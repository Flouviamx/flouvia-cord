{
  "name": "@flouviahq/cli",
  "version": "1.2.0",
  "description": "CLI de Cord: inicia sesión desde el navegador, configura tu cuenta con IA, integra tu proyecto y prueba webhooks en tu localhost.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://docs.cordhq.app/docs/desarrolladores/herramientas/cli",
  "keywords": [
    "cord",
    "cli",
    "webhooks",
    "sandbox",
    "testing",
    "setup"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cord": "dist/cord.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@clack/prompts": "1.5.1",
    "@types/node": "^22.0.0",
    "esbuild": "*",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
