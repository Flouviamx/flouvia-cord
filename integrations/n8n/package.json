{
  "name": "n8n-nodes-cord",
  "version": "1.0.1",
  "description": "n8n node for Cord: quotes, clients, invoices and payments in one link.",
  "license": "MIT",
  "homepage": "https://cordhq.app",
  "author": {
    "name": "Flouvia",
    "email": "contacto@cordhq.app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flouviamx/n8n-nodes-cord.git"
  },
  "bugs": {
    "url": "https://github.com/Flouviamx/n8n-nodes-cord/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "cord",
    "quotes",
    "invoices",
    "payments"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/node.test.mjs",
    "sync": "node scripts/sync-events.mjs",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CordApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Cord/Cord.node.js",
      "dist/nodes/Cord/CordTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
