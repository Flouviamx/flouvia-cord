{
	"name": "n8n-nodes-cord",
	"version": "1.1.0",
	"description": "n8n node for Cord: quotes, clients, invoices and payments in one link.",
	"license": "MIT",
	"homepage": "https://cordhq.app",
	"author": {
		"name": "Flouvia",
		"email": "contacto@cordhq.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Flouviamx/n8n-nodes-cord.git"
	},
	"bugs": {
		"url": "https://github.com/Flouviamx/n8n-nodes-cord/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"cord",
		"quotes",
		"invoices",
		"payments"
	],
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "n8n-node build && node --test test/node.test.mjs",
		"sync": "node scripts/sync-events.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CordApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Cord/Cord.node.js",
			"dist/nodes/Cord/CordTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
