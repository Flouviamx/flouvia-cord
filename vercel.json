{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/recurrencias",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/recordatorios",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/intereses",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/cobranza",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/webhooks",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/webhooks-limpieza",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/limpieza-capturas",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/cron/stripe-webhook-health",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/billing-reconcile",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/comisiones-mensuales",
      "schedule": "0 8 2 * *"
    },
    {
      "path": "/api/cron/expirar-cotizaciones",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/verifactu-submit",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?!(?:(?:www|dev|docs|ops|billing|build|pay)\\.)?cordhq\\.app$|cord\\.flouvia\\.com$|[a-z0-9.-]+\\.vercel\\.app$).+" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "redirects": [
    {
      "source": "/((?!(?:q|i)(?:/|$)|api/|_astro/|imgs/|fonts/|favicon\\.ico$|robots\\.txt$|\\.well-known/cord-domain-check$).+)",
      "has": [{ "type": "host", "value": "(?!(?:(?:www|dev|docs|ops|billing|build|pay)\\.)?cordhq\\.app$|cord\\.flouvia\\.com$|[a-z0-9.-]+\\.vercel\\.app$).+" }],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cord.flouvia.com"
        }
      ],
      "destination": "https://cordhq.app/$1",
      "permanent": true
    },
    {
      "source": "/producto/cfdi",
      "destination": "/producto/internacional",
      "permanent": true
    },
    {
      "source": "/en/producto/cfdi",
      "destination": "/en/producto/internacional",
      "permanent": true
    }
  ]
}
