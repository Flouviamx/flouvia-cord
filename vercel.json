{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "buildCommand": "node scripts/migrate-brand-profile.mjs && node scripts/migrate-catalogo-fiscal.mjs && node scripts/migrate-tareas.mjs && node scripts/migrate-facturacion.mjs && npm run build",
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/recurrencias",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/recordatorios",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/intereses",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/cobranza",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/webhooks",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/webhooks-limpieza",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/limpieza-capturas",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/cron/stripe-webhook-health",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/billing-reconcile",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/comisiones-mensuales",
      "schedule": "0 8 2 * *"
    },
    {
      "path": "/api/cron/expirar-cotizaciones",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/verifactu-submit",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/fiscal-latam",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/spfe",
      "schedule": "40 9 * * *"
    },
    {
      "path": "/api/cron/fiscal-plataforma",
      "schedule": "50 9 * * *"
    },
    {
      "path": "/api/cron/anclas-tiempo",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/workflows",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/integraciones",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/informes-programados",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/cron/cobro-automatico",
      "schedule": "15 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?!(?:(?:www|dev|docs|ops|billing|build|pay|status)\\.)?cordhq\\.app$|cord\\.flouvia\\.com$|[a-z0-9.-]+\\.vercel\\.app$).+" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "redirects": [
    {
      "source": "/((?!en$|_|api/|desarrolladores/status$|en/desarrolladores/status$|.*\\.[A-Za-z0-9]+$).+)",
      "has": [{ "type": "host", "value": "status\\.cordhq\\.app" }],
      "destination": "https://cordhq.app/$1",
      "permanent": false
    },
    {
      "source": "/((?!(?:q|i)(?:/|$)|api/|_astro/|imgs/|fonts/|favicon\\.ico$|robots\\.txt$|\\.well-known/cord-domain-check$).+)",
      "has": [{ "type": "host", "value": "(?!(?:(?:www|dev|docs|ops|billing|build|pay|status)\\.)?cordhq\\.app$|cord\\.flouvia\\.com$|[a-z0-9.-]+\\.vercel\\.app$).+" }],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cord.flouvia.com"
        }
      ],
      "destination": "https://cordhq.app/$1",
      "permanent": true
    },
    {
      "source": "/producto/cfdi",
      "destination": "/producto/facturacion",
      "permanent": true
    },
    {
      "source": "/en/producto/cfdi",
      "destination": "/en/producto/facturacion",
      "permanent": true
    }
  ]
}
