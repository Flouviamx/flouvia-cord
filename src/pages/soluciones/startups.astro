---
import { jsonForScript } from '../../lib/escape';
// Página de solución (Startups).
// Diseño alineado al estilo Cord.
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/landing/Nav.astro';
import Footer from '../../components/landing/Footer.astro';
import PageAnims from '../../components/landing/PageAnims.astro';
import StpMockup from '../../components/soluciones/startups/StpMockup.astro';
import StpDashboard from '../../components/soluciones/startups/StpDashboard.astro';
import { SOLUCIONES } from '../../lib/solucion';
import { SOLUCIONES_EN } from '../../lib/solucion.en';
import { getLangFromUrl } from '../../i18n/utils';
import RibbonHeroBg from '../../components/RibbonHeroBg.jsx';
import SolucionHeroStack from '../../components/soluciones/SolucionHeroStack.astro';
import IntegrationsMarquee from '../../components/integraciones/IntegrationsMarquee.astro';

// Ola del hero en versión clara: menta en la cresta, cielo, índigo, violeta y
// rosa al fondo de la tela. Distinta a la cálida de empresas a propósito.
const HERO_PAL = { base: '#FCFCFC', c1: '#5EEAD4', c2: '#38BDF8', c3: '#6366F1', c4: '#A855F7', c5: '#EC4899' };
import FaqAccordion from '../../components/landing/FaqAccordion.astro';
import BlogCover from '../../components/blog/BlogCover.jsx';

const lang = getLangFromUrl(Astro.url);
const isEn = Astro.props.isEn || lang === 'en';
const baseSolucion = isEn ? SOLUCIONES_EN.find((s) => s.slug === 'startups') : SOLUCIONES.find((s) => s.slug === 'startups');
const solucion = baseSolucion!;
const otras = (isEn ? SOLUCIONES_EN : SOLUCIONES).filter((s) => s.slug !== solucion.slug);

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: solucion.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
};

// BreadcrumbList (jul 2026, auditoría SEO/AI-SEO — mismo criterio que /producto/*)
const SITE = 'https://cordhq.app';
const base = isEn ? `${SITE}/en` : SITE;
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: solucion.nav, item: `${base}/soluciones/${solucion.slug}` },
    ],
};


// Array estático de logos (Stripe-style logo cloud)
const clientLogos = ['GAMA', 'ACEROS', 'VERTICE', 'ZARCO', 'FERREX', 'CEMENTOS'];

// H1 con el fragmento de acento en degradado (misma familia que la ola).
const heroTitle = solucion.tituloAcento
    ? solucion.titulo.replace(solucion.tituloAcento, `<span class="stripe-title-accent">${solucion.tituloAcento}</span>`)
    : solucion.titulo;
import { iconInner } from '../../lib/icons';
---

<Layout
    title={solucion.metaTitle ?? `${solucion.nav} — Cord`}
    description={solucion.metaDescription ?? solucion.sub}
>
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(faqSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(breadcrumbSchema)} />
    <Nav darkHero={solucion.slug === 'empresas'} />
    <main class="stripe-main">
        
        <header class="stripe-hero">
            <div class="stripe-hero-bg">
                <RibbonHeroBg client:only="react" light colors={HERO_PAL} />
            </div>

            <div class="stripe-hero-grid stripe-container">
                <div class="stripe-hero-content">
                    <h1 class="stripe-title reveal" set:html={heroTitle} />

                    <p class="stripe-sub">{solucion.sub}</p>

                    <div class="stripe-actions">
                        <a href="/sign-up" class="btn-luxe">
                            <span>{isEn ? 'Start for free' : 'Crear cuenta gratis'}</span>
                            <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg>
                            <div class="btn-shimmer"></div>
                        </a>
                        <a href="/contacto/ventas" class="btn-ghost">
                            <span>{isEn ? 'Talk to our team' : 'Hablar con el equipo'}</span>
                        </a>
                    </div>
                </div>

                <div class="stripe-hero-visual">
                    <SolucionHeroStack isEn={isEn} variant="startups" />
                </div>
            </div>
        </header>

        <!-- ── STARTUP USE CASES ── -->
        {solucion.useCases && (
            <section class="startup-use-cases-section reveal">
                <div class="stripe-container">
                    <div class="startup-section-header">
                        <div class="startup-section-titles">
                            <h2 class="startup-section-title">{isEn ? 'Four ways startups sell, already covered' : 'Cuatro formas de vender que Cord ya resuelve'}</h2>
                            <p class="startup-section-sub">{isEn ? 'Pick the one closest to your business and see how the full flow looks, with the apps it usually connects to.' : 'Elige la que se parece a tu negocio y mira cómo se ve el flujo completo, con las apps que suele conectar.'}</p>
                        </div>
                        <div class="startup-carousel-controls">
                            <button id="startup-prev" class="carousel-btn" aria-label="Previous">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-left')}></svg>
                            </button>
                            <button id="startup-next" class="carousel-btn" aria-label="Next">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-right')}></svg>
                            </button>
                        </div>
                    </div>
                </div> <!-- End stripe-container to allow full-bleed grid -->
                
                <div class="startup-use-cases-grid">
                        {solucion.useCases.map(uc => (
                            <div class="startup-use-case-card">
                                <div class="uc-content">
                                    <h3 class="uc-title">{uc.title}</h3>
                                    <p class="uc-desc">{uc.desc}</p>
                                    <a href={uc.link} class="uc-link">
                                        <span>{isEn ? 'See the flow' : 'Ver el flujo'}</span>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg>
                                    </a>
                                </div>
                                <div class="uc-logos">
                                    {uc.logos.map(l => (
                                        <div class="uc-logo-item">
                                            <img src={`https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${l.domain}&size=128`} alt={l.name} class="uc-logo-img" loading="lazy" />
                                            <span class="uc-logo-name">{l.name}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
            </section>
        )}

        <!-- ── STARTUP INTEGRATION TABS (Apple Style) ── -->
        {solucion.slug === 'startups' && (
            <section class="integration-tabs-section reveal">
                <div class="stripe-container">
                    <div class="integration-header-wrapper">
                        <div class="integration-header">
                            <h2 class="integration-title">{isEn ? 'Three ways to plug Cord in, depending on how much you want to code' : 'Tres maneras de conectar Cord, según cuánto quieras programar'}</h2>
                            <p class="integration-sub">{isEn ? 'Start without writing code, automate with Zapier, Make or n8n, or create quotes from your own product with the API and Cord Elements.' : 'Empieza sin escribir código, automatiza con Zapier, Make o n8n, o crea cotizaciones desde tu propio producto con la API y Cord Elements.'}</p>
                        </div>
                        <div class="integration-carousel-controls">
                            <button id="integration-prev" class="carousel-btn" aria-label="Previous">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-left')}></svg>
                            </button>
                            <button id="integration-next" class="carousel-btn" aria-label="Next">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-right')}></svg>
                            </button>
                        </div>
                    </div>

                    <div class="stripe-tabs-container">
                        <div class="stripe-progress-track">
                            <div class="stripe-progress-fill" id="stripe-progress-fill"></div>
                        </div>
                        <div class="stripe-tabs-buttons" role="tablist">
                            <button class="stripe-tab active" role="tab" aria-selected="true" data-target="tab-nocode">
                                <span class="tab-label">{isEn ? 'No code' : 'Sin código'}</span>
                                <span class="tab-sub">{isEn ? 'Live today' : 'Listo hoy'}</span>
                            </button>
                            <button class="stripe-tab" role="tab" aria-selected="false" data-target="tab-lowcode">
                                <span class="tab-label">{isEn ? 'Low code' : 'Bajo código'}</span>
                                <span class="tab-sub">{isEn ? 'With your tools' : 'Con tus herramientas'}</span>
                            </button>
                            <button class="stripe-tab" role="tab" aria-selected="false" data-target="tab-api">
                                <span class="tab-label">{isEn ? 'REST API' : 'API REST'}</span>
                                <span class="tab-sub">{isEn ? 'From your product' : 'Desde tu producto'}</span>
                            </button>
                        </div>
                    </div>
                </div> <!-- Close stripe-container so track can bleed full width -->

                    <div class="integration-scroll-track" id="integration-scroll">
                        <!-- NO CODE -->
                        <div class="int-card" data-tab-group="tab-nocode">
                            <div class="int-card-text">
                                <h3 class="int-card-title">{isEn ? 'Quote editor' : 'Editor de cotizaciones'}</h3>
                                <p class="int-card-desc">{isEn ? 'Build the proposal from your catalog, or paste your client\'s request and let AI suggest the lines. Prices always come from your catalog.' : 'Arma la propuesta desde tu catálogo o pega el pedido de tu cliente y deja que la IA proponga las líneas. El precio siempre sale de tu catálogo.'}</p>
                                <a href="/producto/editor" class="int-link">{isEn ? 'See the editor' : 'Ver el editor'} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                            </div>
                            <div class="int-card-graphic">
                                <StpMockup scene="editor" isEn={isEn} />
                            </div>
                        </div>
                        <div class="int-card" data-tab-group="tab-nocode">
                            <div class="int-card-text">
                                <h3 class="int-card-title">{isEn ? 'A link with a pay button' : 'Link con botón de pago'}</h3>
                                <p class="int-card-desc">{isEn ? 'Every quote and invoice has its own link: your client opens it from WhatsApp or email, approves and pays by card without creating an account.' : 'Cada cotización y cada factura tienen su link: tu cliente lo abre desde WhatsApp o el correo, aprueba y paga con tarjeta sin crear cuenta.'}</p>
                                <a href="/producto/link-publico" class="int-link">{isEn ? 'See the public link' : 'Ver el link público'} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                            </div>
                            <div class="int-card-graphic">
                                <StpMockup scene="paylink" isEn={isEn} />
                            </div>
                        </div>

                        <!-- LOW CODE -->
                        <div class="int-card" data-tab-group="tab-lowcode">
                            <div class="int-card-text">
                                <h3 class="int-card-title">Zapier, Make & n8n</h3>
                                <p class="int-card-desc">{isEn ? 'Use the Cord apps for Zapier and Make or the n8n node: when a quote is approved or paid, the rest happens on its own.' : 'Usa las apps de Cord para Zapier y Make o el nodo de n8n: cuando una cotización se aprueba o se paga, lo demás pasa solo.'}</p>
                                <a href="/desarrolladores/api" class="int-link">{isEn ? 'See how to connect' : 'Ver cómo conectarlo'} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                            </div>
                            <div class="int-card-graphic">
                                <StpMockup scene="zapier" isEn={isEn} />
                            </div>
                        </div>
                        <div class="int-card" data-tab-group="tab-lowcode">
                            <div class="int-card-text">
                                <h3 class="int-card-title">Webhooks</h3>
                                <p class="int-card-desc">{isEn ? 'Get every quote, invoice, payment and client event in your backend, HMAC-signed and retried automatically if your server is down.' : 'Recibe en tu backend cada evento de cotización, factura, pago y cliente, firmado con HMAC y con reintentos automáticos si tu servidor no responde.'}</p>
                                <a href="/desarrolladores/api" class="int-link">{isEn ? 'Set up webhooks' : 'Configurar webhooks'} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                            </div>
                            <div class="int-card-graphic">
                                <StpMockup scene="webhooks" isEn={isEn} />
                            </div>
                        </div>

                        <!-- API -->
                        <div class="int-card" data-tab-group="tab-api">
                            <div class="int-card-text">
                                <h3 class="int-card-title">{isEn ? 'REST API' : 'API REST'}</h3>
                                <p class="int-card-desc">{isEn ? 'Create clients and quotes, send them and read invoices from your code. sk_test_ keys work against a separate test environment.' : 'Crea clientes y cotizaciones, envíalas y consulta facturas desde tu código. Las llaves sk_test_ trabajan sobre un entorno de prueba separado.'}</p>
                                <a href="/desarrolladores/api" class="int-link">{isEn ? 'Read the docs' : 'Leer la documentación'} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                            </div>
                            <div class="int-card-graphic">
                                <StpMockup scene="api" isEn={isEn} />
                            </div>
                        </div>
                        <div class="int-card" data-tab-group="tab-api">
                            <div class="int-card-text">
                                <h3 class="int-card-title">Cord Elements</h3>
                                <p class="int-card-desc">{isEn ? 'Put the Cord quote builder inside your site or app as a Web Component, in React or in Vue.' : 'Pon el cotizador de Cord dentro de tu sitio o tu app como Web Component, en React o en Vue.'}</p>
                                <a href={isEn ? "/en/elements" : "/elements"} class="int-link">{isEn ? "See Elements" : "Ver Elements"} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                            </div>
                            <div class="int-card-graphic">
                                <StpMockup scene="elements" isEn={isEn} />
                            </div>
                        </div>
                    </div>
            </section>
        )}

        <!-- ── AIRY BENTO PILLARS ── -->
        {solucion.pillars && (
            <section class="stripe-pillars-section">
                <div class="stripe-container">
                    <div class="stripe-pillars-grid">
                        {solucion.pillars.map((p, i) => (
                            <div class="stripe-pillar-card reveal">
                                <div class="stripe-pillar-graphic">
                                    {i === 0 && <StpMockup scene="p-pay" isEn={isEn} />}
                                    {i === 1 && <StpMockup scene="p-track" isEn={isEn} />}
                                    {i === 2 && <StpMockup scene="p-usage" isEn={isEn} />}
                                </div>
                                <div class="stripe-pillar-content">
                                    <h3 class="stripe-pillar-title">{p.titulo}</h3>
                                    <p class="stripe-pillar-desc">{p.desc}</p>
                                    <a href={p.href || '/producto/editor'} class="stripe-pillar-link">
                                        {p.link}
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-down')}></svg>
                                    </a>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        )}

        <!-- ── FEATURE GRID (ASYMMETRIC) ── -->
        <section class="stripe-feature-grid-section">
            <div class="stripe-container">
                <div class="stripe-section-header reveal">
                    <h2 class="stripe-h2">{isEn ? 'Everything you need to close your first customers' : 'Todo lo que necesitas para cerrar a tus primeros clientes'}</h2>
                    <p class="stripe-p">{solucion.paraQuien}</p>
                </div>

                <div class="stripe-fg-layout">
                    <!-- Left Column: Main Features -->
                    <div class="stripe-fg-main">
                        {solucion.blocks.map((block, idx) => (
                            <div class="stripe-fg-card aurora-card reveal">
                                <div class="aurora-card-layer" aria-hidden="true"></div>
                                <div class="stripe-fg-card-content">
                                    <h3 class="stripe-fg-title">{block.titulo}</h3>
                                    <p class="stripe-fg-desc">{block.copy}</p>
                                    <div class="stripe-fg-tags">
                                        {block.bullets.map((b, bulletIdx) => {
                                            const slugs = ['aprobaciones', 'finanzas', 'facturacion', 'editor', 'equipo'];
                                            const targetSlug = slugs[(idx + bulletIdx) % slugs.length];
                                            return (
                                                <a href={`${isEn ? '/en' : ''}/producto/${targetSlug}`} class="stripe-fg-tag">{b}</a>
                                            );
                                        })}
                                    </div>
                                </div>
                                <div class="stripe-fg-card-visual">
                                    {idx === 0 && <StpMockup scene="b-list" isEn={isEn} />}
                                    {idx === 1 && <StpMockup scene="b-link" isEn={isEn} />}
                                    {idx === 2 && <StpMockup scene="b-invoice" isEn={isEn} />}
                                </div>
                            </div>
                        ))}
                    </div>

                    <!-- Right Column: Resources Sidebar -->
                    <div class="stripe-fg-sidebar">
                        <div class="stripe-resource-card reveal">
                            <div class="stripe-resource-visual res-blog-cover">
                                <BlogCover client:only="react" category={isEn ? 'B2B Sales' : 'Ventas B2B'} title={isEn ? 'Why sending PDF quotes is costing you deals' : 'Por qué enviar cotizaciones en PDF te está costando cierres'} />
                            </div>
                            <div class="stripe-resource-content">
                                <span class="stripe-resource-eyebrow">Blog</span>
                                <h4 class="stripe-resource-title">{isEn ? 'How to quote faster, why PDFs cost you deals and how to use Cord with your AI' : 'Cómo cotizar más rápido, por qué el PDF te cuesta cierres y cómo usar Cord con tu IA'}</h4>
                                <a href={`${isEn ? "/en" : ""}/blog/error-pdf-ventas-b2b`} class="stripe-pillar-link">
                                    {isEn ? 'Browse articles' : 'Ver artículos'}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-right')}></svg>
                                </a>
                            </div>
                        </div>

                        <div class="stripe-resource-card reveal">
                            <div class="stripe-resource-visual stp-res">
                                <StpMockup scene="r-guide" isEn={isEn} />
                            </div>
                            <div class="stripe-resource-content">
                                <span class="stripe-resource-eyebrow">{isEn ? 'Getting started' : 'Primeros pasos'}</span>
                                <h4 class="stripe-resource-title">{isEn ? 'Your catalog, your first quote and your first payment, step by step' : 'Tu catálogo, tu primera cotización y tu primer cobro, paso a paso'}</h4>
                                <a href="/soporte" class="stripe-pillar-link">
                                    {isEn ? 'Start the guide' : 'Empezar la guía'}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-right')}></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── FEATURE GRID 2 (ADVANCED TOOLS) ── -->
        <section class="stripe-feature-grid-section" style="padding-top: 0;">
            <div class="stripe-container">
                <div class="stripe-section-header reveal">
                    <h2 class="stripe-h2">{isEn ? 'What you will need next is already here' : 'Lo que vas a necesitar después ya está aquí'}</h2>
                    <p class="stripe-p">{isEn ? 'Automations, your first hire and international sales, without switching tools.' : 'Automatizaciones, tu primer vendedor y ventas fuera de tu país, sin cambiar de herramienta.'}</p>
                </div>

                <div class="stripe-fg-layout">
                    <!-- Left Column: Main Features -->
                    <div class="stripe-fg-main">
                        <!-- Block 1 -->
                        <div class="stripe-fg-card aurora-card reveal">
                            <div class="aurora-card-layer" aria-hidden="true"></div>
                            <div class="stripe-fg-card-content">
                                <h3 class="stripe-fg-title">Cord Workflows</h3>
                                <p class="stripe-fg-desc">{isEn ? 'When something is approved, paid or about to expire, Cord creates the task, posts in Slack or Teams, emails your client or sends the data to a URL. One active workflow on Free, five on Starter and unlimited from Professional.' : 'Cuando algo se aprueba, se paga o está por vencer, Cord crea la tarea, avisa en Slack o Teams, le escribe a tu cliente o manda los datos a una URL. Un workflow activo en Gratis, cinco en Starter y sin tope desde Profesional.'}</p>
                                <div class="stripe-fg-tags">
                                    <a class="stripe-fg-tag">{isEn ? 'Events and actions' : 'Eventos y acciones'}</a>
                                    <a class="stripe-fg-tag">{isEn ? 'No code' : 'Sin programar'}</a>
                                </div>
                            </div>
                            <div class="stripe-fg-card-visual">
                                <StpMockup scene="g-workflow" isEn={isEn} />
                            </div>
                        </div>

                        <!-- Block 2 -->
                        <div class="stripe-fg-card aurora-card reveal">
                            <div class="aurora-card-layer" aria-hidden="true"></div>
                            <div class="stripe-fg-card-content">
                                <h3 class="stripe-fg-title">{isEn ? 'Your first sales hire, no migration' : 'Tu primer vendedor, sin migrar'}</h3>
                                <p class="stripe-fg-desc">{isEn ? 'On Professional you invite up to five people with per-section permissions, and the team report shows each person\'s quotes, close rate and amount collected.' : 'En Profesional invitas hasta cinco personas con permisos por sección, y el informe de equipo muestra las cotizaciones, la tasa de cierre y lo cobrado de cada una.'}</p>
                                <div class="stripe-fg-tags">
                                    <a class="stripe-fg-tag">{isEn ? 'Team' : 'Equipo'}</a>
                                    <a class="stripe-fg-tag">{isEn ? 'Reports' : 'Informes'}</a>
                                </div>
                            </div>
                            <div class="stripe-fg-card-visual">
                                <StpMockup scene="g-team" isEn={isEn} />
                            </div>
                        </div>

                        <!-- Block 3 -->
                        <div class="stripe-fg-card aurora-card reveal">
                            <div class="aurora-card-layer" aria-hidden="true"></div>
                            <div class="stripe-fg-card-content">
