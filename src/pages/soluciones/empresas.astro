---
import { jsonForScript } from '../../lib/escape';
// Página de solución (Empresas).
// Diseño alineado al estilo Cord.
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/landing/Nav.astro';
import Footer from '../../components/landing/Footer.astro';
import PageAnims from '../../components/landing/PageAnims.astro';
import EmpresasMockup from '../../components/soluciones/empresas/EmpresasMockup.astro';
import { SOLUCIONES } from '../../lib/solucion';
import { SOLUCIONES_EN } from '../../lib/solucion.en';
import { getLangFromUrl } from '../../i18n/utils';
import CordDynamicBg from '../../components/CordDynamicBg.jsx';
import RibbonHeroBg from '../../components/RibbonHeroBg.jsx';
import SolucionHeroStack from '../../components/soluciones/SolucionHeroStack.astro';

// El hero usa su propio shader (RibbonHeroBg). Las tarjetas siguen con el
// shader estándar de Cord: navy + teal esmeralda + índigo (el teal es el foco).
const CARD_PAL = { base: '#0B0F19', color1: '#0F8A6E', color2: '#3A2280', color3: '#1E64E0' };
import FaqAccordion from '../../components/landing/FaqAccordion.astro';
import BlogCover from '../../components/blog/BlogCover.jsx';

const lang = getLangFromUrl(Astro.url);
const isEn = Astro.props.isEn || lang === 'en';
const baseSolucion = isEn ? SOLUCIONES_EN.find((s) => s.slug === 'empresas') : SOLUCIONES.find((s) => s.slug === 'empresas');
const solucion = baseSolucion!;
const otras = (isEn ? SOLUCIONES_EN : SOLUCIONES).filter((s) => s.slug !== solucion.slug);

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: solucion.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
};

// BreadcrumbList (jul 2026, auditoría SEO/AI-SEO — mismo criterio que /producto/*)
const SITE = 'https://cordhq.app';
const base = isEn ? `${SITE}/en` : SITE;
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: solucion.nav, item: `${base}/soluciones/${solucion.slug}` },
    ],
};

// H1 con el fragmento de acento pintado en degradado (misma paleta que la tela
// del shader). El titulo admite HTML, así que el reemplazo es sobre el string.
const heroTitle = solucion.tituloAcento
    ? solucion.titulo.replace(solucion.tituloAcento, `<span class="stripe-title-accent">${solucion.tituloAcento}</span>`)
    : solucion.titulo;
import { iconInner } from '../../lib/icons';
---

<Layout
    title={solucion.metaTitle ?? `${solucion.nav} — Cord`}
    description={solucion.metaDescription ?? solucion.sub}
>
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(faqSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(breadcrumbSchema)} />
    <Nav darkHero={solucion.slug === 'empresas'} />
    <main class="stripe-main">
        
        <header class="stripe-hero">
            <div class="stripe-hero-bg">
                <RibbonHeroBg client:only="react" />
            </div>

            <div class="stripe-hero-grid stripe-container">
                <div class="stripe-hero-content">
                    <h1 class="stripe-title reveal" set:html={heroTitle} />

                    <p class="stripe-sub">{solucion.sub}</p>

                    <div class="stripe-actions">
                        <a href="/sign-up" class="btn-luxe">
                            <span>{isEn ? 'Create your company account' : 'Crear la cuenta de tu empresa'}</span>
                            <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('arrow-right')}></svg>
                            <div class="btn-shimmer"></div>
                        </a>
                        <a href="/contacto/ventas" class="btn-ghost">
                            <span>{isEn ? 'Book a demo' : 'Agendar una demostración'}</span>
                        </a>
                    </div>
                </div>

                <div class="stripe-hero-visual">
                    <SolucionHeroStack isEn={isEn} variant="empresas" />
                </div>
            </div>
        </header>


        <!-- ── AIRY BENTO PILLARS ── -->
        {solucion.pillars && (
            <section class="stripe-pillars-section">
                <div class="stripe-container">
                    <div class="stripe-pillars-grid">
                        {solucion.pillars.map((p, i) => (
                            <div class="stripe-pillar-card reveal">
                                <div class="stripe-pillar-graphic">
                                    <EmpresasMockup scene={(["aprobaciones", "integraciones", "equipo"] as const)[i] ?? "aprobaciones"} variant="pillar" isEn={isEn} />
                                </div>
                                <div class="stripe-pillar-content">
                                    <h3 class="stripe-pillar-title">{p.titulo}</h3>
                                    <p class="stripe-pillar-desc">{p.desc}</p>
                                    <a href={p.href || '/producto/editor'} class="stripe-pillar-link">
                                        {p.link}
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-down')}></svg>
                                    </a>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        )}

        <!-- ── FEATURE GRID (ASYMMETRIC) ── -->
        <section class="stripe-feature-grid-section">
            <div class="stripe-container">
                <div class="stripe-section-header reveal">
                    <h2 class="stripe-h2">{isEn ? 'Control over every price, without slowing your team down' : 'Control sobre cada precio, sin frenar al equipo'}</h2>
                    <p class="stripe-p">{solucion.paraQuien}</p>
                </div>

                <div class="stripe-fg-layout">
                    <!-- Left Column: Main Features -->
                    <div class="stripe-fg-main">
                        {solucion.blocks.map((block, idx) => (
                            <div class="stripe-fg-card aurora-card reveal">
                                <CordDynamicBg client:only="react" colors={CARD_PAL} grain={false} />
                                <div class="stripe-fg-card-content">
                                    <h3 class="stripe-fg-title">{block.titulo}</h3>
                                    <p class="stripe-fg-desc">{block.copy}</p>
                                    <div class="stripe-fg-tags">
                                        {block.bullets.map((b, bulletIdx) => {
                                            const slugs = ['aprobaciones', 'finanzas', 'facturacion', 'editor', 'equipo'];
                                            const targetSlug = slugs[(idx + bulletIdx) % slugs.length];
                                            return (
                                                <a href={`${isEn ? '/en' : ''}/producto/${targetSlug}`} class="stripe-fg-tag">{b}</a>
                                            );
                                        })}
                                    </div>
                                </div>
                                <div class="stripe-fg-card-visual">
                                    <EmpresasMockup scene={(["cotizacion", "webhooks", "sso"] as const)[idx] ?? "cotizacion"} isEn={isEn} />
                                </div>
                            </div>
                        ))}
                    </div>

                    <!-- Right Column: Resources Sidebar -->
                    <div class="stripe-fg-sidebar">
                        <div class="stripe-resource-card reveal">
                            <div class="stripe-resource-visual res-blog-cover">
                                <BlogCover client:only="react" category={isEn ? 'Finance' : 'Finanzas'} title={isEn ? 'How to offer credit (Net 30) without going bankrupt' : 'Cómo ofrecer crédito (Net 30) sin quebrar en el intento'} />
                            </div>
                            <div class="stripe-resource-content">
                                <span class="stripe-resource-eyebrow">Blog</span>
                                <h4 class="stripe-resource-title">{isEn ? 'Net 30 credit, price lists and collections, explained for sales teams' : 'Crédito a 30 días, listas de precios y cobranza, explicados para equipos comerciales'}</h4>
                                <a href={`${isEn ? "/en" : ""}/blog/credito-b2b-net30`} class="stripe-pillar-link">
                                    {isEn ? 'Read the blog' : 'Leer el blog'}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('chevron-right')}></svg>
                                </a>
                            </div>
                        </div>

                        <div class="stripe-resource-card reveal">
                            <div class="stripe-resource-visual emk-dark-visual">
                                <EmpresasMockup scene="sso" variant="dark" isEn={isEn} />
                            </div>
                            <div class="stripe-resource-content">
                                <span class="stripe-resource-eyebrow">{isEn ? 'Security' : 'Seguridad'}</span>
                                <h4 class="stripe-resource-title">{isEn ? 'Guides for SSO, two-step verification and security reviews' : 'Guías de SSO, verificación en dos pasos y revisiones de seguridad'}</h4>
                                <a href="/soporte" class="stripe-pillar-link">
                                    {isEn ? 'See security guides' : 'Ver guías de seguridad'}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('chevron-right')}></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── FEATURE GRID 2 (ADVANCED TOOLS) ── -->
        <section class="stripe-feature-grid-section" style="padding-top: 0;">
            <div class="stripe-container">
                <div class="stripe-section-header reveal">
                    <h2 class="stripe-h2">{isEn ? 'Built for everything that happens once the deal is signed' : 'Pensado para todo lo que pasa después de la firma'}</h2>
                    <p class="stripe-p">{isEn ? 'Collections, per-rep reporting and several legal entities, without leaving Cord.' : 'Cobranza, informes por vendedor y varias razones sociales, sin salir de Cord.'}</p>
                </div>

                <div class="stripe-fg-layout">
                    <!-- Left Column: Main Features -->
                    <div class="stripe-fg-main">
                        <!-- Block 1 -->
                        <div class="stripe-fg-card aurora-card reveal">
                            <CordDynamicBg client:only="react" colors={CARD_PAL} grain={false} />
                            <div class="stripe-fg-card-content">
                                <h3 class="stripe-fg-title">{isEn ? 'Collections with priorities' : 'Cobranza con prioridades'}</h3>
                                <p class="stripe-fg-desc">{isEn ? 'Your receivables bring quotes and invoices together, rank who to call first and track promises to pay. On Scale, an AI agent follows up within the rules you set and late interest is calculated for you.' : 'La cartera junta cotizaciones y facturas por cobrar, ordena a quién llamar primero y registra promesas de pago. En Scale, un agente de IA da seguimiento dentro de las reglas que fijes y el interés moratorio se calcula solo.'}</p>
                                <div class="stripe-fg-tags">
                                    <a href="/producto/cobranza-ia" class="stripe-fg-tag">{isEn ? 'AI collections' : 'Cobranza con IA'}</a>
                                    <a href="/producto/clientes-credito" class="stripe-fg-tag">{isEn ? 'Credit and statements' : 'Crédito y estado de cuenta'}</a>
                                </div>
                            </div>
                            <div class="stripe-fg-card-visual">
                                <EmpresasMockup scene="cobranza" isEn={isEn} />
                            </div>
                        </div>

                        <!-- Block 2 -->
                        <div class="stripe-fg-card aurora-card reveal">
                            <CordDynamicBg client:only="react" colors={CARD_PAL} grain={false} />
                            <div class="stripe-fg-card-content">
                                <h3 class="stripe-fg-title">{isEn ? 'Reporting by rep' : 'Informes por vendedor'}</h3>
                                <p class="stripe-fg-desc">{isEn ? 'Quotes, close rate, amount closed and collected, average deal size and days to close for each person, next to the month\'s pipeline. Visible to whoever holds the Reports permission.' : 'Cotizaciones, tasa de cierre, monto cerrado y cobrado, ticket promedio y días a cierre de cada persona, junto al pipeline del mes. Lo ve quien tiene el permiso de Informes.'}</p>
                                <div class="stripe-fg-tags">
                                    <a href="/producto/equipo" class="stripe-fg-tag">{isEn ? 'Team reports' : 'Informes de equipo'}</a>
                                    <a href="/producto/finanzas" class="stripe-fg-tag">{isEn ? '90-day cash flow' : 'Flujo a 90 días'}</a>
                                </div>
                            </div>
                            <div class="stripe-fg-card-visual">
                                <EmpresasMockup scene="desempeno" isEn={isEn} />
                            </div>
                        </div>

                        <!-- Block 3 -->
                        <div class="stripe-fg-card aurora-card reveal">
                            <CordDynamicBg client:only="react" colors={CARD_PAL} grain={false} />
                            <div class="stripe-fg-card-content">
                                <h3 class="stripe-fg-title">{isEn ? 'Several legal entities, several currencies' : 'Varias razones sociales, varias divisas'}</h3>
                                <p class="stripe-fg-desc">{isEn ? 'Each legal entity lives in its own organization, with its own country, taxes, numbering and team, and you switch between them without signing in again. Sell in each client\'s currency with a rate from a published source that the invoice declares.' : 'Cada razón social vive en su propia organización, con su país, sus impuestos, su numeración y su equipo, y cambias entre ellas sin volver a entrar. Vendes en la divisa de cada cliente con una tasa de fuente publicada que la factura declara.'}</p>
                                <div class="stripe-fg-tags">
                                    <a href="/producto/divisas" class="stripe-fg-tag">{isEn ? 'Multi-currency' : 'Multi-divisa'}</a>
                                    <a href="/soporte/multiples-empresas" class="stripe-fg-tag">{isEn ? 'Multiple companies' : 'Varias empresas'}</a>
                                </div>
                            </div>
                            <div class="stripe-fg-card-visual">
                                <EmpresasMockup scene="divisas" isEn={isEn} />
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Resources Sidebar (Duplicated with different info) -->
                    <div class="stripe-fg-sidebar">
                        <div class="stripe-resource-card reveal">
                            <div class="stripe-resource-visual emk-dark-visual">
                                <EmpresasMockup scene="headers" variant="dark" isEn={isEn} />
                            </div>
                            <div class="stripe-resource-content">
                                <span class="stripe-resource-eyebrow">{isEn ? 'Developers' : 'Desarrolladores'}</span>
                                <h4 class="stripe-resource-title">{isEn ? 'API reference, signed webhooks and idempotency for your integration team' : 'Referencia de la API, webhooks firmados e idempotencia para tu equipo de integración'}</h4>
                                <a href="/desarrolladores/api" class="stripe-pillar-link">
                                    {isEn ? 'Open the reference' : 'Abrir la referencia'}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('chevron-right')}></svg>
                                </a>
                            </div>
                        </div>

                        <div class="stripe-resource-card reveal">
                            <div class="stripe-resource-visual emk-dark-visual">
                                <EmpresasMockup scene="equipo" variant="dark" isEn={isEn} />
                            </div>
                            <div class="stripe-resource-content">
                                <span class="stripe-resource-eyebrow">{isEn ? 'Team' : 'Equipo'}</span>
                                <h4 class="stripe-resource-title">{isEn ? 'Invite your team, assign roles and run several companies' : 'Invita a tu equipo, asigna roles y opera varias empresas'}</h4>
                                <a href="/soporte" class="stripe-pillar-link">
                                    {isEn ? 'See team guides' : 'Ver guías de equipo'}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('chevron-right')}></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── SECURITY / TRUST CENTER (STRIPE SPLIT LAYOUT) ── -->
        {solucion.security && (
            <section class="stripe-split-security">
                <div class="stripe-container">
                    <div class="split-layout">
                        <!-- Left Side: Text and Features -->
                        <div class="split-text-side">
                            <div class="split-header reveal">
                                <h2 class="split-title">{solucion.security.titulo}</h2>
                                <p class="split-subtitle">{solucion.security.copy}</p>
                            </div>

                            <div class="split-features-list">
                                {solucion.security.features.map((f, index) => (
                                    <div class={`split-feature-item reveal delay-${index}`}>
                                        <h4 class="split-feature-title">{f.title}</h4>
                                        <p class="split-feature-desc">{f.desc}</p>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <!-- Right Side: Sticky Visual -->
                        <div class="split-visual-side reveal">
                            <div class="split-visual-sticky">
                                <!-- Colorful Gradient Background -->
                                <div class="split-visual-bg">
                                    <CordDynamicBg client:only="react" colors={CARD_PAL} grain={false} />
                                </div>
                                
                                <EmpresasMockup scene="evidencia" variant="split" isEn={isEn} />
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        )}


        <!-- ── FAQ ── -->
        <FaqAccordion
            faqs={solucion.faqs}
            title={isEn ? 'What sales, finance and IT ask before signing' : 'Lo que preguntan ventas, finanzas y TI antes de firmar'}
            id="empresas-faq"
            class="sol-faq-acc"
            maxWidth="800px"
        />


        <Footer />
    </main>

    <PageAnims />
    
</Layout>

<style>
    /* ════════════════════════════════════════════════════════════════
       VARIABLES & TOKENS GLOBALES (ESTILO CORD LIGHT)
    ════════════════════════════════════════════════════════════════ */
    :root {
        --stripe-bg: #ffffff;
        --stripe-text: #0a192f;
        --stripe-muted: #555c68;
        --stripe-accent: #0a192f;
        --stripe-accent-light: #1e3a8a;
        --stripe-cyan: #3b82f6;
        --stripe-border: rgba(10, 25, 47, 0.08);
        --stripe-card-bg: rgba(255, 255, 255, 0.8);
        --stripe-font-sans: var(--font-sans, "Inter", system-ui, sans-serif);
    }
    
    .stripe-main {
        background-color: var(--stripe-bg);
        color: var(--stripe-text);
        font-family: var(--stripe-font-sans);
        overflow-x: clip;
    }
    
    .stripe-container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* ════════════════════════════════════════════════════════════════
       HERO (Stripe Enterprise)
    ════════════════════════════════════════════════════════════════ */
    /* Fondo continuo como la home: una sola superficie #fcfcfc debajo del
       hero, sin franjas ni filos entre secciones. */
    .stripe-main { background: #fcfcfc; }
    .stripe-main > section { background: transparent; border-top: 0; border-bottom: 0; }

    /* Encabezados de sección: título a la izquierda, texto y enlace a la
       derecha. (Los dos carruseles de arriba de startups conservan el suyo.) */
    .stripe-main .stripe-section-header {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        column-gap: 4rem;
        align-items: start;
        max-width: none;
        margin: 0 0 3.5rem;
        text-align: left;
    }
    .stripe-main .stripe-section-header > h2 {
        grid-column: 1;
        grid-row: 1 / span 3;
        margin: 0;
        align-self: start;
    }
    .stripe-main .stripe-section-header > :not(h2) {
        grid-column: 2;
        margin-top: 0;
        max-width: 520px;
    }
    .stripe-main .stripe-section-header > p { margin-bottom: 1rem; }
    @media (max-width: 880px) {
        .stripe-main .stripe-section-header { grid-template-columns: 1fr; row-gap: 1.2rem; }
        .stripe-main .stripe-section-header > h2, .stripe-main .stripe-section-header > :not(h2) { grid-column: 1; grid-row: auto; }
    }

    /* Portada real del artículo del blog en la tarjeta de recursos. */
    .res-blog-cover { position: relative; overflow: hidden; }

    .stripe-hero {
        position: relative;
        padding: 150px 0 90px;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
        background: #0b1330;
    }

    /* Respaldo sin WebGL: la misma composición (navy a la izquierda, tela
       cálida en diagonal a la derecha) hecha con degradados. El canvas la
       cubre en cuanto monta. */
    .stripe-hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        background:
            linear-gradient(118deg, #0b1330 0%, #0b1330 42%, #ffb561 44%, #ff6f59 50%, #e2448f 60%, #8a4df0 76%, #3b2fc9 100%);
    }
    /* Legibilidad: un velo navy tenue detrás de la columna de texto. */
    .stripe-hero-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(11, 19, 48, 0.55) 0%, rgba(11, 19, 48, 0.2) 38%, transparent 55%);
    }

    .stripe-hero-grid {
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        gap: 56px;
        align-items: center;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
    }

    .stripe-hero-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
    }

    .stripe-hero-visual {
        display: flex;
        justify-content: center;
        padding-right: 120px;
    }


    .stripe-title {
        /* Mismo tamaño que el estándar global de títulos (h1.masked-title,
           Layout.astro) que usan la home y la plantilla de producto. */
        font-size: clamp(2.1rem, 3.4vw, 3.6rem);
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.035em;
        margin: 0 0 1.75rem;
        color: #ffffff;
        text-wrap: balance;
        max-width: 660px;
    }
    .stripe-title :global(.stripe-title-accent) {
        background: linear-gradient(92deg, #ffc27a 0%, #ff8a5c 38%, #f0588f 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: #ff8a5c;
    }

    .stripe-sub {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.78);
        max-width: 540px;
        margin: 0 0 2.4rem 0;
        font-weight: 400;
    }


    @media (max-width: 1100px) {
        .stripe-hero-visual { padding-right: 60px; }
    }

    @media (max-width: 880px) {
        .stripe-hero-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        .stripe-hero-visual { padding-right: 0; }
        .stripe-hero-bg::after {
            background: linear-gradient(180deg, rgba(11, 19, 48, 0.5) 0%, rgba(11, 19, 48, 0.15) 50%, transparent 70%);
        }
    }

    .stripe-actions {
        display: flex;
        gap: 0.8rem;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    /* ── btn-luxe (copiado exacto de Hero.astro) ── */
    .btn-luxe {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
