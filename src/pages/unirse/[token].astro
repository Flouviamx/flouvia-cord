---
// /unirse/[token] — landing de invitación. Pública: muestra a qué org te invitan.
// Si hay sesión → botón "Unirme" (POST /api/equipo/join → /app). Si no → a login
// con redirect_url de vuelta aquí. El token del LINK es el crudo; en BD solo
// vive su sha256 (ver equipo.ts) — aquí se hashea antes de buscar.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { sql } from '../../lib/db';
import { currentUserId, currentLocale } from '../../lib/context';
import { t } from '../../i18n/app';
import { sha256Hex } from '../../lib/auth';

const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const { token } = Astro.params;
const path = `/unirse/${token}`;
// `Astro.locals.auth` era de Clerk — nunca existió en el auth propio (que
// resuelve la sesión vía AsyncLocalStorage, no vía `Astro.locals`). Con el
// residuo, esta condición SIEMPRE era falsa y el botón "Unirme" nunca se
// mostraba a un usuario ya logueado.
const signedIn = !!currentUserId();

let invite: { nombre: string; rol: string; estado: string; expirado: boolean } | null = null;
try {
    const tokenHash = sha256Hex(token || '');
    const rows = await sql`
        select o.nombre, m.rol, m.estado, m.token_expires_at
        from org_members m join orgs o on o.id = m.org_id
        where m.token = ${tokenHash}`;
    if (rows.length) {
        const expirado = !!rows[0].token_expires_at && new Date(rows[0].token_expires_at as string) < new Date();
        invite = { nombre: rows[0].nombre as string, rol: rows[0].rol as string, estado: rows[0].estado as string, expirado };
    }
} catch { /* tabla no migrada → invite null */ }

const ROL_LABEL: Record<string, string> = {
    admin: t(L, 'set.eq.rol.admin'), vendedor: t(L, 'set.eq.rol.vendedor'),
    lectura: t(L, 'set.eq.rol.lectura'), miembro: t(L, 'set.eq.rol.miembro'),
};
// `estado === 'activo'` también invalida: la invitación ya se usó. Antes solo se
// excluía 'revocado', así que un link ya consumido seguía mostrando el botón
// "Unirme" y el usuario se comía un 409 del API sin entender por qué.
const valido = invite && invite.estado === 'invitado' && !invite.expirado;
---

<Layout title={t(L, 'join.title')} noindex={true}>
    <main class="join-page">
        <div class="join-card">
            <a href="/"><img src="/imgs/logo-cord-navy.png" alt="Cord" class="join-logo" /></a>

            {!valido && (
                <>
                    <h1>{t(L, 'join.invalida')}</h1>
                    <p>{t(L, 'join.invalida_desc')}</p>
                    <a href="/" class="join-btn ghost">{t(L, 'join.ir_inicio')}</a>
                </>
            )}

            {valido && (
                <>
                    <p class="join-eyebrow">{t(L, 'join.eyebrow')}</p>
                    <h1>{invite!.nombre}</h1>
                    <p class="join-rol" set:html={tf('join.como_rol', { rol: `<b>${ROL_LABEL[invite!.rol] ?? t(L, 'set.eq.rol.miembro')}</b>` })}></p>

                    {signedIn ? (
                        <>
                            <button class="join-btn" id="joinBtn" data-token={token}
                                data-i18n-uniendo={t(L, 'join.uniendo')} data-i18n-error={t(L, 'join.error')}>{tf('join.unirme_a', { org: invite!.nombre })}</button>
                            <p class="join-note" id="joinMsg"></p>
                        </>
                    ) : (
                        <>
                            <p class="join-sub">{t(L, 'join.necesitas_cuenta')}</p>
                            <div class="join-actions">
                                <a href={`/sign-in?redirect_url=${encodeURIComponent(path)}`} class="join-btn">{t(L, 'join.iniciar_sesion')}</a>
                                <a href={`/sign-up?redirect_url=${encodeURIComponent(path)}`} class="join-btn ghost">{t(L, 'join.crear_cuenta')}</a>
                            </div>
                        </>
                    )}
                </>
            )}
        </div>
    </main>
</Layout>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('joinBtn');
        if (!btn) return;
        btn.addEventListener('click', async () => {
            btn.disabled = true;
            const msg = document.getElementById('joinMsg');
            msg.textContent = btn.dataset.i18nUniendo || 'Uniéndote…';
            try {
                const res = await fetch('/api/equipo/join', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token: btn.dataset.token }) });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || btn.dataset.i18nError || 'No se pudo unir');
                window.location.href = '/app';
            } catch (e) { msg.textContent = e.message; msg.style.color = '#ef4444'; btn.disabled = false; }
        });
    });
</script>

<style>
    .join-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; background: var(--color-bg-soft, #fafbfc); }
    /* Tokens, no literales: esta página también se abre desde la app, donde el
       tema oscuro está activo — antes era blanco sobre blanco. */
    .join-card { width: min(420px, 100%); background: var(--surface, #fff); border: 1px solid var(--color-border, rgba(10,25,47,0.08)); border-radius: 24px; box-shadow: 0 30px 70px -30px rgba(10,25,47,0.25); padding: 2.4rem 2rem; text-align: center; }
    .join-logo { height: 22px; margin-bottom: 1.6rem; }
    .join-eyebrow { font-size: 0.62rem; font-weight: 800; letter-spacing: 2px; color: #99a2af; margin: 0 0 0.5rem; }
    .join-card h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.5px; margin: 0 0 0.4rem; color: var(--color-text, #050505); }
    .join-rol { font-size: 0.9rem; color: var(--color-text-muted, #555); margin: 0 0 1.8rem; }
    .join-rol b { color: var(--color-text, #050505); }
    .join-sub { font-size: 0.85rem; color: var(--color-text-muted, #555); margin: 0 0 1.4rem; }
    .join-actions { display: flex; flex-direction: column; gap: 0.6rem; }
    .join-btn { display: inline-block; font-family: var(--font-sans); font-size: 0.9rem; font-weight: 600; text-decoration: none; cursor: pointer; border: none; padding: 12px 24px; border-radius: 999px; background: var(--color-blue-deep, #0a192f); color: #fff; transition: transform 0.3s var(--ease-spring, ease); }
    .join-btn:hover { transform: translateY(-2px); }
    .join-btn:active { transform: scale(0.97); }
    .join-btn:disabled { opacity: 0.6; }
    .join-btn.ghost { background: transparent; color: var(--color-text, #0a192f); border: 1px solid var(--color-border, rgba(10,25,47,0.14)); }
    .join-note { font-size: 0.82rem; color: var(--color-text-muted, #555); margin: 1rem 0 0; min-height: 1.2em; }
    .join-card p { line-height: 1.5; }
</style>
