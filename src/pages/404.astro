---
import Layout from '../layouts/Layout.astro';
import CordDynamicBg from '../components/CordDynamicBg.jsx';
import Nav from '../components/landing/Nav.astro';
import Footer from '../components/landing/Footer.astro';
---

<Layout
    title="Página no encontrada | Cord"
    description="La página que buscas no existe."
    noindex={true}
>
    <Nav />

    <main class="error-page">
        <section class="error-hero" aria-labelledby="error-title">
            <div class="error-number" aria-hidden="true">
                <div class="error-number__fallback"></div>
                <CordDynamicBg
                    client:load
                    maskImage="/404-mask.svg"
                    colors={{
                        base: '#0F172A',
                        color1: '#38BDF8',
                        color2: '#6670F4',
                        color3: '#10B981',
                    }}
                    grain={true}
                />
            </div>

            <div class="error-copy">
                <h1 id="error-title">Esta página no está aquí.</h1>
                <p>La dirección puede haber cambiado. Vuelve al inicio o continúa explorando Cord.</p>
                <a class="home-cta" href="/">
                    Volver al inicio
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>

        <section class="paths" aria-labelledby="paths-title">
            <div class="paths-heading">
                <h2 id="paths-title">Puedes continuar por aquí</h2>
                <p>Encuentra rápidamente lo que estabas buscando.</p>
            </div>

            <nav class="path-list" aria-label="Enlaces recomendados">
                <a class="path-item" href="/producto/editor">
                    <span class="path-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h11a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z" fill="currentColor" fill-opacity="0.12" />
                            <path d="M4 4h11a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z" />
                            <path d="M8 8.5h7M8 12h7" stroke-opacity="0.5" />
                        </svg>
                    </span>
                    <span class="path-copy">
                        <strong>Conoce el producto</strong>
                        <span>Descubre cómo Cord lleva cada venta de la propuesta al pago.</span>
                    </span>
                    <span class="path-arrow" aria-hidden="true">→</span>
                </a>

                <a class="path-item" href="/precios">
                    <span class="path-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 13 13 20a2 2 0 0 1-2.83 0L4 13.83A2 2 0 0 1 4 11l7-7h7a2 2 0 0 1 2 2z" fill="currentColor" fill-opacity="0.12" />
                            <path d="M20 13 13 20a2 2 0 0 1-2.83 0L4 13.83A2 2 0 0 1 4 11l7-7h7a2 2 0 0 1 2 2z" />
                            <circle cx="16" cy="8" r="1" fill="currentColor" stroke="none" />
                        </svg>
                    </span>
                    <span class="path-copy">
                        <strong>Consulta los planes</strong>
                        <span>Compara funciones y elige el plan adecuado para tu operación.</span>
                    </span>
                    <span class="path-arrow" aria-hidden="true">→</span>
                </a>

                <a class="path-item" href="/soporte">
                    <span class="path-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.12" />
                            <circle cx="12" cy="12" r="9" />
                            <path d="M9.7 9a2.45 2.45 0 0 1 4.67 1c0 1.63-2.37 2-2.37 3.5" stroke-opacity="0.65" />
                            <path d="M12 17h.01" />
                        </svg>
                    </span>
                    <span class="path-copy">
                        <strong>Centro de ayuda</strong>
                        <span>Encuentra respuestas, guías y recursos para usar Cord.</span>
                    </span>
                    <span class="path-arrow" aria-hidden="true">→</span>
                </a>
            </nav>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    :global(.js-anim body:has(.error-page) #navbar) {
        opacity: 1;
    }

    :global(html),
    :global(body) {
        min-height: 100%;
        background: #f5f5f7 !important;
        color-scheme: light;
    }

    .error-page {
        min-height: 100dvh;
        overflow: hidden;
        background:
            radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 34rem),
            #f5f5f7;
        color: #050505;
    }

    .error-hero {
        display: flex;
        min-height: min(92dvh, 920px);
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: clamp(9rem, 15vh, 11rem) 1.5rem 4.5rem;
        text-align: center;
    }

    .error-number {
        position: relative;
        width: min(76vw, 880px);
        aspect-ratio: 2.7 / 1;
        flex: none;
        filter: drop-shadow(0 22px 34px rgba(10, 25, 47, 0.13));
    }

    .error-number > :global(astro-island) {
        position: absolute;
        inset: 0;
        display: block;
    }

    .error-number__fallback {
        position: absolute;
        inset: 0;
        background: #0f172a;
        -webkit-mask: url('/404-mask.svg') center / contain no-repeat;
        mask: url('/404-mask.svg') center / contain no-repeat;
    }

    .error-copy {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: clamp(1rem, 2.5vh, 2rem);
    }

    .error-copy h1 {
        max-width: 720px;
        margin: 0;
        color: #050505;
        font-size: clamp(2rem, 4.2vw, 3.75rem);
        font-weight: 700;
        letter-spacing: -0.045em;
        line-height: 1.04;
        text-wrap: balance;
    }

    .error-copy p {
        max-width: 570px;
        margin: 1rem 0 0;
        color: #6e6e73;
        font-size: clamp(0.95rem, 1.4vw, 1.0625rem);
        line-height: 1.55;
        text-wrap: balance;
    }

    .home-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin-top: 1.75rem;
        padding: 0.75rem 1.2rem;
        border-radius: 999px;
        background: #0a192f;
        box-shadow: 0 8px 24px rgba(10, 25, 47, 0.17);
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: transform 180ms var(--ease-ios), background-color 180ms ease, box-shadow 180ms ease;
    }

    .home-cta:hover {
        background: #102640;
        box-shadow: 0 10px 28px rgba(10, 25, 47, 0.22);
        transform: scale(0.98);
    }

    .home-cta:active { transform: scale(0.96); }
    .home-cta:focus-visible { outline: 2px solid #0a192f; outline-offset: 4px; }

    .paths {
        width: min(1180px, calc(100% - 3rem));
        margin: 0 auto;
        padding: 5rem 0 7rem;
        border-top: 1px solid rgba(10, 25, 47, 0.09);
    }

    .paths-heading h2 {
        margin: 0;
        color: #050505;
        font-size: clamp(1.65rem, 2.8vw, 2.4rem);
        font-weight: 650;
        letter-spacing: -0.035em;
        line-height: 1.1;
    }

    .paths-heading p {
        margin: 0.65rem 0 0;
        color: #6e6e73;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .path-list {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: 2.5rem;
        overflow: hidden;
        border-radius: 28px;
        background: #fff;
        box-shadow:
            0 1px 2px rgba(10, 25, 47, 0.03),
            0 18px 50px -28px rgba(10, 25, 47, 0.22);
    }

    .path-item {
        position: relative;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 1rem;
        min-height: 190px;
        align-items: start;
        padding: 2rem;
        color: #0a192f;
        text-decoration: none;
        transition: background-color 180ms ease;
    }

    .path-item + .path-item { border-left: 1px solid rgba(10, 25, 47, 0.08); }
    .path-item:hover { background: #fafbfc; }
    .path-item:active { background: #f5f5f7; }
    .path-item:focus-visible { z-index: 1; outline: 2px solid #0a192f; outline-offset: -4px; }

    .path-icon {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        border-radius: 13px;
        background: #f0f4f7;
        color: #0f5f78;
    }

    .path-icon svg { width: 22px; height: 22px; }

    .path-copy {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding-top: 0.55rem;
    }

    .path-copy strong {
        color: #0a192f;
        font-size: 1rem;
        font-weight: 650;
        letter-spacing: -0.02em;
    }

    .path-copy > span {
        color: #6e6e73;
        font-size: 0.875rem;
        line-height: 1.55;
    }

    .path-arrow {
        padding-top: 0.65rem;
        color: #9a9aa0;
        transition: color 180ms ease, transform 180ms var(--ease-ios);
    }

    .path-item:hover .path-arrow { color: #0f5f78; transform: translateX(3px); }

    @media (max-width: 820px) {
        .error-hero { min-height: auto; padding-top: 8.5rem; }
        .error-number { width: min(94vw, 700px); }
        .path-list { grid-template-columns: 1fr; }
        .path-item { min-height: 0; }
        .path-item + .path-item { border-top: 1px solid rgba(10, 25, 47, 0.08); border-left: 0; }
    }

    @media (max-width: 520px) {
        .error-hero { padding: 8rem 1.25rem 3.75rem; }
        .error-number { width: 112vw; }
        .paths { width: calc(100% - 2rem); padding: 3.75rem 0 5rem; }
        .path-list { border-radius: 24px; }
        .path-item { padding: 1.5rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-cta,
        .path-arrow { transition: none; }
    }
</style>
