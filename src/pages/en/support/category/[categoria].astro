---
import CategoriaPage from '../../../soporte/categoria/[categoria].astro';
import { SUPPORT_CATEGORIES } from '../../../../lib/support-categories';

export const prerender = true;

export function getStaticPaths() {
  return SUPPORT_CATEGORIES.map(cat => ({
    params: { categoria: cat.slug },
    props: { name: cat.en.name, desc: cat.en.desc, icon: cat.icon },
  }));
}

const { categoria } = Astro.params;
const { name, desc, icon } = Astro.props;
---
<CategoriaPage isEn={true} categoria={categoria} name={name} desc={desc} icon={icon} />
