---
export const prerender = true;
import RoadmapDetail from '../../../components/roadmap/RoadmapDetail.astro';
import { roadmapData } from '../../../lib/roadmap-data';

export function getStaticPaths() {
    return roadmapData.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<RoadmapDetail item={item} lang="en" />
