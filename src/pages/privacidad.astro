<!-- Lógica del Scrollspy (JavaScript Nativo) -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Seleccionamos todos los H2 con ID y todos los links del índice
    const sections = document.querySelectorAll('.legal-content h2[id]');
    const navLinks = document.querySelectorAll('.toc-link');

    // Opciones del observador: El margen superior hace que se active un poco antes de llegar a la mitad de la pantalla
    const observerOptions = {
      root: null,
      rootMargin: '-100px 0px -60% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          
          // Removemos la clase active de todos
          navLinks.forEach(link => {
            link.classList.remove('active');
            // Si el link coincide con el ID de la sección visible, le ponemos active
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('active');
            }
          });
        }
      });
    }, observerOptions);

    // Observamos cada sección
    sections.forEach(section => observer.observe(section));

    // Reabrir el aviso de cookies (montado por <CookieConsent> en Layout.astro)
    const reopenBtn = document.getElementById('cc-reopen');
    if (reopenBtn) {
      reopenBtn.addEventListener('click', () => {
        if (typeof window.cordOpenCookiePrefs === 'function') window.cordOpenCookiePrefs();
      });
    }
  });
</script>

