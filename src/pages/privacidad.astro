---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/landing/Nav.astro';
import Footer from '../components/landing/Footer.astro';
import PageAnims from '../components/landing/PageAnims.astro';
import { getLangFromUrl } from '../i18n/utils';

import { getEntry } from 'astro:content';
import { signupLegalBundle } from '../lib/legal-corpus';
import { publishedLegalHtml } from '../lib/legal-publication';

export const prerender = true;

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const variant = signupLegalBundle(isEn ? 'en-US' : 'es-MX').privacy;
const entry = await getEntry('legal', `${variant.locale.toLowerCase()}/${variant.docId}`);
const legalHtml = publishedLegalHtml(entry, variant);
---

<Layout title={isEn ? "Privacy Policy | CORD by Flouvia" : "Aviso de Privacidad | CORD by Flouvia"}>
  <Nav />
  
  <PageAnims />

  <Fragment set:html={legalHtml} />

  <Footer />
</Layout>

<!-- Lógica del Scrollspy (JavaScript Nativo) -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Seleccionamos todos los H2 con ID y todos los links del índice
    const sections = document.querySelectorAll('.legal-content h2[id]');
    const navLinks = document.querySelectorAll('.toc-link');

    // Opciones del observador: El margen superior hace que se active un poco antes de llegar a la mitad de la pantalla
    const observerOptions = {
      root: null,
      rootMargin: '-100px 0px -60% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          
          // Removemos la clase active de todos
          navLinks.forEach(link => {
            link.classList.remove('active');
            // Si el link coincide con el ID de la sección visible, le ponemos active
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('active');
            }
          });
        }
      });
    }, observerOptions);

    // Observamos cada sección
    sections.forEach(section => observer.observe(section));

    // Reabrir el aviso de cookies (montado por <CookieConsent> en Layout.astro)
    const reopenBtn = document.getElementById('cc-reopen');
    if (reopenBtn) {
      reopenBtn.addEventListener('click', () => {
        if (typeof window.cordOpenCookiePrefs === 'function') window.cordOpenCookiePrefs();
      });
    }
  });
</script>

<style is:global>
  ::selection {
    background-color: var(--color-blue-deep);
    color: #ffffff;
  }

  html {
    scroll-behavior: smooth;
  }
</style>

<style>
  .legal-page {
    padding: 12rem 2rem 9rem; 
    min-height: 100vh;
    background-color: var(--color-bg);
    font-family: var(--font-sans), sans-serif;
  }
  
  .legal-header {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Forzando la tipografía tabular de CORD */
  .editorial {
    font-family: var(--font-sans), sans-serif;
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum" on;
  }

  h1.editorial {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1.5rem;
    color: var(--color-blue-deep);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .last-updated {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: 4rem;
  }

  .cc-reopen-link {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--color-blue-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .cc-reopen-link:hover { opacity: 0.75; }

  /* Grid Layout */
  .legal-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 5rem;
    max-width: 1000px;
    margin: 0 auto;
    align-items: start;
  }

  /* --- ESTILOS DEL SIDEBAR STICKY --- */
  .toc-sidebar {
    position: sticky;
    top: 120px; 
  }

  .toc-eyebrow {
    display: block;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 1.5rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--color-border);
  }

  .toc-link {
    display: block;
    padding: 0.5rem 0 0.5rem 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    position: relative;
    /* Microinteracción de movimiento fluido */
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                color 0.3s ease, 
                border-color 0.3s ease;
    margin-left: -1px; 
    border-left: 2px solid transparent;
    transform: translateX(0);
  }

  .toc-link:hover {
    color: var(--color-text);
    transform: translateX(3px); /* Toque táctil */
  }

  .toc-link.active {
    color: var(--color-blue-deep);
    font-weight: 600;
    border-left: 2px solid var(--color-blue-deep); 
    transform: translateX(3px);
  }

  /* --- ESTILOS DEL CONTENIDO --- */
  .legal-content {
    color: var(--color-text);
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .intro-box {
    background-color: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 3rem;
    /* Microinteracción: Sutil sombra al pasar el mouse */
    transition: box-shadow 0.4s var(--ease-smooth), transform 0.4s var(--ease-smooth);
  }
  
  .intro-box:hover {
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);
    transform: translateY(-2px);
  }

  .intro-box p {
    margin: 0;
    color: var(--color-text);
  }

  .legal-content h2.editorial {
    font-size: 1.5rem;
    margin-top: 5rem;
    margin-bottom: 1.5rem;
    color: var(--color-blue-deep);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: color 0.3s ease;
  }

  .legal-content h2.editorial .num {
    font-style: normal;
    font-weight: 300;
    color: var(--color-text-muted);
    opacity: 0.4;
    font-size: 1.25rem;
    transition: opacity 0.4s ease, color 0.4s ease;
  }

  /* Microinteracción: El número se enciende al leer la sección */
  .legal-content h2.editorial:hover .num {
    opacity: 0.8;
    color: var(--color-blue-deep);
  }

  .legal-content p {
    margin-bottom: 1.5rem;
    color: rgba(5, 5, 5, 0.85);
  }

  .legal-content p.legal-warning {
    padding: 1rem 1.1rem;
    border: 1px solid rgba(180, 83, 9, 0.24);
    border-radius: 10px;
    background: rgba(245, 158, 11, 0.07);
    color: #78350f;
    font-size: 0.92rem;
  }

  .legal-content ul {
    margin-bottom: 2rem;
    padding-left: 1.5rem;
    list-style-type: none;
  }

  .legal-content li {
    margin-bottom: 1rem;
    position: relative;
    color: rgba(5, 5, 5, 0.85);
  }

  .legal-content li::before {
    content: "";
    position: absolute;
    left: -1.25rem;
    top: 0.6rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-blue-deep);
    opacity: 0.4;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* Microinteracción en bullets */
  .legal-content li:hover::before {
    opacity: 0.8;
    transform: scale(1.2);
  }

  .legal-content strong {
    color: var(--color-blue-deep);
    font-weight: 600;
  }

  /* Enlaces en el texto con subrayado expansivo (Estilo Stripe/Linear) */
  .legal-content p a {
    color: var(--color-blue-deep);
    text-decoration: none;
    font-weight: 500;
    background-image: linear-gradient(var(--color-blue-deep), var(--color-blue-deep));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .legal-content p a:hover {
    background-size: 100% 1px;
  }

  .table-wrapper {
    overflow-x: auto;
    margin: 2rem 0;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }

  th, td {
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  th {
    background-color: var(--color-bg-soft);
    font-weight: 600;
    color: var(--color-blue-deep);
    letter-spacing: -0.01em;
  }

  /* Microinteracción: Hover de filas de tabla */
  tbody tr {
    transition: background-color 0.2s ease;
  }
  
  tbody tr:hover {
    background-color: var(--color-bg-soft);
  }

  tr:last-child td {
    border-bottom: none;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .legal-grid {
      grid-template-columns: 1fr;
    }
    .toc-sidebar {
      display: none;
    }
  }
</style>
