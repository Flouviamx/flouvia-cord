---
import { jsonForScript } from '../../lib/escape';

export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/landing/Nav.astro';
import Footer from '../../components/landing/Footer.astro';
import RibbonHeroBg from '../../components/RibbonHeroBg.jsx';
import CasoHeroMockup from '../../components/casos/CasoHeroMockup.astro';

// Ola de seda del hero (mismo shader que /soluciones), paleta VIOLETA → CIELO para equipos de desarrollo.
const HERO_PAL = { base: '#F6F9FC', c1: '#C4B5FD', c2: '#A78BFA', c3: '#7C3AED', c4: '#4F46E5', c5: '#0EA5E9' };
import FaqAccordion from '../../components/landing/FaqAccordion.astro';
import IntegrationsMarquee from '../../components/integraciones/IntegrationsMarquee.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const t = useTranslations(lang);

const metaTitle = "Cord para Software Factories — Propuestas por Fases y Anticipos";
const metaDesc = "Envía propuestas técnicas por fases, cobra anticipos y saldos, y emite tu factura desde cada cotización (CFDI 4.0 para negocios en México). Para dev shops y equipos de desarrollo.";

// FAQ + JSON-LD (jul 2026, auditoría SEO/AI-SEO) — preguntas ancladas a
// capacidades reales del producto.
const FAQS = [
    {
        q: '¿Puedo cobrar un proyecto por fases en vez de todo de una vez?',
        a: 'Sí. Divides el proyecto en fases (por ejemplo Setup, Core, Launch), cotizas cada una por separado y envías la cotización correspondiente cuando completas esa fase; tu cliente la aprueba con firma electrónica y paga desde su link. Dentro de una misma cotización también puedes pedir un anticipo y cobrar el saldo después, o dividir el pago en cuotas.',
    },
    {
        q: '¿Puedo agregar opciones (up-sells) que el cliente activa o desactiva antes de firmar?',
        a: 'Sí. El editor permite líneas adicionales — como "Migración a AWS" o "Soporte 24/7" — que el cliente puede incluir o quitar de la propuesta antes de aprobar, y el total se recalcula en vivo.',
    },
    {
        q: '¿El cliente puede pedir cambios a la propuesta antes de aprobarla?',
        a: 'Sí. Cord tiene un chat de negociación por cotización y por línea: tu cliente puede comentar, pedir ajustes o contraofertar un precio específico, y tú respondes desde el detalle sin salir de la plataforma.',
    },
    {
        q: '¿Necesito facturar en México para usar Cord con clientes extranjeros?',
        a: 'No necesariamente. Puedes cotizar y cobrar en USD con el tipo de cambio congelado 30 días. Si tu negocio es mexicano, emites CFDI 4.0 con esa divisa y ese tipo de cambio; si facturas desde fuera de México, Cord genera factura comercial.',
    },
];
const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: 'https://cordhq.app/' },
        { '@type': 'ListItem', position: 2, name: 'Software Factory', item: 'https://cordhq.app/casos-de-uso/software-factory' },
    ],
};



import { iconInner } from '../../lib/icons';
---


<Layout title={metaTitle} description={metaDesc}>
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(faqSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(breadcrumbSchema)} />
    <Nav />

    <main class="use-case-main">
        <!-- HERO -->
        <header class="startup-hero">
            <div class="startup-hero-bg">
                <RibbonHeroBg client:only="react" light colors={HERO_PAL} />
            </div>
            <div class="startup-hero-grid">
            <div class="startup-hero-content">
                <h1 class="startup-title reveal">De la propuesta al cobro para <span class="startup-title-accent">desarrollo de software</span></h1>
                <p class="startup-sub">
                    Formaliza proyectos complejos con propuestas técnicas que tu cliente aprueba con firma electrónica. Cotiza por fases, cobra el anticipo al aprobar y el saldo al entregar.
                </p>
                <div class="startup-actions">
                    <a href="/sign-up" class="btn-luxe">
                        <span>Empezar ahora</span>
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg>
                        <div class="btn-shimmer"></div>
                    </a>
                    <a href="/contacto/ventas" class="btn-ghost"><span>Contactar a ventas</span></a>
                </div>
            </div>
            <div class="startup-hero-visual">
                <CasoHeroMockup variant="software-factory" />
            </div>
            </div>
        </header>

        <!-- INTEGRACIONES: el mismo marquee 3D de /integraciones -->
        <section class="uc-trust reveal">
            <p>Se conecta con las herramientas que ya usa tu equipo</p>
            <IntegrationsMarquee />
        </section>

        <!-- SECONDARY BENEFITS SECTION -->
        <section class="uc-benefits">
            <div class="uc-container">
                <div class="uc-benefits-intro reveal">
                    <h2 class="uc-split-title">Cobra cada fase técnica a tiempo</h2>
                    <p class="uc-split-desc">
                        El desarrollo de software tiene su propio ritmo. Conecta tus herramientas por API y webhooks para que cada entregable aprobado llegue a tu proceso de cobro.
                    </p>
                </div>

                <div class="uc-bento-cards">
                    <!-- Tarjeta 1 -->
                    <div class="uc-bento-card reveal">
                        <div class="uc-bc-text">
                            <h3>Cobros por fase del proyecto</h3>
                            <p>Divide el proyecto en fases — Setup, Core, Launch — y cotiza cada una por separado. Cuando completes una fase, envías su cotización y el cliente la aprueba con firma electrónica desde su link.</p>
                            <a href="/sign-up" class="uc-link-arrow">Crear propuesta por fases <span>&rarr;</span></a>
                        </div>
                        <div class="uc-bc-mockup">
                            <!-- Calca de /app/clientes/[id]: una cotización por fase del proyecto,
                                 cada una con su propio estado ("Cotizaciones" y "Qué le vendes"). -->
                            <div class="ucm-shot">
                                <div class="ucm-dh">
                                    <span class="ucm-dh-av">TA</span>
                                    <span class="ucm-dh-who">
                                        <b class="ucm-dh-name">Transportes Arrieta</b>
                                        <small>Mónica Arrieta · ti@arrieta.mx · 81 2210 4476</small>
                                    </span>
                                    <span class="ucm-dh-tot"><small>Cerrado</small><b class="editorial">$301,600<i class="ucm-cur">MXN</i></b></span>
                                </div>
                                <div class="ucm-sec">Cotizaciones</div>
                                <div class="ucm-qrow"><span class="ucm-qfolio">COT-0203</span><span class="ucm-pill" style="color:#2563eb;background:rgba(37,99,235,0.09)">Enviada</span><span class="editorial ucm-r">$162,400<i class="ucm-cur">MXN</i></span><span class="ucm-date ucm-r">29 sep 2026</span><svg class="ucm-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-right')}></svg></div><div class="ucm-qrow"><span class="ucm-qfolio">COT-0202</span><span class="ucm-pill" style="color:#059669;background:rgba(16,185,129,0.1)">Aprobada</span><span class="editorial ucm-r">$208,800<i class="ucm-cur">MXN</i></span><span class="ucm-date ucm-r">1 sep 2026</span><svg class="ucm-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-right')}></svg></div><div class="ucm-qrow"><span class="ucm-qfolio">COT-0201</span><span class="ucm-pill" style="color:#059669;background:rgba(16,185,129,0.14)">Pagada</span><span class="editorial ucm-r">$92,800<i class="ucm-cur">MXN</i></span><span class="ucm-date ucm-r">4 ago 2026</span><svg class="ucm-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-right')}></svg></div>
                                <div class="ucm-sec ucm-sec-gap">Qué le vendes</div>
                                <div class="ucm-prow"><span>Fase 3 · App móvil y lanzamiento</span><small>1×</small><b class="editorial">$140,000<i class="ucm-cur">MXN</i></b></div><div class="ucm-prow"><span>Fase 2 · Core backend y API</span><small>1×</small><b class="editorial">$180,000<i class="ucm-cur">MXN</i></b></div><div class="ucm-prow"><span>Fase 1 · Setup e infraestructura</span><small>1×</small><b class="editorial">$80,000<i class="ucm-cur">MXN</i></b></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tarjeta 2 -->
                    <div class="uc-bento-card reveal">
                        <div class="uc-bc-text">
                            <h3>Propuestas técnicas modulares</h3>
                            <p>Crea cotizaciones detalladas que tus clientes entienden, con opciones adicionales y up-sells (como "Migración AWS" o "Soporte 24/7") que pueden activar o desactivar antes de firmar.</p>
                            <a href="/sign-up" class="uc-link-arrow">Genera propuestas técnicas <span>&rarr;</span></a>
                        </div>
                        <div class="uc-bc-mockup">
                            <!-- Calca de /q/[token] (QuoteCard): el cliente desmarca una línea y aprueba
                                 solo lo que quiere; la nota y el total se recalculan. -->
                            <div class="ucm-shot ucm-q is-late" style="--brand:#312e81">
                                <div class="ucm-url"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('lock')}></svg>cordhq.app/q/c87399c8ec8eb69d80af3e05541e06f2</span></div>
                                <div class="ucm-qcard ucm-qcard-cut">
                                    <div class="ucm-qi-h"><span>CONCEPTO</span><span>CANT.</span><span class="ucm-r">P. UNIT.</span><span class="ucm-r">IMPORTE</span></div>
                                    <div class="ucm-qi-r"><span class="ucm-qi-n"><i class="ucm-pick on"></i><span>App móvil iOS y Android</span></span><span class="ucm-qi-q">1 servicio</span><span class="editorial ucm-r ucm-qi-p">$186,000.00</span><span class="editorial ucm-r">$186,000.00</span></div><div class="ucm-qi-r"><span class="ucm-qi-n"><i class="ucm-pick on"></i><span>Panel de administración web</span></span><span class="ucm-qi-q">1 servicio</span><span class="editorial ucm-r ucm-qi-p">$94,000.00</span><span class="editorial ucm-r">$94,000.00</span></div><div class="ucm-qi-r off"><span class="ucm-qi-n"><i class="ucm-pick"></i><span>Soporte extendido 24/7 (12 meses)</span></span><span class="ucm-qi-q">1 servicio</span><span class="editorial ucm-r ucm-qi-p">$72,000.00</span><span class="editorial ucm-r">$72,000.00</span></div>
                                    <div class="ucm-qt"><span><em>Subtotal</em><b class="editorial">$280,000.00</b></span><span><em>IVA 16%</em><b class="editorial">$44,800.00</b></span><span class="g"><em>Total</em><b class="editorial">$324,800.00</b></span></div>
                                    <div class="ucm-partial">Aprobarás <b>2 de 3 líneas</b> · Total a aprobar: <b class="editorial">$324,800.00 MXN</b></div>
                                    <span class="ucm-cta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('check')}></svg>Aprobar cotización</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Micro Features Grid -->
                <div class="uc-micro-features reveal">
                    <h3 class="uc-mf-title">Diseñado para el ecosistema de desarrollo</h3>
                    <div class="uc-mf-grid">
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('code')}></svg>
                            </div>
                            <h4>API REST nativa</h4>
                            <p>Integra Cord con tus herramientas internas vía nuestra <a href="/desarrolladores/api" class="uc-link-inline">API REST</a>. Crea cotizaciones, y consulta y crea clientes y productos directamente desde tu código.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('products')}></svg>
                            </div>
                            <h4>Webhooks con firma HMAC</h4>
                            <p>Escucha eventos reales — <code>quote.approved</code>, <code>quote.paid</code> — con firma <code>X-Cord-Signature: sha256=…</code>. Conecta tu backend, Zapier o Make al instante.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('globe')}></svg>
                            </div>
                            <h4>Cobros Internacionales</h4>
                            <p>Cotiza y cobra a clientes en el extranjero en su <a href="/producto/divisas" class="uc-link-inline">moneda</a> (USD, EUR y otras divisas); el depósito llega a tu cuenta de cobros.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('clock')}></svg>
                            </div>
                            <h4>Soporte y horas adicionales</h4>
                            <p>Agrega líneas de soporte o consultoría a cualquier cotización o <a href="/producto/facturacion" class="uc-link-inline">factura</a>, con su cantidad de horas y tarifa.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    

        <!-- INTEGRATIONS SECTION -->
        



    
                <!-- POWER SECTION -->
        <section class="uc-power">
            <div class="uc-container">
                <h2 class="uc-power-title reveal">Cobra cada entregable con precisión y sin fricciones</h2>
                <div class="uc-power-grid">
                    <div class="uc-power-item reveal">
                        <h3>CFDI 4.0 por cada fase</h3>
                        <p>Cuando tu cliente aprueba la cotización de una fase, emites su CFDI 4.0 con un clic, timbrado por un PAC certificado. El XML y el PDF quedan disponibles al instante sin salir de Cord.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Propuestas con módulos opcionales</h3>
                        <p>Agrega partidas opcionales a tu cotización — "Soporte extendido 3 meses", "Setup de infraestructura" — y el cliente decide qué incluir antes de firmar. Tú controlas los márgenes con el Auditor Silencioso (plan Scale).</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Multi-divisa para clientes internacionales</h3>
                        <p>Cotiza en USD o EUR con el tipo de cambio congelado 30 días, y un margen de cobertura de 1, 2 o 5%. Tu cliente ve y paga en su moneda; el CFDI declara ese tipo de cambio.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Margen mínimo en cada cotización</h3>
                        <p>El Auditor Silencioso revisa el margen bruto de cada línea con costo y, si baja del mínimo que defines, la cotización espera la aprobación de tu equipo antes de salir (plan Scale).</p>
                    </div>
                </div>
            </div>
        </section>


        

        <FaqAccordion
            faqs={FAQS}
            title="Lo que preguntan los equipos de desarrollo antes de empezar."
            id="software-factory"
            class="uc-faq-acc"
        />
    </main>
    <Footer />

</Layout>

<style>
    :global(.uc-faq-acc) { padding: 5rem 5% 7rem; }

    .uc-int-card {
        background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=2000'); background-size: cover; background-position: center;
        border-radius: 24px;
        padding: 4rem;
        text-align: center;
        max-width: 900px;
        margin: 0 auto 3rem;
        color: #fff;
    }
    .uc-int-card h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
        color: #fff;
    }
    .uc-int-card p {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #cbd5e1;
        max-width: 700px;
        margin: 0 auto;
    }
    .uc-int-card code {
        background: rgba(255,255,255,0.1);
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
    }
    .uc-int-logos {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        align-items: center;
        padding: 2rem 0;
    }
    .uc-logo-badge {
        font-size: 1.25rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: -0.02em;
        transition: color 0.3s;
    }
    .uc-logo-badge:hover {
        color: #0f172a;
    }
    
    .uc-power-item h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0a2540;
        margin-bottom: 0.75rem;
    }
    .uc-power-item p {
        font-size: 0.95rem;
        color: #425466;
        line-height: 1.5;
    }
    @media (max-width: 900px) {
        .uc-power-grid { grid-template-columns: 1fr 1fr; }
        .uc-int-card { padding: 3rem 1.5rem; }
        .uc-int-card h2 { font-size: 2rem; }
    }
    @media (max-width: 600px) {
        .uc-power-grid { grid-template-columns: 1fr; }
    }
    

    .uc-logo-img {
        height: 36px;
        width: auto;
        opacity: 0.7;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .uc-logo-badge:hover .uc-logo-img {
        opacity: 1;
        transform: scale(1.05);
    }
    
</style>

<style>
    /* VARIABLES Y UTILIDADES GLOBALES PARA USE CASES */
    .use-case-main {
        background: #fff;
        padding-top: 0;
        overflow-x: hidden;
        color: #425466; /* Texto Stripe */
    }

    .uc-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 5%;
    }

    /* ── HERO — layout de soluciones/startups: texto a la izquierda y, a la
       derecha, una calca de pantalla real (CasoHeroMockup) sobre la ola de seda. ── */
    .startup-hero {
        position: relative;
        padding: 150px 0 90px;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
        background: #f6f9fc;
    }

    /* Respaldo sin WebGL: la misma composición con degradados. */
    .startup-hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        background: linear-gradient(118deg, #f6f9fc 0%, #f6f9fc 42%, #C4B5FD 44%, #A78BFA 52%, #7C3AED 64%, #4F46E5 80%, #0EA5E9 100%);
    }
    /* Velo claro detrás del texto. */
    .startup-hero-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(246, 249, 252, 0.6) 0%, rgba(246, 249, 252, 0.25) 38%, transparent 55%);
    }

    .startup-hero-grid {
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        gap: 56px;
        align-items: center;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 20px;
    }

    .startup-hero-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        min-width: 0;
    }

    .startup-hero-visual {
        display: flex;
        justify-content: flex-end;
        min-width: 0;
    }

    .startup-title {
        /* Tamaño estándar de títulos (h1.masked-title, Layout.astro). */
        font-size: clamp(2.1rem, 3.4vw, 3.6rem);
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.035em;
        margin: 0 0 1.75rem;
        color: #050505;
        text-wrap: balance;
        max-width: 660px;
    }
    /* El vertical, en los tonos de su paleta (un paso más profundos para que
       se lean sobre claro). */
    .startup-title-accent {
        background: linear-gradient(92deg, #7c3aed 0%, #6d28d9 55%, #4338ca 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: #6d28d9;
    }

    .startup-sub {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        line-height: 1.6;
        color: #425466;
        max-width: 540px;
        margin: 0 0 2.4rem 0;
        font-weight: 400;
    }

    .startup-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .startup-hero .btn-ghost {
        color: #0a2540;
        border: 1px solid rgba(10, 37, 64, 0.15);
        background: rgba(255, 255, 255, 0.55);
    }

    .startup-hero .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.8);
        box-shadow: 0 6px 16px rgba(0,0,0,0.05);
    }

    @media (max-width: 880px) {
        .startup-hero { padding: 120px 0 64px; min-height: auto; }
        .startup-hero-grid { grid-template-columns: 1fr; gap: 48px; }
        .startup-hero-visual { justify-content: center; }
        .startup-hero-bg::after {
            background: linear-gradient(180deg, rgba(246, 249, 252, 0.72) 0%, rgba(246, 249, 252, 0.3) 45%, transparent 65%);
        }
    }
    @media (max-width: 520px) {
    }

    .uc-title {
        font-size: clamp(2.2rem, 4vw, 3.8rem);
        font-weight: 800;
        color: #0a2540;
        line-height: 1.1;
        letter-spacing: -0.04em;
        margin-bottom: 1.2rem;
        text-wrap: balance;
    }

    .uc-sub {
        font-size: 1.15rem;
        color: #425466;
        line-height: 1.6;
        margin-bottom: 2rem;
        max-width: 90%;
    }

    .uc-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    /* ── BUTTONS (estilo soluciones/startups) ── */
    .btn-luxe {
        position: relative;
        display: inline-flex; align-items: center; justify-content: center;
        background: #0a2540; color: #fff;
        padding: 18px 38px; border-radius: 100px;
        font-size: 0.95rem; font-weight: 600; text-decoration: none;
        overflow: hidden;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 24px rgba(10, 37, 64, 0.2);
    }
    .btn-luxe span { position: relative; z-index: 2; }
    .btn-arrow {
        position: relative; z-index: 2; display: inline-block;
        width: 16px; height: 16px; margin-left: 6px;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-luxe:hover .btn-arrow { transform: translateX(4px); }
    .btn-shimmer {
        position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
        transform: skew(-20deg); transition: 0s; z-index: 1;
    }
    .btn-luxe:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(10, 37, 64, 0.3);
    }
    .btn-luxe:active {
        transform: translateY(-1px);
        box-shadow: 0 2px 4px rgba(10, 37, 64, 0.1);
    }
    .btn-luxe:hover .btn-shimmer {
        left: 150%;
        transition: left 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-ghost {
        display: inline-flex; align-items: center; gap: 9px;
        color: #0a2540; text-decoration: none;
        font-size: 1rem; font-weight: 600;
        padding: 15px 26px; border-radius: 100px;
        border: 1px solid rgba(10, 37, 64, 0.15);
        background: rgba(10, 37, 64, 0.03);
        transition: background 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }
    .btn-ghost:hover {
        background: rgba(10, 37, 64, 0.08);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
    }

    /* ── TRUST LOGOS ── */
    .uc-trust {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 3rem 5%;
    }
    .uc-trust p {
        font-size: 0.95rem; font-weight: 500; color: #687385; margin-bottom: 1.5rem;
    }

    /* ── STRIPE-LIKE SPLIT FEATURE ── */
    .uc-split-feature {
        padding: 6rem 0;
        background: #ffffff;
        
    }
    
    .uc-split-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 6rem;
        align-items: center;
    }

    .uc-split-text {
        max-width: 480px;
    }


    .uc-split-title {
        font-size: clamp(2.2rem, 3.5vw, 3rem);
        font-weight: 800;
        color: #0a2540;
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin-bottom: 1.5rem;
        text-wrap: balance;
    }

    .uc-split-desc {
        font-size: 1.1rem;
        color: #425466;
        line-height: 1.6;
        margin-bottom: 3.5rem;
    }
    .uc-split-desc a {
        color: #0a2540;
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px solid rgba(10,37,64,0.2);
        padding-bottom: 2px;
        transition: border-color 0.2s;
    }
    .uc-split-desc a:hover {
        border-color: #0a2540;
    }

    .uc-feature-item {
        display: flex;
        gap: 1.25rem;
        margin-bottom: 3rem;
    }

    .uc-feature-icon {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
    }
    .uc-feature-icon svg {
        width: 100%;
        height: 100%;
    }

    .uc-feature-content h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0a2540;
        margin-bottom: 0.8rem;
        line-height: 1.35;
    }

    .uc-feature-content p {
        font-size: 1rem;
        color: #425466;
        line-height: 1.6;
    }
    .uc-feature-content a {
        color: #0a2540;
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px solid rgba(10,37,64,0.2);
        padding-bottom: 2px;
        transition: border-color 0.2s;
    }
    .uc-feature-content a:hover {
        border-color: #0a2540;
    }

    /* MOCKUP UI */
    .uc-split-mockup {
        position: relative;
    }

    /* Ventana cmk-* (kit compartido de mockups, calca estilo Stripe) */
    .uc-cmk-window {
        position: relative;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        text-align: left;
        border: 1px solid rgba(10, 25, 47, 0.08);
        box-shadow:
            0 2px 4px rgba(10, 25, 47, 0.05),
            0 40px 80px -24px rgba(10, 25, 47, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .uc-mockup-wrapper {
        position: relative;
        background: #f5f5f7;
        border-radius: 12px;
        border: 1px solid rgba(10,37,64,0.06);
        box-shadow: 0 40px 80px -20px rgba(10,37,64,0.12), 0 20px 40px -20px rgba(10,37,64,0.08);
        overflow: hidden;
    }
    
    .uc-mockup-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 24px;
        background: #fff;
        
    }
    
    .uc-mockup-logo {
        font-weight: 800;
        color: #0a2540;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
    }
    
    .uc-mockup-nav {
