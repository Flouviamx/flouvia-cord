    }
    .uc-sf-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        text-align: left;
    }
    .uc-sf-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #0a2540;
    }
    .uc-sf-amount {
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 500;
    }
    .uc-sf-status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .uc-sf-done .uc-sf-status {
        color: #10b981;
    }
    .uc-sf-locked .uc-sf-status {
        color: #94a3b8;
    }
    .uc-sf-btn {
        background: #0f172a;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .uc-sf-btn:hover {
        background: #1e293b;
    }
    
    @media (max-width: 900px) {
        .uc-split-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
        }
        .uc-split-text {
            max-width: 100%;
        }
        .uc-mockup-nav { display: none; }
        .uc-mockup-features { grid-template-columns: 1fr; gap: 24px; text-align: center; }
        .uc-mockup-features li::before { display: none; }
        .uc-mockup-features li { padding-left: 0; }
        .uc-mockup-cards { grid-template-columns: 1fr; gap: 16px; margin-bottom: 24px; }
        .uc-mc-1, .uc-mc-3 { border-radius: 8px; border: 1px solid rgba(10,25,47,0.06); }
        .uc-mc-2 { padding: 24px 16px; }
    }

    /* ── CTA SECTION ── */
    .uc-cta-section {
        padding: 4rem 0 8rem;
        background: #fff;
    }
    .uc-cta-box {
        background: #0a192f;
        border-radius: 20px;
        padding: 4rem 2rem;
        text-align: center;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(10,37,64,0.25);
    }
    .uc-cta-box::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at center top, rgba(255,255,255,0.08), transparent 70%);
        pointer-events: none;
    }
    .uc-cta-box h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 1rem; position: relative; z-index: 1; }
    .uc-cta-box p { font-size: 1.1rem; color: #aab7c4; margin-bottom: 2rem; position: relative; z-index: 1; }
    .uc-cta-box .btn-luxe { background: #ffffff; color: #0a2540; box-shadow: 0 4px 14px rgba(255,255,255,0.1); }
    .uc-cta-box .btn-luxe:hover { background: #f8fafc; box-shadow: 0 6px 20px rgba(255,255,255,0.2); }

    @media (max-width: 900px) {
        .uc-hero { padding: 9rem 0 6rem; }
        .uc-hero-content { max-width: 100%; }
        .uc-title { font-size: 2.5rem; }
        .uc-bento-grid { grid-template-columns: 1fr; }
    }
    /* ── SECONDARY BENEFITS (STRIPE STYLE) ── */
    .uc-benefits {
        padding: 5rem 0 7rem;
        background: #ffffff;
        
    }
    .uc-benefits-intro {
        text-align: left;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        column-gap: 4rem;
        align-items: start;
        max-width: none;
        margin-bottom: 4rem;
    }
    .uc-benefits-intro > .uc-split-title { margin: 0; }
    .uc-benefits-intro > .uc-split-desc { margin: 0; max-width: 520px; }
    @media (max-width: 880px) {
        .uc-benefits-intro { grid-template-columns: 1fr; row-gap: 1.2rem; }
    }
    .uc-bento-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        margin-bottom: 6rem;
    }
    .uc-bento-card {
        background: #fff;
        display: flex;
        flex-direction: column;
    }
    .uc-bc-text {
        padding-right: 2rem;
        margin-bottom: 2.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .uc-bc-text h3 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0a2540;
        margin-bottom: 1rem;
        line-height: 1.25;
        letter-spacing: -0.02em;
    }
    .uc-bc-text p {
        font-size: 1.05rem;
        color: #425466;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }
    .uc-link-arrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #0f172a;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: color 0.2s;
        margin-top: auto;
    }
    .uc-link-arrow:hover {
        color: #334155;
    }
    .uc-link-arrow span {
        transition: transform 0.2s;
    }
    .uc-link-arrow:hover span {
        transform: translateX(4px);
    }

    /* Mockups dentro de bento cards: el lienzo gris ES el de la app; la calca
       (.ucm-shot) se recorta y se desvanece abajo. */
    .uc-bc-mockup {
        background: #f5f5f7;
        border-radius: 16px;
        padding: 0;
        height: 320px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(10,37,64,0.06);
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);
    }
    .cord-bg-1 {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #0a2540 0%, #1e293b 100%);
        clip-path: polygon(0 0, 100% 0, 100% 60%, 0 80%);
