    }
    .uc-mf-item h4 {
        font-size: 1rem;
        font-weight: 700;
        color: #0a2540;
        margin-bottom: 0.8rem;
    }
    .uc-mf-item p {
        font-size: 0.95rem;
        color: #425466;
        line-height: 1.6;
    }
    .uc-link-inline {
        color: #0f172a;
        text-decoration: none;
        font-weight: 700;
        border-bottom: 1px solid rgba(15,23,42,0.2);
        padding-bottom: 1px;
