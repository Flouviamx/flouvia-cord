        font-weight: 600;
        background: #f1f5f9;
        padding: 4px 10px;
        border-radius: 6px;
    }
    
    .uc-mockup-body {
        background: #f8fafc;
        border-top: 1px solid rgba(10,37,64,0.06);
    }
    
    .uc-sf-milestones {
        background: #fff;
        border: 1px solid rgba(10,37,64,0.08);
        border-radius: 12px;
