    }
    .uc-sf-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .uc-sf-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
