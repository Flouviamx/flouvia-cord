---

export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/landing/Nav.astro';
import Footer from '../../components/landing/Footer.astro';
import RibbonHeroBg from '../../components/RibbonHeroBg.jsx';
import CasoHeroMockup from '../../components/casos/CasoHeroMockup.astro';

// Ola de seda del hero (mismo shader que /soluciones), paleta TURQUESA → ÍNDIGO para empresas de software.
const HERO_PAL = { base: '#F6F9FC', c1: '#5EEAD4', c2: '#22D3EE', c3: '#3B82F6', c4: '#6366F1', c5: '#8B5CF6' };
import FaqAccordion from '../../components/landing/FaqAccordion.astro';
import { INTEGRATION_APPS } from '../../lib/integraciones/catalogo';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const t = useTranslations(lang);

const metaTitle = "Cord para SaaS — Contratos, Cobros y Facturación";
const metaDesc = "Cierra contratos, cobra en línea y factura automáticamente (CFDI 4.0 para negocios en México). La plataforma de ventas para empresas de software en cualquier país.";

// FAQ + JSON-LD (jul 2026, auditoría SEO/AI-SEO — mismo criterio que
// /producto/*): esta página no tenía FAQ visible ni ningún dato
// estructurado. Preguntas ancladas a capacidades reales del producto (no al
// copy de marketing de la página, para no heredar afirmaciones de más).
const FAQS = [
    {
        q: '¿Cord reemplaza mi motor de facturación recurrente (Stripe Billing, Chargebee)?',
        a: 'No. Cord no cobra suscripciones de forma recurrente — se especializa en el ciclo de cierre comercial: propuesta, aprobación digital y CFDI 4.0 por cada contrato o renovación. Sigues usando Stripe u otra pasarela para el cobro recurrente; Cord se integra vía API y webhooks para mantener todo sincronizado.',
    },
    {
        q: '¿Puedo sincronizar Cord con mi CRM o Slack?',
        a: 'Sí. Cord emite webhooks (quote.sent, quote.approved, quote.paid) que puedes conectar a Zapier, Make, n8n o tu propio backend para sincronizar con Notion, Slack o el CRM que ya uses.',
    },
    {
        q: '¿El CFDI 4.0 que emite Cord es real o simulado?',
        a: 'Es real: Cord timbra ante el SAT vía un PAC certificado (Facturapi). El XML y el PDF quedan disponibles desde el portal del cliente y desde tu cuenta, sin recapturar datos en otro sistema.',
    },
    {
        q: '¿Necesito tarjeta para probar Cord con mi equipo?',
        a: 'No. El plan gratuito de Cord no pide tarjeta: hasta 5 cotizaciones activas, catálogo y clientes limitados, y armado de cotizaciones con IA incluido para probar el flujo completo.',
    },
];
const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: 'https://cordhq.app/' },
        { '@type': 'ListItem', position: 2, name: 'SaaS', item: 'https://cordhq.app/casos-de-uso/saas' },
    ],
};




// Integraciones reales y disponibles hoy (regla 15): nada de logos de clientes
// que no lo son.
const CONECTA = INTEGRATION_APPS.filter((a) => a.disponible);
---


<Layout title={metaTitle} description={metaDesc}>
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <Nav />

    <main class="use-case-main">
        <!-- HERO -->
        <header class="startup-hero">
            <div class="startup-hero-bg">
                <RibbonHeroBg client:only="react" light colors={HERO_PAL} />
            </div>
            <div class="startup-hero-grid">
            <div class="startup-hero-content">
                <h1 class="startup-title reveal">De la propuesta al cobro para <span class="startup-title-accent">empresas de software</span></h1>
                <p class="startup-sub">
                    Transforma los acuerdos verbales en transacciones pagadas. Gestiona renovaciones anuales, firmas de contratos y facturación (CFDI 4.0 para negocios en México). Construido para empresas de software en cualquier país.
                </p>
                <div class="startup-actions">
                    <a href="/sign-up" class="btn-luxe">
                        <span>Empezar ahora</span>
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        <div class="btn-shimmer"></div>
                    </a>
                    <a href="/contacto/ventas" class="btn-ghost"><span>Contactar a ventas</span></a>
                </div>
            </div>
            <div class="startup-hero-visual">
                <CasoHeroMockup variant="saas" />
            </div>
            </div>
        </header>

        <!-- INTEGRACIONES (reales, del catálogo) -->
        <section class="uc-trust reveal">
            <p>Se conecta con las herramientas que ya usa tu equipo</p>
            <div class="uc-logos">
                {CONECTA.map((a) => (
                    <a href="/integraciones" class="trust-logo-item">
                        <img src={a.logo} alt="" width="24" height="24" loading="lazy" />
                        <span>{a.nombre}</span>
                    </a>
                ))}
            </div>
        </section>

        <!-- SECONDARY BENEFITS SECTION -->
        <section class="uc-benefits">
            <div class="uc-container">
                <div class="uc-benefits-intro reveal">
                    <h2 class="uc-split-title">Cobra rápido y mantén a tu equipo enfocado en el producto</h2>
                    <p class="uc-split-desc">
                        Tu equipo de ventas genera la propuesta en Cord, el cliente la aprueba en un clic y el CFDI sale solo. Sin perseguir firmas ni capturar datos fiscales manualmente.
                    </p>
                </div>

                <div class="uc-bento-cards">
                    <!-- Tarjeta 1 -->
                    <div class="uc-bento-card reveal">
                        <div class="uc-bc-text">
                            <h3>Link de pago y CFDI en el mismo flujo</h3>
                            <p>Tu cliente recibe el link de la cotización, paga con tarjeta o SPEI, y Cord emite el CFDI 4.0 al instante. Sin recapturar datos, sin coordinar por correo.</p>
                            <a href="/sign-up" class="uc-link-arrow">Empieza ahora mismo <span>&rarr;</span></a>
                        </div>
                        <div class="uc-bc-mockup">
                            <!-- Calca de la columna lateral de /app/cotizaciones/[id] en estado Pagada:
                                 el CFDI se timbra con el botón del vendedor, después del pago. -->
                            <div class="ucm-shot">
                                <div class="ucm-tbr">
                                    <span class="ucm-pill" style="color:#059669;background:rgba(16,185,129,0.14)">Pagada</span>
                                    <span class="ucm-tb-create"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Crear</span>
                                    <span class="ucm-tb-av">LC</span>
                                </div>
                                <div class="ucm-sec">Acciones</div>
                                <span class="ucm-act-cfdi">Timbrar CFDI 4.0</span>
                                <div class="ucm-act-grid">
                                    <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>Abrir link</span>
                                    <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copiar link</span>
                                    <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>PDF</span>
                                    <span class="wa"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.7-.85-2-.95-.26-.1-.46-.15-.65.15-.2.3-.74.94-.9 1.13-.17.2-.34.22-.63.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.46.13-.6.13-.14.3-.34.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.65-1.57-.9-2.15-.24-.56-.48-.48-.65-.49h-.56c-.2 0-.5.07-.77.37-.26.3-1 .98-1 2.4 0 1.4 1.03 2.76 1.17 2.96.14.2 2.02 3.08 4.9 4.32.68.3 1.22.47 1.64.6.69.22 1.31.19 1.8.12.55-.08 1.7-.7 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.2-.56-.34zM12 2a10 10 0 0 0-8.6 15.06L2 22l5.06-1.33A10 10 0 1 0 12 2z"/></svg>WhatsApp</span>
                                </div>
                                <span class="ucm-act-sec">Duplicar cotización</span>
                                <div class="ucm-sec ucm-sec-gap">Actividad</div>
                                <div class="ucm-tl"><div class="ucm-tl-i"><span class="ucm-tl-dot" style="background:#10b981"></span><span class="ucm-tl-b"><span>Pago recibido con Cord Payments; cotización saldada</span><small>hoy, 11:24</small></span></div><div class="ucm-tl-i"><span class="ucm-tl-dot" style="background:#10b981"></span><span class="ucm-tl-b"><span>Firmado digitalmente por "Andrea Salinas" (IP 187.190.44.12)</span><small>ayer, 17:52</small></span></div><div class="ucm-tl-i"><span class="ucm-tl-dot" style="background:#7c3aed"></span><span class="ucm-tl-b"><span>Abierta por el cliente desde el link</span><small>ayer, 17:40</small></span></div><div class="ucm-tl-i"><span class="ucm-tl-dot" style="background:#3b82f6"></span><span class="ucm-tl-b"><span>Cotización enviada — link generado</span><small>28 sep, 10:05</small></span></div></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tarjeta 2 -->
                    <div class="uc-bento-card reveal">
                        <div class="uc-bc-text">
                            <h3>Portal de cliente con tu marca en minutos</h3>
                            <p>Cada cotización tiene su propio link seguro donde tu cliente revisa el desglose, descarga el PDF y el XML, aprueba o rechaza con firma digital. Todo en los colores de tu empresa.</p>
                            <a href="/sign-up" class="uc-link-arrow">Empieza ahora mismo <span>&rarr;</span></a>
                        </div>
                        <div class="uc-bc-mockup">
                            <!-- Calca de /q/[token] (QuoteCard) con la página desplazada hasta la
                                 aprobación: totales, estado en vivo y el paso de firma digital. -->
                            <div class="ucm-shot ucm-q is-late" style="--brand:#0f3d56">
                                <div class="ucm-url"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" fill="currentColor" fill-opacity="0.15"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>cordhq.app/q/84de3ab68f5e35d047f54bc3ca93c1ac</span></div>
                                <div class="ucm-qcard ucm-qcard-cut">
                                    <div class="ucm-qi-r"><span class="ucm-qi-n"><span>Soporte prioritario (12 meses)</span></span><span class="ucm-qi-q">1 servicio</span><span class="editorial ucm-r ucm-qi-p">$36,000.00</span><span class="editorial ucm-r">$36,000.00</span></div>
                                    <div class="ucm-qt"><span><em>Subtotal</em><b class="editorial">$360,000.00</b></span><span><em>IVA 16%</em><b class="editorial">$57,600.00</b></span><span class="g"><em>Total</em><b class="editorial">$417,600.00</b></span></div>
                                    <div class="ucm-qtrust"><span class="ucm-live"><i></i>Conectado en tiempo real</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" fill="currentColor" fill-opacity="0.15"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Cifrado · firma con validez legal</span></div>
                                    <div class="ucm-sign">
                                        <div class="ucm-sign-h"><span class="ucm-back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></span>Firma digital</div>
                                        <p class="ucm-sign-p">Aprobando <b>COT-0342</b> por <b style="color:var(--brand)">$417,600.00 MXN</b></p>
                                        <span class="ucm-lbl">Nombre completo del firmante</span>
                                        <span class="ucm-input">Andrea Salinas</span>
                                        <span class="ucm-check"><i></i>He revisado esta cotización y acepto los términos y condiciones indicados</span>
                                        <span class="ucm-cta">Confirmar y firmar</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Micro Features Grid -->
                <div class="uc-micro-features reveal">
                    <h3 class="uc-mf-title">Más velocidad en cada etapa del ciclo comercial</h3>
                    <div class="uc-mf-grid">
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" fill="currentColor" fill-opacity="0.12"></path><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                            </div>
                            <h4>Webhooks en cada evento</h4>
                            <p>Cord emite eventos reales — <code>quote.approved</code>, <code>quote.paid</code>, <code>quote.invoiced</code> — que puedes escuchar desde Zapier, Make o tu propio backend.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" fill="currentColor" fill-opacity="0.12"></circle><circle cx="12" cy="12" r="10"></circle><path d="M16.2 7.8l-2 6.3-6.4 2.1 2-6.3z"></path></svg>
                            </div>
                            <h4>Cobranza automática</h4>
                            <p>Si un contrato vence y no se ha pagado, Cord envía recordatorios por correo y WhatsApp antes del vencimiento sin que tengas que intervenir.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" fill="currentColor" fill-opacity="0.12"></rect><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            </div>
                            <h4>Control de aprobaciones</h4>
                            <p>Define umbrales de descuento y margen mínimo. Si un vendedor se pasa, la propuesta se congela y espera aprobación del gerente antes de salir.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" fill="currentColor" fill-opacity="0.12"></path><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            </div>
                            <h4>Correos al instante</h4>
                            <p>Tu cliente recibe el link de la propuesta por correo al enviar, y tú recibes una notificación en cuanto la abre, la aprueba o la rechaza.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    

        <!-- INTEGRATIONS SECTION -->
        



    
                <!-- POWER SECTION -->
        <section class="uc-power">
            <div class="uc-container">
                <h2 class="uc-power-title reveal">Cierra más contratos, cobra más rápido</h2>
                <div class="uc-power-grid">
                    <div class="uc-power-item reveal">
                        <h3>Propuestas con precios por nivel de cliente</h3>
                        <p>Define niveles — Estándar, Plata, Oro, Distribuidor — y Cord aplica el descuento correspondiente automáticamente al elegir el cliente. Menos negociación improvisada, márgenes más controlados.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Portal de cliente con tu marca</h3>
                        <p>Cada propuesta genera un link seguro donde tu cliente revisa el desglose, aprueba con firma digital y descarga el PDF y el XML del CFDI — sin que tengas que mandar documentos por correo.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>CFDI 4.0 sin salir de Cord</h3>
                        <p>Al aprobar la propuesta, Cord timbra el CFDI 4.0 vía PAC certificado. El XML y el PDF quedan vinculados a la cotización y disponibles para descarga desde el portal del cliente.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Seguimiento en vivo y cobranza</h3>
                        <p>Sabes en tiempo real cuándo tu cliente abrió la propuesta. Si no ha pagado, Cord envía recordatorios automáticos por correo y WhatsApp antes del vencimiento sin que tengas que intervenir.</p>
                    </div>
                </div>
            </div>
        </section>

        

        <FaqAccordion
            faqs={FAQS}
            title="Lo que preguntan las empresas de SaaS antes de empezar."
            id="saas"
            class="uc-faq-acc"
        />
    </main>
    <Footer />

</Layout>

<style>
    :global(.uc-faq-acc) { padding: 5rem 5% 7rem; }

    .uc-int-card {
        background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1614729939124-032f0b56c9ce?q=80&w=2000'); background-size: cover; background-position: center;
        border-radius: 24px;
        padding: 4rem;
        text-align: center;
        max-width: 900px;
        margin: 0 auto 3rem;
        color: #fff;
    }
    .uc-int-card h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
        color: #fff;
    }
    .uc-int-card p {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #cbd5e1;
        max-width: 700px;
        margin: 0 auto;
    }
    .uc-int-card code {
        background: rgba(255,255,255,0.1);
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
    }
    .uc-int-logos {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        align-items: center;
        padding: 2rem 0;
    }
    .uc-logo-badge {
        font-size: 1.25rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: -0.02em;
        transition: color 0.3s;
    }
    .uc-logo-badge:hover {
        color: #0f172a;
    }
    
    .uc-power-item h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0a2540;
        margin-bottom: 0.75rem;
    }
    .uc-power-item p {
        font-size: 0.95rem;
        color: #425466;
        line-height: 1.5;
    }
    @media (max-width: 900px) {
        .uc-power-grid { grid-template-columns: 1fr 1fr; }
        .uc-int-card { padding: 3rem 1.5rem; }
        .uc-int-card h2 { font-size: 2rem; }
    }
    @media (max-width: 600px) {
        .uc-power-grid { grid-template-columns: 1fr; }
    }
    

    .uc-logo-img {
        height: 36px;
        width: auto;
        opacity: 0.7;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .uc-logo-badge:hover .uc-logo-img {
        opacity: 1;
        transform: scale(1.05);
    }
    
</style>

<style>
    /* VARIABLES Y UTILIDADES GLOBALES PARA USE CASES */
    .use-case-main {
        background: #fff;
        padding-top: 0;
        overflow-x: hidden;
        color: #425466; /* Texto Stripe */
    }

    .uc-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 5%;
    }

    /* ── HERO — layout de soluciones/startups: texto a la izquierda y, a la
       derecha, una calca de pantalla real (CasoHeroMockup) sobre la ola de seda. ── */
    .startup-hero {
        position: relative;
        padding: 150px 0 90px;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
        background: #f6f9fc;
    }

    /* Respaldo sin WebGL: la misma composición con degradados. */
    .startup-hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        background: linear-gradient(118deg, #f6f9fc 0%, #f6f9fc 42%, #5EEAD4 44%, #22D3EE 52%, #3B82F6 64%, #6366F1 80%, #8B5CF6 100%);
    }
    /* Velo claro detrás del texto. */
    .startup-hero-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(246, 249, 252, 0.6) 0%, rgba(246, 249, 252, 0.25) 38%, transparent 55%);
    }

    .startup-hero-grid {
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        gap: 56px;
        align-items: center;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 20px;
    }

    .startup-hero-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        min-width: 0;
    }

    .startup-hero-visual {
        display: flex;
        justify-content: flex-end;
        min-width: 0;
    }

    .startup-title {
        font-size: clamp(2.5rem, 4.3vw, 4rem);
        line-height: 1.04;
        font-weight: 700;
        letter-spacing: -0.045em;
        margin: 0 0 1.75rem;
        color: #050505;
        text-wrap: balance;
        max-width: 660px;
    }
    /* El vertical, en los tonos de su paleta (un paso más profundos para que
       se lean sobre claro). */
    .startup-title-accent {
        background: linear-gradient(92deg, #0891b2 0%, #2563eb 55%, #4f46e5 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: #2563eb;
    }

    .startup-sub {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        line-height: 1.6;
        color: #425466;
        max-width: 540px;
        margin: 0 0 2.4rem 0;
        font-weight: 400;
    }

    .startup-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .startup-hero .btn-ghost {
        color: #0a2540;
        border: 1px solid rgba(10, 37, 64, 0.15);
        background: rgba(255, 255, 255, 0.55);
    }

    .startup-hero .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.8);
        box-shadow: 0 6px 16px rgba(0,0,0,0.05);
    }

    @media (max-width: 880px) {
        .startup-hero { padding: 120px 0 64px; min-height: auto; }
        .startup-hero-grid { grid-template-columns: 1fr; gap: 48px; }
        .startup-hero-visual { justify-content: center; }
        .startup-hero-bg::after {
            background: linear-gradient(180deg, rgba(246, 249, 252, 0.72) 0%, rgba(246, 249, 252, 0.3) 45%, transparent 65%);
        }
    }
    @media (max-width: 520px) {
        .startup-title { font-size: 2.35rem; }
    }

    .uc-hero-inner {
        position: relative;
        z-index: 1;
        width: 100%;
    }

    .uc-hero-content {
        max-width: 640px;
    }

    .uc-title {
        font-size: clamp(2.2rem, 4vw, 3.8rem);
        font-weight: 800;
        color: #0a2540;
        line-height: 1.1;
        letter-spacing: -0.04em;
        margin-bottom: 1.2rem;
        text-wrap: balance;
    }

    .uc-sub {
        font-size: 1.15rem;
        color: #425466;
        line-height: 1.6;
        margin-bottom: 2rem;
        max-width: 90%;
    }

    .uc-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    /* ── BUTTONS (estilo soluciones/startups) ── */
    .btn-luxe {
        position: relative;
        display: inline-flex; align-items: center; justify-content: center;
        background: #0a2540; color: #fff;
        padding: 18px 38px; border-radius: 100px;
        font-size: 0.95rem; font-weight: 600; text-decoration: none;
        overflow: hidden;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 24px rgba(10, 37, 64, 0.2);
    }
    .btn-luxe span { position: relative; z-index: 2; }
    .btn-arrow {
        position: relative; z-index: 2; display: inline-block;
        width: 16px; height: 16px; margin-left: 6px;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-luxe:hover .btn-arrow { transform: translateX(4px); }
    .btn-shimmer {
        position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
        transform: skew(-20deg); transition: 0s; z-index: 1;
    }
    .btn-luxe:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(10, 37, 64, 0.3);
    }
    .btn-luxe:active {
        transform: translateY(-1px);
        box-shadow: 0 2px 4px rgba(10, 37, 64, 0.1);
    }
    .btn-luxe:hover .btn-shimmer {
        left: 150%;
        transition: left 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-ghost {
        display: inline-flex; align-items: center; gap: 9px;
        color: #0a2540; text-decoration: none;
        font-size: 1rem; font-weight: 600;
        padding: 15px 26px; border-radius: 100px;
        border: 1px solid rgba(10, 37, 64, 0.15);
        background: rgba(10, 37, 64, 0.03);
        transition: background 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }
    .btn-ghost:hover {
        background: rgba(10, 37, 64, 0.08);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
    }

    /* ── TRUST LOGOS ── */
    .uc-trust {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 3rem 5%;
    }
    .uc-trust p {
        font-size: 0.9rem; font-weight: 600; color: #687385; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem;
    }
    .uc-logos {
        display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap; align-items: center;
    }
    .trust-logo-item {
        display: flex; align-items: center; gap: 8px; text-decoration: none;
        font-size: 1.25rem; font-weight: 700; color: #a1a9b3; letter-spacing: -0.5px;
        filter: grayscale(100%) opacity(0.8);
        transition: all 0.3s ease;
    }
    .trust-logo-item:hover {
        filter: grayscale(0%) opacity(1);
        color: #0a2540;
    }
    .trust-logo-item img {
        border-radius: 4px;
    }

    /* ── STRIPE-LIKE SPLIT FEATURE ── */
    .uc-split-feature {
        padding: 6rem 0;
        background: #ffffff;
        
    }
    
    .uc-split-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 6rem;
        align-items: center;
    }

    .uc-split-text {
        max-width: 480px;
    }


    .uc-split-title {
        font-size: clamp(2.2rem, 3.5vw, 3rem);
        font-weight: 800;
        color: #0a2540;
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin-bottom: 1.5rem;
        text-wrap: balance;
    }

    .uc-split-desc {
        font-size: 1.1rem;
        color: #425466;
        line-height: 1.6;
        margin-bottom: 3.5rem;
    }
    .uc-split-desc a {
        color: #0a2540;
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px solid rgba(10,37,64,0.2);
        padding-bottom: 2px;
        transition: border-color 0.2s;
    }
    .uc-split-desc a:hover {
        border-color: #0a2540;
    }

    .uc-feature-item {
        display: flex;
        gap: 1.25rem;
        margin-bottom: 3rem;
    }

    .uc-feature-icon {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
    }
    .uc-feature-icon svg {
        width: 100%;
        height: 100%;
    }

    .uc-feature-content h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0a2540;
        margin-bottom: 0.8rem;
        line-height: 1.35;
    }

    .uc-feature-content p {
        font-size: 1rem;
        color: #425466;
        line-height: 1.6;
    }
    .uc-feature-content a {
        color: #0a2540;
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px solid rgba(10,37,64,0.2);
        padding-bottom: 2px;
        transition: border-color 0.2s;
    }
    .uc-feature-content a:hover {
        border-color: #0a2540;
    }

    /* MOCKUP UI */
    .uc-split-mockup {
        position: relative;
    }

    /* Ventana cmk-* (kit compartido de mockups, calca estilo Stripe) */
    .uc-cmk-window {
        position: relative;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        text-align: left;
        border: 1px solid rgba(10, 25, 47, 0.08);
        box-shadow:
            0 2px 4px rgba(10, 25, 47, 0.05),
            0 40px 80px -24px rgba(10, 25, 47, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .uc-mockup-wrapper {
        position: relative;
        background: #f5f5f7;
        border-radius: 12px;
        border: 1px solid rgba(10,37,64,0.06);
        box-shadow: 0 40px 80px -20px rgba(10,37,64,0.12), 0 20px 40px -20px rgba(10,37,64,0.08);
        overflow: hidden;
    }
    
    .uc-mockup-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 24px;
        background: #fff;
        
    }
    
    .uc-mockup-logo {
        font-weight: 800;
        color: #0a2540;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
    }
    
    .uc-mockup-nav {
        display: flex;
        gap: 20px;
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
    }
    .uc-mockup-nav span.active {
        color: #0a2540;
        font-weight: 600;
    }
    
    .uc-mockup-body {
        background: #f8fafc;
        border-top: 1px solid rgba(10,37,64,0.06);
    }
    
    .uc-saas-checkout {
        background: #fff;
        border: 1px solid rgba(10,37,64,0.08);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 10px 30px -10px rgba(10,37,64,0.08);
    }

    .uc-sc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    .uc-sc-header h4 {
        font-size: 1.05rem;
        font-weight: 800;
        color: #0a2540;
    }
    .uc-sc-status {
        font-size: 0.7rem;
        font-weight: 700;
        color: #b45309;
        background: #fef3c7;
        padding: 4px 10px;
        border-radius: 20px;
    }

    .uc-sc-plan {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        background: #f1f5f9;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .uc-sc-plan-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .uc-sc-tier {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0a2540;
    }
    .uc-sc-seats {
        font-size: 0.75rem;
        color: #64748b;
    }
    .uc-sc-price {
        font-size: 1.2rem;
        font-weight: 800;
        color: #0a2540;
        display: flex;
        align-items: baseline;
        gap: 2px;
    }
    .uc-sc-price span {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
    }

    .uc-sc-breakdown {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 24px;
    }
    .uc-sc-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #475569;
    }
    .uc-sc-discount {
        color: #10b981;
        font-weight: 500;
    }
    .uc-sc-divider {
        height: 1px;
        background: #e2e8f0;
        margin: 4px 0;
    }
    .uc-sc-total {
        font-size: 0.95rem;
        font-weight: 800;
        color: #0a2540;
    }

    .uc-sc-actions {
        display: flex;
        justify-content: flex-end;
    }
    .uc-sc-btn {
        background: #0f172a;
        color: #fff;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .uc-sc-btn:hover {
        background: #1e293b;
    }

    .uc-mc {
        background: #fff;
        border: 1px solid rgba(10,37,64,0.07);
        border-radius: 16px;
        padding: 20px 15px;
        position: relative;
        text-align: left;
        display: flex;
        flex-direction: column;
        box-shadow: 0 1px 2px rgba(10,37,64,0.04);
        transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), box-shadow 0.3s ease;
    }

    .uc-mc-2 {
        border-color: var(--uc-accent);
        box-shadow: 0 0 0 1px var(--uc-accent), 0 26px 50px -22px var(--uc-accent-shadow), 0 8px 20px -14px rgba(10,37,64,0.16);
        transform: translateY(-12px);
        z-index: 2;
    }

    .uc-mc-badge {
        position: absolute;
        top: -11px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--uc-accent);
        color: #fff;
        font-size: 0.6rem;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: 999px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        white-space: nowrap;
        box-shadow: 0 6px 14px -4px var(--uc-accent-shadow);
    }

    .uc-mc-tier {
        font-size: 0.68rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 9px;
    }

    .uc-mc-amount {
        font-size: 1.45rem;
        font-weight: 700;
        color: #0a2540;
        letter-spacing: -0.045em;
        font-variant-numeric: tabular-nums;
        line-height: 1;
        display: flex;
        align-items: baseline;
        gap: 3px;
        flex-wrap: wrap;
    }
    .uc-mc-amount span {
        font-size: 0.7rem;
        font-weight: 500;
        color: #94a3b8;
        letter-spacing: 0;
    }

    .uc-mc-chip {
        align-self: flex-start;
        font-size: 0.62rem;
        font-weight: 700;
        color: var(--uc-accent);
        background: var(--uc-accent-soft);
        padding: 2px 8px;
        border-radius: 999px;
        margin-top: 8px;
    }

    .uc-mc-feats {
        list-style: none;
        padding: 0;
        margin: 14px 0 18px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }
    .uc-mc-feats li {
        font-size: 0.73rem;
        color: #475569;
        line-height: 1.3;
        padding-left: 18px;
        position: relative;
    }
    .uc-mc-feats li::before {
        content: '✓';
        position: absolute;
        left: 0;
        top: 0;
        color: var(--uc-accent);
        font-size: 0.72rem;
        font-weight: 800;
    }

    .uc-mc-btn {
        margin-top: auto;
        background: #eef1f5;
        color: #334155;
        font-size: 0.74rem;
        font-weight: 600;
        padding: 9px 12px;
        border-radius: 10px;
        text-align: center;
        transition: all 0.2s;
    }
    .uc-mc-2 .uc-mc-btn {
        background: var(--uc-accent);
        color: #ffffff;
        box-shadow: 0 8px 18px -6px var(--uc-accent-shadow);
    }
    .uc-mc-btn.is-muted {
        background: #f1f5f9;
        color: #94a3b8;
    }

    @media (max-width: 900px) {
        .uc-split-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
        }
        .uc-split-text {
            max-width: 100%;
        }
        .uc-mockup-nav { display: none; }
        .uc-mockup-cards { grid-template-columns: 1fr; gap: 12px; }
        .uc-mc-2 { transform: none; }
    }

    /* ── CTA SECTION ── */
    .uc-cta-section {
        padding: 4rem 0 8rem;
        background: #fff;
    }
    .uc-cta-box {
        background: #0a192f;
        border-radius: 20px;
        padding: 4rem 2rem;
        text-align: center;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(10,37,64,0.25);
    }
    .uc-cta-box::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at center top, rgba(255,255,255,0.08), transparent 70%);
        pointer-events: none;
    }
    .uc-cta-box h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 1rem; position: relative; z-index: 1; }
    .uc-cta-box p { font-size: 1.1rem; color: #aab7c4; margin-bottom: 2rem; position: relative; z-index: 1; }
    .uc-cta-box .btn-luxe { background: #ffffff; color: #0a2540; box-shadow: 0 4px 14px rgba(255,255,255,0.1); }
    .uc-cta-box .btn-luxe:hover { background: #f8fafc; box-shadow: 0 6px 20px rgba(255,255,255,0.2); }

    @media (max-width: 900px) {
        .uc-hero { padding: 9rem 0 6rem; }
        .uc-hero-content { max-width: 100%; }
        .uc-title { font-size: 2.5rem; }
        .uc-bento-grid { grid-template-columns: 1fr; }
    }
    /* ── SECONDARY BENEFITS (STRIPE STYLE) ── */
    .uc-benefits {
        padding: 5rem 0 7rem;
        background: #ffffff;
        
    }
    .uc-benefits-intro {
        text-align: left;
        max-width: 680px;
        margin-bottom: 4rem;
    }
    .uc-bento-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        margin-bottom: 6rem;
    }
    .uc-bento-card {
        background: #fff;
        display: flex;
        flex-direction: column;
    }
    .uc-bc-text {
        padding-right: 2rem;
        margin-bottom: 2.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .uc-bc-text h3 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0a2540;
        margin-bottom: 1rem;
        line-height: 1.25;
        letter-spacing: -0.02em;
    }
    .uc-bc-text p {
        font-size: 1.05rem;
        color: #425466;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }
    .uc-link-arrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #0f172a;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: color 0.2s;
        margin-top: auto;
    }
    .uc-link-arrow:hover {
        color: #334155;
    }
    .uc-link-arrow span {
        transition: transform 0.2s;
    }
    .uc-link-arrow:hover span {
        transform: translateX(4px);
    }

    /* Mockups dentro de bento cards: el lienzo gris ES el de la app; la calca
       (.ucm-shot) se recorta y se desvanece abajo. */
    .uc-bc-mockup {
        background: #f5f5f7;
        border-radius: 16px;
        padding: 0;
        height: 320px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(10,37,64,0.06);
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);
    }
    .cord-bg-1 {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #0a2540 0%, #1e293b 100%);
        clip-path: polygon(0 0, 100% 0, 100% 60%, 0 80%);
    }

    /* Micro mockups CSS */
    .uc-mini-invoice {
        position: relative; z-index: 2;
        background: #fff; width: 280px; border-radius: 12px;
        box-shadow: 0 20px 40px -10px rgba(10,37,64,0.15);
        padding: 24px; text-align: center; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .uc-mi-logo { width: 40px; height: 40px; border-radius: 50%; background: #0a2540; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; margin: 0 auto 12px; }
    .uc-mi-title { font-size: 0.95rem; font-weight: 700; color: #0a2540; margin-bottom: 4px; }
    .uc-mi-sub { font-size: 0.75rem; color: #64748b; margin-bottom: 20px; }
    .uc-mi-amount { font-size: 1.6rem; font-weight: 800; color: #0a2540; margin-bottom: 24px; }
    .uc-mi-currency { font-size: 0.85rem; color: #64748b; font-weight: 600; }
    .uc-mi-form { display: flex; flex-direction: column; gap: 10px; }
    .uc-mi-input { border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px; font-size: 0.75rem; color: #475569; display: flex; align-items: center; gap: 8px; text-align: left; background: #f8fafc; }
    .uc-mi-btn { background: #0a2540; color: #fff; border-radius: 6px; padding: 10px; font-size: 0.8rem; font-weight: 600; margin-top: 5px; }

    .uc-mini-portal {
        display: flex; width: 100%; height: 100%; background: #fff;
    }
    .uc-mp-sidebar {
        width: 120px; background: #f8fafc; border-right: 1px solid #e2e8f0; padding: 20px 12px;
        display: flex; flex-direction: column; gap: 12px;
    }
    .uc-mp-brand { font-size: 0.85rem; font-weight: 700; color: #0a2540; display: flex; align-items: center; gap: 6px; margin-bottom: 12px; }
    .uc-mp-dot { width: 16px; height: 16px; background: #0f172a; border-radius: 4px; }
    .uc-mp-nav { font-size: 0.75rem; color: #64748b; font-weight: 500; }
    .uc-mp-main { flex: 1; padding: 24px; text-align: left; }
    .uc-mp-header { font-size: 1.2rem; font-weight: 700; color: #0a2540; margin-bottom: 20px; }
    .uc-mp-card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; }
    .uc-mp-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; }
    .uc-mp-row div { display: flex; flex-direction: column; gap: 4px; }
