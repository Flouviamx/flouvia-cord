---

export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/landing/Nav.astro';
import Footer from '../../components/landing/Footer.astro';
import RibbonHeroBg from '../../components/RibbonHeroBg.jsx';
import CasoHeroMockup from '../../components/casos/CasoHeroMockup.astro';

// Ola de seda del hero (mismo shader que /soluciones), paleta AZUL PROFUNDO para distribución y mayoreo.
const HERO_PAL = { base: '#F6F9FC', c1: '#93C5FD', c2: '#60A5FA', c3: '#3B82F6', c4: '#4F46E5', c5: '#312E81' };
import FaqAccordion from '../../components/landing/FaqAccordion.astro';
import IntegrationsMarquee from '../../components/integraciones/IntegrationsMarquee.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const t = useTranslations(lang);

const metaTitle = "Cord para Comercializadoras — Cotizaciones y Crédito";
const metaDesc = "Digitaliza las ventas de tu comercializadora: cotiza por volumen y nivel de cliente, registra el crédito Net 30/60 y el límite de cada cliente, y emite tu factura desde la misma cotización (CFDI 4.0 para negocios en México). Para distribuidoras y mayoristas.";

// FAQ + JSON-LD (jul 2026, auditoría SEO/AI-SEO) — preguntas ancladas a
// capacidades reales del producto.
const FAQS = [
    {
        q: '¿Cómo veo qué clientes rebasaron su límite de crédito?',
        a: 'Defines el límite de crédito y los términos (Contado, Net 30 o Net 60) de cada cliente. Cord muestra en su ficha el saldo abierto frente al límite, y en Cobranza lista a los clientes que lo rebasaron para que tu equipo decida antes de venderles más.',
    },
    {
        q: '¿Puedo dar precios por volumen y por nivel de cliente al mismo tiempo?',
        a: 'Sí. Defines una matriz de precios por volumen a nivel producto y, además, un nivel de cliente (Estándar, Plata, Oro, Distribuidor) con su propio descuento — Cord aplica el que corresponda automáticamente al cotizar.',
    },
    {
        q: '¿Cómo veo qué tan vencida está mi cartera?',
        a: 'El panel de Cobranza muestra tu cartera por antigüedad, el saldo vencido y los días promedio de cobro por cliente, con recordatorios automáticos por correo (plan Profesional).',
    },
    {
        q: '¿Cord timbra CFDI para ventas con muchas líneas de producto?',
        a: 'Sí, hasta 200 líneas por cotización. Cuando la cotización está aprobada, emites el CFDI 4.0 completo desde ella, timbrado por un PAC certificado, sin recapturar los datos en otro sistema.',
    },
];
const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: 'https://cordhq.app/' },
        { '@type': 'ListItem', position: 2, name: 'Comercializadoras', item: 'https://cordhq.app/casos-de-uso/comercializadoras' },
    ],
};



---


<Layout title={metaTitle} description={metaDesc}>
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <Nav />

    <main class="use-case-main">
        <!-- HERO -->
        <header class="startup-hero">
            <div class="startup-hero-bg">
                <RibbonHeroBg client:only="react" light colors={HERO_PAL} />
            </div>
            <div class="startup-hero-grid">
            <div class="startup-hero-content">
                <h1 class="startup-title reveal">De la propuesta al cobro para <span class="startup-title-accent">comercializadoras</span></h1>
                <p class="startup-sub">
                    Precios por volumen y por nivel de cliente, crédito a la vista y aprobaciones internas. Cierra ventas a volumen y emite el CFDI 4.0 (para negocios en México) sin recapturar.
                </p>
                <div class="startup-actions">
                    <a href="/sign-up" class="btn-luxe">
                        <span>Empezar ahora</span>
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        <div class="btn-shimmer"></div>
                    </a>
                    <a href="/contacto/ventas" class="btn-ghost"><span>Contactar a ventas</span></a>
                </div>
            </div>
            <div class="startup-hero-visual">
                <CasoHeroMockup variant="comercializadoras" />
            </div>
            </div>
        </header>

        <!-- INTEGRACIONES: el mismo marquee 3D de /integraciones -->
        <section class="uc-trust reveal">
            <p>Se conecta con las herramientas que ya usa tu equipo</p>
            <IntegrationsMarquee />
        </section>

        <!-- SECONDARY BENEFITS SECTION -->
        <section class="uc-benefits">
            <div class="uc-container">
                <div class="uc-benefits-intro reveal">
                    <h2 class="uc-split-title">Acelera tu ciclo comercial desde la orden hasta el pago</h2>
                    <p class="uc-split-desc">
                        Olvida los procesos manuales que retrasan el despacho de mercancía. Con Cord, tus agentes cierran ventas más rápido, el crédito de cada cliente queda a la vista y los pagos hechos por Cord se registran solos.
                    </p>
                </div>

                <div class="uc-bento-cards">
                    <!-- Tarjeta 1 -->
                    <div class="uc-bento-card reveal">
                        <div class="uc-bc-text">
                            <h3>Límites de crédito por cliente a la vista</h3>
                            <p>Define el límite y los términos de cada distribuidor. Cord muestra su saldo abierto frente al límite y lista en Cobranza a quienes lo rebasan, para que tu equipo lo vea antes de venderles más.</p>
                            <a href="/sign-up" class="uc-link-arrow">Controla tu cartera de crédito <span>&rarr;</span></a>
                        </div>
                        <div class="uc-bc-mockup">
                            <!-- Calca de /app/clientes/[id]: nivel Distribuidor, KPIs y el bloque
                                 Crédito con el aviso de saldo por encima del límite. -->
                            <div class="ucm-shot">
                                <div class="ucm-dh">
                                    <span class="ucm-dh-av dist">DE</span>
                                    <span class="ucm-dh-who">
                                        <span class="ucm-badges"><span class="ucm-tier">Distribuidor</span><span class="ucm-fis">Datos fiscales completos</span></span>
                                        <small>Raúl Mendoza · compras@elzarco.mx · 33 1845 2290</small>
                                    </span>
                                    <span class="ucm-dh-tot"><small>Cerrado</small><b class="editorial">$1,284,650<i class="ucm-cur">MXN</i></b></span>
                                </div>
                                <div class="ucm-card ucm-ckpis">
                                    <span><small>Cotizaciones</small><b class="editorial">18</b></span>
                                    <span><small>En pipeline</small><b class="editorial">$248,234<i class="ucm-cur">MXN</i></b></span>
                                    <span><small>Cobrado</small><b class="editorial">$960,650<i class="ucm-cur">MXN</i></b></span>
                                    <span><small>Ticket promedio</small><b class="editorial">$71,370<i class="ucm-cur">MXN</i></b></span>
                                </div>
                                <div class="ucm-card ucm-credit">
                                    <div class="ucm-credit-h"><b>Crédito</b><span>108% usado</span></div>
                                    <div class="ucm-credit-track"><i style="width:100%"></i></div>
                                    <div class="ucm-credit-n"><b class="editorial">$324,000<i class="ucm-cur">MXN</i></b><span>Saldo abierto · $300,000 MXN crédito</span></div>
                                    <p class="ucm-credit-w">Saldo abierto por encima del límite de crédito</p>
                                </div>
                                <div class="ucm-sec ucm-sec-gap">Estado de cuenta</div>
                                <div class="ucm-aging">
                                    <span><small>Corriente</small><b class="editorial">$165,000</b></span>
                                    <span class="late"><small>1–30 días</small><b class="editorial">$124,300</b></span>
                                    <span class="late"><small>31–60 días</small><b class="editorial">$34,700</b></span>
                                    <span class="empty"><small>61–90 días</small><b class="editorial">$0</b></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tarjeta 2 -->
                    <div class="uc-bento-card reveal">
                        <div class="uc-bc-text">
                            <h3>Cartera vencida con recordatorios por correo</h3>
                            <p>Cord muestra el aging de tu cartera por cliente, los saldos vencidos y los días promedio de cobro. Cuando una factura no se ha pagado, Cord manda recordatorios por correo antes y después del vencimiento, y puedes abrir un WhatsApp con el mensaje ya redactado.</p>
                            <a href="/sign-up" class="uc-link-arrow">Mejora tu ciclo de cobro <span>&rarr;</span></a>
                        </div>
                        <div class="uc-bc-mockup">
                            <!-- Calca de /app/cobranza: KPIs de hoy + cuentas por cobrar -->
                            <div class="ucm-shot">
                                <div class="ucm-ph">
                                    <div><h4 class="ucm-ph-t">Cobranza</h4></div>
                                    <span class="ucm-tabs"><span class="on">Cobranza</span><span>Cobranza con IA</span></span>
                                </div>
                                <div class="ucm-kpis4">
                                    <div class="ucm-card ucm-kpi"><span class="ucm-kl">VENCIDO</span><b class="editorial ucm-bad">$184,300<i class="ucm-cur">MXN</i></b><small>3 cuenta(s) · toca para filtrar</small></div>
                                    <div class="ucm-card ucm-kpi"><span class="ucm-kl">VENCE ESTA SEMANA</span><b class="editorial">$96,580<i class="ucm-cur">MXN</i></b><small>2 cuenta(s) en los próximos 7 días</small></div>
                                </div>
                                <div class="ucm-card">
                                    <div class="ucm-sec ucm-sec-row"><span>Cuentas por cobrar</span><span class="ucm-chips"><span class="on">Todas</span><span>Vencidas</span><span>Con promesa</span><span>Sin gestión</span></span></div>
                                    <div class="ucm-th ucm-cz"><span>Cliente</span><span>Folio</span><span>Vence</span><span>Estado</span><span class="ucm-r">Saldo</span></div>
                                    <div class="ucm-tr ucm-cz"><span class="ucm-cli"><i class="ucm-av">GN</i><span>Grupo Norteño</span></span><span class="ucm-folio">COT-0131</span><span class="ucm-date">12 sep 2026</span><span class="ucm-est"><span class="ucm-e over">Vencida 18 d</span></span><span class="editorial ucm-r ucm-amt">$96,420<i class="ucm-cur">MXN</i></span></div><div class="ucm-tr ucm-cz"><span class="ucm-cli"><i class="ucm-av">FM</i><span>Ferre Mayoreo Bajío</span></span><span class="ucm-folio">COT-0138</span><span class="ucm-date">22 sep 2026</span><span class="ucm-est"><span class="ucm-e over">Vencida 8 d</span></span><span class="editorial ucm-r ucm-amt">$52,180<i class="ucm-cur">MXN</i></span></div><div class="ucm-tr ucm-cz"><span class="ucm-cli"><i class="ucm-av">DE</i><span>Distribuidora El Zarco</span></span><span class="ucm-folio">COT-0142</span><span class="ucm-date">26 sep 2026</span><span class="ucm-est"><span class="ucm-e over">Vencida 4 d</span><span class="ucm-e prom"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Promete 3 oct</span></span><span class="editorial ucm-r ucm-amt">$35,700<i class="ucm-cur">MXN</i></span></div><div class="ucm-tr ucm-cz"><span class="ucm-cli"><i class="ucm-av">AC</i><span>Abastos del Centro</span></span><span class="ucm-folio">COT-0145</span><span class="ucm-date">3 oct 2026</span><span class="ucm-est"><span class="ucm-e due">Vence en 3 d</span></span><span class="editorial ucm-r ucm-amt">$61,240<i class="ucm-cur">MXN</i></span></div><div class="ucm-tr ucm-cz"><span class="ucm-cli"><i class="ucm-av">MC</i><span>Materiales Cárdenas</span></span><span class="ucm-folio">COT-0147</span><span class="ucm-date">6 oct 2026</span><span class="ucm-est"><span class="ucm-e due">Vence en 6 d</span></span><span class="editorial ucm-r ucm-amt">$35,340<i class="ucm-cur">MXN</i></span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Micro Features Grid -->
                <div class="uc-micro-features reveal">
                    <h3 class="uc-mf-title">Agilidad operativa para escalar tus ventas</h3>
                    <div class="uc-mf-grid">
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="14 2 18 6 7 17 3 17 3 13 14 2" fill="currentColor" fill-opacity="0.12"></polygon><polygon points="14 2 18 6 7 17 3 17 3 13 14 2"></polygon><line x1="3" y1="22" x2="21" y2="22"></line></svg>
                            </div>
                            <h4>Descuentos por volumen</h4>
                            <p><a href="/sign-up" class="uc-link-inline">Aplica matrices de precios</a> automáticamente dependiendo de las cantidades solicitadas en el cotizador.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2" fill="currentColor" fill-opacity="0.12"></rect><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                            </div>
                            <h4>Webhooks para tu ERP</h4>
                            <p>Cord emite <code>quote.approved</code> y <code>quote.paid</code> para que tu ERP o sistema de inventario reaccione vía Zapier, Make o tu propio backend al cerrar un pedido.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.5" cy="7" r="4" fill="currentColor" fill-opacity="0.12"></circle><path d="M16 21v-2a4 4 0 0 0-4-4H5c-1.1 0-2 .9-2 2v2" fill="currentColor" fill-opacity="0.12"></path><path d="M16 21v-2a4 4 0 0 0-4-4H5c-1.1 0-2 .9-2 2v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
                            </div>
                            <h4>Roles de aprobación</h4>
                            <p>Establece <a href="/producto/aprobaciones" class="uc-link-inline">flujos de validación</a> internos si un asesor otorga un descuento mayor al permitido (plan Scale).</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" fill="currentColor" fill-opacity="0.12"></path><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                            </div>
                            <h4>WhatsApp con Workflows</h4>
                            <p>Con <a href="/producto/workflows" class="uc-link-inline">Cord Workflows</a> le escribes al cliente por WhatsApp, con tu plantilla aprobada por Meta, cuando cambia el estado de una cotización o factura.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    

        <!-- INTEGRATIONS SECTION -->
        



    
                <!-- POWER SECTION -->
        <section class="uc-power">
            <div class="uc-container">
                <h2 class="uc-power-title reveal">Acelera el flujo de efectivo de tu comercializadora con Cord</h2>
                <div class="uc-power-grid">
                    <div class="uc-power-item reveal">
                        <h3>Líneas de crédito bajo control</h3>
                        <p>Administra el crédito de cada cliente con precisión: define plazos (Contado, Net 30 o Net 60) y límite, y ve en Cobranza quién tiene saldo vencido o rebasó su límite.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Gestión activa de cobranza</h3>
                        <p>El módulo de Cobranza hace el seguimiento pesado por ti: registra <a href="/producto/cobranza-ia">promesas de pago</a> y envía por correo recordatorios automáticos antes y después del vencimiento.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Multi-divisa con tasa protegida</h3>
                        <p>Cotiza a clientes del extranjero en USD o EUR con el tipo de cambio congelado 30 días, y un margen de cobertura de 1, 2 o 5%. Tu cliente ve y paga en su moneda; el CFDI declara ese tipo de cambio.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>CFDI 4.0 de cada venta, con un clic</h3>
                        <p>Con un clic emites el CFDI 4.0 de la cotización aprobada, timbrado por un PAC certificado. El XML y el PDF quedan ligados a ella y tu cliente los descarga desde el link de la factura.</p>
                    </div>
                </div>
            </div>
        </section>

        

        <FaqAccordion
            faqs={FAQS}
            title="Lo que preguntan las comercializadoras antes de empezar."
            id="comercializadoras"
            class="uc-faq-acc"
        />
    </main>
    <Footer />

</Layout>

<style>
    :global(.uc-faq-acc) { padding: 5rem 5% 7rem; }

    .uc-int-card {
        background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2000'); background-size: cover; background-position: center;
        border-radius: 24px;
        padding: 4rem;
        text-align: center;
        max-width: 900px;
        margin: 0 auto 3rem;
        color: #fff;
    }
    .uc-int-card h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
        color: #fff;
    }
    .uc-int-card p {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #cbd5e1;
        max-width: 700px;
        margin: 0 auto;
    }
    .uc-int-card code {
        background: rgba(255,255,255,0.1);
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
    }
    .uc-int-logos {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        align-items: center;
        padding: 2rem 0;
    }
    .uc-logo-badge {
        font-size: 1.25rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: -0.02em;
        transition: color 0.3s;
    }
    .uc-logo-badge:hover {
        color: #0f172a;
    }
    
    .uc-power-item h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0a2540;
        margin-bottom: 0.75rem;
    }
    .uc-power-item p {
        font-size: 0.95rem;
        color: #425466;
        line-height: 1.5;
    }
    @media (max-width: 900px) {
        .uc-power-grid { grid-template-columns: 1fr 1fr; }
        .uc-int-card { padding: 3rem 1.5rem; }
        .uc-int-card h2 { font-size: 2rem; }
    }
    @media (max-width: 600px) {
        .uc-power-grid { grid-template-columns: 1fr; }
    }
    

    .uc-logo-img {
        height: 36px;
        width: auto;
        opacity: 0.7;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .uc-logo-badge:hover .uc-logo-img {
        opacity: 1;
        transform: scale(1.05);
    }
    
</style>

<style>
    /* VARIABLES Y UTILIDADES GLOBALES PARA USE CASES */
    .use-case-main {
        background: #fff;
        padding-top: 0;
        overflow-x: hidden;
        color: #425466; /* Texto Stripe */
    }

    .uc-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 5%;
    }

    /* ── HERO — layout de soluciones/startups: texto a la izquierda y, a la
       derecha, una calca de pantalla real (CasoHeroMockup) sobre la ola de seda. ── */
    .startup-hero {
        position: relative;
        padding: 150px 0 90px;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
        background: #f6f9fc;
    }

    /* Respaldo sin WebGL: la misma composición con degradados. */
    .startup-hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        background: linear-gradient(118deg, #f6f9fc 0%, #f6f9fc 42%, #93C5FD 44%, #60A5FA 52%, #3B82F6 64%, #4F46E5 80%, #312E81 100%);
    }
    /* Velo claro detrás del texto. */
    .startup-hero-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(246, 249, 252, 0.6) 0%, rgba(246, 249, 252, 0.25) 38%, transparent 55%);
    }

    .startup-hero-grid {
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        gap: 56px;
        align-items: center;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 20px;
    }

    .startup-hero-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        min-width: 0;
    }

    .startup-hero-visual {
        display: flex;
        justify-content: flex-end;
        min-width: 0;
    }

    .startup-title {
        /* Tamaño estándar de títulos (h1.masked-title, Layout.astro). */
        font-size: clamp(2.1rem, 3.4vw, 3.6rem);
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.035em;
        margin: 0 0 1.75rem;
        color: #050505;
        text-wrap: balance;
        max-width: 660px;
    }
    /* El vertical, en los tonos de su paleta (un paso más profundos para que
       se lean sobre claro). */
    .startup-title-accent {
        background: linear-gradient(92deg, #2563eb 0%, #1d4ed8 55%, #4338ca 100%);
        -webkit-background-clip: text;
        background-clip: text;
