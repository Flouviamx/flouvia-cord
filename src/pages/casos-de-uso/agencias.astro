---
import { jsonForScript } from '../../lib/escape';

export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/landing/Nav.astro';
import Footer from '../../components/landing/Footer.astro';
import RibbonHeroBg from '../../components/RibbonHeroBg.jsx';
import CasoHeroMockup from '../../components/casos/CasoHeroMockup.astro';

// Ola de seda del hero (mismo shader que /soluciones), paleta CÁLIDA (ámbar → coral → violeta) para agencias y consultoras.
const HERO_PAL = { base: '#F6F9FC', c1: '#FDBA74', c2: '#FB7185', c3: '#E879F9', c4: '#A78BFA', c5: '#60A5FA' };
import FaqAccordion from '../../components/landing/FaqAccordion.astro';
import IntegrationsMarquee from '../../components/integraciones/IntegrationsMarquee.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const t = useTranslations(lang);

const metaTitle = "Cord para Agencias y Consultoras — Propuestas e Igualas";
const metaDesc = "Envía propuestas con firma electrónica, cobra tus igualas (retainers) con tarjeta cada mes y emite tu factura desde la misma cotización (CFDI 4.0 para negocios en México). Para agencias y consultoras.";

// FAQ + JSON-LD (jul 2026, auditoría SEO/AI-SEO) — preguntas ancladas a
// capacidades reales del producto.
const FAQS = [
    {
        q: '¿Cord cobra mis igualas (retainers) de forma automática cada mes?',
        a: 'Sí. Marca la cotización como "iguala mensual" y, cuando tu cliente la aprueba, autoriza su tarjeta una sola vez desde el mismo link. A partir de ahí Cord le cobra ese monto cada mes y lo liquida directo en tu cuenta bancaria, con la tarifa recurrente visible antes de activar Cord Payments, hasta que canceles la iguala desde el detalle de la cotización (si tu cliente quiere cancelar, te lo pide a ti). Para pagos únicos o a crédito, Cord también genera links de pago con tarjeta (y SPEI en México, en pesos) y recordatorios por correo. El CFDI 4.0 lo timbras desde Cord cuando lo necesitas.',
    },
    {
        q: '¿Qué evidencia queda cuando mi cliente firma la propuesta?',
        a: 'Cuando el cliente aprueba, Cord guarda su nombre, correo, IP y navegador, y un hash SHA-256 del contenido aprobado: la evidencia de firma electrónica sobre esa versión exacta de la propuesta. Su valor legal depende de tu país y del tipo de contrato; consulta a tu asesor.',
    },
    {
        q: '¿Puedo dar seguimiento a varias igualas activas al mismo tiempo?',
        a: 'Sí. En Cobros ves el total de igualas activas, cuánto suman al mes y cuántas tienen un cobro fallido; en cada cotización, el estado de la suscripción y el próximo cargo.',
    },
    {
        q: '¿Cord sirve si facturo en dólares a clientes en Estados Unidos?',
        a: 'Sí. Puedes cotizar y cobrar en USD con el tipo de cambio congelado 30 días; si emites CFDI 4.0, el comprobante declara la divisa y ese tipo de cambio. Si tu negocio factura desde fuera de México, Cord genera factura comercial.',
    },
];
const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: 'https://cordhq.app/' },
        { '@type': 'ListItem', position: 2, name: 'Agencias', item: 'https://cordhq.app/casos-de-uso/agencias' },
    ],
};



import { iconInner } from '../../lib/icons';
---


<Layout title={metaTitle} description={metaDesc}>
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(faqSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(breadcrumbSchema)} />
    <Nav />

    <main class="use-case-main">
        <!-- HERO -->
        <header class="startup-hero">
            <div class="startup-hero-bg">
                <RibbonHeroBg client:only="react" light colors={HERO_PAL} />
            </div>
            <div class="startup-hero-grid">
            <div class="startup-hero-content">
                <h1 class="startup-title reveal">De la propuesta al cobro para <span class="startup-title-accent">agencias y consultoras</span></h1>
                <p class="startup-sub">
                    Formaliza tus servicios con propuestas que tu cliente aprueba con firma electrónica. Centraliza la negociación, la aprobación y el cobro de igualas en un solo link.
                </p>
                <div class="startup-actions">
                    <a href="/sign-up" class="btn-luxe">
                        <span>Empezar ahora</span>
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg>
                        <div class="btn-shimmer"></div>
                    </a>
                    <a href="/contacto/ventas" class="btn-ghost">
                        <span>Contactar a ventas</span>
                    </a>
                </div>
            </div>
            <div class="startup-hero-visual">
                <CasoHeroMockup variant="agencias" />
            </div>
            </div>
        </header>

        <!-- INTEGRACIONES: el mismo marquee 3D de /integraciones -->
        <section class="uc-trust reveal">
            <p>Se conecta con las herramientas que ya usa tu equipo</p>
            <IntegrationsMarquee />
        </section>

                <!-- SECONDARY BENEFITS SECTION -->
        <section class="uc-benefits">
            <div class="uc-container">
                <div class="uc-benefits-intro reveal">
                    <h2 class="uc-split-title">Mantén a tu equipo enfocado en la creatividad</h2>
                    <p class="uc-split-desc">
                        Mientras tu equipo diseña, programa y lanza campañas, Cord lleva el cobro. Ofrece a tus clientes un pago sin fricción, y Cord registra cada cobro mensual de la iguala y lo concilia con su cotización.
                    </p>
                </div>

                <div class="uc-bento-cards">
                    <!-- Tarjeta 1 -->
                    <div class="uc-bento-card reveal">
                        <div class="uc-bc-text">
                            <h3>Cobra anticipos al instante con links de pago</h3>
                            <p>No inicies un proyecto sin el anticipo. Genera un enlace de pago directamente desde tu propuesta, para que tu cliente pague con tarjeta (o por SPEI en México, en pesos) en el momento en que acepta.</p>
                            <a href="/sign-up" class="uc-link-arrow">Descubre los enlaces de pago <span>&rarr;</span></a>
                        </div>
                        <div class="uc-bc-mockup">
                            <!-- Calca de /q/[token]/pay: el anticipo del link, con Tarjeta o SPEI -->
                            <div class="ucm-shot ucm-payp" style="--brand:#9f1239">
                                <div class="ucm-payc">
                                    <div class="ucm-pbrand"><span class="ucm-pav">E</span><span><b>Estudio Brío</b><small>Cotización COT-0212</small></span></div>
                                    <div class="ucm-pamt">
                                        <small>Anticipo a pagar</small>
                                        <b class="editorial">$45,820.00 <i>MXN</i></b>
                                        <em>del total de $91,640.00 MXN</em>
                                        <em>Tarjeta · Transferencia SPEI</em>
                                    </div>
                                    <div class="ucm-plegend">Método de pago</div>
                                    <div class="ucm-pmethods"><span>Tarjeta</span><span class="on">SPEI</span></div>
                                    <div class="ucm-spei-t">Instrucciones SPEI</div>
                                    <p class="ucm-spei-d">Transfiere el monto exacto y usa la referencia indicada. La confirmación es automática.</p>
                                    <div class="ucm-spei-r"><span>Monto</span><b class="editorial">$45,820.00 MXN</b></div>
                                    <div class="ucm-spei-r"><span>CLABE</span><b>646180157900012345</b><em>Copiar</em></div>
                                    <div class="ucm-spei-r"><span>Beneficiario</span><b>Estudio Brío SA de CV</b></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tarjeta 2 -->
                    <div class="uc-bento-card reveal">
                        <div class="uc-bc-text">
                            <h3>Igualas activas y seguimiento en vivo</h3>
                            <p>Ve cuánto suman tus igualas activas y cuáles tuvieron un cobro fallido, y qué clientes ya abrieron su propuesta. En pagos únicos, Cord manda recordatorios por correo antes del vencimiento sin que tengas que intervenir.</p>
                            <a href="/sign-up" class="uc-link-arrow">Empieza a cobrar mejor <span>&rarr;</span></a>
                        </div>
                        <div class="uc-bc-mockup">
                            <!-- Calca de /app/cobros: KPI "IGUALAS ACTIVAS" + cobros recientes -->
                            <div class="ucm-shot">
                                <div class="ucm-ph"><h4 class="ucm-ph-t">Cobros</h4><span class="ucm-dp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('calendar')}></svg>Este trimestre<svg class="ucm-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></div>
                                <div class="ucm-kpis2">
                                    <div class="ucm-card ucm-kpi"><span class="ucm-kl">COBRADO</span><b class="editorial">$486,200<i class="ucm-cur">MXN</i></b><small>31 operaciones en el periodo</small><small class="ucm-up">+18.4% vs. periodo anterior</small></div>
                                    <div class="ucm-card ucm-kpi"><span class="ucm-kl">IGUALAS ACTIVAS<em>en vivo</em></span><b class="editorial">$137,000<i class="ucm-cur">MXN</i></b><small>4 contratos recurrentes</small><small class="ucm-down">1 con cobro fallido</small></div>
                                </div>
                                <div class="ucm-card">
                                    <div class="ucm-sec">Cobros recientes</div>
                                    <div class="ucm-th ucm-cbr"><span>Folio</span><span>Cliente</span><span>Método</span><span>Fecha</span><span class="ucm-r">Monto</span></div>
                                    <div class="ucm-tr ucm-cbr"><span class="ucm-folio">COT-0209</span><span class="ucm-cli">Vela Foods</span><span class="ucm-met"><i style="background:#6366f1"></i><span>Tarjeta de crédito/débito</span></span><span class="ucm-date">29 sep 2026</span><span class="editorial ucm-r ucm-amt">$44,080<i class="ucm-cur">MXN</i></span></div><div class="ucm-tr ucm-cbr"><span class="ucm-folio">COT-0204</span><span class="ucm-cli">Nimbus Retail</span><span class="ucm-met"><i style="background:#10b981"></i><span>Transferencia SPEI</span></span><span class="ucm-date">28 sep 2026</span><span class="editorial ucm-r ucm-amt">$52,200<i class="ucm-cur">MXN</i></span></div><div class="ucm-tr ucm-cbr"><span class="ucm-folio">COT-0207</span><span class="ucm-cli">Casa Olmo</span><span class="ucm-met"><i style="background:#6366f1"></i><span>Tarjeta de crédito/débito</span></span><span class="ucm-date">26 sep 2026</span><span class="editorial ucm-r ucm-amt">$25,520<i class="ucm-cur">MXN</i></span></div><div class="ucm-tr ucm-cbr"><span class="ucm-folio">COT-0198</span><span class="ucm-cli">Hotel Marea</span><span class="ucm-met"><i style="background:#10b981"></i><span>Transferencia SPEI</span></span><span class="ucm-date">24 sep 2026</span><span class="editorial ucm-r ucm-amt">$37,120<i class="ucm-cur">MXN</i></span></div><div class="ucm-tr ucm-cbr"><span class="ucm-folio">COT-0195</span><span class="ucm-cli">Grupo Alcázar</span><span class="ucm-met"><i style="background:#6366f1"></i><span>Tarjeta de crédito/débito</span></span><span class="ucm-date">22 sep 2026</span><span class="editorial ucm-r ucm-amt">$38,000<i class="ucm-cur">MXN</i></span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Micro Features Grid -->
                <div class="uc-micro-features reveal">
                    <h3 class="uc-mf-title">Herramientas que blindan el flujo de caja de tu agencia</h3>
                    <div class="uc-mf-grid">
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('wallet')}></svg>
                            </div>
                            <h4>Seguimiento en tiempo real</h4>
                            <p>Cord te avisa en cuanto tu cliente abre la propuesta, si activas el aviso. Cada cobro mensual de la iguala se registra solo en el historial de la cotización, y ves el estado de la suscripción (activa, próximo cargo) sin intervenir.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('mail')}></svg>
                            </div>
                            <h4>Recordatorios inteligentes</h4>
                            <p>Si un cliente se retrasa, Cord le envía <a href="/producto/cobranza-ia" class="uc-link-inline">seguimientos por correo</a> con el tono que elijas, para que tú no tengas que hacerlo.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('globe')}></svg>
                            </div>
                            <h4>Cobros internacionales</h4>
                            <p><a href="/producto/divisas" class="uc-link-inline">Acepta dólares</a> y euros con tarjetas internacionales, perfecto para agencias con clientes en Estados Unidos o Europa.</p>
                        </div>
                        <div class="uc-mf-item">
                            <div class="uc-mf-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('template')}></svg>
                            </div>
                            <h4>Analítica de cartera</h4>
                            <p>Visualiza tu pipeline, el valor por cobrar, los días promedio de cobro, el ingreso mensual de igualas y el margen cedido en descuentos. Todo desde <a href="/producto/finanzas" class="uc-link-inline">los informes de Cord</a>.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    

        <!-- INTEGRATIONS SECTION -->
        



    
                <!-- POWER SECTION -->
        <section class="uc-power">
            <div class="uc-container">
                <h2 class="uc-power-title reveal">Escala tu agencia con el motor financiero de Cord</h2>
                <div class="uc-power-grid">
                    <div class="uc-power-item reveal">
                        <h3>Igualas mensuales sin perseguir pagos</h3>
                        <p>Envía la cotización de la iguala, tu cliente la aprueba con firma electrónica y autoriza su tarjeta una sola vez; Cord cobra cada mes y registra cada pago. Tú emites el CFDI cuando lo necesitas. Menos correos, más cobros.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Anticipos y pagos por etapa</h3>
                        <p>Cobra un anticipo al aprobar y el saldo después, o divide el pago en cuotas con fecha. Si tu proyecto va por fases, cotiza cada una por separado y <a href="/producto/pagos">cóbrala en su propio link</a>.</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Cartera y cobranza con IA</h3>
                        <p>El módulo de cobranza muestra la antigüedad del saldo de cada cliente y lo que tienes por cobrar. El agente de IA propone planes de pago a tus deudores; por defecto tú apruebas cada mensaje, y puedes activar el modo automático (plan Scale).</p>
                    </div>
                    <div class="uc-power-item reveal">
                        <h3>Un link de pago por factura</h3>
                        <p>Cada <a href="/producto/facturacion">factura</a> tiene su propio link, donde tu cliente descarga el PDF (y el XML en México) y paga en línea, incluso con abonos parciales.</p>
                    </div>
                </div>
            </div>
        </section>


        <FaqAccordion
            faqs={FAQS}
            title="Lo que preguntan las agencias antes de empezar."
            id="agencias"
            class="uc-faq-acc"
        />
    </main>
    <Footer />

</Layout>

<style>
    :global(.uc-faq-acc) { padding: 5rem 5% 7rem; }

    .uc-int-card {
        background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?q=80&w=2000'); background-size: cover; background-position: center;
        border-radius: 24px;
        padding: 4rem;
        text-align: center;
        max-width: 900px;
        margin: 0 auto 3rem;
        color: #fff;
    }
    .uc-int-card h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
        color: #fff;
    }
    .uc-int-card p {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #cbd5e1;
        max-width: 700px;
        margin: 0 auto;
    }
    .uc-int-card code {
        background: rgba(255,255,255,0.1);
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
    }
    .uc-int-logos {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        align-items: center;
        padding: 2rem 0;
    }
    .uc-logo-badge {
        font-size: 1.25rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: -0.02em;
        transition: color 0.3s;
    }
    .uc-logo-badge:hover {
        color: #0f172a;
    }
    
    .uc-power-item h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0a2540;
        margin-bottom: 0.75rem;
    }
    .uc-power-item p {
        font-size: 0.95rem;
        color: #425466;
        line-height: 1.5;
    }
    @media (max-width: 900px) {
        .uc-power-grid { grid-template-columns: 1fr 1fr; }
        .uc-int-card { padding: 3rem 1.5rem; }
        .uc-int-card h2 { font-size: 2rem; }
    }
    @media (max-width: 600px) {
        .uc-power-grid { grid-template-columns: 1fr; }
    }
    

    .uc-logo-img {
        height: 36px;
        width: auto;
        opacity: 0.7;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .uc-logo-badge:hover .uc-logo-img {
        opacity: 1;
        transform: scale(1.05);
    }
    
</style>

<style>
    /* VARIABLES Y UTILIDADES GLOBALES PARA USE CASES */
    .use-case-main {
        background: var(--color-bg);
        padding-top: 0;
        overflow-x: hidden;
        color: var(--color-text-muted);
    }


    .uc-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 5%;
    }

    /* ── HERO — layout de soluciones/startups: texto a la izquierda y, a la
       derecha, una calca de pantalla real (CasoHeroMockup) sobre la ola de seda. ── */
    .startup-hero {
        position: relative;
        padding: 150px 0 90px;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
        background: #f6f9fc;
    }

    /* Respaldo sin WebGL: la misma composición con degradados. */
    .startup-hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        background: linear-gradient(118deg, #f6f9fc 0%, #f6f9fc 42%, #FDBA74 44%, #FB7185 52%, #E879F9 64%, #A78BFA 80%, #60A5FA 100%);
    }
    /* Velo claro detrás del texto. */
    .startup-hero-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(246, 249, 252, 0.6) 0%, rgba(246, 249, 252, 0.25) 38%, transparent 55%);
    }

    .startup-hero-grid {
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        gap: 56px;
        align-items: center;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 20px;
    }

    .startup-hero-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        min-width: 0;
    }

    .startup-hero-visual {
        display: flex;
        justify-content: flex-end;
        min-width: 0;
    }

    .startup-title {
        /* Tamaño estándar de títulos (h1.masked-title, Layout.astro). */
        font-size: clamp(2.1rem, 3.4vw, 3.6rem);
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.035em;
        margin: 0 0 1.75rem;
        color: #050505;
        text-wrap: balance;
        max-width: 660px;
    }
    /* El vertical, en los tonos de su paleta (un paso más profundos para que
       se lean sobre claro). */
    .startup-title-accent {
        background: linear-gradient(92deg, #e11d48 0%, #c026d3 55%, #7c3aed 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: #c026d3;
    }

    .startup-sub {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        line-height: 1.6;
        color: #425466;
        max-width: 540px;
        margin: 0 0 2.4rem 0;
        font-weight: 400;
    }

    .startup-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .startup-hero .btn-ghost {
        color: #0a2540;
        border: 1px solid rgba(10, 37, 64, 0.15);
        background: rgba(255, 255, 255, 0.55);
    }

    .startup-hero .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.8);
        box-shadow: 0 6px 16px rgba(0,0,0,0.05);
    }

    @media (max-width: 880px) {
        .startup-hero { padding: 120px 0 64px; min-height: auto; }
        .startup-hero-grid { grid-template-columns: 1fr; gap: 48px; }
        .startup-hero-visual { justify-content: center; }
        .startup-hero-bg::after {
            background: linear-gradient(180deg, rgba(246, 249, 252, 0.72) 0%, rgba(246, 249, 252, 0.3) 45%, transparent 65%);
        }
    }
    @media (max-width: 520px) {
    }

    .uc-hero-inner {
        position: relative;
        z-index: 1;
        width: 100%;
    }

    .uc-hero-content {
        max-width: 640px;
    }

    .uc-title {
        font-size: clamp(2.2rem, 4vw, 3.8rem);
        font-weight: 800;
        color: var(--color-blue-deep);
        line-height: 1.1;
        letter-spacing: -0.04em;
        margin-bottom: 1.2rem;
        text-wrap: balance;
    }

    .uc-sub {
        font-size: 1.15rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin-bottom: 2rem;
        max-width: 90%;
    }

    /* ── BUTTONS (estilo soluciones/startups) ── */
    .uc-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .btn-luxe {
        position: relative;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--color-blue-deep); color: #fff;
        padding: 18px 38px; border-radius: 100px;
        font-size: 0.95rem; font-weight: 600; text-decoration: none;
        overflow: hidden;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 24px rgba(10, 25, 47, 0.2);
    }
    .btn-luxe span { position: relative; z-index: 2; }
    .btn-arrow {
        position: relative; z-index: 2; display: inline-block;
        width: 16px; height: 16px; margin-left: 6px;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-luxe:hover .btn-arrow { transform: translateX(4px); }
    .btn-shimmer {
        position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
        transform: skew(-20deg); transition: 0s; z-index: 1;
    }
    .btn-luxe:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(10, 25, 47, 0.3);
    }
    .btn-luxe:active {
        transform: translateY(-1px);
        box-shadow: 0 2px 4px rgba(10, 25, 47, 0.1);
    }
    .btn-luxe:hover .btn-shimmer {
        left: 150%;
        transition: left 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-ghost {
        display: inline-flex; align-items: center; gap: 9px;
        color: #0a2540; text-decoration: none;
        font-size: 1rem; font-weight: 600;
        padding: 15px 26px; border-radius: 100px;
        border: 1px solid rgba(10, 37, 64, 0.15);
        background: rgba(10, 37, 64, 0.03);
        transition: background 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }
    .btn-ghost:hover {
        background: rgba(10, 37, 64, 0.08);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
    }

    /* ── TRUST LOGOS ── */
    .uc-trust {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 3rem 5%;
    }
    .uc-trust p {
        font-size: 0.95rem; font-weight: 500; color: var(--color-text-muted); margin-bottom: 1.5rem;
    }

    /* ── STRIPE-LIKE SPLIT FEATURE ── */
    .uc-split-feature {
        padding: 6rem 0;
        background: #ffffff;
        border-bottom: 1px solid var(--color-border);
    }
    
    .uc-split-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 6rem;
        align-items: center;
    }

    .uc-split-text {
        max-width: 480px;
    }


    .uc-split-title {
        font-size: clamp(2.2rem, 3.5vw, 3rem);
        font-weight: 800;
        color: var(--color-blue-deep);
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin-bottom: 1.5rem;
        text-wrap: balance;
    }

    .uc-split-desc {
        font-size: 1.1rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin-bottom: 3.5rem;
    }
    .uc-split-desc a {
        color: var(--color-blue-deep, #0a192f);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px solid rgba(10,25,47,0.2);
        padding-bottom: 2px;
        transition: border-color 0.2s;
    }
    .uc-split-desc a:hover {
        border-color: var(--color-blue-deep);
    }

    .uc-feature-item {
        display: flex;
        gap: 1.25rem;
        margin-bottom: 3rem;
    }

    .uc-feature-icon {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
    }
    .uc-feature-icon svg {
        width: 100%;
        height: 100%;
    }

    .uc-feature-content h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-blue-deep);
        margin-bottom: 0.8rem;
        line-height: 1.35;
    }

    .uc-feature-content p {
        font-size: 1rem;
        color: var(--color-text-muted);
        line-height: 1.6;
    }
    .uc-feature-content a {
        color: var(--color-blue-deep, #0a192f);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px solid rgba(10,25,47,0.2);
        padding-bottom: 2px;
        transition: border-color 0.2s;
    }
    .uc-feature-content a:hover {
        border-color: var(--color-blue-deep);
    }

    /* MOCKUP UI REDESIGN */
    .uc-split-mockup {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Ventana cmk-* (kit compartido de mockups, calca estilo Stripe) */
    .uc-cmk-window {
        position: relative;
        width: 100%;
        max-width: 520px;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        text-align: left;
        border: 1px solid rgba(10, 25, 47, 0.08);
        box-shadow:
            0 2px 4px rgba(10, 25, 47, 0.05),
            0 40px 80px -24px rgba(10, 25, 47, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .uc-rw-glow {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 140%; height: 140%;
        background: radial-gradient(circle, rgba(15,23,42,0.06) 0%, rgba(255,255,255,0) 70%);
        z-index: 1;
        pointer-events: none;
    }
    
    .uc-retainer-widget {
        position: relative;
        width: 100%;
        max-width: 400px;
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid rgba(15,23,42,0.12);
        box-shadow: 0 30px 60px -15px rgba(15,23,42,0.08), 0 10px 30px -10px rgba(15,23,42,0.04);
        overflow: hidden;
        z-index: 2;
    }
    
    .uc-rw-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 24px;
        background: #f8fafc;
        border-bottom: 1px solid rgba(15,23,42,0.08);
    }
    
    .uc-rw-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .uc-rw-avatar {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        border: 1px solid rgba(15,23,42,0.1);
        background: #ffffff;
        display: flex; align-items: center; justify-content: center;
    }
    
    .uc-rw-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.2;
    }
    
    .uc-rw-sub {
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 500;
        margin-top: 2px;
    }
    
    .uc-rw-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f1f5f9;
        color: #334155;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
    }
    
    .uc-status-dot {
        width: 6px; height: 6px; border-radius: 50%; background: #10b981;
        box-shadow: 0 0 0 2px rgba(16,185,129,0.15);
    }

    .uc-rw-body {
        padding: 32px 24px;
    }

    .uc-rw-amount-block {
        text-align: center;
        margin-bottom: 32px;
    }
    .uc-rw-currency { font-size: 1.2rem; font-weight: 600; color: #64748b; vertical-align: super; }
    .uc-rw-amount { font-size: 3rem; font-weight: 700; color: #0f172a; letter-spacing: -0.04em; line-height: 1; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .uc-rw-period { font-size: 1rem; font-weight: 500; color: #64748b; }

    .uc-rw-timeline {
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
    }
    .uc-rw-timeline::before {
        content: '';
        position: absolute;
        top: 10px; bottom: 30px; left: 15px;
        width: 1px;
        background: #cbd5e1;
        z-index: 0;
    }

    .uc-tl-item {
        display: flex;
        gap: 16px;
        position: relative;
        z-index: 1;
        padding-bottom: 24px;
    }
    .uc-tl-item:last-child { padding-bottom: 0; }

    .uc-tl-icon {
        width: 32px; height: 32px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #cbd5e1;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        color: #94a3b8;
    }
    .uc-tl-icon svg { width: 14px; height: 14px; }

    .uc-tl-item.success .uc-tl-icon {
        background: #f8fafc;
        border-color: #0f172a;
        color: #0f172a;
    }
    .uc-tl-item.active .uc-tl-icon {
        background: #0f172a;
        border-color: #0f172a;
        color: #ffffff;
        box-shadow: 0 0 0 3px rgba(15,23,42,0.1);
    }

    .uc-tl-content {
        padding-top: 4px;
    }
    .uc-tl-content strong {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 4px;
    }
    .uc-tl-content span {
        display: block;
        font-size: 0.8rem;
        color: #64748b;
        line-height: 1.4;
    }

    .uc-rw-footer {
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        text-align: center;
        font-size: 0.8rem;
        color: #64748b;
    }
    .uc-rw-footer strong {
        color: #0f172a;
        font-weight: 700;
    }

    @media (max-width: 900px) {
        .uc-split-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
        }
        .uc-split-text {
            max-width: 100%;
        }
    }

    /* ── CTA SECTION ── */
    .uc-cta-section {
        padding: 4rem 0 8rem;
        background: var(--color-bg);
    }
    .uc-cta-box {
        background: #0a192f;
        border-radius: 20px;
        padding: 4rem 2rem;
        text-align: center;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(10, 25, 47, 0.25);
    }
    .uc-cta-box::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at center top, rgba(255,255,255,0.08), transparent 70%);
        pointer-events: none;
    }
    .uc-cta-box h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 1rem; position: relative; z-index: 1; }
    .uc-cta-box p { font-size: 1.1rem; color: #aab7c4; margin-bottom: 2rem; position: relative; z-index: 1; }
    .uc-cta-box .btn-luxe { background: #ffffff; color: #0a2540; box-shadow: 0 4px 14px rgba(255,255,255,0.1); }
    .uc-cta-box .btn-luxe:hover { background: #f8fafc; box-shadow: 0 6px 20px rgba(255,255,255,0.2); }

    @media (max-width: 900px) {
        .uc-hero { padding: 9rem 0 6rem; }
        .uc-hero-content { max-width: 100%; }
        .uc-title { font-size: 2.5rem; }
        .uc-bento-grid { grid-template-columns: 1fr; }
    }
    /* ── SECONDARY BENEFITS (STRIPE STYLE) ── */
    .uc-benefits {
        padding: 5rem 0 7rem;
        background: #ffffff;
        
    }
    .uc-benefits-intro {
        text-align: left;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        column-gap: 4rem;
        align-items: start;
        max-width: none;
        margin-bottom: 4rem;
    }
    .uc-benefits-intro > .uc-split-title { margin: 0; }
    .uc-benefits-intro > .uc-split-desc { margin: 0; max-width: 520px; }
    @media (max-width: 880px) {
        .uc-benefits-intro { grid-template-columns: 1fr; row-gap: 1.2rem; }
    }
    .uc-bento-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        margin-bottom: 6rem;
    }
    .uc-bento-card {
        background: #fff;
        display: flex;
        flex-direction: column;
    }
    .uc-bc-text {
        padding-right: 2rem;
        margin-bottom: 2.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .uc-bc-text h3 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0a2540;
        margin-bottom: 1rem;
        line-height: 1.25;
        letter-spacing: -0.02em;
    }
    .uc-bc-text p {
        font-size: 1.05rem;
        color: #425466;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }
    .uc-link-arrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #0f172a;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: color 0.2s;
        margin-top: auto;
    }
    .uc-link-arrow:hover {
        color: #334155;
    }
    .uc-link-arrow span {
        transition: transform 0.2s;
    }
    .uc-link-arrow:hover span {
        transform: translateX(4px);
    }

    /* Mockups dentro de bento cards: el lienzo gris ES el de la app; la calca
       (.ucm-shot) se recorta y se desvanece abajo. */
    .uc-bc-mockup {
        background: #f5f5f7;
        border-radius: 16px;
        padding: 0;
        height: 320px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(10,37,64,0.06);
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);
    }
    .cord-bg-1 {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #0a2540 0%, #1e293b 100%);
        clip-path: polygon(0 0, 100% 0, 100% 60%, 0 80%);
    }

    /* Micro mockups CSS */
    .uc-mini-invoice {
        position: relative; z-index: 2;
        background: #fff; width: 280px; border-radius: 12px;
        box-shadow: 0 20px 40px -10px rgba(10,37,64,0.15);
        padding: 24px; text-align: center; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .uc-mi-logo { width: 40px; height: 40px; border-radius: 50%; background: #0a2540; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; margin: 0 auto 12px; }
    .uc-mi-title { font-size: 0.95rem; font-weight: 700; color: #0a2540; margin-bottom: 4px; }
    .uc-mi-sub { font-size: 0.75rem; color: #64748b; margin-bottom: 20px; }
    .uc-mi-amount { font-size: 1.6rem; font-weight: 800; color: #0a2540; margin-bottom: 24px; }
    .uc-mi-currency { font-size: 0.85rem; color: #64748b; font-weight: 600; }
    .uc-mi-form { display: flex; flex-direction: column; gap: 10px; }
    .uc-mi-input { border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px; font-size: 0.75rem; color: #475569; display: flex; align-items: center; gap: 8px; text-align: left; background: #f8fafc; }
    .uc-mi-btn { background: #0a2540; color: #fff; border-radius: 6px; padding: 10px; font-size: 0.8rem; font-weight: 600; margin-top: 5px; }

    .uc-mini-portal {
        display: flex; width: 100%; height: 100%; background: #fff;
    }
    .uc-mp-sidebar {
        width: 120px; background: #f8fafc; border-right: 1px solid #e2e8f0; padding: 20px 12px;
        display: flex; flex-direction: column; gap: 12px;
    }
    .uc-mp-brand { font-size: 0.85rem; font-weight: 700; color: #0a2540; display: flex; align-items: center; gap: 6px; margin-bottom: 12px; }
    .uc-mp-dot { width: 16px; height: 16px; background: #0f172a; border-radius: 4px; }
    .uc-mp-nav { font-size: 0.75rem; color: #64748b; font-weight: 500; }
    .uc-mp-main { flex: 1; padding: 24px; text-align: left; }
    .uc-mp-header { font-size: 1.2rem; font-weight: 700; color: #0a2540; margin-bottom: 20px; }
    .uc-mp-card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; }
    .uc-mp-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; }
    .uc-mp-row div { display: flex; flex-direction: column; gap: 4px; }
    .uc-mp-row strong { color: #0a2540; font-size: 0.9rem; }
    .uc-mp-row span { color: #64748b; }
    .uc-mp-tag { background: #f1f5f9; color: #334155; padding: 4px 8px; border-radius: 100px; font-weight: 600; font-size: 0.7rem; }
    .uc-mp-divider { height: 1px; background: #e2e8f0; margin: 16px 0; }

    /* Micro Features */
    .uc-micro-features {
        padding-top: 5rem;
        
    }
    .uc-mf-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0a2540;
        margin-bottom: 3.5rem;
        text-align: left;
    }
    .uc-mf-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2.5rem;
    }
    .uc-mf-item {
        display: flex;
        flex-direction: column;
    }
    .uc-mf-icon {
        width: 40px;
        height: 40px;
        margin-bottom: 1.5rem;
        border-radius: 10px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-blue-deep);
    }
    .uc-mf-icon svg {
        width: 20px;
        height: 20px;
    }
    .uc-mf-item h4 {
        font-size: 1rem;
        font-weight: 700;
        color: #0a2540;
        margin-bottom: 0.8rem;
    }
    .uc-mf-item p {
        font-size: 0.95rem;
        color: #425466;
        line-height: 1.6;
    }
    .uc-link-inline {
        color: #0f172a;
        text-decoration: none;
        font-weight: 700;
        border-bottom: 1px solid rgba(15,23,42,0.2);
        padding-bottom: 1px;
        transition: border-color 0.2s;
    }
    .uc-link-inline:hover {
        border-color: #0f172a;
    }

    @media (max-width: 900px) {
        .uc-bento-cards {
            grid-template-columns: 1fr;
            gap: 4rem;
        }
        .uc-mf-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 3rem 2rem;
        }
        .uc-bc-text {
            padding-right: 0;
        }
    }
    @media (max-width: 600px) {
        .uc-mf-grid {
            grid-template-columns: 1fr;
        }
        .uc-bc-mockup {
            height: 280px;
        }
        .uc-benefits { padding: 4rem 0 5rem; }
    }

    /* ── INTEGRATIONS SECTION ── */
    .uc-power {
        padding: 6rem 0 8rem;
        background: transparent;
    }
    .uc-power-title {
        font-size:  3rem; margin-bottom: 2rem; max-width: 800px; ;
        font-weight: 800;
        color: #0a2540;
        margin-bottom: 4rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
        max-width: 600px;
    }
    .uc-power-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4rem 3rem;
    }
    .uc-power-item {
        display: flex;
        flex-direction: column;
    }
    
    /* CSS MOCKUPS FOR ICONS */
    .uc-power-icon {
        width: 54px;
        height: 54px;
        margin-bottom: 1.5rem;
        position: relative;
        border-radius: 12px;
        background: #f8fafc;
        box-shadow: 0 4px 12px rgba(10,37,64,0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    
    /* 1. Toggle / Switch */
    .uc-pi-toggle {
        width: 28px;
        height: 16px;
        background: #0f172a;
        border-radius: 10px;
        position: relative;
    }
    .uc-pi-toggle::after {
        content: '';
        position: absolute;
        top: 2px;
        right: 2px;
        width: 12px;
        height: 12px;
        background: #fff;
        border-radius: 50%;
    }
    
    /* 2. Chart / Bars */
    .uc-pi-chart {
        display: flex;
        align-items: flex-end;
        gap: 4px;
        height: 24px;
    }
    .uc-pi-chart span {
        width: 6px;
        background: #0f172a;
        border-radius: 2px 2px 0 0;
    }
    .uc-pi-chart span:nth-child(1) { height: 12px; background: #cbd5e1; }
    .uc-pi-chart span:nth-child(2) { height: 18px; }
    .uc-pi-chart span:nth-child(3) { height: 24px; background: #020617; }
    
    /* 3. Sync / Refresh (using CSS borders) */
    .uc-pi-sync {
        width: 24px;
        height: 24px;
        border: 3px solid #0f172a;
        border-top-color: transparent;
        border-radius: 50%;
        position: relative;
    }
    .uc-pi-sync::after {
        content: '';
        position: absolute;
        top: -6px;
        right: -3px;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #0f172a;
        transform: rotate(-45deg);
    }
    
    /* 4. Invoice / Document */
    .uc-pi-doc {
        width: 20px;
        height: 26px;
        background: #fff;
