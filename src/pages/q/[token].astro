---
// Link público — Quiet Luxury edition.
import Layout from '../../layouts/Layout.astro';
import QuoteCard from '../../components/q/QuoteCard.astro';
import DemoExperience from '../../components/q/DemoExperience.astro';
import { getCotizacionByToken } from '../../lib/queries';
import { getDemoQuote, isDemoQuoteToken } from '../../lib/demo-quote';
import { isInternalAnalyticsOrg } from '../../lib/analytics-internal';
import { resolveViewer } from '../../lib/public-viewer';
import { t } from '../../i18n/app';
import { currentLocale } from '../../lib/context';

const { token } = Astro.params;
let result;

// La demo pública (/q/demo) es Cord cotizándole a un cliente el plan
// Profesional, en la forma exacta del DTO real. Sus interacciones se resuelven
// en el navegador (modo demo de QuoteCard): nada llega a /api/q/demo.
const esDemo = isDemoQuoteToken(token);
if (esDemo) {
    result = getDemoQuote();
} else {
    result = await getCotizacionByToken(token ?? '');
}

if (!result) return Astro.redirect('/');
const { quote: q, org: ORG, conversacion } = result;

const analyticsOrgId = String((ORG as any).id || '');

// ── ¿Quién está abriendo esto? ────────────────────────────────────────────────
// La vista YA NO se marca aquí. Un GET al SSR lo hace cualquiera: el propio
// vendedor con su botón "Abrir link", el bot de WhatsApp generando la tarjeta
// del enlace, un prefetch del navegador. Marcar aquí convertía todos esos casos
// en "El cliente abrió el link" + webhook + correo al owner.
// Ahora la vista la marca el heartbeat (/api/q/[token] action:'ping'), que exige
// JavaScript y pestaña visible. Aquí solo se resuelve el actor para (a) fijar la
// cookie de visitante, que necesita una respuesta con Set-Cookie, y (b) mostrar
// el aviso de vista previa cuando quien abre es del equipo.
const L = currentLocale();
const viewer = esDemo
    ? null
    : await resolveViewer(analyticsOrgId, Astro, { crearCookie: true });
const esVistaPrevia = viewer?.rol === 'seller';
const analyticsInternal = esDemo || await isInternalAnalyticsOrg(analyticsOrgId);

const yaAprobada = ['approved', 'paid', 'invoiced'].includes(q.status);
const yaRechazada = q.status === 'rejected';
// Regreso del flujo de pago (Stripe Elements): el webhook confirma en segundos
// (tarjeta) o al liquidar el SPEI — mientras, se avisa que el pago va en camino.
const regresoDePago = Astro.url.searchParams.get('pagado') === '1' && q.status !== 'paid';
// La demo simula el pago en el navegador: no depende de que haya cobro configurado.
const pagoActivo = esDemo || !!(import.meta.env.STRIPE_SECRET_KEY || process.env.STRIPE_SECRET_KEY);
// Términos de crédito (Net 30/60): el pago NO se pide al aprobar — se habilita
// cuando llega la fecha de vencimiento (getCotizacionByToken calcula pagoDisponible).
// Con cobros parciales (anticipo/cuotas), mandan LOS COBROS: hay botón de pago
// solo si existe un cobro pendiente cuya fecha ya llegó.
const cobrosQ: any[] = Array.isArray((q as any).cobros) ? (q as any).cobros : [];
const hayCobroPagable = cobrosQ.some((co: any) => co.status === 'pendiente' && !co.venceEnFuturo);
// Con anticipo configurado, el anticipo es pagable EN CUANTO se aprueba (aunque
// el término sea a crédito) — los cobros aún no existen antes de aprobar, así
// que se considera el anticipo_pct directamente.
const anticipoPagable = Number((q as any).anticipoPct) >= 1 && q.status !== 'paid';
const pagoDisponible = cobrosQ.length > 0
    ? hayCobroPagable
    : ((q as any).pagoDisponible !== false || anticipoPagable);
const puedePagar = pagoActivo && pagoDisponible && (
    ORG.aceptaTransferencia ||
    ((ORG.aceptaTarjeta || ORG.cobroSpeiAuto) && ORG.stripeAccountId && ORG.stripeChargesEnabled)
);

const color = ORG.colorMarca || '#0a192f';
---

<Layout
    title={`Cotización ${q.folio} — ${ORG.nombre}`}
    noindex={true}
    analyticsDisabled={analyticsInternal}
    analyticsOrgId={analyticsOrgId}
    analyticsIsSandbox={!!ORG.esPrueba}
    analyticsIsDemo={!!ORG.esDemo}
>
    <div class="qp-bg" aria-hidden="true">
        <div class="qp-orb qp-orb-top"></div>
        <div class="qp-orb qp-orb-bot" style={`background: radial-gradient(circle, ${color}14 0%, transparent 70%)`}></div>
    </div>

    <main class="qp-main">
        {esVistaPrevia && (
            <div class="qp-preview" role="status">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" fill="currentColor" fill-opacity="0.13"/><circle cx="12" cy="12" r="3"/></svg>
                <span>{t(L, 'q.vista_previa')}</span>
            </div>
        )}
        {regresoDePago && (
            <div class="qp-payback" role="status">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" fill="currentColor" fill-opacity="0.1"/><polyline points="8 12.5 11 15.5 16 9.5"/></svg>
                <span>{t(L, 'q.regreso_pago')}</span>
            </div>
        )}
        {esDemo ? (
            // Demo: la misma tarjeta, envuelta en la guía, la vista simulada del
            // vendedor y el cierre. Ninguna cotización real pasa por aquí.
            <DemoExperience quote={q} org={ORG}>
                <QuoteCard
                    quote={q}
                    org={ORG}
                    conversacion={conversacion}
                    yaAprobada={yaAprobada}
                    yaRechazada={yaRechazada}
                    puedePagar={puedePagar}
                    standalone={true}
                />
            </DemoExperience>
        ) : (
            <QuoteCard
                quote={q}
                org={ORG}
                conversacion={conversacion}
                yaAprobada={yaAprobada}
                yaRechazada={yaRechazada}
                puedePagar={puedePagar}
                standalone={true}
            />
        )}
        {!esVistaPrevia && !esDemo && (
            <p class="qp-aviso">{t(L, 'q.aviso_actividad')}</p>
        )}
    </main>
</Layout>

<style>
    .qp-bg {
        position: fixed; inset: 0; z-index: 0;
        background: #f3f2ef;
        overflow: hidden; pointer-events: none;
    }
    .qp-orb { position: absolute; border-radius: 50%; filter: blur(90px); }
    .qp-orb-top {
        width: 70vw; height: 70vw; top: -30%; left: -15%;
        background: radial-gradient(circle, rgba(10,25,47,0.05) 0%, transparent 70%);
    }
    .qp-orb-bot { width: 55vw; height: 55vw; bottom: -20%; right: -10%; opacity: 0.7; }

    .qp-main {
        position: relative; z-index: 1;
        min-height: 100svh;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 1.8rem; padding: 3.5rem 5% 4rem;
    }

    .qp-payback {
        display: flex; align-items: flex-start; gap: 10px;
        max-width: 560px; width: 100%;
        background: #ffffff; border-radius: 16px;
        padding: 13px 16px;
        font-size: 0.82rem; color: #065f46; line-height: 1.5;
        box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 18px 40px -14px rgba(10,25,47,0.12);
        border: 1px solid rgba(16,185,129,0.2);
        animation: qp-payback-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .qp-payback svg { flex-shrink: 0; margin-top: 1px; color: #10b981; }
    @keyframes qp-payback-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .qp-payback { animation: none; } }

    /* Aviso para el propio equipo: este link no cuenta como vista del cliente. */
    .qp-preview {
        display: flex; align-items: flex-start; gap: 10px;
        max-width: 560px; width: 100%;
        background: #ffffff; border-radius: 16px;
        padding: 13px 16px;
        font-size: 0.82rem; color: #555556; line-height: 1.5;
        box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 18px 40px -14px rgba(10,25,47,0.12);
        border: 1px solid rgba(10,25,47,0.1);
    }
    .qp-preview svg { flex-shrink: 0; margin-top: 1px; color: #0a192f; }

    /* Transparencia: el cliente debe saber que su actividad es visible. */
    .qp-aviso {
        max-width: 560px; width: 100%;
        margin-top: -0.6rem;
        font-size: 0.72rem; color: #8a8a8e; line-height: 1.5;
        text-align: center; text-wrap: balance;
    }

    @media (max-width: 600px) {
        .qp-main { justify-content: flex-start; gap: 1rem; padding: max(1rem, env(safe-area-inset-top)) max(.75rem, env(safe-area-inset-right)) max(5rem, env(safe-area-inset-bottom)) max(.75rem, env(safe-area-inset-left)); }
        .qp-payback, .qp-preview { border-radius: 14px; padding: 12px; }
    }

    @media print {
        .qp-bg, .qp-payback, .qp-preview, .qp-aviso { display: none !important; }
        .qp-main { min-height: 0; padding: 0; display: block; }
    }
</style>
