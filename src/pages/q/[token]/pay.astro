---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import PaymentIsland from '../../../components/q/PaymentIsland';
import { sql, resolvePublicQuote, withOrgTx } from '../../../lib/db';
import { materializeAnticipoCobros, venceDia } from '../../../lib/cobros';
import { normalizeCurrency, currencyDecimals } from '../../../lib/currency';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
import type { PayStrings } from '../../../components/q/PaymentIsland';
import { availableRails } from '../../../lib/payment-rail';

const token = Astro.params.token ?? '';
const identity = await resolvePublicQuote(token);
if (!identity) return Astro.redirect('/404');
const [rows] = await withOrgTx(identity.orgId, sql`
    select c.id, c.org_id, c.folio, c.total, c.status, c.approved_at, c.created_at, c.anticipo_pct, c.es_recurrente, c.base_currency,
           coalesce(c.terminos, cl.terminos_default) as terminos,
           o.nombre, o.color_marca, o.logo_url,
           o.stripe_account_id, o.stripe_charges_enabled, o.acepta_tarjeta, o.cobro_spei_auto, o.sandbox_of,
           o.mp_charges_enabled, upper(coalesce(o.country_code, 'MX')) as pais,
           o.checkout_v2
    from cotizaciones c
    left join clientes cl on cl.id = c.cliente_id
    join orgs o on o.id = c.org_id
    where c.id = ${identity.id} and c.org_id = ${identity.orgId}`);

if (!rows.length) {
    return Astro.redirect('/404');
}

const q = rows[0];
const orgId = q.org_id as string;
const yaPagada = q.status === 'paid';

// Rieles de cobro en orden de prioridad: Cord Payments primero. Donde la cuenta
// tiene los dos se ofrece el primero y el otro queda como alternativa; donde
// solo hay uno, ese es el único.
const RAILS = availableRails({
    stripeAccountId: q.stripe_account_id as string | null,
    stripeChargesEnabled: !!q.stripe_charges_enabled,
    aceptaTarjeta: !!q.acepta_tarjeta,
    cobroSpeiAuto: !!q.cobro_spei_auto,
    mpChargesEnabled: !!q.mp_charges_enabled,
    country: q.pais as string,
});
const TIENE_CORD = RAILS.includes('cord_payments');
const TIENE_MP = RAILS.includes('mercadopago');
const MP_MARK = 'M11.115 16.479a.93.927 0 0 1-.939-.886c-.002-.042-.006-.155-.103-.155-.04 0-.074.023-.113.059-.112.103-.254.206-.46.206a.816.814 0 0 1-.305-.066c-.535-.214-.542-.578-.521-.725.006-.038.007-.08-.02-.11l-.032-.03h-.034c-.027 0-.055.012-.093.039a.788.786 0 0 1-.454.16.7.699 0 0 1-.253-.05c-.708-.27-.65-.928-.617-1.126.005-.041-.005-.072-.03-.092l-.05-.04-.047.043a.728.726 0 0 1-.505.203.73.728 0 0 1-.732-.725c0-.4.328-.722.732-.722.364 0 .675.27.721.63l.026.195.11-.165c.01-.018.307-.46.852-.46.102 0 .21.016.316.05.434.13.508.52.519.68.008.094.075.1.09.1.037 0 .064-.024.083-.045a.746.744 0 0 1 .54-.225c.128 0 .263.03.402.09.69.293.379 1.158.374 1.167-.058.144-.061.207-.005.244l.027.013h.02c.03 0 .07-.014.134-.035.093-.032.235-.08.367-.08a.944.942 0 0 1 .94.93.936.934 0 0 1-.94.928zm7.302-4.171c-1.138-.98-3.768-3.24-4.481-3.77-.406-.302-.685-.462-.928-.533a1.559 1.554 0 0 0-.456-.07c-.182 0-.376.032-.58.095-.46.145-.918.505-1.362.854l-.023.018c-.414.324-.84.66-1.164.73a1.986 1.98 0 0 1-.43.049c-.362 0-.687-.104-.81-.258-.02-.025-.007-.066.04-.125l.008-.008 1-1.067c.783-.774 1.525-1.506 3.23-1.545h.085c1.062 0 2.12.469 2.24.524a7.03 7.03 0 0 0 3.056.724c1.076 0 2.188-.263 3.354-.795a9.135 9.11 0 0 0-.405-.317c-1.025.44-2.003.66-2.946.66-.962 0-1.925-.229-2.858-.68-.05-.022-1.22-.567-2.44-.57-.032 0-.065 0-.096.002-1.434.033-2.24.536-2.782.976-.528.013-.982.138-1.388.25-.361.1-.673.186-.979.185-.125 0-.35-.01-.37-.012-.35-.01-2.115-.437-3.518-.962-.143.1-.28.203-.415.31 1.466.593 3.25 1.053 3.812 1.089.157.01.323.027.491.027.372 0 .744-.103 1.104-.203.213-.059.446-.123.692-.17l-.196.194-1.017 1.087c-.08.08-.254.294-.14.557a.705.703 0 0 0 .268.292c.243.162.677.27 1.08.271.152 0 .297-.015.43-.044.427-.095.874-.448 1.349-.82.377-.296.913-.672 1.323-.782a1.494 1.49 0 0 1 .37-.05.611.61 0 0 1 .095.005c.27.034.533.125 1.003.472.835.62 4.531 3.815 4.566 3.846.002.002.238.203.22.537-.007.186-.11.352-.294.466a.902.9 0 0 1-.484.15.804.802 0 0 1-.428-.124c-.014-.01-1.28-1.157-1.746-1.543-.074-.06-.146-.115-.22-.115a.122.122 0 0 0-.096.045c-.073.09.01.212.105.294l1.48 1.47c.002 0 .184.17.204.395.012.244-.106.447-.35.606a.957.955 0 0 1-.526.171.766.764 0 0 1-.42-.127l-.214-.206a21.035 20.978 0 0 0-1.08-1.009c-.072-.058-.148-.112-.221-.112a.127.127 0 0 0-.094.038c-.033.037-.056.103.028.212a.698.696 0 0 0 .075.083l1.078 1.198c.01.01.222.26.024.511l-.038.048a1.18 1.178 0 0 1-.1.096c-.184.15-.43.164-.527.164a.8.798 0 0 1-.147-.012c-.106-.018-.178-.048-.212-.089l-.013-.013c-.06-.06-.602-.609-1.054-.98-.059-.05-.133-.11-.21-.11a.128.128 0 0 0-.096.042c-.09.096.044.24.1.293l.92 1.003a.204.204 0 0 1-.033.062c-.033.044-.144.155-.479.196a.91.907 0 0 1-.122.007c-.345 0-.712-.164-.902-.264a1.343 1.34 0 0 0 .13-.576 1.368 1.365 0 0 0-1.42-1.357c.024-.342-.025-.99-.697-1.274a1.455 1.452 0 0 0-.575-.125c-.146 0-.287.025-.42.075a1.153 1.15 0 0 0-.671-.564 1.52 1.515 0 0 0-.494-.085c-.28 0-.537.08-.767.242a1.168 1.165 0 0 0-.903-.43 1.173 1.17 0 0 0-.82.335c-.287-.217-1.425-.93-4.467-1.613a17.39 17.344 0 0 1-.692-.189 4.822 4.82 0 0 0-.077.494l.67.157c3.108.682 4.136 1.391 4.309 1.525a1.145 1.142 0 0 0-.09.442 1.16 1.158 0 0 0 1.378 1.132c.096.467.406.821.879 1.003a1.165 1.162 0 0 0 .415.08c.09 0 .179-.012.266-.034.086.22.282.493.722.668a1.233 1.23 0 0 0 .457.094c.122 0 .241-.022.355-.063a1.373 1.37 0 0 0 1.269.841c.37.002.726-.147.985-.41.221.121.688.341 1.163.341.06 0 .118-.002.175-.01.47-.059.689-.24.789-.382a.571.57 0 0 0 .048-.078c.11.032.234.058.373.058.255 0 .501-.086.75-.265.244-.174.418-.424.444-.637v-.01c.083.017.167.026.251.026.265 0 .527-.082.773-.242.48-.31.562-.715.554-.98a1.28 1.279 0 0 0 .978-.194 1.04 1.04 0 0 0 .502-.808 1.088 1.085 0 0 0-.16-.653c.804-.342 2.636-1.003 4.795-1.483a4.734 4.721 0 0 0-.067-.492 27.742 27.667 0 0 0-5.049 1.62zm5.123-.763c0 4.027-5.166 7.293-11.537 7.293-6.372 0-11.538-3.266-11.538-7.293 0-4.028 5.165-7.293 11.539-7.293 6.371 0 11.537 3.265 11.537 7.293zm.46.004c0-4.272-5.374-7.755-12-7.755S.002 7.277.002 11.55L0 12.004c0 4.533 4.695 8.203 11.999 8.203 7.347 0 12-3.67 12-8.204z';

// La divisa sale de la COTIZACIÓN, no de una constante. Con `currency: 'MXN'`
// fijo, una venta en euros se le mostraba al comprador como "MX$5,000.00" —con
// "MXN" impreso debajo del monto— mientras Stripe le cobraba EUR. Regla 21.
const CURRENCY = normalizeCurrency(q.base_currency, 'MXN');
const DECIMALS = currencyDecimals(CURRENCY);
const L = currentLocale();
const INTL = L === 'en' ? 'en-US' : 'es-MX';
const fmtMoney = (n: number) => {
    try {
        return new Intl.NumberFormat(INTL, {
            style: 'currency', currency: CURRENCY,
            minimumFractionDigits: DECIMALS, maximumFractionDigits: DECIMALS,
        }).format(n);
    } catch {
        return new Intl.NumberFormat(INTL, { minimumFractionDigits: DECIMALS, maximumFractionDigits: DECIMALS }).format(n);
    }
};
const esRecurrente = !!q.es_recurrente;
const color = (q.color_marca as string) || '#0a192f';
const inicial = ((q.nombre as string) || 'C').trim().charAt(0).toUpperCase();

let amount = '';
let amountLabel = '';
let totalNote = '';
let cobroId = '';
let metodos = '';

// Los textos de la isla de pago se resuelven AQUÍ, no en el navegador: el
// diccionario pesa ~373 KB y quien abre este link es el cliente del vendedor.
const PAY_STRINGS: PayStrings = {
    metodoPago: t(L, 'pay.metodo_pago'),
    tarjeta: t(L, 'pay.tarjeta'),
    spei: 'SPEI',
    eligeMetodo: t(L, 'pay.elige_metodo'),
    pagoRecibido: t(L, 'pay.pago_recibido'),
    igualaActivada: t(L, 'pay.iguala_activada'),
    pagoRecibidoDesc: t(L, 'pay.pago_recibido_desc'),
    igualaActivadaDesc: t(L, 'pay.iguala_activada_desc'),
    volverCotizacion: t(L, 'pay.volver_cotizacion'),
    instruccionesSpei: t(L, 'pay.instrucciones_spei'),
    instruccionesSpeiDesc: t(L, 'pay.instrucciones_spei_desc'),
    monto: t(L, 'pay.monto'),
    banco: t(L, 'pay.banco'),
    beneficiario: t(L, 'pay.beneficiario'),
    referencia: t(L, 'pay.referencia'),
    vigencia: t(L, 'pay.vigencia'),
    copiar: t(L, 'pay.copiar'),
    copiado: t(L, 'pay.copiado'),
    imprimirGuardar: t(L, 'pay.imprimir_guardar'),
    enviarCorreo: t(L, 'pay.enviar_correo'),
    enviando: t(L, 'pay.enviando'),
    instruccionesEnviadas: t(L, 'pay.instrucciones_enviadas'),
    errorCorreo: t(L, 'pay.error_correo'),
    procesando: t(L, 'pay.procesando'),
    pagarAhora: t(L, 'pay.pagar_ahora'),
    pagarMonto: t(L, 'pay.pagar_monto'),
    autorizarMensual: t(L, 'pay.autorizar_mensual'),
    autorizarMonto: t(L, 'pay.autorizar_monto'),
    errorIniciarPago: t(L, 'pay.error_iniciar'),
};

if (esRecurrente) {
    // ── Iguala recurrente: autorización de suscripción (no cobro único) ──────
    // Requiere tarjeta (SPEI no auto-cobra). Si ya está autorizada, no hay nada
    // que hacer aquí → de vuelta al link, que muestra el estado de la iguala.
    const recurPagable = ['approved', 'invoiced'].includes(q.status as string)
        && !q.sandbox_of && !!q.stripe_account_id && !!q.stripe_charges_enabled && !!q.acepta_tarjeta;
    const [[subRow]] = await withOrgTx(orgId, sql`
        select estado from cotizacion_suscripciones
        where org_id = ${orgId} and cotizacion_id = ${q.id} limit 1`);
    const yaActiva = subRow && ['active', 'trialing', 'past_due'].includes(subRow.estado as string);
    if (!yaPagada && (!recurPagable || yaActiva)) return Astro.redirect(`/q/${token}`);
    amount = fmtMoney(Number(q.total));
    amountLabel = L === 'en' ? 'Monthly charge' : 'Cobro mensual';
    totalNote = L === 'en' ? 'repeats automatically every month' : 'se repite automáticamente cada mes';
    metodos = L === 'en' ? 'Card · cancel any time' : 'Tarjeta · cancela cuando quieras';
} else {
    const pagable = ['approved', 'invoiced'].includes(q.status as string)
        && !q.sandbox_of
        && RAILS.length > 0;

    // ── ¿QUÉ se paga hoy? ──
    // Cobros parciales (anticipo/saldo/cuotas): se paga el siguiente cobro pendiente
    // cuya fecha ya llegó. Sin cobros: el total, gateado por términos de crédito
    // (contado = pagable ya; net30/net60 = hasta la fecha de vencimiento).
    let [cobros] = await withOrgTx(orgId, sql`
        select id, tipo, numero_cuota, monto, status, vence
        from cotizacion_cobros
        where org_id = ${orgId} and cotizacion_id = ${q.id}
        order by vence asc nulls first, created_at asc`);
    // Respaldo: cotización con anticipo cuyos cobros no se materializaron al aprobar
    // (best-effort ahí) — materializarlos aquí para que la página muestre el MISMO
    // monto que payment-intent.ts va a cobrar (el anticipo, no el total).
    if (!cobros.length && Number(q.anticipo_pct) > 0 && Number(q.anticipo_pct) < 100 && !yaPagada) {
        try {
            await materializeAnticipoCobros(q.id as string, orgId);
            [cobros] = await withOrgTx(orgId, sql`
                select id, tipo, numero_cuota, monto, status, vence
                from cotizacion_cobros
                where org_id = ${orgId} and cotizacion_id = ${q.id}
                order by vence asc nulls first, created_at asc`);
        } catch { /* payment-intent.ts lo reintenta */ }
    }
    const hoyISO = new Date().toISOString().slice(0, 10);
    const pendientes = cobros.filter((co: any) => co.status === 'pendiente');
    const nextCobro = pendientes.find((co: any) => !co.vence || venceDia(co.vence) <= hoyISO) || null;

    const DAYS: Record<string, number> = { contado: 0, net30: 30, net60: 60 };
    const termDias = DAYS[(q.terminos as string) || 'contado'] ?? 0;
    const due = new Date((q.approved_at as string) || (q.created_at as string));
    due.setDate(due.getDate() + termDias);
    const totalPagableHoy = termDias === 0 || due.toISOString().slice(0, 10) <= hoyISO;

    // Sin nada pagable hoy (crédito vigente, o anticipo ya cubierto y saldo a futuro):
    // regresar al link público, que explica cuándo vence el pago.
    const hayQuePagar = cobros.length > 0 ? !!nextCobro : totalPagableHoy;
    if (!yaPagada && (!pagable || !hayQuePagar)) {
        return Astro.redirect(`/q/${token}`);
    }

    const cobroTipoLabel = (co: any) =>
        co.tipo === 'anticipo' ? (L === 'en' ? 'Deposit' : 'Anticipo')
        : co.tipo === 'saldo' ? (L === 'en' ? 'Balance' : 'Saldo')
        : co.tipo === 'cuota' ? (L === 'en' ? `Installment ${co.numero_cuota}` : `Cuota ${co.numero_cuota}`)
        : '';
    const montoCobro = nextCobro ? Number(nextCobro.monto) : Number(q.total);
    amount = fmtMoney(montoCobro);
    amountLabel = nextCobro && nextCobro.tipo !== 'total'
        ? (L === 'en' ? `${cobroTipoLabel(nextCobro)} due` : `${cobroTipoLabel(nextCobro)} a pagar`)
        : (L === 'en' ? 'Total due' : 'Total a pagar');
    totalNote = nextCobro && nextCobro.tipo !== 'total'
        ? (L === 'en' ? `of a ${fmtMoney(Number(q.total))} total` : `del total de ${fmtMoney(Number(q.total))}`)
        : '';
    cobroId = nextCobro ? (nextCobro.id as string) : '';
    metodos = TIENE_CORD
        ? [q.acepta_tarjeta ? (L === 'en' ? 'Card' : 'Tarjeta') : null, q.cobro_spei_auto ? (L === 'en' ? 'SPEI transfer' : 'Transferencia SPEI') : null].filter(Boolean).join(' · ')
        : (L === 'en' ? 'Card and Mercado Pago' : 'Tarjeta y Mercado Pago');
}
---

<Layout title={`${L === 'en' ? 'Pay' : 'Pagar'} ${q.folio} | ${q.nombre}`} noindex={true}>
    <main class="payp">
        <div class="payp-col">
            <header class="payp-head">
                <a href={`/q/${token}`} class="payp-back">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                    {L === 'en' ? 'Back to the quote' : 'Volver a la cotización'}
                </a>
            </header>

            <section class="payp-card">
                <div class="payp-brand">
                    {q.logo_url
                        ? <img class="payp-logo" src={q.logo_url as string} alt={q.nombre as string} />
                        : <span class="payp-avatar" style={`background:${color}`}>{inicial}</span>}
                    <div class="payp-brand-text">
                        <span class="payp-org">{q.nombre}</span>
                        <span class="payp-folio">{L === 'en' ? 'Quote' : 'Cotización'} {q.folio}</span>
                    </div>
                </div>

                <div class="payp-amount-block">
                    <span class="payp-amount-label">{amountLabel}</span>
                    <span class="editorial payp-amount">{amount} <small>{CURRENCY}</small></span>
                    {totalNote && <span class="payp-methods">{totalNote}</span>}
                    {!yaPagada && metodos && <span class="payp-methods">{metodos}</span>}
                </div>

                {yaPagada ? (
                    <div class="payp-paid">
                        <span class="payp-paid-ring">
                            <svg viewBox="0 0 52 52" width="58" height="58">
                                <circle cx="26" cy="26" r="23" fill="none" stroke={color} stroke-width="2"/>
                                <polyline points="14,27 22,35 38,18" fill="none" stroke={color} stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <strong>{t(L, 'pay.ya_pagada')}</strong>
                        <p>{L === 'en' ? `Nothing else to do here. ${q.nombre} already received your payment.` : `No hay nada más que hacer aquí. ${q.nombre} ya recibió tu pago.`}</p>
                        <a class="payp-paid-link" href={`/q/${token}`}>{t(L, 'pay.ver_cotizacion')}</a>
                    </div>
                ) : (
                    <Fragment>
                        {(TIENE_CORD || esRecurrente) && (
                            <div class="payp-element" style={`--theme-color: ${color};`}>
                                <PaymentIsland client:only="react" token={token} color={color} amountLabel={amount} cobroId={cobroId} subscription={esRecurrente} acceptsCard={!!q.acepta_tarjeta} acceptsSpei={!!q.cobro_spei_auto} checkoutV2={!!q.checkout_v2} strings={PAY_STRINGS} locale={L} />
                            </div>
                        )}
                        {/* Mercado Pago: una iguala recurrente necesita la suscripción de
                            Cord Payments, así que ahí no se ofrece. Con los dos rieles es la
                            alternativa (Cord Payments va primero); si es el único, es el botón. */}
                        {TIENE_MP && !esRecurrente && (
                            <div class:list={['payp-mp', { 'is-secondary': TIENE_CORD }]} style={`--theme-color: ${color};`}>
                                {TIENE_CORD && <div class="payp-or"><span>{t(L, 'pay.mp_o')}</span></div>}
                                <button type="button" class="payp-mp-btn" data-mp-pay data-token={token} data-cobro={cobroId}
                                    data-i18n-loading={t(L, 'pay.mp_redirigiendo')} data-i18n-error={t(L, 'pay.mp_error')}>
                                    <svg class="payp-mp-logo" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={MP_MARK} /></svg>
                                    <span data-mp-label>{t(L, 'pay.mp_pagar')}</span>
                                    <svg class="payp-mp-go" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 10.5 10.5 5.5M6.5 5.5h4v4"/></svg>
                                </button>
                                <p class="payp-mp-err" data-mp-err role="alert" hidden></p>
                            </div>
                        )}
                    </Fragment>
                )}
            </section>

            <footer class="payp-foot">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                {TIENE_CORD || esRecurrente
                    ? (L === 'en' ? `Encrypted and processed by Cord Payments. ${q.nombre} never sees your card details.` : `Pago cifrado y procesado por Cord Payments. ${q.nombre} nunca ve los datos de tu tarjeta.`)
                    : (L === 'en' ? `Encrypted and processed by Mercado Pago. ${q.nombre} never sees your card details.` : `Pago cifrado y procesado por Mercado Pago. ${q.nombre} nunca ve los datos de tu tarjeta.`)}
            </footer>
        </div>
    </main>
</Layout>

<style is:global>
    /* La página de pago es standalone — sin navbar/footer de la landing */
    body:has(.payp) #navbar,
    body:has(.payp) footer:not(.payp-foot) { display: none !important; }

    .payp {
        min-height: 100vh;
        min-height: 100dvh;
        background: #f5f5f7;
        display: flex;
        justify-content: center;
        padding: 2.2rem 1.25rem 3rem;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    }
    .payp-col { width: 100%; max-width: 470px; display: flex; flex-direction: column; }

    .payp-head { margin-bottom: 1.4rem; }
    .payp-back {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 0.85rem; font-weight: 500; color: #6b7686; text-decoration: none;
        transition: color 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .payp-back:hover { color: #0a192f; }
    .payp-back:hover svg { transform: translateX(-2px); }
    .payp-back svg { transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1); }

    .payp-card {
        background: #ffffff;
        border-radius: 28px;
        padding: 2rem 1.9rem 1.9rem;
        box-shadow:
            0 2px 4px rgba(10,25,47,0.04),
            0 28px 56px -14px rgba(10,25,47,0.12),
            inset 0 1px 0 rgba(255,255,255,0.6);
        border: 1px solid rgba(10,25,47,0.05);
        animation: payp-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes payp-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .payp-card { animation: none; } }

