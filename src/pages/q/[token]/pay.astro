</style>

<script>
    // Mercado Pago: pide la preferencia y manda al cliente a su checkout.
    // Los textos vienen del servidor (data-i18n-*), no de un diccionario en el
    // navegador: quien abre este link es el cliente del vendedor.
    function initMercadoPago() {
        const btn = document.querySelector<HTMLButtonElement>('[data-mp-pay]');
        if (!btn) return;
        const label = btn.querySelector<HTMLElement>('[data-mp-label]');
        const err = document.querySelector<HTMLElement>('[data-mp-err]');
        const original = label?.textContent ?? '';

        btn.addEventListener('click', async () => {
            btn.disabled = true;
            if (label) label.textContent = btn.dataset.i18nLoading || '';
            if (err) err.hidden = true;
            try {
                const res = await fetch(`/api/q/${encodeURIComponent(btn.dataset.token || '')}/mp-preference`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(btn.dataset.cobro ? { cobro_id: btn.dataset.cobro } : {}),
                });
                const data = await res.json().catch(() => ({}));
                // Ya estaba pagado: de vuelta al link, que lo explica.
                if (data.alreadyPaid) { window.location.href = `/q/${btn.dataset.token}`; return; }
                if (!res.ok || !data.url) throw new Error(data.error || '');
                window.location.href = data.url;
            } catch (e: any) {
                if (err) { err.textContent = e?.message || btn.dataset.i18nError || ''; err.hidden = false; }
                if (label) label.textContent = original;
                btn.disabled = false;
            }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMercadoPago);
    else initMercadoPago();
</script>
