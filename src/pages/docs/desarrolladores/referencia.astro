---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import ApiReference from '../../../components/docs/ApiReference.astro';
import { groupedOperations, API_REFERENCE_PAGE } from '../../../lib/api-reference';

const headings = groupedOperations().map(([tag]) => ({ depth: 2, slug: tag.toLowerCase().replace(/[^a-z0-9]+/g, '-'), text: tag }));
const page = API_REFERENCE_PAGE.es;
const alternates = { es: API_REFERENCE_PAGE.es.url, en: API_REFERENCE_PAGE.en.url };
---

<DocsLayout slug="desarrolladores/referencia" title={page.title} lang="es" description={page.description} headings={headings} alternates={alternates}>
  <header class="content-header">
    <h1 class="page-title">{page.title}</h1>
  </header>
  <ApiReference lang="es" />
</DocsLayout>
