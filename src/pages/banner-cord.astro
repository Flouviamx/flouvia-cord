---
// src/pages/banner-stripe.astro
import StripeBannerBg from '../components/StripeBannerBg.jsx';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Banner Shader - Stripe Style</title>
  <style>
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #f5f5f7; /* Gris claro de fondo por si acaso */
    }
    
    /* Contenedor que puedes redimensionar para capturar la imagen con las medidas exactas que necesites */
    .banner-container {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 1200px; /* Ajusta esto al tamaño de tu banner */
      height: 630px; /* Ajusta esto al tamaño de tu banner (ej: tamaño OG de Twitter) */
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
      resize: both;
    }
  </style>
</head>
<body>
  
  <div class="banner-container">
    <StripeBannerBg client:only="react" />
    <!-- Logo centrado (usando la imagen oficial de Cord) -->
    <div class="logo-wrapper" style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 10;">
      <img src="/imgs/logo-cord-white.png" alt="Cord" style="width: 320px; height: auto;" />
    </div>
  </div>

  <div style="position: absolute; bottom: 20px; left: 20px; font-family: system-ui; background: rgba(255,255,255,0.8); padding: 12px; border-radius: 8px; backdrop-filter: blur(10px); z-index: 20; color: #000;">
    <strong>Generador de OG Banner</strong><br>
    <small>Toma captura solo del recuadro principal.<br>El logo ya está perfectamente centrado.</small>
  </div>
</body>
</html>
