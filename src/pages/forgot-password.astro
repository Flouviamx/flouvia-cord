---
import Layout from '../layouts/Layout.astro';
import ForgotPassword from '../components/auth/ForgotPassword';
import '../styles/auth.css';
---

<Layout title="Recuperar contraseña - Cord">
    <div class="auth-page">
        <a href="/" class="auth-logo">
            <img src="/imgs/logo-cord-navy.png" alt="Cord" height="26" />
        </a>

        <ForgotPassword client:load />

        <p class="auth-page-footer">Hecho en México &nbsp;&middot;&nbsp; Datos cifrados</p>
    </div>
</Layout>

