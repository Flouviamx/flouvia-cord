---
// Segundo paso del login cuando la cuenta tiene TOTP activo. Se llega aquí
// desde CustomSignIn (fetch → mfaRequired) o desde los callbacks de Google/
// Apple (redirect directo). El reto vive en la cookie httpOnly
// cord_2fa_challenge — si no existe, Verify2fa.tsx rebota a /sign-in.
import Layout from '../layouts/Layout.astro';
import Verify2fa from '../components/auth/Verify2fa';
import '../styles/auth.css';

const hasChallenge = !!Astro.cookies.get('cord_2fa_challenge')?.value;
if (!hasChallenge) {
    return Astro.redirect('/sign-in');
}
---

<Layout title="Verificación en dos pasos - Cord">
    <div class="auth-page">
        <a href="/" class="auth-logo">
            <img src="/imgs/logo-cord-navy.png" alt="Cord" height="26" />
        </a>

        <Verify2fa client:only="react" />

        <p class="auth-page-footer">Hecho en México &nbsp;&middot;&nbsp; Datos cifrados</p>
    </div>
</Layout>

