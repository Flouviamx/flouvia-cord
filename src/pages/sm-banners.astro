---
// Herramienta interna de diseño. La ruta solo existe durante desarrollo.
export const prerender = false;
if (import.meta.env.PROD) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex' } });
}

const scenes = [
  { type: 'dashboard', label: 'Dashboard', title: 'El pulso de tu negocio, en una vista.', copy: 'Decisiones más rápidas con métricas que sí conectan ventas y cobros.', accent: '#64b5ff', kicker: 'Revenue intelligence' },
  { type: 'quote', label: 'AI Quoting', title: 'De un pedido complejo a una propuesta lista.', copy: 'Convierte instrucciones naturales en cotizaciones claras y rentables.', accent: '#55d7ad', kicker: 'Proposal engine' },
  { type: 'pipeline', label: 'Pipeline', title: 'Cada oportunidad. El siguiente paso.', copy: 'Un pipeline vivo para que ninguna venta se quede en pausa.', accent: '#8ca8ff', kicker: 'Sales command' },
  { type: 'link', label: 'Public Link', title: 'Un link que cierra por ti.', copy: 'Presenta, aprueba, firma y cobra en la misma experiencia.', accent: '#c8a8ff', kicker: 'Client experience' },
  { type: 'tracking', label: 'Live Tracking', title: 'Saber cuándo importa actuar.', copy: 'Entiende la intención de compra mientras la conversación sucede.', accent: '#f6bd70', kicker: 'Buyer signals' },
  { type: 'collections', label: 'AI Collections', title: 'Cobrar también puede ser una conversación.', copy: 'Planes de pago inteligentes, con el tono correcto y cero fricción.', accent: '#f29a9a', kicker: 'Receivables copilot' },
  { type: 'workflows', label: 'Workflows', title: 'El trabajo repetible, resuelto.', copy: 'Diseña automatizaciones con lógica clara y control total.', accent: '#91b7ff', kicker: 'No-code operations' },
  { type: 'payments', label: 'Cord Payments', title: 'El dinero llega con contexto.', copy: 'Cobros, comisiones y saldo disponible en tiempo real.', accent: '#68d3a4', kicker: 'Cash movement' },
  { type: 'reports', label: 'CFO Reports', title: 'Ver antes. Decidir mejor.', copy: 'La salud de tu negocio resumida en señales accionables.', accent: '#e9a47c', kicker: 'Executive view' },
  { type: 'developer', label: 'Dev Workbench', title: 'Una venta que también habla con tu stack.', copy: 'Eventos, webhooks y trazabilidad listos para operar.', accent: '#76d4e5', kicker: 'Built for builders' },
];
---

<!doctype html>
<html lang="es" translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Social Media Banners · Cord</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root { color-scheme: dark; --navy: #070d1a; --ink: #071425; --muted: #91a0b5; }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-width: 320px; background: var(--navy); color: #f7f9fc; font-family: Inter, system-ui, sans-serif; }
      body { overflow-x: hidden; }
      .smb-page { width: 100%; padding: 68px 0 120px; }
      .smb-header { width: min(1200px, calc(100% - 48px)); margin: 0 auto 70px; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
      .smb-brand { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,.64); font-size: 12px; font-weight: 600; letter-spacing: .02em; }
      .smb-brand img { width: 66px; height: auto; display: block; }
      .smb-header h1 { max-width: 680px; margin: 22px 0 0; font-size: clamp(34px, 5vw, 68px); line-height: .98; letter-spacing: -.06em; font-weight: 700; }
      .smb-header p { max-width: 340px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
      .smb-section { margin-bottom: 108px; }
      .smb-section-head { width: min(1200px, calc(100% - 48px)); margin: 0 auto 22px; display: flex; align-items: center; justify-content: space-between; color: rgba(255,255,255,.56); }
      .smb-section-head h2 { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
      .smb-section-head span { font-size: 11px; font-variant-numeric: tabular-nums; }
      .smb-rail { display: flex; gap: 42px; overflow-x: auto; padding: 24px max(24px, calc((100vw - 1200px) / 2)); scroll-snap-type: x mandatory; scrollbar-width: none; }
      .smb-rail::-webkit-scrollbar { display: none; }
      .smb-item { flex: 0 0 auto; scroll-snap-align: center; }
      .smb-item-meta { display: flex; align-items: center; gap: 9px; margin: 0 0 13px 10px; color: rgba(255,255,255,.57); font-size: 11px; font-weight: 600; letter-spacing: .02em; }
      .smb-item-meta img { width: 46px; height: auto; opacity: .9; }
      .smb-item-meta b { color: rgba(255,255,255,.19); font-weight: 400; }
      .smb-banner { position: relative; isolation: isolate; overflow: hidden; width: 1200px; height: 630px; border-radius: 24px; background: #0b1830; box-shadow: 0 24px 80px rgba(0,0,0,.34), 0 3px 10px rgba(0,0,0,.2); }
      .smb-banner::before { content: ''; position: absolute; inset: -20%; z-index: -2; background: radial-gradient(ellipse at 14% 40%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 40%), radial-gradient(ellipse at 86% 9%, rgba(255,255,255,.08), transparent 33%), linear-gradient(135deg, #08172c 0%, #0a1425 60%, #07101f 100%); }
      .smb-banner::after { content: ''; position: absolute; inset: 0; z-index: -1; opacity: .24; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.28'/%3E%3C/svg%3E"); mix-blend-mode: soft-light; pointer-events: none; }
      .smb-copy { position: absolute; z-index: 4; left: 62px; top: 0; bottom: 0; width: 335px; display: flex; flex-direction: column; justify-content: center; }
      .smb-kicker { margin: 0 0 22px; color: var(--accent); font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
      .smb-copy h3 { max-width: 330px; margin: 0 0 18px; font-size: 45px; line-height: 1.01; letter-spacing: -.055em; font-weight: 700; }
      .smb-copy p { max-width: 300px; margin: 0; color: rgba(255,255,255,.62); font-size: 15px; line-height: 1.55; }
      .smb-mark { position: absolute; left: 62px; bottom: 52px; color: rgba(255,255,255,.32); font-size: 11px; font-weight: 600; letter-spacing: .04em; }
      .smb-visual { position: absolute; z-index: 2; top: 54px; right: -16px; bottom: -28px; width: 785px; transform: rotate(-1.5deg); transform-origin: center bottom; }
      .smb-app { width: 100%; height: 100%; overflow: hidden; background: #f7f9fc; color: var(--ink); border: 1px solid rgba(255,255,255,.34); border-radius: 20px 0 0 0; box-shadow: -24px 24px 64px rgba(0,0,0,.34), 0 1px 0 rgba(255,255,255,.7) inset; font-family: Inter, system-ui, sans-serif; }
      .smb-app-top { height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid #e7ebf0; background: #fff; }
      .smb-app-title { display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; }
      .smb-app-title i { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 7px; background: #0a192f; color: #fff; font-style: normal; font-size: 10px; }
      .smb-app-sub { display: block; margin-top: 2px; color: #8a97a8; font-size: 9px; font-weight: 500; }
      .smb-app-status { display: inline-flex; align-items: center; gap: 6px; color: #5e6b7c; font-size: 10px; font-weight: 600; }
      .smb-app-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #23ad7a; box-shadow: 0 0 0 4px rgba(35,173,122,.1); }
      .smb-app-body { height: calc(100% - 52px); padding: 26px 28px; background: #f7f9fc; }
      .smb-overline { color: #718096; font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
      .smb-number { margin-top: 6px; color: #0b172b; font-size: 29px; line-height: 1; font-weight: 700; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
      .smb-number small { margin-left: 10px; color: #13875f; font-size: 10px; letter-spacing: 0; vertical-align: middle; }
      .smb-grid { display: grid; gap: 12px; }
      .smb-metric { padding: 15px; background: #fff; border: 1px solid #e3e8ee; border-radius: 11px; }
      .smb-metric label { display: block; margin-bottom: 8px; color: #7b8999; font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      .smb-metric strong { color: #0b172b; font-size: 18px; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
      .smb-metric em { margin-left: 6px; color: #159a69; font-size: 10px; font-style: normal; font-weight: 600; }
      .smb-chart { height: 190px; display: flex; align-items: flex-end; gap: 11px; padding: 22px 18px 0; border: 1px solid #e3e8ee; border-radius: 12px; background: #fff; }
      .smb-chart span { flex: 1; height: var(--h); min-width: 14px; border-radius: 4px 4px 0 0; background: #dfe6ee; }
      .smb-chart span:nth-last-child(2) { background: var(--accent); }
      .smb-chart span:last-child { background: #0a192f; }
      .smb-row { display: flex; align-items: center; justify-content: space-between; min-height: 45px; border-bottom: 1px solid #e8edf2; font-size: 11px; }
      .smb-row strong { font-weight: 700; }
      .smb-row span { color: #6e7c8c; }
      .smb-pill { display: inline-flex; align-items: center; padding: 4px 8px; border-radius: 999px; background: #e8f7f1; color: #12835d; font-size: 9px; font-weight: 700; }
      .smb-table-head, .smb-table-row { display: grid; grid-template-columns: 1.1fr 1.8fr .8fr .9fr; align-items: center; gap: 12px; }
      .smb-table-head { padding: 0 14px 10px; color: #8190a0; font-size: 8px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      .smb-table-row { min-height: 45px; padding: 0 14px; border-top: 1px solid #e8edf2; color: #26354a; font-size: 10px; }
      .smb-table-row strong { font-size: 10px; }
      .smb-board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; height: 100%; }
      .smb-column { padding: 14px; border-radius: 12px; background: #edf1f5; }
      .smb-column h4 { display: flex; justify-content: space-between; margin: 0 0 12px; color: #708094; font-size: 9px; text-transform: uppercase; letter-spacing: .07em; }
      .smb-column h4 b { color: #9ca8b5; }
      .smb-deal { padding: 12px; margin-bottom: 9px; border: 1px solid #e2e8ee; border-radius: 9px; background: #fff; box-shadow: 0 3px 8px rgba(20,40,70,.04); }
      .smb-deal strong { display: block; margin-bottom: 6px; font-size: 11px; }
      .smb-deal span { color: #778697; font-size: 9px; }
      .smb-deal b { float: right; color: #0a192f; font-size: 10px; }
      .smb-proposal { width: 365px; height: 100%; margin: auto; overflow: hidden; border-radius: 14px; background: #fff; box-shadow: 0 14px 30px rgba(20,35,60,.12); }
      .smb-proposal-head { padding: 20px; background: #0a192f; color: #fff; }
      .smb-proposal-head small { color: rgba(255,255,255,.52); font-size: 9px; }
      .smb-proposal-head strong { display: block; margin-top: 11px; font-size: 17px; }
      .smb-proposal-body { padding: 19px; }
      .smb-proposal-line { display: flex; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid #edf0f3; color: #728092; font-size: 10px; }
      .smb-proposal-line strong { color: #15233a; font-size: 11px; }
      .smb-total { display: flex; align-items: baseline; justify-content: space-between; margin: 18px 0; color: #6c7a8b; font-size: 11px; }
      .smb-total strong { color: #0a192f; font-size: 23px; letter-spacing: -.05em; }
      .smb-button { width: 100%; padding: 12px; border: 0; border-radius: 8px; background: #0a192f; color: #fff; font-size: 11px; font-weight: 700; }
      .smb-timeline { position: relative; padding-left: 28px; }
      .smb-timeline::before { content: ''; position: absolute; top: 8px; bottom: 8px; left: 7px; width: 1px; background: #dce3ea; }
      .smb-event { position: relative; padding: 0 0 21px; }
      .smb-event::before { content: ''; position: absolute; left: -25px; top: 3px; width: 8px; height: 8px; border: 2px solid #fff; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 1px #cdd7e2; }
      .smb-event time { color: #8b98a7; font-size: 9px; }
      .smb-event strong { display: block; margin: 4px 0; font-size: 11px; }
      .smb-event span { color: #748294; font-size: 10px; }
      .smb-agent { display: grid; grid-template-columns: 1fr 1.25fr; gap: 16px; height: 100%; }
      .smb-agent-stat { padding: 18px; border-radius: 12px; background: #0a192f; color: #fff; }
      .smb-agent-stat h4 { margin: 0 0 20px; font-size: 11px; }
      .smb-agent-stat .smb-overline { color: rgba(255,255,255,.47); }
      .smb-agent-stat .smb-number { color: #fff; font-size: 28px; }
      .smb-agent-stat .smb-row { border-color: rgba(255,255,255,.1); }
      .smb-agent-stat .smb-row span { color: rgba(255,255,255,.57); }
      .smb-agent-message { padding: 20px; border: 1px solid #e2e8ef; border-radius: 12px; background: #fff; }
      .smb-agent-message header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; font-size: 11px; font-weight: 700; }
      .smb-agent-message header span { color: #b27725; font-size: 9px; font-weight: 700; }
      .smb-message { padding: 15px; border-radius: 10px 10px 10px 2px; background: #f1f4f7; color: #526174; font-size: 11px; line-height: 1.65; }
      .smb-flow { display: flex; align-items: center; gap: 10px; height: 100%; }
      .smb-node { width: 170px; padding: 16px; border: 1px solid #dfe6ed; border-radius: 11px; background: #fff; box-shadow: 0 6px 14px rgba(20,40,70,.05); }
      .smb-node small { color: #8a98a7; font-size: 8px; font-weight: 700; letter-spacing: .1em; }
      .smb-node strong { display: block; margin-top: 7px; font-size: 11px; }
      .smb-node p { margin: 6px 0 0; color: #798697; font-size: 9px; line-height: 1.4; }
      .smb-arrow { color: #9aa7b5; font-size: 16px; }
      .smb-balance { display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; height: 100%; }
      .smb-balance-card { padding: 22px; border-radius: 13px; background: #0a192f; color: #fff; }
      .smb-balance-card .smb-overline { color: rgba(255,255,255,.48); }
      .smb-balance-card .smb-number { color: #fff; font-size: 35px; }
      .smb-balance-card .smb-chart { height: 115px; padding: 18px 10px 0; border-color: rgba(255,255,255,.1); background: rgba(255,255,255,.04); }
      .smb-balance-card .smb-chart span { background: rgba(255,255,255,.2); }
      .smb-balance-card .smb-chart span:nth-last-child(2) { background: var(--accent); }
      .smb-balance-card .smb-chart span:last-child { background: #fff; }
      .smb-list { padding: 5px 18px; border-radius: 13px; background: #fff; }
      .smb-list h4 { margin: 13px 0 8px; font-size: 11px; }
      .smb-report { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; height: 100%; }
      .smb-report .smb-metric { display: flex; flex-direction: column; justify-content: space-between; }
      .smb-report .smb-chart { grid-column: 1 / -1; height: 185px; }
      .smb-code { display: grid; grid-template-columns: 1.1fr 1fr; gap: 15px; height: 100%; padding: 18px; background: #0b1628; color: #d3deec; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      .smb-code h4 { margin: 0 0 14px; color: #fff; font-family: Inter, sans-serif; font-size: 11px; }
      .smb-log { padding: 13px; border: 1px solid rgba(255,255,255,.09); border-radius: 10px; background: rgba(255,255,255,.035); font-size: 9px; line-height: 2; }
      .smb-log b { color: var(--accent); }
      .smb-log i { color: #74d6a8; font-style: normal; }
      .smb-json { padding: 14px; overflow: hidden; border-radius: 10px; background: #07101d; color: #8ea0b8; font-size: 9px; line-height: 1.7; white-space: pre; }
      .smb-json strong { color: #e8c47f; font-weight: 500; }
      .smb-vertical { width: 360px; height: 640px; border-radius: 22px; }
      .smb-vertical .smb-copy { left: 26px; right: 26px; top: 28px; bottom: auto; width: auto; display: block; }
      .smb-vertical .smb-kicker { margin-bottom: 13px; font-size: 8px; }
      .smb-vertical .smb-copy h3 { max-width: 300px; margin-bottom: 10px; font-size: 31px; line-height: 1.02; }
      .smb-vertical .smb-copy p { max-width: 285px; font-size: 11px; line-height: 1.45; }
      .smb-vertical .smb-mark { left: 26px; bottom: 19px; font-size: 9px; }
      .smb-vertical .smb-visual { top: 248px; right: 14px; left: 14px; bottom: 35px; width: auto; transform: none; }
      .smb-vertical .smb-app { border-radius: 16px 16px 0 0; }
      .smb-vertical .smb-app-top { height: 40px; padding: 0 13px; }
      .smb-vertical .smb-app-body { height: calc(100% - 40px); padding: 16px; }
      .smb-vertical .smb-app-title { gap: 7px; font-size: 9px; }
      .smb-vertical .smb-app-title i { width: 18px; height: 18px; font-size: 8px; }
      .smb-vertical .smb-app-sub, .smb-vertical .smb-app-status { font-size: 7px; }
      .smb-vertical .smb-number { font-size: 22px; }
      .smb-vertical .smb-number small { font-size: 8px; }
      .smb-vertical .smb-overline { font-size: 7px; }
      .smb-vertical .smb-metric { padding: 10px; }
      .smb-vertical .smb-metric label { font-size: 7px; margin-bottom: 5px; }
      .smb-vertical .smb-metric strong { font-size: 14px; }
      .smb-vertical .smb-metric em { font-size: 8px; }
      .smb-vertical .smb-chart { height: 110px; gap: 6px; padding: 15px 10px 0; }
      .smb-vertical .smb-table-head, .smb-vertical .smb-table-row { gap: 5px; font-size: 8px; }
      .smb-vertical .smb-table-head { padding: 0 8px 7px; font-size: 6px; }
      .smb-vertical .smb-table-row { min-height: 34px; padding: 0 8px; font-size: 8px; }
      .smb-vertical .smb-table-row strong { font-size: 8px; }
      .smb-vertical .smb-board { gap: 7px; }
      .smb-vertical .smb-column { padding: 8px; }
      .smb-vertical .smb-column h4 { margin-bottom: 8px; font-size: 7px; }
      .smb-vertical .smb-deal { padding: 8px; margin-bottom: 6px; }
      .smb-vertical .smb-deal strong, .smb-vertical .smb-deal b { font-size: 8px; }
      .smb-vertical .smb-deal span { font-size: 7px; }
      .smb-vertical .smb-proposal { width: 100%; }
      .smb-vertical .smb-proposal-head { padding: 14px; }
      .smb-vertical .smb-proposal-head strong { margin-top: 7px; font-size: 13px; }
      .smb-vertical .smb-proposal-body { padding: 12px; }
      .smb-vertical .smb-proposal-line { padding: 9px 0; font-size: 8px; }
      .smb-vertical .smb-proposal-line strong { font-size: 9px; }
      .smb-vertical .smb-total { margin: 12px 0; font-size: 8px; }
      .smb-vertical .smb-total strong { font-size: 18px; }
      .smb-vertical .smb-button { padding: 9px; font-size: 9px; }
      .smb-vertical .smb-event { padding-bottom: 13px; }
      .smb-vertical .smb-event time, .smb-vertical .smb-event span { font-size: 8px; }
      .smb-vertical .smb-event strong { font-size: 9px; }
      .smb-vertical .smb-agent { gap: 8px; }
      .smb-vertical .smb-agent-stat, .smb-vertical .smb-agent-message { padding: 11px; }
      .smb-vertical .smb-agent-stat h4, .smb-vertical .smb-agent-message header { font-size: 8px; }
      .smb-vertical .smb-agent-stat .smb-number { font-size: 20px; }
      .smb-vertical .smb-message { padding: 9px; font-size: 8px; }
      .smb-vertical .smb-flow { gap: 5px; }
      .smb-vertical .smb-node { width: 1px; flex: 1; padding: 8px; }
      .smb-vertical .smb-node small { font-size: 6px; }
      .smb-vertical .smb-node strong { margin-top: 5px; font-size: 8px; }
      .smb-vertical .smb-node p { font-size: 7px; }
      .smb-vertical .smb-arrow { font-size: 11px; }
      .smb-vertical .smb-balance { gap: 8px; }
      .smb-vertical .smb-balance-card { padding: 12px; }
      .smb-vertical .smb-balance-card .smb-number { font-size: 24px; }
      .smb-vertical .smb-list { padding: 3px 10px; }
      .smb-vertical .smb-list h4 { margin: 8px 0 4px; font-size: 8px; }
      .smb-vertical .smb-row { min-height: 31px; font-size: 8px; }
      .smb-vertical .smb-report { gap: 7px; }
      .smb-vertical .smb-report .smb-metric { padding: 8px; }
      .smb-vertical .smb-report .smb-chart { height: 108px; }
      .smb-vertical .smb-code { gap: 7px; padding: 10px; }
      .smb-vertical .smb-code h4 { margin-bottom: 8px; font-size: 8px; }
      .smb-vertical .smb-log, .smb-vertical .smb-json { padding: 8px; font-size: 7px; line-height: 1.7; }
      @media (max-width: 700px) {
        .smb-page { padding-top: 34px; }
        .smb-header { width: calc(100% - 36px); margin-bottom: 48px; display: block; }
        .smb-header h1 { margin-top: 18px; font-size: 46px; }
        .smb-header p { margin-top: 22px; }
        .smb-section { margin-bottom: 72px; }
        .smb-section-head { width: calc(100% - 36px); }
        .smb-rail { gap: 24px; padding-inline: 18px; }
      }
    </style>
  </head>
  <body>
    <main class="smb-page">
      <header class="smb-header">
        <div>
          <div class="smb-brand"><img src="/imgs/logo-cord-white.png" alt="Cord" /><span>Social campaign system</span></div>
          <h1>El ciclo completo.<br />En una sola mirada.</h1>
        </div>
        <p>Mockups 1:1 para campañas de producto. Veinte piezas, diez historias de Cord, listas para seleccionar.</p>
      </header>

      {(['horizontal', 'vertical'] as const).map((format) => (
        <section class="smb-section" aria-labelledby={`${format}-title`}>
          <div class="smb-section-head">
            <h2 id={`${format}-title`}>{format === 'horizontal' ? '01 / Horizontal · 1200 × 630' : '02 / Vertical · 360 × 640'}</h2>
            <span>{scenes.length} escenas · scroll horizontal</span>
          </div>
          <div class="smb-rail">
            {scenes.map((scene, index) => (
              <article class="smb-item">
                <div class="smb-item-meta"><img src="/imgs/logo-cord-white.png" alt="" /><b>/</b><span>{String(index + 1).padStart(2, '0')} · {scene.label}</span></div>
                <div class:list={['smb-banner', format === 'vertical' && 'smb-vertical']} style={`--accent:${scene.accent}`}>
                  <div class="smb-copy"><div class="smb-kicker">{scene.kicker}</div><h3>{scene.title}</h3><p>{scene.copy}</p></div>
                  <div class="smb-mark">CORD · {scene.label.toUpperCase()}</div>
                  <div class="smb-visual">
                    {scene.type === 'dashboard' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>↗</i><div>Dashboard<span class="smb-app-sub">Desarrollos Inmobiliarios</span></div></div><div class="smb-app-status">En vivo</div></div><div class="smb-app-body"><div class="smb-overline">Ingreso cerrado</div><div class="smb-number">$1,847,320 <small>↑ 14%</small></div><div class="smb-chart" style="margin-top:22px"><span style="--h:32%"></span><span style="--h:47%"></span><span style="--h:39%"></span><span style="--h:68%"></span><span style="--h:53%"></span><span style="--h:84%"></span><span style="--h:61%"></span><span style="--h:100%"></span><span style="--h:77%"></span></div><div class="smb-grid" style="grid-template-columns:repeat(3,1fr);margin-top:14px"><div class="smb-metric"><label>Tasa de cierre</label><strong>68%</strong><em>+4%</em></div><div class="smb-metric"><label>Por cerrar</label><strong>$450k</strong></div><div class="smb-metric"><label>DSO</label><strong>14 días</strong><em>ok</em></div></div></div></div>}
                    {scene.type === 'quote' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>✦</i><div>Arma la cotización<span class="smb-app-sub">Asistente inteligente · listo</span></div></div><div class="smb-pill">Analizado</div></div><div class="smb-app-body"><div style="display:grid;grid-template-columns:1.25fr .75fr;gap:22px;height:100%"><div><div class="smb-overline">Instrucción del cliente</div><div style="margin:9px 0 20px;padding:14px;border-radius:10px;background:#eaf6f1;color:#356b59;font-size:11px;line-height:1.55">“Cotiza branding, landing page y tres meses de contenido. Aplica 10% al primer concepto.”</div><div class="smb-table-head" style="grid-template-columns:1.8fr .8fr .8fr;padding-inline:0"><span>Concepto</span><span>Precio</span><span>Importe</span></div><div class="smb-table-row" style="grid-template-columns:1.8fr .8fr .8fr;padding-inline:0"><strong>Branding integral</strong><span>$45,000</span><strong>$40,500</strong></div><div class="smb-table-row" style="grid-template-columns:1.8fr .8fr .8fr;padding-inline:0"><strong>Iguala social media</strong><span>× 3 meses</span><strong>$45,000</strong></div><div class="smb-table-row" style="grid-template-columns:1.8fr .8fr .8fr;padding-inline:0"><strong>Landing page</strong><span>$25,000</span><strong>$25,000</strong></div></div><div class="smb-metric" style="align-self:start"><label>Total con IVA</label><strong style="font-size:25px">$128,180</strong><div style="margin-top:18px;padding-top:14px;border-top:1px solid #e5eaf0;color:#728092;font-size:10px;line-height:1.7">MXN · 30 días de vigencia<br />Margen protegido · 42.6%</div><button class="smb-button" style="margin-top:20px">Enviar cotización →</button></div></div></div></div>}
                    {scene.type === 'pipeline' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>▦</i><div>Cotizaciones<span class="smb-app-sub">Pipeline de ventas</span></div></div><div class="smb-app-status">8 activas</div></div><div class="smb-app-body"><div class="smb-board"><div class="smb-column"><h4>Borrador <b>2</b></h4><div class="smb-deal"><strong>COT-084 <b>$120,500</b></strong><span>Grupo Alsea</span></div><div class="smb-deal"><strong>COT-081 <b>$84,000</b></strong><span>Hospital Ángeles</span></div></div><div class="smb-column"><h4>Vista <b>3</b></h4><div class="smb-deal"><strong>COT-079 <b>$32,100</b></strong><span>Constructora AX</span></div><div class="smb-deal"><strong>COT-076 <b>$210,000</b></strong><span>Distribuidora del Bajío</span></div></div><div class="smb-column"><h4>Aprobada <b>3</b></h4><div class="smb-deal"><strong>COT-078 <b>$210,000</b></strong><span>Bimbo SA de CV</span></div><div class="smb-deal"><strong>COT-075 <b>$95,600</b></strong><span>Aceros del Norte</span></div></div></div></div></div>}
                    {scene.type === 'link' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>↗</i><div>Vista del cliente<span class="smb-app-sub">app.cord.com/q/d7a8b9c0</span></div></div><div class="smb-pill">Seguro</div></div><div class="smb-app-body" style="display:grid;place-items:center"><div class="smb-proposal"><div class="smb-proposal-head"><small>DESARROLLOS INMOBILIARIOS</small><strong>Propuesta Comercial · Q3</strong></div><div class="smb-proposal-body"><div class="smb-proposal-line"><span>Licencia empresarial<br /><small>Suscripción anual</small></span><strong>$120,000</strong></div><div class="smb-proposal-line"><span>Implementación<br /><small>Setup inicial y migración</small></span><strong>$35,000</strong></div><div class="smb-total"><span>Total a pagar</span><strong>$155,000</strong></div><button class="smb-button">Aprobar y firmar</button></div></div></div></div>}
                    {scene.type === 'tracking' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>◉</i><div>Cotización #4092<span class="smb-app-sub">Desarrollos Polanco</span></div></div><div class="smb-pill">Viendo ahora</div></div><div class="smb-app-body"><div class="smb-grid" style="grid-template-columns:1fr 1fr;gap:24px;height:100%"><div><div class="smb-overline">Estado de la cotización</div><div class="smb-timeline" style="margin-top:22px"><div class="smb-event"><time>09:18 · hace 4 min</time><strong>El cliente abrió el link</strong><span>Sesión activa en Ciudad de México</span></div><div class="smb-event"><time>09:20 · hace 2 min</time><strong>Revisó Detalle de Precios</strong><span>Tiempo de lectura · 2m 10s</span></div><div class="smb-event"><time>09:22 · ahora</time><strong>Volvió a Resumen Ejecutivo</strong><span>Señal de intención alta</span></div></div></div><div class="smb-metric" style="align-self:start"><label>Atención del cliente</label><strong style="font-size:31px">72%</strong><div class="smb-chart" style="height:110px;margin-top:15px;padding:12px 8px 0;gap:6px"><span style="--h:22%"></span><span style="--h:30%"></span><span style="--h:46%"></span><span style="--h:78%"></span><span style="--h:92%"></span><span style="--h:66%"></span></div><div style="margin-top:10px;color:#7d8a99;font-size:10px">Momento recomendado para dar seguimiento</div></div></div></div></div>}
                    {scene.type === 'collections' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>✦</i><div>Agente de cobranza<span class="smb-app-sub">Monitoreo y recuperación automática</span></div></div><div class="smb-pill">Revisión requerida</div></div><div class="smb-app-body"><div class="smb-agent"><div class="smb-agent-stat"><h4>Resumen del mes</h4><div class="smb-overline">Monto recuperado</div><div class="smb-number">$425,000</div><div class="smb-row" style="margin-top:22px"><span>Facturas gestionadas</span><strong>18</strong></div><div class="smb-row"><span>Tasa de éxito</span><strong>92%</strong></div></div><div class="smb-agent-message"><header><span>Borrador propuesto por IA</span><span>Editar</span></header><div class="smb-message">Hola equipo,<br /><br />Notamos que la factura <strong>INV-8892</strong> por <strong>$45,000 MXN</strong> tiene un atraso de 15 días. Estructuramos un <strong>plan de pagos a 3 meses</strong> sin intereses moratorios.<br /><br />¿Les parece bien si lo activamos hoy mismo?</div><button class="smb-button" style="margin-top:15px">Aprobar y enviar</button></div></div></div></div>}
                    {scene.type === 'workflows' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>↯</i><div>Flujo: Onboarding clientes<span class="smb-app-sub">Publicado hace 2 min</span></div></div><div class="smb-pill">Activo</div></div><div class="smb-app-body"><div class="smb-flow"><div class="smb-node"><small>DISPARADOR</small><strong>Cotización aprobada</strong><p>Cuando el cliente confirma la propuesta</p></div><div class="smb-arrow">→</div><div class="smb-node"><small>ESPERA</small><strong>Esperar 1 día</strong><p>Una ventana de seguimiento</p></div><div class="smb-arrow">→</div><div class="smb-node" style="border-color:#a9dcc8"><small style="color:#148361">ACCIÓN</small><strong>Notificar en Slack</strong><p>Mensaje al canal #ventas</p></div></div></div></div>}
                    {scene.type === 'payments' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>₿</i><div>Destino del dinero<span class="smb-app-sub">Cord Payments · conciliado</span></div></div><div class="smb-app-status">Hoy, 10:42</div></div><div class="smb-app-body"><div class="smb-balance"><div class="smb-balance-card"><div class="smb-overline">Saldo disponible</div><div class="smb-number">$1,207,600</div><div style="margin:11px 0 20px;color:#6ed9ab;font-size:10px">↑ 12.4% vs mes anterior</div><div class="smb-chart"><span style="--h:32%"></span><span style="--h:47%"></span><span style="--h:52%"></span><span style="--h:61%"></span><span style="--h:76%"></span><span style="--h:100%"></span></div></div><div class="smb-list"><h4>Cobros recientes</h4><div class="smb-row"><span><strong>Desarrollos Inm.</strong><br />SPEI</span><strong>$245,000</strong></div><div class="smb-row"><span><strong>Logística MX</strong><br />Tarjeta</span><strong>$85,000</strong></div><div class="smb-row"><span><strong>Aceros del Norte</strong><br />Tarjeta</span><strong>$62,400</strong></div></div></div></div></div>}
                    {scene.type === 'reports' && <div class="smb-app"><div class="smb-app-top"><div class="smb-app-title"><i>⌁</i><div>Proyección de flujo<span class="smb-app-sub">Reporte ejecutivo · últimos 90 días</span></div></div><div class="smb-app-status">Actualizado</div></div><div class="smb-app-body"><div class="smb-report"><div class="smb-metric"><label>DSO · días venta cobro</label><strong>24 días</strong><em>-2 días vs ant.</em></div><div class="smb-metric"><label>Concentración</label><strong>18%</strong><em>Top 5 clientes</em></div><div class="smb-metric"><label>Margen bruto</label><strong>64%</strong><em>+4% interanual</em></div><div class="smb-chart"><span style="--h:42%"></span><span style="--h:57%"></span><span style="--h:68%"></span><span style="--h:76%"></span><span style="--h:84%"></span><span style="--h:91%"></span><span style="--h:100%"></span><span style="--h:88%"></span></div></div></div></div>}
                    {scene.type === 'developer' && <div class="smb-app"><div class="smb-app-top" style="background:#0b1628;border-color:rgba(255,255,255,.08);color:#fff"><div class="smb-app-title" style="color:#fff"><i style="background:#fff;color:#0a192f">⌘</i><div>Eventos <span class="smb-app-sub" style="color:#91a0b5">Webhook monitor · live</span></div></div><div class="smb-app-status" style="color:#8ed8b8">Connected</div></div><div class="smb-code"><div><h4>Eventos recientes</h4><div class="smb-log"><b>10:42:15</b> POST /webhooks/cord <i>200 OK</i><br />↳ quote.approved<br /><b>10:38:02</b> POST /webhooks/cord <i>200 OK</i><br />↳ payment.succeeded<br /><b>10:15:44</b> POST /webhooks/cord <span style="color:#f09b9b">500 ERR</span><br />↳ invoice.created</div></div><div><h4>Payload</h4><div class="smb-json">{`{`}<br />  <strong>"type"</strong>: "quote.approved",<br />  <strong>"amount"</strong>: 24500000,<br />  <strong>"currency"</strong>: "MXN",<br />  <strong>"status"</strong>: "paid"<br />{`}`}</div></div></div></div>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>
