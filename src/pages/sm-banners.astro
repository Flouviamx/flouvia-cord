---
// src/pages/sm-banners.astro
import StripeBannerBg from '../components/StripeBannerBg.jsx';
---

<!DOCTYPE html>
<html lang="en" translate="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media Banners | Cord</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body, html { 
      margin: 0; padding: 0; width: 100%; height: 100%; 
      background-color: #050a15; 
      font-family: 'Inter', system-ui, -apple-system, sans-serif; 
    }
    
    .gallery-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 120px;
      padding: 80px 20px;
      overflow-y: auto;
      height: 100vh;
      box-sizing: border-box;
    }

    .banner-wrapper {
      position: relative;
      width: 1200px; 
      height: 630px; 
      border-radius: 12px; 
      overflow: hidden;
      box-shadow: 0 40px 80px rgba(0,0,0,0.6);
      flex-shrink: 0;
      background-color: #0a192f;
    }

    .banner-label {
      position: absolute;
      top: -40px; left: 0;
      color: #94a3b8; font-size: 15px; font-weight: 500;
      letter-spacing: 0.02em;
    }

    /* --- LinkedIn Mockup Styles --- */
    .connection-lines { position: absolute; inset: 0; pointer-events: none; z-index: 10; }
    .connection-lines path { stroke: rgba(255,255,255,0.3); stroke-width: 1.5px; fill: none; stroke-linecap: round; }
    .connection-lines circle { fill: rgba(255,255,255,1); box-shadow: 0 0 10px rgba(255,255,255,0.5); }
    
    .source-node {
      position: absolute; top: 50%; left: 240px; transform: translate(-50%, -50%);
      width: 120px; height: 120px; background: rgba(10, 25, 47, 0.6);
      backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      z-index: 20; box-shadow: 0 0 80px rgba(255,255,255,0.05), inset 0 2px 10px rgba(255,255,255,0.1);
    }
    .pulse-ring { position: absolute; inset: -16px; border: 1px solid rgba(255,255,255,0.06); border-radius: 50%; }
    .pulse-ring-2 { position: absolute; inset: -32px; border: 1px solid rgba(255,255,255,0.03); border-radius: 50%; }
    
    .cards-column {
      position: absolute; right: 110px; top: 0; bottom: 0; display: flex; flex-direction: column;
      justify-content: center; gap: 20px; z-index: 20; width: 300px;
    }
    .mock-panel {
      width: 100%; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(24px);
      border: 1px solid rgba(10,25,47,0.05); border-radius: 16px; padding: 16px;
      box-shadow: 0 8px 32px -8px rgba(10,25,47,0.15), 0 2px 8px rgba(10,25,47,0.05), inset 0 1px 0 rgba(255,255,255,1);
      color: #0a192f; display: flex; flex-direction: column; gap: 4px; box-sizing: border-box;
    }
    .mock-header { display: flex; gap: 10px; align-items: center; margin-bottom: 4px; }
    .icon-box { width: 28px; height: 28px; background: rgba(10,25,47,0.04); border-radius: 8px; display: flex; align-items: center; justify-content: center; box-shadow: inset 0 1px 0 rgba(255,255,255,0.6); }
    .icon-box svg { width: 14px; height: 14px; color: #0a192f; stroke-width: 2; }
    .mock-title { font-weight: 600; font-size: 14px; letter-spacing: -0.01em; }
    .mock-row { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-top: 1px solid rgba(10,25,47,0.04); }
    .row-label { font-size: 11.5px; color: #64748b; font-weight: 500; display: flex; align-items: center; gap: 6px; }
    .row-pill { font-size: 10.5px; font-weight: 600; padding: 4px 10px; border-radius: 99px; background: rgba(10,25,47,0.05); color: #0a192f; font-variant-numeric: tabular-nums; }
    .pill-green { background: rgba(16,185,129,0.12); color: #047857; }
    .pill-blue { background: rgba(15, 63, 235, 0.1); color: #0F3FEB; }
    .label-icon { width: 12px; height: 12px; color: #94a3b8; stroke-width: 2; }
    
    .footer-text {
      position: absolute; bottom: 30px; left: 40px; color: rgba(255,255,255,0.6);
      font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 8px;
      z-index: 20; letter-spacing: 0.02em;
    }
  </style>
</head>
<body>
  <div class="gallery-container">
    
    <!-- 1. LinkedIn Feature Post -->
    <div style="position: relative;">
      <div class="banner-label">1. LinkedIn Feature Post (1200x630)</div>
      <div class="banner-wrapper">
        <StripeBannerBg client:only="react" />

        <div class="footer-text">
          <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
          <span style="opacity: 0.4;">|</span>
          Product Infrastructure
        </div>

        <div class="source-node">
          <div class="pulse-ring"></div>
          <div class="pulse-ring-2"></div>
          <img src="/imgs/logo-cord-white.png" alt="Cord" style="width: 70px; height: auto; opacity: 0.95;" />
        </div>

        <svg class="connection-lines" viewBox="0 0 1200 630">
          <path d="M 300 315 C 450 315, 550 155, 790 155" />
          <circle cx="790" cy="155" r="3" />
          <path d="M 300 315 L 790 315" />
          <circle cx="790" cy="315" r="3" />
          <path d="M 300 315 C 450 315, 550 475, 790 475" />
          <circle cx="790" cy="475" r="3" />
          <circle cx="300" cy="315" r="3" />
        </svg>

        <div class="cards-column">
          <!-- Proposals -->
          <div class="mock-panel">
            <div class="mock-header">
              <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg></div>
              <div class="mock-title">Proposals</div>
            </div>
            <div class="mock-row" style="border-top: none; padding-top: 0;">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> Workflow</span>
              <span class="row-pill">Interactive</span>
            </div>
            <div class="mock-row">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg> Rendering</span>
              <span class="row-pill">Dynamic</span>
            </div>
            <div class="mock-row">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg> Status</span>
              <span class="row-pill pill-green">Issued</span>
            </div>
          </div>

          <!-- Signatures -->
          <div class="mock-panel">
            <div class="mock-header">
              <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></div>
              <div class="mock-title">Contract Signatures</div>
            </div>
            <div class="mock-row" style="border-top: none; padding-top: 0;">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg> Identity</span>
              <span class="row-pill">Verified</span>
            </div>
            <div class="mock-row">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg> Legal</span>
              <span class="row-pill">Binding</span>
            </div>
            <div class="mock-row">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg> Status</span>
              <span class="row-pill pill-blue">Signed</span>
            </div>
          </div>

          <!-- Invoices -->
          <div class="mock-panel">
            <div class="mock-header">
              <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg></div>
              <div class="mock-title">Invoice Processing</div>
            </div>
            <div class="mock-row" style="border-top: none; padding-top: 0;">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Latency</span>
              <span class="row-pill">Zero</span>
            </div>
            <div class="mock-row">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> Payment</span>
              <span class="row-pill">Auto</span>
            </div>
            <div class="mock-row">
              <span class="row-label"><svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg> Status</span>
              <span class="row-pill pill-green">Captured</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Standard Stripe Banner -->
    <div style="position: relative;">
      <div class="banner-label">2. Standard Stripe Banner (1200x630)</div>
      <div class="banner-wrapper">
        <StripeBannerBg client:only="react" />
        <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 10;">
          <img src="/imgs/logo-cord-white.png" alt="Cord" style="width: 320px; height: auto;" />
        </div>
      </div>
    </div>

  </div>
</body>
</html>
