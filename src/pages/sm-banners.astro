              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Cord Payments
            </div>
          </div>
          <div class="banner-wrapper-vertical" style="background-color: #0A192F; overflow: hidden; position: relative;">
