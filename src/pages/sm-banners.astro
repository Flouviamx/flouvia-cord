                    <div style="display: flex; align-items: baseline; gap: 6px; margin-bottom: 2px;">
                       <span style="font-size: 28px; font-weight: 700; color: #0f172a; letter-spacing: -0.02em;">$1,087.67</span>
                       <span style="font-size: 13px; font-weight: 600; color: #64748b;">USD</span>
                    </div>
                    <div style="font-size: 12px; color: #64748b;">of $2,175.34 total</div>
                 </div>
                 
                 <!-- Payment Method -->
                 <div style="margin-bottom: 16px;">
                    <div style="font-size: 12px; font-weight: 500; color: #0f172a; margin-bottom: 6px;">Payment method</div>
                    <div style="display: flex; background: #f8fafc; border-radius: 10px; padding: 4px;">
