            </div>
          </div>
          <div class="banner-wrapper" style="background-color: #061F20;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#061F20', color1: '#10B981', color2: '#047857', color3: '#F59E0B' }} 
              grain={false}
            />

          </div>
        </div>

        <!-- 3. Live Tracking & Approvals -->
        <div class="carousel-slide">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="footer-text">
              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Operational Infrastructure
            </div>
          </div>
          <div class="banner-wrapper" style="background-color: #0F172A;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#0F172A', color1: '#38BDF8', color2: '#6670F4', color3: '#10B981' }} 
              grain={false}
            />

          </div>
        </div>

        <!-- 4. Automated Billing -->
        <div class="carousel-slide">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="footer-text">
              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Operational Infrastructure
            </div>
          </div>
          <div class="banner-wrapper" style="background-color: #1E1B4B;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#1E1B4B', color1: '#6366F1', color2: '#8B5CF6', color3: '#D946EF' }} 
              grain={false}
            />

          </div>
        </div>

        <!-- 5. Scale to Entire Operation -->
        <div class="carousel-slide">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="footer-text">
              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Operational Infrastructure
            </div>
          </div>
          <div class="banner-wrapper" style="background-color: #38BDF8;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#38BDF8', color1: '#60A5FA', color2: '#FDE68A', color3: '#34D399' }} 
              grain={false}
            />

        </div>

