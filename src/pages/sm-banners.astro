                          <circle cx="16" cy="12" r="5" stroke="white" stroke-width="2" stroke-opacity="0.6" fill="none"/>
                          <path d="M8 7A5 5 0 0 1 12 12A5 5 0 0 1 8 17" stroke="white" stroke-width="2" stroke-linecap="round"/>
                       </svg>
                    </div>
                    <div>
                       <div style="font-size: 15px; font-weight: 600; color: #0f172a;">Nexus Studio</div>
                       <div style="font-size: 12px; color: #64748b; font-weight: 500;">Quote COT-0011</div>
                    </div>
                 </div>
                 
                 <!-- Amount Section -->
                 <div style="background: #f8fafc; border-radius: 14px; padding: 16px; margin-bottom: 16px;">
