                       <div style="flex: 1; text-align: center; padding: 8px 0; border-radius: 6px; font-size: 12px; font-weight: 500; color: #64748b;">Wire</div>
                    </div>
                 </div>
                 
                 <!-- Card Details Form -->
                 <div style="margin-bottom: 16px;">
                    <div style="font-size: 12px; font-weight: 500; color: #0f172a; margin-bottom: 6px;">Card number</div>
                    <div style="border: 1px solid #e2e8f0; background: #f8fafc; border-radius: 10px; padding: 10px 14px; display: flex; align-items: center; justify-content: space-between;">
                       <span style="color: #cbd5e1; font-size: 13px; font-family: monospace; letter-spacing: 0.05em;">1234 1234 1234 1234</span>
                       <div style="display: flex; gap: 4px;">
                          <div style="width: 24px; height: 16px; background: #1434CB; border-radius: 3px; display: flex; align-items: center; justify-content: center; color: white; font-size: 7px; font-weight: bold; font-style: italic;">VISA</div>
                          <div style="width: 24px; height: 16px; background: #EB001B; border-radius: 3px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                             <div style="position: absolute; left: 3px; width: 9px; height: 9px; border-radius: 50%; background: #F79E1B;"></div>
                             <div style="position: absolute; right: 3px; width: 9px; height: 9px; border-radius: 50%; background: #FF5F00;"></div>
                          </div>
                       </div>
                    </div>
                 </div>
                 
                 <!-- Expiry & CVC -->
                 <div style="display: flex; gap: 12px; margin-bottom: 16px;">
                    <div style="flex: 1;">
                       <div style="font-size: 12px; font-weight: 500; color: #0f172a; margin-bottom: 6px;">Expiry date</div>
                       <div style="border: 1px solid #e2e8f0; background: #f8fafc; border-radius: 10px; padding: 10px 14px; color: #cbd5e1; font-size: 13px;">MM/YY</div>
                    </div>
                    <div style="flex: 1;">
                       <div style="font-size: 12px; font-weight: 500; color: #0f172a; margin-bottom: 6px;">Security code</div>
                       <div style="border: 1px solid #e2e8f0; background: #f8fafc; border-radius: 10px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; color: #cbd5e1; font-size: 13px;">
                          <span>CVC</span>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #94a3b8;"><rect x="3" y="5" width="18" height="14" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="16" y1="15" x2="18" y2="15"/></svg>
                       </div>
                    </div>
                 </div>

                 <!-- Pay Button -->
                 <button style="width: 100%; background: #0f172a; color: white; border: none; border-radius: 10px; padding: 14px; font-size: 14px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 0; box-shadow: 0 4px 12px rgba(15,23,42,0.15);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Pay $1,087.67
                 </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Portada 3: Quote Preview Vertical (From Horizontal 3) -->
        <div class="carousel-slide">
          <div style="display: flex; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="footer-text">
              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Cord Payments
            </div>
          </div>
          <div class="banner-wrapper-vertical" style="background-color: #0F172A; overflow: hidden; position: relative;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#0F172A', color1: '#38BDF8', color2: '#6670F4', color3: '#10B981' }} 
              grain={false}
            />
            <div style="position: absolute; width: 1040px; height: 600px; left: -450px; top: 120px; z-index: 10; font-family: 'Inter', sans-serif; transform: scale(0.85);">
              <div class="cmk-shot" style="width: 100%; height: 100%; background: white; border-radius: 20px; box-shadow: 0 40px 100px rgba(0,0,0,0.8); border: 1px solid rgba(226,232,240,1);">
                <div class="cmk-nav" style="border-bottom: 1px solid #e2e8f0; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-radius: 20px 20px 0 0;">
                  <div class="cmk-nav-l" style="display: flex; gap: 16px; align-items: center;">
                    <div class="cmk-brand-dot" style="width: 36px; height: 36px; background: #0f172a; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; border-radius: 8px;">Ac</div>
                    <div>
                       <div class="cmk-nav-title" style="font-weight: 600; font-size: 15px;">Acme Corp Enterprise</div>
                       <div class="cmk-nav-sub" style="font-size: 13px; color: #64748b;">Propuesta Comercial · Q3</div>
                    </div>
                  </div>
                  <div class="cmk-badge cmk-b-green" style="background: #ecfdf5; color: #059669; padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 8px;"><div class="cmk-dot cmk-dot-green" style="width: 6px; height: 6px; background: #10b981; border-radius: 50%;"></div> Client Viewing Now</div>
                </div>
                
                <div class="cmk-body" style="padding: 40px; display: flex; gap: 40px;">
                   <div style="flex: 2;">
                      <div class="cmk-eyebrow" style="font-size: 11px; font-weight: 700; color: #94a3b8; letter-spacing: 0.1em; text-transform: uppercase;">Document Status</div>
                      <div class="cmk-rule" style="margin-top: 24px;">
                         <div style="display: flex; gap: 16px; align-items: flex-start;">
                            <div style="width: 32px; height: 32px; border-radius: 50%; background: #10b981; color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg></div>
                            <div>
                              <div style="font-weight: 700; font-size: 15px; color: #0f172a; margin-bottom: 4px;">Identity Verified</div>
                              <div class="cmk-rule-line" style="font-size: 14px; color: #64748b;">Jane Doe (jane@acmecorp.com) authenticated via work email.</div>
                            </div>
                         </div>
                      </div>
                      <div class="cmk-rule" style="margin-top: 32px;">
                         <div style="display: flex; gap: 16px; align-items: flex-start;">
                            <div style="width: 32px; height: 32px; border-radius: 50%; background: #3b82f6; color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></div>
                            <div>
                              <div style="font-weight: 700; font-size: 15px; color: #0f172a; margin-bottom: 4px;">Legally Binding</div>
                              <div class="cmk-rule-line" style="font-size: 14px; color: #64748b;">Compliant with ESIGN Act and local electronic signature laws.</div>
                            </div>
                         </div>
                      </div>
                   </div>
                   
                   <div style="flex: 1.5; background: #f8fafc; border-radius: 16px; padding: 32px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: center;">
                      <div style="text-align: center; margin-bottom: 32px;">
                         <div class="cmk-big-sub" style="font-size: 14px; color: #64748b; font-weight: 500; margin-bottom: 8px;">Total a pagar</div>
                         <div class="cmk-big" style="font-size: 40px; font-weight: 800; color: #0f172a; letter-spacing: -0.03em;">$6,150.00</div>
                      </div>
                      <button style="width: 100%; padding: 18px; background: linear-gradient(180deg, #1e293b, #0f172a); color: white; border: none; border-radius: 12px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 12px rgba(15,23,42,0.15); cursor: pointer;">Approve & Sign</button>
                      <div style="text-align: center; font-size: 12px; color: #64748b; margin-top: 16px;">By clicking, you agree to the Terms of Service.</div>
                   </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Portada 4: Settings Vertical (From Horizontal 4) -->
        <div class="carousel-slide">
          <div style="display: flex; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="footer-text">
              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Cord Payments
            </div>
          </div>
          <div class="banner-wrapper-vertical" style="background-color: #1E1B4B; overflow: hidden; position: relative;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#1E1B4B', color1: '#6366F1', color2: '#8B5CF6', color3: '#D946EF' }} 
              grain={false}
            />
            <div style="position: absolute; width: 1150px; height: 580px; left: -220px; top: 80px; z-index: 10; font-family: 'Inter', sans-serif; transform: scale(0.85);">
              <!-- Mac OS window style wrapper (Replica) -->
              <div style="width: 100%; height: 100%; background: #ffffff; border-radius: 16px; box-shadow: 0 40px 100px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,1); display: flex; overflow: hidden;">
                 
                 <!-- Sidebar -->
                 <div style="width: 250px; background: #ffffff; border-right: 1px solid #f3f4f6; display: flex; flex-direction: column; flex-shrink: 0;">
                    <!-- Workspace switch -->
                    <div style="padding: 24px 20px 16px;">
                       <div style="display: flex; align-items: center; justify-content: space-between;">
                          <div style="display: flex; align-items: center; gap: 12px;">
                             <div style="width: 36px; height: 36px; background: #0f172a; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                             </div>
                             <div>
                                <div style="font-size: 10px; color: #9ca3af; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2px;">Workspace</div>
                                <div style="font-size: 14px; font-weight: 600; color: #111827;">Nexus Studio</div>
