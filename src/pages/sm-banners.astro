---
// Herramienta interna de diseño (banners para redes). Solo vive en `npm run dev`:
// en cualquier build de producción responde 404, así no queda publicada ni se
// puede indexar en cordhq.app.
export const prerender = false;
if (import.meta.env.PROD) {
    return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex' } });
}

import CordDynamicBg from '../components/CordDynamicBg.jsx';
import '../styles/mockups.css';
import { flagSrc } from '../lib/flags';
---

<!DOCTYPE html>
<html lang="en" translate="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media Banners | Cord</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body, html { 
      margin: 0; padding: 0; width: 100%; height: 100%; 
      background-color: #050a15; 
      font-family: 'Inter', system-ui, -apple-system, sans-serif; 
      overflow-x: hidden;
    }
    
    .page-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 120px;
      padding: 80px 0 120px 0;
      width: 100%;
    }

    .category-block {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .category-label {
      color: rgba(255,255,255,0.9);
      font-size: 18px;
      font-weight: 500;
      letter-spacing: -0.01em;
      margin-bottom: 30px;
      width: 1200px;
      text-align: left;
    }

    .variants-carousel {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: center;
      gap: 40px;
      overflow-x: auto;
      width: 100vw;
      padding: 20px max(20px, calc(50vw - 600px));
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      box-sizing: border-box;
    }
    
    .variants-carousel::-webkit-scrollbar { display: none; }
    .variants-carousel { -ms-overflow-style: none; scrollbar-width: none; }

    .carousel-slide {
      scroll-snap-align: center;
      flex-shrink: 0;
      position: relative;
    }

        .banner-wrapper-vertical {
      width: 360px;
      height: 640px;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
      position: relative;
      flex-shrink: 0;
    }
    .banner-wrapper {
      position: relative;
      width: 1200px; 
      height: 630px; 
      border-radius: 12px; 
      overflow: hidden;
      box-shadow: 0 40px 80px rgba(0,0,0,0.6);
      background-color: #0a192f;
      flex-shrink: 0;
    }

    .variant-pill {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.9);
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 13px;
      font-weight: 500;
    }
    
    .footer-text {
      color: rgba(255,255,255,0.6);
      font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 8px;
      letter-spacing: 0.02em;
    }
  </style>
</head>
<body>
  
  <div class="page-container">
    
    <!-- Category 1: LinkedIn Banners (Carousel) -->
    <div class="category-block">
      <div class="category-label">1. Carrusel Horizontal, Banners (1200x630)</div>
      
      <div class="variants-carousel">
        
        <!-- 1. The Unified Link (Hero) -->
        <div class="carousel-slide">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="footer-text">
              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Operational Infrastructure
            </div>
          </div>
          <div class="banner-wrapper" style="background-color: #0A192F;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#0A192F', color1: '#38BDF8', color2: '#6670F4', color3: '#10B981' }} 
