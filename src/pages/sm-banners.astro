              colors={{ base: '#0A192F', color1: '#38BDF8', color2: '#6670F4', color3: '#10B981' }} 
              grain={false}
            />
            <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; padding: 40px; text-align: center;">
              <h1 style="color: white; font-size: 48px; font-weight: 800; margin: 0 0 16px 0; letter-spacing: -0.04em; line-height: 1.05;">Cord<br/>Payments</h1>
              <p style="color: rgba(255,255,255,0.8); font-size: 18px; font-weight: 500; margin: 0; line-height: 1.4; max-width: 280px; letter-spacing: -0.01em;">
                The complete commercial closing platform. From quote to cash in a single link.
              </p>
            </div>
          </div>
        </div>

        <!-- Portada 2: Checkout Card Vertical (From Horizontal 1) -->
        <div class="carousel-slide">
          <div style="display: flex; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="footer-text">
