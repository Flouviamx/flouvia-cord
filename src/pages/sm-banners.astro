              <span style="opacity: 0.4;">|</span>
              Cord Payments
            </div>
          </div>
          <div class="banner-wrapper-vertical" style="background-color: #061F20; overflow: hidden; position: relative;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#061F20', color1: '#10B981', color2: '#047857', color3: '#F59E0B' }} 
              grain={false}
            />
            <div style="position: absolute; width: 420px; top: 70px; left: -30px; z-index: 10; transform: scale(0.85);">
              <!-- Checkout Card from Horizontal 1 -->
              <div style="background: #ffffff; border-radius: 20px; box-shadow: 0 40px 100px -20px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,1); border: 1px solid rgba(226,232,240,1); overflow: hidden; display: flex; flex-direction: column; padding: 24px 28px; font-family: 'Inter', sans-serif;">
