---
import StripeBannerBg from '../components/StripeBannerBg.jsx';
import CordDynamicBg from '../components/CordDynamicBg.jsx';
import '../styles/mockups.css';
import { flagSrc } from '../lib/flags';
---

<!DOCTYPE html>
<html lang="en" translate="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media Banners | Cord</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body, html { 
      margin: 0; padding: 0; width: 100%; height: 100%; 
      background-color: #050a15; 
      font-family: 'Inter', system-ui, -apple-system, sans-serif; 
      overflow-x: hidden;
    }
    
    .page-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 120px;
      padding: 80px 0 120px 0;
      width: 100%;
    }

    .category-block {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .category-label {
      color: rgba(255,255,255,0.9);
      font-size: 18px;
      font-weight: 500;
      letter-spacing: -0.01em;
      margin-bottom: 30px;
      width: 1200px;
      text-align: left;
    }

    .variants-carousel {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: center;
      gap: 40px;
      overflow-x: auto;
      width: 100vw;
      padding: 20px max(20px, calc(50vw - 600px));
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      box-sizing: border-box;
    }
    
    .variants-carousel::-webkit-scrollbar { display: none; }
    .variants-carousel { -ms-overflow-style: none; scrollbar-width: none; }

    .carousel-slide {
      scroll-snap-align: center;
      flex-shrink: 0;
      position: relative;
    }

    .banner-wrapper {
      position: relative;
      width: 1200px; 
      height: 630px; 
      border-radius: 12px; 
      overflow: hidden;
      box-shadow: 0 40px 80px rgba(0,0,0,0.6);
      background-color: #0a192f;
      flex-shrink: 0;
    }

    .variant-pill {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.9);
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 13px;
      font-weight: 500;
    }
    
    .footer-text {
      color: rgba(255,255,255,0.6);
      font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 8px;
      letter-spacing: 0.02em;
    }
  </style>
</head>
<body>
  
  <div class="page-container">
    
    <!-- Category 1: LinkedIn Banners (Carousel) -->
    <div class="category-block">
      <div class="category-label">1. Unified Sales Link Campaign (Swipe horizontal para ver variantes)</div>
      
      <div class="variants-carousel">
        
        <!-- 1. The Unified Link (Hero) -->
        <div class="carousel-slide">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="variant-pill">1. The Unified Link</div>
            <div class="footer-text">
              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Product Infrastructure
            </div>
          </div>
          <div class="banner-wrapper" style="background-color: #0A192F;">
            <StripeBannerBg client:only="react" />

            <!-- Mockup: App Quote Creator -->
            <div class="cmk-stage">
              <div style="display: flex; align-items: center; justify-content: center; height: 100%; position: relative; z-index: 10; padding: 40px;">
                 <!-- Floating App Window -->
                 <div style="width: 1040px; height: 580px; background: #ffffff; border-radius: 16px; box-shadow: 0 40px 100px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,1); border: 1px solid rgba(255,255,255,0.2); overflow: hidden; display: flex; font-family: 'Inter', sans-serif;">
                    
                    <!-- Sidebar -->
                    <div style="width: 220px; background: #f8fafc; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column; padding: 20px 16px;">
                       <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 30px;">
                          <div style="width: 32px; height: 32px; background: #0f172a; border-radius: 8px; color: white; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px;">P</div>
                          <div>
                            <div style="font-size: 10px; color: #64748b; font-weight: 600; text-transform: uppercase;">Espacio de trabajo</div>
                            <div style="font-size: 13px; color: #0f172a; font-weight: 600;">PRUEBAS</div>
                          </div>
                       </div>
                       
                       <div style="display: flex; flex-direction: column; gap: 4px;">
                          <div style="padding: 8px 12px; border-radius: 8px; color: #64748b; font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 10px;">
                             <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg> Inicio
                          </div>
                          <div style="padding: 8px 12px; border-radius: 8px; background: rgba(15,23,42,0.05); color: #0f172a; font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: space-between;">
                             <div style="display: flex; align-items: center; gap: 10px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> Cotizaciones</div>
                             <span style="background: #e2e8f0; color: #475569; padding: 2px 6px; border-radius: 99px; font-size: 11px;">1</span>
                          </div>
                          <div style="padding: 8px 12px; border-radius: 8px; color: #64748b; font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 10px;">
                             <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> Clientes
                          </div>
                          <div style="padding: 8px 12px; border-radius: 8px; color: #64748b; font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 10px;">
                             <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg> Productos
                          </div>
                       </div>
                    </div>
                    
                    <!-- Main Content -->
                    <div style="flex: 1; display: flex; flex-direction: column; background: #ffffff;">
                       <!-- Top Nav -->
                       <div style="height: 60px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; padding: 0 24px;">
                          <div style="background: #f1f5f9; padding: 8px 12px; border-radius: 8px; width: 280px; color: #94a3b8; font-size: 13px; display: flex; align-items: center; gap: 8px;">
                             <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Buscar...
                          </div>
                          <div style="display: flex; align-items: center; gap: 16px;">
                             <div style="background: #0f172a; color: white; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 6px;">+ Crear <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></div>
                          </div>
                       </div>
                       
                       <!-- Page Body -->
                       <div style="flex: 1; display: flex; overflow: hidden;">
                          <!-- Left Section (Form) -->
                          <div style="flex: 1; padding: 32px 40px; overflow: hidden; display: flex; flex-direction: column;">
                             <div style="color: #64748b; font-size: 12px; margin-bottom: 4px;">Cotizaciones / Nueva cotización</div>
                             <h1 style="font-size: 24px; font-weight: 700; color: #0f172a; margin: 0 0 24px 0; letter-spacing: -0.02em;">Nueva cotización</h1>
                             
                             <!-- AI Box -->
                             <div style="background: #0f172a; border-radius: 12px; padding: 24px; color: white; margin-bottom: 24px; box-shadow: 0 10px 25px rgba(15,23,42,0.15);">
                                <div style="font-weight: 600; font-size: 15px; margin-bottom: 4px;">Arma la cotización con IA</div>
                                <div style="color: #94a3b8; font-size: 13px; margin-bottom: 16px;">Pega el pedido del cliente o adjunta la foto/PDF de su orden de compra.</div>
                                <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 12px 16px; font-size: 13px; color: #cbd5e1; display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; height: 60px;">
                                   <span style="opacity: 0.5;">Ej. Hola, necesito 200 sacos de cemento gris, 50 varillas de 3/8 y 2 m³ de arena. ¿Me pasas precio?</span>
                                   <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity: 0.5;"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                                </div>
                                <button style="background: white; color: #0f172a; border: none; border-radius: 8px; padding: 8px 16px; font-size: 13px; font-weight: 600;">Armar cotización con IA</button>
                             </div>
                             
                             <div style="text-align: center; color: #94a3b8; font-size: 11px; font-weight: 600; letter-spacing: 0.05em; margin-bottom: 24px;">O CRÉALA MANUALMENTE</div>
                             
                             <!-- Steps -->
                             <div style="display: flex; align-items: flex-start; gap: 16px; margin-bottom: 32px;">
                                <div style="width: 24px; height: 24px; background: #0f172a; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; flex-shrink: 0;">1</div>
                                <div>
                                   <div style="font-weight: 600; font-size: 15px; color: #0f172a; margin-bottom: 4px;">¿A quién le cotizas?</div>
                                   <div style="color: #64748b; font-size: 13px; margin-bottom: 16px;">Elige el cliente y cómo te paga. Si tiene un nivel con descuento, se aplica solo a los precios.</div>
                                   <div style="display: flex; gap: 12px; align-items: center;">
                                      <div style="border: 1px solid #e2e8f0; padding: 8px 16px; border-radius: 8px; font-size: 13px; color: #64748b; display: flex; justify-content: space-between; width: 220px;">
                                         <span>— Selecciona un cliente —</span>
                                         <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                      </div>
                                      <div style="background: #0f172a; color: white; padding: 8px 16px; border-radius: 99px; font-size: 13px; font-weight: 500;">Contado</div>
                                      <div style="color: #64748b; font-size: 13px; font-weight: 500;">Net 30</div>
                                      <div style="color: #64748b; font-size: 13px; font-weight: 500;">Net 60</div>
                                   </div>
                                </div>
                             </div>
                          </div>
                          
                          <!-- Right Section (Summary) -->
                          <div style="width: 280px; border-left: 1px solid #e2e8f0; padding: 32px 24px; background: #ffffff;">
                             <div style="font-weight: 700; font-size: 16px; color: #0f172a; margin-bottom: 4px;">Revisa y envía</div>
                             <div style="color: #64748b; font-size: 12px; margin-bottom: 24px;">Agrega productos para ver el total</div>
                             
                             <div style="display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 13px; color: #475569;">
                                <span>Subtotal</span>
                                <span style="font-weight: 600; color: #0f172a;">$0.00</span>
                             </div>
                             
                             <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; font-size: 13px; color: #475569;">
                                <span>Precios ya incluyen IVA</span>
                                <div style="width: 32px; height: 18px; background: #e2e8f0; border-radius: 9px; position: relative;">
                                   <div style="width: 14px; height: 14px; background: white; border-radius: 50%; position: absolute; left: 2px; top: 2px; box-shadow: 0 1px 2px rgba(0,0,0,0.1);"></div>
                                </div>
                             </div>
                             
                             <div style="display: flex; justify-content: space-between; margin-bottom: 24px; font-size: 13px; color: #475569;">
                                <span>IVA 16%</span>
                                <span style="font-weight: 600; color: #0f172a;">$0.00</span>
                             </div>
                             
                             <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; border-top: 1px solid #e2e8f0; padding-top: 16px;">
                                <span style="font-weight: 600; color: #0f172a;">Total</span>
                                <span style="font-weight: 700; font-size: 24px; color: #0f172a; letter-spacing: -0.02em;">$0.00</span>
                             </div>
                             
                             <div style="margin-bottom: 16px;">
                                <div style="font-size: 12px; color: #64748b; margin-bottom: 8px;">Vigencia</div>
                                <div style="border: 1px solid #e2e8f0; padding: 8px 12px; border-radius: 8px; font-size: 13px; color: #0f172a; display: flex; justify-content: space-between; background: #f8fafc;">
                                   <span>30 días</span>
                                   <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                </div>
                             </div>
                             
                             <div style="margin-bottom: 24px;">
                                <div style="font-size: 12px; color: #64748b; margin-bottom: 8px;">¿En qué moneda le cotizas?</div>
                                <div style="border: 1px solid #e2e8f0; padding: 8px 12px; border-radius: 8px; font-size: 13px; color: #0f172a; display: flex; justify-content: space-between; background: #f8fafc;">
                                   <span style="display: flex; align-items: center; gap: 8px;"><img src={flagSrc('MX')} alt="" width="16" height="16" style="border-radius:50%;display:block;" /> Pesos mexicanos (MXN)</span>
                                   <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                </div>
                             </div>
                             
                             <button style="width: 100%; background: #0f172a; color: white; border: none; border-radius: 8px; padding: 12px; font-size: 14px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 12px;">
                                Crear y enviar <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
                             </button>
                             
                             <button style="width: 100%; background: #f1f5f9; color: #0f172a; border: none; border-radius: 8px; padding: 12px; font-size: 14px; font-weight: 600; display: flex; align-items: center; justify-content: center;">
                                Guardar borrador
                             </button>
                          </div>
                       </div>
                    </div>
                 </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. AI Drafting -->
        <div class="carousel-slide">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 10px;">
            <div class="variant-pill">2. AI Drafting in Seconds</div>
            <div class="footer-text">
              <img src="/imgs/logo-cord-white.png" style="height: 14px; opacity: 0.8;" />
              <span style="opacity: 0.4;">|</span>
              Product Infrastructure
            </div>
          </div>
          <div class="banner-wrapper" style="background-color: #061F20;">
            <CordDynamicBg 
              client:only="react" 
              colors={{ base: '#061F20', color1: '#10B981', color2: '#047857', color3: '#F59E0B' }} 
              grain={false}
            />

            <!-- Mockup: Public Quote View -->
            <div class="cmk-stage">
              <div style="display: flex; align-items: center; justify-content: center; height: 100%; position: relative; z-index: 10; padding: 20px;">
                 <div style="width: 720px; height: 550px; background: #ffffff; border-radius: 24px; box-shadow: 0 40px 100px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,1); display: flex; flex-direction: column; overflow: hidden; position: relative;">
                    
                    <!-- Quote Content -->
                    <div style="flex: 1; padding: 40px 60px; overflow: hidden;">
                       <!-- Header -->
                       <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
                          <div style="display: flex; gap: 16px; align-items: center;">
                             <div style="width: 48px; height: 48px; background: #0f172a; border-radius: 12px; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;">MN</div>
                             <div>
                                <div style="font-size: 18px; font-weight: 700; color: #0f172a;">Mi negocio</div>
                                <div style="font-size: 12px; color: #94a3b8; font-weight: 500;">RFC MNEG890101XYZ</div>
                             </div>
                          </div>
                          <div style="text-align: right;">
                             <div style="font-size: 10px; font-weight: 700; color: #94a3b8; letter-spacing: 0.1em; margin-bottom: 4px;">COTIZACIÓN</div>
                             <div style="font-size: 16px; font-weight: 700; color: #0f172a;">COT-0004</div>
                          </div>
                       </div>
                       
                       <!-- Details -->
                       <div style="display: flex; justify-content: space-between; margin-bottom: 32px; font-size: 13px;">
                          <div>
                             <div style="font-size: 10px; font-weight: 700; color: #cbd5e1; letter-spacing: 0.1em; margin-bottom: 4px;">PARA</div>
                             <div style="font-weight: 700; color: #0f172a; font-size: 14px;">Desarrollos Inmobiliarios Polanco</div>
                          </div>
                          <div>
                             <div style="font-size: 10px; font-weight: 700; color: #cbd5e1; letter-spacing: 0.1em; margin-bottom: 4px;">VÁLIDA HASTA</div>
                             <div style="font-weight: 700; color: #0f172a; font-size: 14px; margin-bottom: 4px;">12 jul 2026</div>
                             <div style="display: inline-block; background: #fffbeb; color: #d97706; font-size: 10px; font-weight: 600; padding: 2px 6px; border-radius: 4px;">Vence en 2 días</div>
                          </div>
                          <div>
                             <div style="font-size: 10px; font-weight: 700; color: #cbd5e1; letter-spacing: 0.1em; margin-bottom: 4px;">TÉRMINOS</div>
                             <div style="font-weight: 700; color: #0f172a; font-size: 14px;">Contado</div>
                          </div>
                       </div>
                       
                       <!-- Big Total -->
                       <div style="background: #f8fafc; border-radius: 16px; border: 1px solid #f1f5f9; padding: 32px; text-align: center; margin-bottom: 24px;">
                          <div style="font-size: 10px; font-weight: 700; color: #94a3b8; letter-spacing: 0.1em; margin-bottom: 12px;">TOTAL A PAGAR</div>
                          <div style="font-size: 52px; font-weight: 700; color: #0f172a; letter-spacing: -0.04em; line-height: 1; margin-bottom: 12px;">$34,232.76</div>
                          <div style="font-size: 12px; font-weight: 500; color: #94a3b8;">MXN · IVA incluido</div>
                       </div>
                       
                       <!-- Table Headers -->
                       <div style="display: flex; font-size: 10px; font-weight: 700; color: #cbd5e1; letter-spacing: 0.1em; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9; margin-bottom: 8px;">
                          <div style="flex: 2;">Concepto</div>
                          <div style="width: 80px; text-align: right;">Cant.</div>
                          <div style="width: 100px; text-align: right;">P. Unit.</div>
                          <div style="width: 120px; text-align: right;">Importe</div>
                       </div>
                       
                       <!-- Table Rows -->
                       <div style="display: flex; align-items: center; font-size: 14px; padding: 12px 0; border-bottom: 1px solid #f8fafc;">
                          <div style="width: 24px;"><div style="width: 16px; height: 16px; background: #0f172a; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg></div></div>
                          <div style="flex: 2; font-weight: 600; color: #0f172a; display: flex; align-items: center; gap: 8px;">Arena Fina (Metro Cúbico) <div style="font-size: 11px; font-weight: 500; color: #94a3b8; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; display: flex; align-items: center; gap: 4px;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg> 2</div></div>
                          <div style="width: 80px; text-align: right; color: #94a3b8; font-size: 13px;">11 pieza</div>
                          <div style="width: 100px; text-align: right; color: #64748b; font-weight: 500;">$445.00</div>
                          <div style="width: 120px; text-align: right; font-weight: 700; color: #0f172a;">$4,895.00</div>
                       </div>
                       
