---
import Layout from '../layouts/Layout.astro';
import ResetPassword from '../components/auth/ResetPassword';
import '../styles/auth.css';

const token = Astro.url.searchParams.get('token');
if (!token) {
    return Astro.redirect('/sign-in');
}
---

<Layout title="Establecer nueva contraseña - Cord">
    <div class="auth-page">
        <a href="/" class="auth-logo">
            <img src="/imgs/logo-cord-navy.png" alt="Cord" height="26" />
        </a>

        <ResetPassword token={token} client:load />

        <p class="auth-page-footer">Hecho en México &nbsp;&middot;&nbsp; Datos cifrados</p>
    </div>
</Layout>
