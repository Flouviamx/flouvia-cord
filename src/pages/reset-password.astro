---
import Layout from '../layouts/Layout.astro';
import ResetPassword from '../components/auth/ResetPassword';
import '../styles/auth.css';

const token = Astro.url.searchParams.get('token');
if (!token) {
    return Astro.redirect('/sign-in');
}
---

<Layout title="Establecer nueva contraseña - Cord">
    <div class="auth-page" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; width: 100%; padding: 2.5rem 1.5rem; background: #ffffff;">
        <a href="/" class="auth-logo" style="margin-bottom: 2.25rem;">
            <img src="/imgs/logo-cord-navy.png" alt="Cord" height="26" style="display: block;" />
        </a>

        <ResetPassword token={token} client:load />

        <p class="auth-page-footer" style="margin-top: 2.25rem; text-align: center; width: 100%;">Hecho en México &nbsp;&middot;&nbsp; Datos cifrados</p>
    </div>
</Layout>

