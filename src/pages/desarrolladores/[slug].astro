---
// Página para desarrolladores — una por tema (api, workbench, mcp, integraciones,
// fx, fiscal). Mismo lenguaje visual que /producto/*, con mockups 1:1 de la UI
// real (DevMock.astro). Copy, datos y fecha de revisión en src/lib/desarrolladores.ts.
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/landing/Nav.astro';
import Footer from '../../components/landing/Footer.astro';
import PageAnims from '../../components/landing/PageAnims.astro';
import DevMock from '../../components/desarrolladores/DevMock.astro';
import TrustGrid from '../../components/desarrolladores/TrustGrid.astro';
import FaqAccordion from '../../components/landing/FaqAccordion.astro';

import { DEV_PAGES } from '../../lib/desarrolladores';
import { DEV_PAGES_EN } from '../../lib/desarrolladores.en';
import { getLangFromUrl } from '../../i18n/utils';

export function getStaticPaths() {
    // 'elements' NO genera página aquí: se consolidó en /elements y esta ruta hace 301
    // (ver redirects en astro.config.mjs). El dato sigue en DEV_PAGES como fuente única.
    return DEV_PAGES.filter((p) => p.slug !== 'elements').map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const lang = getLangFromUrl(Astro.url);
const isEn = Astro.props.isEn || lang === 'en';
const currentPage = Astro.props.page || Astro.props.page;
const page = isEn && currentPage ? DEV_PAGES_EN.find((p) => p.slug === currentPage.slug) || currentPage : currentPage;
const ORDER = (isEn ? DEV_PAGES_EN : DEV_PAGES).filter((p) => p.slug !== 'elements');
const otra = ORDER[(ORDER.findIndex((p) => p.slug === page.slug) + 1) % ORDER.length];
const updatedLabel = page.updated
    ? new Intl.DateTimeFormat(isEn ? 'en-US' : 'es-MX', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${page.updated}T12:00:00Z`))
    : null;

// Datos estructurados (jul 2026, auditoría SEO/AI-SEO — mismo criterio que
// /producto/*): esta plantilla no tenía metaTitle/metaDescription propios
// (título genérico `${nav} — Cord`), ni FAQPage, ni BreadcrumbList.
const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((f: { q: string; a: string }) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
};
const SITE = 'https://cordhq.app';
const base = isEn ? `${SITE}/en` : SITE;
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: isEn ? 'Developers' : 'Desarrolladores', item: `${base}/desarrolladores/api` },
        { '@type': 'ListItem', position: 3, name: page.nav, item: `${base}/desarrolladores/${page.slug}` },
    ],
};
// HowTo con los pasos reales y TechArticle con fecha de revisión: las páginas de
// desarrolladores responden "cómo conecto X" y "qué es X" — los dos formatos que
// más citan los buscadores con IA (skill ai-seo).
const howToSchema = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: isEn ? `How to get started with ${page.nav} in Cord` : `Cómo empezar con ${page.nav} en Cord`,
    step: page.steps.map((st: { titulo: string; copy: string }, i: number) => ({ '@type': 'HowToStep', position: i + 1, name: st.titulo, text: st.copy })),
};
const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: page.metaTitle ?? page.nav,
    description: page.metaDescription ?? page.sub,
    inLanguage: isEn ? 'en' : 'es',
    url: `${base}/desarrolladores/${page.slug}`,
    ...(page.updated ? { dateModified: page.updated } : {}),
    publisher: { '@type': 'Organization', name: 'Cord', url: SITE },
};
---

<Layout title={page.metaTitle ?? `${page.nav} — Cord`} description={page.metaDescription ?? page.sub}>
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <Nav />
    <main>
        <!-- ── HERO ── -->
        <section class="pp-hero">
            <div class="pp-hero-mesh" aria-hidden="true"></div>
            <div class="pp-hero-inner">
                <div class="pp-hero-text">
                    <h1 class="pp-title masked-title" set:html={page.titulo} />
                    <p class="pp-sub reveal">{page.sub}</p>
                    <div class="pp-actions reveal">
                        <a href="/sign-up" class="pp-btn-primary">
                            <span>{isEn ? 'Start for free' : 'Empezar gratis'}</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                        <a href="/precios" class="pp-btn-ghost">{isEn ? 'View plans' : 'Ver planes'}</a>
                    </div>
                    <p class="pp-plan reveal">{page.plan}</p>
                    {updatedLabel && <p class="pp-updated reveal">{isEn ? 'Updated' : 'Actualizado'} <time datetime={page.updated}>{updatedLabel}</time></p>}
                </div>

                <!-- Mockup del hero (panel de código CLARO estilo Stripe/GitHub Docs — toolbar real, sin dots macOS) -->
                <div class="pp-hero-visual">
                <div class="pp-mockup-wrap reveal-mockup">
                    <div class="pp-glow" aria-hidden="true"></div>
                    <div class="pp-mockup">
                        {page.heroMock && <DevMock id={page.heroMock} isEn={isEn} />}
                    </div>
                </div>
                </div>{/* /pp-hero-visual */}
            </div>
        </section>

        <!-- ── BLOQUES (bento de tarjetas — mismo patrón que /producto) ── -->
        <section class="pp-bento">
            {page.blocks.map((b, i) => (
                <article class={`pp-bcard pp-bcard-${i}`}>
                    <div class="pp-bcard-text">
                        <p class="pp-bcard-eyebrow">{b.eyebrow}</p>
                        <h2 class="pp-bcard-h2 masked-title" set:html={b.titulo} />
                        <p class="pp-bcard-copy reveal">{b.copy}</p>
                        <ul class="pp-bcard-bullets">
                            {b.bullets.map((bl) => (
                                <li class="reveal">
                                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
                                    <span set:html={bl} />
                                </li>
                            ))}
                        </ul>
                    </div>
                    <div class="pp-bcard-visual">
                        {b.mock && <DevMock id={b.mock} isEn={isEn} />}
                    </div>
                </article>
            ))}
        </section>

        <section class="dv-steps" aria-labelledby="dv-steps-t">
            <h2 id="dv-steps-t" class="dv-steps-t masked-title">{isEn ? 'Get started in three steps' : 'Empieza en tres pasos'}</h2>
            <ol>
                {page.steps.map((st, i) => (
                    <li class="reveal"><span class="dv-step-n">{String(i + 1).padStart(2, '0')}</span><h3>{st.titulo}</h3><p>{st.copy}</p></li>
                ))}
            </ol>
        </section>

        {page.trust && <TrustGrid trust={page.trust} />}

        <FaqAccordion
            faqs={page.faqs}
            eyebrow={isEn ? 'FREQUENTLY ASKED QUESTIONS' : 'PREGUNTAS FRECUENTES'}
            title={isEn ? `What developers ask about ${page.nav}.` : `Lo que preguntan los developers sobre ${page.nav}.`}
            id={`dev-${page.slug}`}
            class="dv-faq-acc"
        />

        <!-- ── CROSS-LINK (estilo lista, no cards) — última sección antes del footer ── -->
        <section class="dv-more">
            <a href={`/desarrolladores/${otra.slug}`} class="dv-more-row reveal">
                <div>
                    <span class="dv-more-eyebrow">{otra.eyebrow}</span>
                    <b>{otra.nav}</b>
                    <i>{otra.sub.split('.')[0]}.</i>
                </div>
                <span class="dv-more-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
            </a>
        </section>
    </main>

    <Footer ctaTitle={page.cta.titulo.replace(/\. /, '.<br />')} ctaSub={page.cta.sub} />
    <PageAnims />
</Layout>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Los mockups (DevMock.astro) ya son el estado final en HTML; aquí solo hay
    // entradas y loops discretos. Con prefers-reduced-motion no corre nada.
    window.addEventListener('load', () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // Entrada de las ventanas del bento + cascada de sus filas.
        document.querySelectorAll<HTMLElement>('.pp-bcard-visual .dm-win').forEach((win) => {
            gsap.set(win, { y: 26, opacity: 0 });
            ScrollTrigger.create({ trigger: win, start: 'top 90%', once: true, onEnter: () => {
                gsap.to(win, { y: 0, opacity: 1, duration: 0.9, ease: 'power3.out', clearProps: 'transform' });
                const rows = win.querySelectorAll('.dm-logrow, .dm-keyrow, .dm-eprow, .dm-whrow, .dm-tool, .dm-invrow, .dm-step, .dm-ctry, .dm-evs code, .dm-kv');
                gsap.from(rows, { opacity: 0, y: 6, duration: 0.45, stagger: 0.025, delay: 0.2, ease: 'power2.out' });
            } });
        });

        // Barras del Workbench (hero): crecen desde la base.
        const bars = document.querySelectorAll('.dm-hero-workbench .dm-bars > span');
        if (bars.length) gsap.from(bars, { scaleY: 0, duration: 0.8, stagger: 0.035, delay: 0.4, ease: 'power3.out' });

        // Hero API: la respuesta llega línea por línea y el estado pasa a 200 OK (loop).
        const res = document.getElementById('dmApiRes');
        const stat = document.getElementById('dmApiStat');
        if (res && stat) {
            const code = res.querySelector('code')!;
            const lines = code.innerHTML.split('\n');
            code.innerHTML = lines.map((l) => `<span class="dm-ln-a">${l}</span>`).join('\n');
            const spans = code.querySelectorAll('.dm-ln-a');
            const isEn = document.documentElement.lang === 'en';
            gsap.timeline({ repeat: -1, repeatDelay: 2.6, delay: 0.8 })
                .call(() => { stat.textContent = isEn ? 'sending…' : 'enviando…'; stat.classList.add('dm-pending'); })
                .set(spans, { opacity: 0 })
                .to({}, { duration: 0.7 })
                .to(spans, { opacity: 1, duration: 0.25, stagger: 0.08 })
                .call(() => { stat.textContent = '200 OK'; stat.classList.remove('dm-pending'); })
                .fromTo(stat, { scale: 0.85 }, { scale: 1, duration: 0.35, ease: 'back.out(1.8)' })
                .to({}, { duration: 2 });
        }

        // Registros: la fila seleccionada recorre la lista (loop).
        const logRows = document.querySelectorAll<HTMLElement>('.dm-wb-logs .dm-logrow');
        if (logRows.length) {
            let i = 4;
            gsap.timeline({ repeat: -1, repeatDelay: 1.6, delay: 1.5 }).call(() => {
                logRows.forEach((r) => r.classList.remove('sel'));
                i = (i + 3) % logRows.length;
                logRows[i].classList.add('sel');
            }).to({}, { duration: 1.6 });
        }

        // Probar / Ejecutar: pulsación discreta (loop).
        ['dmProbar', 'dmRun'].forEach((idBtn) => {
            const btn = document.getElementById(idBtn);
            if (btn) gsap.timeline({ repeat: -1, repeatDelay: 3, delay: 2 }).to(btn, { scale: 0.92, duration: 0.12, yoyo: true, repeat: 1, ease: 'power2.in' });
        });
    });
</script>

<style>
    /* ════════ HERO — split layout, llena 100dvh (mismo patrón que /producto) ════════ */
    .pp-hero {
        position: relative;
        min-height: 100dvh;
        display: flex; align-items: center;
        overflow: hidden;
        background: var(--color-bg);
    }
    .pp-hero-mesh {
        position: absolute; inset: -20% -10% auto; height: 80%;
        background:
            radial-gradient(ellipse 50% 60% at 28% 20%, rgba(10,25,47,0.05) 0%, transparent 60%),
            radial-gradient(ellipse 44% 54% at 76% 12%, rgba(10,25,47,0.04) 0%, transparent 60%);
        pointer-events: none;
    }
    .pp-hero-inner {
        position: relative; z-index: 1; width: 100%;
        max-width: 1440px; margin: 0 auto;
        padding: 7rem 5% 4rem 6%;
        display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.55fr);
        gap: 2.6rem; align-items: center;
    }
    .pp-hero-text { text-align: left; min-width: 0; }
    .pp-hero-visual {
        position: relative; overflow: visible; min-width: 0;
        margin-right: -16%;
        display: flex; align-items: center; justify-content: center;
    }
    /* El tamaño/peso real lo gobierna el estándar global h1.masked-title (Layout.astro);
       estas propiedades quedan sin !important a propósito — solo aplican el color/margen
       propios de este hero si algún día el h1 pierde la clase masked-title. */
    .pp-title { color: #050505; margin: 0 0 1.4rem; text-align: left; }
    .pp-sub { font-size: 1.08rem; line-height: 1.65; color: var(--color-text-muted); max-width: 480px; margin: 0 0 2.2rem; text-align: left; }
    .pp-actions { display: flex; gap: 0.9rem; justify-content: flex-start; align-items: center; flex-wrap: wrap; }
    .pp-btn-primary {
        display: inline-flex; align-items: center; gap: 10px; position: relative; overflow: hidden;
        background: var(--color-blue-deep); color: #fff; text-decoration: none;
        font-size: 0.98rem; font-weight: 600; padding: 14px 30px; border-radius: 999px;
        box-shadow: 0 18px 44px -16px rgba(10,25,47,0.55);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    .pp-btn-primary::after {
        content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,0.18) 50%, transparent 62%);
        transform: translateX(-110%); transition: transform 0.55s ease;
    }
    .pp-btn-primary:hover::after { transform: translateX(110%); }
    .pp-btn-primary svg { width: 15px; height: 15px; transition: transform 0.5s var(--ease-spring); }
    .pp-btn-primary:hover { transform: translateY(-3px); box-shadow: 0 26px 56px -16px rgba(10,25,47,0.6); }
    .pp-btn-primary:hover svg { transform: translateX(4px); }
    .pp-btn-primary:active { transform: scale(0.97); }
    .pp-btn-ghost {
        color: var(--color-text); text-decoration: none; font-weight: 600; font-size: 0.98rem;
        padding: 14px 22px; border-radius: 999px; border: 1px solid var(--color-border);
        transition: color 0.3s, border-color 0.3s, background 0.3s;
    }
    .pp-btn-ghost:hover { color: var(--color-blue-deep); border-color: rgba(10,25,47,0.2); background: rgba(10,25,47,0.03); }
    .pp-plan { font-size: 0.78rem; color: #99a2af; margin: 1.3rem 0 0; font-weight: 600; text-align: left; }

    /* ── Mockup del hero: llena el espacio y sangra por la derecha (estilo /producto) ── */
    .pp-mockup-wrap { position: relative; max-width: 1000px; width: 100%; min-width: 0; margin: 0; }
    .pp-glow { position: absolute; inset: -6% -4% 14%; background: radial-gradient(ellipse at center, rgba(10,25,47,0.05) 0%, transparent 72%); filter: blur(44px); z-index: 0; pointer-events: none; }
    .pp-mockup { position: relative; }

    .pp-updated { font-size: 0.74rem; color: #99a2af; margin: 0.4rem 0 0; }
    :global(.dm-pending) { color: #64748b !important; background: rgba(10,25,47,0.05) !important; border-color: rgba(10,25,47,0.1) !important; }


    /* ════════ PASOS ════════ */
    .dv-steps { max-width: 1360px; margin: 0 auto; padding: 2rem 5% 6rem; }
    .dv-steps-t { font-size: clamp(1.6rem, 2.6vw, 2.3rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.1; color: #050505; margin: 0 0 2.2rem; }
    .dv-steps ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .dv-steps li { padding-top: 1.4rem; border-top: 1px solid var(--color-border); }
    .dv-step-n { font-family: ui-monospace, monospace; font-size: 0.75rem; font-weight: 700; color: #99a2af; }
    .dv-steps h3 { margin: 0.8rem 0 0.5rem; font-size: 1.08rem; font-weight: 700; letter-spacing: -0.02em; color: #050505; }
    .dv-steps p { margin: 0; font-size: 0.92rem; line-height: 1.6; color: var(--color-text-muted); }

    /* ════════ BLOQUES — bento de tarjetas (mismo patrón que /producto) ════════ */
    .pp-bento {
        max-width: 1360px; margin: 0 auto; padding: 6rem 5% 5rem;
        display: grid; grid-template-columns: 5fr 7fr; gap: 1.2rem;
    }
    .pp-bcard-2, .pp-bcard-3 { grid-column: 1 / -1; }
    .pp-bcard {
        background: #fff; border-radius: 28px; overflow: hidden;
        display: flex; flex-direction: column; min-height: 540px;
        box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 28px 56px -16px rgba(10,25,47,0.14), inset 0 1px 0 rgba(255,255,255,0.6);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    .pp-bcard:hover {
        transform: translateY(-6px);
        box-shadow: 0 2px 4px rgba(10,25,47,0.05), 0 38px 72px -18px rgba(10,25,47,0.2), inset 0 1px 0 rgba(255,255,255,0.6);
    }
    .pp-bcard-2, .pp-bcard-3 { flex-direction: row; min-height: 480px; }
    .pp-bcard-text { padding: 3rem 2.8rem 2rem; flex-shrink: 0; position: relative; z-index: 2; }
    .pp-bcard-2 .pp-bcard-text, .pp-bcard-3 .pp-bcard-text { flex: 0 0 40%; padding: 3.8rem 2.6rem 3.8rem 4rem; display: flex; flex-direction: column; justify-content: center; }
    .pp-bcard-visual { flex: 1; position: relative; overflow: hidden; min-height: 340px; background: #fff; }
    .pp-bcard-eyebrow { font-size: 0.6rem; font-weight: 800; letter-spacing: 2.8px; text-transform: uppercase; color: #b0b0b8; margin: 0 0 0.9rem; }
    .pp-bcard-h2 { font-size: clamp(1.35rem, 2.1vw, 1.85rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.035em; color: #050505; margin: 0 0 0.9rem; }
    .pp-bcard-copy { font-size: 0.875rem; line-height: 1.68; color: var(--color-text-muted); margin: 0 0 1.4rem; }
    .pp-bcard-bullets { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }
    .pp-bcard-bullets li { display: flex; align-items: flex-start; gap: 8px; font-size: 0.83rem; color: var(--color-text); font-weight: 500; line-height: 1.45; }
    .pp-bcard-bullets svg { width: 15px; height: 15px; color: var(--color-ok); flex-shrink: 0; margin-top: 1px; }

    /* ════════ CROSS-LINK (última sección) ════════ */
    .dv-more { max-width: 1080px; margin: 0 auto; padding: 2rem 5% 8rem; }
    .dv-more-row {
        display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
        padding: 1.8rem 2rem; border-radius: 20px;
        background: var(--color-bg-soft); border: 1px solid var(--color-border); text-decoration: none;
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring), border-color 0.4s;
    }
    .dv-more-row:hover { transform: translateY(-3px); box-shadow: 0 30px 70px -30px rgba(10,25,47,0.18); border-color: rgba(10,25,47,0.12); }
    .dv-more-eyebrow { display: block; font-size: 0.6rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: #99a2af; margin-bottom: 0.5rem; }
    .dv-more-row b { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.3px; color: var(--color-text); }
    .dv-more-row i { display: block; font-style: normal; font-size: 0.9rem; color: var(--color-text-muted); margin-top: 0.3rem; }
    .dv-more-arrow {
        flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%;
        background: rgba(10,25,47,0.05); color: var(--color-blue-deep);
        display: flex; align-items: center; justify-content: center;
        transition: background 0.35s, color 0.35s, transform 0.5s var(--ease-spring);
    }
    .dv-more-arrow svg { width: 16px; height: 16px; }
    .dv-more-row:hover .dv-more-arrow { background: var(--color-blue-deep); color: #fff; transform: translateX(3px); }

    /* ════════ RESPONSIVE ════════ */
    @media (max-width: 1000px) {
        .pp-hero { align-items: flex-start; }
        .pp-hero-inner { grid-template-columns: 1fr; gap: 0; padding: 6rem 6% 3rem; }
        .pp-hero-text { padding-bottom: 2.5rem; }
        .pp-hero-visual { margin-left: -6%; margin-right: -6%; justify-content: flex-start; }
        .pp-mockup-wrap { max-width: 100%; }
        .pp-bento { grid-template-columns: 1fr; gap: 1.25rem; padding: 4rem 5% 3rem; }
        .pp-bcard-2, .pp-bcard-3 { flex-direction: column; min-height: 500px; }
        .pp-bcard-2 .pp-bcard-text, .pp-bcard-3 .pp-bcard-text { flex: none; padding: 2.8rem 2.4rem 1.6rem; }
        .pp-bcard { min-height: 460px; }
        .dv-steps ol { grid-template-columns: 1fr; }
    }
    @media (max-width: 860px) {
        .pp-hero { padding-top: 8.5rem; }
        .dv-more-row { padding: 1.4rem 1.4rem; }
    }

    :global(.dv-faq-acc) { padding: 0 5% 7rem; }
</style>

<!-- Global override: GSAP wrapLines() inyecta .m-line/.m-line-in sin data-astro-cid,
     por eso el override al título del hero DEBE ser is:global. Además aquí van los
     overrides del bento (mismo patrón que /producto/[slug].astro) para que las
     ventanas .dm-win llenen la tarjeta y sangren por abajo. -->
<style is:global>
