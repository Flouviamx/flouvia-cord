---
// Landing de Cord — página de ventas completa.
// NO es prerender a propósito: en modo `server`, las páginas prerender=true se sirven
// como HTML estático desde el edge y SALTAN el middleware. La raíz "/" de los subdominios
// (dev.cordhq.app / docs.cordhq.app) necesita pasar por SSR para que src/middleware.ts
// pueda reescribirla al árbol /dev-blog o /docs. Si esto vuelve a ser prerender, los
// subdominios volverán a mostrar la landing principal en su raíz.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import Features from '../components/landing/Features.astro';
import AdvancedFeatures from '../components/landing/AdvancedFeatures.astro';
import Steps from '../components/landing/Steps.astro';
import PaymentsSection from '../components/landing/PaymentsSection.astro';
import InvoicingSection from '../components/landing/InvoicingSection.astro';

import ClientView from '../components/landing/ClientView.astro';
import Pricing from '../components/landing/Pricing.astro';
import Faq from '../components/landing/Faq.astro';
import Footer from '../components/landing/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const t = useTranslations(lang);

// ── Datos estructurados (JSON-LD) — HowTo del flujo de venta de Cord.
//    Lo lee Google para enriquecer el resultado de búsqueda de la home.
const howToSchema = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: isEn ? 'How Cord works: from proposal to payment in one link' : 'Cómo funciona Cord: de la propuesta al cobro en un solo link',
    description: isEn 
        ? 'Cord centralizes the entire commercial cycle in three steps: create a proposal, send an interactive link for approval, and collect payment — all without your client downloading anything.'
        : 'Cord centraliza todo el ciclo comercial en tres pasos: crea una propuesta, envía un link interactivo de aprobación y cobra, todo sin que tu cliente descargue nada.',
    totalTime: 'PT10M',
    tool: [
        { '@type': 'HowToTool', name: isEn ? 'Cord account (free)' : 'Cuenta de Cord (gratuita)' },
        { '@type': 'HowToTool', name: isEn ? 'Product catalog loaded in Cord' : 'Catálogo de productos cargado en Cord' },
    ],
    step: [
        {
            '@type': 'HowToStep',
            position: '1',
            name: isEn ? 'Build the quote' : 'Arma la cotización',
            text: isEn 
                ? 'Choose the client from the directory, add catalog products, and negotiate line prices. Define credit terms (Cash, Net 30/60), apply volume discounts, and set validity. The total with tax recalculates in real-time. All done in minutes.'
                : 'Elige al cliente desde el directorio, agrega productos del catálogo y negocia el precio de cada línea. Define los términos de crédito (Contado, Net 30 o Net 60), aplica descuentos por volumen y establece la vigencia. El total con IVA se recalcula en tiempo real. Todo listo en minutos.',
            url: isEn ? 'https://cordhq.app/en/producto/editor' : 'https://cordhq.app/producto/editor',
        },
        {
            '@type': 'HowToStep',
            position: '2',
            name: isEn ? 'Send the link' : 'Envía el link',
            text: isEn 
                ? 'Cord generates a branded link (logo, colors, and tax details) that the client can open from any device. You also get a PDF. Receive a notification the exact moment your client opens the quote.'
                : 'Cord genera un link con tu marca (logo, colores y datos fiscales) que el cliente puede abrir desde cualquier dispositivo. También puedes descargar un PDF. Recibes una notificación en el instante exacto en que tu cliente abre la cotización.',
            url: isEn ? 'https://cordhq.app/en/producto/link-publico' : 'https://cordhq.app/producto/link-publico',
        },
        {
            '@type': 'HowToStep',
            position: '3',
            name: isEn ? 'Close and invoice' : 'Cierra y factura',
            text: isEn
                ? 'The client approves with one click and pays online, or the quote stays on credit based on defined terms. The quote automatically turns into an order — and for businesses in Mexico, the corresponding CFDI 4.0 is stamped with the SAT automatically, with no data re-entry needed.'
                : 'El cliente aprueba con un clic y paga en línea, o la cotización queda a crédito según los términos definidos. La cotización se convierte automáticamente en pedido y, para negocios en México, el CFDI 4.0 correspondiente se timbra ante el SAT automáticamente, sin necesidad de recapturar datos en otro portal.',
            url: isEn ? 'https://cordhq.app/en/producto/facturacion' : 'https://cordhq.app/producto/facturacion',
        },
    ],
};

// Título y descripción (jul 2026, auditoría SEO/AI-SEO): reescritos para dejar
// explícito desde el <title> que Cord es un SOFTWARE PÚBLICO e INDEPENDIENTE
// (no una herramienta interna/exclusiva de Flouvia) — así los motores de
// búsqueda y los LLMs que citan la página no infieren "producto exclusivo de
// clientes de Flouvia". "by Flouvia" se movió del <title> a un dato de
// confianza secundario dentro de la descripción, sin liderar el mensaje.
// ACTUALIZACIÓN: Se implementa enfoque "Transaccional Absoluto".
const title = isEn
    ? "Free Online Quote Software | Proposals to Payments | Cord"
    : "Software de cotizaciones online gratis y cobranza | Cord";

const description = isEn
    ? "Create professional quotes, share a link and follow up through payment. Start with 5 free sends each month and up to 5 active quotes. No credit card required."
    : "Crea cotizaciones profesionales, comparte un link y da seguimiento hasta el pago. Empieza con 5 envíos gratis al mes y hasta 5 cotizaciones activas. Sin tarjeta.";

// ── Datos estructurados adicionales (jul 2026) ──────────────────────────
// Organization (Flouvia, la empresa creadora) + SoftwareApplication (Cord,
// el producto — independiente, con su propio dominio/oferta) + FAQPage
// (misma fuente que <Faq /> más abajo, así el schema SIEMPRE coincide con
// el texto visible). Este trío es la forma "machine-readable" correcta de
// decir "Cord es un producto propio, hecho por Flouvia, disponible para
// cualquier negocio" — exactamente el problema que los LLMs venían
// malinterpretando al no encontrar esta señal explícita en el HTML.
const orgSchema = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://flouvia.com/#organization',
    name: 'Flouvia',
    url: 'https://flouvia.com',
    logo: 'https://cordhq.app/imgs/logo-cord-navy.png',
    sameAs: [
        'https://instagram.com/flouvia',
        'https://tiktok.com/@flouvia',
        'https://x.com/flouvia',
    ],
};

const softwareSchema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': 'https://cordhq.app/#software',
    name: 'Cord',
    url: 'https://cordhq.app',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: isEn ? 'Commercial Closing Platform' : 'Plataforma de Cierre Comercial',
    operatingSystem: 'Web',
    description,
    audience: {
        '@type': 'BusinessAudience',
        audienceType: isEn ? 'Any business worldwide (distributors, wholesalers, manufacturers, service providers, SaaS, agencies)' : 'Cualquier negocio en cualquier país (distribuidoras, mayoristas, manufactura, servicios, SaaS, agencias)',
    },
    creator: { '@id': 'https://flouvia.com/#organization' },
    provider: { '@id': 'https://flouvia.com/#organization' },
    offers: {
        // Sin priceCurrency a propósito: es un plan $0 (no hay precio real que
        // convertir), y atar la moneda al idioma (MXN=ES / USD=EN) era una señal
        // implícita de "ES = México" que contradice el posicionamiento universal.
        '@type': 'Offer',
        price: '0',
        description: t('hero.free.note'),
    },
    featureList: isEn 
        ? ['Negotiated pricing', 'One-click quote approval', 'Real-time view tracking', 'AI-powered collections', 'Approval with technical evidence', 'Net 30/60 credit terms', 'Public API & webhooks']
        : ['Precios negociados', 'Aprobación de cotizaciones en un clic', 'Seguimiento en tiempo real', 'Cobranza automatizada con IA', 'Aprobación con evidencia técnica', 'Términos de crédito Net 30/60', 'API pública y webhooks'],
};

// Misma fuente (claves faq.1..faq.8 de ui.ts) que consume <Faq /> — el
// schema queda garantizado a coincidir con el contenido visible.
const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: Array.from({ length: 8 }, (_, i) => i + 1).map((n) => ({
        '@type': 'Question',
        name: t(`faq.${n}.q` as any),
        acceptedAnswer: {
            '@type': 'Answer',
            text: t(`faq.${n}.a` as any),
        },
    })),
};
---

<Layout title={title} description={description}>
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(orgSchema)}
    />
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(softwareSchema)}
    />
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(howToSchema)}
    />
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqSchema)}
    />
    <Nav />
    <main>
        <Hero />
        <Features />
        <AdvancedFeatures />
        <Steps />
        <PaymentsSection />
        <InvoicingSection />

        <ClientView />
        <Pricing />
        <Faq />
    </main>
    <Footer />
</Layout>

<!-- Gate anti-FOUC + estilos de los masked line reveals -->
<style is:global>
    .js-anim .reveal,
    .js-anim .reveal-mockup { opacity: 0; }

    /* Masked line reveal (Linear-style): cada línea del título sube desde
       una máscara con overflow hidden. Los spans los inyecta el JS. */
    .m-line { display: block; overflow: hidden; }
    .m-line-in { display: inline-block; will-change: transform; }
</style>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('DOMContentLoaded', () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ───────────────────────── COUNT-UP util ─────────────────────────
        const mxn = (n: number, dec: number) =>
            '$' + new Intl.NumberFormat('es-MX', { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n);
        const countUp = (el: HTMLElement, target: number, dec: number, dur = 1.3) => {
            const obj = { v: 0 };
            return gsap.to(obj, {
                v: target, duration: dur, ease: 'power2.out',
                onUpdate: () => { el.textContent = mxn(obj.v, dec); },
            });
        };

        // ───────────────────────── DEMO DEL TELÉFONO (ClientView) ─────────────────────────
        // Grabación de pantalla del /q real en Safari de iPhone. La historia sigue el
        // flujo de QuoteCard: el total cuenta y entran las partidas → la página hace
        // scroll y la barra sticky se oculta al aparecer el CTA → toque en "Aprobar
        // cotización" → paso "Firma digital" (se escribe el nombre, casilla, "Confirmar
        // y firmar" → "Firmando…") → "Cotización aprobada" con el anillo dibujado,
        // nota de crédito Net 30 y sello. El HTML es el estado FINAL: con
        // reduced-motion solo se encuadra la aprobación, sin animar nada.
        const initClientPhone = (phone: HTMLElement) => {
            const q = <T extends Element = HTMLElement>(sel: string) => phone.querySelector<T>(sel);
            const screen = q('#cvScreen');
            const page = q('#cvPage');
            const amount = q('#cvAmount');
            const stickyTotal = q('#cvStickyTotal');
            const sticky = q('#cvSticky');
            const stepReview = q('#cvStepReview');
            const stepSign = q('#cvStepSign');
            const stepOk = q('#cvStepApproved');
            const approve = q('#cvApprove');
            const field = q('#cvSignField');
            const nameEl = q('#cvSignName');
            const terms = q('#cvTerms');
            const confirm = q('#cvConfirm');
            const confirmLabel = q('#cvConfirmLabel');
            const tap = q('#cvCursor');
            const tapRing = q('#cvTapRing');
            const circle = q<SVGCircleElement>('#cvCheckCircle');
            const check = q<SVGPolylineElement>('#cvCheck');
            const lines = Array.from(phone.querySelectorAll<HTMLElement>('.cvq-line'));
            if (!screen || !page || !amount || !sticky || !stepReview || !stepSign || !stepOk || !approve
                || !field || !nameEl || !terms || !confirm || !confirmLabel || !tap || !tapRing || !circle || !check) return;

            const steps = [stepReview, stepSign, stepOk];
            const show = (step: HTMLElement) => steps.forEach((s) => s.classList.toggle('cvq-off', s !== step));
            const prefix = amount.dataset.prefix || '$';
            const fmt = (n: number) => prefix + new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
            const NAME = nameEl.dataset.name || '';
            const LABEL = confirmLabel.dataset.label || confirmLabel.textContent || '';
            const BUSY = confirmLabel.dataset.busy || '…';
            const CIRCLE = 145, CHECK = 36;

            // Posición de un elemento dentro de la página (offsets de layout: no los
            // alteran el translate de la página ni la escala del reveal).
            const offsetIn = (el: HTMLElement) => {
                let y = 0; let n: HTMLElement | null = el;
                while (n && n !== page) { y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
                return y;
            };
            // Scroll de la página para dejar `el` a `ratio` de la altura de la pantalla.
            const scrollFor = (el: HTMLElement, ratio: number) => {
                const max = Math.max(0, page.offsetHeight - screen.clientHeight);
                return -Math.min(max, Math.max(0, offsetIn(el) - screen.clientHeight * ratio));
            };
            // Centro de un elemento en coordenadas de la pantalla.
            const pt = (el: HTMLElement, fx = 0.5) => {
                const s = screen.getBoundingClientRect();
                const r = el.getBoundingClientRect();
                const k = s.width / (screen.offsetWidth || 1);
                return { x: (r.left + r.width * fx - s.left) / k, y: (r.top + r.height / 2 - s.top) / k };
            };

            const frameFinal = () => gsap.set(page, { y: scrollFor(stepOk, 0.13) });

            if (reduced) {
                frameFinal();
                window.addEventListener('resize', frameFinal, { passive: true });
                window.addEventListener('load', frameFinal, { once: true });
                return;
            }

            const toReview = (stickyOpacity = 1) => {
                show(stepReview);
                gsap.set([stepReview, stepSign, stepOk], { clearProps: 'opacity,transform' });
                nameEl.textContent = '';
                field.classList.remove('is-focus');
                terms.classList.remove('is-on');
                confirm.classList.add('is-disabled');
                confirmLabel.textContent = LABEL;
                gsap.set(circle, { strokeDasharray: CIRCLE, strokeDashoffset: CIRCLE });
                gsap.set(check, { strokeDasharray: CHECK, strokeDashoffset: CHECK });
                gsap.set(page, { y: 0 });
                sticky.classList.remove('cvq-sticky-off');
                gsap.set(sticky, { yPercent: 0, autoAlpha: stickyOpacity });
                gsap.set(tap, { opacity: 0 });
            };

            // Un toque de grabación de pantalla: aparece, presiona, onda y se va.
            const tapOn = (target: HTMLElement, fx = 0.5) => {
                const tl = gsap.timeline();
                tl.set(tap, { x: () => pt(target, fx).x, y: () => pt(target, fx).y + 22, scale: 1.2, opacity: 0 })
                    .to(tap, { opacity: 1, y: () => pt(target, fx).y, scale: 1, duration: 0.4, ease: 'power2.out' })
                    .to(tap, { scale: 0.8, duration: 0.12, ease: 'power1.in' })
                    .to(target, { scale: 0.97, duration: 0.12, ease: 'power1.in' }, '<')
                    .fromTo(tapRing, { scale: 0.7, opacity: 0.6 }, { scale: 2.2, opacity: 0, duration: 0.55, ease: 'power2.out', immediateRender: false }, '<0.08')
                    .to(tap, { scale: 1, opacity: 0, duration: 0.32, ease: 'power1.out' }, '<0.1')
                    .to(target, { scale: 1, duration: 0.3, ease: 'power2.out' }, '<');
                return tl;
            };
            const enter = (step: HTMLElement) =>
                gsap.fromTo(step, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.32, ease: 'power3.out', immediateRender: false, clearProps: 'transform' });

            let current: gsap.core.Timeline | null = null;
            let onScreen = true;

            const cycle = (first: boolean) => {
                const tl = gsap.timeline({ paused: !onScreen, onComplete: () => cycle(false) });
                current = tl;

                if (first) {
                    tl.add(() => toReview());
                    const o = { v: 0 };
                    tl.to(o, {
                        v: 196469.2, duration: 1.5, ease: 'power2.out',
                        onUpdate: () => { const s = fmt(o.v); amount.textContent = s; if (stickyTotal) stickyTotal.textContent = s; },
                    }, 0.05);
                    tl.fromTo(lines, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.09, ease: 'power2.out', clearProps: 'transform' }, 0.3);
                    tl.to({}, { duration: 0.6 });
                } else {
                    // Cierre suave: la pantalla vuelve arriba como una recarga del link.
                    tl.to([page, sticky], { opacity: 0, duration: 0.4, ease: 'power1.in' })
                        .add(() => toReview(0))
                        .to(page, { opacity: 1, duration: 0.5, ease: 'power1.out' })
                        .to(sticky, { autoAlpha: 1, duration: 0.5, ease: 'power1.out' }, '<')
                        .to({}, { duration: 0.9 });
                }

                // 1 · baja a las partidas y al CTA real; la barra sticky se retira.
                tl.to(page, { y: () => scrollFor(approve, 0.6), duration: 1.5, ease: 'power2.inOut' })
                    .to(sticky, { yPercent: 130, autoAlpha: 0, duration: 0.45, ease: 'power2.in' }, '<0.7')

                // 2 · aprobar → paso de firma digital.
                    .add(tapOn(approve, 0.58), '+=0.25')
                    .add(() => show(stepSign), '-=0.3')
                    .add(enter(stepSign), '<')
                    .to(page, { y: () => scrollFor(stepSign, 0.13), duration: 0.85, ease: 'power2.inOut' }, '<0.1')

                // 3 · el cliente escribe su nombre, acepta y firma.
                    .add(() => field.classList.add('is-focus'), '+=0.15');
                const typed = { n: 0 };
                tl.to(typed, {
                    n: NAME.length, duration: NAME.length * 0.07, ease: 'none',
                    onUpdate: () => { nameEl.textContent = NAME.slice(0, Math.round(typed.n)); },
                }, '+=0.2')
                    .add(tapOn(terms), '+=0.25')
                    .add(() => { terms.classList.add('is-on'); field.classList.remove('is-focus'); confirm.classList.remove('is-disabled'); }, '-=0.62')
                    .add(tapOn(confirm, 0.52), '+=0.15')
                    .add(() => { confirmLabel.textContent = BUSY; confirm.classList.add('is-disabled'); }, '-=0.55')

                // 4 · aprobada: anillo + check se dibujan y se encuadra el sello.
                    .add(() => show(stepOk), '+=0.45')
                    .add(enter(stepOk), '<')
                    .to(page, { y: () => scrollFor(stepOk, 0.13), duration: 0.8, ease: 'power2.inOut' }, '<')
                    .to(circle, { strokeDashoffset: 0, duration: 0.55, ease: 'power2.out' }, '<0.1')
                    .to(check, { strokeDashoffset: 0, duration: 0.4, ease: 'power2.out' }, '<0.4')
                    .to({}, { duration: 3.6 });
            };

            // Arranque: estado de revisión listo antes de entrar en pantalla.
            toReview();
            amount.textContent = fmt(0);
            if (stickyTotal) stickyTotal.textContent = fmt(0);
            gsap.set(lines, { opacity: 0, y: 10 });

            // Flotación ambiental sutil del teléfono sobre la banda.
            gsap.to(phone, { y: -8, duration: 4.8, ease: 'sine.inOut', yoyo: true, repeat: -1 });

            ScrollTrigger.create({
                trigger: phone, start: 'top 72%', once: true,
                onEnter: () => cycle(true),
            });
            // Fuera de pantalla la historia se pausa (y retoma donde iba).
            ScrollTrigger.create({
                trigger: phone, start: 'top bottom', end: 'bottom top',
                onToggle: (self) => { onScreen = self.isActive; current?.paused(!self.isActive); },
            });
        };
        const cvPhone = document.getElementById('cvPhone');
        if (cvPhone) initClientPhone(cvPhone);

        if (reduced) {
            gsap.set('.reveal, .reveal-mockup', { opacity: 1, y: 0 });
            return; // números muestran su valor final del HTML; nada se anima
        }

        // ───────────────────── MASKED LINE REVEALS (Linear) ─────────────────────
        // Envuelve cada línea (separada por <br>) en una máscara y la sube.
        // Los títulos marcados dejan de participar del reveal genérico.
        const wrapLines = (el: HTMLElement): HTMLElement[] => {
            const parts = el.innerHTML.split(/<br\s*\/?>/i);
            el.innerHTML = parts
                .map(p => `<span class="m-line"><span class="m-line-in">${p.trim()}</span></span>`)
                .join('');
            return Array.from(el.querySelectorAll<HTMLElement>('.m-line-in'));
        };

        const maskTargets = gsap.utils.toArray<HTMLElement>(
            '.ft-title, .steps-title, .cav-title, .cps-title, .cis-title, .cv-title, .pr-title, .faq-title, .fc-title'
        );
        const maskedSet = new Set<HTMLElement>(maskTargets);

        maskTargets.forEach((el) => {
            const lines = wrapLines(el);
            gsap.set(lines, { yPercent: 115 });
            gsap.set(el, { opacity: 1 }); // el gate ya no lo oculta; lo ocultan las máscaras
            ScrollTrigger.create({
                trigger: el, start: 'top 86%', once: true,
                onEnter: () => gsap.to(lines, {
                    yPercent: 0, duration: 1.0, ease: 'power3.out', stagger: 0.09,
                }),
            });
        });

        // ───────────────────────── HERO (en carga) ─────────────────────────
        const heroTitleLines = document.querySelectorAll<HTMLElement>('.hero-title .m-line-in');
        const heroReveals = gsap.utils.toArray<HTMLElement>('.hero .reveal').filter(el => !maskedSet.has(el));
        gsap.set(heroReveals, { y: 16 });

        const heroTl = gsap.timeline({ delay: 0.15, defaults: { ease: 'power2.out' } });
        heroTl
            .to('.hero .hero-pill', { opacity: 1, y: 0, duration: 0.8 }, 0)
            .to('.hero .hero-desc', { opacity: 1, y: 0, duration: 0.9 }, 0.45)
            .to('.hero .hero-actions', { opacity: 1, y: 0, duration: 0.9 }, 0.65)
            .to('.hero .hero-microcopy', { opacity: 1, y: 0, duration: 0.9 }, 0.75);

        // Mockup del hero: entra con perspectiva y se ASIENTA al hacer scroll (Stripe).
        const heroMockup = document.querySelector<HTMLElement>('.hero .reveal-mockup');
        const heroMk = document.querySelector<HTMLElement>('.hero .mockup');
        if (heroMockup && heroMk) {
            gsap.set(heroMk, { transformPerspective: 1400, transformOrigin: 'center top' });
            gsap.set(heroMockup, { y: 50 });
            gsap.set(heroMk, { rotationX: 9 });
            gsap.to(heroMockup, { opacity: 1, y: 0, duration: 1.3, ease: 'power3.out', delay: 0.55 });
            // settle: la perspectiva se aplana conforme el mockup viaja hacia el centro
            gsap.to(heroMk, {
                rotationX: 0, ease: 'none',
                scrollTrigger: { trigger: heroMockup, start: 'top 88%', end: 'top 32%', scrub: 0.6 },
            });
        }

        // El escalado del mockup (tablet) vive SOLO en Hero.astro: aquí había un
        // segundo escalador que peleaba por el mismo `transform` con otro umbral.

        // ───────── HERO DEMO INTERACTIVO: Creas → Envías → La ven → Aprueban → Facturas ─────────
        // El visitante recorre el flujo con los botones de paso; además auto-avanza
        // como tour guiado y se pausa al pasar el mouse. El HTML por defecto es el
        // estado final (completo) → sin JS / reduced-motion el mockup queda estático
        // (los botones de paso se ocultan por CSS en reduced-motion).
        const mkStatus = document.getElementById('mkStatus');
        const mkToast = document.getElementById('mkToast');
        const mkChip = document.getElementById('mkChip');
        const demoEl = document.getElementById('heroDemo');
        const stepEls = Array.from(document.querySelectorAll<HTMLButtonElement>('.demo-step'));
        const tlItems = Array.from(document.querySelectorAll<HTMLElement>('.mk-tl-item[data-story]'));
        const stpItems = Array.from(document.querySelectorAll<HTMLElement>('.mk-stp[data-story]'));

        if (mkStatus && mkToast && mkChip && demoEl && stepEls.length) {
            const DWELL = 2.7;
            const fills = stepEls.map((s) => s.querySelector<HTMLElement>('.ds-fill')!);
            // Clases = colores de STATUS_META de la app. La etiqueta sale de
            // data-s0..s4 (servidas con t()) — antes era español fijo también en /en.
            const STAGES = [
                { badge: 'mk-badge-draft',    on: ['created'],                                              toast: false, chip: false },
                { badge: 'mk-badge-sent',     on: ['created', 'sent'],                                      toast: false, chip: false },
                { badge: 'mk-badge-viewed',   on: ['created', 'sent', 'viewed'],                            toast: true,  chip: false },
                { badge: 'mk-badge-approved', on: ['created', 'sent', 'viewed', 'approved'],                toast: false, chip: false },
                { badge: 'mk-badge-invoiced', on: ['created', 'sent', 'viewed', 'approved', 'invoiced'],    toast: false, chip: true },
            ];
            const LABELS = ['Borrador', 'Enviada', 'Vista', 'Aprobada', 'Facturada'];
            let active = 0, paused = false, fillTween: gsap.core.Tween | null = null;

            const applyStage = (i: number, animate: boolean) => {
                const st = STAGES[i];
                mkStatus.className = `mk-badge ${st.badge}`;
                mkStatus.textContent = mkStatus.dataset[`s${i}`] || LABELS[i];
                if (animate) gsap.fromTo(mkStatus, { scale: 0.84, opacity: 0.4 }, { scale: 1, opacity: 1, duration: 0.45, ease: 'power2.out' });
                // El stepper real distingue hecho (check), actual (navy) y pendiente.
                const current = st.on[st.on.length - 1];
                tlItems.forEach((it) => it.classList.toggle('is-pending', !st.on.includes(it.dataset.story || '')));
                stpItems.forEach((it) => {
                    const story = it.dataset.story || '';
                    it.classList.toggle('is-pending', !st.on.includes(story));
                    it.classList.toggle('is-current', story === current);
                });
                const dur = animate ? 0.5 : 0;
                gsap.to(mkToast, { opacity: st.toast ? 1 : 0, duration: dur });
                gsap.to(mkChip, { opacity: st.chip ? 1 : 0, y: st.chip ? 0 : -10, duration: dur });
            };
            const render = (i: number, animate = true) => {
                active = i;
                applyStage(i, animate);
                stepEls.forEach((b, idx) => {
                    b.classList.toggle('is-active', idx === i);
                    b.setAttribute('aria-selected', idx === i ? 'true' : 'false');
                });
            };
            const go = (i: number) => {
                render(i, true);
                fillTween?.kill();
                gsap.set(fills, { scaleX: 0 });
                fillTween = gsap.fromTo(fills[i], { scaleX: 0 }, {
                    scaleX: 1, duration: DWELL, ease: 'none',
                    onComplete: () => { if (!paused) go((i + 1) % STAGES.length); },
                });
            };

            render(0, false); // estado inicial inmediato (sin pop), evita flash del estado final

            stepEls.forEach((b, idx) => b.addEventListener('click', () => {
                if (paused) { render(idx, true); fillTween?.kill(); gsap.set(fills, { scaleX: 0 }); }
                else go(idx);
            }));
            demoEl.addEventListener('mouseenter', () => { paused = true; fillTween?.kill(); });
            demoEl.addEventListener('mouseleave', () => { paused = false; go(active); });
            gsap.delayedCall(2.0, () => { if (!paused) go(0); });
        }


        // ───────────────────────── REVEALS ON-SCROLL ─────────────────────────
        const scrollReveals = gsap.utils.toArray<HTMLElement>('.reveal')
            .filter((el) => !el.closest('.hero') && !maskedSet.has(el));
        scrollReveals.forEach((el) => {
            gsap.set(el, { y: 18 });
            ScrollTrigger.create({
                trigger: el, start: 'top 88%', once: true,
                // clearProps SOLO de transform — el opacity:1 inline gana sobre el gate.
                onEnter: () => gsap.to(el, { opacity: 1, y: 0, duration: 0.85, ease: 'power2.out', clearProps: 'transform' }),
            });
        });

        const otherMockups = gsap.utils.toArray<HTMLElement>('.reveal-mockup').filter((el) => !el.closest('.hero'));
        otherMockups.forEach((el) => {
            gsap.set(el, { y: 36, scale: 0.985 });
            ScrollTrigger.create({
                trigger: el, start: 'top 85%', once: true,
                onEnter: () => gsap.to(el, { opacity: 1, y: 0, scale: 1, duration: 1.1, ease: 'power3.out' }),
            });
        });

        // ───────────────────────── MICRO-DEMOS DE LOS BENTO ─────────────────────────
        // Editor: el precio negociado "baja" en vivo y el chip de descuento hace pop.
        const evLine = document.querySelector<HTMLElement>('.ev-edit');
        const evPrice = document.querySelector<HTMLElement>('.ev-edit .editorial');
        const evTag = document.querySelector<HTMLElement>('.ev-edit .ev-tag');
        if (evLine && evPrice && evTag) {
            gsap.set(evTag, { scale: 0, transformOrigin: 'center' });
            ScrollTrigger.create({
                trigger: evLine, start: 'top 88%', once: true,
                onEnter: () => {
                    const obj = { v: 191.48 }; // precio de lista antes del −12%
                    const tl = gsap.timeline({ delay: 0.5 });
                    tl.to(obj, {
                        v: 168.5, duration: 1.1, ease: 'power2.out',
                        onUpdate: () => { evPrice.textContent = mxn(obj.v, 2); },
                    }, 0)
                    .fromTo(evLine,
                        { backgroundColor: 'rgba(16,185,129,0.04)' },
                        { backgroundColor: 'rgba(16,185,129,0.16)', duration: 0.4, yoyo: true, repeat: 1, onComplete: () => gsap.set(evLine, { clearProps: 'backgroundColor' }) },
                        0.5)
                    .fromTo(evTag, { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: 'power3.out' }, 0.7);
                },
            });
        }

        // CFDI: el check de timbrado entra con un pop sutil.
        const cfdiCheck = document.querySelector<HTMLElement>('.cfdi-visual .cfdi-check');
        if (cfdiCheck) {
            ScrollTrigger.create({
                trigger: cfdiCheck, start: 'top 90%', once: true,
                onEnter: () => gsap.fromTo(cfdiCheck, { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.55, ease: 'power3.out', delay: 0.45, clearProps: 'transform,opacity' }),
            });
        }

        // ───────────────────────── COUNT-UP (números) ─────────────────────────
        gsap.utils.toArray<HTMLElement>('[data-countup]').forEach((el) => {
            const target = parseFloat(el.dataset.countup || '0');
            const dec = parseInt(el.dataset.decimals || '0', 10);
            ScrollTrigger.create({
                trigger: el, start: 'top 92%', once: true,
                onEnter: () => countUp(el, target, dec, 1.3),
            });
        });

        // ───────────────────────── PARALLAX (scrub sutil) ─────────────────────────
        const parallax = (sel: string, amount: number, triggerSel: string) => {
            const el = document.querySelector<HTMLElement>(sel);
            const trig = document.querySelector<HTMLElement>(triggerSel);
            if (!el || !trig) return;
            gsap.to(el, {
                yPercent: amount, ease: 'none',
                scrollTrigger: { trigger: trig, start: 'top bottom', end: 'bottom top', scrub: 1 },
            });
        };
        parallax('.hero-mesh', 18, '.hero');

        // ───────────────────────── SMOOTH SCROLL + REFRESH ─────────────────────────
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
            a.addEventListener('click', (e) => {
                const id = a.getAttribute('href');
                if (!id || id === '#') return;
                const target = document.querySelector(id);
                if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            });
        });

        Promise.all([
            new Promise<void>((r) => window.addEventListener('load', () => r(), { once: true })),
            (document as any).fonts?.ready ?? Promise.resolve(),
        ]).then(() => setTimeout(() => ScrollTrigger.refresh(), 120));
    });
</script>
