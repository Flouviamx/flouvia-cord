---
import OpsLayout from '../../layouts/OpsLayout.astro';
import OpsShell from '../../components/ops/OpsShell.astro';
import OpsDist from '../../components/ops/OpsDist.astro';
import { withOpsTx } from '../../lib/db';
import { opsAgo, opsDate, opsMoney, opsNumber, opsPct, opsSubscription } from '../../lib/ops-format';
import { opsRevenueAtRisk, opsRevenueCanceling, opsRevenueOrgs, summarizeRevenue, type OpsRevenueOrg } from '../../lib/ops-billing';
import { PLANES } from '../../lib/precios';

if (!Astro.locals.opsOperator) return Astro.redirect('/ops/login');

let rows: OpsRevenueOrg[] = [];
let error = false;
try {
  const [r] = await withOpsTx(opsRevenueOrgs());
  rows = r as OpsRevenueOrg[];
} catch (cause) { error = true; console.error('[ops/revenue]', cause); }

const byCurrency = summarizeRevenue(rows);
const canceling = opsRevenueCanceling(rows);
const atRisk = opsRevenueAtRisk(rows);
const paying = byCurrency.reduce((a, c) => a + c.paying, 0);
const annual = byCurrency.reduce((a, c) => a + c.annual, 0);
const planName = (id: string) => PLANES.find((p) => p.id === id)?.nombre ?? id;
// Altas de pago de los últimos 30 días vs. organizaciones nuevas del mismo periodo
// no se calculan aquí: Cord no guarda cuándo empezó cada suscripción. Se dice.
---
<OpsLayout title="Ingresos | Cord Ops"><OpsShell active="revenue" title="Ingresos" subtitle="La suscripción de Cord: quién paga, cuánto es recurrente y quién está por irse.">
  {error && <div class="ops-inline-error">No se pudieron cargar los ingresos.</div>}

  <section class="ops-card ops-metrics">
    <div class="ops-metric"><span>Organizaciones que pagan</span><strong>{opsNumber(paying)}</strong><small>Plan pagado verificado, no solo guardado</small></div>
    <div class="ops-metric"><span>Pago anual</span><strong>{opsPct(annual, paying)}%</strong><small>{opsNumber(annual)} de {opsNumber(paying)}</small></div>
    <div class="ops-metric"><span>Cancelan al cierre</span><strong>{opsNumber(canceling.length)}</strong><small>Siguen pagando hasta su fecha</small></div>
    <div class="ops-metric"><span>En riesgo</span><strong>{opsNumber(atRisk.length)}</strong><small>Plan de pago sin cobro que lo respalde</small></div>
  </section>

  <section class="ops-section">
    <header class="ops-section-header"><div><h2>Recurrente por divisa</h2><p>A precio de lista: sin descuentos ni excedentes medidos. Cada divisa se cuenta aparte; nunca se suman entre sí.</p></div></header>
    <div class="ops-revenue-grid">
      {byCurrency.map((c) => <article class="ops-card ops-revenue-card">
        <header><span class="ops-badge navy">{c.currency}</span><small>{opsNumber(c.paying)} {c.paying === 1 ? 'organización' : 'organizaciones'}</small></header>
        <strong class="ops-revenue-mrr">{opsMoney(c.mrr, c.currency)}<small>MRR</small></strong>
        <span class="ops-sub">{opsMoney(c.arr, c.currency)} ARR · {opsNumber(c.annual)} anuales</span>
        {c.unpriced > 0 && <span class="ops-inline-warning">{opsNumber(c.unpriced)} sin precio de lista en {c.currency}: no suman al MRR.</span>}
        <OpsDist rows={c.byPlan.map((p) => ({ label: `${planName(p.plan)} · ${opsNumber(p.paying)}`, value: p.mrr || p.paying, display: opsMoney(p.mrr, c.currency) }))} />
      </article>)}
      {byCurrency.length === 0 && <div class="ops-card ops-empty">Ninguna organización paga todavía.</div>}
    </div>
  </section>

  <div class="ops-grid-2 even ops-section">
    <section>
      <header class="ops-section-header"><div><h2>Cancelan al cierre del periodo</h2><p>Primero las que terminan antes: ahí todavía hay tiempo de hablar.</p></div></header>
      <div class="ops-card ops-list">
        {canceling.map((o) => <a class="ops-list-row two" href={`/ops/organizations/${o.id}`}><div><strong>{o.nombre}</strong><span class="ops-sub">{planName(o.plan)} · {o.billing_cycle || 'sin ciclo'}</span></div><time>Termina {opsDate(o.current_period_end)}</time></a>)}
        {canceling.length === 0 && <div class="ops-empty">Nadie ha pedido cancelar.</div>}
      </div>
    </section>
    <section>
      <header class="ops-section-header"><div><h2>En riesgo</h2><p>Plan de pago sin cobro que lo respalde; la app ya los trata como Gratis.</p></div></header>
      <div class="ops-card ops-list">
        {atRisk.map((o) => <a class="ops-list-row two" href={`/ops/organizations/${o.id}`}><div><strong>{o.nombre}</strong><span class="ops-sub">{planName(o.plan)} guardado · {opsSubscription(o.subscription_status)}</span></div><time>{o.current_period_end ? `Periodo ${opsAgo(o.current_period_end).toLowerCase()}` : 'Sin periodo'}</time></a>)}
        {atRisk.length === 0 && <div class="ops-empty">Ningún plan guardado está sin respaldo.</div>}
      </div>
    </section>
  </div>
  <p class="ops-inline-note ops-section">Cord no guarda cuándo empezó ni cuándo terminó cada suscripción, así que aquí no hay curva de altas ni de bajas: solo el estado de hoy. El checkout de Cord no ofrece prueba gratuita: ese papel lo cumple el plan Gratis.</p>
</OpsShell></OpsLayout>
