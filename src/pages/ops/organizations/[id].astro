---
import OpsLayout from '../../../layouts/OpsLayout.astro';
import OpsShell from '../../../components/ops/OpsShell.astro';
import OpsFeed from '../../../components/ops/OpsFeed.astro';
import OpsDist from '../../../components/ops/OpsDist.astro';
import { sql, withOpsTx } from '../../../lib/db';
import { opsAgo, opsDate, opsMoney, opsNumber, opsPct, OPS_AUDIT_LABELS, OPS_LIFECYCLE_LABELS, OPS_PROVIDER_LABELS, OPS_QUOTE_STATUS, opsDay, opsDisputeReason, opsMoneyStatus, opsSubscription } from '../../../lib/ops-format';
import { opsCollectedByCurrency, opsEventFeed, opsIntegrationPage, opsInvoicePage, opsOrgClosedByCurrency, opsOrgCommerce, opsWorkflowFailures, opsWorkflowPage } from '../../../lib/ops-insights';
import { opsConnectRequirements, opsMinor, opsOrgBilling, opsOrgDisputes, opsOrgPayouts, opsOrgRefunds, opsOrgSubscriptionInvoices, stripeDashboardUrl } from '../../../lib/ops-billing';
import { opsDeliveryPage } from '../../../lib/ops-webhooks';
import { mergeOpsLog, OPS_NOTE_MAX, opsOrgNotes, opsOrgTags } from '../../../lib/ops-notes';
import { iconInner } from '../../../lib/icons';
import { GRANT_MAX_DAYS, GRANT_MAX_MONTHS, GRANT_PLANS, OPS_GRANT_MECHANISM } from '../../../lib/ops-grants';
import { PLANES } from '../../../lib/precios';
import { hasPaidBillingEvidence, normalizePlan } from '../../../lib/entitlements';

if (!Astro.locals.opsOperator) return Astro.redirect('/ops/login');
const id = String(Astro.params.id || '');
if (!/^[0-9a-f-]{36}$/i.test(id)) return Astro.redirect('/ops/organizations');
const r = await withOpsTx(
  sql`select o.id,o.nombre,o.plan,o.country_code,o.moneda,o.quote_prefix,o.created_at,o.onboarded_at,o.subscription_status,o.billing_cycle,o.current_period_end,o.stripe_charges_enabled,o.stripe_payouts_enabled,o.stripe_details_submitted,o.stripe_disabled_reason,o.require_2fa,o.require_sso,o.session_timeout_min,o.ai_cobranza_activa,o.is_demo,o.sandbox_of,owner.email owner_email,owner.id owner_id,
      (select count(*)::int from org_members m where m.org_id=o.id) member_count,
      (select count(*)::int from clientes c where c.org_id=o.id) client_count,
      (select count(*)::int from productos p where p.org_id=o.id) product_count,
      (select count(*)::int from api_keys k where k.org_id=o.id) api_key_count,
      (select count(*)::int from api_keys k where k.org_id=o.id and k.revoked_at is null) active_api_keys,
      (select count(*)::int from webhooks w where w.org_id=o.id) webhook_count,
      (select count(*)::int from webhooks w where w.org_id=o.id and w.activo) active_webhooks,
      (select count(*)::int from sso_connections s where s.org_id=o.id) sso_count,
      (select max(created_at) from domain_events e where e.org_id=o.id) last_event,
      (select count(*)::int from domain_events e where e.org_id=o.id and e.created_at>=now()-interval '30 days') events_30d,
      exists(select 1 from users g where g.id=o.owner_id and lower(g.email) in ('andrevalleo13@gmail.com','hola@flouvia.com')) or exists(select 1 from org_members m join users u on u.id=m.user_id where m.org_id=o.id and lower(u.email) in ('andrevalleo13@gmail.com','hola@flouvia.com')) protected
      from orgs o left join users owner on owner.id=o.owner_id where o.id=${id} limit 1`,
  sql`select u.id,u.email,u.first_name,u.last_name,m.rol,m.estado,m.joined_at,
             (select max(last_used_at) from sessions s where s.user_id=u.id) last_seen,
             (select count(*)::int from domain_events e where e.org_id=m.org_id and e.actor='user:'||u.id::text and e.created_at>=now()-interval '30 days') actions_30d
      from org_members m left join users u on u.id=m.user_id where m.org_id=${id} order by m.created_at desc limit 100`,
  sql`select id,folio,status,total,moneda,created_at,sent_at,approved_at,paid_at from cotizaciones where org_id=${id} order by created_at desc limit 15`,
  sql`select id,empresa,contacto,email,created_at from clientes where org_id=${id} order by created_at desc limit 8`,
  sql`select id,sku,nombre,precio_lista,activo,created_at from productos where org_id=${id} order by created_at desc limit 8`,
  sql`select id,nombre,prefix,last4,scope,mode,type,last_used_at,revoked_at,created_at from api_keys where org_id=${id} order by created_at desc limit 50`,
  sql`select id,url,activo,eventos,last_status,last_error,last_delivery_at,fallos_consecutivos,created_at from webhooks where org_id=${id} order by created_at desc limit 50`,
  sql`select id,nombre,proveedor,enabled,last_login_at,last_error,last_error_at,created_at from sso_connections where org_id=${id} order by created_at desc limit 50`,
  sql`select action,result,actor_email,metadata,ip,created_at from ops_audit_log where target_type='organization' and target_id=${id} order by created_at desc limit 30`,
  opsEventFeed({ orgId: id, limit: 20 }),
  opsInvoicePage('', '', 10, 0, id),
  opsWorkflowPage('', '', 10, 0, id),
  opsIntegrationPage('', '', 10, 0, id),
  opsCollectedByCurrency(90, id),
  opsOrgCommerce(id),
  opsOrgClosedByCurrency(id),
  opsOrgBilling(id),
  opsOrgPayouts(id),
  opsOrgRefunds(id),
  opsOrgDisputes(id),
  opsOrgSubscriptionInvoices(id),
  opsOrgNotes(id),
  opsOrgTags(id),
  opsWorkflowFailures(8, id),
  opsDeliveryPage('failed', id, 8, 0),
  sql`select id, plan, kind, mechanism, starts_at, expires_at, status, reason, operator_email, stripe_coupon_id, revoked_at, revoked_by, created_at
      from ops_plan_grants where org_id = ${id} order by created_at desc limit 6`,
);
const [orgRows, members, quotes, clients, products, keys, webhooks, sso, audit, feed, invoices, workflows, integrations, collected, commerceRows, closed,
  billingRows, payouts, refunds, disputes, subInvoices, notes, tags, failedRuns, failedDeliveries, grants] = r as any[];
if (!orgRows.length) return Astro.redirect('/ops/organizations');
const org: any = orgRows[0];
const commerce: any = commerceRows[0] || {};
const endpoint = `/api/ops/organizations/${id}`;
const isAdmin = Astro.locals.opsOperator?.role === 'admin';
const plan = org.plan || 'free';
const fullName = (m: any) => [m.first_name, m.last_name].filter(Boolean).join(' ') || m.email || 'Invitación pendiente';
const billing: any = billingRows[0] || {};
const requirements = opsConnectRequirements(billing.stripe_requirements);
const effectivePlan = String(billing.effective_plan || 'free');
// Acceso efectivo (pago o cortesía) y plan PAGADO son cosas distintas: una
// cortesía no se rotula como pago (regla 17).
const paidPlan = hasPaidBillingEvidence({
  plan: billing.plan, subscriptionStatus: billing.subscription_status, currentPeriodEnd: billing.current_period_end,
  billingPaidThrough: billing.billing_paid_through, billingPaidPlan: billing.billing_paid_plan,
  stripeSubscriptionId: billing.stripe_subscription_id, stripeCustomerId: billing.stripe_customer_id,
}) ? normalizePlan(billing.plan) : 'free';
const stripeLinks = [
  ['Cliente', stripeDashboardUrl('customer', billing.stripe_customer_id)],
  ['Suscripción', stripeDashboardUrl('subscription', billing.stripe_subscription_id)],
  ['Última factura', stripeDashboardUrl('invoice', billing.billing_last_invoice_id)],
].filter(([, href]) => href) as [string, string][];
const accountUrl = stripeDashboardUrl('account', billing.stripe_account_id);
const log = mergeOpsLog(notes, audit);
const operatorId = Astro.locals.opsOperator?.userId;
const openDisputes = disputes.filter((d: any) => !['won', 'lost', 'charge_refunded', 'warning_closed'].includes(d.status));
const planName = (id: unknown) => PLANES.find((p) => p.id === String(id || 'free'))?.nombre ?? String(id || 'free');
// Mismo día civil: "renueva el 26" y "pagado hasta el 26" dicen lo mismo.
const sameDay = (a: unknown, b: unknown) => !!a && !!b && Math.abs(new Date(String(a)).getTime() - new Date(String(b)).getTime()) < 86_400_000;
const activeGrant = grants.find((g: any) => g.status === 'active' && new Date(g.expires_at) > new Date());
const grantHistory = grants.filter((g: any) => g !== activeGrant);
const grantState = (g: any): [string, string] => g.status === 'revoked' ? ['Revocada', 'red'] : g.status === 'expired' || new Date(g.expires_at) <= new Date() ? ['Vencida', ''] : ['Vigente', 'green'];
const resendable = (d: any) => d.invoice_number && d.lifecycle !== 'draft' && d.lifecycle !== 'void';
---
<OpsLayout title={`${org.nombre} | Cord Ops`}><OpsShell active="organizations" eyebrow="Organización" title={org.nombre} subtitle={`${org.owner_email || 'Sin propietario'} · ${org.country_code} · ${org.moneda}`}>
  <div class="ops-links"><a class="ops-back" href="/ops/organizations">Organizaciones</a><a class="ops-link" href={`/ops/activity?org=${org.id}`}>Toda su actividad</a><a class="ops-link" href={`/ops/usage?org=${org.id}`}>Uso y costos</a><a class="ops-link" href={`/ops/developers?org=${org.id}`}>API y accesos</a></div>

  <section class="ops-card">
    <div class="ops-detail-hero">
      <div class="ops-detail-identity"><span class="ops-avatar square">{org.nombre.charAt(0).toUpperCase()}</span><div><h2>{org.nombre}</h2><p>Plan {plan} · {opsSubscription(org.subscription_status).toLowerCase()} · {org.sandbox_of ? 'Sandbox' : org.is_demo ? 'Demo' : 'Producción'} · última actividad {opsAgo(org.last_event, 'nunca').toLowerCase()}</p>
        <div class="ops-tags" aria-label="Etiquetas internas">
          {tags.map((t: any) => <span class="ops-tag">{t.tag}<button type="button" class="ops-tag-remove" data-ops-tag-remove={t.tag} aria-label={`Quitar etiqueta ${t.tag}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('x')}></svg></button></span>)}
          <form class="ops-tag-form" data-ops-tag-form><label class="ops-sr-only" for="ops-tag-input">Nueva etiqueta</label><input id="ops-tag-input" name="tag" maxlength="24" autocomplete="off" placeholder="Etiqueta" pattern="[a-zA-Z0-9][a-zA-Z0-9 \-]{0,23}" /><button type="submit" class="ops-button ghost sm">Agregar</button></form>
        </div>
      </div></div>
      {isAdmin && <div class="ops-detail-actions">
        <button class="ops-button secondary sm" data-ops-action="revoke_api_keys" data-endpoint={endpoint} data-confirm={org.nombre} data-danger="true" data-title="Revocar llaves API" data-description={`Revocará ${org.active_api_keys} llaves activas. No se puede deshacer: el negocio tendrá que crear llaves nuevas.`}>Revocar llaves API</button>
        <button class="ops-button secondary sm" data-ops-action="disable_webhooks" data-endpoint={endpoint} data-confirm={org.nombre} data-title="Desactivar webhooks" data-description={`Desactivará ${org.active_webhooks} endpoints activos.`}>Desactivar webhooks</button>
        <button class="ops-button danger-soft sm" data-ops-action="revoke_member_sessions" data-endpoint={endpoint} data-confirm={org.nombre} data-danger="true" data-title="Cerrar sesiones del equipo" data-description="Cerrará las sesiones Cord de todos los miembros.">Cerrar sesiones</button>
        {!org.protected && <button class="ops-button danger sm" data-ops-action="delete_organization" data-endpoint={endpoint} data-confirm={org.nombre} data-danger="true" data-title="Eliminar organización" data-description="Cancelará su suscripción y eliminará permanentemente el workspace y toda su información dependiente. Exige haber entrado a Ops hace menos de 10 minutos.">Eliminar</button>}
      </div>}
    </div>
    <div class="ops-facts cols-6">
      <div class="ops-fact"><span>Miembros</span><strong>{opsNumber(org.member_count)}</strong></div>
      <div class="ops-fact"><span>Clientes</span><strong>{opsNumber(org.client_count)}</strong></div>
      <div class="ops-fact"><span>Cotizaciones</span><strong>{opsNumber(commerce.quotes)} · {opsNumber(commerce.quotes_30d)} en 30 días</strong></div>
      <div class="ops-fact"><span>Cierre</span><strong>{opsPct(commerce.won, commerce.sent)}% de las enviadas</strong></div>
      <div class="ops-fact"><span>Eventos 30 días</span><strong>{opsNumber(org.events_30d)}</strong></div>
      <div class="ops-fact"><span>Alta</span><strong>{opsDate(org.created_at)}</strong></div>
    </div>
  </section>

  <div class="ops-grid-3 ops-section">
    <section>
      <header class="ops-section-header"><div><h2>Cerrado</h2><p>Cotizaciones aprobadas o pagadas, por divisa.</p></div></header>
      <div class="ops-card"><OpsDist rows={closed.map((c: any) => ({ label: `${c.currency} · ${opsNumber(c.n)}`, value: Number(c.n), display: opsMoney(c.total, c.currency) }))} empty="Aún no cierra ninguna venta." /></div>
    </section>
    <section>
      <header class="ops-section-header"><div><h2>Cobrado · 90 días</h2><p>Pagos registrados, por divisa.</p></div></header>
      <div class="ops-card"><OpsDist rows={collected.map((c: any) => ({ label: `${c.currency} · ${opsNumber(c.payments)} pagos`, value: Number(c.payments), display: opsMoney(c.total, c.currency) }))} empty="Sin pagos en 90 días." /></div>
    </section>
    <section>
      <header class="ops-section-header"><div><h2>Embudo</h2><p>Estado de todas sus cotizaciones.</p></div></header>
      <div class="ops-card"><OpsDist rows={[
        { label: 'Creadas', value: Number(commerce.quotes || 0) },
        { label: 'Enviadas', value: Number(commerce.sent || 0) },
        { label: 'Ganadas', value: Number(commerce.won || 0) },
        { label: 'Perdidas', value: Number(commerce.lost || 0) },
      ]} /></div>
    </section>
  </div>

  <div class="ops-grid-2 even ops-section">
    <section>
      <header class="ops-section-header"><div><h2>Suscripción de Cord</h2><p>Lo que paga y lo que eso le da.</p></div></header>
      <div class="ops-card ops-card-pad"><dl class="ops-key-value">
        <div><dt>Acceso efectivo</dt><dd><strong>{planName(effectivePlan)}</strong>{effectivePlan !== paidPlan && <span class="ops-badge blue">{activeGrant ? 'Por cortesía' : 'Por promoción'}</span>}</dd></div>
        <div><dt>Plan pagado</dt><dd>{planName(paidPlan)}{normalizePlan(billing.plan) !== paidPlan && <span class="ops-badge amber">Guardado: {planName(billing.plan)}</span>}</dd></div>
        <div><dt>Estado</dt><dd>{opsSubscription(billing.subscription_status)}{billing.billing_cycle && ` · ${billing.billing_cycle}`}{billing.cancel_at_period_end && <span class="ops-badge red">Cancela al cierre del periodo</span>}</dd></div>
        <div><dt>{billing.cancel_at_period_end ? 'Termina' : 'Renueva'}</dt><dd>{opsDate(billing.current_period_end, '—')}{billing.billing_paid_through && !sameDay(billing.billing_paid_through, billing.current_period_end) && ` · pagado hasta ${opsDate(billing.billing_paid_through)}`}</dd></div>
        <div><dt>Último cobro</dt><dd>{billing.billing_last_paid_at
          ? <>{opsMoney(opsMinor(billing.billing_last_amount_paid, billing.billing_currency), billing.billing_currency)} · {opsDate(billing.billing_last_paid_at)}</>
          : 'Ninguno registrado'}</dd></div>
        <div><dt>Divisa de cobro</dt><dd>{billing.billing_currency || 'Sin factura todavía'}</dd></div>
        <div><dt>En el procesador</dt><dd>{stripeLinks.length
          ? <span class="ops-ext-links">{stripeLinks.map(([label, href]) => <a class="ops-link" href={href} target="_blank" rel="noopener noreferrer">{label}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-up-right')}></svg></a>)}</span>
          : 'Sin cliente en el procesador'}</dd></div>
      </dl></div>
      {subInvoices.length > 0 && <div class="ops-card ops-list wrap-sub ops-stack">
        <div class="ops-list-caption">Comprobantes de los cobros de Cord</div>
        {subInvoices.map((f: any) => <div class="ops-list-row two"><div><strong>{opsMoney(opsMinor(f.total_cents, f.currency), f.currency)}</strong><span class="ops-sub">{f.invoice_number ? `CFDI ${f.invoice_number}` : 'Comprobante del cobro'}{f.invoice_error && ` · ${f.invoice_error}`}</span></div><span class:list={['ops-badge', f.status === 'issued' ? 'green' : f.status === 'error' ? 'red' : '']}>{f.status === 'issued' ? 'Timbrada' : f.status === 'error' ? 'Error' : 'Pendiente'}</span></div>)}
      </div>}
    </section>
    <section>
      <header class="ops-section-header"><div><h2>Cuenta de cobros</h2><p>Qué le falta para cobrar y depositar.</p></div>{accountUrl && <a href={accountUrl} target="_blank" rel="noopener noreferrer">Abrir en el procesador</a>}</header>
      <div class="ops-card ops-card-pad">
        {!billing.stripe_account_id ? <div class="ops-empty compact">No ha iniciado el alta de cobros en línea.</div> : <dl class="ops-key-value">
          <div><dt>Cobros</dt><dd><span class:list={['ops-badge', billing.stripe_charges_enabled ? 'green' : 'red']}>{billing.stripe_charges_enabled ? 'Habilitados' : 'Detenidos'}</span></dd></div>
          <div><dt>Depósitos</dt><dd><span class:list={['ops-badge', billing.stripe_payouts_enabled ? 'green' : 'red']}>{billing.stripe_payouts_enabled ? 'Habilitados' : 'Detenidos'}</span>{!billing.stripe_details_submitted && <span class="ops-sub">El alta no se ha enviado completa.</span>}</dd></div>
          <div><dt>Restricción</dt><dd>{billing.stripe_disabled_reason ? <span class="ops-code">{billing.stripe_disabled_reason}</span> : 'Ninguna'}</dd></div>
          <div><dt>Vencidos</dt><dd>{requirements.pastDue.length ? <span class="ops-fields red">{requirements.pastDue.map((f) => <code>{f}</code>)}</span> : 'Ninguno'}</dd></div>
          <div><dt>Pendientes</dt><dd>{requirements.currentlyDue.length ? <span class="ops-fields">{requirements.currentlyDue.map((f) => <code>{f}</code>)}</span> : 'Ninguno'}{requirements.deadline && <span class="ops-sub">Fecha límite {opsDate(requirements.deadline)}</span>}</dd></div>
          <div><dt>En verificación</dt><dd>{requirements.pendingVerification.length ? <span class="ops-fields">{requirements.pendingVerification.map((f) => <code>{f}</code>)}</span> : 'Nada en revisión'}</dd></div>
        </dl>}
      </div>
    </section>
  </div>

  <section class="ops-section" id="cortesias">
    <header class="ops-section-header"><div><h2>Cortesías</h2><p>Días gratis o plan regalado. Dan acceso, no cuentan como pago, y mientras duran lo incluido es su tope: no hay excedentes.</p></div></header>
    <div class="ops-grid-2 even ops-grant-grid">
      <div class="ops-card ops-list wrap-sub">
        {activeGrant ? <div class="ops-list-row two ops-grant-active"><div><strong>{planName(activeGrant.plan)} hasta el {opsDate(activeGrant.expires_at)}</strong><span class="ops-sub">{OPS_GRANT_MECHANISM[activeGrant.mechanism]} · {activeGrant.reason} · {activeGrant.operator_email}</span></div>
          {isAdmin ? <button class="ops-button danger-soft sm" data-ops-action="revoke_grant" data-endpoint={`/api/ops/organizations/${org.id}/grants`} data-target-id={activeGrant.id} data-confirm={org.nombre} data-danger="true" data-title="Revocar cortesía" data-description={activeGrant.mechanism === 'trial' ? 'Termina el periodo sin cobro en el procesador: le cobra el periodo nuevo AHORA con su tarjeta guardada, y pierde el acceso de cortesía.' : activeGrant.mechanism === 'cupon' ? 'Quita el cupón de su suscripción: la próxima mensualidad se cobra completa, y pierde el acceso de cortesía.' : 'Pierde de inmediato el acceso que le daba la cortesía. No toca el procesador.'}>Revocar</button> : <span class="ops-badge green">Vigente</span>}
        </div> : <div class="ops-empty">Sin cortesía vigente.</div>}
        {grantHistory.map((g: any) => { const [label, tone] = grantState(g); return <div class="ops-list-row two"><div><strong>{planName(g.plan)} · {g.kind === 'dias' ? 'días gratis' : 'plan regalado'}</strong><span class="ops-sub">{opsDate(g.created_at)} → {opsDate(g.expires_at)} · {OPS_GRANT_MECHANISM[g.mechanism]} · {g.reason}{g.revoked_by && ` · revocó ${g.revoked_by}`}</span></div><span class:list={['ops-badge', tone]}>{label}</span></div>; })}
      </div>
      {isAdmin && !activeGrant && !org.sandbox_of && <form class="ops-card ops-card-pad ops-grant-form" data-ops-grant-form data-endpoint={`/api/ops/organizations/${org.id}/grants`}>
        <div class="ops-grant-kinds" role="radiogroup" aria-label="Tipo de cortesía">
          <label><input type="radio" name="kind" value="dias" checked /> <span>Días gratis</span></label>
          <label><input type="radio" name="kind" value="plan" /> <span>Plan regalado</span></label>
        </div>
        <div class="ops-grant-fields">
          <label class="ops-field"><span data-ops-grant-amount-label>Días (1 a {GRANT_MAX_DAYS})</span><input class="ops-input" name="amount" type="number" min="1" max={GRANT_MAX_DAYS} value="14" required data-max-dias={GRANT_MAX_DAYS} data-max-plan={GRANT_MAX_MONTHS} /></label>
          <label class="ops-field"><span>Plan</span><select class="ops-select" name="plan">{GRANT_PLANS.map((p) => <option value={p} selected={p === 'pro'}>{planName(p)}</option>)}</select><small>En días gratis a quien ya paga, conserva el suyo.</small></label>
        </div>
        <label class="ops-field"><span>Motivo</span><input class="ops-input" name="reason" maxlength="300" required placeholder="Por qué, para quien lea la bitácora después" /></label>
        <div class="ops-grant-review" data-ops-grant-review hidden>
          <p data-ops-grant-summary></p>
          <label class="ops-field"><span>Escribe <strong>{org.nombre}</strong> para confirmar</span><input class="ops-input" name="confirmation" autocomplete="off" /></label>
        </div>
        <p class="ops-inline-error" data-ops-grant-error hidden></p>
        <div class="ops-grant-actions"><button type="submit" class="ops-button secondary sm" data-ops-grant-step="review">Revisar</button><button type="button" class="ops-button sm" data-ops-grant-step="confirm" hidden>Dar cortesía</button></div>
      </form>}
    </div>
  </section>

  {billing.stripe_account_id && <div class="ops-grid-3 ops-section">
    <section>
      <header class="ops-section-header"><div><h2>Depósitos</h2><p>Los más recientes.</p></div></header>
      <div class="ops-card ops-list wrap-sub">
        {payouts.map((p: any) => { const [label, tone] = opsMoneyStatus(p.status); return <div class="ops-list-row two"><div><strong>{opsMoney(opsMinor(p.amount_cents, p.currency), p.currency)}</strong><span class="ops-sub">{p.arrival_date ? `${p.status === 'paid' ? 'Llegó' : 'Llega'} el ${opsDay(p.arrival_date)}` : opsDate(p.created_at)}{p.destino_last4 && ` · cuenta …${p.destino_last4}`}{p.failure_message && ` · ${p.failure_message}`}</span></div><span class:list={['ops-badge', tone]}>{label}</span></div>; })}
        {payouts.length === 0 && <div class="ops-empty">Sin depósitos.</div>}
      </div>
    </section>
    <section>
      <header class="ops-section-header"><div><h2>Reembolsos</h2><p>Devoluciones a sus clientes.</p></div></header>
      <div class="ops-card ops-list wrap-sub">
        {refunds.map((f: any) => { const [label, tone] = opsMoneyStatus(f.status); return <div class="ops-list-row two"><div><strong>{opsMoney(opsMinor(f.amount_cents, f.currency), f.currency)}</strong><span class="ops-sub">{f.manual ? 'Registrado a mano' : 'En línea'} · {opsAgo(f.created_at).toLowerCase()}{f.failure_reason && ` · ${f.failure_reason}`}</span></div><span class:list={['ops-badge', tone]}>{label}</span></div>; })}
        {refunds.length === 0 && <div class="ops-empty">Sin reembolsos.</div>}
      </div>
    </section>
    <section>
      <header class="ops-section-header"><div><h2>Disputas</h2><p>{openDisputes.length === 1 ? 'Una abierta.' : openDisputes.length ? `${opsNumber(openDisputes.length)} abiertas.` : 'Contracargos de sus clientes.'}</p></div></header>
      <div class="ops-card ops-list wrap-sub">
        {disputes.map((d: any) => { const [label, tone] = opsMoneyStatus(d.status); return <div class="ops-list-row two"><div><strong>{opsMoney(opsMinor(d.amount_cents, d.currency), d.currency)}</strong><span class="ops-sub">{opsDisputeReason(d.reason)}{d.evidence_due_at && !d.evidence_submitted_at && ` · evidencia antes del ${opsDate(d.evidence_due_at)}`}{d.evidence_submitted_at && ' · evidencia enviada'}</span></div><span class:list={['ops-badge', tone]}>{label}</span></div>; })}
        {disputes.length === 0 && <div class="ops-empty">Sin disputas.</div>}
      </div>
    </section>
  </div>}

  {(failedRuns.length > 0 || failedDeliveries.length > 0) && <div class="ops-grid-2 even ops-section">
    <section>
      <header class="ops-section-header"><div><h2>Workflows fallidos</h2><p>{isAdmin ? 'Reintentar los vuelve a poner en cola desde el inicio.' : 'Solo un admin puede reintentarlos.'}</p></div></header>
      <div class="ops-card ops-list wrap-sub">
        {failedRuns.map((f: any) => <div class="ops-list-row two"><div><strong>{f.workflow}</strong><span class="ops-sub">{f.error || 'Sin detalle'} · {opsNumber(f.attempts)} {Number(f.attempts) === 1 ? 'intento' : 'intentos'} · {opsAgo(f.created_at).toLowerCase()}</span></div>{isAdmin ? <button class="ops-button secondary sm" data-ops-action="retry_workflow_run" data-endpoint="/api/ops/recovery" data-target-id={f.id} data-title="Reintentar ejecución" data-description={`Volverá a ejecutar "${f.workflow}" desde el inicio, con el mismo evento que lo disparó. Si el workflow manda correos o mensajes, saldrán de nuevo.`}>Reintentar</button> : <time>{opsAgo(f.created_at)}</time>}</div>)}
        {failedRuns.length === 0 && <div class="ops-empty">Ningún workflow ha fallado.</div>}
      </div>
    </section>
    <section>
      <header class="ops-section-header"><div><h2>Entregas de webhook fallidas</h2><p>Los intentos más recientes que su endpoint rechazó.</p></div><a href={`/ops/webhooks?org=${org.id}`}>Ver todas</a></header>
      <div class="ops-card ops-list wrap-sub">
        {failedDeliveries.map((d: any) => <div class="ops-list-row two"><div><strong>{d.evento}</strong><span class="ops-sub ops-data-value">{d.error || (d.status ? `Respondió ${d.status}` : 'Sin respuesta')} · {d.url}</span></div>{isAdmin && d.replayable ? <button class="ops-button secondary sm" data-ops-action="redeliver_webhook" data-endpoint="/api/ops/recovery" data-target-id={d.id} data-title="Re-entregar webhook" data-description={`Volverá a mandar el mismo evento ${d.evento}, firmado de nuevo, a ${d.url}. El receptor debe ser idempotente: es el mismo id de evento.`}>Re-entregar</button> : <time>{opsAgo(d.created_at)}</time>}</div>)}
        {failedDeliveries.length === 0 && <div class="ops-empty">Ninguna entrega ha fallado.</div>}
      </div>
    </section>
  </div>}

  <div class="ops-grid-2 ops-section">
    <section>
      <header class="ops-section-header"><div><h2>Actividad reciente</h2><p>Lo que hicieron el equipo, sus clientes y los sistemas.</p></div><a href={`/ops/activity?org=${org.id}`}>Ver todo</a></header>
      <div class="ops-card"><OpsFeed events={feed.slice(0, 20)} showOrg={false} /></div>
    </section>
    <div>
      <section>
        <header class="ops-section-header"><div><h2>Equipo</h2><p>{opsNumber(org.member_count)} miembros · acciones en 30 días.</p></div></header>
        <div class="ops-card ops-list">
          {members.map((m: any) => <a class="ops-list-row two" href={m.id ? `/ops/users/${m.id}` : undefined}><div class="ops-identity"><span class="ops-avatar">{fullName(m).charAt(0).toUpperCase()}</span><div><strong>{fullName(m)}</strong><span class="ops-sub">{m.rol} · {m.estado} · visto {opsAgo(m.last_seen, 'nunca').toLowerCase()}</span></div></div><time>{opsNumber(m.actions_30d)} acciones</time></a>)}
          {members.length === 0 && <div class="ops-empty">Sin miembros.</div>}
        </div>
      </section>
      <section class="ops-section">
        <header class="ops-section-header"><div><h2>Configuración</h2><p>Estado operativo del workspace.</p></div></header>
        <div class="ops-card ops-card-pad"><dl class="ops-key-value">
          <div><dt>ID</dt><dd class="ops-code">{org.id}</dd></div>
          <div><dt>Onboarding</dt><dd>{opsDate(org.onboarded_at, 'Pendiente')}</dd></div>
          <div><dt>Seguridad</dt><dd>2FA {org.require_2fa ? 'obligatorio' : 'opcional'} · SSO {org.require_sso ? 'obligatorio' : 'opcional'} · sesión de {org.session_timeout_min || 'duración estándar'}{org.session_timeout_min ? ' min' : ''}</dd></div>
          <div><dt>Cobranza autónoma</dt><dd>{org.ai_cobranza_activa ? 'Activa' : 'Inactiva'}</dd></div>
        </dl></div>
      </section>
    </div>
  </div>

  <section class="ops-section">
    <header class="ops-section-header"><div><h2>Cotizaciones recientes</h2><p>Últimas 15.</p></div></header>
    <div class="ops-card ops-table-wrap"><table class="ops-table"><thead><tr><th>Folio</th><th>Estado</th><th class="num">Total</th><th>Creada</th><th>Enviada</th><th>Cierre</th></tr></thead><tbody>
      {quotes.map((q: any) => { const [label, tone] = OPS_QUOTE_STATUS[q.status] ?? [q.status, '']; return <tr><td><strong>{q.folio}</strong></td><td><span class:list={['ops-badge', tone]}>{label}</span></td><td class="num">{opsMoney(q.total, q.moneda || org.moneda)}</td><td>{opsDate(q.created_at)}</td><td>{opsDate(q.sent_at, '—')}</td><td>{opsDate(q.paid_at || q.approved_at, '—')}</td></tr>; })}
      {quotes.length === 0 && <tr><td colspan="6" class="ops-empty">Sin cotizaciones.</td></tr>}
    </tbody></table></div>
  </section>

  <section class="ops-section">
    <header class="ops-section-header"><div><h2>Facturas</h2><p>{opsNumber(invoices[0]?.total_count || 0)} en total; últimas 10.</p></div><a href="/ops/invoices">Todas las facturas</a></header>
    <div class="ops-card ops-table-wrap"><table class="ops-table"><thead><tr><th>Factura</th><th>Cliente</th><th>Estado</th><th class="num">Total</th><th class="num">Saldo</th><th>Vista</th>{isAdmin && <th><span class="ops-sr-only">Acciones</span></th>}</tr></thead><tbody>
      {invoices.map((d: any) => { const [label, tone] = OPS_LIFECYCLE_LABELS[d.lifecycle] ?? [d.lifecycle, '']; return <tr><td><strong>{d.invoice_number || 'Sin folio'}</strong><span class="ops-sub">{opsDate(d.issued_at || d.created_at)}</span></td><td>{d.cliente || 'Sin cliente'}</td><td><span class:list={['ops-badge', d.overdue ? 'red' : tone]}>{d.overdue ? 'Vencida' : label}</span>{d.status === 'error' && <span class="ops-badge red">Error fiscal</span>}</td><td class="num">{opsMoney(d.total, d.currency)}</td><td class="num">{Number(d.amount_remaining) > 0 ? opsMoney(d.amount_remaining, d.currency) : '—'}</td><td>{d.first_viewed_at ? opsAgo(d.first_viewed_at) : <span class="ops-muted">Aún no</span>}</td>{isAdmin && <td class="num">{resendable(d) && <button class="ops-button ghost sm" data-ops-action="resend_invoice" data-endpoint="/api/ops/recovery" data-target-id={d.id} data-confirm={d.invoice_number} data-title="Reenviar factura al cliente" data-description={`Mandará otra vez la factura ${d.invoice_number} a ${d.cliente || 'su cliente'}, con su PDF y su link de pago, en el idioma del negocio. El negocio verá en su historial que la reenvió Soporte de Cord.`}>Reenviar</button>}</td>}</tr>; })}
      {invoices.length === 0 && <tr><td colspan={isAdmin ? 7 : 6} class="ops-empty">Sin facturas.</td></tr>}
    </tbody></table></div>
  </section>

  <div class="ops-grid-2 even ops-section">
    <section>
      <header class="ops-section-header"><div><h2>Workflows</h2><p>Ejecuciones y fallas en 7 días.</p></div></header>
      <div class="ops-card ops-list">
        {workflows.map((w: any) => <div class="ops-list-row two"><div><strong>{w.nombre}</strong><span class="ops-sub">{w.estado === 'active' ? 'Activo' : w.estado === 'paused' ? 'Pausado' : 'Borrador'} · <span class="ops-code">{w.trigger_publicado || 'sin publicar'}</span></span></div><time>{opsNumber(w.runs_7d)} ejecuciones{Number(w.failed_7d) > 0 && ` · ${opsNumber(w.failed_7d)} fallidas`}</time></div>)}
        {workflows.length === 0 && <div class="ops-empty">Sin workflows.</div>}
      </div>
    </section>
    <section>
      <header class="ops-section-header"><div><h2>Integraciones</h2><p>Cuentas externas conectadas.</p></div></header>
      <div class="ops-card ops-list">
        {integrations.map((c: any) => <div class="ops-list-row two"><div><strong>{OPS_PROVIDER_LABELS[c.proveedor] || c.proveedor}</strong><span class="ops-sub">{c.cuenta_nombre || c.cuenta_externa}{c.ultimo_error && ` · ${c.ultimo_error}`}</span></div><time>{c.estado === 'error' ? <span class="ops-badge red">Con error</span> : c.estado === 'activa' ? `Sincronizó ${opsAgo(c.ultima_sync_at, 'nunca').toLowerCase()}` : 'Desconectada'}</time></div>)}
        {integrations.length === 0 && <div class="ops-empty">Sin integraciones.</div>}
      </div>
    </section>
  </div>

  <div class="ops-grid-2 even ops-section">
    <section><header class="ops-section-header"><div><h2>Clientes</h2><p>{opsNumber(org.client_count)} en total; últimos 8.</p></div></header><div class="ops-card ops-list">{clients.map((c: any) => <div class="ops-list-row"><strong>{c.empresa}</strong><span>{c.contacto || c.email || 'Sin contacto'}</span><time>{opsAgo(c.created_at)}</time></div>)}{clients.length === 0 && <div class="ops-empty">Sin clientes.</div>}</div></section>
    <section><header class="ops-section-header"><div><h2>Productos</h2><p>{opsNumber(org.product_count)} en total; últimos 8.</p></div></header><div class="ops-card ops-list">{products.map((p: any) => <div class="ops-list-row"><strong>{p.nombre}</strong><span>{p.sku || 'Sin SKU'} · {opsMoney(p.precio_lista, org.moneda)}</span><span class:list={['ops-badge', p.activo ? 'green' : '']}>{p.activo ? 'Activo' : 'Inactivo'}</span></div>)}{products.length === 0 && <div class="ops-empty">Sin productos.</div>}</div></section>
  </div>

  <div class="ops-grid-3 ops-section">
    <section><header class="ops-section-header"><div><h2>Llaves API</h2><p>{opsNumber(org.api_key_count)} llaves.</p></div></header><div class="ops-card ops-list">{keys.map((k: any) => <div class="ops-list-row two"><div><strong>{k.nombre}</strong><span class="ops-sub ops-code">{k.prefix}…{k.last4} · usada {opsAgo(k.last_used_at, 'nunca').toLowerCase()}</span></div><span class:list={['ops-badge', k.revoked_at ? 'red' : 'green']}>{k.revoked_at ? 'Revocada' : 'Activa'}</span></div>)}{keys.length === 0 && <div class="ops-empty">Sin llaves.</div>}</div></section>
    <section><header class="ops-section-header"><div><h2>Webhooks</h2><p>{opsNumber(org.webhook_count)} endpoints.</p></div></header><div class="ops-card ops-list">{webhooks.map((w: any) => <div class="ops-list-row two"><div><strong class="ops-data-value">{w.url}</strong><span class="ops-sub">{w.last_status || 'Sin entregas'} · {w.fallos_consecutivos || 0} fallos seguidos</span></div><span class:list={['ops-badge', w.activo ? 'green' : 'red']}>{w.activo ? 'Activo' : 'Inactivo'}</span></div>)}{webhooks.length === 0 && <div class="ops-empty">Sin webhooks.</div>}</div></section>
    <section><header class="ops-section-header"><div><h2>SSO</h2><p>{opsNumber(org.sso_count)} conexiones.</p></div></header><div class="ops-card ops-list">{sso.map((s: any) => <div class="ops-list-row two"><div><strong>{s.nombre}</strong><span class="ops-sub">{s.proveedor} · último acceso {opsAgo(s.last_login_at, 'nunca').toLowerCase()}</span></div><span class:list={['ops-badge', s.enabled ? 'green' : '']}>{s.enabled ? 'Activa' : 'Inactiva'}</span></div>)}{sso.length === 0 && <div class="ops-empty">Sin SSO.</div>}</div></section>
  </div>

  <section class="ops-section" id="bitacora">
    <header class="ops-section-header"><div><h2>Bitácora interna</h2><p>Notas del equipo y acciones de Ops sobre este workspace. El negocio no la ve.</p></div></header>
    <div class="ops-card">
      <form class="ops-note-form" data-ops-note-form data-endpoint={`/api/ops/organizations/${org.id}/notes`}>
        <label class="ops-sr-only" for="ops-note-body">Nota interna</label>
        <textarea id="ops-note-body" class="ops-textarea" name="body" maxlength={OPS_NOTE_MAX} required placeholder="Contexto para el siguiente que abra esta ficha: qué pidió, qué se le prometió, qué vigilar."></textarea>
        <div class="ops-note-form-foot"><span class="ops-inline-error" data-ops-note-error hidden></span><button type="submit" class="ops-button sm">Guardar nota</button></div>
      </form>
      {log.map((e) => e.kind === 'note'
        ? <article class="ops-log-row note"><span class="ops-log-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('chat')}></svg></span><div><p class="ops-log-body">{e.body}</p><span class="ops-sub">{e.author} · <time title={opsDate(e.at)}>{opsAgo(e.at).toLowerCase()}</time></span></div>{(isAdmin || e.authorId === operatorId) && <button type="button" class="ops-icon-button" data-ops-note-delete={e.id} aria-label="Borrar nota"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('trash')}></svg></button>}</article>
        : <div class="ops-log-row"><span class:list={['ops-audit-dot', e.result]}></span><div><strong>{OPS_AUDIT_LABELS[e.action] || e.action}</strong><span class="ops-sub">{e.author}{e.ip && ` · ${e.ip}`}</span></div><time title={opsDate(e.at)}>{opsAgo(e.at)}</time></div>)}
      {log.length === 0 && <div class="ops-empty">Sin notas ni acciones administrativas.</div>}
    </div>
  </section>
<script>
  // Notas y etiquetas: fetch y recarga. El texto lo pinta el servidor (Astro
  // escapa); aquí no se escribe HTML con datos de nadie.
  const noteForm = document.querySelector<HTMLFormElement>('[data-ops-note-form]');
  const endpoint = noteForm?.dataset.endpoint || '';
  const send = async (method: 'POST' | 'DELETE', body: Record<string, string>) => {
    const res = await fetch(endpoint, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'No se pudo guardar.');
  };
  const noteError = document.querySelector<HTMLElement>('[data-ops-note-error]');
  noteForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = noteForm.querySelector('button')!;
    button.disabled = true;
    try {
      await send('POST', { kind: 'note', body: String(new FormData(noteForm).get('body') || '') });
      location.reload();
    } catch (error: any) {
      if (noteError) { noteError.textContent = error.message; noteError.hidden = false; }
      button.disabled = false;
    }
  });
  const tagForm = document.querySelector<HTMLFormElement>('[data-ops-tag-form]');
  tagForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = tagForm.querySelector('input')!;
    try { await send('POST', { kind: 'tag', tag: input.value }); location.reload(); }
    catch (error: any) { input.setCustomValidity(error.message); input.reportValidity(); }
  });
  tagForm?.querySelector('input')?.addEventListener('input', (event) => (event.target as HTMLInputElement).setCustomValidity(''));
  // Cortesías: primero "Revisar" (sin efectos, el servidor dice qué hará con
  // el estado real de la suscripción) y después confirmar con el nombre.
  const grantForm = document.querySelector<HTMLFormElement>('[data-ops-grant-form]');
  if (grantForm) {
    const review = grantForm.querySelector<HTMLElement>('[data-ops-grant-review]')!;
    const summary = grantForm.querySelector<HTMLElement>('[data-ops-grant-summary]')!;
    const grantError = grantForm.querySelector<HTMLElement>('[data-ops-grant-error]')!;
    const reviewBtn = grantForm.querySelector<HTMLButtonElement>('[data-ops-grant-step="review"]')!;
    const confirmBtn = grantForm.querySelector<HTMLButtonElement>('[data-ops-grant-step="confirm"]')!;
    const amount = grantForm.querySelector<HTMLInputElement>('input[name="amount"]')!;
    const amountLabel = grantForm.querySelector<HTMLElement>('[data-ops-grant-amount-label]')!;
    const payload = () => {
      const data = new FormData(grantForm);
      return { kind: data.get('kind'), amount: Number(data.get('amount')), plan: data.get('plan'), reason: String(data.get('reason') || ''), confirmation: String(data.get('confirmation') || '') };
    };
    const reset = () => { review.hidden = true; confirmBtn.hidden = true; reviewBtn.hidden = false; grantError.hidden = true; };
    grantForm.addEventListener('input', (event) => { if ((event.target as HTMLInputElement).name !== 'confirmation') reset(); });
    grantForm.querySelectorAll<HTMLInputElement>('input[name="kind"]').forEach((radio) => radio.addEventListener('change', () => {
      const dias = radio.value === 'dias' && radio.checked;
      const max = dias ? amount.dataset.maxDias : amount.dataset.maxPlan;
      amount.max = String(max);
      amount.value = dias ? '14' : '3';
      amountLabel.textContent = dias ? `Días (1 a ${max})` : `Meses (1 a ${max})`;
    }));
    const call = async (dryRun: boolean) => {
      const res = await fetch(grantForm.dataset.endpoint || '', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...payload(), dryRun }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 428) window.location.href = `/ops/login?next=${encodeURIComponent(window.location.pathname)}`;
        throw new Error(data.error || 'No se pudo completar.');
      }
      return data;
    };
    grantForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      reviewBtn.disabled = true; grantError.hidden = true;
      try {
        const data = await call(true);
        summary.textContent = data.summary;
        review.hidden = false; confirmBtn.hidden = false; reviewBtn.hidden = true;
        grantForm.querySelector<HTMLInputElement>('input[name="confirmation"]')?.focus();
      } catch (error: any) { grantError.textContent = error.message; grantError.hidden = false; }
      finally { reviewBtn.disabled = false; }
    });
    confirmBtn.addEventListener('click', async () => {
      confirmBtn.disabled = true; grantError.hidden = true;
      try { await call(false); window.location.reload(); }
      catch (error: any) { grantError.textContent = error.message; grantError.hidden = false; confirmBtn.disabled = false; }
    });
  }

  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const tag = target.closest<HTMLButtonElement>('[data-ops-tag-remove]');
    const note = target.closest<HTMLButtonElement>('[data-ops-note-delete]');
    if (!tag && !note) return;
    const button = (tag || note)!;
    if (note && !window.confirm('¿Borrar esta nota? Queda registrado en la bitácora quién la borró.')) return;
    button.disabled = true;
    try {
      await send('DELETE', tag ? { kind: 'tag', tag: tag.dataset.opsTagRemove || '' } : { kind: 'note', id: note!.dataset.opsNoteDelete || '' });
      location.reload();
    } catch (error: any) { button.disabled = false; window.alert(error.message); }
  });
</script>
</OpsShell></OpsLayout>
