---
import OpsLayout from '../../../layouts/OpsLayout.astro';
import OpsShell from '../../../components/ops/OpsShell.astro';
import OpsActionDialog from '../../../components/ops/OpsActionDialog.astro';
import { sql } from '../../../lib/db';
import { opsDate, opsNumber, OPS_AUDIT_LABELS } from '../../../lib/ops-format';

if(!Astro.locals.opsOperator)return Astro.redirect('/ops/login');
const id=String(Astro.params.id||'');
if(!/^[0-9a-f-]{36}$/i.test(id))return Astro.redirect('/ops/organizations');
const [orgRows,members,quotes,clients,products,keys,webhooks,sso,audit]=await Promise.all([
  sql`select o.id,o.nombre,o.plan,o.country_code,o.moneda,o.quote_prefix,o.created_at,o.onboarded_at,o.subscription_status,o.billing_cycle,o.current_period_end,o.stripe_charges_enabled,o.stripe_payouts_enabled,o.stripe_details_submitted,o.stripe_disabled_reason,o.require_2fa,o.require_sso,o.session_timeout_min,o.ai_cobranza_activa,o.is_demo,o.sandbox_of,owner.email owner_email,
      (select count(*)::int from org_members m where m.org_id=o.id) member_count,
      (select count(*)::int from clientes c where c.org_id=o.id) client_count,
      (select count(*)::int from productos p where p.org_id=o.id) product_count,
      (select count(*)::int from cotizaciones q where q.org_id=o.id) quote_count,
      (select coalesce(sum(q.total),0) from cotizaciones q where q.org_id=o.id and q.status in ('approved','paid','invoiced')) closed_value,
      (select count(*)::int from api_keys k where k.org_id=o.id) api_key_count,
      (select count(*)::int from api_keys k where k.org_id=o.id and k.revoked_at is null) active_api_keys,
      (select count(*)::int from webhooks w where w.org_id=o.id) webhook_count,
      (select count(*)::int from webhooks w where w.org_id=o.id and w.activo) active_webhooks,
      (select count(*)::int from sso_connections s where s.org_id=o.id) sso_count,
      exists(select 1 from users g where g.id=o.owner_id and lower(g.email) in ('andrevalleo13@gmail.com','hola@flouvia.com')) or exists(select 1 from org_members m join users u on u.id=m.user_id where m.org_id=o.id and lower(u.email) in ('andrevalleo13@gmail.com','hola@flouvia.com')) protected
      from orgs o left join users owner on owner.id=o.owner_id where o.id=${id} limit 1`,
  sql`select u.id,u.email,u.first_name,u.last_name,m.rol,m.estado,m.joined_at from org_members m left join users u on u.id=m.user_id where m.org_id=${id} order by m.created_at desc limit 100`,
  sql`select id,folio,status,total,moneda,created_at,sent_at,approved_at,paid_at from cotizaciones where org_id=${id} order by created_at desc limit 25`,
  sql`select id,empresa,contacto,email,created_at from clientes where org_id=${id} order by created_at desc limit 20`,
  sql`select id,sku,nombre,precio_lista,activo,created_at from productos where org_id=${id} order by created_at desc limit 20`,
  sql`select id,nombre,prefix,last4,scope,mode,type,last_used_at,revoked_at,created_at from api_keys where org_id=${id} order by created_at desc limit 50`,
  sql`select id,url,activo,eventos,last_status,last_error,last_delivery_at,fallos_consecutivos,created_at from webhooks where org_id=${id} order by created_at desc limit 50`,
  sql`select id,nombre,proveedor,enabled,last_login_at,last_error,last_error_at,created_at from sso_connections where org_id=${id} order by created_at desc limit 50`,
  sql`select action,result,actor_email,metadata,ip,created_at from ops_audit_log where target_type='organization' and target_id=${id} order by created_at desc limit 50`,
]);
if(!orgRows.length)return Astro.redirect('/ops/organizations');
const org:any=orgRows[0]; const endpoint=`/api/ops/organizations/${id}`;
---
<OpsLayout title={`${org.nombre} | Cord Ops`}><OpsShell active="organizations" eyebrow="Organización" title={org.nombre} subtitle={org.owner_email||'Sin propietario'}>
  <div class="ops-detail-links"><a href="/ops/organizations">Volver a organizaciones</a><a href={`/ops/usage?org=${org.id}`}>Ver uso y costos</a></div>
  <section class="ops-card"><div class="ops-detail-hero"><div class="ops-detail-identity"><span class="ops-avatar">{org.nombre.charAt(0).toUpperCase()}</span><div><h2>{org.nombre}</h2><p>{org.country_code} · {org.plan||'free'} · {org.subscription_status||'sin suscripción'}</p></div></div><div class="ops-detail-actions"><button class="ops-button secondary" data-ops-action="revoke_api_keys" data-endpoint={endpoint} data-title="Revocar llaves API" data-description={`Revocará ${org.active_api_keys} llaves activas.`}>Revocar API keys</button><button class="ops-button secondary" data-ops-action="disable_webhooks" data-endpoint={endpoint} data-title="Desactivar webhooks" data-description={`Desactivará ${org.active_webhooks} endpoints activos.`}>Desactivar webhooks</button><button class="ops-button danger" data-ops-action="revoke_member_sessions" data-endpoint={endpoint} data-confirm={org.nombre} data-danger="true" data-title="Cerrar sesiones del equipo" data-description="Cerrará las sesiones Cord de todos los miembros.">Cerrar sesiones</button>{!org.protected&&<button class="ops-button danger" data-ops-action="delete_organization" data-endpoint={endpoint} data-confirm={org.nombre} data-danger="true" data-title="Eliminar organización" data-description="Eliminará permanentemente el workspace y toda su información dependiente.">Eliminar</button>}</div></div>
    <div class="ops-facts"><div class="ops-fact"><span>Miembros</span><strong>{opsNumber(org.member_count)}</strong></div><div class="ops-fact"><span>Cotizaciones</span><strong>{opsNumber(org.quote_count)}</strong></div><div class="ops-fact"><span>Cierre acumulado</span><strong>{new Intl.NumberFormat('es-MX',{style:'currency',currency:org.moneda||'MXN',maximumFractionDigits:0}).format(Number(org.closed_value||0))}</strong></div><div class="ops-fact"><span>Alta</span><strong>{opsDate(org.created_at)}</strong></div></div></section>
  <div class="ops-grid-2 ops-section"><section><header class="ops-section-header"><div><h2>Configuración</h2><p>Estado operativo del workspace.</p></div></header><div class="ops-card ops-card-pad"><dl class="ops-key-value"><div><dt>ID</dt><dd class="ops-code">{org.id}</dd></div><div><dt>Onboarding</dt><dd>{opsDate(org.onboarded_at,'Pendiente')}</dd></div><div><dt>2FA obligatorio</dt><dd>{org.require_2fa?'Sí':'No'}</dd></div><div><dt>SSO obligatorio</dt><dd>{org.require_sso?'Sí':'No'}</dd></div><div><dt>Timeout</dt><dd>{org.session_timeout_min||'Default'} min</dd></div><div><dt>Cobranza autónoma</dt><dd>{org.ai_cobranza_activa?'Activa':'Inactiva'}</dd></div><div><dt>Entorno</dt><dd>{org.sandbox_of?'Sandbox':org.is_demo?'Demo':'Producción'}</dd></div></dl></div></section><section><header class="ops-section-header"><div><h2>Pagos</h2><p>Estado de Stripe y suscripción.</p></div></header><div class="ops-card ops-card-pad"><dl class="ops-key-value"><div><dt>Suscripción</dt><dd>{org.subscription_status||'Sin suscripción'}</dd></div><div><dt>Ciclo</dt><dd>{org.billing_cycle||'—'}</dd></div><div><dt>Próximo periodo</dt><dd>{opsDate(org.current_period_end,'—')}</dd></div><div><dt>Cobros</dt><dd>{org.stripe_charges_enabled?'Habilitados':'No habilitados'}</dd></div><div><dt>Retiros</dt><dd>{org.stripe_payouts_enabled?'Habilitados':'No habilitados'}</dd></div><div><dt>Detalle Stripe</dt><dd>{org.stripe_disabled_reason||'Sin incidencias'}</dd></div></dl></div></section></div>
  <section class="ops-section"><header class="ops-section-header"><div><h2>Equipo</h2><p>{opsNumber(org.member_count)} miembros; últimos 100.</p></div></header><div class="ops-card ops-table-wrap"><table class="ops-table"><thead><tr><th>Persona</th><th>Rol</th><th>Estado</th><th>Ingreso</th></tr></thead><tbody>{members.map((m:any)=><tr><td>{m.id?<a href={`/ops/users/${m.id}`}>{[m.first_name,m.last_name].filter(Boolean).join(' ')||m.email}</a>:m.email||'Invitación pendiente'}<span class="ops-sub">{m.email}</span></td><td>{m.rol}</td><td><span class="ops-badge">{m.estado}</span></td><td>{opsDate(m.joined_at,'Pendiente')}</td></tr>)}{members.length===0&&<tr><td colspan="4" class="ops-empty">Sin miembros.</td></tr>}</tbody></table></div></section>
  <section class="ops-section"><header class="ops-section-header"><div><h2>Cotizaciones recientes</h2><p>Últimos 25 registros.</p></div></header><div class="ops-card ops-table-wrap"><table class="ops-table"><thead><tr><th>Folio</th><th>Estado</th><th>Total</th><th>Creada</th><th>Cierre</th></tr></thead><tbody>{quotes.map((q:any)=><tr><td>{q.folio}</td><td><span class="ops-badge blue">{q.status}</span></td><td>{new Intl.NumberFormat('es-MX',{style:'currency',currency:q.moneda||org.moneda||'MXN'}).format(Number(q.total||0))}</td><td>{opsDate(q.created_at)}</td><td>{opsDate(q.paid_at||q.approved_at,'—')}</td></tr>)}{quotes.length===0&&<tr><td colspan="5" class="ops-empty">Sin cotizaciones.</td></tr>}</tbody></table></div></section>
  <div class="ops-grid-2 ops-section"><section><header class="ops-section-header"><div><h2>Clientes</h2><p>{clients.length} recientes.</p></div></header><div class="ops-card ops-list">{clients.map((c:any)=><div class="ops-list-row"><strong>{c.empresa}</strong><span>{c.contacto||c.email||'Sin contacto'}</span><span>{opsDate(c.created_at)}</span></div>)}{clients.length===0&&<div class="ops-empty">Sin clientes.</div>}</div></section><section><header class="ops-section-header"><div><h2>Productos</h2><p>{products.length} recientes.</p></div></header><div class="ops-card ops-list">{products.map((p:any)=><div class="ops-list-row"><strong>{p.nombre}</strong><span>{p.sku||'Sin SKU'}</span><span class:list={['ops-badge',p.activo?'green':'']}>{p.activo?'Activo':'Inactivo'}</span></div>)}{products.length===0&&<div class="ops-empty">Sin productos.</div>}</div></section></div>
  <div class="ops-grid-3 ops-section"><section><header class="ops-section-header"><div><h2>API keys</h2><p>{opsNumber(org.api_key_count)} llaves; últimas 50.</p></div></header><div class="ops-card ops-list">{keys.map((k:any)=><div class="ops-list-row"><strong>{k.nombre}</strong><span class="ops-code">{k.prefix}…{k.last4}</span><span class:list={['ops-badge',k.revoked_at?'red':'green']}>{k.revoked_at?'Revocada':'Activa'}</span></div>)}{keys.length===0&&<div class="ops-empty">Sin llaves.</div>}</div></section><section><header class="ops-section-header"><div><h2>Webhooks</h2><p>{opsNumber(org.webhook_count)} endpoints; últimos 50.</p></div></header><div class="ops-card ops-list">{webhooks.map((w:any)=><div class="ops-list-row"><strong class="ops-data-value">{w.url}</strong><span>{w.last_status||'Sin entregas'} · {w.fallos_consecutivos||0} fallos</span><span class:list={['ops-badge',w.activo?'green':'red']}>{w.activo?'Activo':'Inactivo'}</span></div>)}{webhooks.length===0&&<div class="ops-empty">Sin webhooks.</div>}</div></section><section><header class="ops-section-header"><div><h2>SSO</h2><p>{opsNumber(org.sso_count)} conexiones; últimas 50.</p></div></header><div class="ops-card ops-list">{sso.map((s:any)=><div class="ops-list-row"><strong>{s.nombre}</strong><span>{s.proveedor}</span><span class:list={['ops-badge',s.enabled?'green':'']}>{s.enabled?'Activa':'Inactiva'}</span></div>)}{sso.length===0&&<div class="ops-empty">Sin SSO.</div>}</div></section></div>
  <section class="ops-section"><header class="ops-section-header"><div><h2>Historial administrativo</h2><p>Acciones de Ops sobre este workspace.</p></div></header><div class="ops-card">{audit.map((e:any)=><div class="ops-audit-row"><span class:list={['ops-audit-dot',e.result]}></span><div><strong>{OPS_AUDIT_LABELS[e.action]||e.action}</strong><span class="ops-sub">{e.actor_email||'Sistema'}</span></div><span>{e.ip||'IP no disponible'}</span><time>{opsDate(e.created_at)}</time></div>)}{audit.length===0&&<div class="ops-empty">Sin acciones administrativas.</div>}</div></section>
</OpsShell><OpsActionDialog /><style is:global>.ops-detail-links{display:flex;justify-content:space-between;gap:16px;margin-bottom:16px}.ops-detail-links a{color:#0066cc;text-decoration:none;font-size:12px}.ops-detail-links a:hover{text-decoration:underline}.ops-grid-3 .ops-list-row{grid-template-columns:1fr;gap:6px}.ops-grid-3 .ops-list-row>*{min-width:0}</style></OpsLayout>
