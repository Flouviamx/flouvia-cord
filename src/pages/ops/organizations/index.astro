---
import OpsLayout from '../../../layouts/OpsLayout.astro';
import OpsShell from '../../../components/ops/OpsShell.astro';
import OpsPagination from '../../../components/ops/OpsPagination.astro';
import { opsAgo, opsDate, opsMoney, opsNumber, opsSubscription } from '../../../lib/ops-format';
import { getOpsOrganizationsPage } from '../../../lib/ops-list-queries';
import { normalizeOpsSearch, OPS_PAGE_SIZE, parseOpsPage } from '../../../lib/ops-pagination';

if (!Astro.locals.opsOperator) return Astro.redirect('/ops/login');
const query=normalizeOpsSearch(Astro.url.searchParams.get('q'));
const page=parseOpsPage(Astro.url.searchParams.get('page'));
let organizations:any[]=[];
let total=0;
let error=false;
try{
  organizations=await getOpsOrganizationsPage(query,page);
  total=Number(organizations[0]?.total_count||0);
  if(page>1&&organizations.length===0)return Astro.redirect(`/ops/organizations${query?`?q=${encodeURIComponent(query)}`:''}`);
}catch(cause){error=true;console.error('[ops/organizations]',cause)}
import { iconInner } from '../../../lib/icons';
---
<OpsLayout title="Organizaciones | Cord Ops"><OpsShell active="organizations" title="Organizaciones" subtitle="Workspaces, actividad comercial e infraestructura conectada.">
  <form slot="actions" class="ops-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('search')}></svg><input name="q" value={query} placeholder="Buscar organización" /></form>
  <section class="ops-card ops-metrics cols-3">
    <div class="ops-metric"><span>Organizaciones</span><strong>{opsNumber(total)}</strong><small>{query ? 'Coinciden con la búsqueda' : 'Workspaces en Cord'}</small></div>
    <div class="ops-metric"><span>Activas en 7 días</span><strong>{opsNumber(organizations.filter((o) => o.events_7d > 0).length)}</strong><small>De las {opsNumber(organizations.length)} mostradas</small></div>
    <div class="ops-metric"><span>Con cobros en línea</span><strong>{opsNumber(organizations.filter((o) => o.stripe_charges_enabled).length)}</strong><small>De las {opsNumber(organizations.length)} mostradas</small></div>
  </section>
  <section class="ops-section"><div class="ops-card ops-table-wrap"><table class="ops-table"><thead><tr><th>Organización</th><th>Plan</th><th>Equipo</th><th>Datos</th><th class="num">Cierre acumulado</th><th>Actividad</th></tr></thead><tbody>{organizations.map((org)=><tr><td><div class="ops-identity"><span class="ops-avatar square">{org.nombre.charAt(0).toUpperCase()}</span><div><a href={`/ops/organizations/${org.id}`}>{org.nombre}</a><span class="ops-sub">{org.owner_email||'Sin propietario'} · {org.country_code} · alta {opsDate(org.created_at).split(',')[0]}</span></div></div></td><td><span class="ops-badge blue">{org.plan||'free'}</span><span class="ops-sub">{opsSubscription(org.subscription_status)}</span></td><td>{opsNumber(org.members)}<span class="ops-sub">miembros</span></td><td>{opsNumber(org.clients)} clientes<span class="ops-sub">{opsNumber(org.quotes)} cotizaciones · {opsNumber(org.quotes_30d)} en 30 días</span></td><td class="num">{opsMoney(org.closed_value,org.moneda)}</td><td><span title={opsDate(org.last_event)}>{opsAgo(org.last_event,'Sin actividad')}</span><span class="ops-sub">{opsNumber(org.events_7d)} eventos en 7 días</span></td></tr>)}{organizations.length===0&&<tr><td colspan="6" class="ops-empty">No se encontraron organizaciones.</td></tr>}</tbody></table></div>{!error&&<OpsPagination page={page} total={total} pageSize={OPS_PAGE_SIZE} path="/ops/organizations" search={query?`q=${encodeURIComponent(query)}`:''}/>}</section>
  {error&&<div class="ops-inline-error">No se pudieron cargar las organizaciones.</div>}
</OpsShell></OpsLayout>
