---
import OpsLayout from '../../layouts/OpsLayout.astro';
import OpsShell from '../../components/ops/OpsShell.astro';
import { sql } from '../../lib/db';
import { opsDate,opsNumber,OPS_AUDIT_LABELS } from '../../lib/ops-format';

if(!Astro.locals.opsOperator)return Astro.redirect('/ops/login');
let stats:any={}; let recentUsers:any[]=[]; let recentOrgs:any[]=[]; let audit:any[]=[]; let error=false;
try{
  const result=await Promise.all([
    sql`select (select count(*)::int from users) users,(select count(*)::int from users where suspended_at is not null) suspended,(select count(*)::int from orgs) organizations,(select count(*)::int from sessions where revoked_at is null and expires_at>now()) sessions,(select count(*)::int from cotizaciones) quotes,(select coalesce(sum(total),0) from cotizaciones where status in ('approved','paid','invoiced')) closed_value,(select count(*)::int from api_keys where revoked_at is null) api_keys,(select count(*)::int from webhooks where activo) webhooks`,
    sql`select u.id,u.email,u.first_name,u.last_name,u.created_at,u.suspended_at,(select max(last_used_at) from sessions s where s.user_id=u.id) last_seen from users u order by u.created_at desc limit 5`,
    sql`select o.id,o.nombre,o.plan,o.created_at,u.email owner_email,(select count(*)::int from cotizaciones q where q.org_id=o.id) quotes from orgs o left join users u on u.id=o.owner_id order by o.created_at desc limit 5`,
    sql`select action,result,actor_email,target_type,created_at from ops_audit_log order by created_at desc limit 8`,
  ]);stats=result[0][0]||{};recentUsers=result[1] as any[];recentOrgs=result[2] as any[];audit=result[3] as any[];
}catch(cause){error=true;console.error('[ops/overview]',cause)}
---
<OpsLayout title="Operaciones | Cord Ops"><OpsShell active="overview" title="Operaciones" subtitle="Control interno de toda la plataforma Cord.">
  <button slot="actions" id="ops-overview-refresh" class="ops-button secondary">Actualizar</button>
  {error&&<div class="ops-inline-error">No fue posible cargar la plataforma. Ninguna acción se ejecutó.</div>}
  <section class="ops-card ops-hero-card"><div style="display:flex;justify-content:space-between;gap:30px;align-items:flex-start"><div><span class="ops-kicker">Estado de plataforma</span><h2 style="margin:0;font-size:34px;letter-spacing:-.045em">Todo bajo control</h2><p style="margin:10px 0 0;color:#86868b;font-size:13px">Neon responde y el carril privilegiado está aislado.</p></div><span class="ops-badge green">Operativa</span></div></section>
  <section class="ops-card ops-metrics" style="margin-top:18px"><div class="ops-metric"><span>Usuarios</span><strong>{opsNumber(stats.users)}</strong><small>{opsNumber(stats.suspended)} suspendidos</small></div><div class="ops-metric"><span>Organizaciones</span><strong>{opsNumber(stats.organizations)}</strong><small>Workspaces totales</small></div><div class="ops-metric"><span>Sesiones</span><strong>{opsNumber(stats.sessions)}</strong><small>Vigentes en Cord</small></div><div class="ops-metric"><span>Cotizaciones</span><strong>{opsNumber(stats.quotes)}</strong><small>Registros comerciales</small></div></section>
  <section class="ops-section"><header class="ops-section-header"><div><h2>Áreas de control</h2><p>Entra directo a cada sistema.</p></div></header><div class="ops-grid-3"><a class="ops-card ops-link-card" href="/ops/users"><div><h3>Usuarios</h3><p>Identidad, sesiones y suspensión.</p></div><b>›</b></a><a class="ops-card ops-link-card" href="/ops/organizations"><div><h3>Organizaciones</h3><p>Equipo, ventas e integraciones.</p></div><b>›</b></a><a class="ops-card ops-link-card" href="/ops/usage"><div><h3>Uso y costos</h3><p>IA, API, CFDI, correo y proveedores.</p></div><b>›</b></a><a class="ops-card ops-link-card" href="/ops/database"><div><h3>Base de datos</h3><p>Todas las tablas, con secretos redactados.</p></div><b>›</b></a><a class="ops-card ops-link-card" href="/ops/security"><div><h3>Seguridad</h3><p>Sesiones privilegiadas y auditoría.</p></div><b>›</b></a><a class="ops-card ops-link-card" href="/ops/database/cotizaciones"><div><h3>Actividad comercial</h3><p>{new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN',maximumFractionDigits:0}).format(Number(stats.closed_value||0))} cerrados.</p></div><b>›</b></a></div></section>
  <div class="ops-grid-2 ops-section"><section><header class="ops-section-header"><div><h2>Usuarios recientes</h2><p>Últimas identidades registradas.</p></div><a href="/ops/users">Ver todos</a></header><div class="ops-card ops-list">{recentUsers.map((u)=><a class="ops-list-row" href={`/ops/users/${u.id}`} style="text-decoration:none"><strong>{[u.first_name,u.last_name].filter(Boolean).join(' ')||u.email}</strong><span>{u.suspended_at?'Suspendida':u.email}</span><span>{opsDate(u.last_seen,'Sin actividad')}</span></a>)}{recentUsers.length===0&&<div class="ops-empty">Sin usuarios.</div>}</div></section><section><header class="ops-section-header"><div><h2>Organizaciones recientes</h2><p>Últimos workspaces.</p></div><a href="/ops/organizations">Ver todas</a></header><div class="ops-card ops-list">{recentOrgs.map((o)=><a class="ops-list-row" href={`/ops/organizations/${o.id}`} style="text-decoration:none"><strong>{o.nombre}</strong><span>{o.owner_email||'Sin propietario'}</span><span>{o.quotes} cotizaciones</span></a>)}{recentOrgs.length===0&&<div class="ops-empty">Sin organizaciones.</div>}</div></section></div>
  <section class="ops-section"><header class="ops-section-header"><div><h2>Actividad privilegiada</h2><p>Últimos eventos de Ops.</p></div><a href="/ops/security">Auditoría completa</a></header><div class="ops-card">{audit.map((e)=><div class="ops-audit-row"><span class:list={['ops-audit-dot',e.result]}></span><div><strong>{OPS_AUDIT_LABELS[e.action]||e.action}</strong><span class="ops-sub">{e.actor_email||'Sistema'} · {e.target_type||'plataforma'}</span></div><span>{e.result}</span><time>{opsDate(e.created_at)}</time></div>)}{audit.length===0&&<div class="ops-empty">Sin eventos.</div>}</div></section>
</OpsShell><script>document.getElementById('ops-overview-refresh')?.addEventListener('click',()=>window.location.reload());</script></OpsLayout>
