---
// /app/facturas/[id] — detalle y acciones de UNA factura.
//
// Las acciones que antes no existían en ningún lado: emitir un borrador,
// enviarla al cliente, registrar un pago manual, anularla y emitir nota de
// crédito. `cancelDocument()` llevaba meses implementada en los providers sin
// que ninguna ruta la llamara; esta pantalla es la que por fin la usa.
//
// Vocabulario del resto de la app: .surface-card, .t-head/.t-row, .status-pill,
// .editorial y columna lateral sticky, igual que el detalle de cotización.
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/modal.css';
import AccessGate from '../../../components/app/AccessGate.astro';
import WhatsAppIcon from '../../../components/app/WhatsAppIcon.astro';
import { getFacturaDetalle, getMyMembership, money } from '../../../lib/queries';
import { memberCan } from '../../../lib/permissions';
import { siteOrigin } from '../../../lib/email';
import { getCountryProfile } from '../../../lib/countries';
import { currentLocale } from '../../../lib/context';
import { getInvoiceTimeline } from '../../../lib/fiscal/timeline';
import { fmtRelative } from '../../../lib/fmt-server';
import { t } from '../../../i18n/app';

export const prerender = false;

const L = currentLocale();
const ME = await getMyMembership();
const hasPerm = memberCan(ME, 'cobranza');
const f = hasPerm ? await getFacturaDetalle(Astro.params.id ?? '') : null;
if (hasPerm && !f) return Astro.redirect('/app/facturas');
// Un borrador se edita, no se contempla: su sitio es el editor.
if (f && f.estado === 'draft' && !f.invoiceNumber) {
    return Astro.redirect(`/app/facturas/nueva?draft=${f.id}`);
}

const ESTADO_META: Record<string, { label: string; color: string; bg: string }> = {
    draft: { label: t(L, 'fact.st_draft'), color: '#5b6472', bg: 'rgba(91,100,114,0.1)' },
    open: { label: t(L, 'fact.st_open'), color: '#b45309', bg: 'rgba(245,158,11,0.12)' },
    paid: { label: t(L, 'fact.st_paid'), color: '#059669', bg: 'rgba(16,185,129,0.12)' },
    void: { label: t(L, 'fact.st_void'), color: '#5b6472', bg: 'rgba(91,100,114,0.1)' },
    uncollectible: { label: t(L, 'fact.st_uncollectible'), color: '#dc2626', bg: 'rgba(239,68,68,0.1)' },
};
const meta = f?.estadoFiscal === 'error'
    ? { label: L === 'en' ? 'Issue error' : 'Error al emitir', color: '#dc2626', bg: 'rgba(239,68,68,0.1)' }
    : f?.vencida
        ? { label: L === 'en' ? 'Overdue' : 'Vencida', color: '#dc2626', bg: 'rgba(239,68,68,0.1)' }
        : f ? (ESTADO_META[f.estado] ?? ESTADO_META.open) : ESTADO_META.open;
// Vocabulario fiscal del país del documento, no un default mexicano.
const perfilPais = f ? getCountryProfile(f.pais) : null;
const taxIdLabel = perfilPais?.taxIdLabel ?? 'Tax ID';
const linkPublico = f?.publicToken ? `${siteOrigin()}/i/${f.publicToken}` : null;
const deliveryFailed = Astro.url.searchParams.get('delivery') === 'failed';

// Historia de la factura. Antes esta pantalla no la tenía: `eventos` solo
// apuntaba a cotizaciones, así que una factura independiente era un documento
// sin pasado y el vendedor no sabía si el cliente ya la había abierto.
const TIMELINE = f ? await getInvoiceTimeline(f.orgId ?? '', f.id) : [];
const EV_LABEL: Record<string, string> = {
    created: t(L, 'fact.ev.created'), issued: t(L, 'fact.ev.issued'),
    sent: t(L, 'fact.ev.sent'), viewed: t(L, 'fact.ev.viewed'),
    payment: t(L, 'fact.ev.payment'), paid: t(L, 'fact.ev.paid'),
    reminder: t(L, 'fact.ev.reminder'), void: t(L, 'fact.ev.void'),
    credit_note: t(L, 'fact.ev.credit_note'), uncollectible: t(L, 'fact.ev.uncollectible'),
};
const waLink = f && linkPublico
    ? `https://wa.me/?text=${encodeURIComponent(`${f.invoiceNumber ?? ''} · ${linkPublico}`.trim())}`
    : null;
const clienteInicial = (f?.cliente ?? '')
    .split(/\s+/).filter(Boolean).slice(0, 2).map((word) => word[0]).join('').toUpperCase() || 'SC';
const hasViewed = TIMELINE.some((event) => event.tipo === 'viewed');
const hasIssued = f?.estadoFiscal === 'issued' || (!!f?.invoiceNumber && f?.estado !== 'draft');
const stepIdx = !f ? 0
    : f.estado === 'paid' ? 4
    : hasViewed ? 3
    : f.enviada ? 2
    : hasIssued ? 1
    : 0;
const INVOICE_STEPS = L === 'en'
    ? ['Draft', 'Issued', 'Sent', 'Viewed', 'Paid']
    : ['Borrador', 'Emitida', 'Enviada', 'Vista', 'Pagada'];

// Desglose por tasa a partir de las líneas del snapshot: es la forma de que una
// factura con conceptos exentos y gravados cuadre a la vista.
const porTasa = new Map<number, { base: number; impuesto: number }>();
for (const l of f?.lineas ?? []) {
    const tasa = l.subtotal > 0 ? Math.round((l.impuesto / l.subtotal) * 10000) / 10000 : 0;
    const acc = porTasa.get(tasa) ?? { base: 0, impuesto: 0 };
    acc.base += l.subtotal; acc.impuesto += l.impuesto;
    porTasa.set(tasa, acc);
}
const tasas = [...porTasa.entries()].sort((a, b) => a[0] - b[0]).filter(([, v]) => v.impuesto > 0);

const METODOS = [
    { v: 'transferencia', l: t(L, 'fact.d_m_transferencia') },
    { v: 'efectivo', l: t(L, 'fact.d_m_efectivo') },
    { v: 'cheque', l: t(L, 'fact.d_m_cheque') },
    { v: 'otro', l: t(L, 'fact.d_m_otro') },
];
---

<AppLayout
    title={f ? `${f.invoiceNumber ?? t(L, 'fact.st_draft')} - Cord` : 'Cord'}
    page="facturas"
    heading={f?.invoiceNumber ?? t(L, 'fact.heading')}
    crumbs={[{ label: t(L, 'fact.heading'), href: '/app/facturas' }]}>

    {!hasPerm && (
        <AccessGate title={t(L, 'fact.sin_acceso_titulo')} desc={t(L, 'fact.sin_acceso_desc')} />
    )}

    {f && (
        <Fragment>
            <span slot="topbar-actions" class="status-pill" style={`color:${meta.color}; background:${meta.bg}`}>{meta.label}</span>

            <div class="fd" data-id={f.id} data-currency={f.currency ?? ''} data-link={linkPublico ?? ''}
                 data-i18n={JSON.stringify({
                     procesando: t(L, 'fact.d_procesando'),
                     error: t(L, 'fact.d_error'),
                     usaNota: t(L, 'fact.d_usa_nota'),
                     confAnular: t(L, 'fact.d_conf_anular'),
                     confIncobrable: t(L, 'fact.d_conf_incobrable'),
                     tituloAnular: L === 'en' ? 'Void invoice' : 'Anular factura',
                     tituloIncobrable: L === 'en' ? 'Mark as uncollectible' : 'Marcar como incobrable',
                     continuar: L === 'en' ? 'Continue' : 'Continuar',
                     montoInvalido: t(L, 'fact.d_monto_invalido'),
                     copiar: t(L, 'fact.d_copiar'),
                     copiado: t(L, 'fact.d_copiado'),
                     repetirOk: t(L, 'rec.repetir_ok'),
                     verRecurrentes: t(L, 'rec.ver'),
                 })}>

                <a href="/app/facturas" class="fd-back">{L === 'en' ? '← Invoices' : '← Facturas'}</a>

                {f.estadoFiscal === 'error' && (
                    <div class="fd-alert">{t(L, 'fact.d_error_fiscal')}</div>
                )}
                {deliveryFailed && (
                    <div class="fd-alert fd-alert-warn">
                        {L === 'en'
                            ? 'The invoice was issued, but the email could not be delivered. You can safely retry sending it.'
                            : 'La factura sí fue emitida, pero el correo no pudo entregarse. Puedes reintentar el envío con seguridad.'}
                    </div>
                )}
                {f.simulado && (
                    <div class="fd-sim-note" role="status">
                        <span class="fd-sim-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2.8 19h18.4L12 3Z"/><path d="M12 9v4.5"/><path d="M12 17h.01"/></svg>
                        </span>
                        <span>
                            <strong>{L === 'en' ? 'Not fiscally issued' : 'Sin timbre fiscal'}</strong>
                            <small>{L === 'en'
                                ? 'Cord generated this document in test mode because no active fiscal provider issued it. It is not valid before the tax authority.'
                                : 'Cord generó este documento en modo de prueba porque ningún proveedor fiscal activo lo timbró. No es válido ante el SAT.'}</small>
                        </span>
                    </div>
                )}

                <div class="fd-stepper" aria-label={L === 'en' ? 'Invoice progress' : 'Progreso de la factura'}>
                    {INVOICE_STEPS.map((label, index) => (
                        <div class:list={['fd-step', { done: index < stepIdx, current: index === stepIdx }]}
                             aria-current={index === stepIdx ? 'step' : undefined}>
                            <span class="fd-step-dot">{index < stepIdx ? '✓' : index + 1}</span>
                            <span class="fd-step-label">{label}</span>
                        </div>
                    ))}
                </div>

                <div class="fd-grid">
                    <main class="fd-main">
                        <section class="fd-head">
                            <div class="fd-client">
                                <div class="fd-avatar">{clienteInicial}</div>
                                <div class="fd-client-copy">
                                    <div class="fd-client-title">
                                        <h2>{f.cliente ?? (L === 'en' ? 'No client' : 'Sin cliente')}</h2>
                                        {f.vencida && <span class="fd-badge fd-badge-danger">+{f.diasVencida}d</span>}
                                        {f.notaCreditoDe && <span class="fd-badge">{t(L, 'fact.d_nota_credito')}</span>}
                                        {f.simulado && <span class="fd-badge fd-badge-test">{L === 'en' ? 'Test document' : 'Documento de prueba'}</span>}
                                        {!f.simulado && f.testMode && <span class="fd-badge fd-badge-test">{t(L, 'fact.badge_prueba')}</span>}
                                    </div>
                                    <p>
                                        {L === 'en' ? 'Issued' : 'Emitida'} {f.creado}
                                        <span>·</span>
                                        {L === 'en' ? 'Due' : 'Vence'} {f.vence ?? (L === 'en' ? 'no due date' : 'sin fecha')}
                                        <span>·</span>
                                        {f.enviada ? (L === 'en' ? 'Sent' : 'Enviada') : (L === 'en' ? 'Not sent' : 'Sin enviar')}
                                    </p>
                                    {f.folio && f.cotizacionId && (
                                        <a class="fd-origin" href={`/app/cotizaciones/${f.cotizacionId}`}>
                                            {t(L, 'fact.d_desde_cot')} {f.folio}
                                        </a>
                                    )}
                                </div>
                            </div>
                            <div class="fd-hero-total">
                                <span>{L === 'en' ? 'TOTAL' : 'TOTAL'}</span>
                                <strong class="editorial">{money(f.total)}</strong>
                                {f.saldo !== f.total && <small>{L === 'en' ? 'Balance' : 'Saldo'} {money(f.saldo)}</small>}
                            </div>
                        </section>

                        <section class="fd-items">
                            <div class="fd-section-head"><h2>{L === 'en' ? 'Details' : 'Detalle'}</h2></div>
                            <div class="fd-items-head">
                                <span>{t(L, 'fact.d_concepto')}</span>
                                <span>{t(L, 'fact.d_cant')}</span>
                                <span>{t(L, 'fact.d_precio')}</span>
                                <span>{t(L, 'fact.d_importe')}</span>
                            </div>
                            {f.lineas.map((linea) => (
                                <div class="fd-item-row">
                                    <span class="fd-desc">{linea.descripcion}</span>
                                    <span class="fd-qty">{linea.cantidad}</span>
                                    <span class="editorial fd-price">{money(linea.precioUnitario)}</span>
                                    <span class="editorial fd-amount">{money(linea.subtotal)}</span>
                                </div>
                            ))}

                            <div class="fd-totals">
                                <div class="fd-tline"><span>{t(L, 'fact.d_subtotal')}</span><span class="editorial">{money(f.subtotal)}</span></div>
                                {tasas.map(([tasa, value]) => (
                                    <div class="fd-tline fd-tax"><span>{Math.round(tasa * 10000) / 100}%</span><span class="editorial">{money(value.impuesto)}</span></div>
                                ))}
                                <div class="fd-tline fd-total"><span>{t(L, 'fact.d_total')}</span><span class="editorial">{money(f.total)}</span></div>
                                {f.pagado > 0 && (
                                    <div class="fd-tline"><span>{t(L, 'fact.d_pagado')}</span><span class="editorial">−{money(f.pagado)}</span></div>
                                )}
                                <div class="fd-tline fd-due"><span>{t(L, 'fact.d_saldo')}</span><span class="editorial">{money(f.saldo)}</span></div>
                            </div>

                            {f.fxRate && f.fxRate !== 1 && f.ledgerCurrency && (
                                <p class="fd-fx">
                                    {t(L, 'fact.d_tc')}: 1 {f.currency} = {f.fxRate} {f.ledgerCurrency}
                                    {f.ledgerTotal !== null && <> · {t(L, 'fact.d_total_contable')} {f.ledgerTotal} {f.ledgerCurrency}</>}
                                </p>
                            )}
                        </section>

                        {f.pagos.length > 0 && (
                            <section class="fd-pagos">
                                <div class="fd-section-head"><h2>{t(L, 'fact.d_pagos')}</h2></div>
                                {f.pagos.map((pago) => (
                                    <div class="fd-pago">
                                        <span>{pago.cuando} · {pago.metodo}{pago.referencia ? ` · ${pago.referencia}` : ''}</span>
                                        <strong class="editorial">{money(pago.monto)}</strong>
                                    </div>
                                ))}
                            </section>
                        )}

                        {f.notas && (
                            <section class="fd-notes">
                                <div class="fd-section-head"><h2>{L === 'en' ? 'Notes' : 'Notas'}</h2></div>
                                <p>{f.notas}</p>
                            </section>
                        )}
                    </main>

                    <aside class="fd-side">
                        <section class="fd-actions">
                            <div class="fd-section-head"><h2>{L === 'en' ? 'Actions' : 'Acciones'}</h2></div>
                            {f.estadoFiscal === 'error' && f.estado === 'draft' && (
                                <button type="button" class="fd-btn fd-btn-primary" data-act="finalize">
                                    {L === 'en' ? 'Retry issuing' : 'Reintentar emisión'}
                                </button>
                            )}
                            {f.estado !== 'draft' && !f.enviada && (
                                <button type="button" class="fd-btn fd-btn-primary" data-act="send">
                                    {t(L, 'fact.d_enviar')}
                                </button>
                            )}
                            {f.estado === 'open' && f.enviada && (
                                <button type="button" class="fd-btn fd-btn-ok" data-act="payment">{t(L, 'fact.d_pago')}</button>
                            )}
                            {f.enviada && f.estado !== 'draft' && (
                                <div class="fd-delivery">
                                    <span class="fd-delivery-dot" aria-hidden="true"></span>
                                    <span class="fd-delivery-copy">
                                        <strong>{L === 'en' ? 'Sent to client' : 'Enviada al cliente'}</strong>
                                        {f.clienteEmail && <small>{f.clienteEmail}</small>}
                                    </span>
                                    <button type="button" data-act="send">{L === 'en' ? 'Resend' : 'Reenviar'}</button>
                                </div>
                            )}
                            {f.estado === 'open' && !f.enviada && (
                                <button type="button" class="fd-btn fd-btn-secondary" data-act="payment">{t(L, 'fact.d_pago')}</button>
                            )}

                            {linkPublico && (
                                <div class="fd-util-grid">
                                    <a href={linkPublico} class="fd-util" target="_blank" rel="noopener noreferrer" title={L === 'en' ? 'Open client link' : 'Abrir link del cliente'}>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                        <span>{L === 'en' ? 'Open link' : 'Abrir link'}</span>
                                    </a>
                                    <button type="button" class="fd-util" id="fdCopy" title={L === 'en' ? 'Copy client link' : 'Copiar link del cliente'}>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                        <span class="fd-util-label">{t(L, 'fact.d_copiar')}</span>
                                    </button>
                                    <a href={`/api/fiscal/documents/${f.id}/pdf`} class="fd-util" target="_blank" rel="noopener" title={t(L, 'fact.d_pdf')}>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        <span>{t(L, 'fact.d_pdf')}</span>
                                    </a>
                                    {waLink && (
                                        <a href={waLink} class="fd-util fd-util-wa" target="_blank" rel="noopener noreferrer" title={t(L, 'fact.d_wa')}>
                                            <WhatsAppIcon />
                                            <span>WhatsApp</span>
                                        </a>
                                    )}
                                </div>
                            )}

                            {f.clienteId && (
                                <button type="button" class="fd-btn fd-btn-secondary" data-act="duplicate">
                                    {L === 'en' ? 'Duplicate invoice' : 'Duplicar factura'}
                                </button>
                            )}

                            <details class="fd-more">
                                <summary>
                                    <span>{L === 'en' ? 'More actions' : 'Más acciones'}</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                                </summary>
                                <div class="fd-more-menu">
                                    {f.estado === 'open' && (
                                        <button type="button" class="fd-menu-btn" data-act="uncollectible">{t(L, 'fact.d_incobrable')}</button>
                                    )}
                                    {f.estadoFiscal === 'issued' && !f.notaCreditoDe && (
                                        <button type="button" class="fd-menu-btn" data-act="credit_note">{t(L, 'fact.d_nota_credito')}</button>
                                    )}
                                    {f.estadoFiscal === 'issued' && (
                                        <button type="button" class="fd-menu-btn" id="fdRepetir">{t(L, 'rec.repetir')}</button>
                                    )}
                                    {f.pais === 'MX' && f.fiscalId && (
                                        <a class="fd-menu-btn fd-menu-link" href={`/api/fiscal/documents/${f.id}/xml`} target="_blank" rel="noopener">{t(L, 'fact.d_xml')}</a>
                                    )}
                                    {f.estado === 'open' && f.pagado === 0 && (
                                        <button type="button" class="fd-menu-btn fd-menu-danger" data-act="void">{t(L, 'fact.d_anular')}</button>
                                    )}
                                </div>
                            </details>
                        </section>

                        <section class="fd-timeline">
                            <div class="fd-section-head"><h2>{t(L, 'fact.d_actividad')}</h2></div>
                            {TIMELINE.length === 0
                                ? <p class="fd-tl-empty">{t(L, 'fact.d_actividad_vacia')}</p>
                                : (
                                    <ol class="fd-tl-list">
                                        {TIMELINE.map((e) => (
                                            <li class={`fd-tl-item is-${e.tipo}`}>
                                                <span class="fd-tl-dot" aria-hidden="true"></span>
                                                <span class="fd-tl-body">
                                                    <strong>{EV_LABEL[e.tipo] ?? e.tipo}</strong>
                                                    {e.detalle && <span class="fd-tl-det">{e.detalle}</span>}
                                                    <time class="fd-tl-when">{fmtRelative(e.cuando)}</time>
                                                </span>
                                            </li>
                                        ))}
                                    </ol>
                                )}
                        </section>

                        <section class="fd-meta-section">
                            <div class="fd-section-head"><h2>{L === 'en' ? 'Invoice details' : 'Datos de la factura'}</h2></div>
                            <div class="fd-meta">
                                <div><span>{t(L, 'fact.d_emitida')}</span><span>{f.creado}</span></div>
                                <div><span>{t(L, 'fact.d_vence')}</span><span>{f.vence ?? (L === 'en' ? 'Not set' : 'Sin fecha')}</span></div>
                                <div><span>{t(L, 'fact.d_pais')}</span><span>{f.pais}</span></div>
                                <div><span>{t(L, 'fact.d_divisa')}</span><span>{f.currency ?? (L === 'en' ? 'Not set' : 'Sin definir')}</span></div>
                                {f.clienteEmail && <div><span>Email</span><span>{f.clienteEmail}</span></div>}
                                {f.receptor?.taxId && <div><span>{taxIdLabel}</span><span>{f.receptor.taxId}</span></div>}
                                {f.fiscalId && <div><span>{t(L, 'fact.d_folio_fiscal')}</span><span class="fd-uuid">{f.fiscalId}</span></div>}
                                {f.anuladaEn && <div><span>{t(L, 'fact.d_anulada')}</span><span>{f.anuladaEn}</span></div>}
                            </div>
                        </section>

                    </aside>
                </div>

                <p class="fd-err" id="fdErr" hidden></p>

                <dialog class="modal" id="fdPagoModal">
                    <form method="dialog">
                        <div class="m-head">
                            <h2>{t(L, 'fact.d_pago')}</h2>
                            <button type="button" class="m-close" data-close aria-label="×">&times;</button>
                        </div>
                        <div class="m-body">
                            <label class="fd-field">
                                <span>{t(L, 'fact.d_monto')} ({f.currency})</span>
                                <input type="number" id="fdMonto" min="0" step="any" value={f.saldo} />
                            </label>
                            <label class="fd-field">
                                <span>{t(L, 'fact.d_metodo')}</span>
                                <select id="fdMetodo">
                                    {METODOS.map((m) => <option value={m.v}>{m.l}</option>)}
                                </select>
                            </label>
                            <label class="fd-field">
                                <span>{t(L, 'fact.d_referencia')}</span>
                                <input type="text" id="fdRef" maxlength="120" />
                            </label>
                        </div>
                        <div class="m-foot">
                            <button type="button" class="fd-btn" data-close>{t(L, 'fact.d_cancelar')}</button>
                            <button type="button" class="fd-btn fd-btn-primary" id="fdPagoOk">{t(L, 'fact.d_registrar')}</button>
                        </div>
                    </form>
                </dialog>
            </div>
        </Fragment>
    )}
</AppLayout>

<script>
    const raiz = document.querySelector('.fd') as HTMLElement | null;
    if (raiz) {
        const id = raiz.dataset.id;
        const T = JSON.parse(raiz.dataset.i18n || '{}');
        const errEl = document.getElementById('fdErr');
        const pagoModal = document.getElementById('fdPagoModal') as HTMLDialogElement | null;

        document.getElementById('fdRepetir')?.addEventListener('click', async (ev) => {
            const btn = ev.currentTarget as HTMLButtonElement;
            btn.disabled = true;
            try {
                const res = await fetch('/api/recurrencias', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fromDocumentoId: id, cadencia: 'mensual', diaMes: 1, diasCredito: 0 }),
                });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || T.error);
                (window as any).cordToast?.(T.repetirOk, 'ok', 4000);
                location.href = '/app/facturas/recurrentes';
            } catch (err: any) {
                (window as any).cordToast?.(err.message || T.error, 'error');
                btn.disabled = false;
            }
        });

        const fallar = (msg: string) => {
            if (!errEl) return;
            errEl.textContent = msg;
            errEl.hidden = false;
            errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        };

        const llamar = async (payload: Record<string, unknown>, boton?: HTMLButtonElement) => {
            if (errEl) errEl.hidden = true;
            const etiqueta = boton?.textContent ?? '';
            if (boton) { boton.disabled = true; boton.textContent = T.procesando; }
            try {
                const res = await fetch(`/api/facturas/${id}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                const data = await res.json();
                if (!res.ok) {
                    // Anular una factura con pagos no es un error de captura: el
                    // siguiente paso correcto es la nota de crédito, y hay que
                    // decirlo en vez de dejar al usuario reintentando.
                    if (data.requires_credit_note) throw new Error(`${data.error} ${T.usaNota}`);
                    throw new Error(data.error || T.error);
                }
                if (payload.action === 'credit_note' && data.id) {
                    location.href = `/app/facturas/${data.id}`;
                    return;
                }
                if (payload.action === 'duplicate' && data.id) {
                    location.href = `/app/facturas/nueva?draft=${data.id}`;
                    return;
                }
                location.reload();
            } catch (e) {
                if (boton) { boton.disabled = false; boton.textContent = etiqueta; }
                fallar(e instanceof Error ? e.message : T.error);
            }
        };

        raiz.querySelectorAll('[data-act]').forEach((el) => {
            el.addEventListener('click', async (ev) => {
                const boton = ev.currentTarget as HTMLButtonElement;
                const act = boton.dataset.act ?? '';
                if (act === 'payment') { pagoModal?.showModal(); return; }
                if (act === 'void' && !await (window as any).cordConfirm({
                    title: T.tituloAnular, body: T.confAnular, danger: true, confirmText: T.tituloAnular,
                })) return;
                if (act === 'uncollectible' && !await (window as any).cordConfirm({
                    title: T.tituloIncobrable, body: T.confIncobrable, danger: true, confirmText: T.continuar,
                })) return;
                llamar({ action: act }, boton);
            });
        });

        pagoModal?.querySelectorAll('[data-close]').forEach((el) => {
            el.addEventListener('click', () => pagoModal.close());
        });

        document.getElementById('fdPagoOk')?.addEventListener('click', (ev) => {
            const monto = Number((document.getElementById('fdMonto') as HTMLInputElement | null)?.value ?? 0);
            if (!(monto > 0)) { fallar(T.montoInvalido); return; }
            pagoModal?.close();
            llamar({
                action: 'payment',
                monto,
                // La divisa la manda la FACTURA: registrar un pago en otra el
                // servidor lo rechaza en vez de convertirlo con una tasa
                // inventada (Regla 21).
                currency: raiz.dataset.currency || '',
                metodo: (document.getElementById('fdMetodo') as HTMLSelectElement | null)?.value,
                referencia: (document.getElementById('fdRef') as HTMLInputElement | null)?.value,
            }, ev.currentTarget as HTMLButtonElement);
        });

        document.getElementById('fdCopy')?.addEventListener('click', async (ev) => {
            const boton = ev.currentTarget as HTMLButtonElement;
            const link = raiz.dataset.link || '';
            if (!link) return;
            const label = boton.querySelector<HTMLElement>('.fd-util-label');
            const anterior = label?.textContent || T.copiar;
            try {
                await navigator.clipboard.writeText(link);
                boton.classList.add('is-copied');
                if (label) label.textContent = T.copiado;
                (window as any).cordToast?.(T.copiado, 'ok', 1800);
                setTimeout(() => {
                    boton.classList.remove('is-copied');
                    if (label) label.textContent = anterior;
                }, 1600);
            } catch {
                fallar(T.error);
            }
        });
    }
</script>


