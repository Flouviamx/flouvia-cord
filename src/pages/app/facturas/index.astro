---
// /app/facturas — la bandeja de facturas.
//
// Adopta el arquetipo "lista" del resto de la app (mismo vocabulario que
// `/app/cotizaciones`: .cot-summary, .filters, .t-head/.t-row, .status-pill,
// .editorial). La primera versión inventó sus propias clases `.fx-*` y al lado
// de Cotizaciones se notaba que era de otra mano.
//
// A diferencia de las otras listas, esta pagina por CURSOR en servidor: una
// bandeja de facturas crece sin techo y cargar todo en el SSR es una bomba de
// tiempo. Por eso los filtros son enlaces (el estado vive en la URL) y no
// botones que filtran en memoria.
//
// Crear ya no es un modal: vive en `/app/facturas/nueva`, el editor completo.
import AppLayout from '../../../layouts/AppLayout.astro';
import AccessGate from '../../../components/app/AccessGate.astro';
import PlanPaywallModal from '../../../components/app/PlanPaywallModal.astro';
import { getFacturas, getFacturasResumen, getMyMembership, money } from '../../../lib/queries';
import { memberCan, planLabel } from '../../../lib/permissions';
import { getActiveOrgId } from '../../../lib/db';
import { checkEntitlement } from '../../../lib/org-entitlements';
import { invoicingFeatureFor } from '../../../lib/fiscal/gate';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';

export const prerender = false;

const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const ME = await getMyMembership();
const hasPerm = memberCan(ME, 'cobranza');
const canCrear = memberCan(ME, 'cotizar');
const orgId = await getActiveOrgId();
const feature = await invoicingFeatureFor(orgId);
// Regla 17: el gate se evalúa aquí también, no solo en el endpoint.
const entitlementCheck = hasPerm ? await checkEntitlement(orgId, feature) : null;
const hasAccess = hasPerm && (entitlementCheck?.ok ?? false);

const url = Astro.url;
const filtros = {
    estado: url.searchParams.get('estado'),
    q: url.searchParams.get('q'),
    cursor: url.searchParams.get('cursor'),
};
const data = hasAccess ? await getFacturas(filtros) : { facturas: [], nextCursor: null };
const resumen = hasAccess ? await getFacturasResumen() : null;
const hasEnviable = data.facturas.some((f: any) =>
    f.estadoFiscal === 'issued' && !f.enviada && ['open', 'uncollectible'].includes(f.estado));

const FILTERS = [
    { key: '', label: t(L, 'fact.filter.all') },
    { key: 'draft', label: t(L, 'fact.filter.draft') },
    { key: 'open', label: t(L, 'fact.filter.open') },
    { key: 'overdue', label: t(L, 'fact.filter.overdue') },
    { key: 'paid', label: t(L, 'fact.filter.paid') },
    { key: 'void', label: t(L, 'fact.filter.void') },
];
const activo = filtros.estado ?? '';
const exportParams = new URLSearchParams();
if (filtros.estado) exportParams.set('estado', filtros.estado);
if (filtros.q) exportParams.set('q', filtros.q);
const exportHref = `/api/facturas/export${exportParams.size ? `?${exportParams.toString()}` : ''}`;

// Mismo contrato visual que STATUS_META de cotizaciones: color + fondo por
// estado, aplicados inline sobre `.status-pill`.
const ESTADO_META: Record<string, { label: string; color: string; bg: string }> = {
    draft: { label: t(L, 'fact.st_draft'), color: '#5b6472', bg: 'rgba(91,100,114,0.1)' },
    open: { label: t(L, 'fact.st_open'), color: '#b45309', bg: 'rgba(245,158,11,0.12)' },
    paid: { label: t(L, 'fact.st_paid'), color: '#059669', bg: 'rgba(16,185,129,0.12)' },
    void: { label: t(L, 'fact.st_void'), color: '#5b6472', bg: 'rgba(91,100,114,0.1)' },
    uncollectible: { label: t(L, 'fact.st_uncollectible'), color: '#dc2626', bg: 'rgba(239,68,68,0.1)' },
};

const qs = (patch: Record<string, string | null>) => {
    const p = new URLSearchParams();
    // El cursor se descarta al cambiar de filtro o búsqueda: conservarlo
    // paginaría desde un punto que ya no pertenece al nuevo conjunto.
    const base: Record<string, string | null> = { estado: filtros.estado, q: filtros.q, cursor: null, ...patch };
    for (const [k, v] of Object.entries(base)) if (v) p.set(k, String(v));
    const s = p.toString();
    return s ? `/app/facturas?${s}` : '/app/facturas';
};

const inicial = (nombre: string | null) => (nombre || '–').trim().slice(0, 2).toUpperCase();
const vacia = data.facturas.length === 0 && !filtros.estado && !filtros.q;
---

<AppLayout title="Facturas - Cord" page="facturas" heading={t(L, 'fact.heading')}>
    {hasAccess && (
        <div slot="topbar-actions" class="topbar-btns">
            <form class:list={['ph-search', { 'has-q': !!filtros.q }]} method="get" action="/app/facturas" role="search">
                {filtros.estado && <input type="hidden" name="estado" value={filtros.estado} />}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input id="searchFacturas" type="search" name="q" value={filtros.q ?? ''}
                    placeholder={t(L, 'fact.buscar')} autocomplete="off" spellcheck="false" />
                <a class="ph-search-clear" id="searchClearFac" href={qs({ q: null })} aria-label={t(L, 'fact.limpiar')}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </a>
            </form>
            <a class="fac-rec-link" href={exportHref}>{L === 'en' ? 'Export CSV' : 'Exportar CSV'}</a>
            <a class="fac-rec-link" href="/app/facturas/recurrentes">{t(L, 'rec.ver')}</a>
            {canCrear && (
                <a class="fac-new-link" href="/app/facturas/nueva">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    {L === 'en' ? 'New invoice' : 'Nueva factura'}
                </a>
            )}
        </div>
    )}

    {!hasPerm && (
        <AccessGate title={t(L, 'fact.sin_acceso_titulo')} desc={t(L, 'fact.sin_acceso_desc')} />
    )}
    {hasPerm && !hasAccess && entitlementCheck && (
        <Fragment>
            <AccessGate reason="plan"
                title={t(L, 'fact.plan_titulo')}
                desc={tf('fact.plan_desc', {
                    plan: planLabel(entitlementCheck.requiredPlan),
                    current: planLabel(entitlementCheck.plan),
                })} />
            <PlanPaywallModal
                id="facturasPlanModal"
                title={t(L, 'fact.plan_titulo')}
                desc={tf('fact.plan_desc', {
                    plan: planLabel(entitlementCheck.requiredPlan),
                    current: planLabel(entitlementCheck.plan),
                })}
                requiredPlan={entitlementCheck.requiredPlan}
                locale={L === 'en' ? 'en' : 'es'}
                returnHref="/app" />
        </Fragment>
    )}

    {hasAccess && vacia && (
        <div class="cot-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><polyline points="15 2 15 7 20 7"/><path d="M9 13h6"/><path d="M9 17h4"/></svg>
            <h3>{t(L, 'fact.empty_titulo')}</h3>
            <p>{t(L, 'fact.empty_desc')}</p>
            {canCrear && (
                <a href="/app/facturas/nueva" class="cot-empty-cta">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:15px;height:15px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    {t(L, 'fact.crear_primera')}
                </a>
            )}
        </div>
    )}

    {hasAccess && !vacia && (
        <Fragment>
            {resumen && (
                <div class="cot-summary">
                    <div class="cs-item">
                        <span class="cs-val editorial">{money(resumen.porCobrar, 0)}</span>
                        <span class="cs-lbl">{t(L, 'fact.cs_por_cobrar')}</span>
                    </div>
                    <div class:list={['cs-item', { 'cs-warn': resumen.vencido > 0 }]}>
                        <span class="cs-val editorial">{money(resumen.vencido, 0)}</span>
                        <span class="cs-lbl">
                            {t(L, 'fact.cs_vencido')}{resumen.vencidas > 0 ? ` · ${resumen.vencidas}` : ''}
                        </span>
                    </div>
                    <div class="cs-item">
                        <span class="cs-val editorial">{money(resumen.cobradoMes, 0)}</span>
                        <span class="cs-lbl">{t(L, 'fact.cs_cobrado_mes')}</span>
                    </div>
                </div>
            )}

            <div class="filters">
                {FILTERS.map((f) => (
                    <a href={qs({ estado: f.key || null })} class:list={['filter-pill', { active: activo === f.key }]}>{f.label}</a>
                ))}
            </div>

            <section class="table-card">
                <div class="t-head t-line">
                    <span class="t-check-cell">
                        <input type="checkbox" id="facCheckAll" disabled={!hasEnviable} aria-label={t(L, 'fact.bulk_sel_todas')} />
                    </span>
                    <span class="t-head-inner">
                    <span>{L === 'en' ? 'Invoice' : 'Factura'}</span>
                    <span>{t(L, 'fact.th_cliente')}</span>
                    <span>{L === 'en' ? 'Created' : 'Creada'}</span>
                    <span>{t(L, 'fact.th_vence')}</span>
                    <span class="t-right">{t(L, 'fact.th_total')}</span>
                    <span class="t-right">{t(L, 'fact.th_saldo')}</span>
                    <span>{t(L, 'fact.th_estado')}</span>
                    </span>
                </div>

                {data.facturas.map((f) => {
                    const meta = f.estadoFiscal === 'error'
                        ? { label: L === 'en' ? 'Issue error' : 'Error al emitir', color: '#dc2626', bg: 'rgba(239,68,68,0.1)' }
                        : f.vencida
                            ? { label: L === 'en' ? 'Overdue' : 'Vencida', color: '#dc2626', bg: 'rgba(239,68,68,0.1)' }
                            : (ESTADO_META[f.estado] ?? ESTADO_META.open);
                    // Un borrador se abre en el editor; una emitida, en su
                    // detalle. Mandar el borrador al detalle read-only sería
                    // cobrarle al usuario un clic extra por lo obvio.
                    const href = f.estado === 'draft' && !f.invoiceNumber
                        ? `/app/facturas/nueva?draft=${f.id}`
                        : `/app/facturas/${f.id}`;
                    // El envío masivo es para la primera entrega. Una factura
                    // ya enviada se reenvía desde su detalle, donde el usuario
                    // ve destinatario e historial antes de repetir la acción.
                    // El servidor vuelve a filtrar: la UI no autoriza (regla 17).
                    const enviable = f.estadoFiscal === 'issued' && !f.enviada && ['open', 'uncollectible'].includes(f.estado);
                    const selectionHint = f.estado === 'draft'
                        ? (L === 'en'
                            ? 'Issue this draft before selecting it for bulk delivery.'
                            : 'Emite este borrador antes de seleccionarlo para envío masivo.')
                        : f.enviada
                            ? (L === 'en'
                                ? 'This invoice was already sent. Resend it from its detail page.'
                                : 'Esta factura ya fue enviada. Reenvíala desde su detalle.')
                            : (L === 'en'
                                ? 'This invoice is not available for bulk delivery.'
                                : 'Esta factura no está disponible para envío masivo.');
                    const testDocument = f.simulado || f.testMode;
                    return (
                        <div class="t-line">
                        <span class="t-check-cell" title={enviable ? undefined : selectionHint}>
                            <input
                                type="checkbox"
                                class="t-check"
                                value={f.id}
                                disabled={!enviable}
                                aria-label={enviable ? t(L, 'fact.bulk_sel_una') : selectionHint}
                            />
                        </span>
                        <a href={href} class="t-row">
                            <span class="t-folio">
                                <strong>{f.invoiceNumber ?? (L === 'en' ? 'No number' : 'Sin folio')}</strong>
                                {!f.invoiceNumber && (
                                    <small>{L === 'en' ? 'Draft' : 'Borrador'} · BOR-{f.id.slice(0, 6).toUpperCase()}</small>
                                )}
                            </span>
                            <span class="t-client">
                                <span class="t-avatar">{inicial(f.cliente)}</span>
                                {f.cliente ?? '–'}
                            </span>
                            <span class="t-muted t-created">{f.creado}</span>
                            <span class="t-muted">
                                {f.vence ?? '–'}
                                {f.vencida && <b class="t-late">+{f.diasVencida}d</b>}
                            </span>
                            <span class="editorial t-amount t-right">{money(f.total, 0)}</span>
                            <span class="editorial t-right t-saldo">{f.saldo > 0 ? money(f.saldo, 0) : '–'}</span>
                            <span class="t-status">
                                <span class="status-pill" style={`color:${meta.color}; background:${meta.bg}`}>{meta.label}</span>
                                {(f.enviada || testDocument) && (
                                    <span class="t-status-meta">
                                        {f.enviada && <span class="t-delivery">{L === 'en' ? 'Sent' : 'Enviada'}</span>}
                                        {f.enviada && testDocument && <span class="t-status-sep" aria-hidden="true">·</span>}
                                        {testDocument && (
                                            <span class="t-test-mode" title={L === 'en'
                                                ? 'The fiscal provider did not issue this document. It is not valid before the tax authority.'
                                                : 'El proveedor fiscal no timbró este documento. No es válido ante el SAT.'}>
                                                {L === 'en' ? 'Test' : 'Prueba'}
                                            </span>
                                        )}
                                    </span>
                                )}
                            </span>
                        </a>
                        </div>
                    );
                })}

                {data.facturas.length === 0 && (
                    <div class="t-empty"><p>{t(L, 'fact.sin_filtro')}</p></div>
                )}
            </section>

            <div class="fac-bulk" id="facBulk" hidden
                 data-i18n={JSON.stringify({
                     sel: t(L, 'fact.bulk_sel'),
                     enviando: t(L, 'fact.bulk_enviando'),
                     enviar: t(L, 'fact.bulk_enviar'),
                     ok: t(L, 'fact.bulk_ok'),
                     parcial: t(L, 'fact.bulk_parcial'),
                     ninguna: t(L, 'fact.bulk_ninguna'),
                 })}>
                <span class="fac-bulk-count" id="facBulkCount"></span>
                <div class="fac-bulk-acts">
                    <button type="button" class="fac-bulk-ghost" id="facBulkClear">{t(L, 'fact.bulk_limpiar')}</button>
                    <button type="button" class="fac-bulk-send" id="facBulkSend">{t(L, 'fact.bulk_enviar')}</button>
                </div>
            </div>

            {data.nextCursor && (
                <div class="t-more">
                    <a href={qs({ cursor: data.nextCursor })}>{t(L, 'fact.cargar_mas')}</a>
                </div>
            )}
        </Fragment>
    )}
</AppLayout>

<script>
    // Envío masivo. El artículo de soporte lo describía desde antes de que
    // existiera, con una navegación inventada y sin endpoint detrás (regla 15).
    const bulk = document.getElementById('facBulk') as HTMLElement | null;
    if (bulk) {
        const T = JSON.parse(bulk.dataset.i18n || '{}');
        const checkAll = document.getElementById('facCheckAll') as HTMLInputElement | null;
        const countEl = document.getElementById('facBulkCount');
        const sendBtn = document.getElementById('facBulkSend') as HTMLButtonElement | null;
        const checks = () => Array.from(document.querySelectorAll<HTMLInputElement>('.t-check:not(:disabled)'));
        const seleccionadas = () => checks().filter((c) => c.checked);

        const refrescar = () => {
            const n = seleccionadas().length;
            bulk.hidden = n === 0;
            if (countEl) countEl.textContent = String(T.sel || '{n}').replace('{n}', String(n));
            if (checkAll) {
                const todas = checks();
                checkAll.checked = todas.length > 0 && n === todas.length;
                checkAll.indeterminate = n > 0 && n < todas.length;
            }
        };

        document.addEventListener('change', (e) => {
            const el = e.target as HTMLElement;
            if (el === checkAll) {
                checks().forEach((c) => { c.checked = !!checkAll?.checked; });
                refrescar();
            } else if (el.classList?.contains('t-check')) {
                refrescar();
            }
        });

        document.getElementById('facBulkClear')?.addEventListener('click', () => {
            checks().forEach((c) => { c.checked = false; });
            refrescar();
        });

        sendBtn?.addEventListener('click', async () => {
            const ids = seleccionadas().map((c) => c.value);
            if (!ids.length) return;
            sendBtn.disabled = true;
            sendBtn.textContent = T.enviando;
            try {
                const res = await fetch('/api/facturas/bulk', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'send', ids }),
                });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || 'Error');
                // Se dice cuántas NO salieron y por qué. Contar solo los éxitos
                // deja al vendedor creyendo que mandó 20 cuando mandó 17.
                const msg = d.enviadas === 0
                    ? T.ninguna
                    : (d.fallidas > 0
                        ? String(T.parcial).replace('{n}', String(d.enviadas)).replace('{f}', String(d.fallidas))
                        : String(T.ok).replace('{n}', String(d.enviadas)));
                (window as any).cordToast?.(msg, d.enviadas === 0 ? 'error' : 'ok', 6000);
                if (d.enviadas > 0) setTimeout(() => location.reload(), 900);
            } catch (err: any) {
                (window as any).cordToast?.(err.message || 'Error', 'error');
            } finally {
                sendBtn.disabled = false;
                sendBtn.textContent = T.enviar;
            }
        });

        refrescar();
    }
</script>

<style>
    /* Envío masivo: casilla + fila. La fila sigue siendo un <a>; la casilla vive
       fuera de él para no anidar dos elementos interactivos. */
    .t-line { display: grid; grid-template-columns: 36px minmax(0, 1fr); align-items: center; }
    /* El encabezado lleva las DOS clases, y `.t-head` más abajo declara la
       rejilla de seis columnas: sin esta regla más específica el head aplicaría
       seis columnas a dos hijos y la cabecera quedaría desalineada de sus filas. */
    .t-head.t-line { grid-template-columns: 36px minmax(0, 1fr); gap: 0; padding-left: 0; padding-right: 0; }
    .t-head.t-line .t-head-inner {
        display: grid; grid-template-columns: 140px minmax(180px, 1.6fr) 0.75fr 0.85fr 0.9fr 0.9fr 140px;
        gap: 1rem; align-items: center; padding: 0 0.75rem;
    }
    .t-line > .t-row { padding-left: 0.35rem; }
    .t-check-cell {
        --selection-fill: #0a192f;
        --selection-ink: #fff;
        display: flex; align-items: center; justify-content: center;
    }
    .t-check-cell input {
        appearance: none; -webkit-appearance: none;
        position: relative; width: 20px; height: 20px; margin: 0;
        cursor: pointer; border: 1.5px solid color-mix(in srgb, var(--color-text-muted) 42%, transparent); border-radius: 7px;
        background: var(--surface);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42), 0 1px 2px rgba(10, 25, 47, 0.05);
        transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s var(--ease-spring), box-shadow 0.18s ease;
    }
    .t-check-cell input:hover:not(:disabled) { border-color: var(--color-text-muted); }
    .t-check-cell input:checked {
        border-color: var(--selection-fill); background: var(--selection-fill);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 2px 5px rgba(10, 25, 47, 0.18);
    }
    .t-check-cell input:checked::after {
        content: ''; position: absolute; left: 6px; top: 3px;
        width: 5px; height: 9px; border: solid var(--selection-ink); border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }
    .t-check-cell input:indeterminate {
        border-color: var(--selection-fill); background: var(--selection-fill);
    }
    .t-check-cell input:indeterminate::after {
        content: ''; position: absolute; left: 4px; right: 4px; top: 8px;
        height: 2px; border-radius: 2px; background: var(--selection-ink);
    }
    .t-check-cell input:focus-visible { outline: none; box-shadow: 0 0 0 4px rgba(10, 25, 47, 0.12); }
    .t-check-cell input:active:not(:disabled) { transform: scale(0.92); }
    .t-check-cell input:disabled {
        cursor: not-allowed; opacity: 0.48; border-color: var(--color-border);
        background: var(--color-bg-soft); box-shadow: none;
    }
    :global(html[data-theme="dark"]) .t-check-cell {
        --selection-fill: #6b9bf2;
        --selection-ink: #0b1018;
    }
    :global(html[data-theme="dark"]) .t-check-cell input { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05); }
    :global(html[data-theme="dark"]) .t-check-cell input:focus-visible { box-shadow: 0 0 0 4px rgba(107, 155, 242, 0.2); }

    .fac-bulk {
        position: sticky; bottom: 1rem; z-index: 5;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        margin-top: 1.2rem; padding: 0.85rem 1.1rem;
        background: var(--surface); border: 1px solid var(--color-border); border-radius: 14px;
        box-shadow: 0 18px 40px -22px rgba(10, 25, 47, 0.45);
    }
    .fac-bulk[hidden] { display: none; }
    .fac-bulk-count { font-size: 0.85rem; font-weight: 600; color: var(--color-text); }
    .fac-bulk-acts { display: flex; gap: 0.6rem; }
    .fac-bulk-ghost, .fac-bulk-send {
        font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600;
        border-radius: 999px; padding: 9px 18px; cursor: pointer; white-space: nowrap;
    }
    .fac-bulk-ghost { color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); }
    .fac-bulk-send { color: #fff; background: var(--color-blue-deep); border: none; }
    .fac-bulk-send:disabled { opacity: 0.6; cursor: wait; }

    @media (max-width: 880px) {
        .fac-bulk { flex-direction: column; align-items: stretch; gap: 0.7rem; }
        .fac-bulk-acts { display: grid; grid-template-columns: 1fr 1fr; }
        .fac-bulk-ghost, .fac-bulk-send { min-height: 44px; }
        .t-line { grid-template-columns: 30px minmax(0, 1fr); }
    }

    /* Acceso a las recurrentes desde la bandeja. */
    .fac-rec-link, .fac-new-link {
        font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600;
