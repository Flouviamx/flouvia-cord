---
// Editor de facturas: nueva o borrador (?draft=<id>), incluido el borrador con
// folio reservado tras una emisión que falló con certeza. La página solo junta
// los datos y gatea el plan; el editor es src/components/app/DocumentEditor.astro,
// el mismo de cotizaciones.
import AppLayout from '../../../layouts/AppLayout.astro';
import DocumentEditor from '../../../components/app/DocumentEditor.astro';
import AccessGate from '../../../components/app/AccessGate.astro';
import PlanGate from '../../../components/app/PlanGate.astro';
import {
    getProductos, getClientes, getOrg, getKitsForEditor, getImpuestos,
    getFacturaDetalle, getMyMembership,
} from '../../../lib/queries';
import { memberCan } from '../../../lib/permissions';
import { getActiveOrgId } from '../../../lib/db';
import { checkEntitlement } from '../../../lib/org-entitlements';
import { documentTypeForOrg, isFiscalDocument } from '../../../lib/fiscal/document-kind';
import { invoicingFeatureFor } from '../../../lib/fiscal/gate';
import { getCountryProfile } from '../../../lib/countries';
import { buildTaxOptions, defaultTaxRate, retencionesFrom } from '../../../lib/impuestos';
import { CURRENCY_FLAG } from '../../../lib/flags';
import { listOfferedCurrencies, normalizeCurrency } from '../../../lib/currency';
import { currentLocale } from '../../../lib/context';
import { civilDay } from '../../../lib/fmt-server';
import { t, getDocumentEditorI18n } from '../../../i18n/app';
import type { EditorBoot } from '../../../lib/editor/document-editor';

export const prerender = false;

const L = currentLocale();
const T = getDocumentEditorI18n(L);
const ME = await getMyMembership();
const hasPerm = memberCan(ME, 'cotizar');
const orgId = await getActiveOrgId();
const feature = await invoicingFeatureFor(orgId);
// Regla 17: se gatea aquí igual que en el endpoint. Ocultar el editor no
// autoriza nada, pero abrirlo sin plan es prometer algo que el POST rechaza.
const entitlementCheck = hasPerm ? await checkEntitlement(orgId, feature) : null;
const hasAccess = hasPerm && (entitlementCheck?.ok ?? false);

// Una factura emitida es inmutable: se redirige a su detalle. Con folio solo se
// edita una emisión que falló con CERTEZA (no existe comprobante).
const draftId = Astro.url.searchParams.get('draft');
let draft = null;
if (hasAccess && draftId) {
    draft = await getFacturaDetalle(draftId);
    if (!draft) return Astro.redirect('/app/facturas/nueva');
    if (draft.estado !== 'draft' || draft.notaCreditoDe || (draft.invoiceNumber && !draft.corregible)) {
        return Astro.redirect(`/app/facturas/${draftId}`);
    }
}
const preselectCliente = !draft ? Astro.url.searchParams.get('cliente') : null;

const [productos, CLIENTES, ORG, kits, IMPUESTOS] = hasAccess
    ? await Promise.all([getProductos(), getClientes(), getOrg(), getKitsForEditor(), getImpuestos()])
    : [[], [], await getOrg(), [], []];

const country = String(ORG.countryCode || 'MX').toUpperCase();
const profile = getCountryProfile(country, L);
const isMx = country === 'MX';
const defaultDocumentType = draft?.tipo || (hasAccess ? await documentTypeForOrg(orgId, country) : 'proforma');
const fiscalAccess = hasAccess ? await checkEntitlement(orgId, 'cfdi') : null;
const fiscalSelected = isFiscalDocument(defaultDocumentType, country);
const selectableFiscal = !!fiscalAccess?.ok && ['MX', 'ES'].includes(country);
const documentModes = [
    { value: 'commercial', label: ['MX', 'ES'].includes(country) ? T.docProforma : T.docCommercial, selected: !fiscalSelected },
    ...(selectableFiscal || fiscalSelected
        ? [{ value: 'fiscal', label: isMx ? 'CFDI 4.0' : 'VERI*FACTU', selected: fiscalSelected, disabled: !selectableFiscal }]
        : []),
];

const orgTaxRate = Number(ORG.ivaPct) || 0;
const TAX_OPTIONS = buildTaxOptions(IMPUESTOS, { locale: L, countryCode: country, orgTaxRate });
const DEFAULT_TAX_RATE = defaultTaxRate(IMPUESTOS, orgTaxRate);
const orgCurrency = normalizeCurrency(ORG.moneda || profile.currency);
const currency = normalizeCurrency(draft?.currency || orgCurrency);
const currencyNames = new Intl.DisplayNames([L], { type: 'currency' });
const currencyOptions = listOfferedCurrencies(currency).map((code) => ({
    code, label: `${code} — ${currencyNames.of(code) || code}`, flag: CURRENCY_FLAG[code] || country,
}));

// Vencimiento: el del borrador; si no, el de los términos de la org. Es una
// fecha de calendario EN LA ZONA DEL NEGOCIO (regla 24): con el reloj del
// servidor, que corre en UTC, "contado" amanecía en mañana a partir de las
// 18:00 en México.
const DAY = 86400000;
const plusDays = (iso: string, n: number) => new Date(Date.parse(`${iso}T12:00:00Z`) + n * DAY).toISOString().slice(0, 10);
const DIAS: Record<string, number> = { contado: 0, net30: 30, net60: 60 };
const orgTerm = ORG.terminosDefault || 'contado';
const today = civilDay(new Date());
const dueDate = draft?.venceISO || plusDays(today, DIAS[orgTerm] ?? 0);
// El chip activo es el que corresponde al vencimiento guardado (o ninguno).
const dueDays = Math.round((Date.parse(`${dueDate}T12:00:00Z`) - Date.parse(`${today}T12:00:00Z`)) / DAY);
const terms = draft ? (Object.entries(DIAS).find(([, d]) => d === dueDays)?.[0] ?? '') : orgTerm;

const boot: Omit<EditorBoot, 'T'> = {
    kind: 'invoice',
    mode: draft ? 'draft' : 'new',
    orgCurrency,
    orgCountry: country,
    catalogo: (productos as any[]).filter((p) => p.activo).map((p) => ({
        id: p.id, nombre: p.nombre, sku: p.sku, unidad: p.unidad, precio: p.precio, costo: p.costo,
        preciosVolumen: p.preciosVolumen, existencias: p.existencias,
    })),
    kits: (kits as any[]).map((k) => ({
        id: k.id, nombre: k.nombre, precioCombo: k.precioCombo,
        items: k.items.map((it: any) => ({ productoId: it.productoId, descripcion: it.descripcion, cantidad: it.cantidad, precio: it.precio, unidad: it.unidad })),
    })),
    // La vista previa se arma con la marca del negocio. El logo se sirve por su
    // ruta y no se incrusta: puede ser un data URL de cientos de KB.
    brand: {
        nombre: ORG.nombre,
        logoUrl: ORG.logoUrl ? `/api/orgs/${ORG.id}/logo` : null,
        color: ORG.colorMarca,
        taxIdLabel: profile.taxIdLabel,
        taxId: ORG.rfc || null,
    },
    taxOptions: TAX_OPTIONS,
    defaultTaxRate: DEFAULT_TAX_RATE,
    // Las retenciones no se eligen por línea: son una política del negocio y
    // se restan del total del documento.
    retenciones: retencionesFrom(IMPUESTOS),
    taxLabel: profile.taxLabel,
    multiTax: TAX_OPTIONS.length > 1,
    aprobMargenMin: 0,
    doc: {
        id: draft?.id ?? null,
        folio: draft?.invoiceNumber ?? null,
        version: null,
        clienteId: draft?.clienteId ?? preselectCliente ?? null,
        reservedFolio: draft?.invoiceNumber ?? null,
        lines: (draft?.lineas ?? []).map((l) => ({
            productoId: l.productoId,
            nombre: l.descripcion,
            unidad: l.unidad,
            cantidad: l.cantidad,
            // Lo capturado si el snapshot lo trae; si no (documentos anteriores),
            // el unitario declarado sin impuesto, que reproduce el mismo total.
            lista: l.precioLista ?? l.precioUnitario,
            negociado: l.productoId ? l.precioNegociado : null,
            taxRate: l.taxRate ?? (l.subtotal > 0 ? l.impuesto / l.subtotal : DEFAULT_TAX_RATE),
        })),
    },
};

const title = draft?.invoiceNumber ? T.titleFixInvoiceTpl.replace('{folio}', draft.invoiceNumber) : draft ? T.titleEditInvoice : T.titleNewInvoice;
---

<AppLayout title={title} page="facturas" heading={title} crumbs={[{ label: T.crumbInvoices, href: '/app/facturas' }]}>
    {!hasPerm && (
        <AccessGate
            title={L === 'en' ? "You can't create invoices" : 'No puedes crear facturas'}
            desc={L === 'en' ? 'Ask an administrator for the quoting permission.' : 'Pídele a un administrador el permiso de cotizar.'} />
    )}
    {hasPerm && !hasAccess && entitlementCheck && (
        <PlanGate
            id="facturaNuevaPlanModal"
            title={t(L, 'fact.plan_titulo')}
            desc={t(L, 'fact.plan_desc')}
            requiredPlan={entitlementCheck.requiredPlan}
            locale={L === 'en' ? 'en' : 'es'}
            preview="facturas" />
    )}
    {hasAccess && (
        <DocumentEditor
            boot={boot}
            clientes={(CLIENTES as any[]).map((c) => ({ id: c.id, empresa: c.empresa, contacto: c.contacto, email: c.email, rfc: c.rfc, descuentoPct: c.descuentoPct, terminosCode: c.terminosCode }))}
            currencyOptions={currencyOptions}
            currency={currency}
            terms={terms}
            notas={draft?.notas || ''}
            ivaIncluido={draft ? !!draft.preciosConImpuesto : !!ORG.ivaIncluidoDefecto}
            taxIncludedLabel={T.taxIncludedTpl.replace('{tax}', profile.taxLabel)}
            taxIdLabel={profile.taxIdLabel}
            dueDate={dueDate}
            documentModes={documentModes}
        />
    )}
</AppLayout>
