.cia-cta { font-family: var(--font-sans); font-size: .88rem; font-weight: 600; background: var(--color-blue-deep); color: #fff; border: none; border-radius: 999px; padding: 13px 30px; cursor: pointer; box-shadow: 0 8px 22px -10px rgba(10,25,47,.5); transition: transform .35s var(--ease-spring); }
.cia-cta:hover { transform: translateY(-1px); }
