.cia-nudge-no { background: transparent; color: var(--color-text-muted); }

/* Bandeja */
.cia-kpi-click { cursor: pointer; }
.cia-inbox { display: flex; flex-direction: column; gap: 1rem; }
.cia-draft { border: 1px solid var(--color-border); border-radius: 18px; padding: 1.1rem 1.2rem; background: var(--surface); transition: opacity .25s, transform .25s var(--ease-ios); }
