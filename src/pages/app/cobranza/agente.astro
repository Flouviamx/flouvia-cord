.cia-draft-head { display: flex; align-items: center; gap: .7rem; margin-bottom: .8rem; }
.cia-draft-who { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
.cia-draft-who strong { font-size: .9rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cia-draft-who small, .cia-thread-who small { font-size: .74rem; color: var(--color-text-muted); }
.cia-draft-who a { color: var(--color-text-muted); text-decoration: none; font-family: ui-monospace, Menlo, monospace; }
