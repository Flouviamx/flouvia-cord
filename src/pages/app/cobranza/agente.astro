.cia-avatar { width: 32px; height: 32px; border-radius: 10px; background: var(--color-bg-soft); color: var(--color-text-muted); display: flex; align-items: center; justify-content: center; font-size: .78rem; font-weight: 700; flex-shrink: 0; }
.cia-tag-edit, .cia-tag-prop { margin-left: 6px; font-style: normal; font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 2px 6px; border-radius: 999px; background: var(--color-bg-soft); color: var(--color-text-muted); }
.cia-plan-card { display: flex; align-items: center; gap: .6rem; padding: .7rem .9rem; margin-bottom: .8rem; border-radius: 12px; background: rgba(10,25,47,.05); font-size: .82rem; color: var(--color-text); }
.cia-plan-card svg { width: 18px; height: 18px; flex-shrink: 0; color: var(--color-blue-deep); }
.cia-draft-text { width: 100%; font-family: var(--font-sans); font-size: .85rem; line-height: 1.65; color: var(--color-text); background: var(--color-bg-soft); border: 1px solid transparent; border-radius: 12px; padding: .9rem 1rem; resize: vertical; transition: border-color .2s, background .2s; }
.cia-draft-text:focus { outline: none; background: var(--surface); border-color: rgba(10,25,47,.15); }
.cia-draft-actions { display: flex; gap: .5rem; margin-top: .8rem; flex-wrap: wrap; }
.cia-act { font-family: var(--font-sans); font-size: .8rem; font-weight: 600; border-radius: 999px; padding: 9px 17px; cursor: pointer; border: 1px solid var(--color-border); background: var(--surface); color: var(--color-text); transition: transform .18s var(--ease-ios), background .2s, opacity .2s; }
.cia-act:hover { background: var(--color-bg-soft); }
.cia-act:active { transform: scale(.96); }
.cia-act:disabled { opacity: .55; cursor: wait; }
.cia-act-primary { background: var(--color-blue-deep); color: #fff; border-color: transparent; }
.cia-act-primary:hover { background: var(--color-blue-deep); filter: brightness(1.12); }
.cia-act-ghost { border-color: transparent; color: var(--color-text-muted); background: transparent; }
.cia-act-ghost:hover { background: var(--color-bg-soft); }
.cia-regen { display: flex; gap: .5rem; margin-top: .7rem; align-items: center; flex-wrap: wrap; }
.cia-regen[hidden] { display: none; }
.cia-regen input { flex: 1; min-width: 180px; font-family: var(--font-sans); font-size: .82rem; color: var(--color-text); background: var(--color-bg-soft); border: 1px solid transparent; border-radius: 999px; padding: 9px 15px; }
.cia-regen input:focus { outline: none; background: var(--surface); border-color: rgba(10,25,47,.15); }

/* Hilos */
.cia-threads { display: flex; flex-direction: column; }
.cia-thread { border-top: 1px solid var(--color-border); }
.cia-thread:first-child { border-top: 0; }
.cia-thread > summary { display: flex; align-items: center; gap: .7rem; padding: .85rem 0; cursor: pointer; list-style: none; }
.cia-thread > summary::-webkit-details-marker { display: none; }
.cia-thread-who { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
.cia-thread-who strong { font-size: .82rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cia-thread-monto { font-size: .85rem; }
.cia-msgs { display: flex; flex-direction: column; gap: .7rem; padding: .3rem 0 .9rem; max-height: 340px; overflow-y: auto; }
.cia-msg { max-width: 86%; padding: .7rem .9rem; border-radius: 14px; font-size: .82rem; line-height: 1.6; }
.cia-msg p { margin: .3rem 0 0; white-space: pre-wrap; }
.cia-msg-meta { font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; opacity: .65; }
.cia-msg-meta em { margin-left: 6px; font-style: normal; }
.cia-msg.is-agent { align-self: flex-start; background: var(--color-bg-soft); color: var(--color-text); border-bottom-left-radius: 4px; }
.cia-msg.is-client { align-self: flex-end; background: rgba(16,185,129,.12); color: var(--color-text); border-bottom-right-radius: 4px; }
.cia-msg.is-user { align-self: flex-end; background: var(--color-blue-deep); color: #fff; border-bottom-right-radius: 4px; }
.cia-msg.is-user .cia-msg-meta { opacity: .8; }
.cia-compose { display: flex; gap: .5rem; align-items: flex-end; padding-bottom: .9rem; }
.cia-compose textarea { flex: 1; font-family: var(--font-sans); font-size: .82rem; line-height: 1.5; color: var(--color-text); background: var(--color-bg-soft); border: 1px solid transparent; border-radius: 12px; padding: .6rem .8rem; resize: vertical; }
.cia-compose textarea:focus { outline: none; background: var(--surface); border-color: rgba(10,25,47,.15); }
.cia-nomail { padding: 0 0 .9rem; margin: 0; font-size: .78rem; color: var(--color-text-muted); }

/* En la mira / exclusiones */
.cia-motivo { font-style: normal; font-size: .7rem; font-weight: 600; color: var(--color-text-muted); background: var(--color-bg-soft); padding: 4px 9px; border-radius: 999px; white-space: nowrap; }
.cia-lastrun { margin-top: .9rem; }
.cia-excl { display: flex; flex-wrap: wrap; gap: .5rem; }
.cia-chip { display: inline-flex; align-items: center; gap: 6px; font-size: .78rem; font-weight: 500; padding: 6px 8px 6px 12px; border-radius: 999px; background: var(--color-bg-soft); color: var(--color-text); }
.cia-chip button { all: unset; cursor: pointer; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .9rem; line-height: 1; color: var(--color-text-muted); }
.cia-chip button:hover { background: rgba(10,25,47,.08); color: var(--color-text); }
.cia-warn { color: var(--color-warn); }

/* Modal de configuración */
.cia-modal .m-body { display: flex; flex-direction: column; gap: 1.3rem; }
.cia-f { display: flex; flex-direction: column; gap: .4rem; }
.cia-f > label { font-size: .62rem; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: #99a2af; }
.cia-f input[type="number"], .cia-f select, .cia-f textarea { font-family: var(--font-sans); font-size: .86rem; color: var(--color-text); background: var(--color-bg-soft); border: 1px solid transparent; border-radius: 10px; padding: 10px 12px; }
.cia-f input[type="number"]:focus, .cia-f select:focus, .cia-f textarea:focus { outline: none; background: var(--surface); border-color: rgba(10,25,47,.15); }
.cia-hint { margin: 0; font-size: .7rem; line-height: 1.5; color: var(--color-text-muted); }
.cia-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
@media (max-width: 620px) { .cia-grid2 { grid-template-columns: 1fr; } }
.cia-seg { display: flex; gap: 4px; padding: 4px; border-radius: 12px; background: var(--color-bg-soft); }
.cia-seg label { flex: 1; }
.cia-seg input { position: absolute; opacity: 0; pointer-events: none; }
.cia-seg span { display: block; text-align: center; font-size: .8rem; font-weight: 600; padding: 8px 10px; border-radius: 9px; color: var(--color-text-muted); cursor: pointer; transition: background .2s, color .2s; }
.cia-seg input:checked + span { background: var(--surface); color: var(--color-text); box-shadow: 0 1px 3px rgba(10,25,47,.1); }
.cia-seg input:focus-visible + span { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }
</style>

<script>
    const shell = document.querySelector<HTMLElement>('[data-cia-shell]');
    if (shell) {
        const T = JSON.parse(shell.dataset.t || '{}');
        const toast = (m: string, k: 'ok' | 'error' | 'info' = 'ok') => (window as any).cordToast?.(m, k);
        const confirmar = async (opts: any) => {
            const fn = (window as any).cordConfirm;
            return fn ? await fn(opts) : confirm(typeof opts === 'string' ? opts : opts.title);
        };

        async function post(url: string, body: any, method = 'POST') {
            const res = await fetch(url, {
                method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
            });
            const d = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(d.error || T.error);
            return d;
        }

        /** Actualiza el contador de la bandeja y saca el estado vacío cuando toca. */
        function syncInbox() {
            const inbox = shell!.querySelector<HTMLElement>('[data-cia-inbox]');
            if (!inbox) return;
            const n = inbox.querySelectorAll('[data-cia-draft]').length;
            const bind = shell!.querySelector<HTMLElement>('[data-cia-bind="n-pendientes"]');
            if (bind) bind.textContent = String(n);
            let empty = inbox.querySelector<HTMLElement>('[data-cia-inbox-empty]');
            if (n === 0 && !empty) {
                empty = document.createElement('p');
                empty.className = 'report-empty';
                empty.setAttribute('data-cia-inbox-empty', '');
                empty.textContent = T.bandeja_vacia;
                inbox.appendChild(empty);
            } else if (n > 0 && empty) empty.remove();
        }

        function removeDraft(card: HTMLElement) {
            card.classList.add('is-going');
            setTimeout(() => { card.remove(); syncInbox(); }, 250);
        }

        // ── Delegación única para toda la página ──
        shell.addEventListener('click', async (ev) => {
            const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-cia-act]');
            if (!btn) {
                const kpi = (ev.target as HTMLElement).closest<HTMLElement>('[data-cia-goto]');
                if (kpi) document.querySelector(`[data-widget="${kpi.dataset.ciaGoto}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                return;
            }
            const act = btn.dataset.ciaAct!;
            const card = btn.closest<HTMLElement>('[data-cia-draft]');
            const thread = btn.closest<HTMLElement>('[data-cia-thread]');

            try {
                btn.disabled = true;

                if (act === 'aprobar' && card) {
                    const id = card.dataset.ciaDraft!;
                    const ta = card.querySelector<HTMLTextAreaElement>('[data-cia-text]')!;
                    const tienePlan = !!card.querySelector('.cia-plan-card');
                    const ok = await confirmar({
                        title: T.confirmar_aprobar,
                        body: tienePlan ? T.confirmar_aprobar_plan : undefined,
                        confirmText: T.aprobar_cta, cancelText: T.cancelar,
                    });
                    if (!ok) return;
                    // Si el usuario editó el texto, se guarda ANTES de aprobar: si no,
                    // se enviaría el borrador original y su edición se perdería.
                    if (ta.value !== ta.defaultValue) await post(`/api/cobranza-ia/${id}`, { action: 'editar', mensaje: ta.value });
                    const d = await post(`/api/cobranza-ia/${id}`, { action: 'aprobar' });
                    toast(d.planActivado ? T.aprobar_plan : T.aprobar_ok, 'ok');
                    removeDraft(card);
                    return;
                }

                if (act === 'guardar' && card) {
                    const id = card.dataset.ciaDraft!;
                    const ta = card.querySelector<HTMLTextAreaElement>('[data-cia-text]')!;
                    await post(`/api/cobranza-ia/${id}`, { action: 'editar', mensaje: ta.value });
                    ta.defaultValue = ta.value;
                    btn.hidden = true;
                    toast(T.guardado, 'ok');
                    return;
                }

                if (act === 'regenerar-abrir' && card) {
                    const row = card.querySelector<HTMLElement>('[data-cia-regen]')!;
                    row.hidden = false;
                    row.querySelector<HTMLInputElement>('[data-cia-instr]')?.focus();
                    return;
                }

                if (act === 'regenerar-cerrar' && card) {
                    card.querySelector<HTMLElement>('[data-cia-regen]')!.hidden = true;
                    return;
                }

                if (act === 'regenerar' && card) {
                    const id = card.dataset.ciaDraft!;
                    const row = card.querySelector<HTMLElement>('[data-cia-regen]')!;
                    const instruccion = row.querySelector<HTMLInputElement>('[data-cia-instr]')?.value.trim() ?? '';
                    const d = await post(`/api/cobranza-ia/${id}`, { action: 'regenerar', instruccion });
                    const ta = card.querySelector<HTMLTextAreaElement>('[data-cia-text]')!;
                    ta.value = d.mensaje; ta.defaultValue = d.mensaje;
                    card.querySelector<HTMLElement>('[data-cia-act="guardar"]')!.hidden = true;
                    row.hidden = true;
                    toast(T.regenerado, 'ok');
                    return;
                }

                if (act === 'descartar' && card) {
                    const ok = await confirmar({
                        title: T.confirmar_descartar, body: T.confirmar_descartar_body,
                        danger: true, confirmText: T.confirmar_descartar, cancelText: T.cancelar,
                    });
                    if (!ok) return;
                    await post(`/api/cobranza-ia/${card.dataset.ciaDraft}`, { action: 'descartar' });
                    toast(T.descartado, 'ok');
                    removeDraft(card);
                    return;
                }

                if (act === 'excluir' && card) {
                    await post('/api/cobranza-ia/exclusiones', { cotizacion_id: card.dataset.cot });
                    await post(`/api/cobranza-ia/${card.dataset.ciaDraft}`, { action: 'descartar' });
                    toast(T.excluido, 'ok');
                    removeDraft(card);
                    return;
                }

                if (act === 'incluir') {
                    const chip = btn.closest<HTMLElement>('[data-cia-excl-id]')!;
                    await post('/api/cobranza-ia/exclusiones', { id: chip.dataset.ciaExclId }, 'DELETE');
                    chip.remove();
                    toast(T.incluido, 'ok');
                    return;
                }

                if (act === 'mensaje' && thread) {
                    const ta = thread.querySelector<HTMLTextAreaElement>('[data-cia-compose]')!;
                    const texto = ta.value.trim();
                    if (!texto) return;
                    await post('/api/cobranza-ia/mensaje', { cotizacion_id: thread.dataset.ciaThread, mensaje: texto });
                    // Append optimista: la burbuja aparece al instante, sin recargar.
                    const box = thread.querySelector<HTMLElement>('[data-cia-msgs]')!;
                    const div = document.createElement('div');
                    div.className = 'cia-msg is-user';
                    const meta = document.createElement('span');
                    meta.className = 'cia-msg-meta';
                    meta.textContent = T.enviado;
                    const p = document.createElement('p');
                    p.textContent = texto;               // textContent, nunca innerHTML
                    div.append(meta, p);
                    box.appendChild(div);
                    box.scrollTop = box.scrollHeight;
                    ta.value = '';
                    toast(T.enviado, 'ok');
                    return;
                }

                if (act === 'cfg-cancel') {
                    (document.getElementById('ciaCfg') as HTMLDialogElement | null)?.close();
                    return;
                }
            } catch (e: any) {
                toast(e.message || T.error, 'error');
            } finally {
                btn.disabled = false;
            }
        });

        // El botón "Guardar cambios" aparece solo cuando el correo se tocó.
        shell.addEventListener('input', (ev) => {
            const ta = (ev.target as HTMLElement).closest<HTMLTextAreaElement>('[data-cia-text]');
            if (!ta) return;
            const card = ta.closest<HTMLElement>('[data-cia-draft]');
            const save = card?.querySelector<HTMLElement>('[data-cia-act="guardar"]');
            if (save) save.hidden = ta.value === ta.defaultValue;
        });

        // ── Correr el agente ahora ──
        document.getElementById('ciaRunBtn')?.addEventListener('click', async (ev) => {
            const b = ev.currentTarget as HTMLButtonElement;
            const prev = b.textContent;
            b.disabled = true; b.textContent = T.corriendo;
            try {
                const d = await post('/api/cobranza-ia/run', {});
                toast(T.corrida_ok.replace('{n}', String(d.procesadas ?? 0)), 'ok');
                if ((d.procesadas ?? 0) > 0) setTimeout(() => location.reload(), 1100);
            } catch (e: any) {
                toast(e.message || T.error, 'error');
            } finally { b.disabled = false; b.textContent = prev; }
        });

        // ── Configuración ──
        const dlg = document.getElementById('ciaCfg') as HTMLDialogElement | null;
        document.getElementById('ciaCfgBtn')?.addEventListener('click', () => {
            if (!dlg) return;
            (window as any).cordWireModal?.(dlg);
            dlg.showModal();
        });
        document.getElementById('ciaCfgSave')?.addEventListener('click', async (ev) => {
            const b = ev.currentTarget as HTMLButtonElement;
            const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value;
            b.disabled = true;
            try {
                await post('/api/org', {
                    ai_cobranza_modo: (document.querySelector('input[name="ciaModo"]:checked') as HTMLInputElement | null)?.value,
                    ai_cobranza_gracia_dias: val('ciaGracia'),
                    ai_cobranza_cadencia_dias: val('ciaCadencia'),
                    ai_cobranza_plan_dias: val('ciaPlanDias'),
                    ai_cobranza_max_cuotas: val('ciaMaxCuotas'),
                    ai_cobranza_monto_min: val('ciaMontoMin'),
                    ai_cobranza_max_corrida: val('ciaMaxCorrida'),
                    ai_cobranza_tono: val('ciaTono'),
                    ai_cobranza_idioma: val('ciaIdioma'),
                    ai_cobranza_firma: (document.getElementById('ciaFirma') as HTMLTextAreaElement | null)?.value ?? '',
                }, 'PATCH');
                toast(T.guardado, 'ok');
                dlg?.close();
                setTimeout(() => location.reload(), 700);
            } catch (e: any) {
                toast(e.message || T.error, 'error');
            } finally { b.disabled = false; }
        });

        // ── Encender el agente desde el estado de arranque ──
        document.getElementById('ciaActivar')?.addEventListener('click', async (ev) => {
            const b = ev.currentTarget as HTMLButtonElement;
            b.disabled = true;
            try {
                await post('/api/org', { ai_cobranza_activa: true, ai_cobranza_modo: 'aprobacion' }, 'PATCH');
                location.reload();
            } catch (e: any) {
                toast(e.message || T.error, 'error');
                b.disabled = false;
            }
        });

        // ── Nudge: pasar a automático ──
        document.getElementById('ciaNudgeYes')?.addEventListener('click', async () => {
            try {
                await post('/api/org', { ai_cobranza_modo: 'automatico' }, 'PATCH');
                location.reload();
            } catch (e: any) { toast(e.message || T.error, 'error'); }
        });
        document.getElementById('ciaNudgeNo')?.addEventListener('click', () => {
            document.getElementById('ciaNudge')?.remove();
        });
    }
</script>
