/* Nudge para pasar a automático */
.cia-nudge { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: .9rem 1.2rem; margin-bottom: 1.1rem; border-radius: 14px; background: rgba(16,185,129,.09); font-size: .84rem; color: var(--color-text); }
