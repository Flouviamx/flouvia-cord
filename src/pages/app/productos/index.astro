---
// Productos — catálogo con precios de lista. CRUD real (Neon).
import AppLayout from '../../../layouts/AppLayout.astro';
import ProductModal from '../../../components/app/ProductModal.astro';
import { getProductos, getMyMembership, money } from '../../../lib/queries';
import { memberCan } from '../../../lib/permissions';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
import '../../../styles/modal.css';

const [PRODUCTOS, ME] = await Promise.all([getProductos(), getMyMembership()]);
const canEdit = memberCan(ME, 'productos');
const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};
const pLabel = PRODUCTOS.length === 1 ? t(L, 'prod.producto_singular') : t(L, 'prod.producto_plural');

// Margen de lista por producto (null = sin costo capturado); usado por el filtro/orden
// "Margen bajo" y por el data-margen de cada fila.
const margenOf = (p: (typeof PRODUCTOS)[number]) => (p.costo > 0 && p.precio > 0 ? ((p.precio - p.costo) / p.precio) * 100 : null);

const fCount = {
    all: PRODUCTOS.length,
    activos: PRODUCTOS.filter((p) => p.activo).length,
    inactivos: PRODUCTOS.filter((p) => !p.activo).length,
    conVolumen: PRODUCTOS.filter((p) => p.preciosVolumen.length > 0).length,
    sinCosto: PRODUCTOS.filter((p) => p.costo <= 0).length,
    margenBajo: PRODUCTOS.filter((p) => { const m = margenOf(p); return m !== null && m < 15; }).length,
};
---

<AppLayout title={t(L, 'prod.title')} page="productos" heading={t(L, 'prod.catalogo')}>
    <div slot="page-tabs" class="ph-tabs">
        <a href="/app/productos" class="ph-tab active">{t(L, 'prod.tab_catalogo')}</a>
        <a href="/app/productos/kits" class="ph-tab">{t(L, 'prod.tab_kits')}</a>
    </div>
    <div slot="topbar-actions" class="topbar-btns">
        <div class="ph-search" data-i18n-sin-resultados={t(L, 'prod.sin_resultados')} data-i18n-producto-singular={t(L, 'prod.producto_singular')} data-i18n-producto-plural={t(L, 'prod.producto_plural')} data-i18n-n-de-n={t(L, 'prod.n_de_n_productos')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="searchProductos" type="search" placeholder={t(L, 'prod.buscar_ph')} autocomplete="off" spellcheck="false" />
            <button class="ph-search-clear" id="searchClear" aria-label={t(L, 'prod.limpiar')}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        {canEdit && <button class="btn-import" id="btnImport">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            {t(L, 'prod.importar_csv')}
        </button>}
        {canEdit && <button class="btn-new" id="btnNew">{t(L, 'prod.nuevo_producto')}</button>}
    </div>

    <section class="catalogo">
        <div class="section-head">
            <h2>{t(L, 'prod.catalogo')}</h2>
            <span class="cat-count" id="catCount">{PRODUCTOS.length} {pLabel}</span>
        </div>

        <div class="lfbar">
            <div class="filters" role="group" aria-label={t(L, 'prod.catalogo')} id="lfFilters">
                <button class="filter-pill active" data-f="all">{t(L, 'prod.filter_todos')}<span class="fp-count">{fCount.all}</span></button>
                <button class="filter-pill" data-f="activos">{t(L, 'prod.filter_activos')}<span class="fp-count">{fCount.activos}</span></button>
                <button class="filter-pill" data-f="inactivos">{t(L, 'prod.filter_inactivos')}<span class="fp-count">{fCount.inactivos}</span></button>
                <button class="filter-pill" data-f="con_volumen">{t(L, 'prod.filter_con_volumen')}<span class="fp-count">{fCount.conVolumen}</span></button>
                <button class="filter-pill" data-f="sin_costo">{t(L, 'prod.filter_sin_costo')}<span class="fp-count">{fCount.sinCosto}</span></button>
                <button class="filter-pill" data-f="margen_bajo">{t(L, 'prod.filter_margen_bajo')}<span class="fp-count">{fCount.margenBajo}</span></button>
            </div>
            <label class="lf-sort">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
                <select id="lfSort">
                    <option value="nombre">{t(L, 'prod.sort_nombre')}</option>
                    <option value="sku">{t(L, 'prod.sort_sku')}</option>
                    <option value="precio_desc">{t(L, 'prod.sort_precio_desc')}</option>
                    <option value="precio_asc">{t(L, 'prod.sort_precio_asc')}</option>
                    <option value="margen">{t(L, 'prod.sort_margen')}</option>
                </select>
            </label>
        </div>

        <div class="t-head">
            <span>{t(L, 'prod.th_sku')}</span><span>{t(L, 'prod.th_producto')}</span><span>{t(L, 'prod.th_unidad')}</span><span class="t-right">{t(L, 'prod.th_precio')}</span><span>{t(L, 'prod.th_estado')}</span><span></span>
        </div>
        <div class="t-body" id="lfBody">
            {PRODUCTOS.map((p) => {
                const margen = margenOf(p);
                return (
                    <div
                        class="t-row"
                        data-id={p.id}
                        data-sku={p.sku}
                        data-nombre={p.nombre}
                        data-unidad={p.unidad}
                        data-descripcion={p.descripcion}
                        data-precio={String(p.precio)}
                        data-costo={String(p.costo)}
                        data-activo={p.activo ? '1' : ''}
                        data-volumen={JSON.stringify(p.preciosVolumen)}
                        data-has-volumen={p.preciosVolumen.length > 0 ? '1' : ''}
                        data-margen={margen === null ? '' : String(margen)}
                    >
                        <a class="t-rowlink" href={`/app/productos/${p.id}`} aria-label={p.nombre}></a>
                        <span class="t-sku" data-mobile-label={t(L, 'prod.th_sku')}>{p.sku}</span>
                        <span class="t-name">{p.nombre}</span>
                        <span class="t-muted" data-mobile-label={t(L, 'prod.th_unidad')}>{p.unidad}</span>
                        <span class="editorial t-amount t-right" data-mobile-label={t(L, 'prod.th_precio')}>{money(p.precio)}</span>
                        <span class:list={['t-state', p.activo ? 'on' : 'off']} data-mobile-label={t(L, 'prod.th_estado')}>{p.activo ? t(L, 'prod.activo') : t(L, 'prod.inactivo')}</span>
                        {canEdit
                            ? <button class="t-act" type="button" data-edit-id={p.id} aria-label={tf('prod.editar_aria', { nombre: p.nombre })}>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" fill="currentColor" fill-opacity="0.12"/><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                            </button>
                            : <span></span>}
                    </div>
                );
            })}
        </div>
        {PRODUCTOS.length === 0 && (
            <div class="t-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                <p><b>{t(L, 'prod.vacio_titulo')}</b> {t(L, 'prod.vacio_desc')}</p>
                {canEdit && (
                    <div class="t-empty-cta">
                        <button class="btn-new" id="btnNewEmpty">{t(L, 'prod.nuevo_producto')}</button>
                        <button class="btn-import" id="btnImportEmpty">{t(L, 'prod.importar_csv')}</button>
                    </div>
                )}
            </div>
        )}
    </section>

    {canEdit && <ProductModal />}

    <!-- Modal de importación CSV (solo si tiene permiso de edición) -->
    {canEdit && <dialog class="modal modal-lg" id="importModal"
        data-i18n-locale={L}
        data-i18n-ninguna={t(L, 'prod.ninguna')}
        data-i18n-columna-tpl={t(L, 'prod.columna')}
        data-i18n-elige-columna={t(L, 'prod.elige_columna_nombre')}
        data-i18n-productos-a-importar={t(L, 'prod.productos_a_importar')}
        data-i18n-filas-omitidas={t(L, 'prod.filas_omitidas')}
        data-i18n-si={t(L, 'prod.si')}
        data-i18n-no={t(L, 'prod.no')}
        data-i18n-importar-tpl={t(L, 'prod.importar_n')}
        data-i18n-importando={t(L, 'prod.importando')}
        data-i18n-no-pudo-importar={t(L, 'prod.no_pudo_importar')}
        data-i18n-archivo-vacio={t(L, 'prod.archivo_vacio')}
        data-i18n-continuar={t(L, 'prod.continuar')}
        data-i18n-field-nombre={t(L, 'prod.field_nombre')}
        data-i18n-field-sku={t(L, 'prod.field_sku')}
        data-i18n-field-unidad={t(L, 'prod.field_unidad')}
        data-i18n-field-precio={t(L, 'prod.field_precio')}
        data-i18n-field-activo={t(L, 'prod.field_activo')}
    >
        <div class="m-form">
            <div class="m-head">
                <h2 id="impTitle">{t(L, 'prod.importar_titulo')}</h2>
                <button type="button" class="m-close" id="impClose" aria-label={t(L, 'prod.cerrar')}>✕</button>
            </div>

            <div class="m-body">
                <div class="imp-steps" id="impSteps">
                    <span class="imp-stepdot active" data-s="file"><i>1</i> {t(L, 'prod.paso1')}</span>
                    <span class="imp-stepdot" data-s="map"><i>2</i> {t(L, 'prod.paso2')}</span>
                    <span class="imp-stepdot" data-s="prev"><i>3</i> {t(L, 'prod.paso3')}</span>
                </div>

                <div class="imp-step" id="impStepFile">
                    <label class="imp-drop" id="impDrop">
                        <input type="file" id="impFile" accept=".csv,text/csv" hidden />
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3-3 3 3"/></svg>
                        <b>{t(L, 'prod.drop_titulo')}</b>
                        <span>{t(L, 'prod.drop_hint')}</span>
                    </label>
                    <button type="button" class="imp-tpl" id="impTpl">{t(L, 'prod.descargar_plantilla')}</button>
                </div>

                <div class="imp-step" id="impStepMap" hidden>
                    <p class="imp-lead">{t(L, 'prod.emparejar_hint')}</p>
                    <label class="imp-check"><input type="checkbox" id="impHeader" checked /> {t(L, 'prod.primera_fila_encabezados')}</label>
                    <div class="imp-maps" id="impMaps"></div>
                </div>

                <div class="imp-step" id="impStepPrev" hidden>
                    <div class="imp-summary" id="impSummary"></div>
                    <label class="imp-check"><input type="checkbox" id="impUpsert" checked /> {t(L, 'prod.actualizar_existentes')}</label>
                    <div class="imp-prev-wrap"><table class="imp-prev"><thead id="impPrevHead"></thead><tbody id="impPrevBody"></tbody></table></div>
                </div>
            </div>

            <div class="m-foot">
                <p class="m-error" id="impError"></p>
                <div class="m-actions">
                    <button type="button" class="m-cancel" id="impBack" hidden>{t(L, 'prod.atras')}</button>
                    <span class="m-spacer"></span>
                    <button type="button" class="m-cancel" id="impCancel">{t(L, 'prod.cancelar')}</button>
                    <button type="button" class="m-save" id="impNext" disabled>{t(L, 'prod.continuar')}</button>
                </div>
            </div>
        </div>
    </dialog>}
</AppLayout>

<style>
    .btn-new {
        font-family: var(--font-sans);
        background: var(--color-blue-deep); color: #fff;
        font-size: 0.82rem; font-weight: 600; border: none; cursor: pointer;
        padding: 9px 16px; border-radius: 9px;
        box-shadow: 0 6px 18px -8px rgba(10,25,47,0.5);
        transition: transform 0.4s var(--ease-spring);
    }
    .btn-new:hover { transform: translateY(-2px); }
    .topbar-btns { display: flex; gap: 0.6rem; align-items: center; }
    .btn-import {
        font-family: var(--font-sans); display: inline-flex; align-items: center; gap: 7px;
        background: var(--color-bg-soft); color: var(--color-text);
        font-size: 0.82rem; font-weight: 600; border: 1px solid var(--color-border); cursor: pointer;
        padding: 8px 14px; border-radius: 9px; transition: border-color 0.25s, transform 0.4s var(--ease-spring);
    }
    .btn-import svg { width: 14px; height: 14px; }
    .btn-import:hover { transform: translateY(-2px); border-color: rgba(10,25,47,0.25); }

    .catalogo { margin-bottom: 2.6rem; }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.2rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--color-border); }
    .section-head h2 { font-size: 0.98rem; font-weight: 600; letter-spacing: -0.01em; text-transform: none; color: var(--color-text); margin: 0; }
    .cat-count { font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); }

    .t-head, .t-row {
        display: grid;
        grid-template-columns: 100px 1.8fr 0.8fr 1fr 110px 34px;
        gap: 1rem; align-items: center;
        padding: 0.9rem 0.75rem;
    }
    .t-head {
        font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
        color: var(--color-text-muted); border-bottom: 1px solid var(--color-border);
        padding-top: 0; padding-bottom: 0.7rem;
    }
    .t-head > span:first-child, .t-row > :first-child { padding-left: 0; }
    .t-head > span:last-child, .t-row > :last-child { padding-right: 0; }
    .t-row {
        position: relative;
        border-bottom: 1px solid var(--color-border);
        border-radius: 10px;
        transition: background 0.25s var(--ease-ios);
    }
    .t-row:hover { background: var(--color-bg-soft); }
    .t-row[hidden] { display: none !important; }
    .t-rowlink { position: absolute; inset: 0; z-index: 0; border-radius: inherit; }
    .t-row > :not(.t-rowlink) { position: relative; z-index: 1; }
    .t-row:has(.t-rowlink:focus-visible) { background: var(--color-bg-soft); outline: 2px solid var(--color-blue-deep); outline-offset: -2px; }

    .t-sku { font-size: 0.74rem; font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.4px; }
    .t-name { font-size: 0.86rem; font-weight: 600; color: var(--color-text); }
    .t-muted { font-size: 0.8rem; color: var(--color-text-muted); }
    .t-amount { font-size: 0.95rem; color: var(--color-blue-deep); }
    .t-right { text-align: right; }
    .t-state { font-size: 0.72rem; font-weight: 700; }
    .t-state.on { color: #059669; }
    .t-state.off { color: #99a2af; }
    .t-empty { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; padding: 3rem 0.6rem; font-size: 0.85rem; color: var(--color-text-muted); margin: 0; text-align: center; line-height: 1.5; }
    .t-empty svg { width: 34px; height: 34px; color: #cbd5e1; }
    .t-empty b { color: var(--color-text); font-weight: 600; }
    .t-empty-cta { display: flex; gap: 0.6rem; margin-top: 0.3rem; }

    .t-act {
        display: flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 8px; border: none; cursor: pointer;
        background: var(--surface); color: var(--color-text-muted);
        opacity: 0; transition: opacity 0.15s, background 0.15s, color 0.15s;
    }
    .t-act svg { width: 15px; height: 15px; }
    .t-row:hover .t-act, .t-act:focus-visible { opacity: 1; }
    .t-act:hover { background: var(--row-hover); color: var(--color-blue-deep); }

    @media (max-width: 880px) {
        .catalogo,
        .lfbar,
        .filters,
        .t-body {
            width: 100%;
            min-width: 0;
            max-width: 100%;
        }
        .lfbar { gap: 0.8rem; }
        .lfbar .filters {
            width: 100%;
            max-width: 100%;
            padding: 0;
            flex-wrap: wrap;
            overflow: visible;
        }
        .lf-sort {
            width: 100%;
            min-width: 0;
            min-height: 44px;
            justify-content: flex-start;
            gap: 10px;
            padding: 0 12px;
            border-radius: 12px;
            background: var(--color-bg-soft);
        }
        .lf-sort select {
            flex: 1;
            width: 100%;
            min-width: 0;
            max-width: none;
            min-height: 44px;
            text-align: right;
        }
        .t-head { display: none; }
        .t-row {
            grid-template-columns: minmax(0, 1fr) auto 44px;
            grid-template-areas:
                "name name action"
                "sku price price"
                "unit state state";
            gap: 0.45rem 0.75rem;
            align-items: center;
            padding: 1rem 0;
            border-radius: 0;
            width: 100%;
            min-width: 0;
            max-width: 100%;
        }
        .t-name { grid-area: name; min-width: 0; overflow-wrap: anywhere; }
        .t-sku { grid-area: sku; display: block; }
        .t-amount { grid-area: price; align-self: center; justify-self: end; }
        .t-muted { grid-area: unit; display: block; font-size: 0.72rem; }
        .t-state { grid-area: state; display: block; justify-self: end; }
        .t-act { grid-area: action; display: flex; width: 44px; height: 44px; opacity: 1; justify-self: end; }
        .t-row > span:last-child:empty { display: none; }
        .t-row [data-mobile-label]::before {
            content: attr(data-mobile-label) " · ";
            color: var(--color-text-muted);
            font-family: var(--font-sans);
            font-size: 0.64rem;
            font-weight: 600;
            letter-spacing: 0;
        }
        .t-empty-cta { width: 100%; flex-direction: column; }
        .t-empty-cta > button { width: 100%; min-height: 46px; }
    }
</style>
<style>
    .ph-search {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--color-surface, #f5f5f7);
        border: 1.5px solid transparent;
        border-radius: 9px;
        padding: 0 0.8rem;
        height: 36px;
        width: 240px;
        transition: width 0.22s cubic-bezier(0.4,0,0.2,1),
                    border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .ph-search:focus-within {
        width: 320px;
        border-color: var(--color-blue-deep, #0a192f);
        box-shadow: 0 0 0 3px rgba(10,25,47,0.08);
        background: #fff;
    }
    .ph-search svg { width: 15px; height: 15px; color: #999; flex-shrink: 0; transition: color 0.15s; }
    .ph-search:focus-within svg { color: var(--color-blue-deep, #0a192f); }
    .ph-search input { flex: 1; min-width: 0; border: none; background: transparent; outline: none; font-size: 0.85rem; color: var(--color-text, #111); font-family: inherit; letter-spacing: -0.01em; }
    .ph-search input::placeholder { color: #bbb; font-size: 0.85rem; }
    .ph-search-clear { display: none; background: none; border: none; cursor: pointer; padding: 2px; border-radius: 50%; color: #bbb; line-height: 1; flex-shrink: 0; transition: color 0.12s, background 0.12s; }
    .ph-search-clear svg { width: 12px; height: 12px; display: block; }
    .ph-search-clear:hover { color: var(--color-blue-deep, #0a192f); background: rgba(10,25,47,0.07); }
    @media (max-width: 880px) {
        .topbar-btns {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            width: 100%;
            min-width: 0;
            max-width: 100%;
            gap: 0.6rem;
        }
        .topbar-btns .ph-search,
        .topbar-btns .ph-search:focus-within {
            grid-column: 1 / -1;
            width: 100%;
            min-width: 0;
            max-width: 100%;
            height: 44px;
        }
        .ph-search input { font-size: 16px; }
        .ph-search-clear { width: 36px; height: 36px; align-items: center; justify-content: center; }
        .topbar-btns .btn-import,
        .topbar-btns .btn-new {
            width: 100%;
            min-width: 0;
            min-height: 44px;
            justify-content: center;
            padding-inline: 10px;
            text-align: center;
        }
    }
</style>
<style is:global>
    .search-no-results { text-align: center; padding: 3rem 1rem; color: var(--color-text-muted, #999); font-size: 0.9rem; display: none; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const canEdit = !!document.getElementById('prodModal');

        document.getElementById('btnNew')?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('prodmodal:open')));
        document.getElementById('btnNewEmpty')?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('prodmodal:open')));

        document.querySelectorAll<HTMLElement>('.t-act[data-edit-id]').forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const row = btn.closest<HTMLElement>('.t-row');
                if (row) document.dispatchEvent(new CustomEvent('prodmodal:open', { detail: { data: row.dataset } }));
            });
        });

        if (canEdit && new URLSearchParams(location.search).get('nuevo')) {
            document.dispatchEvent(new CustomEvent('prodmodal:open'));
            history.replaceState(null, '', location.pathname);
        }

        document.addEventListener('prodmodal:saved', () => location.reload());
        document.addEventListener('prodmodal:deleted', () => location.reload());
    });
</script>

<script>
    import { createMoney } from '../../../lib/money-client';
    // Importador CSV: archivo → mapeo de columnas → preview → carga masiva.
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('importModal') as HTMLDialogElement | null;
        if (!modal) return;
        const I = modal.dataset;
        const isEn = I.i18nLocale === 'en';
        const tpl = (s: string, vars: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '');
        const $ = (id: string) => document.getElementById(id)!;
        const fileInput = $('impFile') as HTMLInputElement;
        const drop = $('impDrop');
        const stepFile = $('impStepFile'), stepMap = $('impStepMap'), stepPrev = $('impStepPrev');
        const headerChk = $('impHeader') as HTMLInputElement;
        const upsertChk = $('impUpsert') as HTMLInputElement;
        const mapsEl = $('impMaps');
        const errorEl = $('impError');
        const btnNext = $('impNext') as HTMLButtonElement;
        const btnBack = $('impBack') as HTMLButtonElement;

        const FIELDS = [
            { key: 'nombre', label: I.i18nFieldNombre || 'Nombre', req: true, guess: ['nombre', 'producto', 'descripcion', 'description', 'name', 'concepto', 'articulo'] },
            { key: 'sku', label: I.i18nFieldSku || 'SKU / Clave', req: false, guess: ['sku', 'clave', 'codigo', 'code'] },
            { key: 'unidad', label: I.i18nFieldUnidad || 'Unidad', req: false, guess: ['unidad', 'unit', 'medida', 'um'] },
            { key: 'precio', label: I.i18nFieldPrecio || 'Precio de lista', req: false, guess: ['precio', 'price', 'lista', 'costo', 'importe', 'monto'] },
            { key: 'activo', label: I.i18nFieldActivo || 'Activo', req: false, guess: ['activo', 'active', 'estatus', 'status', 'estado'] },
        ];

        let grid: string[][] = [];
        let step: 'file' | 'map' | 'prev' = 'file';
        let prepared: any[] = [];

        const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
        const parseNum = (v: string) => Number(String(v ?? '').replace(/[^0-9.\-]/g, '')) || 0;
        const FALSY = new Set(['0', 'no', 'false', 'inactivo', 'inactive', 'off', '']);
        const parseBool = (v: string) => !FALSY.has(norm(v ?? ''));

        function parseCSV(text: string): string[][] {
            const first = text.split(/\r?\n/)[0] || '';
            const counts: Record<string, number> = {
                ',': (first.match(/,/g) || []).length,
                ';': (first.match(/;/g) || []).length,
                '\t': (first.match(/\t/g) || []).length,
            };
            const delim = Object.entries(counts).sort((a, b) => b[1] - a[1])[0][0] || ',';
            const rows: string[][] = []; let row: string[] = []; let field = ''; let q = false; let i = 0;
            while (i < text.length) {
                const c = text[i];
                if (q) {
                    if (c === '"') { if (text[i + 1] === '"') { field += '"'; i += 2; continue; } q = false; i++; continue; }
                    field += c; i++; continue;
                }
                if (c === '"') { q = true; i++; continue; }
                if (c === delim) { row.push(field); field = ''; i++; continue; }
                if (c === '\n') { row.push(field); rows.push(row); row = []; field = ''; i++; continue; }
                if (c === '\r') { i++; continue; }
                field += c; i++;
            }
            if (field.length || row.length) { row.push(field); rows.push(row); }
            return rows.filter(r => r.some(c => c.trim() !== ''));
        }

        const showStep = (s: 'file' | 'map' | 'prev') => {
            step = s;
            stepFile.hidden = s !== 'file';
            stepMap.hidden = s !== 'map';
            stepPrev.hidden = s !== 'prev';
            btnBack.hidden = s === 'file';
            errorEl.textContent = '';
            if (s === 'file') { btnNext.disabled = true; btnNext.textContent = I.i18nContinuar || 'Continuar'; }
            if (s === 'map') { btnNext.disabled = false; btnNext.textContent = I.i18nContinuar || 'Continuar'; }
            const order: Record<string, number> = { file: 0, map: 1, prev: 2 };
            document.querySelectorAll<HTMLElement>('#impSteps .imp-stepdot').forEach((d) => {
                const di = order[d.dataset.s || 'file']; const ci = order[s];
                d.classList.toggle('active', di === ci);
                d.classList.toggle('done', di < ci);
            });
            (window as any).cordWireModal?.(modal);
        };

        const ncols = () => grid.reduce((m, r) => Math.max(m, r.length), 0);

        function buildMaps() {
            const useHeader = headerChk.checked;
            const headers = useHeader ? (grid[0] || []) : [];
            const n = ncols();
            mapsEl.innerHTML = FIELDS.map(f => {
                let guessed = -1;
                if (useHeader) {
                    guessed = headers.findIndex(h => f.guess.some(g => norm(h).includes(g)));
                }
                const opts = [`<option value="-1">${I.i18nNinguna || '— ninguna —'}</option>`];
                for (let i = 0; i < n; i++) {
                    const label = useHeader && headers[i] ? headers[i] : tpl(I.i18nColumnaTpl || 'Columna {n}', { n: String(i + 1) });
                    opts.push(`<option value="${i}" ${i === guessed ? 'selected' : ''}>${label.replace(/</g, '&lt;')}</option>`);
                }
                return `<div class="imp-map"><label>${f.label}${f.req ? ' <span class="req">*</span>' : ''}</label><select data-field="${f.key}">${opts.join('')}</select></div>`;
            }).join('');
        }

        const readMap = () => {
            const m: Record<string, number> = {};
            mapsEl.querySelectorAll<HTMLSelectElement>('select[data-field]').forEach(s => { m[s.dataset.field!] = parseInt(s.value, 10); });
            return m;
        };

        function buildPreview() {
            const m = readMap();
            if ((m.nombre ?? -1) < 0) { errorEl.textContent = I.i18nEligeColumna || 'Elige qué columna tiene el nombre del producto.'; return false; }
            const dataRows = headerChk.checked ? grid.slice(1) : grid;
            prepared = dataRows.map(r => ({
                nombre: (r[m.nombre] ?? '').trim(),
                sku: m.sku >= 0 ? (r[m.sku] ?? '').trim() : '',
                unidad: m.unidad >= 0 ? (r[m.unidad] ?? '').trim() : '',
                precio: m.precio >= 0 ? parseNum(r[m.precio]) : 0,
                activo: m.activo >= 0 ? parseBool(r[m.activo]) : true,
            }));
            const valid = prepared.filter(p => p.nombre);
            const skipped = prepared.length - valid.length;
            const money = createMoney();

            $('impSummary').innerHTML =
                `<div><span class="is-num">${valid.length}</span><small>${I.i18nProductosAImportar || 'productos a importar'}</small></div>` +
                (skipped > 0 ? `<div><span class="is-num warn">${skipped}</span><small>${I.i18nFilasOmitidas || 'filas omitidas (sin nombre)'}</small></div>` : '');

            $('impPrevHead').innerHTML = `<tr><th>${I.i18nFieldSku || 'SKU'}</th><th>${I.i18nFieldNombre || 'Nombre'}</th><th>${I.i18nFieldUnidad || 'Unidad'}</th><th class="n">${I.i18nFieldPrecio || 'Precio'}</th><th>${I.i18nFieldActivo || 'Activo'}</th></tr>`;
            $('impPrevBody').innerHTML = prepared.slice(0, 8).map(p => {
                const bad = !p.nombre;
                return `<tr class="${bad ? 'bad' : ''}"><td>${esc(p.sku)}</td><td>${esc(p.nombre || '—')}</td><td>${esc(p.unidad || 'pieza')}</td><td class="n">${money(p.precio)}</td><td>${p.activo ? (I.i18nSi || 'Sí') : (I.i18nNo || 'No')}</td></tr>`;
            }).join('');

            btnNext.textContent = tpl(I.i18nImportarTpl || 'Importar {n} producto{s}', { n: String(valid.length), s: valid.length === 1 ? '' : 's' });
            btnNext.disabled = valid.length === 0;
            (window as any).cordWireModal?.(modal);
            return true;
        }
        const esc = (s: string) => String(s ?? '').replace(/</g, '&lt;');

        async function doImport() {
            const valid = prepared.filter(p => p.nombre);
            if (!valid.length) return;
            btnNext.disabled = true; btnNext.textContent = I.i18nImportando || 'Importando…';
            try {
                const res = await fetch('/api/productos/import', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rows: valid, upsert: upsertChk.checked }),
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || I.i18nNoPudoImportar || 'No se pudo importar');
                location.reload();
            } catch (err: any) {
                errorEl.textContent = err.message;
                btnNext.disabled = false; btnNext.textContent = tpl(I.i18nImportarTpl || 'Importar {n} producto{s}', { n: String(valid.length), s: 's' });
            }
        }

        const loadFile = (file: File) => {
            const reader = new FileReader();
            reader.onload = () => {
                grid = parseCSV(String(reader.result));
                if (!grid.length) { errorEl.textContent = I.i18nArchivoVacio || 'El archivo está vacío o no se pudo leer.'; return; }
                buildMaps();
                showStep('map');
            };
            reader.readAsText(file, 'utf-8');
        };

        document.getElementById('btnImport')?.addEventListener('click', () => { showStep('file'); modal.showModal(); (window as any).cordWireModal?.(modal); });
        document.getElementById('btnImportEmpty')?.addEventListener('click', () => { showStep('file'); modal.showModal(); (window as any).cordWireModal?.(modal); });
        $('impClose').addEventListener('click', () => modal.close());
        $('impCancel').addEventListener('click', () => modal.close());
        fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) loadFile(fileInput.files[0]); });
        headerChk.addEventListener('change', buildMaps);

        drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('drag'); });
        drop.addEventListener('dragleave', () => drop.classList.remove('drag'));
        drop.addEventListener('drop', (e) => {
            e.preventDefault(); drop.classList.remove('drag');
            const f = (e as DragEvent).dataTransfer?.files?.[0];
            if (f) loadFile(f);
        });

        btnNext.addEventListener('click', () => {
            if (step === 'map') { if (buildPreview()) showStep('prev'); }
            else if (step === 'prev') doImport();
        });
        btnBack.addEventListener('click', () => {
            if (step === 'prev') { showStep('map'); btnNext.textContent = 'Continuar'; }
            else if (step === 'map') showStep('file');
        });

        $('impTpl').addEventListener('click', () => {
            const csv = isEn
                ? 'sku,name,unit,price,active\nCEM-50,Gray cement 50kg,bag,198.00,1\nVAR-38,Rebar 3/8 x 12m,piece,189.00,1\nBLK-152,Hollow block 15x20x40,piece,16.50,1\n'
                : 'sku,nombre,unidad,precio,activo\nCEM-50,Cemento gris 50kg,saco,198.00,1\nVAR-38,Varilla 3/8 x 12m,pieza,189.00,1\nBLK-152,Block hueco 15x20x40,pieza,16.50,1\n';
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'plantilla-productos-cord.csv';
            a.click();
            URL.revokeObjectURL(a.href);
        });
    });
</script>

<script is:inline>
    (function () {
        const input = document.getElementById('searchProductos');
        const clearBtn = document.getElementById('searchClear');
        const countEl = document.getElementById('catCount');
        const body = document.getElementById('lfBody');
        if (!input || !body) return;
        const searchBox = document.querySelector('.ph-search');
        const I = searchBox ? searchBox.dataset : {};
        const tpl = function (s, vars) { return s.replace(/\{(\w+)\}/g, function (_, k) { return vars[k] != null ? vars[k] : ''; }); };

        const rows = Array.from(body.querySelectorAll('.t-row'));
        const total = rows.length;
        let noResults = document.querySelector('.search-no-results');
        if (!noResults) {
            noResults = document.createElement('div');
            noResults.className = 'search-no-results';
            noResults.textContent = I.i18nSinResultados || 'Sin resultados para esta búsqueda.';
            document.querySelector('.catalogo').appendChild(noResults);
        }

        const PRED = {
            all: function () { return true; },
            activos: function (d) { return d.activo === '1'; },
            inactivos: function (d) { return d.activo !== '1'; },
            con_volumen: function (d) { return d.hasVolumen === '1'; },
            sin_costo: function (d) { return !(Number(d.costo || 0) > 0); },
            margen_bajo: function (d) { return d.margen !== '' && Number(d.margen) < 15; },
        };
        const CMP = {
            nombre: function (a, b) { return (a.dataset.nombre || '').localeCompare(b.dataset.nombre || ''); },
            sku: function (a, b) { return (a.dataset.sku || '').localeCompare(b.dataset.sku || ''); },
            precio_desc: function (a, b) { return Number(b.dataset.precio || 0) - Number(a.dataset.precio || 0); },
            precio_asc: function (a, b) { return Number(a.dataset.precio || 0) - Number(b.dataset.precio || 0); },
            margen: function (a, b) {
                const am = a.dataset.margen === '' ? -Infinity : Number(a.dataset.margen);
                const bm = b.dataset.margen === '' ? -Infinity : Number(b.dataset.margen);
                return bm - am;
            },
        };
        const filterPills = Array.from(document.querySelectorAll('#lfFilters .filter-pill'));
        const sortSel = document.getElementById('lfSort');
        const params = new URLSearchParams(location.search);
        let activeFilter = params.get('f') && PRED[params.get('f')] ? params.get('f') : 'all';
        if (sortSel && params.get('s') && CMP[params.get('s')]) sortSel.value = params.get('s');
        filterPills.forEach(function (p) { p.classList.toggle('active', p.dataset.f === activeFilter); });

        function persist() {
            const url = new URL(location.href);
            if (activeFilter === 'all') url.searchParams.delete('f'); else url.searchParams.set('f', activeFilter);
            const s = sortSel ? sortSel.value : 'nombre';
            if (s === 'nombre') url.searchParams.delete('s'); else url.searchParams.set('s', s);
            history.replaceState(null, '', url.pathname + url.search);
        }

        function filter() {
            const q = input.value.trim().toLowerCase();
            clearBtn.style.display = q ? 'flex' : 'none';
            const pred = PRED[activeFilter] || PRED.all;
            let visible = 0;
            rows.forEach(function (row) {
                const d = row.dataset;
                const matchSearch = !q || (d.sku || '').toLowerCase().includes(q) || (d.nombre || '').toLowerCase().includes(q) || (d.unidad || '').toLowerCase().includes(q);
                const match = matchSearch && pred(d);
                row.hidden = !match;
                if (match) visible++;
            });
            const s = sortSel ? sortSel.value : 'nombre';
            const cmp = CMP[s] || CMP.nombre;
            rows.slice().sort(cmp).forEach(function (row) { body.appendChild(row); });

            noResults.style.display = visible === 0 ? 'block' : 'none';
            if (countEl) {
                const label = total === 1 ? (I.i18nProductoSingular || 'producto') : (I.i18nProductoPlural || 'productos');
                if (q || activeFilter !== 'all') countEl.textContent = tpl(I.i18nNDeN || '{visible} de {total} {productoLabel}', { visible: String(visible), total: String(total), productoLabel: label });
                else countEl.textContent = total + ' ' + label;
            }
            persist();
        }

        input.addEventListener('input', filter);
        clearBtn.addEventListener('click', function () { input.value = ''; filter(); input.focus(); });
        filterPills.forEach(function (p) {
            p.addEventListener('click', function () {
                activeFilter = p.dataset.f;
                filterPills.forEach(function (x) { x.classList.toggle('active', x === p); });
                filter();
            });
        });
        if (sortSel) sortSel.addEventListener('change', filter);
        filter();
    })();
</script>
