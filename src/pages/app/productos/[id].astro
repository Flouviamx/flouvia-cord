---
// Detalle de producto — ficha + métricas (importe cerrado, realización de precio,
// margen de lista vs. realizado, precios por volumen, quién lo compra, kits). Mismo
// patrón que clientes/[id].astro / cotizaciones/[id].astro.
import AppLayout from '../../../layouts/AppLayout.astro';
import ProductModal from '../../../components/app/ProductModal.astro';
import { getProducto, getMyMembership, STATUS_META, money } from '../../../lib/queries';
import { memberCan } from '../../../lib/permissions';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
import '../../../styles/modal.css';

const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const { id } = Astro.params;
const [p, ME] = await Promise.all([getProducto(id ?? ''), getMyMembership()]);
if (!p) return Astro.redirect('/app/productos');
const canEdit = memberCan(ME, 'productos');
const m = p.metricas;
const fmtDate = (iso: string | null) => iso ? new Intl.DateTimeFormat(L === 'en' ? 'en-US' : 'es-MX', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(iso)) : '—';
const metaBits = [p.sku, p.unidad].filter(Boolean);
---

<AppLayout title={`${p.nombre} — Cord`} page="productos" heading={p.nombre} crumbs={[{ label: tf('pdet.volver').replace('← ', ''), href: '/app/productos' }]}>
    <div slot="topbar-actions" class="dp-actions">
        {canEdit && (
            <button type="button" class="dp-btn-ghost" id="dpEdit"
                data-id={p.id} data-nombre={p.nombre} data-sku={p.sku} data-unidad={p.unidad}
                data-descripcion={p.descripcion} data-precio={String(p.precio)} data-costo={String(p.costo)}
                data-activo={p.activo ? '1' : ''} data-volumen={JSON.stringify(p.preciosVolumen)}
            >{t(L, 'pdet.editar')}</button>
        )}
        <a class="dp-btn-primary" href="/app/cotizaciones/nueva">{t(L, 'pdet.cotizar')}</a>
    </div>

    <div class="detail-grid">
        <div class="d-main">
            <section class="d-head">
                <div class="dh-client">
                    <div class:list={['dh-avatar-p', { off: !p.activo }]}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" fill="currentColor" fill-opacity="0.14"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/></svg>
                    </div>
                    <div class="dh-info">
                        <div class="dh-badges">
                            <span class:list={['dp-status-badge', { on: p.activo }]}>{p.activo ? t(L, 'pdet.activo_badge') : t(L, 'pdet.inactivo_badge')}</span>
                            {p.preciosVolumen.length > 0 && <span class="dp-vol-badge">{t(L, 'prod.filter_con_volumen')}</span>}
                        </div>
                        <p class="dh-meta">{metaBits.length > 0 ? metaBits.join(' · ') : p.nombre}</p>
                    </div>
                </div>
                <div class="dh-total">
                    <span class="dh-total-label">{t(L, 'pdet.kpi_importe_cerrado')}</span>
                    <span class="editorial dh-total-val">{money(m.importeCerrado, 0)}</span>
                </div>
            </section>

            {p.descripcion && <p class="dp-desc">{p.descripcion}</p>}

            <section class="dp-kpis surface-card">
                <div class="dp-kpi"><span class="dp-kpi-label">{t(L, 'pdet.kpi_cerradas')}</span><span class="editorial dp-kpi-val">{m.cerradas}</span></div>
                <div class="dp-kpi"><span class="dp-kpi-label">{t(L, 'pdet.kpi_unidades')}</span><span class="editorial dp-kpi-val">{m.cantidadVendida.toLocaleString(L === 'en' ? 'en-US' : 'es-MX')}</span></div>
                <div class="dp-kpi"><span class="dp-kpi-label">{t(L, 'pdet.kpi_veces')}</span><span class="editorial dp-kpi-val">{m.cotizaciones}</span></div>
                <div class="dp-kpi"><span class="dp-kpi-label">{t(L, 'pdet.kpi_tasa_cierre')}</span><span class="editorial dp-kpi-val">{m.tasaCierre}%</span></div>
                <div class="dp-kpi"><span class="dp-kpi-label">{t(L, 'pdet.kpi_precio_prom')}</span><span class="editorial dp-kpi-val">{money(m.precioPromedio, 0)}</span></div>
                <div class="dp-kpi"><span class="dp-kpi-label">{t(L, 'pdet.kpi_descuento')}</span><span class="editorial dp-kpi-val">{money(m.descuentoCedido, 0)}</span></div>
            </section>

            {m.importeCerrado > 0 && (
                <section class="dp-realization">
                    <div class="sec-head"><h2 class="sec-title">{t(L, 'pdet.precio_titulo')}</h2></div>
                    <div class="dp-real-row">
                        <div class="dp-real-item"><span class="dp-real-label">{t(L, 'pdet.precio_min')}</span><span class="editorial">{money(m.precioMin, 0)}</span></div>
                        <div class="dp-real-item"><span class="dp-real-label">{t(L, 'pdet.precio_prom')}</span><span class="editorial">{money(m.precioPromedio, 0)}</span></div>
                        <div class="dp-real-item"><span class="dp-real-label">{t(L, 'pdet.precio_max')}</span><span class="editorial">{money(m.precioMax, 0)}</span></div>
                        <div class="dp-real-item"><span class="dp-real-label">{t(L, 'pdet.precio_lista')}</span><span class="editorial">{money(p.precio, 0)}</span></div>
                    </div>
                </section>
            )}

            <section class="dp-volumen">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'pdet.volumen_titulo')}</h2></div>
                {p.preciosVolumen.length === 0 ? (
                    <p class="dp-empty">{t(L, 'pdet.volumen_vacio')}</p>
                ) : (
                    <div class="dp-list">
                        {p.preciosVolumen.map((v) => (
                            <div class="dp-vrow">
                                <span>{tf('pdet.volumen_desde', { n: String(v.min) })}</span>
                                <span class="editorial">{money(v.precio)}</span>
                                {p.precio > 0 && v.precio < p.precio && (
                                    <span class="dp-vsave">{tf('pdet.volumen_ahorro', { pct: String(Math.round((1 - v.precio / p.precio) * 100)) })}</span>
                                )}
                            </div>
                        ))}
                    </div>
                )}
            </section>

            <section class="dp-buyers">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'pdet.compradores_titulo')}</h2></div>
                {p.topClientes.length === 0 ? (
                    <p class="dp-empty">{t(L, 'pdet.compradores_vacio')}</p>
                ) : (
                    <div class="dp-list">
                        {p.topClientes.map((c) => (
                            <div class="dp-crow">
                                <span class="dp-cname">{c.empresa}</span>
                                <span class="dp-cveces">{tf('cdet.veces', { n: String(c.veces) })}</span>
                                <span class="editorial dp-ctotal">{money(c.importe, 0)}</span>
                            </div>
                        ))}
                    </div>
                )}
            </section>

            <section class="dp-quotes">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'pdet.cotizaciones_titulo')}</h2></div>
                {p.cotizaciones.length === 0 ? (
                    <p class="dp-empty">{t(L, 'pdet.cotizaciones_vacio')}</p>
                ) : (
                    <div class="dp-list">
                        {p.cotizaciones.map((q) => {
                            const meta = STATUS_META[q.status as keyof typeof STATUS_META];
                            return (
                                <a class="dp-qrow" href={`/app/cotizaciones/${q.id}`}>
                                    <span class="dp-qfolio">{q.folio}</span>
                                    <span class="dp-qcliente">{q.cliente || t(L, 'pdet.sin_cliente')}</span>
                                    <span class="status-pill" style={`color:${meta.color};background:${meta.bg}`}>{meta.label}</span>
                                    <span class="editorial dp-qtotal">{money(q.importe)}</span>
                                    <span class="dp-qdate">{fmtDate(q.creada)}</span>
                                    <svg class="dp-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                </a>
                            );
                        })}
                    </div>
                )}
            </section>

            {p.kits.length > 0 && (
                <section class="dp-kits">
                    <div class="sec-head"><h2 class="sec-title">{t(L, 'pdet.kits_titulo')}</h2></div>
                    <div class="dp-list">
                        {p.kits.map((k) => (
                            <a class="dp-krow" href="/app/productos/kits">
                                <span>{k.nombre}</span>
                                <span class="dp-kqty">×{k.cantidad}</span>
                            </a>
                        ))}
                    </div>
                </section>
            )}
        </div>

        <aside class="d-side">
            <section class="dp-side-block">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'pdet.side_precio_titulo')}</h2></div>
                <div class="dc-kv-list">
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'pdet.precio_venta_label')}</span><span class="editorial">{money(p.precio)}</span></div>
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'pdet.costo_label')}</span><span class="editorial">{p.costo > 0 ? money(p.costo) : t(L, 'pdet.sin_costo')}</span></div>
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'pdet.margen_lista')}</span><span>{m.margenLista !== null ? `${Math.round(m.margenLista)}%` : '—'}</span></div>
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'pdet.margen_realizado')}</span><span>{m.margenRealizado !== null ? `${Math.round(m.margenRealizado)}%` : t(L, 'pdet.margen_sin_datos')}</span></div>
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'pdet.unidad_label')}</span><span>{p.unidad}</span></div>
                    {p.sku && <div class="dc-kv"><span class="dc-kv-label">{t(L, 'pdet.sku_label')}</span><span>{p.sku}</span></div>}
                </div>
            </section>

            <section class="dp-side-block">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'pdet.metadatos_titulo')}</h2></div>
                <div class="dc-kv-list">
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'pdet.alta_label')}</span><span>{fmtDate(p.createdAt)}</span></div>
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'pdet.ultima_venta_label')}</span><span>{m.ultimaVez ? fmtDate(m.ultimaVez) : t(L, 'pdet.sin_ventas')}</span></div>
                </div>
            </section>

            {canEdit && (
                <section class="dp-side-block">
                    <button type="button" class="dp-delete" id="dpDelete" data-id={p.id} data-nombre={p.nombre}
                        data-i18n-titulo={t(L, 'pdet.eliminar_titulo')} data-i18n-body={t(L, 'pdet.eliminar_body')}
                        data-i18n-eliminar={t(L, 'pdet.eliminar')} data-i18n-eliminando={t(L, 'pdet.eliminando')}
                        data-i18n-error={t(L, 'pdet.no_pudo_eliminar')}
                    >{t(L, 'pdet.eliminar')}</button>
                </section>
            )}
        </aside>
    </div>

    <!-- Modal de edición compartido — sin botón de eliminar propio (el sidebar ya trae uno). -->
    <ProductModal showDelete={false} />
</AppLayout>

<script>
    document.getElementById('dpEdit')?.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement;
        document.dispatchEvent(new CustomEvent('prodmodal:open', { detail: { data: el.dataset } }));
    });
    document.addEventListener('prodmodal:saved', () => { window.location.reload(); });

    const btnDel = document.getElementById('dpDelete');
    btnDel?.addEventListener('click', async () => {
        const I = btnDel.dataset;
        const id = I.id;
        if (!id) return;
        if (!(await (window as any).cordConfirm({ title: I.titulo, body: I.body, danger: true, confirmText: I.eliminar }))) return;
        const prev = btnDel.textContent;
        (btnDel as HTMLButtonElement).disabled = true;
        btnDel.textContent = I.eliminando || 'Eliminando…';
        try {
            const res = await fetch('/api/productos', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id }),
            });
            if (!res.ok) throw new Error((await res.json()).error || I.error);
            window.location.href = '/app/productos';
        } catch (err: any) {
            (window as any).cordToast?.(err.message || I.error, 'error');
            (btnDel as HTMLButtonElement).disabled = false;
            btnDel.textContent = prev;
        }
    });
</script>

<style>
    .detail-grid { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start; }
    .d-main { display: flex; flex-direction: column; min-width: 0; gap: 2.2rem; }
    .d-side { display: flex; flex-direction: column; gap: 2.2rem; position: sticky; top: 76px; }
    @media (max-width: 980px) {
        .detail-grid { grid-template-columns: 1fr; }
        .d-side { position: static; }
    }

    .dp-actions { display: flex; align-items: center; gap: 0.7rem; }
    .dp-status-badge { font-size: 0.66rem; font-weight: 700; padding: 4px 11px; border-radius: 100px; color: var(--color-text-muted); background: var(--color-bg-soft); }
    .dp-status-badge.on { color: var(--color-ok); background: rgba(16,185,129,0.12); }
    .dp-vol-badge { font-size: 0.66rem; font-weight: 700; padding: 4px 11px; border-radius: 100px; color: var(--color-blue-deep); background: rgba(10,25,47,0.07); }
    .dp-btn-primary, .dp-btn-ghost {
        font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600;
        border-radius: 9px; padding: 9px 16px; cursor: pointer; text-decoration: none;
        transition: transform 0.4s var(--ease-spring), box-shadow 0.3s var(--ease-ios), border-color 0.25s;
        display: inline-flex; align-items: center;
    }
    .dp-btn-primary { background: var(--color-blue-deep); color: #fff; border: none; box-shadow: 0 6px 18px -8px rgba(10,25,47,0.5); }
    .dp-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -8px rgba(10,25,47,0.55); }
    .dp-btn-primary:active { transform: translateY(-1px) scale(0.97); }
    .dp-btn-ghost { background: var(--color-bg-soft); color: var(--color-text); border: 1px solid var(--color-border); }
    .dp-btn-ghost:hover { transform: translateY(-2px); border-color: rgba(10,25,47,0.25); }
    .dp-btn-ghost:active { transform: translateY(-1px) scale(0.97); }

    /* ── Identidad: mismo patrón que cotizaciones/[id].astro y clientes/[id].astro. ── */
    .d-head { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; padding-bottom: 1.8rem; margin-bottom: 0.2rem; border-bottom: 1px solid var(--color-border); }
    .dh-client { display: flex; align-items: center; gap: 16px; min-width: 0; }
    .dh-avatar-p {
        width: 52px; height: 52px; border-radius: 15px; flex-shrink: 0;
        background: var(--color-blue-deep); color: #fff;
        display: flex; align-items: center; justify-content: center;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 8px 18px -10px rgba(10,25,47,0.55);
        transition: background 0.3s, opacity 0.3s;
    }
    .dh-avatar-p svg { width: 24px; height: 24px; }
    .dh-avatar-p.off { background: var(--color-text-muted); opacity: 0.55; }
    .dh-info { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
    .dh-badges { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .dh-meta { font-size: 0.82rem; color: var(--color-text-muted); margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dh-total { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; }
    .dh-total-label { font-size: 0.6rem; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase; color: var(--color-text-muted); opacity: 0.75; }
    .dh-total-val { font-size: 2.1rem; color: var(--color-blue-deep); line-height: 1.1; letter-spacing: -0.02em; }

    .dp-desc { font-size: 0.92rem; color: var(--color-text-muted); line-height: 1.6; margin: -0.6rem 0 0; }

    .dp-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(112px, 1fr)); gap: 0; }
    .dp-kpi { padding: 0.2rem 1rem; display: flex; flex-direction: column; gap: 0.4rem; border-left: 1px solid var(--color-border); }
    .dp-kpi:first-child { border-left: none; padding-left: 0.2rem; }
    .dp-kpi-label { font-size: 0.62rem; font-weight: 800; letter-spacing: 1.1px; text-transform: uppercase; color: var(--color-text-muted); opacity: 0.75; }
    .dp-kpi-val { font-size: 1.18rem; color: var(--color-text); letter-spacing: -0.025em; }
    @media (max-width: 640px) { .dp-kpis { grid-template-columns: repeat(2, 1fr); row-gap: 1.2rem; } .dp-kpi:nth-child(odd) { border-left: none; } }

    .dp-real-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 1rem; }
    .dp-real-item { display: flex; flex-direction: column; gap: 0.3rem; }
    .dp-real-label { font-size: 0.72rem; color: var(--color-text-muted); }
    .dp-real-item .editorial { font-size: 1rem; }

    .dp-empty { font-size: 0.85rem; color: var(--color-text-muted); padding: 1rem 0; }
    .dp-list { display: flex; flex-direction: column; }
    .dp-vrow {
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.8rem;
        padding: 0.65rem 0.6rem; margin: 0 -0.6rem; border-radius: 12px;
        border-bottom: 1px solid var(--color-border); font-size: 0.86rem; transition: background 0.2s var(--ease-ios);
    }
    .dp-vrow:hover { background: var(--color-bg-soft); }
    .dp-vrow:last-child { border-bottom: none; }
    .dp-vsave { font-size: 0.72rem; font-weight: 600; color: var(--color-ok); text-align: right; }

    .dp-crow { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 1rem; padding: 0.7rem 0.6rem; margin: 0 -0.6rem; border-radius: 12px; border-bottom: 1px solid var(--color-border); transition: background 0.2s var(--ease-ios); }
    .dp-crow:hover { background: var(--color-bg-soft); }
    .dp-crow:last-child { border-bottom: none; }
    .dp-cname { font-size: 0.86rem; color: var(--color-text); }
    .dp-cveces { font-size: 0.76rem; color: var(--color-text-muted); }
    .dp-ctotal { font-size: 0.88rem; }

    .dp-qrow {
        display: grid; grid-template-columns: 1fr 1.2fr auto auto auto 16px; align-items: center; gap: 1rem;
        padding: 0.85rem 0.6rem; margin: 0 -0.6rem; border-radius: 12px;
        border-bottom: 1px solid var(--color-border);
        text-decoration: none; color: inherit; transition: background 0.2s var(--ease-ios);
    }
    .dp-qrow:hover { background: var(--color-bg-soft); }
    .dp-qrow:last-child { border-bottom: none; }
    .dp-qfolio { font-size: 0.86rem; font-weight: 600; color: var(--color-text); }
    .dp-qcliente { font-size: 0.82rem; color: var(--color-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dp-qtotal { text-align: right; font-size: 0.9rem; }
    .dp-qdate { text-align: right; font-size: 0.78rem; color: var(--color-text-muted); }
    .dp-chevron { width: 14px; height: 14px; color: var(--color-text-muted); opacity: 0; transform: translateX(-4px); transition: opacity 0.2s var(--ease-ios), transform 0.3s var(--ease-spring); }
    .dp-qrow:hover .dp-chevron { opacity: 1; transform: translateX(0); }

    .dp-krow { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem 0.6rem; margin: 0 -0.6rem; border-radius: 12px; border-bottom: 1px solid var(--color-border); text-decoration: none; color: var(--color-text); font-size: 0.86rem; transition: background 0.2s var(--ease-ios); }
    .dp-krow:hover { background: var(--color-bg-soft); }
    .dp-krow:last-child { border-bottom: none; }
    .dp-kqty { color: var(--color-text-muted); font-size: 0.78rem; }

    .dp-side-block + .dp-side-block { border-top: 1px solid var(--color-border); padding-top: 1.4rem; margin-top: 0; }
    .dc-kv-list { display: flex; flex-direction: column; gap: 0.65rem; }
    .dc-kv { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; font-size: 0.85rem; color: var(--color-text); }
    .dc-kv-label { color: var(--color-text-muted); font-size: 0.78rem; }

    .dp-delete {
        font-family: var(--font-sans); width: 100%; font-size: 0.82rem; font-weight: 600;
        color: var(--color-danger); background: none; border: 1px solid var(--color-border);
        border-radius: 9px; padding: 9px 14px; cursor: pointer; transition: border-color 0.25s, background 0.2s;
    }
    .dp-delete:hover { border-color: var(--color-danger); background: rgba(239,68,68,0.06); }
    .dp-delete:active { transform: scale(0.98); }
    .dp-delete:disabled { opacity: 0.6; cursor: wait; }
</style>
