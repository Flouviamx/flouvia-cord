---
// Fragmentos SSR del Cord Workbench (dock de Desarrolladores, ver
// src/components/app/DevWorkbench.astro). Cada pestaña se pide bajo demanda
// vía fetch() y se inyecta con innerHTML.
//
// ⚠️ DOS REGLAS DURAS DE ESTE ARCHIVO (ambas nacieron de bugs reales):
//
// 1. NADA de <script> aquí. Astro los emite como `<script type="module" src=...>`,
//    y un módulo ES con el mismo src solo se ejecuta UNA VEZ por documento: al
//    re-inyectar una pestaña cacheada el navegador lo ignoraba y TODOS los botones
//    quedaban muertos. Todo el JS vive en el controlador único de DevWorkbench.astro,
//    que delega por `data-wb-act` sobre `.wb-body`. Este archivo es HTML puro.
//
// 2. NADA de `import '...css'` aquí. Sin layout no hay <head>, y el compilador deja
//    el único `maybeRenderHead()` dentro del primer condicional del template — la
//    respuesta salía sin ningún <link> y todo se veía sin estilo. El CSS lo carga
//    DevWorkbench.astro. Por eso además el <div class="wb-frag"> de abajo es el
//    elemento raíz INCONDICIONAL: mantiene el head-instruction en un lugar estable.
//
// Los <dialog>/modales tampoco viven aquí: están en el chasis, para que un
// `innerHTML =` no pueda arrancarlos del DOM estando abiertos.
export const prerender = false;

import { getOrg, getMyMembership, getApiKeys, getApiActivity, getWebhooks, getDevOverview, DEV_RANGES, type DevRange } from '../../../lib/queries';
import { memberCan, apiKeyLimit, webhookLimit, planLabel } from '../../../lib/permissions';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';

const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const tab = Astro.params.tab as string;
const rangeParam = Astro.url.searchParams.get('range') as DevRange | null;
const RANGE: DevRange = rangeParam && DEV_RANGES.includes(rangeParam) ? rangeParam : '14d';

const ME = await getMyMembership();
const hasAccess = memberCan(ME, 'ajustes');
if (!hasAccess) Astro.response.status = 403;

let ORG: any = null;
let KEYS: any[] = [];
let ACTIVITY: any = { total24: 0, errores24: 0, latProm: 0, recent: [] };
let WEBHOOKS: any[] = [];
let OV: any = null;
let LIMITE_KEYS = 0, ACTIVAS = 0, AT_LIMIT_KEYS = false;
let LIMITE_WH = 0, AT_LIMIT_WH = false;

if (hasAccess) {
    if (tab === 'api') {
        [ORG, KEYS, ACTIVITY] = await Promise.all([getOrg(), getApiKeys(), getApiActivity()]);
        LIMITE_KEYS = apiKeyLimit(ORG.plan_raw);
        ACTIVAS = KEYS.filter((k) => !k.revocada).length;
        AT_LIMIT_KEYS = ACTIVAS >= LIMITE_KEYS;
    } else if (tab === 'webhooks') {
        [ORG, WEBHOOKS] = await Promise.all([getOrg(), getWebhooks()]);
        LIMITE_WH = webhookLimit(ORG.plan_raw);
        AT_LIMIT_WH = WEBHOOKS.length >= LIMITE_WH;
    } else if (tab === 'registros') {
        ACTIVITY = await getApiActivity();
    } else if (tab === 'resumen') {
        // getOrg() se llamaba aquí sin usarse nunca — quitado.
        [OV, ACTIVITY, WEBHOOKS] = await Promise.all([getDevOverview(RANGE), getApiActivity(), getWebhooks()]);
    }
}

const activosWh = WEBHOOKS.filter((w) => w.activo && !w.deshabilitadoMotivo).length;
const caidos = WEBHOOKS.filter((w) => w.deshabilitadoMotivo);

// ── Aritmética de las gráficas (en el frontmatter, patrón del repo) ──
// Piso de 3% para que un bucket con tráfico >0 nunca desaparezca visualmente.
const pct = (n: number, max: number) => (n <= 0 || max <= 0 ? 0 : Math.max(3, Math.round((n / max) * 100)));
const SERIE = (OV?.serie ?? []).map((s: any) => {
    const tot = s.ok + s.err;
    return {
        ...s, tot,
        hCol: pct(tot, OV.maxSerie),
        // Dentro de la columna, los segmentos se reparten en % relativos a ella.
        hErr: tot > 0 ? Math.round((s.err / tot) * 100) : 0,
    };
});
const totalReq = (OV?.totalOk ?? 0) + (OV?.totalErr ?? 0);
const errTot = (OV?.errores.c4xx ?? 0) + (OV?.errores.c5xx ?? 0);
const nfmt = (n: number) => new Intl.NumberFormat(L === 'en' ? 'en-US' : 'es-MX').format(n);
const saludOk = caidos.length === 0 && (OV?.wh.fallidos ?? 0) === 0 && (OV?.wh.atrasados ?? 0) === 0;
---

<div class="wb-frag">

{!hasAccess && (
    <div class="wb-sinacceso">{t(L, 'wb.sin_acceso')}</div>
)}

{hasAccess && tab === 'resumen' && OV && (
    <div class="wb-ov">
        <div class="wb-ov-main">
            <div class="wb-sec-head">
                <h3 class="wb-sec-title">{t(L, 'wb.resumen.integracion')}</h3>
                <div class="wb-range" role="group" aria-label={t(L, 'wb.rango.label')}>
                    {DEV_RANGES.map((r) => (
                        <button type="button" class:list={['wb-range-btn', { active: r === RANGE }]}
                                data-wb-act="range" data-range={r}>{t(L, `wb.rango.${r}` as any)}</button>
                    ))}
                </div>
            </div>

            <div class="wb-card">
                <div class="wb-card-top">
                    <span class="wb-card-lbl">{t(L, 'wb.resumen.peticiones')}</span>
                    <span class="wb-card-big editorial">{nfmt(totalReq)}</span>
                </div>
                {totalReq === 0 ? (
                    <p class="wb-empty">{t(L, 'wb.resumen.sin_trafico')}</p>
                ) : (
                    <>
                        <div class="wb-chart">
                            {SERIE.map((s: any) => (
                                <div class="wb-chart-col" title={`${s.label} · ${s.ok} ok · ${s.err} err`}>
                                    <div class="wb-chart-bar" style={`height:${s.hCol}%`}>
                                        <span class="wb-chart-seg err" style={`height:${s.hErr}%`}></span>
                                    </div>
                                </div>
                            ))}
                        </div>
                        <div class="wb-chart-axis">
                            <span>{SERIE[0]?.label}</span>
                            <span>{SERIE[SERIE.length - 1]?.label}</span>
                        </div>
                        <div class="wb-legend">
                            <span class="wb-lg"><i class="wb-sw ok"></i>{t(L, 'wb.resumen.exito')} <b class="editorial">{nfmt(OV.totalOk)}</b></span>
                            <span class="wb-lg"><i class="wb-sw err"></i>{t(L, 'wb.resumen.error')} <b class="editorial">{nfmt(OV.totalErr)}</b></span>
                            <span class="wb-lg wb-lg-r">{t(L, 'wb.resumen.latencia_prom')} <b class="editorial">{OV.latProm}<em>ms</em></b></span>
                        </div>
                    </>
                )}
            </div>

            <div class="wb-ov-duo">
                <div class="wb-card">
                    <span class="wb-card-lbl">{t(L, 'wb.resumen.dist_errores')}</span>
                    {errTot === 0 ? (
                        <p class="wb-empty">{t(L, 'wb.resumen.sin_errores')}</p>
                    ) : (
                        <div class="wb-dist">
                            <div class="wb-dist-row">
                                <span class="wb-dist-k">4xx</span>
                                <span class="wb-dist-track"><i class="wb-dist-fill warn" style={`width:${pct(OV.errores.c4xx, errTot)}%`}></i></span>
                                <span class="wb-dist-n editorial">{nfmt(OV.errores.c4xx)}</span>
                            </div>
                            <div class="wb-dist-row">
                                <span class="wb-dist-k">5xx</span>
                                <span class="wb-dist-track"><i class="wb-dist-fill bad" style={`width:${pct(OV.errores.c5xx, errTot)}%`}></i></span>
                                <span class="wb-dist-n editorial">{nfmt(OV.errores.c5xx)}</span>
                            </div>
                            {OV.errores.topRutas.length > 0 && (
                                <div class="wb-top">
                                    <span class="wb-top-lbl">{t(L, 'wb.resumen.top_rutas')}</span>
                                    {OV.errores.topRutas.map((r: any) => (
                                        <div class="wb-top-row"><code>{r.ruta}</code><b class="editorial">{nfmt(r.n)}</b></div>
                                    ))}
                                </div>
                            )}
                        </div>
                    )}
                </div>

                <div class="wb-card">
                    <span class="wb-card-lbl">{t(L, 'wb.resumen.entregas')}</span>
                    {(OV.wh.entregasOk + OV.wh.entregasErr) === 0 ? (
                        <p class="wb-empty">{t(L, 'wb.resumen.sin_entregas')}</p>
                    ) : (
                        <div class="wb-dist">
                            <div class="wb-dist-row">
                                <span class="wb-dist-k">{t(L, 'wb.resumen.entregadas')}</span>
                                <span class="wb-dist-track"><i class="wb-dist-fill ok" style={`width:${pct(OV.wh.entregasOk, OV.wh.entregasOk + OV.wh.entregasErr)}%`}></i></span>
                                <span class="wb-dist-n editorial">{nfmt(OV.wh.entregasOk)}</span>
                            </div>
                            <div class="wb-dist-row">
                                <span class="wb-dist-k">{t(L, 'wb.resumen.fallidas')}</span>
                                <span class="wb-dist-track"><i class="wb-dist-fill bad" style={`width:${pct(OV.wh.entregasErr, OV.wh.entregasOk + OV.wh.entregasErr)}%`}></i></span>
                                <span class="wb-dist-n editorial">{nfmt(OV.wh.entregasErr)}</span>
                            </div>
                        </div>
                    )}
                </div>
            </div>

            <div class="wb-card">
                <div class="wb-sec-head wb-sec-head-in">
                    <span class="wb-card-lbl">{t(L, 'wb.resumen.actividad_reciente')}</span>
                    <button type="button" class="wb-link" data-wb-act="goto-tab" data-tab="registros">{t(L, 'wb.resumen.ver_registros')}</button>
                </div>
                <div class="act-list">
                    {ACTIVITY.recent.length === 0 && <p class="wb-empty">{t(L, 'wb.resumen.sin_actividad')}</p>}
                    {ACTIVITY.recent.slice(0, 6).map((r: any) => (
                        <div class="act-row">
                            <span class={`act-m ${r.metodo.toLowerCase()}`}>{r.metodo}</span>
                            <code class="act-path">{r.ruta}</code>
                            <span class={`act-status ${r.status >= 400 ? 'bad' : 'ok'}`}>{r.status}</span>
                            <span class="act-lat">{r.ms != null ? `${r.ms}ms` : '—'}</span>
                            <span class="act-when">{r.cuando}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>

        <aside class="wb-ov-side">
            <h3 class="wb-sec-title">{t(L, 'wb.salud.titulo')}</h3>
            <div class:list={['wb-health', { ok: saludOk }]}>
                {saludOk ? (
                    <>
                        <svg class="wb-health-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.12" />
                            <polyline points="8.5 12.2 11 14.7 15.7 9.6" />
                        </svg>
                        <b>{t(L, 'wb.salud.ok')}</b>
                        <i>{t(L, 'wb.salud.ok_sub')}</i>
                    </>
                ) : (
                    <>
                        <svg class="wb-health-ico bad" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" fill="currentColor" fill-opacity="0.12" />
                            <line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                        <b>{t(L, 'wb.salud.alertas')}</b>
                        <i>{t(L, 'wb.salud.alertas_sub')}</i>
                    </>
                )}
            </div>

            <div class="wb-kv">
                <div class="wb-kv-row">
                    <span>{t(L, 'wb.salud.endpoints_activos')}</span>
                    <b class="editorial">{activosWh}<em>/{WEBHOOKS.length}</em></b>
                </div>
                {caidos.length > 0 && (
                    <div class="wb-kv-row bad">
                        <span>{t(L, 'wb.salud.endpoints_caidos')}</span>
                        <b class="editorial">{caidos.length}</b>
                    </div>
                )}
                <div class:list={['wb-kv-row', { warn: OV.wh.pendientes > 0 }]}>
                    <span>{t(L, 'wb.salud.pendientes')}</span>
                    <b class="editorial">{nfmt(OV.wh.pendientes)}</b>
                </div>
                {OV.wh.atrasados > 0 && (
                    <div class="wb-kv-row warn">
                        <span>{t(L, 'wb.salud.atrasados')}</span>
                        <b class="editorial">{nfmt(OV.wh.atrasados)}</b>
                    </div>
                )}
                {OV.wh.fallidos > 0 && (
                    <div class="wb-kv-row bad">
                        <span>{t(L, 'wb.salud.fallidos')}</span>
                        <b class="editorial">{nfmt(OV.wh.fallidos)}</b>
                    </div>
                )}
            </div>

            {caidos.length > 0 && (
                <button type="button" class="wb-link wb-link-block" data-wb-act="goto-tab" data-tab="webhooks">
                    {t(L, 'wb.salud.revisar_webhooks')}
                </button>
            )}

            <h3 class="wb-sec-title wb-sec-title-sp">{t(L, 'wb.recursos.titulo')}</h3>
            <nav class="wb-res">
                <a href="/docs" target="_blank" rel="noopener">{t(L, 'wb.recursos.docs')}<span aria-hidden="true">↗</span></a>
                <a href="/openapi.yaml" target="_blank" rel="noopener">{t(L, 'wb.recursos.openapi')}<span aria-hidden="true">↗</span></a>
                <a href="/llms.txt" target="_blank" rel="noopener">{t(L, 'wb.recursos.llms')}<span aria-hidden="true">↗</span></a>
                <a href="/app/ajustes/mcp">{t(L, 'wb.recursos.mcp')}<span aria-hidden="true">→</span></a>
            </nav>
        </aside>
    </div>
)}

{hasAccess && tab === 'api' && (
    <div class="dev-wrapper">
        <div class="dev-card">
            <div class="dev-card-header">
                <div>
                    <h3 class="dev-card-title">{t(L, 'set.api.claves_titulo')}</h3>
                    <p class="dev-card-sub" set:html={t(L, 'set.api.claves_sub')} />
                </div>
                <div class="dev-head-actions">
                    <div class="dev-seg" role="group" aria-label={t(L, 'set.api.modo_clave')}>
                        <button type="button" class="dev-seg-btn active" data-wb-act="seg-mode" data-mode="test">{t(L, 'set.api.prueba')}</button>
                        <button type="button" class="dev-seg-btn" data-wb-act="seg-mode" data-mode="live">{t(L, 'set.api.vivo')}</button>
                    </div>
                    <span class="dev-limit">{tf('set.api.plan_limite', { plan: planLabel(ORG.plan_raw) })} <b>{ACTIVAS}/{LIMITE_KEYS}</b></span>
                    <button type="button" class="api-btn-solid" data-wb-act="key-new" disabled={AT_LIMIT_KEYS} title={AT_LIMIT_KEYS ? tf('set.api.limite_hint', { n: String(LIMITE_KEYS) }) : ''}>{t(L, 'set.api.generar_clave')}</button>
                </div>
            </div>
            {AT_LIMIT_KEYS && (
                <p class="dev-limit-note">{tf('set.api.limite_nota_pre', { n: String(LIMITE_KEYS) })} <a href="/app/ajustes/plan">{t(L, 'set.api.subir_plan')}</a> {t(L, 'set.api.limite_nota_post')}</p>
            )}

            <div class="key-table">
                <div class="key-thead">
                    <span>{t(L, 'set.api.th_nombre')}</span><span>{t(L, 'set.api.th_token')}</span><span>{t(L, 'set.api.th_permisos')}</span><span>{t(L, 'set.api.th_ultimo_uso')}</span><span>{t(L, 'set.api.th_creacion')}</span><span></span>
                </div>
                {KEYS.length === 0 && (
                    <div class="key-empty">{t(L, 'set.api.vacio')}</div>
                )}
                {KEYS.map((k) => (
                    <div class:list={['key-trow', { revoked: k.revocada }]} data-id={k.id}>
                        <span class="key-cell-name">
                            <span class="key-nm">{k.nombre}</span>
                            <span class="key-tags">
                                <span class={`key-mode ${k.mode}`}>{k.mode === 'test' ? t(L, 'set.api.prueba') : t(L, 'set.api.vivo')}</span>
                                {/* Estas clases reemplazan un `style=` inline: un atributo style
                                    gana a cualquier selector, así que el badge se quedaba en
                                    lila claro y era ilegible sobre el navy del dock. */}
                                <span class={`key-type ${k.type === 'publishable' ? 'pub' : 'sec'}`}>{k.type === 'publishable' ? t(L, 'set.api.publica') : t(L, 'set.api.secreta')}</span>
                            </span>
                        </span>
                        <code class="key-cell-token">{k.masked}</code>
                        <span class={`key-scope ${k.scope}`}>{k.scope === 'write' ? t(L, 'set.api.escritura') : t(L, 'set.api.lectura')}</span>
                        <span class="key-cell-muted">{k.ultimoUso || t(L, 'set.api.sin_uso')}</span>
                        <span class="key-cell-muted">{k.creada}</span>
                        <span class="key-cell-act">
                            {k.revocada
                                ? <span class="key-badge-revoked">{t(L, 'set.api.revocada')}</span>
                                : <button type="button" class="key-revoke" data-wb-act="key-revoke" data-id={k.id}>{t(L, 'set.api.revocar')}</button>}
                        </span>
                    </div>
                ))}
            </div>
        </div>

        <div class="dev-card">
            <h3 class="dev-card-title">{t(L, 'set.api.endpoints_titulo')}</h3>
            <p class="dev-note wb-note-row">
                <span>{t(L, 'set.api.endpoints_base_pre')} <code>https://cordhq.app/api/v1</code> {t(L, 'set.api.endpoints_base_post')} <code>Authorization: Bearer &lt;tu_clave&gt;</code>.</span>
                <span class="wb-note-links">
                    <a href="/openapi.yaml" target="_blank" rel="noopener">{t(L, 'set.api.spec_openapi')}</a>
                    <a href="/llms.txt" target="_blank" rel="noopener">{t(L, 'set.api.llms_txt')}</a>
                </span>
            </p>
            <div class="ep-rows">
                <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/me</code><span class="ep-d">{t(L, 'set.api.ep_me')}</span></div>
                <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/cotizaciones</code><span class="ep-d" set:html={t(L, 'set.api.ep_cot_list')} /></div>
                <div class="ep-row"><span class="ep-m post">POST</span><code class="ep-path">/cotizaciones</code><span class="ep-d">{t(L, 'set.api.ep_cot_create')}</span></div>
                <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/cotizaciones/:id</code><span class="ep-d">{t(L, 'set.api.ep_cot_detail')}</span></div>
                <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/clientes</code><span class="ep-d">{t(L, 'set.api.ep_cli_list')}</span></div>
                <div class="ep-row"><span class="ep-m post">POST</span><code class="ep-path">/clientes</code><span class="ep-d">{t(L, 'set.api.ep_cli_create')}</span></div>
                <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/productos</code><span class="ep-d">{t(L, 'set.api.ep_prod_list')}</span></div>
                <div class="ep-row"><span class="ep-m post">POST</span><code class="ep-path">/productos</code><span class="ep-d">{t(L, 'set.api.ep_prod_create')}</span></div>
                <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/cobranza</code><span class="ep-d">{t(L, 'set.api.ep_cobranza')}</span></div>
            </div>
            <div class="dev-terminal">
                <span class="ep-code-label">{t(L, 'set.api.ejemplo')}</span>
                <pre><code>curl https://cordhq.app/api/v1/cotizaciones \
  -H "Authorization: Bearer sk_live_xxxxxxxxxxxx"</code></pre>
            </div>
            <button type="button" class="api-btn-ghost wb-btn-wide" data-wb-act="ai-prompt">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2" fill="currentColor" fill-opacity="0.12"/><path d="M10 3v3M14 3v3M10 18v3M14 18v3M3 10h3M3 14h3M18 10h3M18 14h3"/></svg>
                {t(L, 'set.api.generar_prompt')}
            </button>
        </div>
    </div>
)}

{hasAccess && tab === 'registros' && (
    <div class="dev-card">
        <div class="dev-card-header">
            <h3 class="dev-card-title">{t(L, 'set.api.actividad_titulo')}</h3>
            <button type="button" class="dev-refresh" data-wb-act="act-refresh" title={t(L, 'set.api.actualizar')}>{t(L, 'set.api.actualizar')}</button>
        </div>
        <div class="dev-stats-grid">
            <div class="dev-stat-box"><span class="dev-stat-value editorial" id="actTotal">{ACTIVITY.total24}</span><span class="dev-stat-label">{t(L, 'set.api.requests_24h')}</span></div>
            <div class="dev-stat-box"><span class={`dev-stat-value editorial ${ACTIVITY.errores24 > 0 ? 'bad' : ''}`} id="actErr">{ACTIVITY.errores24}</span><span class="dev-stat-label">{t(L, 'set.api.errores_24h')}</span></div>
            <div class="dev-stat-box"><span class="dev-stat-value editorial" id="actLat">{ACTIVITY.latProm}<em>ms</em></span><span class="dev-stat-label">{t(L, 'set.api.latencia_prom')}</span></div>
        </div>
        <div class="act-list" id="actList">
            {ACTIVITY.recent.length === 0 && <p class="dev-empty">{t(L, 'set.api.sin_actividad')}</p>}
            {ACTIVITY.recent.map((r: any) => (
                <div class="act-row">
                    <span class={`act-m ${r.metodo.toLowerCase()}`}>{r.metodo}</span>
                    <code class="act-path">{r.ruta}</code>
                    <span class={`act-status ${r.status >= 400 ? 'bad' : 'ok'}`}>{r.status}</span>
                    <span class="act-lat">{r.ms != null ? `${r.ms}ms` : '—'}</span>
                    <span class="act-when">{r.cuando}{r.mode === 'test' ? ' · test' : ''}</span>
                </div>
            ))}
        </div>
    </div>
)}

{hasAccess && tab === 'webhooks' && (
    <div class="dev-wrapper">
        <div class="dev-card">
            <div class="dev-card-header">
                <div>
                    <h3 class="dev-card-title">{t(L, 'set.wh.endpoints_titulo')}</h3>
                    <p class="dev-card-sub" set:html={t(L, 'set.wh.endpoints_sub')} />
                </div>
                <div class="dev-head-actions">
                    <span class="dev-limit">{tf('set.wh.plan', { plan: planLabel(ORG.plan_raw) })} <b>{WEBHOOKS.length}/{LIMITE_WH}</b></span>
                    <button type="button" class="api-btn-solid" data-wb-act="wh-new" disabled={AT_LIMIT_WH} title={AT_LIMIT_WH ? tf('set.wh.limite_hint', { n: String(LIMITE_WH) }) : ''}>{t(L, 'set.wh.agregar_endpoint')}</button>
                </div>
            </div>
            {AT_LIMIT_WH && (
                <p class="dev-limit-note">{tf('set.wh.limite_nota_pre', { n: String(LIMITE_WH), s: LIMITE_WH === 1 ? '' : 's' })} <a href="/app/ajustes/plan">{t(L, 'set.wh.subir_plan')}</a> {t(L, 'set.wh.limite_nota_post')}</p>
            )}

            <div class="wh-list">
                {WEBHOOKS.length === 0 && (
                    <p class="dev-empty">{t(L, 'set.wh.vacio')}</p>
                )}
                {WEBHOOKS.map((w) => (
                    <div class:list={['wh-item', { off: !w.activo, disabled: !!w.deshabilitadoMotivo }]} data-id={w.id}>
                        {w.deshabilitadoMotivo && (
                            <div class="wh-health-banner">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" fill="currentColor" fill-opacity="0.12"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                <span class="wh-health-msg">{t(L, 'set.wh.deshabilitado_pre')} {w.deshabilitadoMotivo}{w.deshabilitadoEn ? ` — ${w.deshabilitadoEn}` : ''}</span>
                                <span class="wh-health-actions">
                                    <button type="button" data-wb-act="wh-reenable" data-id={w.id}>{t(L, 'set.wh.reactivar')}</button>
                                    <button type="button" data-wb-act="wh-reenable-retry" data-id={w.id}>{t(L, 'set.wh.reactivar_reintentar')}</button>
                                </span>
                            </div>
                        )}
                        <div class="wh-row">
                            <button type="button" class="wh-expand" data-wb-act="wh-expand" data-id={w.id} title={t(L, 'set.wh.ver_entregas')} aria-expanded="false">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                            </button>
                            <span class="wh-info">
                                <span class="wh-url">{w.url}</span>
                                <span class="wh-sub">
                                    <code>{w.secretMasked}</code>
                                    <button type="button" class="wh-rotate-link" data-wb-act="wh-rotate" data-id={w.id}>{t(L, 'set.wh.rotar')}</button>
                                    {w.rotandoHasta && <i class="wh-rotating-note">{t(L, 'set.wh.rotando_hasta_pre')} {w.rotandoHasta}</i>}
                                    {w.eventos.length === 0 ? <i>{t(L, 'set.wh.todos_eventos')}</i> : <i>{w.eventos.length > 1 ? tf('set.wh.eventos_plural', { n: String(w.eventos.length) }) : t(L, 'set.wh.evento_singular')}</i>}
                                    {w.ultimaEntrega && (
                                        <i class:list={['wh-stat', { ok: w.lastStatus && w.lastStatus < 400, err: !w.lastStatus || w.lastStatus >= 400 }]}
                                            title={w.lastError ? `${t(L, 'set.wh.ultimo_error_pre')} ${w.lastError}` : ''}>
                                            {t(L, 'set.wh.ultima_pre')} {w.ultimaEntrega} {w.lastStatus ? `(${w.lastStatus})` : (w.lastError || t(L, 'set.wh.fallo'))}
                                        </i>
                                    )}
                                </span>
                            </span>
                            <button type="button" class="api-btn-ghost wh-test" data-wb-act="wh-test" data-id={w.id} title={t(L, 'set.wh.probar_titulo')}>{t(L, 'set.wh.probar')}</button>
                            <button type="button" class="api-btn-ghost wh-edit" data-wb-act="wh-edit" data-id={w.id} data-url={w.url} data-eventos={JSON.stringify(w.eventos)}>{t(L, 'set.wh.editar')}</button>
                            <label class="s-toggle wh-toggle" title={t(L, 'set.wh.activar_pausar')}>
                                <input type="checkbox" data-wb-act="wh-toggle" data-id={w.id} checked={w.activo} />
                                <span class="s-toggle-track"><span class="s-toggle-thumb"></span></span>
                            </label>
                            <button type="button" class="api-btn-ghost" data-wb-act="wh-del" data-id={w.id}>{t(L, 'set.wh.eliminar')}</button>
                        </div>
                        <div class="wh-deliveries" data-deliveries={w.id} hidden>
                            <div class="wh-del-body" data-delbody={w.id}>
                                <span class="wh-del-loading">{t(L, 'set.wh.cargando_entregas')}</span>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
)}

</div>
