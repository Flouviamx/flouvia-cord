---
// Editor de cotizaciones: nueva, borrador (?draft=<id>) o versión nueva de una
// cotización ya enviada (?version=<id>). Esta página solo junta los datos; el
// editor es src/components/app/DocumentEditor.astro, el mismo de facturas.
import AppLayout from '../../../layouts/AppLayout.astro';
import DocumentEditor from '../../../components/app/DocumentEditor.astro';
import { getProductos, getClientes, getOrg, getCotizacion, getKitsForEditor, getImpuestos } from '../../../lib/queries';
import { getCountryProfile } from '../../../lib/countries';
import { buildTaxOptions, defaultTaxRate, retencionesFrom } from '../../../lib/impuestos';
import { currentLocale } from '../../../lib/context';
import { normalizeTerm } from '../../../lib/payment-terms';
import { getDocumentEditorI18n } from '../../../i18n/app';
import { CURRENCY_FLAG } from '../../../lib/flags';
import { listOfferedCurrencies, normalizeCurrency } from '../../../lib/currency';
import type { EditorBoot, EditorMode } from '../../../lib/editor/document-editor';

const L = currentLocale();
const T = getDocumentEditorI18n(L);

// Qué se edita. Una versión nueva solo existe para una cotización que el
// cliente ya tiene; un borrador, solo mientras siga en borrador.
const draftId = Astro.url.searchParams.get('draft');
const versionId = Astro.url.searchParams.get('version');
let quote = null;
let mode: EditorMode = 'new';
if (versionId) {
    quote = await getCotizacion(versionId);
    if (!quote) return Astro.redirect('/app/cotizaciones');
    if (quote.status === 'draft') return Astro.redirect(`/app/cotizaciones/nueva?draft=${quote.id}`);
    if (!['sent', 'viewed', 'expired'].includes(quote.status)) return Astro.redirect(`/app/cotizaciones/${quote.id}`);
    mode = 'version';
} else if (draftId) {
    quote = await getCotizacion(draftId);
    if (!quote || quote.status !== 'draft') return Astro.redirect('/app/cotizaciones/nueva');
    mode = 'draft';
}
// CTA "Nueva cotización" desde la ficha de un cliente: lo preselecciona.
const preselectCliente = !quote ? Astro.url.searchParams.get('cliente') : null;

const [productos, CLIENTES, ORG, kits, IMPUESTOS] = await Promise.all([
    getProductos(), getClientes(), getOrg(), getKitsForEditor(), getImpuestos(),
]);

const PAIS = String(ORG.countryCode || 'MX').toUpperCase();
// No es "IVA" en todos lados: es VAT en la UE, GST en Australia, Sales tax en
// EE.UU. El nombre sale del perfil del país del emisor.
const TAX_LABEL = getCountryProfile(PAIS, L).taxLabel;
const orgTaxRate = Number(ORG.ivaPct) || 0;
const TAX_OPTIONS = buildTaxOptions(IMPUESTOS, { locale: L, countryCode: PAIS, orgTaxRate });
const DEFAULT_TAX_RATE = defaultTaxRate(IMPUESTOS, orgTaxRate);
const orgCurrency = normalizeCurrency(ORG.moneda || getCountryProfile(PAIS, L).currency);
// La divisa del documento manda al reabrirlo (regla 21); la del negocio, al crear.
const currency = normalizeCurrency(quote?.baseCurrency || orgCurrency);
const currencyNames = new Intl.DisplayNames([L], { type: 'currency' });
const currencyOptions = listOfferedCurrencies(currency).map((code) => ({
    code, label: `${code} — ${currencyNames.of(code) || code}`, flag: CURRENCY_FLAG[code] || PAIS,
}));

const vigenciaSel = quote?.vigenciaDias ?? ORG.vigenciaDefaultDias;
const vigencias = [...new Set([15, 30, 60, ORG.vigenciaDefaultDias, vigenciaSel])].sort((a, b) => a - b);

const boot: Omit<EditorBoot, 'T'> = {
    kind: 'quote',
    mode,
    orgCurrency,
    orgCountry: PAIS,
    catalogo: productos.filter((p) => p.activo).map((p) => ({
        id: p.id, nombre: p.nombre, sku: p.sku, unidad: p.unidad, precio: p.precio, costo: p.costo,
        preciosVolumen: p.preciosVolumen, existencias: p.existencias, taxRate: p.taxRate ?? null,
    })),
    kits: kits.map((k) => ({
        id: k.id, nombre: k.nombre, precioCombo: k.precioCombo,
        items: k.items.map((it) => ({ productoId: it.productoId, descripcion: it.descripcion, cantidad: it.cantidad, precio: it.precio, unidad: it.unidad })),
    })),
    // La vista previa se arma con la marca del negocio. El logo se sirve por su
    // ruta y no se incrusta: puede ser un data URL de cientos de KB.
    brand: {
        nombre: ORG.nombre,
        logoUrl: ORG.logoUrl ? `/api/orgs/${ORG.id}/logo` : null,
        color: ORG.colorMarca,
        taxIdLabel: getCountryProfile(PAIS, L).taxIdLabel,
        taxId: ORG.rfc || null,
    },
    taxOptions: TAX_OPTIONS,
    defaultTaxRate: DEFAULT_TAX_RATE,
    retenciones: retencionesFrom(IMPUESTOS),
    taxLabel: TAX_LABEL,
    multiTax: TAX_OPTIONS.length > 1,
    aprobMargenMin: Number(ORG.aprobMargenMin) || 0,
    doc: {
        id: quote?.id ?? null,
        folio: quote?.folio ?? null,
        version: quote?.version ?? null,
        clienteId: quote?.cliente_id ?? preselectCliente ?? null,
        lines: (quote?.items ?? []).map((it) => ({
            productoId: it.producto_id ?? null,
            nombre: it.descripcion,
            unidad: it.unidad,
            cantidad: it.cantidad,
            lista: it.precioLista,
            negociado: it.precioNegociado,
            costo: it.costo ?? null,
            // `null` = línea anterior al impuesto por línea: se calculaba con la
            // tasa de la organización de ese momento.
            taxRate: it.taxRate ?? quote?.taxRateFallback ?? null,
        })),
    },
};

const title = mode === 'version' ? T.titleVersionTpl.replace('{folio}', quote!.folio) : mode === 'draft' ? T.titleEditQuote : T.titleNewQuote;
const crumbs = [{ label: T.crumbQuotes, href: '/app/cotizaciones' }, ...(quote ? [{ label: quote.folio, href: `/app/cotizaciones/${quote.id}` }] : [])];
---

<AppLayout title={title} page="cotizaciones" heading={title} crumbs={crumbs}>
    <DocumentEditor
        boot={boot}
        clientes={CLIENTES.map((c) => ({ id: c.id, empresa: c.empresa, contacto: c.contacto, email: c.email, rfc: c.rfc, descuentoPct: c.descuentoPct, terminosCode: c.terminosCode }))}
        currencyOptions={currencyOptions}
        currency={currency}
        terms={normalizeTerm(quote?.terminosCode ?? ORG.terminosDefault)}
        notas={quote?.notas || ''}
        ivaIncluido={quote ? quote.iva_incluido : !!ORG.ivaIncluidoDefecto}
        taxIncludedLabel={T.taxIncludedTpl.replace('{tax}', TAX_LABEL)}
        vigencias={vigencias}
        vigencia={vigenciaSel}
        anticipo={Number(quote ? quote.anticipoPct : ORG.anticipoDefaultPct) || 0}
        recurrente={!!quote?.esRecurrente}
    />
</AppLayout>
