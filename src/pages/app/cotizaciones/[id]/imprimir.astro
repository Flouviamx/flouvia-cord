---
export const prerender = false;
import QuotePrint from '../../../../components/q/QuotePrint.astro';
import { getCotizacion, getOrg } from '../../../../lib/queries';
const [q, org] = await Promise.all([getCotizacion(Astro.params.id ?? ''),getOrg()]);
if (!q) return Astro.redirect('/app/cotizaciones');
---
<QuotePrint q={q} org={org}/>
