---
// Detalle de cliente — ficha + métricas calculadas (win rate, crédito, negociación,
// actividad de 12 meses). Patrón calcado de /app/cotizaciones/[id].astro: Promise.all +
// redirect si no existe, crumbs, .detail-grid con sidebar sticky.
import AppLayout from '../../../layouts/AppLayout.astro';
import ClientModal from '../../../components/app/ClientModal.astro';
import { getCliente, getEstadoCuentaCliente, getMyMembership, STATUS_META, money } from '../../../lib/queries';
import { memberCan } from '../../../lib/permissions';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
import '../../../styles/modal.css';

const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const { id } = Astro.params;
const [c, ME, EC] = await Promise.all([
    getCliente(id ?? ''), getMyMembership(), getEstadoCuentaCliente(id ?? ''),
]);
if (!c) return Astro.redirect('/app/clientes');
const canEdit = memberCan(ME, 'clientes');

const NIVEL_LABEL: Record<string, string> = { estandar: t(L, 'cdet.nivel_estandar'), plata: t(L, 'cdet.nivel_plata'), oro: t(L, 'cdet.nivel_oro'), distribuidor: t(L, 'cdet.nivel_distribuidor') };
const m = c.metricas;
const waHref = c.telefono ? `https://wa.me/${c.telefono.replace(/\D/g, '')}` : null;
const metaBits = [c.contacto, c.email, c.telefono].filter(Boolean);
---

<AppLayout title={`${c.empresa} — Cord`} page="clientes" heading={c.empresa} crumbs={[{ label: tf('cdet.volver').replace('← ', ''), href: '/app/clientes' }]}>
    <div slot="topbar-actions" class="dc-actions">
        {canEdit && (
            <button type="button" class="dc-btn-ghost" id="dcEdit"
                data-id={c.id} data-empresa={c.empresa} data-contacto={c.contacto} data-email={c.email}
                data-telefono={c.telefono} data-rfc={c.rfc} data-terminos={c.terminosCode}
                data-limite={c.limite > 0 ? String(c.limite) : ''} data-nivel={c.nivel}
                data-descuento={c.descuentoPct > 0 ? String(c.descuentoPct) : ''}
                data-regimen={c.regimenFiscal} data-uso={c.usoCfdi} data-cp={c.cpFiscal}
            >{t(L, 'cdet.editar')}</button>
        )}
        {canEdit && <a class="dc-btn-primary" href={`/app/cotizaciones/nueva?cliente=${c.id}`}>{t(L, 'cdet.nueva_cotizacion')}</a>}
    </div>

    <div class="detail-grid">
        <div class="d-main">
            <section class="d-head">
                <div class="dh-client">
                    <div class:list={['dh-avatar', `dh-avatar-${c.nivel}`]}>{c.inicial}</div>
                    <div class="dh-info">
                        <div class="dh-badges">
                            {c.nivel !== 'estandar' && <span class:list={['dc-tier', `dc-tier-${c.nivel}`]}>{NIVEL_LABEL[c.nivel]}</span>}
                            <span class:list={['dc-fiscal-badge', 'dc-fiscal-badge-sm', { on: c.fiscalCompleto }]}>{c.fiscalCompleto ? t(L, 'cdet.fiscal_completo') : t(L, 'cdet.fiscal_incompleto')}</span>
                            {c.origen === 'embed' && <span class="dc-origin-badge">{t(L, 'cdet.origen_embed')}</span>}
                        </div>
                        <p class="dh-meta">{metaBits.length > 0 ? metaBits.join(' · ') : t(L, 'cdet.sin_contacto')}</p>
                    </div>
                </div>
                <div class="dh-total">
                    <span class="dh-total-label">{t(L, 'cdet.kpi_cerrado')}</span>
                    <span class="editorial dh-total-val">{money(m.cerradoTotal, 0)}</span>
                </div>
            </section>

            <section class="dc-kpis surface-card">
                <div class="dc-kpi"><span class="dc-kpi-label">{t(L, 'cdet.kpi_cotizaciones')}</span><span class="editorial dc-kpi-val">{m.cotizaciones}</span></div>
                <div class="dc-kpi"><span class="dc-kpi-label">{t(L, 'cdet.kpi_pipeline')}</span><span class="editorial dc-kpi-val">{money(m.pipelineTotal, 0)}</span></div>
                <div class="dc-kpi"><span class="dc-kpi-label">{t(L, 'cdet.kpi_cobrado')}</span><span class="editorial dc-kpi-val">{money(m.cobradoTotal, 0)}</span></div>
                <div class="dc-kpi"><span class="dc-kpi-label">{t(L, 'cdet.kpi_ticket')}</span><span class="editorial dc-kpi-val">{money(m.ticketPromedio, 0)}</span></div>
                <div class="dc-kpi"><span class="dc-kpi-label">{t(L, 'cdet.kpi_tasa_cierre')}</span><span class="editorial dc-kpi-val">{m.tasaCierre}%</span></div>
                <div class="dc-kpi"><span class="dc-kpi-label">{t(L, 'cdet.kpi_dias_cierre')}</span><span class="editorial dc-kpi-val">{m.diasCierre || '—'}</span></div>
            </section>

            {c.limite > 0 && (
                <section class="dc-credit surface-card">
                    <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.credito_titulo')}</h2><span class:list={['dc-credit-pct', { danger: m.excedeCredito }]}>{tf('cdet.credito_uso', { pct: String(m.usoCreditoPct) })}</span></div>
                    <div class="dc-credit-track"><div class:list={['dc-credit-fill', { danger: m.excedeCredito }]} style={`width:${Math.min(100, m.usoCreditoPct)}%`}></div></div>
                    <div class="dc-credit-nums"><span>{money(m.saldoAbierto, 0)}</span><span class="dc-credit-muted">{t(L, 'cdet.kpi_saldo')} · {money(c.limite, 0)} {t(L, 'cdet.credito_titulo').toLowerCase()}</span></div>
                    {m.excedeCredito && <p class="dc-credit-warn">{t(L, 'cdet.credito_excedido')}</p>}
                </section>
            )}

            {m.descuentoCedido > 0 && (
                <section class="dc-nego">
                    <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.negociacion_titulo')}</h2></div>
                    <p class="dc-nego-line"><span class="editorial">{money(m.descuentoCedido, 0)}</span> {t(L, 'cdet.descuento_cedido')} <span class="dc-nego-pct">(−{Math.round(m.descuentoCedidoPct)}%)</span></p>
                    <p class="dc-nego-hint">{t(L, 'cdet.descuento_cedido_hint')}</p>
                </section>
            )}

            <section class="dc-activity">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.actividad_titulo')}</h2></div>
                <div id="dcSpark" class="dc-spark" data-values={JSON.stringify(c.meses.map((mm) => mm.cotizado))}></div>
            </section>

            {EC.docs.length > 0 && (
                <section class="dc-statement">
                    <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.estado_cuenta')}</h2></div>

                    <div class="ec-kpis">
                        <div class="ec-kpi">
                            <span class="ec-lbl">{t(L, 'cdet.ec_saldo')}</span>
                            <span class="editorial ec-val">{money(EC.saldoTotal)}</span>
                        </div>
                        <div class="ec-kpi">
                            <span class="ec-lbl">{t(L, 'cdet.ec_vencido')}</span>
                            <span class:list={['editorial', 'ec-val', { 'is-bad': EC.vencido > 0 }]}>{money(EC.vencido)}</span>
                        </div>
                        <div class="ec-kpi">
                            <span class="ec-lbl">{t(L, 'cdet.ec_mas_viejo')}</span>
                            <span class:list={['editorial', 'ec-val', { 'is-bad': EC.masViejo > 30 }]}>
                                {EC.masViejo > 0 ? tf('cdet.ec_dias', { n: String(EC.masViejo) }) : t(L, 'cdet.ec_al_corriente')}
                            </span>
                        </div>
                    </div>

                    <div class="ec-aging">
                        {[
                            { k: 'corriente', l: t(L, 'cdet.ec_corriente'), v: EC.bandas.corriente },
                            { k: 'd1', l: t(L, 'cdet.ec_1_30'), v: EC.bandas.d1_30 },
                            { k: 'd31', l: t(L, 'cdet.ec_31_60'), v: EC.bandas.d31_60 },
                            { k: 'd61', l: t(L, 'cdet.ec_61_90'), v: EC.bandas.d61_90 },
                            { k: 'd90', l: t(L, 'cdet.ec_90mas'), v: EC.bandas.d90mas },
                        ].map((b) => (
                            <div class:list={['ec-band', { 'is-empty': b.v <= 0, 'is-late': b.k !== 'corriente' && b.v > 0 }]}>
                                <span class="ec-band-l">{b.l}</span>
                                <span class="editorial ec-band-v">{money(b.v)}</span>
                            </div>
                        ))}
                    </div>

                    <div class="dc-list">
                        {EC.docs.map((d) => (
                            <a class="dc-qrow ec-row" href={d.origen === 'factura' ? `/app/facturas/${d.id}` : `/app/cotizaciones/${d.id}`}>
                                <span class="dc-qfolio">{d.folio}</span>
                                <span class:list={['status-pill', { 'is-late': d.diasVencido > 0 }]}>
                                    {d.diasVencido > 0
                                        ? tf('cdet.ec_dias', { n: String(d.diasVencido) })
                                        : t(L, 'cdet.ec_al_corriente')}
                                </span>
                                <span class="editorial dc-qtotal">{money(d.saldo)}</span>
                                <span class="dc-qdate">{d.vence ? `${t(L, 'cdet.ec_vence')} ${d.vence}` : '—'}</span>
                                <svg class="dc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                            </a>
                        ))}
                    </div>
                </section>
            )}

            <section class="dc-quotes">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.cotizaciones_titulo')}</h2></div>
                {c.cotizaciones.length === 0 ? (
                    <p class="dc-empty">{t(L, 'cdet.cotizaciones_vacio')}</p>
                ) : (
                    <div class="dc-list">
                        {c.cotizaciones.map((q) => {
                            const meta = STATUS_META[q.status as keyof typeof STATUS_META];
                            return (
                                <a class="dc-qrow" href={`/app/cotizaciones/${q.id}`}>
                                    <span class="dc-qfolio">{q.folio}{q.esRecurrente && <span class="dc-rec-badge">{t(L, 'cdet.recurrente_badge')}</span>}</span>
                                    <span class="status-pill" style={`color:${meta.color};background:${meta.bg}`}>{meta.label}</span>
                                    <span class="editorial dc-qtotal">{money(q.total)}</span>
                                    <span class="dc-qdate">{new Intl.DateTimeFormat(L === 'en' ? 'en-US' : 'es-MX', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(q.creada))}</span>
                                    <svg class="dc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                </a>
                            );
                        })}
                    </div>
                )}
            </section>

            <section class="dc-products">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.que_le_vendes')}</h2></div>
                {c.productos.length === 0 ? (
                    <p class="dc-empty">{t(L, 'cdet.que_le_vendes_vacio')}</p>
                ) : (
                    <div class="dc-list">
                        {c.productos.map((p) => (
                            <div class="dc-prow">
                                <span class="dc-pname">{p.nombre}</span>
                                <span class="dc-pveces">{tf('cdet.veces', { n: String(p.veces) })}</span>
                                <span class="editorial dc-ptotal">{money(p.importe, 0)}</span>
                            </div>
                        ))}
                    </div>
                )}
            </section>
        </div>

        <aside class="d-side">
            <section class="dc-side-block">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.contacto_titulo')}</h2></div>
                {!c.contacto && !c.email && !c.telefono ? (
                    <p class="dc-empty">{t(L, 'cdet.sin_contacto')}</p>
                ) : (
                    <div class="dc-kv-list">
                        {c.contacto && <div class="dc-kv"><span>{c.contacto}</span></div>}
                        <div class="dc-kv"><span>{c.email || t(L, 'cdet.sin_email')}</span>{c.email && <a href={`mailto:${c.email}`} class="dc-kv-link">↗</a>}</div>
                        <div class="dc-kv"><span>{c.telefono || t(L, 'cdet.sin_telefono')}</span>{c.telefono && <a href={`tel:${c.telefono}`} class="dc-kv-link">{t(L, 'cdet.llamar')}</a>}</div>
                        {waHref && <a href={waHref} target="_blank" rel="noopener" class="dc-wa-btn">{t(L, 'cdet.whatsapp')}</a>}
                    </div>
                )}
            </section>

            <section class="dc-side-block">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.condiciones_titulo')}</h2></div>
                <div class="dc-kv-list">
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'cdet.rfc_label')}</span><span>{c.rfc || t(L, 'cdet.sin_rfc')}</span></div>
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'cdet.limite_label')}</span><span class="editorial">{c.limite > 0 ? money(c.limite, 0) : '—'}</span></div>
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'cdet.terminos_label')}</span><span>{c.terminos}</span></div>
                </div>
            </section>

            <section class="dc-side-block">
                <div class="sec-head"><h2 class="sec-title">{c.fiscalCompleto ? t(L, 'cdet.fiscal_completo') : t(L, 'cdet.fiscal_incompleto')}</h2></div>
                <span class:list={['dc-fiscal-badge', { on: c.fiscalCompleto }]}>{c.fiscalCompleto ? t(L, 'cdet.fiscal_completo') : t(L, 'cdet.fiscal_incompleto')}</span>
            </section>

            <section class="dc-side-block">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'cdet.metadatos_titulo')}</h2></div>
                <div class="dc-kv-list">
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'cdet.alta_label')}</span><span>{c.createdAt ? new Intl.DateTimeFormat(L === 'en' ? 'en-US' : 'es-MX', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(c.createdAt)) : '—'}</span></div>
                    <div class="dc-kv"><span class="dc-kv-label">{t(L, 'cdet.origen_label')}</span><span>{c.origen === 'embed' ? t(L, 'cdet.origen_embed') : t(L, 'cdet.origen_app')}</span></div>
                    {m.diasSilencio !== null && (
                        <div class="dc-kv"><span class="dc-kv-label">{t(L, 'cdet.silencio_label')}</span><span>{tf('cdet.dias', { n: String(m.diasSilencio) })}</span></div>
                    )}
                </div>
            </section>

            {canEdit && (
                <section class="dc-side-block">
                    <button type="button" class="dc-delete" id="dcDelete" data-id={c.id} data-empresa={c.empresa}
                        data-i18n-titulo={t(L, 'cdet.eliminar_titulo')} data-i18n-body={t(L, 'cdet.eliminar_body')}
                        data-i18n-eliminar={t(L, 'cdet.eliminar')} data-i18n-eliminando={t(L, 'cdet.eliminando')}
                        data-i18n-error={t(L, 'cdet.no_pudo_eliminar')}
                    >{t(L, 'cdet.eliminar')}</button>
                </section>
            )}
        </aside>
    </div>

    <!-- Modal de edición compartido — sin botón de eliminar propio (el sidebar ya trae uno). -->
    <ClientModal showDelete={false} />
</AppLayout>

<script>
    import { mountSparkline } from '../../../lib/chart';

    const sparkEl = document.getElementById('dcSpark');
    if (sparkEl) {
        let values: number[] = [];
        try { values = JSON.parse(sparkEl.dataset.values || '[]'); } catch { values = []; }
        mountSparkline(sparkEl, { values, height: 56 });
    }

    document.getElementById('dcEdit')?.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement;
        document.dispatchEvent(new CustomEvent('clientmodal:open', { detail: { data: el.dataset } }));
    });
    document.addEventListener('clientmodal:saved', () => { window.location.reload(); });

    const btnDel = document.getElementById('dcDelete');
    btnDel?.addEventListener('click', async () => {
        const I = btnDel.dataset;
        const id = I.id;
        if (!id) return;
        if (!(await (window as any).cordConfirm({ title: I.titulo, body: I.body, danger: true, confirmText: I.eliminar }))) return;
        const prev = btnDel.textContent;
        (btnDel as HTMLButtonElement).disabled = true;
        btnDel.textContent = I.eliminando || 'Eliminando…';
        try {
            const res = await fetch('/api/clientes', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id }),
            });
            if (!res.ok) throw new Error((await res.json()).error || I.error);
            window.location.href = '/app/clientes';
        } catch (err: any) {
            (window as any).cordToast?.(err.message || I.error, 'error');
            (btnDel as HTMLButtonElement).disabled = false;
            btnDel.textContent = prev;
        }
    });
</script>

<style>
    /* Estado de cuenta. Va ANTES del historial de cotizaciones a propósito: lo
       que este cliente debe hoy pesa más para decidir que lo que compró el año
       pasado. */
    .dc-statement { margin-bottom: 2.4rem; }
    .ec-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; margin-bottom: 1.4rem; }
    .ec-kpi { display: flex; flex-direction: column; gap: 2px; }
    .ec-lbl { font-size: 0.72rem; color: var(--color-text-muted); }
    .ec-val { font-size: 1.15rem; color: var(--color-blue-deep); }
    .ec-val.is-bad { color: var(--color-danger); }
    .ec-aging { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--color-border); border-radius: 12px; overflow: hidden; margin-bottom: 1.4rem; }
    .ec-band { display: flex; flex-direction: column; gap: 2px; padding: 0.8rem 0.9rem; background: var(--color-bg-soft); }
    .ec-band-l { font-size: 0.68rem; color: var(--color-text-muted); }
    .ec-band-v { font-size: 0.9rem; color: var(--color-text); }
    .ec-band.is-empty .ec-band-v { color: var(--color-text-muted); opacity: 0.6; }
    .ec-band.is-late .ec-band-v { color: #b45309; }
    .ec-row .status-pill { color: var(--color-text-muted); background: rgba(0,0,0,0.05); }
    .ec-row .status-pill.is-late { color: #b45309; background: rgba(245,158,11,0.12); }

    @media (max-width: 880px) {
        /* Ni los importes ni las bandas se ocultan: son información comercial
           (regla 16). La rejilla se apila. */
        .ec-kpis { grid-template-columns: 1fr; gap: 0.9rem; }
        .ec-aging { grid-template-columns: repeat(2, 1fr); }
    }

    .detail-grid { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start; }
    .d-main { display: flex; flex-direction: column; min-width: 0; gap: 2.2rem; }
    .d-side { display: flex; flex-direction: column; gap: 2.2rem; position: sticky; top: 76px; }
    @media (max-width: 980px) {
        .detail-grid { grid-template-columns: 1fr; }
        .d-side { position: static; }
    }

    .dc-actions { display: flex; align-items: center; gap: 0.7rem; }
    .dc-tier { font-size: 0.66rem; font-weight: 800; letter-spacing: 0.3px; padding: 4px 11px; border-radius: 100px; }
    .dc-tier-oro { color: #92600a; background: rgba(245,158,11,0.18); }
    .dc-tier-plata { color: #475569; background: rgba(100,116,139,0.15); }
    .dc-tier-distribuidor { color: #1e3a5f; background: rgba(10,25,47,0.1); }
    .dc-origin-badge { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.2px; padding: 4px 11px; border-radius: 100px; color: var(--color-text-muted); background: var(--color-bg-soft); }
    .dc-btn-primary, .dc-btn-ghost {
        font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600;
        border-radius: 9px; padding: 9px 16px; cursor: pointer; text-decoration: none;
        transition: transform 0.4s var(--ease-spring), box-shadow 0.3s var(--ease-ios), border-color 0.25s;
        display: inline-flex; align-items: center;
    }
    .dc-btn-primary { background: var(--color-blue-deep); color: #fff; border: none; box-shadow: 0 6px 18px -8px rgba(10,25,47,0.5); }
    .dc-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -8px rgba(10,25,47,0.55); }
    .dc-btn-primary:active { transform: translateY(-1px) scale(0.97); }
    .dc-btn-ghost { background: var(--color-bg-soft); color: var(--color-text); border: 1px solid var(--color-border); }
    .dc-btn-ghost:hover { transform: translateY(-2px); border-color: rgba(10,25,47,0.25); }
    .dc-btn-ghost:active { transform: translateY(-1px) scale(0.97); }

    /* ── Identidad: mismo patrón que cotizaciones/[id].astro (.d-head/.dh-*) — avatar +
       badges + meta a la izquierda, hero stat a la derecha. Sin repetir el nombre (ya
       lo lleva el h1 de AppLayout arriba). ── */
    .d-head { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; padding-bottom: 1.8rem; margin-bottom: 0.2rem; border-bottom: 1px solid var(--color-border); }
    .dh-client { display: flex; align-items: center; gap: 16px; min-width: 0; }
    .dh-avatar {
        width: 52px; height: 52px; border-radius: 15px; flex-shrink: 0;
        background: var(--color-blue-deep); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; font-weight: 800; letter-spacing: -0.02em;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 8px 18px -10px rgba(10,25,47,0.55);
    }
    .dh-avatar-oro { box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 8px 18px -10px rgba(10,25,47,0.55), 0 0 0 2.5px rgba(245,158,11,0.4); }
