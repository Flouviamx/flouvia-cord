<script>
    // Abrir/crear/editar (dispara clientmodal:open) + reaccionar a lo que el
    // ClientModal compartido reporte (clientmodal:saved / clientmodal:deleted).
    document.addEventListener('DOMContentLoaded', () => {
        const canEdit = !!document.getElementById('clientModal');

        document.getElementById('btnNew')?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('clientmodal:open')));
        document.getElementById('btnNewEmpty')?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('clientmodal:open')));

        document.querySelectorAll<HTMLElement>('.t-act[data-edit-id]').forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const row = btn.closest<HTMLElement>('.t-row');
                if (row) document.dispatchEvent(new CustomEvent('clientmodal:open', { detail: { data: row.dataset } }));
            });
        });

        // Auto-abrir el modal de alta cuando se llega con ?nuevo=1 (botón "+" del drawer móvil)
        if (canEdit && new URLSearchParams(location.search).get('nuevo')) {
            document.dispatchEvent(new CustomEvent('clientmodal:open'));
            history.replaceState(null, '', location.pathname);
        }

        document.addEventListener('clientmodal:saved', () => location.reload());
        document.addEventListener('clientmodal:deleted', () => location.reload());
    });
</script>

<script>
    import { createMoney0 } from '../../../lib/money-client';
    import { parseTermText, termLabel } from '../../../lib/payment-terms';
    // Importador CSV de clientes: archivo → mapeo → preview → carga masiva.
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('importModal') as HTMLDialogElement | null;
        if (!modal) return;
        const I = modal.dataset;
        const $ = (id: string) => document.getElementById(id)!;
        const fileInput = $('impFile') as HTMLInputElement;
        const drop = $('impDrop');
        const stepFile = $('impStepFile'), stepMap = $('impStepMap'), stepPrev = $('impStepPrev');
        const headerChk = $('impHeader') as HTMLInputElement;
        const upsertChk = $('impUpsert') as HTMLInputElement;
        const mapsEl = $('impMaps');
        const errorEl = $('impError');
        const btnNext = $('impNext') as HTMLButtonElement;
        const btnBack = $('impBack') as HTMLButtonElement;

        const FIELDS = [
            { key: 'empresa', label: I.i18nFieldEmpresa || 'Empresa', req: true, guess: ['empresa', 'cliente', 'razon', 'nombre', 'company'] },
            { key: 'contacto', label: I.i18nFieldContacto || 'Contacto', req: false, guess: ['contacto', 'contact', 'atencion'] },
            { key: 'email', label: I.i18nFieldCorreo || 'Correo', req: false, guess: ['email', 'correo', 'mail'] },
            { key: 'telefono', label: I.i18nFieldTelefono || 'Teléfono', req: false, guess: ['telefono', 'tel', 'phone', 'celular', 'movil', 'whats'] },
            // El identificador fiscal tiene un nombre por país. Los nombres largos
            // se buscan dentro del encabezado; las siglas cortas solo como palabra
            // completa (`exact`), porque "ust" vive dentro de "customer" y "nit"
            // dentro de "unitario".
            { key: 'rfc', label: I.i18nFieldRfc || 'Tax ID', req: false,
                guess: ['rfc', 'tax id', 'taxid', 'id fiscal', 'identificacion fiscal', 'numero fiscal', 'steuernummer', 'ustid', 'ust idnr', 'vat number', 'vat reg', 'siren', 'siret', 'cuit', 'cnpj', 'business number'],
                exact: ['nif', 'cif', 'nie', 'vat', 'tva', 'ust', 'rut', 'ruc', 'nit', 'ein', 'cpf', 'bn', 'tin', 'utr'] },
            { key: 'terminos', label: I.i18nFieldTerminos || 'Términos de pago', req: false, guess: ['terminos', 'term', 'pago', 'condicion'] },
            { key: 'limite', label: I.i18nFieldLimite || 'Límite de crédito', req: false, guess: ['limite', 'credito', 'limit', 'credit'] },
        ];

        let grid: string[][] = [];
        let step: 'file' | 'map' | 'prev' = 'file';
        let prepared: any[] = [];

        const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
        const parseNum = (v: string) => Number(String(v ?? '').replace(/[^0-9.\-]/g, '')) || 0;
        const lang: 'es' | 'en' = document.documentElement.lang === 'en' ? 'en' : 'es';
        // Un CSV lo escribe una persona: "Net 45", "45 días", "crédito" valen.
        const normTerm = (v: string) => parseTermText(norm(v));
        const money = createMoney0();
        const esc = (s: string) => String(s ?? '').replace(/</g, '&lt;');

        function parseCSV(text: string): string[][] {
            const first = text.split(/\r?\n/)[0] || '';
            const counts: Record<string, number> = {
                ',': (first.match(/,/g) || []).length,
                ';': (first.match(/;/g) || []).length,
                '\t': (first.match(/\t/g) || []).length,
            };
            const delim = Object.entries(counts).sort((a, b) => b[1] - a[1])[0][0] || ',';
            const rows: string[][] = []; let row: string[] = []; let field = ''; let q = false; let i = 0;
            while (i < text.length) {
                const c = text[i];
                if (q) {
                    if (c === '"') { if (text[i + 1] === '"') { field += '"'; i += 2; continue; } q = false; i++; continue; }
                    field += c; i++; continue;
                }
                if (c === '"') { q = true; i++; continue; }
                if (c === delim) { row.push(field); field = ''; i++; continue; }
                if (c === '\n') { row.push(field); rows.push(row); row = []; field = ''; i++; continue; }
                if (c === '\r') { i++; continue; }
                field += c; i++;
            }
            if (field.length || row.length) { row.push(field); rows.push(row); }
            return rows.filter(r => r.some(c => c.trim() !== ''));
        }

        const showStep = (s: 'file' | 'map' | 'prev') => {
            step = s;
            stepFile.hidden = s !== 'file';
            stepMap.hidden = s !== 'map';
            stepPrev.hidden = s !== 'prev';
            btnBack.hidden = s === 'file';
            errorEl.textContent = '';
            if (s === 'file') { btnNext.disabled = true; btnNext.textContent = I.i18nContinuar || 'Continuar'; }
            if (s === 'map') { btnNext.disabled = false; btnNext.textContent = I.i18nContinuar || 'Continuar'; }
            const order: Record<string, number> = { file: 0, map: 1, prev: 2 };
            document.querySelectorAll<HTMLElement>('#impSteps .imp-stepdot').forEach((d) => {
                const di = order[d.dataset.s || 'file']; const ci = order[s];
                d.classList.toggle('active', di === ci);
                d.classList.toggle('done', di < ci);
            });
            (window as any).cordWireModal?.(modal);
        };
        const ncols = () => grid.reduce((m, r) => Math.max(m, r.length), 0);

        function buildMaps() {
            const useHeader = headerChk.checked;
            const headers = useHeader ? (grid[0] || []) : [];
            const n = ncols();
            mapsEl.innerHTML = FIELDS.map(f => {
                let guessed = -1;
                if (useHeader) guessed = headers.findIndex(h => {
                    // "tax_id", "Tax-ID" y "tax id" son el mismo encabezado.
                    const plano = norm(h).replace(/[^a-z0-9]+/g, ' ').trim();
                    return f.guess.some(g => plano.includes(g)) || (f.exact ?? []).some(g => plano.split(' ').includes(g));
                });
                const opts = [`<option value="-1">${I.i18nNinguna || '— ninguna —'}</option>`];
                for (let i = 0; i < n; i++) {
                    const label = useHeader && headers[i] ? headers[i] : (I.i18nColumna || 'Columna {n}').replace('{n}', String(i + 1));
                    opts.push(`<option value="${i}" ${i === guessed ? 'selected' : ''}>${esc(label)}</option>`);
                }
                return `<div class="imp-map"><label>${f.label}${f.req ? ' <span class="req">*</span>' : ''}</label><select data-field="${f.key}">${opts.join('')}</select></div>`;
            }).join('');
        }
        const readMap = () => {
            const m: Record<string, number> = {};
            mapsEl.querySelectorAll<HTMLSelectElement>('select[data-field]').forEach(s => { m[s.dataset.field!] = parseInt(s.value, 10); });
            return m;
        };

        function buildPreview() {
            const m = readMap();
            if ((m.empresa ?? -1) < 0) { errorEl.textContent = I.i18nEligeEmpresa || 'Elige qué columna tiene el nombre de la empresa.'; return false; }
            const dataRows = headerChk.checked ? grid.slice(1) : grid;
            prepared = dataRows.map(r => ({
                empresa: (r[m.empresa] ?? '').trim(),
                contacto: m.contacto >= 0 ? (r[m.contacto] ?? '').trim() : '',
                email: m.email >= 0 ? (r[m.email] ?? '').trim() : '',
                telefono: m.telefono >= 0 ? (r[m.telefono] ?? '').trim() : '',
                rfc: m.rfc >= 0 ? (r[m.rfc] ?? '').trim().toUpperCase() : '',
                terminos: m.terminos >= 0 ? normTerm(r[m.terminos] ?? '') : 'contado',
                limite: m.limite >= 0 ? (String(r[m.limite] ?? '').trim() === '' ? '' : parseNum(r[m.limite])) : '',
            }));
            const valid = prepared.filter(p => p.empresa);
            const skipped = prepared.length - valid.length;

            const importarNTpl = I.i18nImportarN || 'Importar {n} cliente{s}';
            $('impSummary').innerHTML =
                `<div><span class="is-num">${valid.length}</span><small>${I.i18nAImportar || 'clientes a importar'}</small></div>` +
                (skipped > 0 ? `<div><span class="is-num warn">${skipped}</span><small>${I.i18nFilasOmitidas || 'filas omitidas (sin empresa)'}</small></div>` : '');

            $('impPrevHead').innerHTML = `<tr><th>${I.i18nThEmpresa || 'Empresa'}</th><th>${I.i18nThContacto || 'Contacto'}</th><th>${I.i18nThEmail || 'Email'}</th><th>${esc(I.i18nThRfc || 'Tax ID')}</th><th>${I.i18nThTerminos || 'Términos'}</th><th class="n">${I.i18nThLimite || 'Límite'}</th></tr>`;
            $('impPrevBody').innerHTML = prepared.slice(0, 8).map(p => {
                const bad = !p.empresa;
                return `<tr class="${bad ? 'bad' : ''}"><td>${esc(p.empresa || '—')}</td><td>${esc(p.contacto || '—')}</td><td>${esc(p.email || '—')}</td><td>${esc(p.rfc || '—')}</td><td>${esc(termLabel(p.terminos, lang))}</td><td class="n">${p.limite === '' ? '—' : money(p.limite)}</td></tr>`;
            }).join('');

            btnNext.textContent = importarNTpl.replace('{n}', String(valid.length)).replace('{s}', valid.length === 1 ? '' : 's');
            btnNext.disabled = valid.length === 0;
            (window as any).cordWireModal?.(modal);
            return true;
        }

        async function doImport() {
            const valid = prepared.filter(p => p.empresa);
            if (!valid.length) return;
            btnNext.disabled = true; btnNext.textContent = I.i18nImportando || 'Importando…';
            try {
                const res = await fetch('/api/clientes/import', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rows: valid, upsert: upsertChk.checked }),
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || I.i18nNoPudoImportar);
                // Filas con identificador fiscal inválido: se importó el resto y
                // se dice cuáles faltaron, en vez de recargar como si todo entrara.
                if (Array.isArray(data.rejected) && data.rejected.length) {
                    errorEl.textContent = data.rejected.map((r: any) => `${r.empresa}: ${r.error}`).join(' · ');
                    btnNext.disabled = false;
                    btnNext.textContent = (I.i18nImportarN || 'Importar {n} clientes').replace('{n}', String(valid.length)).replace('{s}', 's');
                    return;
                }
                location.reload();
            } catch (err: any) {
                errorEl.textContent = err.message;
                btnNext.disabled = false; btnNext.textContent = (I.i18nImportarN || 'Importar {n} clientes').replace('{n}', String(valid.length)).replace('{s}', 's');
            }
        }

        const loadFile = (file: File) => {
            const reader = new FileReader();
            reader.onload = () => {
                grid = parseCSV(String(reader.result));
                if (!grid.length) { errorEl.textContent = I.i18nArchivoVacio || 'El archivo está vacío o no se pudo leer.'; return; }
                buildMaps();
                showStep('map');
            };
            reader.readAsText(file, 'utf-8');
        };

        document.getElementById('btnImport')?.addEventListener('click', () => { showStep('file'); modal.showModal(); (window as any).cordWireModal?.(modal); });
        document.getElementById('btnImportEmpty')?.addEventListener('click', () => { showStep('file'); modal.showModal(); (window as any).cordWireModal?.(modal); });
        $('impClose').addEventListener('click', () => modal.close());
        $('impCancel').addEventListener('click', () => modal.close());
        fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) loadFile(fileInput.files[0]); });
        headerChk.addEventListener('change', buildMaps);
        drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('drag'); });
        drop.addEventListener('dragleave', () => drop.classList.remove('drag'));
        drop.addEventListener('drop', (e) => {
            e.preventDefault(); drop.classList.remove('drag');
            const f = (e as DragEvent).dataTransfer?.files?.[0];
            if (f) loadFile(f);
        });
        btnNext.addEventListener('click', () => {
            if (step === 'map') { if (buildPreview()) showStep('prev'); }
            else if (step === 'prev') doImport();
        });
        btnBack.addEventListener('click', () => {
            if (step === 'prev') { showStep('map'); btnNext.textContent = 'Continuar'; }
            else if (step === 'map') showStep('file');
        });
        $('impTpl').addEventListener('click', () => {
            const csv = modal.dataset.importTemplate || '';
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'plantilla-clientes-cord.csv';
            a.click();
            URL.revokeObjectURL(a.href);
        });
    });
</script>

<script is:inline>
    (function () {
        const input = document.getElementById('searchClientes');
        const clearBtn = document.getElementById('searchClearCli');
        const countEl = document.getElementById('dirCount');
        const body = document.getElementById('lfBody');
        if (!input || !body) return;
        const searchBox = document.querySelector('.ph-search');
        const iSinResultados = (searchBox && searchBox.dataset.i18nSinResultados) || 'Sin resultados para esta búsqueda.';
        const iSingular = (searchBox && searchBox.dataset.i18nSingular) || 'cliente';
        const iPlural = (searchBox && searchBox.dataset.i18nPlural) || 'clientes';
        const isEn = document.documentElement.lang === 'en';

        const rows = Array.from(body.querySelectorAll('.t-row'));
        const total = rows.length;
        let noResults = document.querySelector('.search-no-results');
        if (!noResults) {
            noResults = document.createElement('div');
            noResults.className = 'search-no-results';
            noResults.textContent = iSinResultados;
            document.querySelector('.dir').appendChild(noResults);
        }

        // ── Filtro por chip ──
        const PRED = {
            all: function () { return true; },
            con_cotizaciones: function (d) { return Number(d.n || 0) > 0; },
            sin_cotizar: function (d) { return Number(d.n || 0) === 0; },
            con_nivel: function (d) { return d.nivel !== 'estandar'; },
            con_credito: function (d) { return Number(d.limite || 0) > 0; },
            sin_fiscal: function (d) { return d.fiscal !== '1'; },
        };
        const CMP = {
            empresa: function (a, b) { return (a.dataset.empresa || '').localeCompare(b.dataset.empresa || ''); },
            cerrado: function (a, b) { return Number(b.dataset.cerrado || 0) - Number(a.dataset.cerrado || 0); },
            n: function (a, b) { return Number(b.dataset.n || 0) - Number(a.dataset.n || 0); },
            ultima: function (a, b) { return (b.dataset.ultima || '').localeCompare(a.dataset.ultima || ''); },
            limite: function (a, b) { return Number(b.dataset.limite || 0) - Number(a.dataset.limite || 0); },
        };
        const filterPills = Array.from(document.querySelectorAll('#lfFilters .filter-pill'));
        const sortSel = document.getElementById('lfSort');
        const params = new URLSearchParams(location.search);
        let activeFilter = params.get('f') && PRED[params.get('f')] ? params.get('f') : 'all';
        if (sortSel && params.get('s') && CMP[params.get('s')]) sortSel.value = params.get('s');
        filterPills.forEach(function (p) { p.classList.toggle('active', p.dataset.f === activeFilter); });

        function persist() {
            const url = new URL(location.href);
            if (activeFilter === 'all') url.searchParams.delete('f'); else url.searchParams.set('f', activeFilter);
            const s = sortSel ? sortSel.value : 'empresa';
            if (s === 'empresa') url.searchParams.delete('s'); else url.searchParams.set('s', s);
            history.replaceState(null, '', url.pathname + url.search);
        }

        function apply() {
            const q = input.value.trim().toLowerCase();
            clearBtn.style.display = q ? 'flex' : 'none';
            const pred = PRED[activeFilter] || PRED.all;
            let visible = 0;
            rows.forEach(function (row) {
                const d = row.dataset;
                const matchSearch = !q || (d.empresa || '').toLowerCase().includes(q) || (d.contacto || '').toLowerCase().includes(q) || (d.email || '').toLowerCase().includes(q) || (d.rfc || '').toLowerCase().includes(q);
                const match = matchSearch && pred(d);
                row.hidden = !match;
                if (match) visible++;
            });
            const s = sortSel ? sortSel.value : 'empresa';
            const cmp = CMP[s] || CMP.empresa;
            rows.slice().sort(cmp).forEach(function (row) { body.appendChild(row); });

            noResults.style.display = visible === 0 ? 'block' : 'none';
            if (countEl) {
                const labelFor = function (n) { return n === 1 ? iSingular : iPlural; };
                if (q || activeFilter !== 'all') countEl.textContent = isEn ? (visible + ' of ' + total + ' ' + labelFor(total)) : (visible + ' de ' + total + ' ' + labelFor(total));
                else countEl.textContent = total + ' ' + labelFor(total);
            }
            persist();
        }

        input.addEventListener('input', apply);
        clearBtn.addEventListener('click', function () { input.value = ''; apply(); input.focus(); });
        filterPills.forEach(function (p) {
            p.addEventListener('click', function () {
                activeFilter = p.dataset.f;
                filterPills.forEach(function (x) { x.classList.toggle('active', x === p); });
                apply();
            });
        });
        if (sortSel) sortSel.addEventListener('change', apply);
        apply();
    })();
</script>
