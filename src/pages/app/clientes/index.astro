---
// Clientes — directorio con términos y límite de crédito. CRUD real (Neon).
// Antes vivía en src/pages/app/clientes.astro (archivo suelto) — se movió a este
// directorio para poder tener clientes/[id].astro (detalle) como hermano.
import AppLayout from '../../../layouts/AppLayout.astro';
import ClientModal from '../../../components/app/ClientModal.astro';
import { getClientes, getMyMembership, getOrg, money } from '../../../lib/queries';
import { getCountryProfile } from '../../../lib/countries';
import { memberCan } from '../../../lib/permissions';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
import '../../../styles/modal.css';

const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const [CLIENTES, ME, ORG] = await Promise.all([getClientes(), getMyMembership(), getOrg()]);
const canEdit = memberCan(ME, 'clientes');
// El identificador fiscal se nombra como en el país del negocio: "RFC" es de
// México, y la columna, el importador y su plantilla se lo decían a todos.
const PAIS = String(ORG.countryCode || 'MX').toUpperCase();
const TAX_ID_LABEL = getCountryProfile(PAIS, L).taxIdLabel;
// Plantilla CSV: encabezado y ejemplo del país. El ejemplo mexicano (RFC,
// correos .mx, lada 55) es exactamente lo que un negocio de Lyon no reconoce.
const IMPORT_TEMPLATE = PAIS === 'MX'
    ? 'empresa,contacto,email,telefono,rfc,terminos,limite\nDistribuidora El Zarco,Raul Mendoza,compras@elzarco.mx,55 1234 5678,DEZ981123QX5,net30,500000\nConstructora GAMA,Lucia Ferreira,lucia@gama.com.mx,55 8765 4321,CGA050617HJ1,net60,850000\n'
    : L === 'en'
        ? 'company,contact,email,phone,tax_id,terms,limit\nNorthwind Supplies,Jane Cooper,purchasing@northwind.example,,,net30,50000\nBlue Harbor Builders,Lucas Martin,lucas@blueharbor.example,,,net60,85000\n'
        : 'empresa,contacto,email,telefono,id_fiscal,terminos,limite\nSuministros Northwind,Ana Cooper,compras@northwind.example,,,net30,50000\nConstructora Blue Harbor,Lucas Martin,lucas@blueharbor.example,,,net60,85000\n';

const NIVEL_LABEL: Record<string, string> = { estandar: t(L, 'cmod.nivel_estandar'), plata: t(L, 'cmod.nivel_plata'), oro: t(L, 'cmod.nivel_oro'), distribuidor: t(L, 'cmod.nivel_distribuidor') };

// Contadores de los chips de filtro — calculados server-side sobre el array ya cargado;
// el JS del cliente aplica exactamente el mismo criterio sobre los data-* de cada fila.
const fCount = {
    all: CLIENTES.length,
    conCotizaciones: CLIENTES.filter((c) => c.nCotizaciones > 0).length,
    sinCotizar: CLIENTES.filter((c) => c.nCotizaciones === 0).length,
    conNivel: CLIENTES.filter((c) => c.nivel !== 'estandar').length,
    conCredito: CLIENTES.filter((c) => c.limite > 0).length,
    sinFiscal: CLIENTES.filter((c) => !c.fiscalCompleto).length,
};
import { iconInner } from '../../../lib/icons';
---

<AppLayout title="Clientes — Cord" page="clientes" heading={t(L, 'cli.heading')}>
    <div slot="topbar-actions" class="topbar-btns">
        <div class="ph-search"
            data-i18n-sin-resultados={t(L, 'cli.sin_resultados')} data-i18n-singular={t(L, 'cli.cliente_singular')} data-i18n-plural={t(L, 'cli.cliente_plural')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('search')}></svg>
            <input id="searchClientes" type="search" placeholder={t(L, 'cli.buscar_ph')} autocomplete="off" spellcheck="false" />
            <button class="ph-search-clear" id="searchClearCli" aria-label={t(L, 'cli.limpiar')}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" set:html={iconInner('x')}></svg>
            </button>
        </div>
        {canEdit && <button class="btn-import" id="btnImport">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('upload')}></svg>
            {t(L, 'cli.importar_csv')}
        </button>}
        {canEdit && <button class="btn-new" id="btnNew">{t(L, 'cli.nuevo_cliente')}</button>}
    </div>

    <section class="dir">
        <div class="section-head">
            <h2>{t(L, 'cli.directorio')}</h2>
            <span class="dir-count" id="dirCount">{CLIENTES.length} {CLIENTES.length === 1 ? t(L, 'cli.cliente_singular') : t(L, 'cli.cliente_plural')}</span>
        </div>

        <div class="lfbar">
            <div class="filters" role="group" aria-label={t(L, 'cli.directorio')} id="lfFilters">
                <button class="filter-pill active" data-f="all">{t(L, 'cli.filter_todos')}<span class="fp-count">{fCount.all}</span></button>
                <button class="filter-pill" data-f="con_cotizaciones">{t(L, 'cli.filter_con_cotizaciones')}<span class="fp-count">{fCount.conCotizaciones}</span></button>
                <button class="filter-pill" data-f="sin_cotizar">{t(L, 'cli.filter_sin_cotizar')}<span class="fp-count">{fCount.sinCotizar}</span></button>
                <button class="filter-pill" data-f="con_nivel">{t(L, 'cli.filter_con_nivel')}<span class="fp-count">{fCount.conNivel}</span></button>
                <button class="filter-pill" data-f="con_credito">{t(L, 'cli.filter_con_credito')}<span class="fp-count">{fCount.conCredito}</span></button>
                <button class="filter-pill" data-f="sin_fiscal">{t(L, 'cli.filter_sin_fiscal')}<span class="fp-count">{fCount.sinFiscal}</span></button>
            </div>
            <label class="lf-sort">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('filter')}></svg>
                <select id="lfSort">
                    <option value="empresa">{t(L, 'cli.sort_empresa')}</option>
                    <option value="cerrado">{t(L, 'cli.sort_cerrado')}</option>
                    <option value="n">{t(L, 'cli.sort_cotizaciones')}</option>
                    <option value="ultima">{t(L, 'cli.sort_actividad')}</option>
                    <option value="limite">{t(L, 'cli.sort_limite')}</option>
                </select>
            </label>
        </div>

        <div class="t-head">
            <span>{t(L, 'cli.th_cliente')}</span><span>{t(L, 'cli.th_contacto')}</span><span>{TAX_ID_LABEL}</span><span>{t(L, 'cli.th_terminos')}</span><span class="t-right">{t(L, 'cli.th_limite')}</span><span class="t-right">{t(L, 'cli.th_cotizaciones')}</span><span></span>
        </div>
        <div class="t-body" id="lfBody">
            {CLIENTES.map((c) => (
                <div
                    class="t-row"
                    data-id={c.id}
                    data-empresa={c.empresa}
                    data-contacto={c.contacto}
                    data-email={c.email}
                    data-telefono={c.telefono}
                    data-rfc={c.rfc}
                    data-terminos={c.terminosCode}
                    data-limite={c.limite > 0 ? String(c.limite) : ''}
                    data-nivel={c.nivel}
                    data-descuento={c.descuentoPct > 0 ? String(c.descuentoPct) : ''}
                    data-regimen={c.regimenFiscal}
                    data-uso={c.usoCfdi}
                    data-cp={c.cpFiscal}
                    data-country={c.countryCode}
                    data-direccion1={c.direccionLine1}
                    data-direccion2={c.direccionLine2}
                    data-ciudad={c.ciudad}
                    data-region={c.region}
                    data-condicion-iva={c.condicionIva}
                    data-dian={c.dian}
                    data-einvoice={c.einvoiceAddress}
                    data-buyerref={c.buyerReference}
                    data-n={c.nCotizaciones}
                    data-cerrado={c.cerrado}
                    data-ultima={c.ultimaActividad ?? ''}
                    data-fiscal={c.fiscalCompleto ? '1' : ''}
                >
                    <a class="t-rowlink" href={`/app/clientes/${c.id}`} aria-label={c.empresa}></a>
                    <span class="t-client">
                        <span class="t-avatar">{c.inicial}</span>{c.empresa}
                        {c.nivel !== 'estandar' && (
                            <span class:list={['tier-badge', `tier-${c.nivel}`]}>{NIVEL_LABEL[c.nivel]}{c.descuentoPct > 0 ? ` −${c.descuentoPct}%` : ''}</span>
                        )}
                    </span>
                    <span class="t-contact">{c.contacto}<small>{c.email}</small></span>
                    <span class="t-muted" data-mobile-label={TAX_ID_LABEL}>{c.rfc}</span>
                    <span class="t-term" data-mobile-label={t(L, 'cli.th_terminos')}>{c.terminos}</span>
                    <span class="editorial t-amount t-right" data-mobile-label={t(L, 'cli.th_limite')}>{c.limite > 0 ? money(c.limite, 0) : '—'}</span>
                    <span class="t-muted t-right" data-mobile-label={t(L, 'cli.th_cotizaciones')}>{c.nCotizaciones}</span>
                    {canEdit
                        ? <button class="t-act" type="button" data-edit-id={c.id} aria-label={tf('cli.editar_aria', { empresa: c.empresa })}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('edit')}></svg>
                        </button>
                        : <span></span>}
                </div>
            ))}
        </div>
        {CLIENTES.length === 0 && (
            <div class="t-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('clients')}></svg>
                <p><b>{t(L, 'cli.vacio_titulo')}</b> {t(L, 'cli.vacio_desc')}</p>
                {canEdit && (
                    <div class="t-empty-cta">
                        <button class="btn-new" id="btnNewEmpty">{t(L, 'cli.nuevo_cliente')}</button>
                        <button class="btn-import" id="btnImportEmpty">{t(L, 'cli.importar_csv')}</button>
                    </div>
                )}
            </div>
        )}
    </section>

    {canEdit && <ClientModal />}

    <!-- Modal de importación CSV (solo si tiene permiso de edición) -->
    {canEdit && <dialog class="modal modal-lg" id="importModal"
        data-i18n-field-empresa={t(L, 'cli.field_empresa')} data-i18n-field-contacto={t(L, 'cli.field_contacto')}
        data-i18n-field-correo={t(L, 'cli.field_correo')} data-i18n-field-telefono={t(L, 'cli.field_telefono')}
        data-i18n-field-rfc={TAX_ID_LABEL} data-i18n-field-terminos={t(L, 'cli.field_terminos')}
        data-i18n-field-limite={t(L, 'cli.field_limite')} data-i18n-ninguna={t(L, 'cli.ninguna')}
        data-i18n-columna={t(L, 'cli.columna')} data-i18n-elige-empresa={t(L, 'cli.elige_columna_empresa')}
        data-i18n-a-importar={t(L, 'cli.clientes_a_importar')} data-i18n-filas-omitidas={t(L, 'cli.filas_omitidas')}
        data-i18n-th-email={t(L, 'cli.th_email')} data-i18n-th-contacto={t(L, 'cli.th_contacto')} data-i18n-th-rfc={TAX_ID_LABEL} data-import-template={IMPORT_TEMPLATE}
        data-i18n-th-terminos={t(L, 'cli.th_terminos')} data-i18n-th-limite={t(L, 'cli.th_limite')} data-i18n-th-empresa={t(L, 'cli.field_empresa')}
        data-i18n-continuar={t(L, 'cli.continuar')} data-i18n-importar-n={t(L, 'cli.importar_n')} data-i18n-importando={t(L, 'cli.importando')}
        data-i18n-no-pudo-importar={t(L, 'cli.no_pudo_importar')} data-i18n-archivo-vacio={t(L, 'cli.archivo_vacio')}>
        <div class="m-form">
            <div class="m-head">
                <h2>{t(L, 'cli.importar_titulo')}</h2>
                <button type="button" class="m-close" id="impClose" aria-label={t(L, 'cli.cerrar')}>✕</button>
            </div>

            <div class="m-body">
                <div class="imp-steps" id="impSteps">
                    <span class="imp-stepdot active" data-s="file"><i>1</i> {t(L, 'cli.paso1')}</span>
                    <span class="imp-stepdot" data-s="map"><i>2</i> {t(L, 'cli.paso2')}</span>
                    <span class="imp-stepdot" data-s="prev"><i>3</i> {t(L, 'cli.paso3')}</span>
                </div>

                <div class="imp-step" id="impStepFile">
                    <label class="imp-drop" id="impDrop">
                        <input type="file" id="impFile" accept=".csv,text/csv" hidden />
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('file-up')}></svg>
                        <b>{t(L, 'cli.drop_titulo')}</b>
                        <span>{tf('cli.drop_hint', { taxId: TAX_ID_LABEL })}</span>
                    </label>
                    <button type="button" class="imp-tpl" id="impTpl">{t(L, 'cli.descargar_plantilla')}</button>
                </div>

                <div class="imp-step" id="impStepMap" hidden>
                    <p class="imp-lead">{t(L, 'cli.emparejar_hint')}</p>
                    <label class="imp-check"><input type="checkbox" id="impHeader" checked /> {t(L, 'cli.primera_fila_encabezados')}</label>
                    <div class="imp-maps" id="impMaps"></div>
                </div>

                <div class="imp-step" id="impStepPrev" hidden>
                    <div class="imp-summary" id="impSummary"></div>
                    <label class="imp-check"><input type="checkbox" id="impUpsert" checked /> {tf('cli.actualizar_existentes', { taxId: TAX_ID_LABEL })}</label>
                    <div class="imp-prev-wrap"><table class="imp-prev"><thead id="impPrevHead"></thead><tbody id="impPrevBody"></tbody></table></div>
                </div>
            </div>

            <div class="m-foot">
                <p class="m-error" id="impError"></p>
                <div class="m-actions">
                    <button type="button" class="m-cancel" id="impBack" hidden>{t(L, 'cli.atras')}</button>
                    <span class="m-spacer"></span>
                    <button type="button" class="m-cancel" id="impCancel">{t(L, 'cli.cancelar')}</button>
                    <button type="button" class="m-save" id="impNext" disabled>{t(L, 'cli.continuar')}</button>
                </div>
            </div>
        </div>
    </dialog>}
</AppLayout>

<style>
    .btn-new {
        font-family: var(--font-sans);
        background: var(--color-blue-deep); color: #fff;
        font-size: 0.82rem; font-weight: 600; border: none; cursor: pointer;
        padding: 9px 16px; border-radius: 9px;
        box-shadow: 0 6px 18px -8px rgba(10,25,47,0.5);
        transition: transform 0.4s var(--ease-spring);
    }
    .btn-new:hover { transform: translateY(-2px); }
    .topbar-btns { display: flex; gap: 0.6rem; align-items: center; }
    .btn-import {
        font-family: var(--font-sans); display: inline-flex; align-items: center; gap: 7px;
        background: var(--color-bg-soft); color: var(--color-text);
        font-size: 0.82rem; font-weight: 600; border: 1px solid var(--color-border); cursor: pointer;
        padding: 8px 14px; border-radius: 9px; transition: border-color 0.25s, transform 0.4s var(--ease-spring);
    }
    .btn-import svg { width: 14px; height: 14px; }
    .btn-import:hover { transform: translateY(-2px); border-color: rgba(10,25,47,0.25); }

    /* ── Directorio (plano editorial, sin caja) ── */
    .dir { margin-bottom: 2.6rem; }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.2rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--color-border); }
    .section-head h2 { font-size: 0.98rem; font-weight: 600; letter-spacing: -0.01em; text-transform: none; color: var(--color-text); margin: 0; }
    .dir-count { font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); }

    .t-head, .t-row {
        display: grid;
        grid-template-columns: 1.6fr 1.4fr 1fr 0.7fr 1fr 0.8fr 34px;
        gap: 1rem; align-items: center;
        padding: 0.95rem 0.85rem;
    }
    .t-head {
        font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
        color: var(--color-text-muted); border-bottom: 1px solid var(--color-border);
        padding-top: 0; padding-bottom: 0.7rem;
    }
    .t-head > span:first-child, .t-row > :first-child { padding-left: 0; }
    .t-head > span:last-child, .t-row > :last-child { padding-right: 0; }
    .t-row {
        position: relative;
        border-bottom: 1px solid var(--color-border);
        border-radius: 10px;
        transition: background 0.25s var(--ease-ios);
    }
    .t-row:hover { background: var(--color-bg-soft); }
    .t-row:last-of-type { border-bottom: none; }
    .t-row[hidden] { display: none !important; }
    /* Stretched link: la fila entera navega, sin anidar <button> dentro de <a> (HTML
       inválido — el parser lo sacaría del anchor y rompería el grid en silencio). */
    .t-rowlink { position: absolute; inset: 0; z-index: 0; border-radius: inherit; }
    .t-row > :not(.t-rowlink) { position: relative; z-index: 1; }
    .t-row:has(.t-rowlink:focus-visible) { background: var(--color-bg-soft); outline: 2px solid var(--color-blue-deep); outline-offset: -2px; }

    .t-client { display: flex; align-items: center; gap: 10px; font-size: 0.86rem; font-weight: 600; color: var(--color-text); }
    .t-avatar {
        width: 32px; height: 32px; border-radius: 9px; flex-shrink: 0;
        background: var(--color-blue-deep); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.64rem; font-weight: 800;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.16);
    }
    .t-contact { display: flex; flex-direction: column; font-size: 0.82rem; font-weight: 500; color: var(--color-text); }
    .t-contact small { font-size: 0.7rem; color: var(--color-text-muted); }
    .t-muted { font-size: 0.78rem; color: var(--color-text-muted); }
    .t-term { font-size: 0.74rem; font-weight: 700; color: var(--color-blue-deep); }
    .tier-badge { font-size: 0.58rem; font-weight: 800; letter-spacing: 0.3px; padding: 2px 8px; border-radius: 100px; margin-left: 8px; vertical-align: 1px; white-space: nowrap; }
    .tier-oro { color: #92600a; background: rgba(245,158,11,0.18); }
    .tier-plata { color: #475569; background: rgba(100,116,139,0.15); }
    .tier-distribuidor { color: #1e3a5f; background: rgba(10,25,47,0.1); }
    .t-amount { font-size: 0.95rem; color: var(--color-blue-deep); }
    .t-right { text-align: right; }
    .t-empty { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; padding: 3rem 0; font-size: 0.85rem; color: var(--color-text-muted); margin: 0; text-align: center; line-height: 1.5; }
    .t-empty svg { width: 34px; height: 34px; color: #cbd5e1; }
    .t-empty b { color: var(--color-text); font-weight: 600; }
    .t-empty-cta { display: flex; gap: 0.6rem; margin-top: 0.3rem; }

    /* Botón "editar" por fila — solo visible al hover/foco (no compite con el clic de
       navegar, que vive en el stretched link .t-rowlink). */
    .t-act {
        display: flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 8px; border: none; cursor: pointer;
        background: var(--surface); color: var(--color-text-muted);
        opacity: 0; transition: opacity 0.15s, background 0.15s, color 0.15s;
    }
    .t-act svg { width: 15px; height: 15px; }
    .t-row:hover .t-act, .t-act:focus-visible { opacity: 1; }
    .t-act:hover { background: var(--row-hover); color: var(--color-blue-deep); }

    @media (max-width: 880px) {
        .dir,
        .lfbar,
        .filters,
        .t-body {
            width: 100%;
            min-width: 0;
            max-width: 100%;
        }
        .lfbar { gap: 0.8rem; }
        .lfbar .filters {
            width: 100%;
            max-width: 100%;
            padding: 0;
            flex-wrap: wrap;
            overflow: visible;
        }
        .lf-sort {
            width: 100%;
            min-width: 0;
            min-height: 44px;
            justify-content: flex-start;
            gap: 10px;
            padding: 0 12px;
            border-radius: 12px;
            background: var(--color-bg-soft);
        }
        .lf-sort select {
            flex: 1;
            width: 100%;
            min-width: 0;
            max-width: none;
            min-height: 44px;
            text-align: right;
        }
        .t-head { display: none; }
        .t-row {
            grid-template-columns: minmax(0, 1fr) auto 44px;
            grid-template-areas:
                "name name action"
                "contact contact action"
                "rfc terms terms"
                "limit quotes quotes";
            gap: 0.45rem 0.75rem;
            align-items: center;
            padding: 1rem 0;
            border-radius: 0;
            width: 100%;
            min-width: 0;
            max-width: 100%;
        }
        .t-client { grid-area: name; min-width: 0; flex-wrap: wrap; overflow-wrap: anywhere; }
        .t-contact { grid-area: contact; display: flex; }
        .t-contact small { overflow-wrap: anywhere; }
        .t-row > .t-muted:nth-child(4) { grid-area: rfc; }
        .t-term { grid-area: terms; justify-self: end; }
        .t-amount { grid-area: limit; text-align: left; }
        .t-row > .t-muted:nth-child(7) { grid-area: quotes; justify-self: end; }
        .t-act { grid-area: action; display: flex; width: 44px; height: 44px; opacity: 1; justify-self: end; }
        .t-row > span:last-child:empty { display: none; }
        .t-muted, .t-term { font-size: 0.72rem; }
        .t-row [data-mobile-label]::before {
            content: attr(data-mobile-label) " · ";
            color: var(--color-text-muted);
            font-family: var(--font-sans);
            font-size: 0.64rem;
            font-weight: 600;
            letter-spacing: 0;
        }
        .t-empty-cta { width: 100%; flex-direction: column; }
