---
// Cobranza operativa: tabla accionable (marcar cobrada, promesa de pago y WhatsApp).
// Datos reales de getCobranza(). Por cobrar = aprobadas/facturadas sin pagar.
import AppLayout from '../../layouts/AppLayout.astro';
import { getCobranza, getMyMembership, money } from '../../lib/queries';
import { memberCan } from '../../lib/permissions';
import { currentLocale } from '../../lib/context';
import { t } from '../../i18n/app';

const L = currentLocale();
const tpl = (s: string, vars: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '');
const ME = await getMyMembership();
const hasAccess = memberCan(ME, 'cobranza');
const C = hasAccess ? await getCobranza() : null;
const hay = (C?.items.length ?? 0) > 0;
---

<AppLayout title={t(L, 'cob.title')} page="cobranza" heading={t(L, 'cob.heading')}>
    <div slot="page-tabs" class="ph-tabs">
        <a href="/app/cobranza" class="ph-tab active">{t(L, 'cob.tab_cobranza')}</a>
        <a href="/app/tesoreria/cobranza" class="ph-tab">{t(L, 'cob.tab_ia')}</a>
    </div>
    {!hasAccess && (
        <div class="cb-denied">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <h3>{t(L, 'cob.sin_acceso_titulo')}</h3>
            <p>{t(L, 'cob.sin_acceso_desc')}</p>
        </div>
    )}
    {hasAccess && !hay && (
        <section class="empty">
            <h2>{t(L, 'cob.vacio_titulo')}</h2>
            <p>{t(L, 'cob.vacio_desc')}</p>
            <a href="/app/cotizaciones" class="empty-cta">{t(L, 'cob.ver_cotizaciones')}</a>
        </section>
    )}

    {hasAccess && hay && (
        <>
        <!-- Tabla de cuentas por cobrar -->
        <section class="table-card">
            <div class="sec-head"><h2 class="sec-title">{t(L, 'cob.cuentas_por_cobrar')}</h2></div>
            <div class="t-head">
                <span>{t(L, 'cob.th_cliente')}</span><span>{t(L, 'cob.th_folio')}</span><span>{t(L, 'cob.th_terminos')}</span><span>{t(L, 'cob.th_vence')}</span><span>{t(L, 'cob.th_estado')}</span><span class="t-right">{t(L, 'cob.th_saldo')}</span><span class="t-right">{t(L, 'cob.th_accion')}</span>
            </div>
            {C.items.map((it) => (
                <div class="t-row" data-id={it.id} data-token={it.token} data-folio={it.folio} data-empresa={it.empresa} data-total={money(it.total)} data-tel={it.telefono} data-vence={it.vence}
                    data-prom-id={it.promesa?.id ?? ''} data-prom-fecha={it.promesa?.fechaISO ?? ''} data-prom-monto={it.promesa?.monto != null ? String(it.promesa.monto) : ''} data-prom-nota={it.promesa?.nota ?? ''}>
                    <span class="t-client"><span class="t-avatar">{it.inicial}</span>{it.empresa}</span>
                    <a class="t-folio" href={`/app/cotizaciones/${it.id}`}>{it.folio}</a>
                    <span class="t-muted">{it.terminos}</span>
                    <span class="t-muted">{it.vence}</span>
                    <span class="t-estado">
                        {it.overdue
                            ? <span class="est est-over">{tpl(t(L, 'cob.vencida_dias'), { n: String(it.diasVencido) })}</span>
                            : <span class="est est-due">{it.diasParaVencer === 0 ? t(L, 'cob.vence_hoy') : tpl(t(L, 'cob.vence_en'), { n: String(it.diasParaVencer) })}</span>}
                        {it.promesa && (
                            <span class="est est-prom" title={it.promesa.nota || t(L, 'cob.promesa_pago')}>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                                {tpl(t(L, 'cob.promete'), { fecha: it.promesa.fecha })}
                            </span>
                        )}
                    </span>
                    <span class="t-saldo t-right">
                        <span class="editorial t-amount">{money(it.total, 0)}</span>
                        {it.interes > 0 && <small class="t-interes">+{money(it.interes, 0)} {t(L, 'cob.mora')}</small>}
                    </span>
                    <span class="t-actions t-right">
                        <button class:list={['cob-prom', { 'has-prom': it.promesa }]} title={t(L, 'cob.promesa_pago')} aria-label={t(L, 'cob.promesa_pago')}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </button>
                        <button class="cob-whats" title={t(L, 'cob.recordar_whatsapp')} aria-label={t(L, 'cob.recordar_whatsapp')}>
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.7-.85-2-.95-.26-.1-.46-.15-.65.15-.2.3-.74.94-.9 1.13-.17.2-.34.22-.63.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.46.13-.6.13-.14.3-.34.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.65-1.57-.9-2.15-.24-.56-.48-.48-.65-.49h-.56c-.2 0-.5.07-.77.37-.26.3-1 .98-1 2.4 0 1.4 1.03 2.76 1.17 2.96.14.2 2.02 3.08 4.9 4.32.68.3 1.22.47 1.64.6.69.22 1.31.19 1.8.12.55-.08 1.7-.7 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.2-.56-.34zM12 2a10 10 0 0 0-8.6 15.06L2 22l5.06-1.33A10 10 0 1 0 12 2z"/></svg>
                        </button>
                        <button class="cob-paid">{t(L, 'cob.cobrada')}</button>
                    </span>
                </div>
            ))}
        </section>

        <!-- Modal: registrar / gestionar promesa de pago -->
        <dialog class="modal" id="promModal"
            data-i18n-editar={t(L, 'cob.modal_editar_promesa')}
            data-i18n-nueva={t(L, 'cob.modal_nueva_promesa')}
            data-i18n-cliente-default={t(L, 'cob.cliente_default')}
            data-i18n-saldo={t(L, 'cob.saldo_de')}
            data-i18n-elige-fecha={t(L, 'cob.elige_fecha')}
            data-i18n-no-pudo-guardar={t(L, 'cob.no_pudo_guardar_promesa')}
        >
            <form method="dialog" class="m-form" id="promForm">
                <div class="m-head">
                    <h2 id="promTitle">{t(L, 'cob.promesa_pago')}</h2>
                    <button type="button" class="m-close" id="promClose" aria-label={t(L, 'cob.cerrar')}>✕</button>
                </div>
                <p class="prom-ctx" id="promCtx"></p>
                <div class="m-field">
                    <label for="promFecha">{t(L, 'cob.cuando_promete')}</label>
                    <input class="m-input" id="promFecha" type="date" required />
                </div>
                <div class="m-field">
                    <label for="promMonto">{t(L, 'cob.monto_comprometido')}</label>
                    <input class="m-input" id="promMonto" type="number" min="0" step="0.01" placeholder={t(L, 'cob.monto_comprometido_ph')} />
                </div>
                <div class="m-field">
                    <label for="promNota">{t(L, 'cob.nota_opcional')}</label>
                    <input class="m-input" id="promNota" placeholder={t(L, 'cob.nota_ph')} maxlength="400" />
                </div>
                <p class="m-error" id="promErr"></p>
                <div class="m-actions">
                    <button type="button" class="m-delete" id="promDel" hidden>{t(L, 'cob.quitar_promesa')}</button>
                    <span class="m-spacer"></span>
                    <button type="button" class="m-done" id="promDone" hidden>{t(L, 'cob.marcar_cumplida')}</button>
                    <button type="submit" class="m-save" id="promSave">{t(L, 'cob.guardar')}</button>
                </div>
            </form>
        </dialog>

        <p class="cob-err" id="cobErr"
            data-i18n-registrar-titulo={t(L, 'cob.registrar_pago_titulo')}
            data-i18n-registrar-body-tpl={t(L, 'cob.registrar_pago_body')}
            data-i18n-registrar-btn={t(L, 'cob.registrar_pago_btn')}
            data-i18n-no-pudo-registrar={t(L, 'cob.no_pudo_registrar_pago')}
            data-i18n-wa-saludo-tpl={t(L, 'cob.wa_saludo')}
        ></p>
        </>
    )}
</AppLayout>

<style>
    .t-saldo { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
    .t-interes { font-size: 0.66rem; color: var(--color-danger); font-weight: 600; }

    /* Tabla */
    .table-card { margin-bottom: 2.6rem; overflow-x: auto; }
    .t-head, .t-row {
        display: grid; grid-template-columns: 1.6fr 0.8fr 0.7fr 0.9fr 1fr 0.9fr 1fr;
        gap: 1rem; align-items: center; padding: 0.85rem 0.6rem;
        min-width: 860px;
    }
    .t-head {
        font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
        color: var(--color-text-muted); border-bottom: 1px solid var(--color-border);
        padding-top: 0; padding-bottom: 0.7rem;
    }
    .t-row { border-bottom: 1px solid var(--color-border); transition: background 0.25s var(--ease-ios); }
    .t-row:last-of-type { border-bottom: none; }
    .t-row:hover { background: var(--color-bg-soft); }
    .t-client { display: flex; align-items: center; gap: 10px; font-size: 0.86rem; font-weight: 600; color: var(--color-text); min-width: 0; }
    .t-client { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .t-avatar { width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0; background: var(--color-blue-deep); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.62rem; font-weight: 800; }
    .t-folio { font-size: 0.8rem; font-weight: 700; color: var(--color-blue-deep); text-decoration: none; }
    .t-folio:hover { text-decoration: underline; }
    .t-muted { font-size: 0.8rem; color: var(--color-text-muted); }
    .t-amount { font-size: 0.95rem; color: var(--color-blue-deep); }
    .t-right { text-align: right; }
    .est { font-size: 0.7rem; font-weight: 700; padding: 4px 9px; border-radius: 100px; white-space: nowrap; }
    .est-over { color: var(--color-danger); background: rgba(239,68,68,0.1); }
    .est-due { color: #2563eb; background: rgba(59,130,246,0.1); }
    .t-actions { display: flex; gap: 6px; justify-content: flex-end; align-items: center; }
    .cob-whats {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 8px; cursor: pointer;
        color: #0b7a4b; background: rgba(37,211,102,0.1); border: 1px solid rgba(37,211,102,0.28);
        transition: background 0.2s;
    }
    .cob-whats svg { width: 15px; height: 15px; }
    .cob-whats:hover { background: rgba(37,211,102,0.18); }
    .cob-paid {
        font-family: var(--font-sans); font-size: 0.76rem; font-weight: 600; cursor: pointer;
        color: #fff; background: var(--color-ok); border: none; border-radius: 8px; padding: 7px 12px;
        transition: transform 0.3s var(--ease-spring), opacity 0.2s;
    }
    .cob-paid:hover { transform: translateY(-1px); }
    .cob-paid:disabled { opacity: 0.55; cursor: wait; }
    .cob-err { font-size: 0.78rem; color: var(--color-danger); margin: 0.6rem 0 0; min-height: 1em; }

    /* Promesa de pago: badge en estado + botón de acción */
    .t-estado { display: inline-flex; flex-wrap: wrap; gap: 5px; align-items: center; }
    .est-prom { display: inline-flex; align-items: center; gap: 4px; color: #7c5cff; background: rgba(124,92,255,0.1); }
    .est-prom svg { width: 11px; height: 11px; }
    .cob-prom {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 8px; cursor: pointer;
        color: var(--color-text-muted); background: var(--color-bg-soft); border: 1px solid var(--color-border);
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .cob-prom svg { width: 15px; height: 15px; }
    .cob-prom:hover { color: var(--color-text); border-color: #cbd5e1; }
    .cob-prom.has-prom { color: #7c5cff; background: rgba(124,92,255,0.1); border-color: rgba(124,92,255,0.3); }

    /* Modal de promesa (mismo lenguaje que los modales de la app) */
    .modal { border: none; border-radius: 18px; padding: 0; width: min(440px, calc(100vw - 2rem)); box-shadow: 0 40px 90px -30px rgba(10,25,47,0.45); }
    .modal::backdrop { background: rgba(10,25,47,0.38); backdrop-filter: blur(4px); }
    .m-form { display: flex; flex-direction: column; gap: 0.9rem; padding: 1.5rem 1.6rem 1.4rem; }
    .m-head { display: flex; align-items: center; justify-content: space-between; }
    .m-head h2 { font-size: 1.05rem; font-weight: 700; margin: 0; letter-spacing: -0.3px; }
    .m-close { background: var(--color-bg-soft); border: 1px solid var(--color-border); width: 30px; height: 30px; border-radius: 9px; cursor: pointer; font-size: 0.8rem; color: var(--color-text-muted); }
    .prom-ctx { font-size: 0.8rem; color: var(--color-text-muted); margin: -0.3rem 0 0; line-height: 1.45; }
    .prom-ctx b { color: var(--color-text); font-weight: 600; }
    .m-field { display: flex; flex-direction: column; gap: 0.4rem; }
    .m-field label { font-size: 0.62rem; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: #99a2af; }
    .m-input { font-family: var(--font-sans); font-size: 0.88rem; font-weight: 500; color: var(--color-text); background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: 9px; padding: 10px 12px; transition: border-color 0.25s; }
    .m-input:focus { outline: none; border-color: var(--color-blue-deep); }
    .m-error { font-size: 0.78rem; color: var(--color-danger); margin: 0; min-height: 1em; }
    .m-actions { display: flex; align-items: center; gap: 0.6rem; }
    .m-spacer { flex: 1; }
    .m-delete { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600; color: var(--color-danger); background: none; border: none; cursor: pointer; padding: 9px 4px; }
    .m-delete[hidden] { display: none; }
    .m-done { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600; color: #059669; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 9px; padding: 8px 14px; cursor: pointer; }
    .m-done[hidden] { display: none; }
    .m-save { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; background: var(--color-blue-deep); color: #fff; border: none; border-radius: 9px; padding: 9px 18px; cursor: pointer; box-shadow: 0 6px 18px -8px rgba(10,25,47,0.5); }
    .m-save:disabled { opacity: 0.6; cursor: wait; }

    /* Empty */
    .empty { padding: 4rem 2rem; text-align: center; }
    .empty h2 { font-size: 1.1rem; font-weight: 700; margin: 0 0 0.5rem; }
    .empty p { font-size: 0.88rem; color: var(--color-text-muted); max-width: 460px; margin: 0 auto 1.4rem; line-height: 1.6; }
    .empty-cta { display: inline-block; background: var(--color-blue-deep); color: #fff; text-decoration: none; font-size: 0.86rem; font-weight: 600; padding: 11px 20px; border-radius: 10px; }

    @media (max-width: 880px) {
        .t-head { display: none; }
        .t-row { grid-template-columns: 1fr auto auto; gap: 0.5rem 0.8rem; min-width: 0; }
        .t-muted, .t-folio { display: none; }
    }
    @media (max-width: 560px) {
        .t-estado { display: none; }
    }
    .cb-denied { display: flex; flex-direction: column; gap: 0.6rem; padding: 2rem 0; }
    .cb-denied svg { width: 32px; height: 32px; color: #c9d2de; }
    .cb-denied h3 { font-size: 1rem; font-weight: 700; margin: 0; }
    .cb-denied p { font-size: 0.84rem; color: var(--color-text-muted); margin: 0; line-height: 1.55; }
</style>

<script>
    // Cobranza: marcar cobrada (PATCH paid) + recordatorio por WhatsApp + promesa de pago.
    document.addEventListener('DOMContentLoaded', () => {
        const err = document.getElementById('cobErr');
        const E = err ? err.dataset : ({} as DOMStringMap);
        const tpl = (s: string, vars: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '');
        const cleanPhone = (t: string) => {
            const d = (t || '').replace(/\D/g, '');
            if (!d) return '';
            if (d.length === 10) return '52' + d;       // celular MX
            return d;
        };

        // ── Promesa de pago (modal) ──
        const promModal = document.getElementById('promModal') as HTMLDialogElement | null;
        const PM = promModal ? promModal.dataset : ({} as DOMStringMap);
        const $p = (id: string) => document.getElementById(id) as HTMLInputElement;
        let promRow: HTMLElement | null = null;
        const todayISO = () => new Date().toISOString().slice(0, 10);

        const openProm = (row: HTMLElement) => {
            if (!promModal) return;
            promRow = row;
            const d = row.dataset;
            const has = !!d.promId;
            document.getElementById('promTitle')!.textContent = has ? (PM.i18nEditar || 'Editar promesa de pago') : (PM.i18nNueva || 'Registrar promesa de pago');
            document.getElementById('promCtx')!.innerHTML = `<b>${d.empresa || PM.i18nClienteDefault || 'Cliente'}</b> · ${d.folio} · ${PM.i18nSaldo || 'saldo'} ${d.total}`;
            $p('promFecha').value = d.promFecha || '';
            $p('promFecha').min = todayISO();
            $p('promMonto').value = d.promMonto || '';
            $p('promNota').value = d.promNota || '';
            document.getElementById('promErr')!.textContent = '';
            (document.getElementById('promDel') as HTMLButtonElement).hidden = !has;
            (document.getElementById('promDone') as HTMLButtonElement).hidden = !has;
            (document.getElementById('promSave') as HTMLButtonElement).disabled = false;
            promModal.showModal();
        };

        document.getElementById('promClose')?.addEventListener('click', () => promModal?.close());

        const promApi = async (method: string, body: any) => {
            const res = await fetch('/api/promesas', { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || PM.i18nNoPudoGuardar || 'No se pudo guardar la promesa');
            return data;
        };

        document.getElementById('promForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!promRow) return;
            const save = document.getElementById('promSave') as HTMLButtonElement;
            const errP = document.getElementById('promErr')!;
            const fecha = $p('promFecha').value;
            if (!fecha) { errP.textContent = PM.i18nEligeFecha || 'Elige la fecha en que el cliente promete pagar.'; return; }
            save.disabled = true; errP.textContent = '';
            try {
                const oldId = promRow.dataset.promId;
                if (oldId) await promApi('DELETE', { id: oldId }); // reemplaza la promesa vigente
                await promApi('POST', {
                    cotizacion_id: promRow.dataset.id,
                    fecha_promesa: fecha,
                    monto: $p('promMonto').value || null,
                    nota: $p('promNota').value || null,
                });
                location.reload();
            } catch (e2: any) { errP.textContent = e2.message; save.disabled = false; }
        });

        document.getElementById('promDone')?.addEventListener('click', async () => {
            if (!promRow?.dataset.promId) return;
            const errP = document.getElementById('promErr')!;
            try { await promApi('PATCH', { id: promRow.dataset.promId, estado: 'cumplida' }); location.reload(); }
            catch (e2: any) { errP.textContent = e2.message; }
        });

        document.getElementById('promDel')?.addEventListener('click', async () => {
            if (!promRow?.dataset.promId) return;
            const errP = document.getElementById('promErr')!;
            try { await promApi('DELETE', { id: promRow.dataset.promId }); location.reload(); }
            catch (e2: any) { errP.textContent = e2.message; }
        });

        document.querySelectorAll<HTMLElement>('.t-row').forEach((row) => {
            const d = row.dataset;

            row.querySelector('.cob-prom')?.addEventListener('click', () => openProm(row));

            row.querySelector('.cob-whats')?.addEventListener('click', () => {
                const link = `${location.origin}/q/${d.token}`;
                const msg = tpl(E.i18nWaSaludoTpl || 'Hola{empresa}, le recordamos amablemente el saldo de la cotización {folio} por {total} (vence {vence}). Puede revisarla aquí: {link}. ¡Gracias!', {
                    empresa: d.empresa ? ' ' + d.empresa : '',
                    folio: d.folio || '',
                    total: d.total || '',
                    vence: d.vence || '',
                    link,
                });
                const phone = cleanPhone(d.tel || '');
                const url = phone
                    ? `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`
                    : `https://wa.me/?text=${encodeURIComponent(msg)}`;
                window.open(url, '_blank');
            });

            row.querySelector('.cob-paid')?.addEventListener('click', async (e) => {
                const btn = e.currentTarget as HTMLButtonElement;
                const body = tpl(E.i18nRegistrarBodyTpl || '¿Registrar el pago de {folio} por {total}?', { folio: d.folio || '', total: d.total || '' });
                if (!await (window as any).cordConfirm({ title: E.i18nRegistrarTitulo || 'Registrar pago', body, confirmText: E.i18nRegistrarBtn || 'Registrar pago' })) return;
                btn.disabled = true;
                if (err) err.textContent = '';
                try {
                    const res = await fetch(`/api/cotizaciones/${d.id}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'paid' }),
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || E.i18nNoPudoRegistrar || 'No se pudo registrar el pago');
                    // Optimista: quita la fila cobrada en sitio (los KPI/aging se
                    // recalculan en la próxima navegación).
                    row.remove();
                } catch (e2: any) {
                    if (err) err.textContent = e2.message;
                    btn.disabled = false;
                }
            });
        });
    });
</script>
