---
import AppLayout from '../../layouts/AppLayout.astro';
import '../../styles/modal.css';
import AccessGate from '../../components/app/AccessGate.astro';
import PlanGate from '../../components/app/PlanGate.astro';
import type { PaywallFeature } from '../../components/app/PlanUpsell.astro';
import DateRangePicker from '../../components/app/DateRangePicker.astro';
import MonedaNota from '../../components/app/MonedaNota.astro';
import ReportPicker from '../../components/app/ReportPicker.astro';
import WidgetGrid from '../../components/app/WidgetGrid.astro';
import WidgetCustomizeButtons from '../../components/app/WidgetCustomizeButtons.astro';
import ResumenReport from '../../components/app/informes/ResumenReport.astro';
import ComercialReport from '../../components/app/informes/ComercialReport.astro';
import FinanzasReport from '../../components/app/informes/FinanzasReport.astro';
import FlujoReport from '../../components/app/informes/FlujoReport.astro';
import CobranzaReport from '../../components/app/informes/CobranzaReport.astro';
import ClientesReport from '../../components/app/informes/ClientesReport.astro';
import ProductosReport from '../../components/app/informes/ProductosReport.astro';
import TablaReport from '../../components/app/informes/TablaReport.astro';
import ExplorerControls from '../../components/app/informes/ExplorerControls.astro';
import { getMyMembership } from '../../lib/queries';
import { memberCan } from '../../lib/permissions';
import { REPORTS, REPORT_BY_ID, parseGranularity, parseReportId, reportLabel, type ReportId } from '../../lib/informes';
import { loadReport } from '../../lib/informes-data';
import { DEFAULT_CONFIG, configFromSearch } from '../../lib/informes-explorar';
import { getGuardado, listGuardados } from '../../lib/informes-guardados';
import { actor as guardadosActor } from '../../lib/informes-guardados-http';
import { addDaysISO, parseRangoParams } from '../../lib/rango';
import { todayInZone } from '../../lib/report-scope';
import { currentLocale, currentTimeZone } from '../../lib/context';
import { t, type AppStringKey } from '../../i18n/app';
import { dateFull } from '../../lib/fmt';
import { getActiveOrgId } from '../../lib/db';
import { checkEntitlement } from '../../lib/org-entitlements';

const L = currentLocale();
const es = L !== 'en';
const ME = await getMyMembership();
// Gate primario antes de cualquier consulta analítica.
const hasAnalytics = memberCan(ME, 'analitica');
const reportId = parseReportId(Astro.url.searchParams.get('r'));
const report = REPORT_BY_ID[reportId];
const premiumFeature = reportId === 'finanzas' ? 'cfo_dashboard' : reportId === 'flujo' ? 'cashflow_90' : reportId === 'cobranza' ? 'collections' : null;
const entitlementCheck = premiumFeature ? await checkEntitlement(await getActiveOrgId(), premiumFeature) : null;
const subscriptionAccess = entitlementCheck ? entitlementCheck.ok : true;
// Los tres motivos de bloqueo se distinguen explícitamente porque cada uno pide
// una acción distinta: sin `analitica`/`report.perm` hay que pedírselo a un admin
// (AccessGate reason="perm", sin CTA); sin el plan hay que subir de plan (reason="plan",
// con CTA a /app/ajustes/plan). Antes los tres colapsaban en un solo mensaje genérico
// de "pídeselo al administrador" — confuso para un owner al que le falta el PLAN, no el
// permiso (él mismo es el administrador).
const hasPerm = hasAnalytics && memberCan(ME, report.perm);
const hasReportAccess = hasPerm && subscriptionAccess;
const allowed = hasAnalytics
    ? REPORTS.filter((item) => memberCan(ME, item.perm)).map((item) => item.id)
    : [];
// "Hoy" del negocio (orgs.zona_horaria), no el del servidor: regla 24.
const todayISO = todayInZone(currentTimeZone());
const minISO = addDaysISO(todayISO, -364);
const rango = parseRangoParams(Astro.url.searchParams, { minISO, maxISO: todayISO, anchorISO: todayISO, fallback: '30' });
const granularity = parseGranularity(Astro.url.searchParams.get('g'));
// Explorador (fase 5): la configuración sale de la URL; un informe guardado
// (?guardado=) la pone cuando la URL todavía no trae una propia.
const isExplorer = report.kind === 'explorador';
const actorG = hasAnalytics ? await guardadosActor() : null;
// Los guardados son un extra del selector: si su consulta falla (p. ej. la tabla
// todavía no migra en un entorno), Informes sigue funcionando sin ellos.
const guardados = actorG ? await listGuardados(actorG).catch(() => []) : [];
const guardadoId = isExplorer ? Astro.url.searchParams.get('guardado') : null;
const saved = actorG && guardadoId ? await getGuardado(actorG, guardadoId).catch(() => null) : null;
const urlHasConfig = Astro.url.searchParams.has('dim') || Astro.url.searchParams.has('m');
const explorerConfig = isExplorer ? (urlHasConfig || !saved ? configFromSearch(Astro.url.searchParams) : saved.config) : DEFAULT_CONFIG;
const payload = hasReportAccess ? await loadReport(reportId, rango, { g: granularity, x: isExplorer ? explorerConfig : undefined }) : null;
const isTabla = report.kind !== 'widgets';
const data = payload ? (payload as any)[isTabla ? 'tabla' : reportId === 'resumen' || reportId === 'comercial' ? 'diagnosis' : reportId === 'finanzas' || reportId === 'flujo' ? 'cfo' : reportId === 'cobranza' ? 'cobranza' : 'analytics'] : null;
// Parámetros del rango en la URL (export CSV y selector de granularidad): el rango
// que se pintó, no el que el navegador tenga guardado.
const rangeQuery = (extra: Record<string, string> = {}) => {
    const q = new URLSearchParams();
    if (rango.key === 'custom') { q.set('desde', rango.desde); q.set('hasta', rango.hasta); } else q.set('rango', String(rango.key));
    for (const [k, v] of Object.entries(extra)) q.set(k, v);
    return q.toString();
};
const rangeParams = Object.fromEntries(new URLSearchParams(rangeQuery()));
const explorerParams = isExplorer ? `&dim=${explorerConfig.dim}&m=${explorerConfig.m.join(',')}` : '';
const csvHref = `/api/informes/${reportId}?${rangeQuery({ format: 'csv', ...(granularity ? { g: granularity } : {}) })}${explorerParams}`;
const granHref = reportId === 'ventas' ? (g: string) => `/app/informes?r=${reportId}&${rangeQuery({ g })}` : undefined;
// Drill-down en el tiempo: el mes (o la semana) de la barra con el mismo informe; en
// el explorador, un nivel más fino de "agrupar por". Un rango nuevo elige solo su
// granularidad, así que el link no la fija.
const finer: Record<string, string> = { mes: 'semana', semana: 'dia' };
const zoomHref = reportId === 'ventas'
    ? (desde: string, hasta: string) => `/app/informes?r=ventas&desde=${desde}&hasta=${hasta}`
    : isExplorer && finer[explorerConfig.dim]
        ? (desde: string, hasta: string) => `/app/informes?r=explorar&desde=${desde}&hasta=${hasta}&dim=${finer[explorerConfig.dim]}&m=${explorerConfig.m.join(',')}`
        : undefined;
const heading = saved?.nombre ?? reportLabel(report, L);
const widgetLabels = {
    drag: es ? 'Arrastrar widget' : 'Drag widget', up: es ? 'Subir widget' : 'Move widget up',
    down: es ? 'Bajar widget' : 'Move widget down', resize: es ? 'Cambiar tamaño' : 'Resize widget',
    remove: es ? 'Ocultar widget' : 'Hide widget',
};
import { iconInner } from '../../lib/icons';
---

<AppLayout title={`${heading} — Cord`} page="informes" heading={heading}>
    <p slot="page-sub">{es ? 'Una sola casa para entender el desempeño y decidir qué mover.' : 'One place to understand performance and decide what to move.'}</p>
    <Fragment slot="topbar-actions">
        <div class="reports-top-actions">
            <ReportPicker current={reportId} locale={L} allowed={allowed as ReportId[]} saved={guardados.map((g) => ({ id: g.id, nombre: g.nombre }))} currentSaved={saved?.id ?? null} />
            {report.scope === 'rango' ? (
                <DateRangePicker minISO={minISO} maxISO={todayISO} initialKey={rango.key as any} initialDesde={rango.desde} initialHasta={rango.hasta} storageKey={`cord.report.${reportId}.range.v1`} />
            ) : (
                <span class="snapshot-chip">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('calendar')}></svg>
                    {es ? `Al día de hoy · ${dateFull(todayISO, L)}` : `As of today · ${dateFull(todayISO, L)}`}
                </span>
            )}
            {hasReportAccess && !isTabla && <WidgetCustomizeButtons editId="reportEditBtn" resetId="reportResetBtn" doneId="reportDoneBtn" />}
        </div>
    </Fragment>

    {!hasAnalytics && <AccessGate title={t(L, 'an.sin_acceso_titulo')} desc={t(L, 'an.sin_acceso_desc')} />}
    {hasAnalytics && !hasPerm && <AccessGate reason="perm" title={t(L, 'an.informe_restringido_titulo')} desc={t(L, 'an.informe_restringido_desc')} />}
    {hasAnalytics && hasPerm && !subscriptionAccess && entitlementCheck && (
        <PlanGate
            id="informesPlanModal"
            title={t(L, `an.plan.${reportId}.titulo` as AppStringKey)}
            desc={t(L, `an.plan.${reportId}.desc` as AppStringKey)}
            requiredPlan={entitlementCheck.requiredPlan}
            locale={L === 'en' ? 'en' : 'es'}
            preview={reportId === 'cobranza' ? 'cobranza' : 'informe'}
            feature={`informe_${reportId}` as PaywallFeature} />
    )}

    {hasReportAccess && data && isTabla && (
        <div data-report-shell data-report-kind="tabla" data-report-type={report.kind} data-report-saved={saved ? '1' : undefined}
            data-report-dim={isExplorer ? explorerConfig.dim : undefined} data-report-metrics={isExplorer ? String(explorerConfig.m.length) : undefined}
            data-report-id={reportId} data-locale={L} data-desde={rango.desde} data-hasta={rango.hasta}>
            {isExplorer && <ExplorerControls config={explorerConfig} L={L} range={rangeParams} saved={saved} />}
            <TablaReport data={data} L={L} reportId={reportId} csvHref={csvHref} granHref={granHref as any} zoomHref={zoomHref} />
            <MonedaNota nota={data.moneda} />
        </div>
    )}

    {hasReportAccess && data && !isTabla && (
        <div data-report-shell data-report-type="widgets" data-report-id={reportId} data-locale={L} data-desde={rango.desde} data-hasta={rango.hasta}
            data-labels={JSON.stringify({
                status: Object.fromEntries(['sent', 'viewed', 'approved', 'paid', 'invoiced'].map((k) => [k, t(L, `cot.col.${k}` as any)])),
                etapa: Object.fromEntries(['created_sent', 'sent_viewed', 'viewed_approved', 'approved_paid'].map((k) => [k, t(L, `inf.etapa.${k}` as any)])),
                vacio: t(L, 'inf.sin_resultados_rango'),
            })}>
        <WidgetGrid id="reportWidgets" storageKey={`cord.report.${reportId}.v1`} serverPrefs={ME.widgetPrefs?.[`cord.report.${reportId}.v1`] as Record<string, unknown> | undefined} editButtonId="reportEditBtn" doneButtonId="reportDoneBtn" resetButtonId="reportResetBtn" resetConfirm={es ? '¿Restablecer este informe?' : 'Reset this report?'} labels={widgetLabels}>
            {reportId === 'resumen' && <ResumenReport data={data} L={L} />}
            {reportId === 'comercial' && <ComercialReport data={data} L={L} />}
            {reportId === 'finanzas' && <FinanzasReport data={data} L={L} />}
            {reportId === 'flujo' && <FlujoReport data={data} L={L} />}
            {reportId === 'cobranza' && <CobranzaReport data={data} L={L} />}
            {reportId === 'clientes' && <ClientesReport data={data} L={L} />}
            {reportId === 'productos' && <ProductosReport data={data} L={L} />}
        </WidgetGrid>
        <MonedaNota nota={(data as any).moneda} />
        </div>
    )}
</AppLayout>

<script>
    import { mountAll, remount } from '../../lib/chart-mount';
    import { money as formatMoney } from '../../lib/fmt';
    mountAll(document);

    const shell = document.querySelector<HTMLElement>('[data-report-shell]');
    const reportId = shell?.dataset.reportId;
    const locale = shell?.dataset.locale || 'es';
    const es = locale !== 'en';
    // Vista de informe (regla 35): desde el navegador, una vez por carga; el
    // prefetch del selector no ejecuta este script, así que no cuenta como vista.
    // Regla 13: se difiere a DOMContentLoaded para que el bootstrap de PostHog ya exista.
    document.addEventListener('DOMContentLoaded', () => {
        if (!shell || !reportId) return;
        const kind = shell.dataset.reportType === 'explorador' ? 'explorador' : shell.dataset.reportType === 'tabla' ? 'tabla' : 'widgets';
        (window as any).cordTrack?.('report_viewed', {
            report_id: reportId, kind, saved: shell.dataset.reportSaved === '1',
            dim: shell.dataset.reportDim, metric_count: shell.dataset.reportMetrics ? Number(shell.dataset.reportMetrics) : undefined,
        });
    });
    const widget = (id: string) => shell?.querySelector<HTMLElement>(`[data-widget="${id}"]`);
    const text = (selector: string, value: string) => { const el = shell?.querySelector<HTMLElement>(selector); if (el) el.textContent = value; };
    const setChart = (widgetId: string, data: Record<string, unknown>) => {
        const chart = widget(widgetId)?.querySelector<HTMLElement>('[data-chart]');
        if (chart) remount(chart, data);
    };
    const pct = (a: number, b: number) => b ? Math.round(a / b * 100) : 0;
    const labels = (() => { try { return JSON.parse(shell?.dataset.labels || '{}'); } catch { return {}; } })() as {
        status?: Record<string, string>; etapa?: Record<string, string>; vacio?: string;
    };
    // Reconstruye una lista con el MISMO markup que el SSR: fila enlazada cuando hay
    // destino (si no, el clic que funcionaba al cargar dejaba de funcionar tras cambiar
    // el rango) y un estado vacío en lugar de una tarjeta en blanco.
    const clearAndRows = (host: HTMLElement | null | undefined, rows: any[], fields: (row: any) => [string, string, string, string?]) => {
        if (!host) return; host.innerHTML = '';
        if (!rows.length) {
            const empty = document.createElement('p'); empty.className = 'report-empty'; empty.textContent = labels.vacio || '';
            host.append(empty); return;
        }
        rows.forEach((row) => {
            const [title, sub, value, href] = fields(row);
            const line = document.createElement(href ? 'a' : 'div');
            if (href) (line as HTMLAnchorElement).href = href;
            const copy = document.createElement('span');
            const strong = document.createElement('strong'); strong.textContent = title;
            const small = document.createElement('small'); small.textContent = sub;
            const amount = document.createElement('b'); amount.className = 'editorial'; amount.textContent = value;
            copy.append(strong, small); line.append(copy, amount); host.append(line);
        });
    };
    function paintMetric(widgetId: string, value: string | number, details: (string | number)[] = []) {
        const w = widget(widgetId);
        if (!w) return;
        const num = w.querySelector<HTMLElement>('.kpi-num');
        if (num) num.textContent = String(value);
        w.querySelectorAll<HTMLElement>('[data-widget-detail] dd').forEach((dd, i) => { if (details[i] !== undefined) dd.textContent = String(details[i]); });
    }
    function paintRangeData(payload: any) {
        const wrapped = payload?.data;
        if (!wrapped || !reportId) return;
        if (reportId === 'resumen') {
            const D = wrapped.diagnosis;
            const lostN = D.losses.rejected.n + D.losses.expired.n;
            const lost = D.losses.rejected.monto + D.losses.expired.monto;
            const won = pct(D.summary.approved, D.summary.sent), lostPct = pct(lostN, D.summary.sent);
            text('[data-report-bind="close-rate"]', `${won}%`);
            text('[data-report-bind="close-rate-sub"]', `${D.summary.approved} / ${D.summary.sent} ${es ? 'cotizaciones enviadas' : 'sent quotes'}`);
            text('[data-report-bind="closed"]', formatMoney(D.summary.cerrado, locale));
            text('[data-report-bind="velocity"]', formatMoney(D.summary.cerrado / Math.max(1, D.series.length), locale));
            text('[data-report-bind="lost"]', formatMoney(lost, locale));
            text('[data-report-bind="lost-sub"]', `${lostN} ${es ? 'cotizaciones' : 'quotes'}`);
            setChart('resumen-evolucion', { points: D.series.map((day: any) => ({ x: day.fecha, y: day.cerrado })) });
            // Sin envíos en el rango no hay cohorte: estado vacío, no una barra "100% abierta".
            setChart('resumen-madurez', { segments: !D.summary.sent ? [] : [
                { key: 'won', label: es ? 'Ganado' : 'Won', value: won, color: '#059669' },
                { key: 'lost', label: es ? 'Perdido' : 'Lost', value: lostPct, color: '#ef4444' },
                { key: 'open', label: es ? 'Aún abierto' : 'Still open', value: Math.max(0, 100 - won - lostPct), color: '#8b95a5' },
            ] });
            paintMetric('resumen-opcional-decididas', D.summary.approved + lostN, [D.summary.approved, D.losses.rejected.n, D.losses.expired.n]);
        } else if (reportId === 'comercial') {
            const D = wrapped.diagnosis;
            setChart('comercial-embudo', { steps: [
                { label: es ? 'Enviadas' : 'Sent', value: D.funnel.sent }, { label: es ? 'Vistas' : 'Viewed', value: D.funnel.views },
                { label: es ? 'Aprobadas' : 'Approved', value: D.funnel.approved }, { label: es ? 'Pagadas' : 'Paid', value: D.funnel.paid },
            ] });
            setChart('comercial-pipeline', { items: D.pipeline.map((row: any) => ({ label: labels.status?.[row.key] ?? row.key, value: row.monto, sub: String(row.n) })) });
            setChart('comercial-descuento', { items: D.discounts.map((row: any) => ({ label: row.nombre, value: row.cedido, sub: `${Math.round(row.pct)}%` })) });
            setChart('comercial-tiempo-etapa', { items: D.stageTiming.map((row: any) => ({ label: labels.etapa?.[row.key] ?? row.key, value: row.dias, sub: es ? 'días' : 'days' })) });
            clearAndRows(widget('comercial-detenidas')?.querySelector<HTMLElement>('.report-list'), D.stalled, (row) => [row.empresa, `${row.folio} · ${row.dias}d`, formatMoney(row.total, locale), `/app/cotizaciones/${row.id}`]);
            paintMetric('comercial-opcional-atencion', D.stalled.length);
        } else if (reportId === 'clientes') {
            const D = wrapped.analytics;
            setChart('clientes-ranking', { items: D.clientes.map((row: any) => ({ label: row.empresa, value: row.cerrado, sub: `${row.tasa}%` })) });
            clearAndRows(widget('clientes-tabla')?.querySelector<HTMLElement>('.report-list'), D.clientes, (row) => [row.empresa, `${row.aprobadas} / ${row.cotizaciones} · ${row.tasa}%`, formatMoney(row.cerrado, locale), row.id ? `/app/clientes/${row.id}` : undefined]);
            setChart('clientes-cohortes', { items: D.cohortes.map((row: any) => ({ label: row.tipo === 'nuevo' ? (es ? 'Nuevos' : 'New') : (es ? 'Recurrentes' : 'Returning'), value: row.cerrado, sub: String(row.clientes) })) });
            clearAndRows(widget('clientes-riesgo')?.querySelector<HTMLElement>('.report-list'), D.enRiesgo, (row) => [row.empresa, `${row.nivel} · ${row.cotizaciones} ${es ? 'cotizaciones' : 'quotes'}`, formatMoney(row.cerrado, locale), `/app/clientes/${row.id}`]);
            paintMetric('clientes-opcional-riesgo', D.enRiesgo.length);
        } else if (reportId === 'productos') {
            const D = wrapped.analytics;
            setChart('productos-importe', { items: D.productos.map((row: any) => ({ label: row.nombre, value: row.importe, sub: String(row.cotizaciones) })) });
            clearAndRows(widget('productos-volumen')?.querySelector<HTMLElement>('.report-list'), D.productos, (row) => [row.nombre, `${row.cotizaciones} ${es ? 'cotizaciones' : 'quotes'}`, `${row.cantidad} · ${formatMoney(row.importe, locale)}`]);
            setChart('productos-elasticidad', { items: D.pricingBands.map((row: any) => ({ label: `${row.band}%`, value: row.winRate * 100, sub: `n=${row.sample}` })) });
            setChart('productos-cierre', { items: D.cierre.map((row: any) => ({ label: row.nombre, value: row.tasa, sub: `n=${row.decididas}` })) });
            setChart('productos-opcional-unidades', { items: D.productos.map((row: any) => ({ label: row.nombre, value: row.cantidad })) });
        }
    }
    let request: AbortController | null = null;
    document.addEventListener('cord:range', async (event) => {
        const detail = (event as CustomEvent).detail;
        if (!reportId || location.pathname !== '/app/informes') return;
        // El emit inicial solo se ignora si el picker resolvió el MISMO rango que pintó el
        // servidor. Si resolvió otro (rango guardado en este navegador, o un link sin
        // ?rango=), los números tienen que seguir a la etiqueta, no al revés.
        if (detail?.initial && detail.desde === shell?.dataset.desde && detail.hasta === shell?.dataset.hasta) return;
        // Los informes tabla se arman en el servidor (tabla completa, totales, CSV): un
        // rango nuevo es una carga nueva. El picker ya escribió el rango en la URL.
        if (shell?.dataset.reportKind === 'tabla') { location.assign(location.href); return; }
        request?.abort(); request = new AbortController();
        shell?.setAttribute('aria-busy', 'true');
        try {
            const response = await fetch(`/api/informes/${reportId}${location.search}`, { signal: request.signal });
            if (!response.ok) throw new Error(String(response.status));
            paintRangeData(await response.json());
        } catch (error) {
            if ((error as Error).name !== 'AbortError') (window as any).cordToast?.(es ? 'No se pudo actualizar el informe' : 'Could not update report');
        } finally { shell?.removeAttribute('aria-busy'); }
    });
</script>

<style>
    /* Selector de informe + fechas + acciones: SIEMPRE pegados a la derecha, exista o no
       texto a la izquierda (`margin-left: auto` no depende del ancho del hermano). */
    .reports-top-actions { display: flex; align-items: center; justify-content: flex-end; margin-left: auto; gap: .55rem; flex-wrap: wrap; }
    .snapshot-chip { min-height: 42px; display: inline-flex; align-items: center; gap: .55rem; padding: .62rem .9rem; border: 0; border-radius: 999px; font: inherit; font-size: .78rem; font-weight: 650; white-space: nowrap; }
    /* ⚠️ Rescue obligatorio: un `display` de autor SIEMPRE le gana al `[hidden]{display:none}`
       del navegador. El de los tres botones de personalización vive junto a ellos en
       styles/widgets.css; este es el del chip, que esta página sí renderiza. */
    .snapshot-chip[hidden] { display: none; }
    .snapshot-chip { background: var(--color-bg-soft); color: var(--color-text-muted); }
    .snapshot-chip svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; }
    /* El grid vive en styles/widgets.css (global) — ver la nota ahí. Esta página comparte
       exactamente el mismo grid, gap y breakpoints que /app. */
    [data-report-shell][aria-busy='true'] { opacity: .68; pointer-events: none; transition: opacity .18s ease; }
    /* El vocabulario de widgets (.report-kpi, .report-list, .report-chart, .report-focus,
       .snapshot-tag, .flow-*) vive en styles/report-widgets.css — lo renderizan los
       componentes informes/*Report.astro, no esta página, así que un `<style>` scopeado
       nunca los alcanzaría (Regla 11). Desde ago 2026 lo comparten además /app/cobros y
       /app/cobranza. Aquí solo queda lo que ESTA página emite: las acciones de la topbar
       y el estado sin acceso. Los breakpoints del grid siguen en widgets.css. */
    @media (max-width: 880px) {
        .reports-top-actions { width: 100%; justify-content: flex-start; flex-wrap: wrap; padding-bottom: 2px; scrollbar-width: none; }
        .reports-top-actions::-webkit-scrollbar { display: none; }
        .reports-top-actions > * { flex: 0 0 auto; }
        .snapshot-chip { min-height: 44px; }
    }
</style>
