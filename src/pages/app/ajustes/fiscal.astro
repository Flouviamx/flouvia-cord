---
// Ajustes › Datos fiscales
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg } from '../../../lib/queries';
import { REGIMENES_FISCALES, USOS_CFDI } from '../../../lib/sat';
import { getCountryProfile } from '../../../lib/countries';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
const ORG = await getOrg();
const L = currentLocale();
const isMx = ORG.countryCode === 'MX';
const PROFILE = getCountryProfile(ORG.countryCode, L);
const FM = ORG.fiscalMetadata || {};
---

<SettingsShell title="Datos fiscales — Ajustes" tab="fiscal" perm="ajustes"
    intro={isMx
        ? t(L, 'set.fiscal.intro')
        : (L === 'en'
            ? `Configure the identity shown on invoices issued in ${PROFILE.name}.`
            : `Configura la identidad que aparecerá en tus facturas emitidas en ${PROFILE.name}.`)} save>
    {!isMx && (
        <div class="fiscal-capability">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" fill-opacity="0.12"/><line x1="12" y1="8" x2="12" y2="12.5"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
                <strong>{L === 'en' ? 'Commercial invoices are active for your country.' : 'Las facturas comerciales ya están activas para tu país.'}</strong>
                <p>{L === 'en'
                    ? 'Cord assigns the number, preserves an immutable copy, and generates the PDF. Submission or clearance by your local tax authority is not connected yet.'
                    : 'Cord asigna el folio, conserva una copia inmutable y genera el PDF. La presentación o autorización ante tu autoridad fiscal local todavía no está conectada.'}</p>
            </div>
        </div>
    )}

    {!isMx && (
        <div class="s-block">
            <h3>{L === 'en' ? 'Invoice identity' : 'Identidad de facturación'}</h3>
            <div class="s-body">
                <div class="s-row">
                    <div class="s-field">
                        <label for="fLegalName">{L === 'en' ? 'Legal name' : 'Razón social o nombre legal'}</label>
                        <input class="s-input" id="fLegalName" data-field="fiscal_legal_name" value={FM.legal_name || ORG.razonSocial || ORG.nombre} maxlength="200" />
                    </div>
                    <div class="s-field">
                        <label for="fTaxId">{PROFILE.taxIdLabel}</label>
                        <input class="s-input" id="fTaxId" data-field="fiscal_tax_id" value={FM.tax_id || ORG.rfc} maxlength="64" autocomplete="off" />
                    </div>
                </div>
                <div class="s-field">
                    <label for="fAddress1">{L === 'en' ? 'Address' : 'Domicilio fiscal'}</label>
                    <input class="s-input" id="fAddress1" data-field="fiscal_address_line1" value={FM.address_line1 || ORG.direccion} maxlength="200" />
                </div>
                <div class="s-field">
                    <label for="fAddress2">{L === 'en' ? 'Suite, floor, or additional details' : 'Interior, piso o datos adicionales'}</label>
                    <input class="s-input" id="fAddress2" data-field="fiscal_address_line2" value={FM.address_line2 || ''} maxlength="200" />
                </div>
                <div class="s-row">
                    <div class="s-field">
                        <label for="fCity">{L === 'en' ? 'City' : 'Ciudad'}</label>
                        <input class="s-input" id="fCity" data-field="fiscal_city" value={FM.city || ''} maxlength="100" />
                    </div>
                    <div class="s-field">
                        <label for="fRegion">{L === 'en' ? 'State or region' : 'Estado, provincia o región'}</label>
                        <input class="s-input" id="fRegion" data-field="fiscal_region" value={FM.region || ''} maxlength="100" />
                    </div>
                </div>
                <div class="s-row">
                    <div class="s-field">
                        <label for="fPostal">{L === 'en' ? 'Postal code' : 'Código postal'}</label>
                        <input class="s-input" id="fPostal" data-field="fiscal_postal_code" value={FM.postal_code || ''} maxlength="20" />
                    </div>
                    <div class="s-field">
                        <label for="fPrefix">{L === 'en' ? 'Invoice prefix' : 'Prefijo de factura'}</label>
                        <input class="s-input" id="fPrefix" data-field="fiscal_invoice_prefix" value={FM.invoice_prefix || PROFILE.invoicePrefix} maxlength="12" />
                        <span class="s-hint">{L === 'en' ? 'Example: INV-000001' : 'Ejemplo: INV-000001'}</span>
                    </div>
                </div>
                <a class="fact-link" href="/app/ajustes/facturas">{L === 'en' ? 'View issued invoices' : 'Ver facturas emitidas'}</a>
            </div>
        </div>
    )}

    <div class="s-block" style={isMx ? undefined : 'display:none;'}>
        <h3>{t(L, 'set.fiscal.identificacion')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label for="oRfc">{t(L, 'set.fiscal.rfc')}</label>
                    <input class="s-input" id="oRfc" data-field="rfc" value={ORG.rfc} maxlength="13" placeholder="XAXX010101000" />
                </div>
                <div class="s-field">
                    <label for="oRazon">{t(L, 'set.fiscal.razon_social')}</label>
                    <input class="s-input" id="oRazon" data-field="razon_social" value={ORG.razonSocial} placeholder={t(L, 'set.fiscal.razon_ph')} />
                </div>
            </div>
            <div class="s-row">
                <div class="s-field">
                    <label for="oRegimen">{t(L, 'set.fiscal.regimen')}</label>
                    <select class="s-input" id="oRegimen" data-field="regimen_fiscal">
                        <option value="" selected={!ORG.regimenFiscal}>{t(L, 'set.fiscal.selecciona')}</option>
                        {REGIMENES_FISCALES.map((r) => <option value={r.codigo} selected={ORG.regimenFiscal === r.codigo}>{r.nombre}</option>)}
                    </select>
                </div>
                <div class="s-field">
                    <label for="oCp">{t(L, 'set.fiscal.cp')}</label>
                    <input class="s-input" id="oCp" data-field="cp_fiscal" value={ORG.cpFiscal} maxlength="5" inputmode="numeric" placeholder="54000" />
                    <span class="s-hint">{t(L, 'set.fiscal.cp_hint')}</span>
                </div>
            </div>
            <div class="s-field" style="max-width:50%">
                <label for="oUso">{t(L, 'set.fiscal.uso_cfdi')}</label>
                <select class="s-input" id="oUso" data-field="uso_cfdi">
                    <option value="" selected={!ORG.usoCfdi}>{t(L, 'set.fiscal.selecciona')}</option>
                    {USOS_CFDI.map((u) => <option value={u.codigo} selected={ORG.usoCfdi === u.codigo}>{u.nombre}</option>)}
                </select>
                <span class="s-hint">{t(L, 'set.fiscal.uso_cfdi_hint')}</span>
            </div>
        </div>
    </div>

    <div class="s-block" style={isMx ? undefined : 'display:none;'}>
        <h3>{t(L, 'set.fiscal.csd')}</h3>
        <p class="csd-intro">{t(L, 'set.fiscal.csd_intro')}</p>

        <div class="csd-state" id="csdState" data-on={ORG.csdEstado === 'cargado' ? '1' : '0'}
            data-i18n-cargado={t(L, 'set.fiscal.csd_cargado')} data-i18n-sin-csd={t(L, 'set.fiscal.sin_csd')}
            data-i18n-cert-activo={t(L, 'set.fiscal.certificado_activo')} data-i18n-sube={t(L, 'set.fiscal.sube_cer_key')}
            data-i18n-elige-cer={t(L, 'set.fiscal.elige_cer')} data-i18n-elige-key={t(L, 'set.fiscal.elige_key')}
            data-i18n-elige-ambos={t(L, 'set.fiscal.elige_ambos')} data-i18n-escribe-pass={t(L, 'set.fiscal.escribe_contrasena')}
            data-i18n-subiendo={t(L, 'set.fiscal.subiendo')} data-i18n-csd-ok={t(L, 'set.fiscal.csd_ok')}
            data-i18n-no-subio={t(L, 'set.fiscal.no_se_pudo_subir')} data-i18n-conectado-toast={t(L, 'set.fiscal.csd_conectado_toast')}
            data-i18n-quitar-titulo={t(L, 'set.fiscal.quitar_csd_titulo')} data-i18n-quitar-body={t(L, 'set.fiscal.quitar_csd_body')}
            data-i18n-quitar={t(L, 'set.fiscal.quitar')} data-i18n-removido={t(L, 'set.fiscal.csd_removido')}
            data-i18n-no-quito={t(L, 'set.fiscal.no_se_pudo_quitar')} data-i18n-conectado={t(L, 'set.fiscal.conectado')}
            data-i18n-sin-conectar={t(L, 'set.fiscal.sin_conectar')}>
            <span class="csd-state-dot"></span>
            <span class="csd-state-info">
                <span class="csd-state-title" id="csdStateTitle">{ORG.csdEstado === 'cargado' ? t(L, 'set.fiscal.csd_cargado') : t(L, 'set.fiscal.sin_csd')}</span>
                <span class="csd-state-sub" id="csdName">{ORG.csdEstado === 'cargado' ? (ORG.csdNombre || t(L, 'set.fiscal.certificado_activo')) : t(L, 'set.fiscal.sube_cer_key')}</span>
            </span>
            <button type="button" class="csd-btn-ghost" id="csdRemove" style={ORG.csdEstado === 'cargado' ? '' : 'display:none'}>{t(L, 'set.fiscal.quitar')}</button>
        </div>

        <div class="csd-files">
            <label class="csd-drop" id="cerDrop">
                <input type="file" id="cerFile" accept=".cer" />
                <span class="csd-drop-ico">.cer</span>
                <span class="csd-drop-t">{t(L, 'set.fiscal.certificado')}</span>
                <span class="csd-drop-s" id="cerName">{t(L, 'set.fiscal.elige_cer')}</span>
            </label>
            <label class="csd-drop" id="keyDrop">
                <input type="file" id="keyFile" accept=".key" />
                <span class="csd-drop-ico">.key</span>
                <span class="csd-drop-t">{t(L, 'set.fiscal.llave_privada')}</span>
                <span class="csd-drop-s" id="keyName">{t(L, 'set.fiscal.elige_key')}</span>
            </label>
        </div>
        <div class="s-field" style="max-width:50%; margin-top:1rem">
            <label for="oCsdPass">{t(L, 'set.fiscal.contrasena')}</label>
            <input class="s-input" id="oCsdPass" type="password" placeholder="••••••••" autocomplete="off" />
            <span class="s-hint">{t(L, 'set.fiscal.contrasena_hint')}</span>
        </div>
        <div class="csd-actions">
            <button type="button" class="csd-btn-solid" id="csdUpload">{t(L, 'set.fiscal.subir_csd')}</button>
            <span class="csd-msg" id="csdMsg"></span>
        </div>
        <a class="fact-link" href="/app/ajustes/facturas">{t(L, 'set.fiscal.ver_facturas')}</a>
    </div>
</SettingsShell>

<style>
    .fiscal-capability { display: flex; gap: 12px; align-items: flex-start; background: rgba(10,25,47,0.045); border: 1px solid rgba(10,25,47,0.1); border-radius: 16px; padding: 15px 17px; margin-bottom: 1.8rem; color: var(--color-blue-deep); }
    html[data-theme="dark"] .fiscal-capability { color: #b9cff8; background: rgba(127,176,255,0.08); border-color: rgba(127,176,255,0.16); }
    .fiscal-capability svg { flex-shrink: 0; width: 20px; height: 20px; margin-top: 1px; }
    .fiscal-capability strong { display: block; font-size: 0.88rem; margin-bottom: 4px; }
    .fiscal-capability p { margin: 0; font-size: 0.82rem; line-height: 1.5; color: var(--color-text-muted); }
    .csd-intro { font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.55; margin: 0 0 1.1rem; }
    .csd-intro b { color: var(--color-text); font-weight: 600; }
    .csd-files { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .csd-drop { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; border: 1.5px dashed var(--color-border); border-radius: 12px; padding: 1.4rem 1rem; cursor: pointer; background: var(--color-bg-soft); transition: border-color 0.2s, background 0.2s; }
    .csd-drop:hover { border-color: var(--color-blue-deep); }
    .csd-drop.has-file { border-style: solid; border-color: var(--color-ok); background: rgba(16,185,129,0.06); }
    .csd-drop input { display: none; }

    /* Estado del CSD */
    .csd-state { display: flex; align-items: center; gap: 11px; border: 1px solid var(--color-border); border-radius: 10px; padding: 12px 14px; margin-bottom: 1.1rem; }
    .csd-state-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--color-text-muted); flex-shrink: 0; }
    .csd-state[data-on="1"] .csd-state-dot { background: var(--color-ok); box-shadow: 0 0 0 3px rgba(16,185,129,0.18); }
    .csd-state-info { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
    .csd-state-title { font-size: 0.86rem; font-weight: 600; color: var(--color-text); }
    .csd-state-sub { font-size: 0.76rem; color: var(--color-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Acciones + botones (estilo Cord, dark-safe) */
    .csd-actions { display: flex; align-items: center; gap: 0.7rem; margin-top: 1.1rem; }
    .csd-btn-solid { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 9px; padding: 9px 18px; cursor: pointer; transition: transform 0.2s var(--ease-spring), opacity 0.2s; }
    .csd-btn-solid:hover { transform: translateY(-1px); }
    .csd-btn-solid:disabled { opacity: 0.6; cursor: wait; transform: none; }
    .csd-btn-ghost { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 8px; padding: 7px 13px; cursor: pointer; }
    .csd-btn-ghost:hover { border-color: var(--color-danger); color: var(--color-danger); }
    .csd-msg { font-size: 0.78rem; font-weight: 600; line-height: 1.4; }
    .csd-msg.ok { color: var(--color-ok); }
    .csd-msg.err { color: var(--color-danger); }
    .csd-drop-ico { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.7rem; font-weight: 700; color: #fff; background: var(--color-blue-deep); padding: 3px 8px; border-radius: 6px; margin-bottom: 4px; }
    .csd-drop-t { font-size: 0.85rem; font-weight: 600; color: var(--color-text); }
    .csd-drop-s { font-size: 0.72rem; color: #99a2af; }

    .fact-link { display: inline-block; margin-top: 1.1rem; font-size: 0.82rem; font-weight: 600; color: var(--color-blue-deep); text-decoration: none; }
    .fact-link:hover { text-decoration: underline; }
    html[data-theme="dark"] .fact-link { color: #7fb0ff; }

    @media (max-width: 560px) {
        .csd-files { grid-template-columns: 1fr; }
        .csd-drop { min-height: 130px; justify-content: center; }
        .csd-state { align-items: flex-start; }
        .csd-state-dot { margin-top: 5px; }
        .csd-state-sub { white-space: normal; overflow: visible; text-overflow: clip; }
        .csd-actions { flex-direction: column; align-items: stretch; }
        .csd-btn-solid, .csd-btn-ghost { width: 100%; min-height: 46px; }
        .fact-link { min-height: 44px; display: inline-flex; align-items: center; }
    }
</style>

<script>
    // ── CSD: subir .cer + .key + contraseña a /api/fiscal/csd (Facturapi) ──
    function initCsd() {
        const cerFile = document.getElementById('cerFile') as HTMLInputElement | null;
        const keyFile = document.getElementById('keyFile') as HTMLInputElement | null;
        const passIn = document.getElementById('oCsdPass') as HTMLInputElement | null;
        const upBtn = document.getElementById('csdUpload') as HTMLButtonElement | null;
        const rmBtn = document.getElementById('csdRemove') as HTMLButtonElement | null;
        const msg = document.getElementById('csdMsg');
        if (!cerFile || !keyFile || !passIn || !upBtn || !msg) return;
        const state = document.getElementById('csdState') as HTMLElement | null;
        const M = state?.dataset || ({} as DOMStringMap);

        const flash = (text: string, ok: boolean) => {
            msg.textContent = text;
            msg.className = 'csd-msg ' + (ok ? 'ok' : 'err');
            if (ok) setTimeout(() => { msg.textContent = ''; msg.className = 'csd-msg'; }, 5000);
        };

        // Reflejar el archivo elegido en el "drop".
        const bind = (input: HTMLInputElement, labelId: string, dropId: string, fallback: string) => {
            input.addEventListener('change', () => {
                const f = input.files?.[0];
                const lbl = document.getElementById(labelId);
                const drop = document.getElementById(dropId);
                if (lbl) lbl.textContent = f ? f.name : fallback;
                if (drop) drop.classList.toggle('has-file', !!f);
            });
        };
        bind(cerFile, 'cerName', 'cerDrop', M.i18nEligeCer || 'Elige tu archivo .cer');
        bind(keyFile, 'keyName', 'keyDrop', M.i18nEligeKey || 'Elige tu archivo .key');

        upBtn.addEventListener('click', async () => {
            const cer = cerFile.files?.[0];
            const key = keyFile.files?.[0];
            const password = passIn.value;
            if (!cer || !key) { flash(M.i18nEligeAmbos || 'Elige tu archivo .cer y .key.', false); return; }
            if (!password) { flash(M.i18nEscribePass || 'Escribe la contraseña de la llave.', false); return; }

            const fd = new FormData();
            fd.append('cer', cer);
            fd.append('key', key);
            fd.append('password', password);

            upBtn.disabled = true; const orig = upBtn.textContent; upBtn.textContent = M.i18nSubiendo || 'Subiendo…';
            try {
                const res = await fetch('/api/fiscal/csd', { method: 'POST', body: fd });
                const d = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(d.error || M.i18nNoSubio || 'No se pudo subir el CSD');
                flash(M.i18nCsdOk || '✓ CSD cargado. Ya puedes timbrar bajo tu RFC.', true);
                passIn.value = '';
                // Actualiza el estado visual sin recargar.
                const title = document.getElementById('csdStateTitle');
                const name = document.getElementById('csdName');
                if (state) state.setAttribute('data-on', '1');
                if (title) title.textContent = M.i18nCargado || 'CSD cargado';
                if (name) name.textContent = d.csd_nombre || M.i18nCertActivo || 'Certificado activo';
                if (rmBtn) rmBtn.style.display = '';
                (window as any).cordToast?.(M.i18nConectadoToast || 'CSD conectado', 'ok');
            } catch (err: any) {
                flash(err.message || M.i18nNoSubio || 'No se pudo subir el CSD', false);
            } finally { upBtn.disabled = false; upBtn.textContent = orig; }
        });

        rmBtn?.addEventListener('click', async () => {
            if (!await (window as any).cordConfirm({ title: M.i18nQuitarTitulo || 'Quitar CSD', body: M.i18nQuitarBody || 'Dejarás de poder timbrar CFDI hasta subir uno nuevo. ¿Quitar el certificado?', danger: true, confirmText: M.i18nQuitar || 'Quitar CSD' })) return;
            rmBtn.disabled = true;
            try {
                const res = await fetch('/api/fiscal/csd', { method: 'DELETE' });
                if (!res.ok) throw new Error();
                const title = document.getElementById('csdStateTitle');
                const name = document.getElementById('csdName');
                if (state) state.setAttribute('data-on', '0');
                if (title) title.textContent = M.i18nSinCsd || 'Sin CSD';
                if (name) name.textContent = M.i18nSube || 'Sube tu .cer y .key para empezar a timbrar.';
                rmBtn.style.display = 'none';
                flash(M.i18nRemovido || 'CSD removido.', true);
            } catch { flash(M.i18nNoQuito || 'No se pudo quitar el CSD', false); } finally { rmBtn.disabled = false; }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCsd);
    else initCsd();
</script>
