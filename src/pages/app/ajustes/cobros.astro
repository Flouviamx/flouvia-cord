<script>
    

    // Desconectar
    document.getElementById('btnDisconnect')?.addEventListener('click', async () => {
        const meta = document.getElementById('cobrosMeta') as HTMLElement | null;
        const M = meta?.dataset || ({} as DOMStringMap);
        const cc = (window as any).cordConfirm;
        const ct = (window as any).cordToast;
        const ok = cc
          ? await cc({ title: M.i18nDescTitulo || 'Desactivar Cord Pagos', body: M.i18nDescBody || 'Dejarás de recibir pagos en línea. Tus datos de transferencia manual se conservan. ¿Continuar?', danger: true, confirmText: M.i18nDescConfirm || 'Desactivar' })
          : confirm(M.i18nDescNative || '¿Seguro que deseas desactivar Cord Pagos? Dejarás de recibir pagos en línea.');
        if (!ok) return;
        try {
            const send = () => fetch('/api/billing/connect/disconnect', { method: 'POST' });
            let res = await send();
            if (res.status === 428 && typeof (window as any).cordStepUp === 'function') {
                if (!await (window as any).cordStepUp()) return;
                res = await send();
            }
            if (!res.ok) { const data = await res.json(); throw new Error(data.error || M.i18nDescErr || 'Error al desconectar'); }
            if (ct) ct(M.i18nDescOk || 'Cuenta desconectada');
            setTimeout(() => window.location.reload(), 1200);
        } catch (e: any) {
            if (ct) ct(e.message, 'error'); else alert(e.message);
        }
    });

    const feeCheck = document.getElementById('feeTermsCheck') as HTMLInputElement | null;
    const feeButton = document.getElementById('feeAcceptBtn') as HTMLButtonElement | null;
    const feePanel = document.getElementById('feeAccept') as HTMLElement | null;
    feeCheck?.addEventListener('change', () => { if (feeButton) feeButton.disabled = !feeCheck.checked; });
    feeButton?.addEventListener('click', async () => {
        if (!feeCheck?.checked || !feePanel) return;
        feeButton.disabled = true;
        const send = () => fetch('/api/billing/fees/accept', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accepted: true, version: feePanel.dataset.version }),
        });
        try {
            let response = await send();
            if (response.status === 428 && typeof (window as any).cordStepUp === 'function') {
                if (!await (window as any).cordStepUp()) return;
                response = await send();
            }
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'No se pudo activar la tarifa');
            (window as any).cordToast?.('Tarifa de Cord Pagos activada', 'ok');
            setTimeout(() => location.reload(), 700);
        } catch (error: any) {
            (window as any).cordToast?.(error.message || 'No se pudo activar la tarifa', 'error');
            feeButton.disabled = false;
        }
    });
</script>
