---
// Ajustes › Tu cuenta — perfil, sesiones, seguridad (2FA, passkeys), cuentas
// conectadas. Montamos una UI 100% custom en React (CustomUserProfile).
import SettingsShell from '../../../components/app/SettingsShell.astro';
import CustomUserProfile from '../../../components/app/CustomUserProfile.tsx';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';

// Llegó aquí redirigido por AppLayout: su organización exige 2FA y su cuenta
// todavía no lo tiene activo (ver el gate en AppLayout.astro).
const require2fa = Astro.url.searchParams.get('require2fa') === '1';
const L = currentLocale();
---

<SettingsShell title="Tu cuenta — Ajustes" tab="cuenta"
    intro={t(L, 'set.cuenta.intro')}>
    {require2fa && (
        <div class="req2fa-notice">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" fill="currentColor" fill-opacity="0.12"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            <div>
                <strong>{t(L, 'set.cuenta.req2fa_titulo')}</strong>
                <p>{t(L, 'set.cuenta.req2fa_desc')}</p>
            </div>
        </div>
    )}
    <div class="cuenta-mount">
        <CustomUserProfile client:only="react" locale={L} />
    </div>
</SettingsShell>

<style>
    .cuenta-mount { margin-top: -0.6rem; }
    .req2fa-notice { display: flex; gap: 12px; align-items: flex-start; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.22); border-radius: 14px; padding: 14px 16px; margin-bottom: 1.4rem; color: #92400e; }
    html[data-theme="dark"] .req2fa-notice { color: #fcd34d; }
    .req2fa-notice svg { flex-shrink: 0; width: 20px; height: 20px; margin-top: 1px; }
    .req2fa-notice strong { display: block; font-size: 0.88rem; margin-bottom: 4px; }
    .req2fa-notice p { margin: 0; font-size: 0.82rem; line-height: 1.5; opacity: 0.9; }
</style>
