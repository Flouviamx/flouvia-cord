---
// Ajustes — ÍNDICE. Tarjetas de categorías con búsqueda. Cada una abre su primera
// pestaña; dentro, las sub-páginas son pestañas horizontales (no rail lateral).
import AppLayout from '../../../layouts/AppLayout.astro';
import AccessGate from '../../../components/app/AccessGate.astro';
import { getOrg, getSetupProgress, getMyMembership } from '../../../lib/queries';
import { memberCan } from '../../../lib/permissions';
import { localizeCategories } from '../../../lib/settings';
import '../../../styles/settings.css';
import { settingsSearchIndex } from '../../../lib/settings-search';
import SettingsOverview from '../../../components/app/settings/SettingsOverview.astro';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';

const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};
const [ORG, SETUP, ME] = await Promise.all([getOrg(), getSetupProgress(), getMyMembership()]);
const SETTINGS_CATEGORIES = localizeCategories(L, ORG.countryCode);
const hasAccess = memberCan(ME, 'ajustes');
// Anillo SVG: circunferencia = 2πr (r=26) ≈ 163.36
const R = 26, C = 2 * Math.PI * R;
const dash = C * (SETUP.pct / 100);

const catMap = Object.fromEntries(SETTINGS_CATEGORIES.map(c => [c.id, c]));
// Los cuatro grupos del índice. Viven aquí y no en settings.ts a propósito:
// settings.ts define el modelo categoría→tabs, y esto es sólo cómo se AGRUPAN
// para presentarlas. `id` sólo lo usa Desarrolladores, que se oculta/muestra
// con el toggle de modo dev.
const GRUPOS = [
    { label: t(L, 'idx.sec_personal'), cats: [catMap.cuenta], first: true },
    { label: t(L, 'idx.sec_cuenta'), cats: [catMap.general, catMap.branding, catMap.equipo, catMap.notificaciones, catMap.planes, catMap.avanzado] },
    { label: t(L, 'idx.sec_producto'), cats: [catMap.cotizaciones, catMap.facturacion, catMap.cobros, catMap.integraciones] },
    { label: t(L, 'idx.sec_dev'), cats: [catMap.mcp, catMap.agentes, catMap.elements], id: 'idxDevSection' },
];
---

<AppLayout title={t(L, 'ajustes.titulo_index')} page="ajustes" heading="Ajustes">
    {!hasAccess && (
        <AccessGate title={t(L, 'settings.sin_acceso')} desc={t(L, 'settings.sin_acceso_idx_desc')} />
    )}
    {hasAccess && <div class="idx">
        <header class="idx-head">
            <h2>{t(L, 'settings.configuracion_titulo')}</h2>
            <p>{tf('settings.configuracion_para', { org: ORG.nombre })}</p>
        </header>

        {!SETUP.complete && (
            <a href="/app?guia=1" class="idx-health">
                <span class="idx-ring" style={`--c:${C}; --dash:${dash}`}>
                    <svg viewBox="0 0 60 60">
                        <circle class="idx-ring-bg" cx="30" cy="30" r="26" />
                        <circle class="idx-ring-fg" cx="30" cy="30" r="26" />
                    </svg>
                    <span class="idx-ring-pct editorial">{SETUP.pct}%</span>
                </span>
                <span class="idx-health-body">
                    <span class="idx-health-title">{tf('idx.cuenta_configurada', { pct: String(SETUP.pct) })}</span>
                    <span class="idx-health-desc">{tf('idx.te_faltan', { n: String(SETUP.total - SETUP.doneN), total: String(SETUP.total) })}</span>
                </span>
                <span class="idx-health-cta">{t(L, 'idx.continuar')}</span>
            </a>
        )}

        <SettingsOverview org={ORG} member={ME} />
        <div class="idx-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
            <label class="sr-only" for="settingsSearch">{L==='en'?'Search settings':'Buscar en ajustes'}</label>
            <input type="search" id="settingsSearch" autocomplete="off" placeholder={L==='en'?'Search settings, taxes, team…':'Buscar ajustes, impuestos, equipo…'}/>
            <kbd aria-hidden="true">/</kbd>
        </div>
        <script type="application/json" id="settingsSearchIndex" is:inline set:html={JSON.stringify(settingsSearchIndex(L,ORG.countryCode)).replace(/</g,'\\u003c')}/>
        <nav class="settings-search-results" id="settingsMatches" aria-label={L==='en'?'Matching settings':'Ajustes encontrados'} hidden></nav>
        <p class="idx-empty" id="settingsEmpty" role="status" hidden>{L==='en'?'No settings match your search. Try another term.':'No encontramos ajustes con esa búsqueda. Prueba con otro término.'}</p>
        {GRUPOS.map((g) => (
            <div data-settings-group id={g.id} style={g.id ? 'display:none;' : undefined}>
                <h3 class={g.first ? 'idx-section-label' : 'idx-section-label idx-section-adv'}>{g.label}</h3>
                <div class="idx-rows">
                    {g.cats.map((c) => (
                        <div class="idx-row" data-cat={c.id} data-search={c.tabs.map(tb=>tb.keywords || '').join(' ')}>
                            {/* Sólo para el ratón: duplica el destino del título, así que
                                se saca del árbol de accesibilidad y del tabulador para no
                                anunciar dos veces la misma categoría. El link real es el
                                título; con teclado se llega a él y a cada pestaña. */}
                            <a class="idx-row-hit" href={c.tabs[0].href} tabindex="-1" aria-hidden="true"></a>
                            <span class="idx-icon-wrap" aria-hidden="true"><svg class="idx-row-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} /></span>
                            <span class="idx-row-body">
                                <a class="idx-row-title" href={c.tabs[0].href}>{c.label}</a>
                                <span class="idx-row-desc">{c.desc}</span>
                                {(c.tabs.length > 1 || c.tabs[0].label !== c.label) && (
                                    <span class="idx-row-tabs" role="group" aria-label={c.label}>
                                        {c.tabs.map((tb) => (
                                            <a class="idx-tab-link" href={tb.href}><span>{tb.label}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a>
                                        ))}
                                    </span>
                                )}
                            </span>
                            <svg class="idx-row-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </div>
                    ))}
                </div>
            </div>
        ))}

        <div class="idx-devmode">
            <span class="idx-dm-body">
                <span class="idx-dm-title">{t(L, 'idx.devmode_titulo')}</span>
                <span class="idx-dm-desc">{t(L, 'idx.devmode_desc')}</span>
            </span>
            <button type="button" class="idx-switch" id="devModeToggle" role="switch" aria-checked="false" aria-label={t(L, 'idx.devmode_aria')}><span class="idx-switch-dot"></span></button>
        </div>
    </div>}
</AppLayout>

<script>
    import { searchSettings } from '../../../lib/settings-search';
    // Modo desarrollador: oculta la categoría "Developers" del índice salvo que el
    // usuario lo active (persistido en localStorage). Esconde el ruido técnico al
    // vendedor típico sin bloquear el acceso directo por URL.
    (function () {
        const KEY = 'cord.devmode';
        const devSec = document.getElementById('idxDevSection');
        const toggle = document.getElementById('devModeToggle');
        if (!devSec || !toggle) return;
        const apply = (on: boolean) => {
            devSec.style.display = on ? 'block' : 'none';
            toggle.classList.toggle('on', on);
            toggle.setAttribute('aria-checked', on ? 'true' : 'false');
            // El dock de Desarrolladores (Cord Workbench) es global a toda la app —
            // este toggle ahora también lo prende/apaga en vivo, sin recargar.
            document.documentElement.classList.toggle('cord-dev', on);
            window.dispatchEvent(new CustomEvent('cord:devmode_changed', { detail: { on } }));
        };
        apply(localStorage.getItem(KEY) === '1');
        toggle.addEventListener('click', () => {
            const on = localStorage.getItem(KEY) !== '1';
            localStorage.setItem(KEY, on ? '1' : '0');
            apply(on);
        });
    })();
    const search = document.getElementById('settingsSearch') as HTMLInputElement | null;
    const normalize = (value:string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
    const applySearch = () => {
        const terms=normalize(search?.value || '').trim().split(/\s+/).filter(Boolean);
        let count=0;
        document.querySelectorAll<HTMLElement>('[data-settings-group]').forEach(group=>{
            let visible=0;
            group.querySelectorAll<HTMLElement>('[data-cat]').forEach(card=>{
                const matches=terms.every(term=>normalize(`${card.textContent} ${card.dataset.search}`).includes(term));
                card.hidden=!matches; if(matches)visible++;
            });
            group.hidden=visible===0;
            if(group.id!=='idxDevSection'||document.documentElement.classList.contains('cord-dev'))count+=visible;
        });
        const catalog=JSON.parse(document.getElementById('settingsSearchIndex')?.textContent||'[]').filter((result:{developer?:boolean})=>!result.developer||document.documentElement.classList.contains('cord-dev'));
        const results=searchSettings(catalog,search?.value||'');
        const matches=document.getElementById('settingsMatches');
        if(matches){matches.replaceChildren();matches.hidden=!results.length;for(const result of results){const a=document.createElement('a');a.href=result.href;const title=document.createElement('b');title.textContent=result.label;const category=document.createElement('span');category.textContent=result.category;a.append(title,category);matches.append(a);}}
        const empty=document.getElementById('settingsEmpty');if(empty)empty.hidden=count>0||results.length>0;
    };
    search?.addEventListener('input',applySearch);
    window.addEventListener('cord:devmode_changed',applySearch);
    window.addEventListener('keydown',e=>{
        const target=e.target as HTMLElement;
        if(e.key==='/'&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!target.closest('input,textarea,select,[contenteditable="true"]')){e.preventDefault();search?.focus();}
        if(e.key==='Escape'&&search&&document.activeElement===search){search.value='';applySearch();}
    });
</script>

<style>
.idx { max-width:1040px; }
.idx-head { margin-bottom:26px; }
.idx-head h2 { margin:0; font-size:1.7rem; font-weight:700; letter-spacing:-.03em; }
.idx-head p { margin:8px 0 0; font-size:.88rem; color:var(--color-text-muted); }
.idx-health { display:flex; align-items:center; gap:18px; padding:24px; margin-bottom:24px; border-radius:var(--settings-radius); background:var(--settings-surface); border:1px solid var(--settings-rim); box-shadow:var(--settings-shadow); text-decoration:none; color:var(--color-text); }
.idx-ring { position:relative; width:60px; height:60px; flex-shrink:0; }
.idx-ring svg { width:60px; height:60px; transform:rotate(-90deg); }
.idx-ring-bg { fill:none; stroke:var(--color-border); stroke-width:4; }
.idx-ring-fg { fill:none; stroke:var(--color-ok); stroke-width:4; stroke-linecap:round; stroke-dasharray:var(--dash) var(--c); }
.idx-ring-pct { position:absolute; inset:0; display:grid; place-items:center; font-size:.8rem; }
.idx-health-body { display:flex; flex-direction:column; gap:6px; flex:1; }
.idx-health-title { font-size:.95rem; font-weight:600; }
.idx-health-desc { font-size:.8rem; line-height:1.5; color:var(--color-text-muted); }
.idx-health-cta { padding:11px 17px; border-radius:12px; background:var(--color-blue-deep); color:white; font-size:.8rem; font-weight:600; white-space:nowrap; }
.idx-search { display:flex; align-items:center; gap:12px; padding:0 16px; height:50px; margin:0 0 30px; background:var(--settings-surface); border:1px solid var(--settings-rim); border-radius:15px; color:var(--color-text-muted); box-shadow:var(--settings-shadow); }
.idx-search:focus-within { outline:2px solid color-mix(in srgb,var(--color-text-muted) 40%,transparent); outline-offset:2px; }
.idx-search svg { width:19px; height:19px; flex-shrink:0; }
.idx-search input { font:inherit; font-size:.88rem; background:transparent; border:0; outline:0; color:var(--color-text); width:100%; min-width:0; height:100%; }
.idx-search kbd { font:12px var(--font-sans); padding:3px 7px; border:1px solid var(--color-border); border-radius:5px; }
.sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
.idx-empty { padding:24px; color:var(--color-text-muted); font-size:.87rem; text-align:center; }
.idx [hidden] { display:none!important; }
.idx-section-label { font-size:.94rem; font-weight:600; margin:0 0 14px; letter-spacing:-.01em; }
.idx-section-adv { margin-top:30px; }
.idx-rows { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
.idx-row { position:relative; display:flex; align-items:flex-start; gap:14px; padding:24px; background:var(--settings-surface); border:1px solid var(--settings-rim); border-radius:var(--settings-radius); box-shadow:var(--settings-shadow); transition:transform .2s,box-shadow .2s; }
.idx-row:hover { transform:translateY(-2px); box-shadow:0 14px 28px -18px #0a192f25; }
.idx-row-hit { position:absolute; inset:0; border-radius:inherit; }
.idx-icon-wrap { display:grid; place-items:center; width:40px; height:40px; background:var(--color-bg-soft); border-radius:12px; flex-shrink:0; color:var(--color-text-muted); }
.idx-row-ico { width:21px; height:21px; }
.idx-row-body { display:flex; flex-direction:column; gap:7px; min-width:0; flex:1; }
.idx-row-title { position:relative; align-self:flex-start; font-size:.92rem; font-weight:600; text-decoration:none; color:var(--color-text); }
.idx-row-desc { font-size:.77rem; color:var(--color-text-muted); line-height:1.55; }
.idx-row-tabs { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.idx-tab-link { position:relative; display:inline-flex; align-items:center; justify-content:space-between; gap:10px; min-height:36px; padding:8px 11px; border:1px solid var(--settings-rim); border-radius:10px; background:var(--color-bg-soft); font-size:.75rem; font-weight:500; line-height:1.4; color:var(--color-text-muted); text-decoration:none; transition:background .18s,color .18s,box-shadow .18s; }
.idx-tab-link svg { width:13px; height:13px; flex-shrink:0; opacity:.55; }
.idx-tab-link:focus-visible { outline:2px solid var(--color-text-muted); outline-offset:3px; }
.idx-tab-link:hover { color:var(--color-text); background:var(--settings-surface); box-shadow:0 2px 6px #0a192f0a; }
.idx-tab-link:hover svg { opacity:1; }
.idx-row-arrow { width:16px; height:16px; flex-shrink:0; color:var(--color-text-muted); margin-top:2px; }
.idx-row a:focus-visible { outline:2px solid var(--color-text-muted); outline-offset:4px; border-radius:3px; }
.idx-devmode { display:flex; align-items:center; gap:20px; padding:24px; margin-top:30px; border-radius:var(--settings-radius); background:var(--settings-surface); box-shadow:var(--settings-shadow); }
.idx-dm-body { flex:1; display:flex; flex-direction:column; gap:6px; }
.idx-dm-title { font-size:.88rem; font-weight:600; }
.idx-dm-desc { font-size:.77rem; line-height:1.5; color:var(--color-text-muted); }
.idx-switch { width:44px; height:44px; flex-shrink:0; border:0; background:none; padding:0; position:relative; cursor:pointer; }
.idx-switch::before { content:''; position:absolute; inset:9px 0; border-radius:100px; background:var(--color-border); transition:background .2s; }
.idx-switch.on::before { background:var(--color-blue-deep); }
.idx-switch-dot { position:absolute; top:12px; left:3px; width:20px; height:20px; border-radius:50%; background:white; box-shadow:0 1px 3px #0003; transition:transform .2s; }
.idx-switch.on .idx-switch-dot { transform:translateX(18px); }
.idx-switch:focus-visible { outline:2px solid var(--color-text-muted); outline-offset:3px; border-radius:12px; }
@media(max-width:700px) { .idx-rows { grid-template-columns:minmax(0,1fr); } .idx-row { padding:20px; border-radius:20px; } .idx-health { flex-wrap:wrap; padding:20px; } .idx-health-body { flex-basis:calc(100% - 80px); } .idx-health-cta { margin-left:78px; } .idx-search input { font-size:16px; } .idx-tab-link { min-height:44px; padding:10px 12px; } .idx-devmode { padding:20px; } }
@media(prefers-reduced-motion:reduce) { .idx-tab-link { transition:none; } .idx-row,.idx-switch-dot,.idx-switch::before { transition:none; } .idx-row:hover { transform:none; } }
</style>
