---
import SettingsSection from '../../../components/app/settings/SettingsSection.astro';
// Ajustes › Notificaciones — matriz evento → canal (correo / Slack / Teams). Guarda en
// orgs.notif_prefs (jsonb) vía /api/org/prefs; src/lib/notify.ts es quien de
// verdad la consulta antes de mandar algo (ver historial-app-features.md).
// No usa el guardado genérico del shell (por eso NO pasa `save`): tiene su
// propia barra.
import SettingsSaveFooter from '../../../components/app/SettingsSaveFooter.astro';
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg } from '../../../lib/queries';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
const ORG = await getOrg();
const P = ORG.notifPrefs || {};
const L = currentLocale();

const EVENTOS = [
    { id: 'quote_viewed',    label: t(L, 'set.notif.ev.viewed'),   desc: t(L, 'set.notif.ev.viewed_desc') },
    { id: 'quote_approved',  label: t(L, 'set.notif.ev.approved'), desc: t(L, 'set.notif.ev.approved_desc') },
    { id: 'quote_rejected',  label: t(L, 'set.notif.ev.rejected'), desc: t(L, 'set.notif.ev.rejected_desc') },
    { id: 'quote_paid',      label: t(L, 'set.notif.ev.paid'),     desc: t(L, 'set.notif.ev.paid_desc') },
    { id: 'quote_expiring',  label: t(L, 'set.notif.ev.expiring'), desc: t(L, 'set.notif.ev.expiring_desc') },
    { id: 'payment_overdue', label: t(L, 'set.notif.ev.overdue'),  desc: t(L, 'set.notif.ev.overdue_desc') },
    { id: 'team_join',       label: t(L, 'set.notif.ev.team_join'), desc: t(L, 'set.notif.ev.team_join_desc') },
    { id: 'task_due',        label: t(L, 'set.notif.ev.task_due'), desc: t(L, 'set.notif.ev.task_due_desc') },
];
const CANALES = [
    { id: 'email', label: t(L, 'set.notif.canal.email') },
    { id: 'slack', label: t(L, 'set.notif.canal.slack') },
    { id: 'teams', label: t(L, 'set.notif.canal.teams') },
];
// task_due nació después de la matriz: una org que ya la había guardado no
// tiene la llave, y el recordatorio sale encendido (mismo default que lee
// src/pages/api/cron/tareas.ts).
const on = (ev: string, c: string) => ev === 'task_due' && c === 'email' && !P.task_due ? true : !!(P[ev] && P[ev][c]);
// team_join no tiene forma de mensaje de canal (no hay folio/cliente/total que
// mostrar) — se deja sin celda interactiva en vez de fingir que aplica. El
// recordatorio de tareas es un correo PERSONAL a cada responsable: tampoco va
// a un canal compartido.
const sinCanal = (ev: string, c: string) => c !== 'email' && (ev === 'team_join' || ev === 'task_due');
---

<SettingsShell title="Notificaciones — Ajustes" tab="notificaciones"
    intro={t(L, 'set.notif.intro')}>

    <SettingsSection icon="mail" class="s-block">
        <Fragment slot="heading">{t(L, 'set.notif.eventos')}</Fragment>
        <div class="notif-grid" data-notif>
            <div class="notif-row notif-head">
                <span></span>
                {CANALES.map((c) => <span class="notif-ch">{c.label}</span>)}
            </div>
            {EVENTOS.map((ev) => (
                <div class="notif-row" data-ev={ev.id}>
                    <span class="notif-ev">
                        <span class="notif-ev-label">{ev.label}</span>
                        <span class="notif-ev-desc">{ev.desc}</span>
                    </span>
                    {CANALES.map((c) => (
                        sinCanal(ev.id, c.id) ? (
                            <span class="notif-na" title={t(L, 'set.notif.sin_canal')}>—</span>
                        ) : (
                            <label class="notif-cell">
                                <input type="checkbox" aria-label={`${ev.label} · ${c.label}`} data-settings-track data-canal={c.id} checked={on(ev.id, c.id)} />
                                <span class="notif-box"></span>
                            </label>
                        )
                    ))}
                </div>
            ))}
        </div>
    </SettingsSection>

    <SettingsSection icon="link" advanced hint={L==='en'?'External channels · configure only those your team uses.':'Canales externos · configura solo los que use tu equipo.'} class="s-block">
        <Fragment slot="heading">{t(L, 'set.notif.slack_canal')}</Fragment>
        <div class="s-body">
            <div class="s-field">
                <label for="oSlack">{t(L, 'set.notif.slack_webhook')}</label>
                <input class="s-input" id="oSlack" data-settings-track value={ORG.slackWebhook} placeholder="https://hooks.slack.com/services/T000/B000/XXXX" />
                <span class="s-hint">{t(L, 'set.notif.slack_hint')}</span>
            </div>
            {ORG.teamsCanal ? (
                <div class="s-field">
                    <label>Microsoft Teams</label>
                    <span class="s-hint">{t(L, 'set.integ.slack.conectado_a')} <b>{ORG.teamsCanal}</b>{ORG.teamsEquipo && ` · ${ORG.teamsEquipo}`}. <a href="/app/ajustes/integraciones/teams">{t(L, 'set.notif.teams_administrar')}</a></span>
                </div>
            ) : (
                <div class="s-field">
                    <label for="oTeams">{t(L, 'set.notif.teams_webhook')}</label>
                    <input class="s-input" id="oTeams" data-settings-track value={ORG.teamsWebhook} placeholder="https://prod-00.westus.logic.azure.com:443/workflows/..." />
                    <span class="s-hint">{t(L, 'set.notif.teams_hint')}</span>
                </div>
            )}
        </div>
    </SettingsSection>

    <SettingsSaveFooter buttonId="nBtn" messageId="nMsg" />
</SettingsShell>

<style>
    .notif-grid { display: flex; flex-direction: column; }
    .notif-row { display: grid; grid-template-columns: 1fr 72px 72px 72px; align-items: center; gap: 0.5rem; padding: 0.85rem 0.3rem; border-bottom: 1px solid var(--color-border); }
    .notif-head { padding-top: 0; padding-bottom: 0.6rem; }
    .notif-ch { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase; color: #99a2af; text-align: center; }
    .notif-ev { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .notif-ev-label { font-size: 0.86rem; font-weight: 600; color: var(--color-text); }
    .notif-ev-desc { font-size: 0.72rem; color: var(--color-text-muted); line-height: 1.4; }
    .notif-cell { display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .notif-cell input { position: absolute; opacity: 0; pointer-events: none; }
    .notif-box { width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid var(--color-border); background: var(--color-bg-soft); position: relative; transition: background 0.2s, border-color 0.2s; }
    .notif-cell input:focus-visible + .notif-box { outline: 2px solid var(--color-text-muted); outline-offset: 3px; }
    .notif-box::after { content: ''; position: absolute; left: 6px; top: 2px; width: 5px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg) scale(0); transition: transform 0.2s var(--ease-spring); }
    .notif-cell input:checked + .notif-box { background: var(--color-ok); border-color: var(--color-ok); }
    .notif-cell input:checked + .notif-box::after { transform: rotate(45deg) scale(1); }
    .notif-na { display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); opacity: 0.4; font-size: 0.9rem; cursor: default; }

    @media (max-width: 560px) {
        .notif-row { grid-template-columns: 1fr 48px 48px 48px; }
        .notif-cell, .notif-na { min-width: 44px; min-height: 44px; }
        .notif-ev-desc { line-height: 1.5; }
    }
</style>

<script>
    import { setSaveState } from '../../../lib/settings-save-feedback';
    function initNotif() {
        const btn = document.getElementById('nBtn') as HTMLButtonElement | null;
        const msg = document.getElementById('nMsg');
        const grid = document.querySelector('[data-notif]');
        const slack = document.getElementById('oSlack') as HTMLInputElement | null;
        const teams = document.getElementById('oTeams') as HTMLInputElement | null;
        if (!btn || !msg || !grid) return;

        const M = btn.dataset;

        btn.addEventListener('click', async () => {
            const notif_prefs: Record<string, Record<string, boolean>> = {};
            grid.querySelectorAll('.notif-row[data-ev]').forEach((row) => {
                const ev = (row as HTMLElement).dataset.ev!;
                const canales: Record<string, boolean> = {};
                row.querySelectorAll('input[data-canal]').forEach((node) => {
                    const i = node as HTMLInputElement;
                    canales[i.dataset.canal!] = i.checked;
                });
                notif_prefs[ev] = canales;
            });

            setSaveState(btn, 'saving');

            try {
                const res = await fetch('/api/org/prefs', {
                    method: 'PATCH', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ notif_prefs, slack_webhook_url: slack?.value ?? '', teams_webhook_url: teams ? teams.value : undefined }),
                });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || M.i18nErr || 'No se pudo guardar');

                setSaveState(btn, 'saved');

            } catch (err: any) {
                setSaveState(btn, 'error', err.message || M.i18nErr);
            }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initNotif);
    else initNotif();
</script>
