---
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg } from '../../../lib/queries';
import { currentLocale } from '../../../lib/context';
import { getEntitlementContext } from '../../../lib/org-entitlements';
import { planIncludes } from '../../../lib/entitlements';
import '../../../styles/brand-editor.css';
const org = await getOrg();
const platformEmailEnabled = Boolean(import.meta.env.RESEND_API_KEY || process.env.RESEND_API_KEY);
const custom = planIncludes((await getEntitlementContext(org.id)).effectivePlan,'custom_email');
const en = currentLocale() === 'en';
const say = (es:string, english:string) => en ? english : es;
import { iconInner } from '../../../lib/icons';
---
<SettingsShell title={say('Correo — Ajustes','Email — Settings')} tab="correo" perm="ajustes" save={custom}>
<div class="brand-editor" id="emailEditor">
    <div class="be-toolbar"><p>{say('Tu marca, también en su bandeja de entrada.','Your brand, in their inbox too.')}<span>{say('Revisa el correo sin enviar una prueba al cliente.','Review the email without sending a test to a client.')}</span></p></div>
    <div class="be-layout">
        <div class="be-controls">
            <div class="be-inherited"><div><b>{say('Identidad compartida','Shared identity')}</b><p>{say('Logo, colores, tipografía y composición de tu marca.','Your logo, colors, typography and composition.')}</p></div><a href="/app/ajustes/branding">{say('Editar →','Edit →')}</a></div>
            {!platformEmailEnabled && <p class="be-help" role="status">{say('El envío desde Cord no está habilitado en este entorno. Puedes seguir editando la vista previa; si conectaste Gmail, los envíos compatibles usan esa cuenta.','Sending from Cord is not enabled in this environment. You can still edit the preview; if Gmail is connected, supported messages use that account.')}</p>}
            {!custom && <p class="be-help">{say('Tu identidad ya se aplica a los correos. Para personalizar remitente, introducción y firma,','Your identity already applies to emails. To customize sender, introduction and signature,')} <a href="/app/ajustes/plan">{say('consulta tu plan.','review your plan.')}</a></p>}
            <section class="be-section">
                <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('mail')}></svg>{say('Remitente','Sender')}</h3>
                <label class="be-label" for="emailName">{say('Nombre visible','Display name')}</label>
                <input class="s-input" id="emailName" data-field={custom?'email_from_name':undefined} value={org.emailFromName} placeholder={org.nombre} disabled={!custom} maxlength="80"/>
                <label class="be-label" for="emailReply">{say('Dirección de respuesta','Reply-to address')}</label>
                <input class="s-input" id="emailReply" type="email" data-field={custom?'email_reply_to':undefined} value={org.emailReplyTo} placeholder={org.email} disabled={!custom}/>
                <p class="be-help">{say('Las respuestas llegan a esta dirección. Esto no cambia el dominio de envío.','Replies go to this address. This does not change the sending domain.')}</p>
            </section>
            <section class="be-section">
                <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chat')}></svg>{say('Mensaje y firma','Message and signature')}</h3>
                <label class="be-label" for="emailIntro">{say('Introducción','Introduction')}</label>
                <textarea class="s-input" id="emailIntro" data-field={custom?'email_intro':undefined} disabled={!custom} maxlength="500" rows="4">{org.emailIntro}</textarea>
                <label class="be-label" for="emailSignature">{say('Firma','Signature')}</label>
                <textarea class="s-input" id="emailSignature" data-field={custom?'email_firma':undefined} disabled={!custom} maxlength="300" rows="3">{org.emailFirma}</textarea>
                <p class="be-help">{say('Personaliza con','Personalize with')} {'{cliente} · {folio} · {total} · {negocio}'}</p>
                <p class="be-help">{say('La introducción se usa al enviar cotizaciones y facturas. Los recordatorios conservan su mensaje de vencimiento y llevan tu firma.','The introduction is used when sending quotes and invoices. Reminders keep their due-date message and carry your signature.')}</p>
            </section>
        </div>
        <aside class="be-preview">
            <div class="be-preview-bar"><span>{say('Correo de cotización','Quote email')}</span><span>{say('Vista previa','Preview')}</span></div>
            <div class="be-preview-stage"><iframe id="emailPreview" src="/app/ajustes/correo-preview" title={say('Vista previa del correo','Email preview')}/></div>
            <p class="be-preview-note">{say('Muestra en MXN. La apariencia puede variar según la aplicación de correo.','Sample in MXN. Appearance may vary by email application.')}</p>
        </aside>
    </div>
</div>
</SettingsShell>
<script>
    import { initDocumentPreview } from '../../../lib/document-preview';
    initDocumentPreview('emailEditor','emailPreview','cord:email-preview',() => ({
        name:(document.getElementById('emailName') as HTMLInputElement).value,
        intro:(document.getElementById('emailIntro') as HTMLTextAreaElement).value,
        signature:(document.getElementById('emailSignature') as HTMLTextAreaElement).value,
        reply:(document.getElementById('emailReply') as HTMLInputElement).value,
    }),640);
</script>
