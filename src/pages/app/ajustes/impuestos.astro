---
// Ajustes › Cotizaciones › Impuestos. Catálogo de tasas de la organización.
//
// El vocabulario sale del PAÍS de la org, no de una constante: un impuesto de
// consumo se llama IVA en México, VAT en Reino Unido, GST en Australia y Moms
// en Suecia. Antes esta pantalla ofrecía "IEPS" y "Retención ISR" a un negocio
// en Madrid — conceptos que ahí no existen.
//
// Las tasas se aplican POR LÍNEA en los dos editores; la sincronización hacia
// orgs.iva_pct se conserva solo como compatibilidad con cuentas anteriores.
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getImpuestos, getOrg } from '../../../lib/queries';
import { getCountryProfile, hasTaxPreset, taxKindLabel, type TaxKind } from '../../../lib/countries';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
const ORG = await getOrg();
const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};
const IMPUESTOS = await getImpuestos();
const PAIS = String(ORG.countryCode || 'MX');
const PROFILE = getCountryProfile(PAIS, L);
const PUEDE_SEMBRAR = IMPUESTOS.length === 0 && hasTaxPreset(PAIS);
// Las tres clases neutras, nombradas como se dicen en este país.
const KINDS: { id: TaxKind; label: string }[] = (['consumo', 'retencion', 'exento'] as TaxKind[])
    .map((id) => ({ id, label: taxKindLabel(id, L, PAIS) }));
const NOMBRE_PLACEHOLDER = `${PROFILE.taxLabel} ${PROFILE.code === 'MX' ? '16' : '21'}%…`;
---

<SettingsShell title="Impuestos — Ajustes" tab="impuestos" perm="ajustes"
    intro={t(L, 'set.imp.intro')}>

    <div class="s-block">
        <h3>{t(L, 'set.imp.perfiles')}</h3>
        <div class="s-body">
            <div class="imp-actions-row">
                <button class="dev-new" id="impNew">{t(L, 'set.imp.nuevo')}</button>
            </div>
            <div class="imp-list" id="impList">
                {IMPUESTOS.length === 0 && (
                    <div class="imp-seed" id="impEmpty">
                        <p class="imp-empty">
                            {PUEDE_SEMBRAR
                                ? (L === 'en'
                                    ? `Your catalog is empty. Cord knows the standard rates for ${PROFILE.name} and can add them for you — you can edit or delete any of them afterwards.`
                                    : `Tu catálogo está vacío. Cord conoce las tasas estándar de ${PROFILE.name} y puede capturarlas por ti — después puedes editarlas o borrarlas.`)
                                : (L === 'en'
                                    ? `Your catalog is empty. ${PROFILE.name} has no single national rate, so add the ones your business charges.`
                                    : `Tu catálogo está vacío. En ${PROFILE.name} no hay una tasa nacional única, así que captura las que cobra tu negocio.`)}
                        </p>
                        {PUEDE_SEMBRAR && (
                            <button class="dev-new" id="impSeed">
                                {L === 'en' ? `Add the standard rates for ${PROFILE.name}` : `Capturar las tasas de ${PROFILE.name}`}
                            </button>
                        )}
                    </div>
                )}
                {IMPUESTOS.map((i) => (
                    <div class="imp-row" data-id={i.id}>
                        <span class={`imp-tipo ${i.kind}`}>{i.kindLabel}</span>
                        <span class="imp-body">
                            <span class="imp-name">{i.nombre}</span>
                            <span class="imp-tasa editorial">{i.tasa}%</span>
                        </span>
                        {i.esDefault
                            ? <span class="imp-default">{t(L, 'set.imp.predeterminado')}</span>
                            : <button class="imp-setdef" data-setdef={i.id}>{t(L, 'set.imp.hacer_predeterminado')}</button>}
                        <button class="key-revoke" data-del={i.id}>{t(L, 'set.imp.eliminar')}</button>
                    </div>
                ))}
            </div>
            <p class="dev-note">
                {L === 'en'
                    ? 'These rates apply per line in quotes and invoices, so a document can mix a taxed item with an exempt one. Withholding profiles marked as default are subtracted from the document total.'
                    : 'Estas tasas se aplican por línea en cotizaciones y facturas, así que un documento puede mezclar un concepto gravado con uno exento. Las retenciones marcadas como predeterminadas se restan del total del documento.'}
            </p>
        </div>
    </div>

    <div class="s-block" data-i18n-crear-err={t(L, 'set.imp.no_se_pudo_crear')} data-i18n-actualizar-err={t(L, 'set.imp.no_se_pudo_actualizar')}
        data-i18n-eliminar-titulo={t(L, 'set.imp.eliminar_titulo')} data-i18n-eliminar-body={t(L, 'set.imp.eliminar_body')}
        data-i18n-eliminar-confirm={t(L, 'set.imp.eliminar')} data-i18n-eliminar-err={t(L, 'set.imp.no_se_pudo_eliminar')}
        data-i18n-config-err={t(L, 'set.imp.no_se_pudo_guardar_config')} id="impMeta">
        <h3>{t(L, 'set.imp.comportamiento')}</h3>
        <div class="s-body">
            <label class="s-toggle">
                <input type="checkbox" id="ivaIncluidoDefecto" checked={ORG.ivaIncluidoDefecto} />
                <span class="s-toggle-track"><span class="s-toggle-thumb"></span></span>
                <span class="s-toggle-text">{t(L, 'set.imp.toggle_incluido')}</span>
            </label>
            <p class="dev-note">{t(L, 'set.imp.toggle_incluido_nota')}</p>
        </div>
    </div>
</SettingsShell>

<dialog id="impDlg" class="kdlg">
    <div class="kdlg-inner">
        <h4>{t(L, 'set.imp.dlg_titulo')}</h4>
        <div class="s-field" style="margin-bottom:1rem">
            <label for="iNombre">{t(L, 'set.imp.nombre')}</label>
            <input class="s-input" id="iNombre" placeholder={NOMBRE_PLACEHOLDER} />
        </div>
        <div class="s-row" style="margin-bottom:1rem">
            <div class="s-field">
                <label for="iKind">{t(L, 'set.imp.tipo')}</label>
                <select class="s-input" id="iKind">
                    {KINDS.map((k) => <option value={k.id}>{k.label}</option>)}
                </select>
            </div>
            <div class="s-field">
                <label for="iTasa">{t(L, 'set.imp.tasa')}</label>
                <input class="s-input" id="iTasa" type="number" min="0" max="100" step="0.001" value="16" />
            </div>
        </div>
        <label class="s-toggle" style="margin-bottom:0.3rem">
            <input type="checkbox" id="iDefault" checked />
            <span class="s-toggle-track"><span class="s-toggle-thumb"></span></span>
            <span class="s-toggle-text">{t(L, 'set.imp.predeterminado_tipo')}</span>
        </label>
        <div class="wh-dlg-actions">
            <button type="button" class="api-btn-ghost" id="impCancel">{t(L, 'set.imp.cancelar')}</button>
            <button type="button" class="api-btn-solid" id="impCreate">{t(L, 'set.imp.crear')}</button>
        </div>
    </div>
</dialog>

<style>
    .imp-actions-row { display: flex; justify-content: flex-end; }
    .dev-new { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 9px; padding: 8px 14px; cursor: pointer; transition: transform 0.3s var(--ease-spring); }
    .dev-new:hover { transform: translateY(-1px); }
    .imp-empty { font-size: 0.84rem; color: var(--color-text-muted); margin: 0; padding: 0.6rem 0; line-height: 1.55; max-width: 62ch; }
    .imp-seed { display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; padding-bottom: 0.4rem; }
    .imp-list { display: flex; flex-direction: column; margin-top: -0.5rem; }
    .imp-row { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 1rem; padding: 1rem 0.3rem; border-bottom: 1px solid var(--color-border); }
    .imp-tipo { font-size: 0.58rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; padding: 4px 9px; border-radius: 100px; white-space: nowrap; color: var(--color-blue-deep); background: rgba(10,25,47,0.08); }
    .imp-tipo.retencion { color: #b45309; background: rgba(245,158,11,0.12); }
    .imp-tipo.exento { color: var(--color-text-muted); background: rgba(0,0,0,0.05); }
    .imp-body { display: flex; align-items: baseline; gap: 0.8rem; min-width: 0; }
    .imp-name { font-size: 0.9rem; font-weight: 600; color: var(--color-text); }
    .imp-tasa { font-size: 0.92rem; color: var(--color-blue-deep); }
    .imp-default { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; color: var(--color-ok); background: rgba(16,185,129,0.12); padding: 4px 10px; border-radius: 100px; white-space: nowrap; }
    .imp-setdef { font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 8px; padding: 6px 11px; cursor: pointer; white-space: nowrap; transition: border-color 0.25s, color 0.25s; }
    .imp-setdef:hover { border-color: var(--color-blue-deep); color: var(--color-blue-deep); }
    .key-revoke { font-family: var(--font-sans); font-size: 0.76rem; font-weight: 600; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 8px; padding: 6px 12px; cursor: pointer; transition: border-color 0.25s, color 0.25s; }
    .key-revoke:hover { border-color: var(--color-danger); color: var(--color-danger); }
    .dev-note { font-size: 0.78rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }
    .dev-note b { color: var(--color-text); }

    .kdlg { border: none; border-radius: 16px; padding: 0; max-width: 460px; width: 92vw; box-shadow: 0 40px 90px -30px rgba(10,25,47,0.5); }
    .kdlg::backdrop { background: rgba(10,25,47,0.45); backdrop-filter: blur(3px); }
    .kdlg-inner { padding: 1.6rem; }
    .kdlg-inner h4 { font-size: 1.15rem; font-weight: 700; margin: 0 0 1rem; }
    .wh-dlg-actions { display: flex; justify-content: flex-end; gap: 0.6rem; margin-top: 1.4rem; }
    .api-btn-ghost { font-family: var(--font-sans); font-size: 0.84rem; font-weight: 600; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 9px; padding: 9px 16px; cursor: pointer; }
    .api-btn-solid { font-family: var(--font-sans); font-size: 0.84rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 9px; padding: 9px 18px; cursor: pointer; }
    .api-btn-solid:disabled { opacity: 0.6; cursor: wait; }
    @media (max-width: 600px) {
        .imp-actions-row .dev-new { width: 100%; min-height: 46px; }
        .imp-row { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "type body" "default default" "delete delete"; gap: .65rem .8rem; padding: 1rem 0; }
        .imp-tipo { grid-area: type; }
        .imp-body { grid-area: body; flex-wrap: wrap; gap: .25rem .65rem; }
        .imp-default, .imp-setdef { grid-area: default; }
        .key-revoke { grid-area: delete; }
        .imp-setdef, .key-revoke { width: 100%; min-height: 44px; }
        .kdlg { width: 100%; max-width: none; max-height: calc(100dvh - 16px); margin: 0; inset: auto 0 0; border-radius: 20px 20px 0 0; }
        .kdlg-inner { padding: 1.25rem max(1rem, env(safe-area-inset-left)) max(1.25rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-right)); overflow-y: auto; }
        .kdlg .s-input { min-height: 46px; font-size: 16px; }
        .kdlg .wh-dlg-actions { display: grid; grid-template-columns: 1fr 1fr; }
        .kdlg .wh-dlg-actions button { width: 100%; min-height: 46px; }
    }
</style>

<script>
    function initImpuestos() {
        const dlg = document.getElementById('impDlg') as HTMLDialogElement | null;
        const newBtn = document.getElementById('impNew');
        if (!dlg || !newBtn) return;
        const meta = document.getElementById('impMeta') as HTMLElement | null;
        const M = meta?.dataset || ({} as DOMStringMap);

        newBtn.addEventListener('click', () => {
            (document.getElementById('iNombre') as HTMLInputElement).value = '';
            (document.getElementById('iKind') as HTMLSelectElement).value = 'consumo';
            (document.getElementById('iTasa') as HTMLInputElement).value = '';
            (document.getElementById('iDefault') as HTMLInputElement).checked = true;
            dlg.showModal();
            (document.getElementById('iNombre') as HTMLInputElement).focus();
        });
        document.getElementById('impCancel')?.addEventListener('click', () => dlg.close());

        document.getElementById('impSeed')?.addEventListener('click', async (ev) => {
            const btn = ev.currentTarget as HTMLButtonElement;
            btn.disabled = true;
            try {
                const res = await fetch('/api/impuestos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'seed' }) });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || M.i18nCrearErr || 'No se pudo crear');
                location.reload();
            } catch (err: any) { (window as any).cordToast?.(err.message || M.i18nCrearErr || 'No se pudo crear', 'error'); btn.disabled = false; }
        });

        document.getElementById('impCreate')?.addEventListener('click', async () => {
            const nombre = (document.getElementById('iNombre') as HTMLInputElement).value.trim();
            if (!nombre) { (document.getElementById('iNombre') as HTMLInputElement).focus(); return; }
            const kind = (document.getElementById('iKind') as HTMLSelectElement).value;
            const tasa = Number((document.getElementById('iTasa') as HTMLInputElement).value) || 0;
            const es_default = (document.getElementById('iDefault') as HTMLInputElement).checked;
            const btn = document.getElementById('impCreate') as HTMLButtonElement;
            btn.disabled = true;
            try {
                const res = await fetch('/api/impuestos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ nombre, kind, tasa, es_default }) });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || M.i18nCrearErr || 'No se pudo crear');
                location.reload();
            } catch (err: any) { (window as any).cordToast?.(err.message || M.i18nCrearErr || 'No se pudo crear', 'error'); btn.disabled = false; }
        });

        document.querySelectorAll('[data-setdef]').forEach((b) => b.addEventListener('click', async () => {
            const id = (b as HTMLElement).dataset.setdef!;
            try {
                const res = await fetch('/api/impuestos', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, es_default: true }) });
                if (!res.ok) throw new Error();
                location.reload();
            } catch { (window as any).cordToast?.(M.i18nActualizarErr || 'No se pudo actualizar', 'error'); }
        }));

        document.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', async () => {
            const id = (b as HTMLElement).dataset.del!;
            if (!await (window as any).cordConfirm({ title: M.i18nEliminarTitulo || 'Eliminar impuesto', body: M.i18nEliminarBody || '¿Eliminar este impuesto de tu configuración?', danger: true, confirmText: M.i18nEliminarConfirm || 'Eliminar' })) return;
            try {
                const res = await fetch('/api/impuestos', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
                if (!res.ok) { const d = await res.json(); throw new Error(d.error || M.i18nEliminarErr || 'No se pudo eliminar'); }
                (b.closest('.imp-row') as HTMLElement)?.remove();
            } catch (err: any) { (window as any).cordToast?.(err.message || M.i18nEliminarErr || 'No se pudo eliminar', 'error'); }
        }));

        document.getElementById('ivaIncluidoDefecto')?.addEventListener('change', async (e) => {
            const checked = (e.target as HTMLInputElement).checked;
            try {
                const res = await fetch('/api/org', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ iva_incluido_defecto: checked })
                });
                if (!res.ok) throw new Error();
            } catch {
                (window as any).cordToast?.(M.i18nConfigErr || 'No se pudo guardar la configuración', 'error');
                (e.target as HTMLInputElement).checked = !checked;
            }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initImpuestos);
    else initImpuestos();
</script>
