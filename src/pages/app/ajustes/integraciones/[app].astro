---
// /app/ajustes/integraciones/[app] — detalle de una integración: estado, conexión y workflows que la usan.
import SettingsShell from '../../../../components/app/SettingsShell.astro';
import IntegrationDetail from '../../../../components/app/IntegrationDetail.astro';
import { getMyMembership, getOrg } from '../../../../lib/queries';
import { memberCan } from '../../../../lib/permissions';
import { getActiveOrgId } from '../../../../lib/db';
import { currentLocale } from '../../../../lib/context';
import { hubspotStatus } from '../../../../lib/integraciones/hubspot/service';
import { findIntegration, integrationState, SHOPIFY_LISTO } from '../../../../lib/integraciones/catalogo';
import { slackCredentials } from '../../../../lib/integraciones/slack-oauth';
import { teamsCredentials } from '../../../../lib/integraciones/teams-graph';
import { connectedOAuthApps } from '../../../../lib/oauth-provider';
import { getShopifyConexion } from '../../../../lib/integraciones/shopify/service';
import { estadoHoja } from '../../../../lib/integraciones/hojas/service';
import { credencialesHoja } from '../../../../lib/integraciones/hojas/config';
import { estadoConta } from '../../../../lib/integraciones/contabilidad/service';
import { credencialesConta, esProveedorConta } from '../../../../lib/integraciones/contabilidad/config';

export const prerender = false;

const app = findIntegration(Astro.params.app);
if (!app) return Astro.redirect('/app/ajustes/integraciones');

const L = currentLocale();
const ORG = await getOrg();
const ME = await getMyMembership();
const canAjustes = memberCan(ME, 'ajustes');
const HS = canAjustes && app.slug === 'hubspot' ? await hubspotStatus(await getActiveOrgId(), false).catch(() => null) : null;
const OAUTH = app.slug === 'zapier' || app.slug === 'make' ? await connectedOAuthApps(await getActiveOrgId()).catch(() => []) : [];
const SHOPIFY = canAjustes && app.slug === 'shopify' ? await getShopifyConexion(await getActiveOrgId()).catch(() => null) : null;
const PROV_HOJA = app.slug === 'google-sheets' ? 'google_sheets' as const : app.slug === 'excel' ? 'excel' as const : null;
const HOJA = canAjustes && PROV_HOJA ? await estadoHoja(await getActiveOrgId(), PROV_HOJA).catch(() => null) : null;
const PROV_CONTA = esProveedorConta(app.slug) ? app.slug : null;
const CONTA = canAjustes && PROV_CONTA ? await estadoConta(await getActiveOrgId(), PROV_CONTA).catch(() => null) : null;
const state = integrationState(app, { hubspot: HS?.conexion?.estado ?? null, shopify: SHOPIFY?.estado ?? null, googleSheets: app.slug === 'google-sheets' ? HOJA?.estado ?? null : null, excel: app.slug === 'excel' ? HOJA?.estado ?? null : null, quickbooks: app.slug === 'quickbooks' ? CONTA?.estado ?? null : null, xero: app.slug === 'xero' ? CONTA?.estado ?? null : null, slack: Boolean(ORG.slackWebhook), teams: Boolean(ORG.teamsWebhook || ORG.teamsCanal), teamsError: ORG.teamsGraph === 'error', whatsapp: Boolean(ORG.whatsappConectado), oauth: OAUTH });
---

<SettingsShell title={`${app.nombre} — Integraciones`} tab="integraciones" perm="ajustes">
    <IntegrationDetail
        lang={L}
        app={app}
        state={state}
        canAjustes={canAjustes}
        hubspot={HS}
        hubspotFlash={Astro.url.searchParams.get('hubspot')}
        slackWebhook={ORG.slackWebhook ?? ''}
        slack={{ canal: ORG.slackCanal ?? '', equipo: ORG.slackEquipo ?? '', oauth: Boolean(slackCredentials()), flash: Astro.url.searchParams.get('slack') }}
        shopify={{ conexion: SHOPIFY, disponible: SHOPIFY_LISTO, flash: Astro.url.searchParams.get('shopify'), tiendaSugerida: Astro.url.searchParams.get('tienda') }}
        hoja={{ conexion: HOJA, disponible: Boolean(PROV_HOJA && credencialesHoja(PROV_HOJA)), flash: Astro.url.searchParams.get('hoja') }}
        conta={{ conexion: CONTA, disponible: Boolean(PROV_CONTA && credencialesConta(PROV_CONTA)), flash: Astro.url.searchParams.get('conta') }}
        teamsWebhook={ORG.teamsWebhook ?? ''}
        teams={{ canal: ORG.teamsCanal, equipo: ORG.teamsEquipo, usuario: ORG.teamsUsuario, estado: ORG.teamsGraph, oauth: Boolean(teamsCredentials()), flash: Astro.url.searchParams.get('teams') }}
        whatsapp={{ phoneId: ORG.whatsappPhoneId ?? '', plantilla: ORG.whatsappPlantilla ?? '', idioma: ORG.whatsappIdioma ?? '', conectado: Boolean(ORG.whatsappConectado) }}
    />
</SettingsShell>
