---
// Ajustes › Auditoría — feature_min_plan `audit_log`. El gate por plan se
// resuelve aquí (no en middleware, que antes redirigía duro a
// /app/ajustes/plan antes de que la página cargara). SettingsShell ya resuelve
// el gate por PERMISO (perm="ajustes"); este es el segundo gate, por PLAN.
import SettingsShell from '../../../components/app/SettingsShell.astro';
import '../../../styles/modal.css';
import PlanPaywallModal from '../../../components/app/PlanPaywallModal.astro';
import { getAuditLog } from '../../../lib/queries';
import { getActiveOrgId } from '../../../lib/db';
import { checkEntitlement } from '../../../lib/org-entitlements';
import { planLabel } from '../../../lib/permissions';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';

const L = currentLocale();
const entitlementCheck = await checkEntitlement(await getActiveOrgId(), 'audit_log');
const AUDIT = entitlementCheck.ok ? await getAuditLog() : [];
---

<SettingsShell title="Auditoría — Ajustes" tab="auditoria" perm="ajustes"
    intro={t(L, 'set.aud.intro')}>
    <div class="s-block full">
        <div class="audit-list">
            {AUDIT.length === 0 && <p class="audit-empty">{t(L, 'set.aud.vacio')}</p>}
            {AUDIT.map((a) => (
                <div class="audit-row">
                    <span class="audit-accion">{a.accion}</span>
                    <span class="audit-detalle">{a.detalle}</span>
                    <span class="audit-meta">{a.cuando}{a.ip && a.ip !== 'desconocida' ? ` · ${a.ip}` : ''}</span>
                </div>
            ))}
        </div>
    </div>
    {!entitlementCheck.ok && (
        <PlanPaywallModal
            id="auditoriaPlanModal"
            title={t(L, 'set.aud.plan_titulo')}
            desc={t(L, 'set.aud.plan_desc')
                .replace('{plan}', planLabel(entitlementCheck.requiredPlan))
                .replace('{current}', planLabel(entitlementCheck.plan))}
            requiredPlan={entitlementCheck.requiredPlan}
            locale={L === 'en' ? 'en' : 'es'}
            returnHref="/app/ajustes"
        />
    )}
</SettingsShell>

<style>
    .audit-list { display: flex; flex-direction: column; max-height: 560px; overflow-y: auto; }
    .audit-row { display: grid; grid-template-columns: auto 1fr auto; gap: 0.9rem; align-items: baseline; padding: 0.65rem 0; border-bottom: 1px solid var(--color-border); }
    .audit-row:last-child { border-bottom: none; }
    .audit-accion { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.68rem; font-weight: 700; color: var(--color-blue-deep); white-space: nowrap; }
    .audit-detalle { font-size: 0.82rem; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .audit-meta { font-size: 0.66rem; color: var(--color-text-muted); white-space: nowrap; }
    .audit-empty { font-size: 0.84rem; color: var(--color-text-muted); margin: 0.4rem 0; }
    @media (max-width: 640px) { .audit-row { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
