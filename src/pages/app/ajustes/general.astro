---
// Ajustes › General — identidad del negocio, contacto, presencia y localización.
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg } from '../../../lib/queries';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
import { listCountries } from '../../../lib/countries';
import { listTimeZones, canonicalZone } from '../../../lib/timezones';
import { listOfferedCurrencies } from '../../../lib/currency';
import FlagSelect from '../../../components/ui/FlagSelect';
const ORG = await getOrg();
const L = currentLocale();
const COUNTRY_OPTIONS = listCountries(L, ORG.countryCode).map((country) => ({
    code: country.code,
    label: country.name,
    hint: country.tag,
}));

const displayCurrency = new Intl.DisplayNames([L], { type: 'currency' });
// El set que Cord ofrece, con la divisa actual de la org primero. No es el ISO
// completo: ver OFFERED_CURRENCIES en lib/currency.ts.
const MONEDAS = listOfferedCurrencies(ORG.moneda)
    .map((code) => ({ v: code, l: `${code} — ${displayCurrency.of(code) || code}` }));
// Zonas con offset y país (src/lib/timezones.ts). Las del país donde opera el
// negocio van primero; `ORG.zonaHoraria` se pasa como `ensure` para que una
// cuenta guardada con un alias de ICU siga encontrando la suya seleccionada.
// El valor guardado puede ser un alias ('Asia/Kolkata'); el catálogo usa el id
// canónico de ICU, así que ambos lados se comparan ya canonizados o la zona del
// negocio no saldría seleccionada.
const ZONA_ACTUAL = canonicalZone(ORG.zonaHoraria);
const ZONAS = listTimeZones(L, ORG.countryCode, ORG.zonaHoraria).map((z) => ({
    code: z.id,
    label: z.city,
    hint: z.country ? `${z.offset} · ${z.country}` : z.offset,
    // `flag` es OBLIGATORIO aquí: FlagSelect cae a usar `code` como ISO y
    // 'America/Mexico_City' no es un código de país.
    flag: z.countryCode || 'UN',
}));
---

<SettingsShell title="General — Ajustes" tab="general" perm="ajustes"
    intro={t(L, 'set.general.intro')} save>

    <div class="s-block">
        <h3>{t(L, 'set.general.identidad')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label for="oNombre">{t(L, 'set.general.nombre')}</label>
                    <input class="s-input" id="oNombre" data-field="nombre" value={ORG.nombre} />
                </div>
                <div class="s-field">
                    <label for="oMoneda">{t(L, 'set.general.moneda')}</label>
                    <select class="s-input" id="oMoneda" data-field="moneda">
                        {MONEDAS.map((m) => <option value={m.v} selected={ORG.moneda === m.v}>{m.l}</option>)}
                    </select>
                    <span class="s-hint">{t(L, 'set.general.moneda_hint')}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.general.contacto')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label for="oEmail">{t(L, 'set.general.correo_contacto')}</label>
                    <input class="s-input" id="oEmail" data-field="email_contacto" type="email" value={ORG.email} placeholder="ventas@tunegocio.mx" />
                </div>
                <div class="s-field">
                    <label for="oTelefono">{t(L, 'set.general.telefono')}</label>
                    <input class="s-input" id="oTelefono" data-field="telefono" value={ORG.telefono} placeholder="55 1234 5678" />
                </div>
            </div>
            <div class="s-field">
                <label for="oDireccion">{t(L, 'set.general.direccion')}</label>
                <input class="s-input" id="oDireccion" data-field="direccion" value={ORG.direccion} placeholder={t(L, 'set.general.direccion_ph')} />
            </div>
        </div>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.general.presencia')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label for="oWeb">{t(L, 'set.general.sitio_web')}</label>
                    <input class="s-input" id="oWeb" data-field="sitio_web" value={ORG.sitioWeb} placeholder="https://tunegocio.mx" />
                </div>
                <div class="s-field">
                    <label for="oWa">{t(L, 'set.general.whatsapp')}</label>
                    <input class="s-input" id="oWa" data-field="whatsapp" value={ORG.whatsapp} placeholder="5215512345678" />
                    <span class="s-hint">{t(L, 'set.general.whatsapp_hint')}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.general.localizacion')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label id="oCountryLabel">{L === 'en' ? 'Country of operation' : 'País donde operas'}</label>
                    <FlagSelect
                        client:load
                        ariaLabel={L === 'en' ? 'Country of operation' : 'País donde operas'}
                        options={COUNTRY_OPTIONS}
                        defaultValue={ORG.countryCode}
                        nativeId="oCountry"
                        nativeName="country_code"
                        nativeDataField="country_code"
                    />
                    <span class="s-hint">{L === 'en'
                        ? 'Controls the invoicing experience and regulatory rail shown by Cord.'
                        : 'Define la experiencia de facturación y el carril regulatorio que muestra Cord.'}</span>
                </div>
                <div class="s-field">
                    <label id="oZonaLabel">{t(L, 'set.general.zona_horaria')}</label>
                    <FlagSelect
                        client:load
                        ariaLabel={t(L, 'set.general.zona_horaria')}
                        options={ZONAS}
                        defaultValue={ZONA_ACTUAL}
                        nativeId="oZona"
                        nativeName="zona_horaria"
                        nativeDataField="zona_horaria"
                    />
                    <span class="s-hint">{t(L, 'set.general.zona_horaria_hint')}</span>
                </div>
            </div>
            <div class="s-field" style="max-width:50%">
                    <label for="oIdioma">{t(L, 'set.general.idioma')}</label>
                    <select class="s-input" id="oIdioma" data-field="idioma">
                        <option value="es-MX" selected={ORG.idioma === 'es-MX'}>Español</option>
                        <option value="en-US" selected={ORG.idioma === 'en-US'}>English</option>
                    </select>
                    <span class="s-hint">{L === 'en'
                        ? 'Applies to the app, your public links and the emails Cord sends on your behalf.'
                        : 'Aplica a la aplicación, a tus links públicos y a los correos que Cord envía en tu nombre.'}</span>
            </div>
        </div>
    </div>
</SettingsShell>
