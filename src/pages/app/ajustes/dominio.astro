    en: {
        title: 'Custom domain', pageTitle: 'Custom domain — Settings',
        intro: 'Give your quotes an address that carries your brand. Connect a subdomain and keep your website where it is.',
        loading: 'Checking domain status…', refreshing: 'Refreshing status…', retry: 'Refresh status',
        preparationTitle: 'Custom domains are being prepared',
        preparation: 'Domain connections are not available yet. You will be able to set yours up here when they are ready.',
        planTitle: 'Your brand, right in the address',
        plan: 'Custom domains are available on the Professional plan and above.', upgrade: 'View Professional plan',
        sandboxTitle: 'Unavailable in the test environment',
        sandbox: 'Exit test mode using the organization switcher to connect a domain.',
