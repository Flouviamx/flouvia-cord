            provider_scope_changed: 'La configuración del servicio cambió. Soporte debe revisar la conexión; no necesitas modificar tu DNS.',
            disconnect_failed: 'El acceso por este dominio ya está bloqueado, pero falta completar la desconexión. Pulsa Desconectar dominio para reintentar.',
        },
