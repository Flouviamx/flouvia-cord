---
// Ajustes › Cotizaciones e impuestos — folio, IVA, defaults, retenciones y leyenda.
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg, getImpuestos } from '../../../lib/queries';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
const [ORG, IMPUESTOS] = await Promise.all([getOrg(), getImpuestos()]);
// Solo las predeterminadas: son las que el motor aplica al documento.
const RETENCIONES = IMPUESTOS.filter((i) => i.kind === 'retencion' && i.activo && i.esDefault && i.tasa > 0);
const L = currentLocale();
const isMx = ORG.countryCode === 'MX';
const TERMS = [
    { v: 'contado', l: t(L, 'set.cot.term.contado') },
    { v: 'net30', l: t(L, 'set.cot.term.net30') },
    { v: 'net60', l: t(L, 'set.cot.term.net60') },
];
---

<SettingsShell title="Cotizaciones e impuestos — Ajustes" tab="cotizaciones" perm="ajustes"
    intro={isMx
        ? t(L, 'set.cot.intro')
        : (L === 'en'
            ? 'Numbering, taxes, and defaults used by every new quote. Configure the rate that applies to your business.'
            : 'Folio, impuestos y valores con los que arranca cada cotización. Configura la tasa que corresponda a tu negocio.')} save>
    <div class="s-block">
        <h3>{t(L, 'set.cot.folio')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label for="oPrefix">{t(L, 'set.cot.prefijo')}</label>
                    <input class="s-input" id="oPrefix" data-field="quote_prefix" value={ORG.prefix} maxlength="6" />
                    <span class="s-hint">{t(L, 'set.cot.prefijo_hint').replace('{prefix}', ORG.prefix)}</span>
                </div>
                <div class="s-field" style={isMx ? undefined : 'display:none;'}>
                    <label for="oSerie">{t(L, 'set.cot.serie')}</label>
                    <input class="s-input" id="oSerie" data-field="serie_folio" value={ORG.serieFolio} maxlength="6" placeholder="A" />
                    <span class="s-hint">{t(L, 'set.cot.serie_hint')}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.cot.impuestos')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label for="oIva">{t(L, 'set.cot.tasa_default')}</label>
                    <input class="s-input" id="oIva" data-field="iva_pct" type="number" min="0" max="100" step="0.001" value={ORG.ivaPct} />
                    <span class="s-hint">{t(L, 'set.cot.tasa_default_hint')}</span>
                </div>
            </div>

            <!-- Las retenciones se LEEN del catálogo, no se capturan aquí.
                 Antes había dos campos (`retencion_iva_pct`, `retencion_isr_pct`)
                 que el negocio llenaba y que no leía nadie: ni los totales, ni
                 el PDF, ni el CFDI. Tener dos lugares donde declarar la misma
                 tasa es exactamente cómo uno de los dos se queda sin consumidor. -->
            <div class="ret-summary">
                <h4>{t(L, 'set.cot.retenciones_titulo')}</h4>
                {RETENCIONES.length === 0
                    ? <p class="s-hint">{t(L, 'set.cot.retenciones_vacio')}</p>
                    : (
                        <ul class="ret-list">
                            {RETENCIONES.map((r) => (
                                <li><span>{r.nombre}</span><span class="editorial">−{r.tasa}%</span></li>
                            ))}
                        </ul>
                    )}
                <p class="s-hint">{t(L, 'set.cot.retenciones_nota')}</p>
                <a class="ret-link" href="/app/ajustes/impuestos">{t(L, 'set.cot.ir_impuestos')} →</a>
            </div>
        </div>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.cot.defaults')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label for="oVig">{t(L, 'set.cot.vigencia')}</label>
                    <input class="s-input" id="oVig" data-field="vigencia_default_dias" type="number" min="1" max="365" step="1" value={ORG.vigenciaDefaultDias} />
                    <span class="s-hint">{t(L, 'set.cot.vigencia_hint')}</span>
                </div>
                <div class="s-field">
                    <label for="oTerm">{t(L, 'set.cot.terminos')}</label>
                    <select class="s-input" id="oTerm" data-field="terminos_default">
                        {TERMS.map((tm) => <option value={tm.v} selected={ORG.terminosDefault === tm.v}>{tm.l}</option>)}
                    </select>
                    <span class="s-hint">{t(L, 'set.cot.terminos_hint')}</span>
                </div>
            </div>
            <div class="s-row">
                <div class="s-field">
                    <label for="oAnticipo">{t(L, 'set.cot.anticipo')}</label>
                    <input class="s-input" id="oAnticipo" data-field="anticipo_default_pct" type="number" min="0" max="99" step="1" value={ORG.anticipoDefaultPct || ''} placeholder="0" />
                    <span class="s-hint">{t(L, 'set.cot.anticipo_hint')}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.cot.leyenda')}</h3>
        <div class="s-body">
            <div class="s-field">
                <label for="oLegal">{t(L, 'set.cot.texto_legal')}</label>
                <textarea class="s-input s-textarea" id="oLegal" data-field="texto_legal" rows="2" placeholder={`Esta cotización no es un comprobante fiscal. Precios en ${ORG.moneda}. Vigencia sujeta a disponibilidad.`}>{ORG.textoLegal}</textarea>
                <span class="s-hint">{t(L, 'set.cot.texto_legal_hint')}</span>
            </div>
        </div>
    </div>
</SettingsShell>

<style>
    .ret-summary { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--color-border); }
    .ret-summary h4 { font-size: 0.86rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.6rem; }
    .ret-list { list-style: none; margin: 0 0 0.7rem; padding: 0; display: flex; flex-direction: column; }
    .ret-list li { display: flex; justify-content: space-between; gap: 1.5rem; padding: 0.55rem 0; border-bottom: 1px solid var(--color-border); font-size: 0.85rem; }
    .ret-list li:last-child { border-bottom: none; }
    .ret-list .editorial { color: #b45309; }
    .ret-link { display: inline-block; margin-top: 0.4rem; font-size: 0.82rem; font-weight: 600; color: var(--color-blue-deep); text-decoration: none; }
    .ret-link:hover { opacity: 0.75; }
</style>
