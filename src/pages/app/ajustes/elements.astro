---
// Ajustes › Developers › Cotizador embebible (CORD Elements).
// Permite (1) copiar el snippet de instalación del <iframe> en sitios de terceros
// y (2) gestionar la allowlist de dominios (orgs.embed_domains) que alimenta el
// header CSP `frame-ancestors`. Estilo LISTA (regla de André, no tarjetas).
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg } from '../../../lib/queries';
import { sql, getActiveOrgId } from '../../../lib/db';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';

const ORG = await getOrg();
const L = currentLocale();

// Token real de una cotización enviada → snippet copy-paste que YA funciona.
// Si no hay ninguna aún, mostramos un placeholder.
const orgId = await getActiveOrgId();
const [reciente] = await sql`
    select public_token from cotizaciones
    where org_id = ${orgId} and status <> 'draft'
    order by created_at desc limit 1`;
const hasSample = !!reciente?.public_token;
const sampleToken = (reciente?.public_token as string) || 'TOKEN_DE_TU_COTIZACION';

const base = Astro.url.origin;
const snippet = `<!-- Cotizador Cord -->
<script src="${base}/embed.js" async></script>
<div data-cord-token="${sampleToken}"></div>`;
const hasDomains = (ORG.embedDomains || '').trim().length > 0;
---

<SettingsShell title="Cotizador embebible — Ajustes" tab="elements" perm="ajustes" save={true}
    intro={t(L, 'set.el.intro')}>

    <div class="s-block full">
        <div class="el-preview-head">
            <h3>{t(L, 'set.el.preview_titulo')}</h3>
            <span class:list={['el-install-badge', hasDomains ? 'ok' : 'open']}>
                {hasDomains ? t(L, 'set.el.preview_dominios_ok') : t(L, 'set.el.preview_dominios_abierto')}
            </span>
        </div>
        {hasSample ? (
            <>
                <p class="el-p">{t(L, 'set.el.preview_desc')}</p>
                <div class="el-frame">
                    <div class="el-frame-bar">
                        <span class="el-frame-dot" /><span class="el-frame-dot" /><span class="el-frame-dot" />
                        <span class="el-frame-url">tu-sitio.com</span>
                    </div>
                    <iframe class="el-frame-iframe" src={`/embed/${sampleToken}`} title="Preview del cotizador embebido" loading="lazy" />
                </div>
                <a class="el-preview" href={`/embed/${sampleToken}`} target="_blank" rel="noopener">{t(L, 'set.el.ver_embed')}</a>
            </>
        ) : (
            <p class="el-p el-preview-empty">{t(L, 'set.el.preview_vacio')}</p>
        )}
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.el.paso1_titulo')}</h3>
        <p class="el-p">{t(L, 'set.el.paso1_desc')}</p>
        <div class="el-code">
            <pre><code id="elSnippet">{snippet}</code></pre>
            <button class="el-copy" id="elCopy" type="button" data-i18n-copiar={t(L, 'set.el.copiar')} data-i18n-copiado={t(L, 'set.el.copiado')}>{t(L, 'set.el.copiar')}</button>
        </div>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.el.paso2_titulo')}</h3>
        <p class="el-p" set:html={t(L, 'set.el.paso2_desc')} />
        <textarea class="el-domains" data-field="embed_domains" rows="4"
            placeholder="cliente-a.com&#10;*.cliente-b.com">{ORG.embedDomains}</textarea>
        <p class:list={['el-status', hasDomains ? 'ok' : 'warn']}>
            {hasDomains ? t(L, 'set.el.status_ok') : t(L, 'set.el.status_warn')}
        </p>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.el.paso3_titulo')}</h3>
        <p class="el-p">{t(L, 'set.el.paso3_desc')}</p>
        <div class="el-code">
            <pre><code>{`document.querySelector('[data-cord-token]')
  .addEventListener('cord:approved', (e) => {
    console.log('Aprobada', e.detail.folio);
  });`}</code></pre>
        </div>
        <ul class="el-events">
            <li><code>cord:ready</code> — {t(L, 'set.el.ev_ready')}</li>
            <li><code>cord:approved</code> — {t(L, 'set.el.ev_approved')} <span>{t(L, 'set.el.ev_approved_detail')}</span></li>
            <li><code>cord:signed</code> — {t(L, 'set.el.ev_signed')} <span>{t(L, 'set.el.ev_signed_detail')}</span></li>
            <li><code>cord:rejected</code> — {t(L, 'set.el.ev_rejected')}</li>
            <li><code>cord:message</code> — {t(L, 'set.el.ev_message')}</li>
            <li><code>cord:pay</code> — {t(L, 'set.el.ev_pay')}</li>
        </ul>
    </div>
</SettingsShell>

<style>
    .el-p { font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55; margin: 0 0 0.9rem; }
    .el-p code, .el-events code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.78rem; background: rgba(10,25,47,0.06); padding: 1px 5px; border-radius: 4px; }
    .el-code { position: relative; }
    .el-code pre { background: #0a192f; color: #e6edf3; border-radius: 12px; padding: 1.1rem 1.2rem; overflow-x: auto; margin: 0; }
    .el-code code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.8rem; line-height: 1.6; white-space: pre; }
    .el-copy {
        position: absolute; top: 10px; right: 10px;
        font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600;
        color: #cdd9e5; background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.14); border-radius: 8px;
        padding: 5px 11px; cursor: pointer; transition: background 0.2s;
    }
    .el-copy:hover { background: rgba(255,255,255,0.16); }
    .el-copy.done { color: #6ee7b7; border-color: rgba(110,231,183,0.4); }
    .el-preview { display: inline-block; margin-top: 0.8rem; font-size: 0.82rem; font-weight: 600; color: var(--color-blue-deep); text-decoration: none; }
    .el-preview:hover { text-decoration: underline; }
    html[data-theme="dark"] .el-preview { color: #7fb0ff; }

    /* ── Vista previa en vivo ── */
    .el-preview-head { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.3rem; }
    .el-preview-head h3 { margin: 0; }
    .el-install-badge { font-size: 0.68rem; font-weight: 700; padding: 4px 10px; border-radius: 100px; white-space: nowrap; }
    .el-install-badge.ok { color: var(--color-ok); background: rgba(16,185,129,0.12); }
    .el-install-badge.open { color: #b45309; background: rgba(245,158,11,0.12); }
    .el-preview-empty { padding: 2rem 1rem; text-align: center; background: var(--color-bg-soft); border-radius: 12px; }
    .el-frame { border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden; background: var(--surface); }
    .el-frame-bar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: var(--color-bg-soft); border-bottom: 1px solid var(--color-border); }
    .el-frame-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-border); }
    .el-frame-url { margin-left: 8px; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.7rem; color: var(--color-text-muted); }
    .el-frame-iframe { display: block; width: 100%; height: 480px; border: none; background: var(--color-bg-soft); }
    .el-domains {
        width: 100%; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.82rem;
        color: var(--color-text); background: var(--surface);
        border: 1px solid var(--color-border); border-radius: 10px; padding: 11px 13px; resize: vertical;
    }
    .el-domains:focus { outline: none; border-color: var(--color-blue-deep); }
    .el-status { font-size: 0.8rem; line-height: 1.5; margin: 0.8rem 0 0; padding: 0.7rem 0.9rem; border-radius: 10px; }
    .el-status.ok { color: #047857; background: rgba(16,185,129,0.1); }
    .el-status.warn { color: #b45309; background: rgba(245,158,11,0.12); }
    .el-events { margin: 1rem 0 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .el-events li { font-size: 0.83rem; color: var(--color-text); line-height: 1.5; }
    .el-events span { color: var(--color-text-muted); font-size: 0.76rem; }

    @media (max-width: 600px) {
        .el-preview-head { align-items: flex-start; }
        .el-frame-iframe { height: min(480px, 70dvh); }
        .el-copy { min-width: 64px; min-height: 44px; top: 8px; right: 8px; }
        .el-code pre { padding: 3.8rem 1rem 1rem; }
        .el-preview { min-height: 44px; display: inline-flex; align-items: center; }
        .el-domains { min-height: 112px; font-size: 16px; }
    }
</style>

<script>
    function initElements() {
        const btn = document.getElementById('elCopy');
        const code = document.getElementById('elSnippet');
        if (!btn || !code) return;
        const i18nCopiar = (btn as HTMLElement).dataset.i18nCopiar || 'Copiar';
        const i18nCopiado = (btn as HTMLElement).dataset.i18nCopiado || '✓ Copiado';
        btn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(code.textContent || '');
                btn.textContent = i18nCopiado; btn.classList.add('done');
                setTimeout(() => { btn.textContent = i18nCopiar; btn.classList.remove('done'); }, 2000);
            } catch {}
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initElements);
    else initElements();
</script>
