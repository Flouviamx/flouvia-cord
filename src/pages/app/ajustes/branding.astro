---
import SettingsShell from '../../../components/app/SettingsShell.astro';
import BrandEditor from '../../../components/app/brand/BrandEditor.astro';
import { getOrg } from '../../../lib/queries';
import { currentLocale } from '../../../lib/context';
const org = await getOrg();
const en = currentLocale() === 'en';
---
<SettingsShell title={en ? 'Brand appearance — Settings' : 'Marca y apariencia — Ajustes'} tab="branding" perm="ajustes" save>
    <BrandEditor org={org} mode="identity" />
</SettingsShell>
