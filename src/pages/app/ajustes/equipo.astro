---
// Ajustes › Equipo y permisos.
//
// Rediseño ago 2026. Lo que estaba roto antes: el tab "Inactivos" siempre salía
// vacío (el SQL de getMembers filtraba los revocados), "Exportar" no tenía
// listener, la columna "Último inicio de sesión" mostraba la fecha de ALTA
// porque el dato no existía, 13 atributos data-i18n-* se emitían y nunca se
// leían (todos los toasts estaban en español duro), faltaban 4 claves i18n que
// renderizaban la clave cruda en el picker, el picker estaba duplicado literal
// entre los dos modales, y el límite de asientos que promete /precios no
// existía en código ni se mostraba.
import SettingsShell from '../../../components/app/SettingsShell.astro';
import '../../../styles/modal.css';
import PermPicker from '../../../components/app/PermPicker.astro';
import { getOrg, getMembers, getMyMembership, getSeatUsage } from '../../../lib/queries';
import { memberCan, PERMISOS, PRESETS, planTieneEquipo, minPlanOf, planLabel, TEAM_PLANS } from '../../../lib/permissions';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';

const [ORG, ME, members, seats] = await Promise.all([
    getOrg(), getMyMembership(), getMembers(), getSeatUsage(),
]);
const canEdit = memberCan(ME, 'equipo');
const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const activos = members.filter((m) => m.estado === 'activo');
const pendientes = members.filter((m) => m.estado === 'invitado');
const inactivos = members.filter((m) => m.estado === 'revocado');

const ROL_LABEL: Record<string, string> = {
    owner: t(L, 'set.eq.rol.owner'),
    admin: t(L, 'set.eq.rol.admin'),
    vendedor: t(L, 'set.eq.rol.vendedor'),
    lectura: t(L, 'set.eq.rol.lectura'),
};

const ilimitado = !Number.isFinite(seats.limite);
const lleno = !ilimitado && seats.usados >= seats.limite;
const pctAsientos = ilimitado ? 0 : Math.min(100, Math.round((seats.usados / seats.limite) * 100));
const tienePlanEquipo = planTieneEquipo(seats.plan);
const dominios = (ORG.inviteDomains || '').split(',').map((d: string) => d.trim()).filter(Boolean);

// Todo lo que el <script> necesita traducido (no es is:inline, no puede llamar
// t() en runtime). Antes se emitían 13 data-i18n-* que el script jamás leía.
const EQ_T = {
    invitado: t(L, 'set.eq.toast_invitado'),
    invitado_link: t(L, 'set.eq.toast_invitado_link'),
    actualizado: t(L, 'set.eq.toast_actualizado'),
    revocado: t(L, 'set.eq.toast_revocado'),
    reenviado: t(L, 'set.eq.invitacion_reenviada'),
    error: t(L, 'set.eq.toast_error'),
    viendo: t(L, 'set.eq.viendo'),
    exportando: t(L, 'set.eq.exportando'),
    dominio_invalido: tf('set.eq.dominio_invalido', { dominios: dominios.join(', ') }),
    custom_label: t(L, 'set.eq.preset.custom.label'),
    presets: JSON.stringify(Object.fromEntries(
        Object.entries(PRESETS).map(([k, v]) => [k, v.permisos]),
    )),
    presetDescs: JSON.stringify({
        ...Object.fromEntries(Object.keys(PRESETS).map((k) => [k, t(L, `set.eq.preset.${k}.desc` as any)])),
        __custom: t(L, 'set.eq.personalizado_desc'),
    }),
    dominios: JSON.stringify(dominios),
    // Etiquetas de permiso para la ficha (el drawer las pinta por JS).
    permLabels: JSON.stringify(Object.fromEntries(
        PERMISOS.map((p) => [p.key, t(L, `set.eq.perm.${p.key}.label` as any)]),
    )),
    sinPermisos: t(L, 'set.eq.ficha_sin_permisos'),
    ultimaAccion: t(L, 'set.eq.ficha_ultima_accion'),
    actSesion: t(L, 'set.eq.act_sesion'),
    actNunca: t(L, 'set.eq.act_nunca'),
    actCotizaciones: t(L, 'set.eq.act_cotizaciones'),
};
---

<SettingsShell title="Equipo y permisos — Ajustes" tab="equipo" intro={t(L, 'set.eq.intro')}>

    <div data-eq-shell data-t={JSON.stringify(EQ_T)}>

        {/* ── Asientos: antes no había ninguna señal de plan en la página; el
             usuario se enteraba del límite con un 402 al invitar. ── */}
        <div class="eq-seats">
            <div class="eq-seats-copy">
                <strong class="editorial">
                    {ilimitado
                        ? tf('set.eq.asientos_ilimitados', { usados: String(seats.usados) })
                        : tf('set.eq.asientos', { usados: String(seats.usados), limite: String(seats.limite) })}
                </strong>
                {lleno && <small>{tf('set.eq.asientos_lleno', { plan: planLabel(seats.plan) })}</small>}
            </div>
            {!ilimitado && (
                <div class="eq-seats-bar" role="presentation">
                    <i style={`width:${pctAsientos}%`} class={lleno ? 'is-full' : ''}></i>
                </div>
            )}
            <div class="eq-seats-actions">
                <button type="button" class="eq-btn" id="eqExport">{t(L, 'set.eq.exportar')}</button>
                {canEdit && (lleno || !tienePlanEquipo
                    ? <a class="eq-btn eq-btn-primary" href={`/app/ajustes/plan?plan=${minPlanOf(TEAM_PLANS)}`}>{t(L, 'set.eq.asientos_ver_planes')}</a>
                    : <button type="button" class="eq-btn eq-btn-primary" id="eqInvite">{t(L, 'set.eq.agregar_miembro')}</button>)}
            </div>
        </div>

        {dominios.length > 0 && (
            <p class="eq-domains">{tf('set.eq.dominios_aviso', { dominios: dominios.join(', ') })}</p>
        )}

        {/* ── Filtros ── */}
        <div class="eq-filters" data-eq-filters>
            <button type="button" class="eq-chip is-active" data-eq-filter="todos">{t(L, 'set.eq.todos')} <b>{members.length}</b></button>
            <button type="button" class="eq-chip" data-eq-filter="activo">{t(L, 'set.eq.activos')} <b>{activos.length}</b></button>
            <button type="button" class="eq-chip" data-eq-filter="invitado">{t(L, 'set.eq.invitaciones_pendientes')} <b>{pendientes.length}</b></button>
            <button type="button" class="eq-chip" data-eq-filter="revocado">{t(L, 'set.eq.inactivos')} <b>{inactivos.length}</b></button>
        </div>

        {/* ── Tabla ── */}
        <div class="eq-table">
            <div class="eq-thead">
                <span>{t(L, 'set.eq.col_miembro')}</span>
                <span>{t(L, 'set.eq.th_rol')}</span>
                <span>{t(L, 'set.eq.col_actividad')}</span>
                <span></span>
            </div>
            <div class="eq-tbody" id="eqList">
                {members.map((m) => (
                    <div class="eq-row" data-eq-row data-estado={m.estado} data-id={m.id}
                        data-email={m.email} data-nombre={m.nombre} data-rol={m.rol}
                        data-sso={m.ssoManaged ? '1' : ''}
                        data-inicial={m.inicial} data-desde={m.desde}
                        data-sesion={m.ultimaSesion ?? ''} data-cot30={String(m.cotizaciones30d)}
                        data-accion={m.ultimaAccion ?? ''} data-esyo={m.esYo ? '1' : ''}
                        data-rol-label={ROL_LABEL[m.rol] ?? t(L, 'set.eq.rol.miembro')}
                        data-permisos={JSON.stringify(m.permisos)}>
                        <button type="button" class="eq-rowlink" data-eq-act="ficha" aria-label={m.nombre}></button>
                        <span class="eq-member">
                            <span class="eq-avatar" aria-hidden="true">{m.inicial}</span>
                            <span class="eq-member-text">
                                <b>
                                    {m.nombre}
                                    {m.esYo && <em class="eq-you">{t(L, 'set.eq.tu')}</em>}
                                </b>
                                <small>{m.email || '—'}</small>
                            </span>
                        </span>

                        <span class="eq-rolcell">
                            <span class:list={['eq-role', m.rol]}>{ROL_LABEL[m.rol] ?? t(L, 'set.eq.rol.miembro')}</span>
                            {m.ssoManaged && <span class="eq-sso" title={t(L, 'set.eq.sso_desc')}>{t(L, 'set.eq.sso_badge')}</span>}
                        </span>

                        <span class="eq-activity">
                            {m.estado === 'invitado' ? (
                                <span class={m.invitacionExpirada ? 'eq-state is-expired' : 'eq-state is-pending'}>
                                    {m.invitacionExpirada ? t(L, 'set.eq.invite_expirada') : t(L, 'set.eq.estado_invitado')}
                                </span>
                            ) : m.estado === 'revocado' ? (
                                <span class="eq-state is-off">{t(L, 'set.eq.estado_revocado')}</span>
                            ) : (
                                <>
                                    <b>{m.ultimaSesion ? tf('set.eq.act_sesion', { fecha: m.ultimaSesion }) : t(L, 'set.eq.act_nunca')}</b>
                                    {m.cotizaciones30d > 0 && <small>{tf('set.eq.act_cotizaciones', { n: String(m.cotizaciones30d) })}</small>}
                                </>
                            )}
                        </span>

                        <span class="eq-rowactions">
                            {canEdit && !m.esYo && m.rol !== 'owner' && (
                                <>
                                    {m.estado === 'invitado' && (
                                        <button type="button" class="eq-icon" data-eq-act="reenviar" title={t(L, 'set.eq.reenviar_invitacion')} aria-label={t(L, 'set.eq.reenviar_invitacion')}>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
                                        </button>
                                    )}
                                    {m.estado === 'revocado' ? (
                                        <button type="button" class="eq-act-link" data-eq-act="reinvitar">{t(L, 'set.eq.volver_a_invitar')}</button>
                                    ) : (
                                        <>
                                            <button type="button" class="eq-act-link" data-eq-act="editar">{t(L, 'set.eq.editar_funciones')}</button>
                                            <button type="button" class="eq-icon eq-icon-danger" data-eq-act="revocar" title={t(L, 'set.eq.revocar_acceso')} aria-label={t(L, 'set.eq.revocar_acceso')}>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                                            </button>
                                        </>
                                    )}
                                </>
                            )}
                        </span>
                    </div>
                ))}
                <p class="eq-empty" data-eq-empty hidden>{t(L, 'set.eq.vacio_titulo')}</p>
            </div>
            <p class="eq-count" data-eq-count>{tf('set.eq.viendo', { n: String(members.length), total: String(members.length) })}</p>
        </div>
    </div>

    <dialog class="modal eq-drawer" id="eqFicha">
        <form method="dialog" class="m-head">
            <h2>{t(L, 'set.eq.ficha_titulo')}</h2>
            <button class="m-close" aria-label={t(L, 'set.eq.cerrar')}>✕</button>
        </form>
        <div class="m-body">
            <div class="eq-fi-head">
                <span class="eq-avatar eq-avatar-lg" data-fi="inicial" aria-hidden="true"></span>
                <span class="eq-fi-id">
                    <b data-fi="nombre"></b>
                    <small data-fi="email"></small>
                </span>
            </div>

            <section class="eq-fi-sec">
                <h4>{t(L, 'set.eq.ficha_acceso')}</h4>
                <div class="eq-fi-kv"><span>{t(L, 'set.eq.th_rol')}</span><b data-fi="rol"></b></div>
                <p class="eq-fi-note" data-fi="owner-note" hidden>{t(L, 'set.eq.ficha_owner')}</p>
                <p class="eq-fi-note" data-fi="sso-note" hidden>{t(L, 'set.eq.sso_desc')}</p>
                <p class="eq-fi-note" data-fi="noperm-note" hidden>{t(L, 'set.eq.ficha_sin_permisos')}</p>
                <ul class="eq-fi-perms" data-fi="perms"></ul>
            </section>

            <section class="eq-fi-sec">
                <h4>{t(L, 'set.eq.ficha_actividad')}</h4>
                <div class="eq-fi-kv"><span>{t(L, 'set.eq.col_actividad')}</span><b data-fi="sesion"></b></div>
                <div class="eq-fi-kv"><span>{t(L, 'set.eq.desde_label')}</span><b data-fi="desde"></b></div>
                <div class="eq-fi-kv" data-fi="cot-row" hidden><span>{t(L, 'set.eq.col_cotizaciones')}</span><b data-fi="cot30"></b></div>
                <p class="eq-fi-note" data-fi="accion" hidden></p>
            </section>
        </div>
        <div class="m-foot">
            <button type="button" class="eq-btn" data-eq-act="cerrar-modal">{t(L, 'set.eq.cerrar')}</button>
            {canEdit && <button type="button" class="eq-btn eq-btn-primary" id="eqFichaEdit">{t(L, 'set.eq.editar_funciones')}</button>}
        </div>
    </dialog>

    {canEdit && (
    <>
    <dialog class="modal" id="eqInviteModal">
        <form method="dialog" class="m-head">
            <h2>{t(L, 'set.eq.modal_invitar_titulo')}</h2>
            <button class="m-close" aria-label={t(L, 'set.eq.cerrar')}>✕</button>
        </form>
        <div class="m-body">
            <div class="eq-f">
                <label for="eqEmail">{t(L, 'set.eq.correo_electronico')}</label>
                <input id="eqEmail" type="email" placeholder="persona@empresa.com" autocomplete="off" />
                <p class="eq-hint">{t(L, 'set.eq.correo_hint')}</p>
                <p class="eq-err" id="eqInviteErr" hidden></p>
            </div>
            <PermPicker prefix="inv" />
        </div>
        <div class="m-foot">
            <button type="button" class="eq-btn" data-eq-act="cerrar-modal">{t(L, 'set.eq.cancelar')}</button>
            <button type="button" class="eq-btn eq-btn-primary" id="eqInviteSave">{t(L, 'set.eq.enviar_invitacion')}</button>
        </div>
    </dialog>

    <dialog class="modal" id="eqEditModal">
        <form method="dialog" class="m-head">
            <h2 id="eqEditTitle">{t(L, 'set.eq.modal_editar_titulo')}</h2>
            <button class="m-close" aria-label={t(L, 'set.eq.cerrar')}>✕</button>
        </form>
        <div class="m-body">
            <p class="eq-sso-note" id="eqSsoNote" hidden>{t(L, 'set.eq.sso_desc')}</p>
            <PermPicker prefix="edit" />
            <p class="eq-err" id="eqEditErr" hidden></p>
        </div>
        <div class="m-foot">
            <button type="button" class="eq-btn" data-eq-act="cerrar-modal">{t(L, 'set.eq.cancelar')}</button>
            <button type="button" class="eq-btn eq-btn-primary" id="eqEditSave">{t(L, 'set.eq.guardar_cambios')}</button>
        </div>
    </dialog>
    </>
    )}
</SettingsShell>

<style is:global>
/* ⚠️ GLOBAL (Regla 11): las filas se mutan por JS (revocar, filtrar) y los
   modales viven en <dialog> fuera del shell. Un <style> scopeado no alcanzaría a
   ninguno.
   Lo que vive DENTRO del shell va anclado a [data-eq-shell]; lo que vive en los
   diálogos (.eq-btn, .eq-f, .eq-fi-*) no puede llevar ese ancla, y se aísla por
   el prefijo `eq-`, exclusivo de esta página. */

/* Asientos */
[data-eq-shell] .eq-seats { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; padding-bottom: 1.4rem; }
[data-eq-shell] .eq-seats-copy { display: flex; flex-direction: column; gap: 2px; }
[data-eq-shell] .eq-seats-copy strong { font-size: .95rem; color: var(--color-text); }
[data-eq-shell] .eq-seats-copy small { font-size: .74rem; color: var(--color-warn); }
[data-eq-shell] .eq-seats-bar { flex: 1; min-width: 120px; max-width: 220px; height: 4px; border-radius: 999px; background: var(--color-bg-soft); overflow: hidden; }
[data-eq-shell] .eq-seats-bar i { display: block; height: 100%; border-radius: 999px; background: var(--color-blue-deep); transition: width .4s var(--ease-ios); }
[data-eq-shell] .eq-seats-bar i.is-full { background: var(--color-warn); }
[data-eq-shell] .eq-seats-actions { display: flex; gap: .5rem; margin-left: auto; }
[data-eq-shell] .eq-domains { margin: 0 0 1.2rem; font-size: .76rem; color: var(--color-text-muted); }

.eq-btn { font-family: var(--font-sans); font-size: .8rem; font-weight: 600; padding: 9px 17px; border-radius: 999px; border: 1px solid var(--color-border); background: var(--surface); color: var(--color-text); cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; transition: transform .18s var(--ease-ios), background .2s; }
.eq-btn:hover { background: var(--color-bg-soft); }
.eq-btn:active { transform: scale(.96); }
.eq-btn:disabled { opacity: .55; cursor: wait; }
.eq-btn-primary { background: var(--color-blue-deep); color: #fff; border-color: transparent; }
.eq-btn-primary:hover { background: var(--color-blue-deep); filter: brightness(1.12); }

/* Filtros */
[data-eq-shell] .eq-filters { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 1rem; }
[data-eq-shell] .eq-chip { font-family: var(--font-sans); font-size: .78rem; font-weight: 600; padding: 7px 13px; border-radius: 999px; border: none; background: var(--color-bg-soft); color: var(--color-text-muted); cursor: pointer; transition: background .2s, color .2s; }
[data-eq-shell] .eq-chip b { font-weight: 700; opacity: .7; margin-left: 3px; }
[data-eq-shell] .eq-chip:hover { color: var(--color-text); }
[data-eq-shell] .eq-chip.is-active { background: var(--color-blue-deep); color: #fff; }
[data-eq-shell] .eq-chip.is-active b { opacity: .8; }

/* Tabla */
[data-eq-shell] .eq-thead, [data-eq-shell] .eq-row { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.2fr) minmax(0, 1.4fr) auto; align-items: center; gap: 1rem; }
[data-eq-shell] .eq-thead { padding: 0 .7rem .6rem; font-size: .62rem; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: #99a2af; }
[data-eq-shell] .eq-row { padding: .8rem .7rem; border-top: 1px solid var(--color-border); border-radius: 12px; transition: background .2s; }
[data-eq-shell] .eq-row:hover { background: var(--color-bg-soft); }
[data-eq-shell] .eq-row[hidden] { display: none; }
[data-eq-shell] .eq-member { display: flex; align-items: center; gap: .7rem; min-width: 0; }
[data-eq-shell] .eq-avatar { width: 34px; height: 34px; border-radius: 11px; background: var(--color-bg-soft); color: var(--color-text-muted); display: flex; align-items: center; justify-content: center; font-size: .78rem; font-weight: 700; flex-shrink: 0; }
[data-eq-shell] .eq-member-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
[data-eq-shell] .eq-member-text b { font-size: .86rem; font-weight: 600; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
[data-eq-shell] .eq-member-text small { font-size: .74rem; color: var(--color-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
[data-eq-shell] .eq-you { margin-left: 6px; font-style: normal; font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 2px 6px; border-radius: 999px; background: var(--color-bg-soft); color: var(--color-text-muted); }
[data-eq-shell] .eq-rolcell { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; min-width: 0; }
[data-eq-shell] .eq-role { font-size: .74rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: var(--color-bg-soft); color: var(--color-text-muted); white-space: nowrap; }
[data-eq-shell] .eq-role.owner { background: rgba(10,25,47,.08); color: var(--color-blue-deep); }
[data-eq-shell] .eq-sso { font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--color-text-muted); cursor: help; }
[data-eq-shell] .eq-activity { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
[data-eq-shell] .eq-activity b { font-size: .78rem; font-weight: 500; color: var(--color-text); }
[data-eq-shell] .eq-activity small { font-size: .72rem; color: var(--color-text-muted); }
[data-eq-shell] .eq-state { font-size: .74rem; font-weight: 600; }
[data-eq-shell] .eq-state.is-pending { color: var(--color-warn); }
[data-eq-shell] .eq-state.is-expired { color: var(--color-danger); }
[data-eq-shell] .eq-state.is-off { color: var(--color-text-muted); }
[data-eq-shell] .eq-rowactions { display: flex; align-items: center; gap: .4rem; justify-content: flex-end; }
[data-eq-shell] .eq-act-link { all: unset; cursor: pointer; font-size: .78rem; font-weight: 600; color: var(--color-blue-deep); padding: 5px 8px; border-radius: 8px; }
[data-eq-shell] .eq-act-link:hover { background: rgba(10,25,47,.06); }
[data-eq-shell] .eq-icon { all: unset; cursor: pointer; width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); transition: background .2s, color .2s; }
[data-eq-shell] .eq-icon svg { width: 16px; height: 16px; }
[data-eq-shell] .eq-icon:hover { background: var(--color-bg-soft); color: var(--color-text); }
[data-eq-shell] .eq-icon-danger:hover { background: rgba(239,68,68,.1); color: var(--color-danger); }
[data-eq-shell] .eq-empty { padding: 2.5rem 0; margin: 0; text-align: center; font-size: .85rem; color: var(--color-text-muted); }
[data-eq-shell] .eq-empty[hidden] { display: none; }
[data-eq-shell] .eq-count { margin: 1rem 0 0; font-size: .74rem; color: var(--color-text-muted); }

@media (max-width: 760px) {
    [data-eq-shell] .eq-thead { display: none; }
    [data-eq-shell] .eq-row { grid-template-columns: 1fr auto; grid-template-areas: "m a" "r r" "act act"; gap: .5rem 1rem; }
    [data-eq-shell] .eq-member { grid-area: m; }
    [data-eq-shell] .eq-rowactions { grid-area: a; }
    [data-eq-shell] .eq-rolcell { grid-area: r; flex-direction: row; align-items: center; gap: .5rem; }
    [data-eq-shell] .eq-activity { grid-area: act; }
}

/* Campos de los modales */
.eq-f { display: flex; flex-direction: column; gap: .4rem; }
.eq-f > label { font-size: .62rem; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: #99a2af; }
.eq-f input { font-family: var(--font-sans); font-size: .86rem; color: var(--color-text); background: var(--color-bg-soft); border: 1px solid transparent; border-radius: 10px; padding: 10px 12px; }
.eq-f input:focus { outline: none; background: var(--surface); border-color: rgba(10,25,47,.15); }
.eq-hint { margin: 0; font-size: .7rem; line-height: 1.5; color: var(--color-text-muted); }
.eq-err { margin: 0; font-size: .78rem; color: var(--color-danger); }
.eq-err[hidden] { display: none; }
.eq-sso-note { margin: 0 0 .4rem; padding: .7rem .9rem; border-radius: 10px; background: var(--color-bg-soft); font-size: .78rem; line-height: 1.5; color: var(--color-text-muted); }
.eq-sso-note[hidden] { display: none; }
#eqInviteModal .m-body, #eqEditModal .m-body { display: flex; flex-direction: column; gap: 1.4rem; }

/* Ficha del miembro */
[data-eq-shell] .eq-row { position: relative; }
[data-eq-shell] .eq-rowlink { all: unset; position: absolute; inset: 0; cursor: pointer; border-radius: 12px; }
[data-eq-shell] .eq-rowlink:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: -2px; }
/* Las acciones van POR ENCIMA del link estirado, si no serían inalcanzables. */
[data-eq-shell] .eq-rowactions { position: relative; z-index: 1; }
.eq-drawer .m-body { display: flex; flex-direction: column; gap: 1.6rem; }
.eq-fi-head { display: flex; align-items: center; gap: .9rem; }
.eq-avatar-lg { width: 46px !important; height: 46px !important; border-radius: 15px !important; font-size: 1rem !important; }
.eq-fi-id { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.eq-fi-id b { font-size: 1rem; font-weight: 600; color: var(--color-text); }
.eq-fi-id small { font-size: .8rem; color: var(--color-text-muted); }
.eq-fi-sec h4 { margin: 0 0 .5rem; font-size: .6rem; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: #99a2af; }
.eq-fi-kv { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem 0; border-top: 1px solid var(--color-border); font-size: .82rem; }
.eq-fi-sec h4 + .eq-fi-kv { border-top: 0; }
.eq-fi-kv span { color: var(--color-text-muted); }
.eq-fi-kv b { font-weight: 600; color: var(--color-text); }
.eq-fi-kv[hidden] { display: none; }
.eq-fi-note { margin: .6rem 0 0; font-size: .76rem; line-height: 1.5; color: var(--color-text-muted); }
.eq-fi-note[hidden] { display: none; }
.eq-fi-perms { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; margin: .7rem 0 0; padding: 0; }
.eq-fi-perms li { font-size: .74rem; font-weight: 500; padding: 5px 11px; border-radius: 999px; background: var(--color-bg-soft); color: var(--color-text); }
</style>

<script>
    import { PRESETS, ALL_PERM_KEYS, type PermKey, type PermMap } from '../../../lib/permissions';

    const shellEl = document.querySelector<HTMLElement>('[data-eq-shell]');
    if (shellEl) {
        // Alias no-nulo: TypeScript no estrecha `shell` dentro de los callbacks.
        const shell = shellEl;
        const T = JSON.parse(shell.dataset.t || '{}');
        const PRESET_PERMS: Record<string, PermMap> = JSON.parse(T.presets || '{}');
        const PRESET_DESCS: Record<string, string> = JSON.parse(T.presetDescs || '{}');
        const DOMINIOS: string[] = JSON.parse(T.dominios || '[]');
        const toast = (m: string, k: 'ok' | 'error' | 'info' = 'ok') => (window as any).cordToast?.(m, k);
        const confirmar = async (o: any) => {
            const fn = (window as any).cordConfirm;
            return fn ? await fn(o) : confirm(typeof o === 'string' ? o : o.title);
        };
        const tpl = (s: string, v: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? '');

        async function req(url: string, body: any, method = 'POST') {
            const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const d = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(d.error || T.error);
            return d;
        }

        // ── Picker de permisos (compartido por los dos modales) ──
        const picker = (prefix: string) => document.querySelector<HTMLElement>(`[data-perm-picker="${prefix}"]`);
        const checks = (prefix: string) =>
            Array.from(picker(prefix)?.querySelectorAll<HTMLInputElement>('[data-perm]') ?? []);
        const readPerms = (prefix: string): PermMap => {
            const out: PermMap = {};
            for (const c of checks(prefix)) out[c.dataset.perm as PermKey] = c.checked;
            return out;
        };
        const writePerms = (prefix: string, p: PermMap) => {
            for (const c of checks(prefix)) c.checked = !!p?.[c.dataset.perm as PermKey];
        };
        /** ¿La matriz actual coincide exactamente con algún preset? */
        const matchPreset = (p: PermMap): string | null => {
            for (const [key, perms] of Object.entries(PRESET_PERMS)) {
                if (ALL_PERM_KEYS.every((k) => !!perms[k] === !!p[k])) return key;
            }
            return null;
        };
        function refreshPicker(prefix: string) {
            const root = picker(prefix); if (!root) return;
            const key = matchPreset(readPerms(prefix));
            root.querySelectorAll<HTMLElement>('.pp-preset').forEach((b) => {
                b.classList.toggle('is-active', b.dataset.preset === (key ?? '__custom'));
                if (b.dataset.preset === '__custom') b.hidden = !!key;
            });
            const desc = root.querySelector<HTMLElement>('[data-perm-desc]');
            if (desc) desc.textContent = PRESET_DESCS[key ?? '__custom'] ?? '';
        }
        function applyPreset(prefix: string, key: string) {
            writePerms(prefix, PRESET_PERMS[key] ?? {});
            refreshPicker(prefix);
        }
        document.querySelectorAll<HTMLElement>('[data-perm-picker]').forEach((root) => {
            const prefix = root.dataset.permPicker!;
            root.addEventListener('click', (e) => {
                const b = (e.target as HTMLElement).closest<HTMLElement>('.pp-preset');
                if (b && b.dataset.preset && b.dataset.preset !== '__custom') applyPreset(prefix, b.dataset.preset);
            });
            root.addEventListener('change', (e) => {
                if ((e.target as HTMLElement).matches('[data-perm]')) refreshPicker(prefix);
            });
        });

        // ── Filtros ──
        const rows = () => Array.from(shell.querySelectorAll<HTMLElement>('[data-eq-row]'));
        function applyFilter(f: string) {
            let visibles = 0;
            for (const r of rows()) {
                const ok = f === 'todos' || r.dataset.estado === f;
                r.hidden = !ok;
                if (ok) visibles++;
            }
            const empty = shell.querySelector<HTMLElement>('[data-eq-empty]');
            if (empty) empty.hidden = visibles > 0;
            const count = shell.querySelector<HTMLElement>('[data-eq-count]');
            if (count) count.textContent = tpl(T.viendo, { n: String(visibles), total: String(rows().length) });
        }
        shell.querySelector('[data-eq-filters]')?.addEventListener('click', (e) => {
            const b = (e.target as HTMLElement).closest<HTMLElement>('[data-eq-filter]');
            if (!b) return;
            shell.querySelectorAll('.eq-chip').forEach((c) => c.classList.toggle('is-active', c === b));
            applyFilter(b.dataset.eqFilter!);
        });

        /** Recalcula los contadores de los chips tras una mutación. */
        function syncCounts() {
            const all = rows();
            const n = (estado: string) => all.filter((r) => r.dataset.estado === estado).length;
            const set = (f: string, v: number) => {
                const b = shell.querySelector<HTMLElement>(`[data-eq-filter="${f}"] b`);
                if (b) b.textContent = String(v);
            };
            set('todos', all.length); set('activo', n('activo'));
            set('invitado', n('invitado')); set('revocado', n('revocado'));
        }

        // ── Modales ──
        const inviteModal = document.getElementById('eqInviteModal') as HTMLDialogElement | null;
        const editModal = document.getElementById('eqEditModal') as HTMLDialogElement | null;
        const emailInput = document.getElementById('eqEmail') as HTMLInputElement | null;
        const inviteErr = document.getElementById('eqInviteErr') as HTMLElement | null;
        const editErr = document.getElementById('eqEditErr') as HTMLElement | null;
        let editingId: string | null = null;

        function openInvite(email = '') {
            if (!inviteModal) return;
            if (emailInput) emailInput.value = email;
            if (inviteErr) inviteErr.hidden = true;
            applyPreset('inv', 'vendedor');
            (window as any).cordWireModal?.(inviteModal);
            inviteModal.showModal();
            emailInput?.focus();
        }
        document.getElementById('eqInvite')?.addEventListener('click', () => openInvite());

        // ── Exportar (el botón llevaba desde siempre sin listener) ──
        document.getElementById('eqExport')?.addEventListener('click', () => {
            toast(T.exportando, 'info');
            window.location.href = '/api/equipo/export';
        });

        // ── Delegación de acciones de fila ──
        shell.addEventListener('click', async (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-eq-act]');
            if (!btn) return;
            const row = btn.closest<HTMLElement>('[data-eq-row]')!;
            const id = row.dataset.id!;
            try {
                btn.disabled = true;
                if (btn.dataset.eqAct === 'ficha') {
                    abrirFicha(row);
                } else if (btn.dataset.eqAct === 'editar') {
                    editingId = id;
                    writePerms('edit', JSON.parse(row.dataset.permisos || '{}'));
                    refreshPicker('edit');
                    const note = document.getElementById('eqSsoNote');
                    if (note) note.hidden = !row.dataset.sso;
                    if (editErr) editErr.hidden = true;
                    const title = document.getElementById('eqEditTitle');
                    if (title) title.textContent = row.dataset.nombre || '';
                    if (editModal) { (window as any).cordWireModal?.(editModal); editModal.showModal(); }
                } else if (btn.dataset.eqAct === 'reenviar') {
                    const d = await req('/api/equipo/resend', { id });
                    if (d.link) await navigator.clipboard?.writeText(d.link).catch(() => {});
                    toast(T.reenviado, 'ok');
                } else if (btn.dataset.eqAct === 'reinvitar') {
                    openInvite(row.dataset.email || '');
                } else if (btn.dataset.eqAct === 'revocar') {
                    const ok = await confirmar({
                        title: T.revocado, body: row.dataset.nombre, danger: true,
                    });
                    if (!ok) return;
                    await req('/api/equipo', { id }, 'DELETE');
                    // Actualización optimista: antes cada mutación hacía location.reload().
                    row.dataset.estado = 'revocado';
                    row.querySelector('.eq-activity')!.innerHTML = '';
                    const st = document.createElement('span');
                    st.className = 'eq-state is-off';
                    st.textContent = shell.querySelector<HTMLElement>('[data-eq-filter="revocado"]')?.firstChild?.textContent?.trim() || '—';
                    row.querySelector('.eq-activity')!.appendChild(st);
                    row.querySelector('.eq-rowactions')!.innerHTML = '';
                    syncCounts();
                    const active = shell.querySelector<HTMLElement>('.eq-chip.is-active');
                    applyFilter(active?.dataset.eqFilter || 'todos');
                    toast(T.revocado, 'ok');
                }
            } catch (err: any) {
                toast(err.message || T.error, 'error');
            } finally { btn.disabled = false; }
        });

        // ── Ficha del miembro ──
        const ficha = document.getElementById('eqFicha') as HTMLDialogElement | null;
        const PERM_LABELS: Record<string, string> = JSON.parse(T.permLabels || '{}');
        let fichaRow: HTMLElement | null = null;

        function abrirFicha(row: HTMLElement) {
            if (!ficha) return;
            fichaRow = row;
            const set = (k: string, v: string) => {
                const el = ficha!.querySelector<HTMLElement>(`[data-fi="${k}"]`);
                if (el) el.textContent = v;
            };
            const show = (k: string, on: boolean) => {
                const el = ficha!.querySelector<HTMLElement>(`[data-fi="${k}"]`);
                if (el) el.hidden = !on;
            };
            const d = row.dataset;
            set('inicial', d.inicial || '?');
            set('nombre', d.nombre || '');
            set('email', d.email || '—');
            set('rol', d.rolLabel || '');
            set('desde', d.desde || '—');
            set('sesion', d.sesion ? tpl(T.actSesion, { fecha: d.sesion }) : T.actNunca);
            set('cot30', tpl(T.actCotizaciones, { n: d.cot30 || '0' }));
            show('cot-row', Number(d.cot30 || 0) > 0);
            show('owner-note', d.rol === 'owner');
            show('sso-note', !!d.sso);

            // Permisos EFECTIVOS: el owner siempre los tiene todos (override de
            // memberCan), aunque su matriz en BD esté vacía.
            const perms = JSON.parse(d.permisos || '{}');
            const activos = d.rol === 'owner'
                ? Object.keys(PERM_LABELS)
                : Object.keys(PERM_LABELS).filter((k) => perms[k]);
            const ul = ficha!.querySelector<HTMLElement>('[data-fi="perms"]')!;
            ul.innerHTML = '';
            for (const k of activos) {
                const li = document.createElement('li');
                li.textContent = PERM_LABELS[k];
                ul.appendChild(li);
            }
            show('noperm-note', activos.length === 0);

            const accion = ficha!.querySelector<HTMLElement>('[data-fi="accion"]');
            if (accion) {
                accion.hidden = !d.accion;
                if (d.accion) accion.textContent = tpl(T.ultimaAccion, { accion: d.accion });
            }
            // Editar solo tiene sentido si la fila lo permite (no yo, no owner).
            const editBtn = document.getElementById('eqFichaEdit');
            if (editBtn) editBtn.hidden = !!d.esyo || d.rol === 'owner' || d.estado === 'revocado';

            (window as any).cordWireModal?.(ficha);
            ficha.showModal();
        }

        document.getElementById('eqFichaEdit')?.addEventListener('click', () => {
            const row = fichaRow;
            ficha?.close();
            if (row) row.querySelector<HTMLButtonElement>('[data-eq-act="editar"]')?.click();
        });

        // Cerrar modales
        document.querySelectorAll('[data-eq-act="cerrar-modal"]').forEach((b) =>
            b.addEventListener('click', () => (b.closest('dialog') as HTMLDialogElement | null)?.close()));

        // ── Guardar invitación ──
        document.getElementById('eqInviteSave')?.addEventListener('click', async (e) => {
            const b = e.currentTarget as HTMLButtonElement;
            const email = (emailInput?.value || '').trim().toLowerCase();
            if (inviteErr) inviteErr.hidden = true;
            // Validación de dominio ANTES de enviar: antes solo te enterabas con
            // un 422 del servidor, sin saber siquiera que existía la restricción.
            if (email && DOMINIOS.length) {
                const dom = email.split('@')[1] ?? '';
                if (!DOMINIOS.includes(dom)) {
                    if (inviteErr) { inviteErr.textContent = T.dominio_invalido; inviteErr.hidden = false; }
                    return;
                }
            }
            b.disabled = true;
            try {
                const perms = readPerms('inv');
                const key = matchPreset(perms);
                const d = await req('/api/equipo', key ? { email, preset: key } : { email, preset: 'miembro', permisos: perms });
                if (d.link) await navigator.clipboard?.writeText(d.link).catch(() => {});
                toast(d.emailed ? T.invitado : T.invitado_link, 'ok');
                inviteModal?.close();
                setTimeout(() => location.reload(), 800);
            } catch (err: any) {
                if (inviteErr) { inviteErr.textContent = err.message || T.error; inviteErr.hidden = false; }
            } finally { b.disabled = false; }
        });

        // ── Guardar permisos ──
        document.getElementById('eqEditSave')?.addEventListener('click', async (e) => {
            const b = e.currentTarget as HTMLButtonElement;
            if (!editingId) return;
            b.disabled = true;
            if (editErr) editErr.hidden = true;
            try {
                const perms = readPerms('edit');
                const key = matchPreset(perms);
                await req('/api/equipo', key ? { id: editingId, rol: key } : { id: editingId, permisos: perms }, 'PATCH');
                // Optimista: la fila refleja el rol nuevo sin recargar.
                const row = shell.querySelector<HTMLElement>(`[data-eq-row][data-id="${editingId}"]`);
                if (row) {
                    row.dataset.permisos = JSON.stringify(perms);
                    row.dataset.rol = key ?? 'miembro';
                    const chip = row.querySelector<HTMLElement>('.eq-role');
                    const label = document.querySelector<HTMLElement>(`[data-perm-picker="edit"] .pp-preset.is-active`);
                    if (chip) chip.textContent = key ? (label?.textContent?.trim() || key) : T.custom_label;
                    if (chip) chip.className = `eq-role ${key ?? 'miembro'}`;
                }
                toast(T.actualizado, 'ok');
                editModal?.close();
            } catch (err: any) {
                if (editErr) { editErr.textContent = err.message || T.error; editErr.hidden = false; }
            } finally { b.disabled = false; }
        });

        // Estado inicial de los pickers
        refreshPicker('inv'); refreshPicker('edit');
        // `PRESETS` se importa solo para que el bundler conserve el módulo compartido
        // con el servidor y los presets no puedan divergir entre ambos lados.
        void PRESETS;
    }
</script>
