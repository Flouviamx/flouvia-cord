---
// Ajustes › Developers › Webhooks.
// Endpoints salientes REALES (tabla webhooks, entrega firmada HMAC-sha256) con
// LOG DE ENTREGAS + replay + envío de prueba. Separado de la API (jun 2026).
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg, getWebhooks } from '../../../lib/queries';
import { webhookLimit, planLabel } from '../../../lib/permissions';
import { WEBHOOK_EVENTS } from '../../../lib/webhooks';
import '../../../styles/developers.css';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
const ORG = await getOrg();
const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};
const WEBHOOKS = await getWebhooks();
const LIMITE = webhookLimit(ORG.plan_raw);
const USADOS = WEBHOOKS.length;
const AT_LIMIT = USADOS >= LIMITE;
---

<SettingsShell title="Webhooks — Ajustes" tab="webhooks" perm="ajustes"
    intro={t(L, 'set.wh.intro')}>
<div class="dev-wrapper">

    <div class="dev-card">
        <div class="dev-card-header">
            <div>
                <h3 class="dev-card-title">{t(L, 'set.wh.endpoints_titulo')}</h3>
                <p class="dev-card-sub" set:html={t(L, 'set.wh.endpoints_sub')} />
            </div>
            <div class="dev-head-actions">
                <span class="dev-limit">{tf('set.wh.plan', { plan: planLabel(ORG.plan_raw) })} <b>{USADOS}/{LIMITE}</b></span>
                <button class="api-btn-solid" id="whNew" disabled={AT_LIMIT} title={AT_LIMIT ? tf('set.wh.limite_hint', { n: String(LIMITE) }) : ''}>{t(L, 'set.wh.agregar_endpoint')}</button>
            </div>
        </div>
        {AT_LIMIT && (
            <p class="dev-limit-note">{tf('set.wh.limite_nota_pre', { n: String(LIMITE), s: LIMITE === 1 ? '' : 's' })} <a href="/app/ajustes/plan">{t(L, 'set.wh.subir_plan')}</a> {t(L, 'set.wh.limite_nota_post')}</p>
        )}

        <div class="wh-list" id="whList">
            {WEBHOOKS.length === 0 && (
                <p class="dev-empty" id="whEmpty">{t(L, 'set.wh.vacio')}</p>
            )}
            {WEBHOOKS.map((w) => (
                <div class:list={['wh-item', { off: !w.activo, disabled: !!w.deshabilitadoMotivo }]} data-id={w.id}>
                    {w.deshabilitadoMotivo && (
                        <div class="wh-health-banner">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                            <span class="wh-health-msg">{t(L, 'set.wh.deshabilitado_pre')} {w.deshabilitadoMotivo}{w.deshabilitadoEn ? ` — ${w.deshabilitadoEn}` : ''}</span>
                            <span class="wh-health-actions">
                                <button data-reenable={w.id}>{t(L, 'set.wh.reactivar')}</button>
                                <button data-reenable-retry={w.id}>{t(L, 'set.wh.reactivar_reintentar')}</button>
                            </span>
                        </div>
                    )}
                    <div class="wh-row">
                        <button class="wh-expand" data-expand={w.id} title={t(L, 'set.wh.ver_entregas')} aria-expanded="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                        <span class="wh-info">
                            <span class="wh-url">{w.url}</span>
                            <span class="wh-sub">
                                <code>{w.secretMasked}</code>
                                <button type="button" class="wh-rotate-link" data-rotate={w.id}>{t(L, 'set.wh.rotar')}</button>
                                {w.rotandoHasta && <i class="wh-rotating-note">{t(L, 'set.wh.rotando_hasta_pre')} {w.rotandoHasta}</i>}
                                {w.eventos.length === 0 ? <i>{t(L, 'set.wh.todos_eventos')}</i> : <i>{w.eventos.length > 1 ? tf('set.wh.eventos_plural', { n: String(w.eventos.length) }) : t(L, 'set.wh.evento_singular')}</i>}
                                {w.ultimaEntrega && (
                                    <i class:list={['wh-stat', { ok: w.lastStatus && w.lastStatus < 400, err: !w.lastStatus || w.lastStatus >= 400 }]}
                                        title={w.lastError ? `${t(L, 'set.wh.ultimo_error_pre')} ${w.lastError}` : ''}>
                                        {t(L, 'set.wh.ultima_pre')} {w.ultimaEntrega} {w.lastStatus ? `(${w.lastStatus})` : (w.lastError || t(L, 'set.wh.fallo'))}
                                    </i>
                                )}
                            </span>
                        </span>
                        <button class="api-btn-ghost wh-test" data-test={w.id} title={t(L, 'set.wh.probar_titulo')}>{t(L, 'set.wh.probar')}</button>
                        <button class="api-btn-ghost wh-edit" data-edit={w.id} data-url={w.url} data-eventos={JSON.stringify(w.eventos)}>{t(L, 'set.wh.editar')}</button>
                        <label class="s-toggle wh-toggle" title={t(L, 'set.wh.activar_pausar')}>
                            <input type="checkbox" data-toggle={w.id} checked={w.activo} />
                            <span class="s-toggle-track"><span class="s-toggle-thumb"></span></span>
                        </label>
                        <button class="api-btn-ghost" data-del={w.id}>{t(L, 'set.wh.eliminar')}</button>
                    </div>
                    <div class="wh-deliveries" data-deliveries={w.id} hidden>
                        <div class="wh-del-body" data-delbody={w.id}
                            data-i18n-cargando={t(L, 'set.wh.cargando_entregas')} data-i18n-sin-entregas={t(L, 'set.wh.sin_entregas')}
                            data-i18n-no-cargo={t(L, 'set.wh.no_pudo_cargar_log')} data-i18n-reintentar={t(L, 'set.wh.reintentar')}
                            data-i18n-intento={t(L, 'set.wh.intento')} data-i18n-prueba-tag={t(L, 'set.wh.prueba_tag')} data-i18n-fallo={t(L, 'set.wh.fallo')}>
                            <span class="wh-del-loading">{t(L, 'set.wh.cargando_entregas')}</span>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</div>
</SettingsShell>

<!-- Modal: agregar/editar webhook -->
<dialog id="whDialog" class="kdlg"
    data-i18n-no-pudo-crear={t(L, 'set.wh.no_pudo_crear')} data-i18n-no-pudo-actualizar={t(L, 'set.wh.no_pudo_actualizar')}
    data-i18n-eliminar-titulo={t(L, 'set.wh.eliminar_titulo')} data-i18n-eliminar-body={t(L, 'set.wh.eliminar_body')}
    data-i18n-eliminar={t(L, 'set.wh.eliminar')} data-i18n-no-pudo-eliminar={t(L, 'set.wh.no_pudo_eliminar')}
    data-i18n-enviado={t(L, 'set.wh.enviado')} data-i18n-error={t(L, 'set.wh.error_generico')}
    data-i18n-titulo-agregar={t(L, 'set.wh.modal_agregar_titulo')} data-i18n-titulo-editar={t(L, 'set.wh.modal_editar_titulo')}
    data-i18n-crear-endpoint={t(L, 'set.wh.crear_endpoint')} data-i18n-guardar-cambios={t(L, 'set.wh.guardar_cambios')}
    data-i18n-reactivando={t(L, 'set.wh.reactivando')} data-i18n-no-pudo-reactivar={t(L, 'set.wh.no_pudo_reactivar')}
    data-i18n-rotando={t(L, 'set.wh.rotando')} data-i18n-no-pudo-rotar={t(L, 'set.wh.no_pudo_rotar')}
    data-i18n-titulo-creado={t(L, 'set.wh.modal_creado_titulo')} data-i18n-warn-creado={t(L, 'set.wh.modal_creado_warn')}
    data-i18n-titulo-rotado={t(L, 'set.wh.modal_rotado_titulo')} data-i18n-warn-rotado={t(L, 'set.wh.modal_rotado_warn')}>
    <div class="kdlg-inner" id="whStepForm">
        <h4 id="whFormTitle">{t(L, 'set.wh.modal_agregar_titulo')}</h4>
        <div class="s-field" style="margin-bottom:1.1rem">
            <label for="whUrl">{t(L, 'set.wh.url_destino')}</label>
            <input class="s-input" id="whUrl" placeholder="https://tusistema.mx/webhooks/cord" />
        </div>
        <div class="wh-events">
            <span class="wh-events-label">{t(L, 'set.wh.eventos_label')}</span>
            <div class="wh-checks">
                {WEBHOOK_EVENTS.map((e) => (
                    <label class="wh-check">
                        <input type="checkbox" value={e.id} />
                        <span><code>{e.id}</code> {e.label}</span>
                    </label>
                ))}
            </div>
        </div>
        <div class="wh-dlg-actions">
            <button type="button" class="api-btn-ghost" id="whCancel">{t(L, 'set.wh.cancelar')}</button>
            <button type="button" class="api-btn-solid" id="whCreate">{t(L, 'set.wh.crear_endpoint')}</button>
        </div>
    </div>
    <div class="kdlg-inner" id="whStepRotate" hidden>
        <h4>{t(L, 'set.wh.rotar_titulo')}</h4>
        <p class="kdlg-warn">{t(L, 'set.wh.rotar_intro')}</p>
        <div class="wh-events">
            <span class="wh-events-label">{t(L, 'set.wh.rotar_ventana')}</span>
            <div class="wh-checks">
                <label class="wh-check"><input type="radio" name="whRotateWindow" value="1" /> <span>{t(L, 'set.wh.rotar_1h')}</span></label>
                <label class="wh-check"><input type="radio" name="whRotateWindow" value="24" checked /> <span>{t(L, 'set.wh.rotar_24h')}</span></label>
                <label class="wh-check"><input type="radio" name="whRotateWindow" value="72" /> <span>{t(L, 'set.wh.rotar_72h')}</span></label>
            </div>
        </div>
        <div class="wh-dlg-actions">
            <button type="button" class="api-btn-ghost" id="whRotateCancel">{t(L, 'set.wh.cancelar')}</button>
            <button type="button" class="api-btn-solid" id="whRotateConfirm">{t(L, 'set.wh.rotar_confirmar')}</button>
        </div>
    </div>
    <div class="kdlg-inner" id="whStepDone" hidden>
        <h4 id="whDoneTitle">{t(L, 'set.wh.modal_creado_titulo')}</h4>
        <p class="kdlg-warn" id="whDoneWarn" set:html={t(L, 'set.wh.modal_creado_warn')} />
        <div class="kdlg-key">
            <code id="whSecret"></code>
            <button id="whCopy" class="kdlg-copy" type="button" data-i18n-copiar={t(L, 'set.wh.copiar')} data-i18n-copiado={t(L, 'set.wh.copiado')}>{t(L, 'set.wh.copiar')}</button>
        </div>
        <button class="kdlg-done" type="button" id="whDone">{t(L, 'set.wh.listo')}</button>
    </div>
</dialog>

<script>
    // ── Webhooks: crear/editar, toggle, eliminar, PROBAR, reactivar, expandir log + replay ──
    function initWebhooks() {
        const dlg = document.getElementById('whDialog') as HTMLDialogElement | null;
        const newBtn = document.getElementById('whNew') as HTMLButtonElement | null;
        if (!dlg || !newBtn) return;
        const urlIn = document.getElementById('whUrl') as HTMLInputElement;
        const stepForm = document.getElementById('whStepForm')!;
        const stepRotate = document.getElementById('whStepRotate')!;
        const stepDone = document.getElementById('whStepDone')!;
        const secretEl = document.getElementById('whSecret')!;
        const doneTitle = document.getElementById('whDoneTitle')!;
        const doneWarn = document.getElementById('whDoneWarn')!;
        const createBtn = document.getElementById('whCreate') as HTMLButtonElement;
        const formTitle = document.getElementById('whFormTitle')!;

        const i18nTituloAgregar = dlg.dataset.i18nTituloAgregar || 'Agregar endpoint';
        const i18nTituloEditar = dlg.dataset.i18nTituloEditar || 'Editar endpoint';
        const i18nCrearEndpoint = dlg.dataset.i18nCrearEndpoint || 'Crear endpoint';
        const i18nGuardarCambios = dlg.dataset.i18nGuardarCambios || 'Guardar cambios';

        // null = creando uno nuevo; con valor = editando ESE endpoint (el mismo
        // dialog/formulario sirve para ambos, solo cambia el modo de envío).
        let editingId: string | null = null;

        function openDialogFor(id: string | null, url = '', eventos: string[] = []) {
            editingId = id;
            stepForm.hidden = false; stepRotate.hidden = true; stepDone.hidden = true;
            urlIn.value = url;
            dlg.querySelectorAll<HTMLInputElement>('.wh-check input').forEach((c) => (c.checked = eventos.includes(c.value)));
            createBtn.disabled = false;
            formTitle.textContent = id ? i18nTituloEditar : i18nTituloAgregar;
            createBtn.textContent = id ? i18nGuardarCambios : i18nCrearEndpoint;
            dlg.showModal(); urlIn.focus();
        }

        newBtn.addEventListener('click', () => openDialogFor(null));
        document.querySelectorAll('[data-edit]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const el = btn as HTMLElement;
                let eventos: string[] = [];
                try { eventos = JSON.parse(el.dataset.eventos || '[]'); } catch {}
                openDialogFor(el.dataset.edit!, el.dataset.url || '', eventos);
            });
        });
        document.getElementById('whCancel')?.addEventListener('click', () => dlg.close());
        document.getElementById('whDone')?.addEventListener('click', () => { dlg.close(); location.reload(); });
        const i18nCopiar = document.getElementById('whCopy')?.dataset.i18nCopiar || 'Copiar';
        const i18nCopiado = document.getElementById('whCopy')?.dataset.i18nCopiado || '✓ Copiado';
        document.getElementById('whCopy')?.addEventListener('click', async () => {
            try { await navigator.clipboard.writeText(secretEl.textContent || ''); const b = document.getElementById('whCopy')!; b.textContent = i18nCopiado; setTimeout(() => (b.textContent = i18nCopiar), 1800); } catch {}
        });

        const i18nNoPudoCrear = dlg.dataset.i18nNoPudoCrear || 'No se pudo crear';
        const i18nNoPudoActualizar = dlg.dataset.i18nNoPudoActualizar || 'No se pudo actualizar';
        const i18nTituloCreado = dlg.dataset.i18nTituloCreado || 'Endpoint creado';
        const i18nWarnCreado = dlg.dataset.i18nWarnCreado || '';
        createBtn.addEventListener('click', async () => {
            const url = urlIn.value.trim();
            if (!url) { urlIn.focus(); return; }
            const eventos = Array.from(dlg.querySelectorAll<HTMLInputElement>('.wh-check input:checked')).map((c) => c.value);
            createBtn.disabled = true;
            if (editingId) {
                // Editar: la API ya soportaba PATCH {url, eventos} — solo faltaba
                // que la UI lo mandara (antes solo mandaba {id, activo}).
                try {
                    const res = await fetch('/api/webhooks', {
                        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: editingId, url, eventos }),
                    });
                    if (!res.ok) { const d = await res.json(); throw new Error(d.error || i18nNoPudoActualizar); }
                    dlg.close(); location.reload();
                } catch (err: any) { (window as any).cordToast?.(err.message || i18nNoPudoActualizar, 'error'); createBtn.disabled = false; }
                return;
            }
            try {
                const res = await fetch('/api/webhooks', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url, eventos }),
                });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || i18nNoPudoCrear);
                secretEl.textContent = d.secret;
                doneTitle.textContent = i18nTituloCreado;
                doneWarn.innerHTML = i18nWarnCreado;
                stepForm.hidden = true; stepRotate.hidden = true; stepDone.hidden = false;
            } catch (err: any) { (window as any).cordToast?.(err.message || i18nNoPudoCrear, 'error'); createBtn.disabled = false; }
        });

        // Rotar secreto (link junto al secreto enmascarado en cada fila)
        const i18nRotando = dlg.dataset.i18nRotando || 'Rotando…';
        const i18nNoPudoRotar = dlg.dataset.i18nNoPudoRotar || 'No se pudo rotar el secreto';
        const i18nTituloRotado = dlg.dataset.i18nTituloRotado || 'Secreto rotado';
        const i18nWarnRotado = dlg.dataset.i18nWarnRotado || '';
        const rotateConfirmBtn = document.getElementById('whRotateConfirm') as HTMLButtonElement | null;
        let rotatingId: string | null = null;

        document.querySelectorAll('[data-rotate]').forEach((btn) => {
            btn.addEventListener('click', () => {
                rotatingId = (btn as HTMLElement).dataset.rotate!;
                stepForm.hidden = true; stepDone.hidden = true; stepRotate.hidden = false;
                dlg.showModal();
            });
        });
        document.getElementById('whRotateCancel')?.addEventListener('click', () => dlg.close());
        rotateConfirmBtn?.addEventListener('click', async () => {
            if (!rotatingId) return;
            const overlapHours = Number((dlg.querySelector('input[name="whRotateWindow"]:checked') as HTMLInputElement)?.value || '24');
            rotateConfirmBtn.disabled = true;
            const orig = rotateConfirmBtn.textContent;
            rotateConfirmBtn.textContent = i18nRotando;
            try {
                const res = await fetch('/api/webhooks', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'rotate', id: rotatingId, overlapHours }),
                });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || i18nNoPudoRotar);
                secretEl.textContent = d.secret;
                doneTitle.textContent = i18nTituloRotado;
                doneWarn.innerHTML = i18nWarnRotado;
                stepRotate.hidden = true; stepDone.hidden = false;
            } catch (err: any) {
                (window as any).cordToast?.(err.message || i18nNoPudoRotar, 'error');
                rotateConfirmBtn.disabled = false; rotateConfirmBtn.textContent = orig;
            }
        });

        // Reactivar / Reactivar y reintentar (banner de endpoint auto-desactivado)
        const i18nReactivando = dlg.dataset.i18nReactivando || 'Reactivando…';
        const i18nNoPudoReactivar = dlg.dataset.i18nNoPudoReactivar || 'No se pudo reactivar';
        async function doReenable(btn: HTMLButtonElement, id: string, retryRecent: boolean) {
            btn.disabled = true;
            const sibling = btn.parentElement?.querySelectorAll('button');
            sibling?.forEach((b) => (b.disabled = true));
            const orig = btn.textContent;
            btn.textContent = i18nReactivando;
            try {
                const res = await fetch('/api/webhooks', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, activo: true, retryRecent }) });
                if (!res.ok) throw new Error();
                location.reload();
            } catch {
                (window as any).cordToast?.(i18nNoPudoReactivar, 'error');
                sibling?.forEach((b) => (b.disabled = false));
                btn.textContent = orig;
            }
        }
        document.querySelectorAll('[data-reenable]').forEach((btn) => {
            btn.addEventListener('click', () => doReenable(btn as HTMLButtonElement, (btn as HTMLElement).dataset.reenable!, false));
        });
        document.querySelectorAll('[data-reenable-retry]').forEach((btn) => {
            btn.addEventListener('click', () => doReenable(btn as HTMLButtonElement, (btn as HTMLElement).dataset.reenableRetry!, true));
        });

        document.querySelectorAll('[data-toggle]').forEach((el) => {
            el.addEventListener('change', async () => {
                const id = (el as HTMLElement).dataset.toggle!;
                const activo = (el as HTMLInputElement).checked;
                try {
                    const res = await fetch('/api/webhooks', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, activo }) });
                    if (!res.ok) throw new Error();
                    (el.closest('.wh-item') as HTMLElement)?.classList.toggle('off', !activo);
                } catch { (el as HTMLInputElement).checked = !activo; (window as any).cordToast?.(dlg.dataset.i18nNoPudoActualizar || 'No se pudo actualizar', 'error'); }
            });
        });

        document.querySelectorAll('[data-del]').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const id = (btn as HTMLElement).dataset.del!;
                if (!await (window as any).cordConfirm({ title: dlg.dataset.i18nEliminarTitulo || 'Eliminar endpoint', body: dlg.dataset.i18nEliminarBody || 'Dejará de recibir eventos de inmediato. ¿Eliminar este webhook?', danger: true, confirmText: dlg.dataset.i18nEliminar || 'Eliminar' })) return;
                try {
                    const res = await fetch('/api/webhooks', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
                    if (!res.ok) { const d = await res.json(); throw new Error(d.error || (dlg.dataset.i18nNoPudoEliminar || 'No se pudo eliminar')); }
                    (btn.closest('.wh-item') as HTMLElement)?.remove();
                } catch (err: any) { (window as any).cordToast?.(err.message || (dlg.dataset.i18nNoPudoEliminar || 'No se pudo eliminar'), 'error'); }
            });
        });

        // Enviar evento de prueba
        document.querySelectorAll('[data-test]').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const id = (btn as HTMLElement).dataset.test!;
                const b = btn as HTMLButtonElement;
                b.disabled = true; const orig = b.textContent; b.textContent = '…';
                try {
                    const res = await fetch('/api/webhooks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'test', id }) });
                    const d = await res.json();
                    b.textContent = d.ok ? (dlg.dataset.i18nEnviado || '✓ Enviado') : `✗ ${d.status || 'falló'}`;
                    const open = document.querySelector(`[data-expand="${id}"][aria-expanded="true"]`);
                    if (open) loadDeliveries(id);
                    setTimeout(() => (b.textContent = orig), 2400);
                } catch { b.textContent = dlg.dataset.i18nError || '✗ error'; setTimeout(() => (b.textContent = orig), 2400); }
                finally { b.disabled = false; }
            });
        });

        // Expandir / colapsar log de entregas
        document.querySelectorAll('[data-expand]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = (btn as HTMLElement).dataset.expand!;
                const panel = document.querySelector(`[data-deliveries="${id}"]`) as HTMLElement;
                const open = btn.getAttribute('aria-expanded') === 'true';
                btn.setAttribute('aria-expanded', String(!open));
                panel.hidden = open;
                if (!open) loadDeliveries(id);
            });
        });
    }

    async function loadDeliveries(webhookId: string) {
        const body = document.querySelector(`[data-delbody="${webhookId}"]`) as HTMLElement | null;
        if (!body) return;
        const i18nCargando = body.dataset.i18nCargando || 'Cargando entregas…';
        const i18nSinEntregas = body.dataset.i18nSinEntregas || 'Sin entregas aún. Usa "Probar" o espera a que pase un evento real.';
        const i18nNoCargo = body.dataset.i18nNoCargo || 'No se pudo cargar el log.';
        const i18nReintentar = body.dataset.i18nReintentar || 'Reintentar';
        const i18nIntentoTpl = body.dataset.i18nIntento || '· intento {n}';
        const i18nPruebaTag = body.dataset.i18nPruebaTag || 'prueba';
        const i18nFallo = body.dataset.i18nFallo || '(falló)';
        body.innerHTML = `<span class="wh-del-loading">${i18nCargando}</span>`;
        try {
            const res = await fetch(`/api/webhooks?deliveries=${encodeURIComponent(webhookId)}`);
            const d = await res.json();
            const list: any[] = d.deliveries || [];
            if (!list.length) { body.innerHTML = `<span class="wh-del-empty">${i18nSinEntregas}</span>`; return; }
            body.innerHTML = list.map((x) => `
                <div class="del-row">
                    <span class="del-dot ${x.ok ? 'ok' : 'err'}"></span>
                    <span class="del-ev">${x.evento}${x.intento > 1 ? `<span class="del-try"> ${i18nIntentoTpl.replace('{n}', x.intento)}</span>` : ''}${x.prueba ? `<i class="del-test">${i18nPruebaTag}</i>` : ''}</span>
                    <span class="del-status ${x.ok ? 'ok' : 'err'}">${x.status || (x.error || i18nFallo)}</span>
                    <span class="del-meta">${x.ms != null ? x.ms + 'ms' : ''} · ${x.cuando}</span>
                    <button class="del-replay" data-replay="${x.id}">${i18nReintentar}</button>
                </div>`).join('');
            body.querySelectorAll('[data-replay]').forEach((rb) => {
                rb.addEventListener('click', async () => {
                    const deliveryId = (rb as HTMLElement).dataset.replay!;
                    const b = rb as HTMLButtonElement; b.disabled = true; b.textContent = '…';
                    try {
                        const r = await fetch('/api/webhooks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'redeliver', deliveryId }) });
                        const dd = await r.json();
                        b.textContent = dd.ok ? '✓' : `✗ ${dd.status || ''}`;
                        setTimeout(() => loadDeliveries(webhookId), 800);
                    } catch { b.textContent = '✗'; b.disabled = false; }
                });
            });
        } catch { body.innerHTML = `<span class="wh-del-empty">${i18nNoCargo}</span>`; }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initWebhooks);
    else initWebhooks();
</script>
