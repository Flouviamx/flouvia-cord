---
// Ajustes › Plan y facturación — suscripción REAL (Stripe Billing) + medidores
// de uso del periodo. Subir de plan → /api/billing/subscribe (Checkout).
// Gestionar → /api/billing/portal (Customer Portal).
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg, getPlanUsage, getBillingUsage } from '../../../lib/queries';
import { PLANES, precioAnualTotal, precioAnualMensualizado } from '../../../lib/precios';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';

const ORG = await getOrg();
const USAGE = await getPlanUsage();
const BILL = await getBillingUsage();
const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

// Entorno de PRUEBA: la facturación (Stripe) nunca opera sobre la org sandbox.
// Ocultamos los botones de cobro y mostramos un aviso — el servidor los bloquea
// igual (409), pero la UI no debe ofrecerlos siquiera.
const isTestEnv = Astro.cookies.get('cord_test_mode')?.value === '1';

// ?plan=pro — el plan al que apunta un AccessGate de motivo `plan`. Sin esto, el
// CTA de un bloqueo aterrizaba en la página genérica sin decir cuál desbloquea.
const highlightPlan = PLANES.some((p) => p.id === Astro.url.searchParams.get('plan'))
    ? Astro.url.searchParams.get('plan')
    : null;

const planRaw = ORG.plan_raw;
const esPago = planRaw !== 'free';
const PAID = PLANES.filter((p) => p.id !== 'free');
const money = (n: number) => '$' + new Intl.NumberFormat(L === 'en' ? 'en-US' : 'es-MX').format(n);

const STATUS_LABEL: Record<string, string> = {
    trialing: t(L, 'set.plan.status.trialing'), active: t(L, 'set.plan.status.active'),
    past_due: t(L, 'set.plan.status.past_due'), canceled: t(L, 'set.plan.status.canceled'),
};
const planActual = PLANES.find((p) => p.id === planRaw);
---

<SettingsShell title="Plan y facturación — Ajustes" tab="plan" perm="ajustes"
    intro={t(L, 'set.plan.intro')}>

    {isTestEnv && (
        <div class="plan-test-note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 12h4l-1.5 8L17 9h-4.5z"/></svg>
            <span>{t(L, 'set.plan.test_note')}</span>
        </div>
    )}

    <div class="s-block">
        <h3>{t(L, 'set.plan.suscripcion_actual')}</h3>
        <div class="plan-row">
            <div class="plan-meta">
                <span class="plan-name">
                    {t(L, 'set.plan.plan_prefix')} {ORG.plan}
                    {BILL.status && <span class={`plan-badge st-${BILL.status}`}>{STATUS_LABEL[BILL.status] ?? BILL.status}</span>}
                </span>
                <span class="plan-price">
                    <span class="editorial">{planActual ? money(planActual.precioMensual) : '$0'}</span> {t(L, 'set.plan.mes_iva')}
                    {BILL.cycle === 'anual' && t(L, 'set.plan.facturacion_anual')}
                    {BILL.periodFin && <i class="plan-renews">{tf('set.plan.renueva', { fecha: BILL.periodFin })}</i>}
                </span>
            </div>
            {esPago && !isTestEnv && <button class="plan-btn solid" data-portal>{t(L, 'set.plan.gestionar')}</button>}
        </div>
    </div>

    <!-- ── ELEGIR / CAMBIAR DE PLAN (tarjetas estilo /precios) ── -->
    <div class="s-block full">
        <h3>{esPago ? t(L, 'set.plan.cambiar') : t(L, 'set.plan.sube')}</h3>
        <div class="cycle-toggle" role="tablist" aria-label={t(L, 'set.plan.ciclo')}>
            <button class="cyc-btn is-active" data-cycle="mensual">{t(L, 'set.plan.mensual')}</button>
            <button class="cyc-btn" data-cycle="anual">{t(L, 'set.plan.anual')} <span class="cyc-save">{t(L, 'set.plan.anual_ahorro')}</span></button>
        </div>

        <div class="pcard-grid">
            {PAID.map((p) => {
                const anual = precioAnualMensualizado(p.precioMensual);
                const actual = p.id === planRaw;
                return (
                    <article class:list={['pcard', { featured: p.destacado, current: actual, highlight: p.id === highlightPlan }]} data-pcard data-current={actual ? '1' : undefined}>
                        <div class="pcard-visual">
                            <div class="pcard-aurora" aria-hidden="true">
                                <div class="pab-b1"></div>
                                <div class="pab-b2"></div>
                            </div>
                            <div class="pcard-visual-top">
                                <span class="pcard-name">{p.nombre}</span>
                            </div>
                            <div class="pcard-visual-bottom">
                                <div class="pcard-price" data-mensual={String(p.precioMensual)} data-anual={String(anual)}>
                                    <span class="editorial pcard-amount pcard-amount-val">{money(p.precioMensual)}</span>
                                    <span class="pcard-cycle">{t(L, 'set.plan.mxn_mes')}</span>
                                </div>
                                <p class="pcard-tagline">{p.tagline}</p>
                            </div>
                        </div>
                        <div class="pcard-body">
                            {actual ? (
                                <span class="pcard-current">{t(L, 'set.plan.actual')}</span>
                            ) : isTestEnv ? (
                                <span class="pcard-current muted" title={t(L, 'set.plan.no_disponible_prueba_title')}>{t(L, 'set.plan.no_disponible_prueba')}</span>
                            ) : (
                                <button class="pcard-cta" data-subscribe={p.id}>{t(L, 'set.plan.elegir')}</button>
                            )}
                            <ul class="pcard-feats">
                                {p.feats.map((f) => (
                                    <li>
                                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <span>{f}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </article>
                );
            })}
        </div>
        <p class="pick-foot">{t(L, 'set.plan.pick_foot')}</p>
    </div>

    <!-- ── MEDIDORES DE USO ── -->
    <div class="s-block">
        <h3>{t(L, 'set.plan.uso_periodo')}</h3>

        <div class="usage">
            <div class="usage-top">
                <span class="usage-label">{t(L, 'set.plan.cotizaciones_activas')}</span>
                <span class="usage-count editorial">{USAGE.usadas}{USAGE.ilimitado ? '' : ` / ${USAGE.limite}`}</span>
            </div>
            {USAGE.ilimitado ? (
                <div class="usage-unlim">{t(L, 'set.plan.ilimitadas')}</div>
            ) : (
                <div class="usage-bar"><span class:list={['usage-fill', { warn: USAGE.pct >= 80, full: USAGE.excedido }]} style={`width:${USAGE.pct}%`}></span></div>
            )}
        </div>

        {[
            { k: 'ia', label: t(L, 'set.plan.armados_ia'), m: BILL.ia },
            { k: 'cfdi', label: t(L, 'set.plan.timbres_cfdi'), m: BILL.cfdi },
            { k: 'api', label: t(L, 'set.plan.llamadas_api'), m: BILL.api },
        ].map(({ label, m }) => (
            <div class="usage">
                <div class="usage-top">
                    <span class="usage-label">{label}</span>
                    <span class="usage-count editorial">{m.usado}{m.ilimitado ? '' : ` / ${m.incluido}`}</span>
                </div>
                {m.ilimitado ? (
                    <div class="usage-unlim">{t(L, 'set.plan.ilimitado')}</div>
                ) : (
                    <>
                        <div class="usage-bar"><span class:list={['usage-fill', { warn: m.pct >= 80, full: m.excedido }]} style={`width:${m.pct}%`}></span></div>
                        {m.excedido && <p class="usage-note">{tf('set.plan.excedente_nota', { n: String(m.usado - (m.incluido ?? 0)) })}</p>}
                    </>
                )}
            </div>
        ))}
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.plan.metodo_pago')}</h3>
        {isTestEnv ? (
            <p class="plan-empty">{t(L, 'set.plan.pagos_no_aplican')}</p>
        ) : esPago ? (
            <p class="plan-empty">{t(L, 'set.plan.gestion_stripe')} <button class="link-btn" data-portal>{t(L, 'set.plan.abrir_portal')}</button></p>
        ) : (
            <p class="plan-empty">{t(L, 'set.plan.agrega_metodo')}</p>
        )}
    </div>
</SettingsShell>

<script is:inline define:vars={{
    I18N_PLAN: {
        noContinuar: t(L, 'set.plan.no_se_pudo_continuar'),
        redirigiendo: t(L, 'set.plan.redirigiendo'),
        abriendo: t(L, 'set.plan.abriendo'),
        noProcesar: t(L, 'set.plan.no_se_pudo_procesar'),
        localeIntl: L === 'en' ? 'en-US' : 'es-MX',
    },
}}></script>
<script>
    const post = async (url: string, body?: any) => {
        const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
        const data = await r.json().catch(() => ({}));
        if (!r.ok || !data.url) throw new Error(data.error || (window as any).I18N_PLAN?.noContinuar || 'No se pudo continuar');
        window.location.href = data.url;
    };

    // Toggle de ciclo → cambia precios mostrados y el ciclo que se envía.
    let cycle: 'mensual' | 'anual' = 'mensual';
    const I18N = (window as any).I18N_PLAN || {};
    const fmt = (n: number) => '$' + new Intl.NumberFormat(I18N.localeIntl || 'es-MX').format(n);
    document.querySelectorAll<HTMLButtonElement>('.cyc-btn').forEach((b) => {
        b.addEventListener('click', () => {
            cycle = (b.dataset.cycle as 'mensual' | 'anual') || 'mensual';
            document.querySelectorAll('.cyc-btn').forEach((x) => x.classList.toggle('is-active', x === b));
            document.querySelectorAll<HTMLElement>('.pcard-price').forEach((el) => {
                const v = cycle === 'anual' ? el.dataset.anual : el.dataset.mensual;
                const val = el.querySelector<HTMLElement>('.pcard-amount-val');
                if (v && val) val.textContent = fmt(parseInt(v, 10));
            });
        });
    });

    // Aurora viajera entre tarjetas de plan (mismo patrón que /precios): activa
    // por defecto en la tarjeta del plan actual (si aparece entre las de paga) o,
    // si no, en la destacada; sigue al hover y regresa al salir del grid.
    {
        const cards = [...document.querySelectorAll<HTMLElement>('[data-pcard]')];
        const gridWrap = document.querySelector<HTMLElement>('.pcard-grid');
        const setAurora = (active: HTMLElement | null) => {
            cards.forEach((c) => c.classList.remove('aurora-active'));
            active?.classList.add('aurora-active');
        };
        const defaultCard = cards.find((c) => c.dataset.current === '1') || cards.find((c) => c.classList.contains('featured')) || null;
        setAurora(defaultCard);
        cards.forEach((card) => card.addEventListener('mouseenter', () => setAurora(card)));
        gridWrap?.addEventListener('mouseleave', () => setAurora(defaultCard));
    }

    // "Elegir" → checkout embebido dentro de la app (mismo flujo que landing/precios).
    document.querySelectorAll<HTMLButtonElement>('[data-subscribe]').forEach((b) => {
        b.addEventListener('click', () => {
            b.disabled = true; b.textContent = I18N.redirigiendo || 'Redirigiendo…';
            window.location.href = `/app/checkout?plan=${b.dataset.subscribe}&cycle=${cycle}`;
        });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-portal]').forEach((b) => {
        b.addEventListener('click', async () => {
            const label = b.textContent; b.disabled = true; b.textContent = I18N.abriendo || 'Abriendo…';
            try { await post('/api/billing/portal'); }
            catch (e: any) { (window as any).cordToast?.(e.message || I18N.noProcesar || 'No se pudo procesar', 'error'); b.disabled = false; b.textContent = label; }
        });
    });
</script>

<style>
    /* Plan resaltado al llegar desde un bloqueo (`?plan=pro`): anillo navy sutil,
       mismo lenguaje que `.s-save.dirty`. No cambia el layout ni el orden. */
    .pcard.highlight { box-shadow: 0 0 0 2px var(--color-blue-deep), 0 24px 48px -22px rgba(10,25,47,.4); }

    .plan-test-note {
        display: flex; align-items: center; gap: 0.65rem;
        padding: 0.85rem 1.1rem; margin-bottom: 1.4rem;
        background: rgba(245,158,11,0.09); border: 1px solid rgba(245,158,11,0.28);
        border-radius: 14px; color: #b45309; font-size: 0.83rem; line-height: 1.5;
    }
    .plan-test-note svg { width: 17px; height: 17px; flex-shrink: 0; color: #d97706; }
    .plan-test-note b { color: #92400e; }
    html[data-theme="dark"] .plan-test-note { background: rgba(245,158,11,0.12); color: #fbbf24; }
    html[data-theme="dark"] .plan-test-note b { color: #fcd34d; }
    .plan-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 1.1rem 0.4rem; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
    .plan-meta { display: flex; flex-direction: column; gap: 4px; }
    .plan-name { font-size: 1.05rem; font-weight: 700; display: flex; align-items: center; gap: 9px; }
    .plan-price { font-size: 0.8rem; color: var(--color-text-muted); }
    .plan-price .editorial { font-size: 1.1rem; color: var(--color-blue-deep); }
    .plan-renews { font-style: normal; }
    .plan-badge { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.3px; padding: 3px 8px; border-radius: 100px; text-transform: uppercase; }
    .st-trialing { background: rgba(245,158,11,0.14); color: #b45309; }
    .st-active { background: rgba(16,185,129,0.14); color: #059669; }
    .st-past_due { background: rgba(239,68,68,0.14); color: #dc2626; }
    .st-canceled { background: rgba(0,0,0,0.06); color: var(--color-text-muted); }

    .plan-btn { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: var(--color-text); background: var(--surface); border: 1px solid var(--color-border); border-radius: 9px; padding: 9px 16px; cursor: pointer; transition: transform 0.3s, box-shadow 0.3s; }
    .plan-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 18px -10px rgba(10,25,47,0.3); }
    .plan-btn.solid { background: var(--color-blue-deep); color: #fff; border-color: var(--color-blue-deep); }
    .plan-btn:disabled { opacity: 0.6; cursor: default; transform: none; box-shadow: none; }
    .link-btn { background: none; border: none; color: var(--color-blue-deep); font-weight: 600; cursor: pointer; font-size: inherit; font-family: inherit; padding: 0; }

    /* Toggle ciclo */
    .cycle-toggle { display: inline-flex; width: fit-content; gap: 2px; padding: 4px; border-radius: 100px; background: var(--color-bg-soft); border: 1px solid var(--color-border); margin-bottom: 1.2rem; }
    .cyc-btn { border: none; background: none; cursor: pointer; font-family: inherit; font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted); padding: 7px 16px; border-radius: 100px; display: inline-flex; align-items: center; gap: 7px; }
    .cyc-btn.is-active { background: var(--color-blue-deep); color: #fff; }
    .cyc-save { font-size: 0.6rem; font-weight: 800; padding: 2px 6px; border-radius: 100px; background: rgba(16,185,129,0.16); color: #059669; }
    .cyc-btn.is-active .cyc-save { background: rgba(255,255,255,0.18); color: #6ee7b7; }

    .pick-foot { font-size: 0.78rem; color: var(--color-text-muted); margin: 1.4rem 0 0; line-height: 1.5; }

    /* ════════ Tarjetas de plan (estilo /precios, aurora viajera) ════════ */
    .pcard-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; align-items: stretch; }
    @media (max-width: 900px) { .pcard-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .pcard-grid { grid-template-columns: 1fr; } }

    .pcard {
        position: relative; display: flex; flex-direction: column;
        border-radius: 18px; overflow: hidden; border: 1px solid var(--color-border);
        background: var(--surface); transition: box-shadow 0.35s, transform 0.35s;
    }
    .pcard:hover { box-shadow: 0 12px 32px -10px rgba(10,25,47,0.16); transform: translateY(-2px); }
    .pcard.featured { box-shadow: 0 8px 24px -8px rgba(10,25,47,0.16); }
    .pcard.current { box-shadow: 0 0 0 1.5px var(--color-blue-deep); }

    .pcard-visual {
        position: relative; padding: 1.2rem; display: flex; flex-direction: column;
        justify-content: space-between; min-height: 140px; gap: 0.7rem;
        background: var(--color-bg-soft); overflow: hidden; transition: background 0.5s;
    }
    .pcard-visual-top { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; }
    .pcard-visual-bottom { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 0.3rem; margin-top: auto; }

    .pcard-aurora {
        position: absolute; inset: 0; z-index: 0; background: #08152a; opacity: 0;
        transition: opacity 0.5s cubic-bezier(0.16,1,0.3,1); pointer-events: none;
    }
    .pcard.aurora-active .pcard-visual { background: transparent; }
    .pcard.aurora-active .pcard-aurora { opacity: 1; }

    .pab-b1 {
        position: absolute; inset: -45%;
        background:
            radial-gradient(ellipse 80% 60% at 18% 32%, rgba(15,99,250,0.6) 0%, transparent 52%),
            radial-gradient(ellipse 60% 75% at 82% 68%, rgba(97,183,255,0.38) 0%, transparent 52%),
            radial-gradient(ellipse 45% 45% at 52% 48%, rgba(37,99,235,0.22) 0%, transparent 65%);
        animation: pab-drift1 9s ease-in-out infinite alternate;
    }
    .pab-b2 {
        position: absolute; inset: -35%;
        background:
            radial-gradient(ellipse 65% 55% at 74% 20%, rgba(96,165,250,0.3) 0%, transparent 52%),
            radial-gradient(ellipse 48% 62% at 26% 80%, rgba(14,165,233,0.28) 0%, transparent 52%);
        animation: pab-drift2 13s ease-in-out infinite alternate-reverse;
    }
    @keyframes pab-drift1 {
        from { transform: translate(-4%, 3%) rotate(-6deg) scale(1); }
        to   { transform: translate(5%, -4%) rotate(5deg) scale(1.08); }
    }
    @keyframes pab-drift2 {
        from { transform: translate(4%, -3%) rotate(4deg) scale(1.05); }
        to   { transform: translate(-5%, 4%) rotate(-5deg) scale(1); }
    }

    .pcard-name { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; color: var(--color-text); transition: color 0.4s; }
    .pcard-price { display: flex; align-items: baseline; gap: 5px; }
    .pcard-amount { font-size: 1.7rem; line-height: 1; font-weight: 500; letter-spacing: -1px; color: var(--color-text); transition: color 0.4s; }
    .pcard-cycle { font-size: 0.72rem; font-weight: 500; color: var(--color-text-muted); transition: color 0.4s; }
    .pcard-tagline { font-size: 0.74rem; margin: 0; line-height: 1.35; color: var(--color-text-muted); transition: color 0.4s; }

    .pcard.aurora-active .pcard-name    { color: #fff; }
    .pcard.aurora-active .pcard-amount  { color: #fff; }
    .pcard.aurora-active .pcard-cycle   { color: rgba(255,255,255,0.6); }
    .pcard.aurora-active .pcard-tagline { color: rgba(255,255,255,0.52); }

    .pcard-body { flex-grow: 1; display: flex; flex-direction: column; padding: 1.1rem 1.2rem 1.3rem; gap: 0.7rem; border-top: 1px solid var(--color-border); }

    .pcard-cta {
        position: relative; overflow: hidden; display: block; width: 100%; text-align: center;
        font-family: var(--font-sans); font-size: 0.84rem; font-weight: 600; color: #fff;
        background: var(--color-blue-deep); border: 1px solid transparent; border-radius: 999px;
        padding: 10px 14px; cursor: pointer; letter-spacing: -0.01em;
        transition: transform 0.22s var(--ease-spring), box-shadow 0.22s, background 0.22s;
    }
    .pcard-cta::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.18) 50%, transparent 60%);
        transform: translateX(-110%); transition: transform 0.55s cubic-bezier(0.16,1,0.3,1); pointer-events: none;
    }
    .pcard-cta:hover::after { transform: translateX(110%); }
    .pcard-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(10,25,47,0.28); }
    .pcard-cta:active { transform: scale(0.97); }
    .pcard-cta:disabled { opacity: 0.6; cursor: default; transform: none; box-shadow: none; }

    .pcard-current { display: block; text-align: center; font-size: 0.8rem; font-weight: 600; color: var(--color-ok); padding: 10px 0; }
    .pcard-current.muted { color: var(--color-text-muted); }

    .pcard-feats { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; flex-grow: 1; }
    .pcard-feats li { display: flex; align-items: flex-start; gap: 8px; font-size: 0.78rem; line-height: 1.4; color: var(--color-text-muted); padding: 0.45rem 0; border-bottom: 1px solid var(--color-border); }
    .pcard-feats li:last-child { border-bottom: none; }
    .pcard-feats li svg { width: 11px; height: 11px; flex-shrink: 0; color: var(--color-blue-deep); margin-top: 3px; }

    .usage { max-width: 460px; margin-bottom: 1.4rem; }
    .usage-top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.5rem; }
    .usage-label { font-size: 0.85rem; color: var(--color-text); font-weight: 500; }
    .usage-count { font-size: 1rem; color: var(--color-blue-deep); }
    .usage-bar { height: 8px; border-radius: 100px; background: var(--color-bg-soft); border: 1px solid var(--color-border); overflow: hidden; }
    .usage-fill { display: block; height: 100%; background: var(--color-ok); border-radius: 100px; transition: width 0.5s var(--ease-spring); }
    .usage-fill.warn { background: var(--color-warn); }
