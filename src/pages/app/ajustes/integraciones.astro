---
// Ajustes › Integraciones: directorio de apps; cada una abre su propia página de detalle.
import SettingsShell from '../../../components/app/SettingsShell.astro';
import IntegrationsDirectory from '../../../components/app/IntegrationsDirectory.astro';
import { getMyMembership, getOrg } from '../../../lib/queries';
import { memberCan } from '../../../lib/permissions';
import { getActiveOrgId } from '../../../lib/db';
import { currentLocale } from '../../../lib/context';
import { hubspotStatus } from '../../../lib/integraciones/hubspot/service';
import { connectedOAuthApps } from '../../../lib/oauth-provider';
import { t } from '../../../i18n/app';

const legado = Astro.url.searchParams.get('hubspot');
if (legado && /^[a-z_]{1,20}$/.test(legado)) return Astro.redirect(`/app/ajustes/integraciones/hubspot?hubspot=${legado}`);

const ORG = await getOrg();
const L = currentLocale();
const ME = await getMyMembership();
const HS = memberCan(ME, 'ajustes') ? await hubspotStatus(await getActiveOrgId(), false).catch(() => null) : null;
const OAUTH = await connectedOAuthApps(await getActiveOrgId()).catch(() => []);
---

<SettingsShell title="Integraciones — Ajustes" tab="integraciones" perm="ajustes" intro={t(L, 'set.integ.intro')}>
    <IntegrationsDirectory lang={L} hubspot={HS?.conexion?.estado ?? null} slack={Boolean(ORG.slackWebhook)} teams={Boolean(ORG.teamsWebhook)} whatsapp={Boolean(ORG.whatsappConectado)} oauth={OAUTH} />
</SettingsShell>
