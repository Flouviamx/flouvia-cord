---
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg } from '../../../lib/queries';
import { currentLocale } from '../../../lib/context';
import '../../../styles/brand-editor.css';
const org = await getOrg();
const en = currentLocale() === 'en';
const say = (es:string, english:string) => en ? english : es;
import { iconInner } from '../../../lib/icons';
---
<SettingsShell title={say('Documento PDF — Ajustes','PDF document — Settings')} tab="pdf" perm="ajustes" save>
<div class="brand-editor" id="pdfEditor">
    <div class="be-toolbar"><p>{say('Una propuesta que lleva tu marca.','A proposal that carries your brand.')}<span>{say('La vista previa usa el mismo documento que imprimes.','The preview uses the same document you print.')}</span></p></div>
    <div class="be-layout">
        <div class="be-controls">
            <div class="be-inherited"><div><b>{say('Identidad compartida','Shared identity')}</b><p>{say('Logo, colores, tipografía y espaciado de tu marca.','Your logo, colors, typography and spacing.')}</p></div><a href="/app/ajustes/branding">{say('Editar →','Edit →')}</a></div>
            <section class="be-section">
                <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('document')}></svg>{say('Composición del documento','Document layout')}</h3>
                <div class="be-options">
                    {[['minimal',say('Minimal','Minimal')],['clasico',say('Clásico','Classic')],['detallado',say('Detallado','Detailed')]].map(([value,label]) => <label class="be-option"><input type="radio" name="pdfTpl" data-field="pdf_template" value={value} checked={(org.pdfTemplate || 'clasico') === value}/><span class:list={['be-layout-sample',value==='detallado'?'contrast':value==='minimal'?'minimal':'']} aria-hidden="true"><i/><i/><i/></span><b>{label}</b></label>)}
                </div>
                <p class="be-help">{say('El encabezado de color utiliza la variante de logo sobre color.','The colored header uses your alternate logo.')}</p>
            </section>
            <section class="be-section">
                <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chat')}></svg>{say('Contenido','Content')}</h3>
                <label class="be-label" for="pdfMessage">{say('Mensaje al pie','Footer message')}</label>
                <input class="s-input" id="pdfMessage" data-field="pdf_mensaje" value={org.pdfMensaje} maxlength="500"/>
                <label class="be-label" for="pdfConditions">{say('Condiciones comerciales','Commercial terms')}</label>
                <textarea class="s-input" id="pdfConditions" data-field="pdf_condiciones" rows="5" maxlength="2000">{org.pdfCondiciones}</textarea>
                <p class="be-help">{say('Una condición por línea.','One term per line.')}</p>
                <label class="s-toggle"><input type="checkbox" id="pdfList" data-field="pdf_mostrar_lista" checked={org.pdfMostrarLista}/><span class="s-toggle-track" aria-hidden="true"><span class="s-toggle-thumb"/></span><span class="s-toggle-text">{say('Mostrar precio de lista y descuento','Show list prices and discounts')}</span></label>
            </section>
            <p class="be-help">{say('La composición se aplica a las cotizaciones. Las facturas comerciales heredan tu identidad y conservan sus datos fiscales.','This layout applies to quotes. Commercial invoices inherit your identity and retain their tax details.')}</p>
        </div>
        <aside class="be-preview">
            <div class="be-preview-bar"><span>{say('Vista del documento','Document preview')}</span><a href="/app/ajustes/documento-preview" target="_blank">{say('Abrir muestra ↗','Open sample ↗')}</a></div>
            <div class="be-preview-stage"><iframe id="pdfPreview" src="/app/ajustes/documento-preview" title={say('Vista previa del PDF','PDF preview')}/></div>
            <p class="be-preview-note">{say('Cotización de ejemplo en MXN. No crea documentos ni envíos.','Sample quote in MXN. No documents or messages are created.')}</p>
        </aside>
    </div>
</div>
</SettingsShell>
<script>
    import { initDocumentPreview } from '../../../lib/document-preview';
    initDocumentPreview('pdfEditor','pdfPreview','cord:pdf-preview',() => ({
        template:document.querySelector<HTMLInputElement>('[name=pdfTpl]:checked')?.value,
        message:(document.getElementById('pdfMessage') as HTMLInputElement).value,
        conditions:(document.getElementById('pdfConditions') as HTMLTextAreaElement).value,
        list:(document.getElementById('pdfList') as HTMLInputElement).checked,
    }));
</script>
