---
// Ajustes › Aprobaciones y tesorería
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getOrg } from '../../../lib/queries';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
const ORG = await getOrg();
const L = currentLocale();
---

<SettingsShell title="Aprobaciones y tesorería — Ajustes" tab="aprobaciones" perm="ajustes"
    intro={t(L, 'set.aprob.intro')} save>
    <div class="s-block">
        <h3>{t(L, 'set.aprob.umbrales')}</h3>
        <div class="s-body">
            <div class="s-row">
                <div class="s-field">
                    <label for="oAprobDesc">{t(L, 'set.aprob.desc_max')}</label>
                    <input class="s-input" id="oAprobDesc" data-field="aprob_descuento_max" type="number" min="0" max="100" step="1" value={ORG.aprobDescuentoMax} />
                    <span class="s-hint">{t(L, 'set.aprob.desc_max_hint')}</span>
                </div>
                <div class="s-field">
                    <label for="oAprobMonto">{t(L, 'set.aprob.monto_max')}</label>
                    <input class="s-input" id="oAprobMonto" data-field="aprob_monto_max" type="number" min="0" step="1000" value={ORG.aprobMontoMax} />
                    <span class="s-hint">{t(L, 'set.aprob.monto_max_hint')}</span>
                </div>
            </div>
            <div class="s-row">
                <div class="s-field">
                    <label for="oAprobMargen">{t(L, 'set.aprob.margen_min')}</label>
                    <input class="s-input" id="oAprobMargen" data-field="aprob_margen_min" type="number" min="0" max="100" step="1" value={ORG.aprobMargenMin} />
                    <span class="s-hint">{t(L, 'set.aprob.margen_min_hint')}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="s-block">
        <h3>{t(L, 'set.aprob.tesoreria')}</h3>
        <div class="s-body">
            <div class="s-field">
                <label for="oInteres">{t(L, 'set.aprob.interes')}</label>
                <input class="s-input" id="oInteres" data-field="interes_moratorio_pct" type="number" min="0" max="100" step="0.5" value={ORG.interesMoratorioPct} />
                <span class="s-hint">{t(L, 'set.aprob.interes_hint')}</span>
            </div>
        </div>
    </div>
</SettingsShell>
