---
// Ajustes › Developers › API.
// Claves de API REALES (tabla api_keys, hash sha-256) en tabla estilo Stripe:
// la clave en claro se muestra UNA vez al crearla. Endpoints REST + actividad
// en vivo. Webhooks y MCP viven en sus propias pestañas (jun 2026: se separó
// la antigua página "API y webhooks" en API · Webhooks · MCP).
import SettingsShell from '../../../components/app/SettingsShell.astro';
import { getApiKeys, getOrg, getApiActivity } from '../../../lib/queries';
import { apiKeyLimit, planLabel } from '../../../lib/permissions';
import '../../../styles/developers.css';
import { currentLocale } from '../../../lib/context';
import { t } from '../../../i18n/app';
const ORG = await getOrg();
const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const KEYS = await getApiKeys();
const ACTIVITY = await getApiActivity();
const LIMITE = apiKeyLimit(ORG.plan_raw);
const ACTIVAS = KEYS.filter((k) => !k.revocada).length;
const AT_LIMIT = ACTIVAS >= LIMITE;
---

<SettingsShell title="API — Ajustes" tab="api" perm="ajustes"
    intro={t(L, 'set.api.intro')}>
<div class="dev-wrapper">

    <!-- ── CLAVES DE API (tabla estilo Stripe) ── -->
    <div class="dev-card">
        <div class="dev-card-header">
            <div>
                <h3 class="dev-card-title">{t(L, 'set.api.claves_titulo')}</h3>
                <p class="dev-card-sub" set:html={t(L, 'set.api.claves_sub')} />
            </div>
            <div class="dev-head-actions">
                <div class="dev-seg" role="tablist" aria-label={t(L, 'set.api.modo_clave')}>
                    <button class="dev-seg-btn active" data-mode="test">{t(L, 'set.api.prueba')}</button>
                    <button class="dev-seg-btn" data-mode="live">{t(L, 'set.api.vivo')}</button>
                </div>
                <span class="dev-limit">{tf('set.api.plan_limite', { plan: planLabel(ORG.plan_raw) })} <b>{ACTIVAS}/{LIMITE}</b></span>
                <button class="api-btn-solid" id="kNew" disabled={AT_LIMIT} title={AT_LIMIT ? tf('set.api.limite_hint', { n: String(LIMITE) }) : ''}>{t(L, 'set.api.generar_clave')}</button>
            </div>
        </div>
        {AT_LIMIT && (
            <p class="dev-limit-note">{tf('set.api.limite_nota_pre', { n: String(LIMITE) })} <a href="/app/ajustes/plan">{t(L, 'set.api.subir_plan')}</a> {t(L, 'set.api.limite_nota_post')}</p>
        )}

        <div class="key-table" id="keyList">
            <div class="key-thead">
                <span>{t(L, 'set.api.th_nombre')}</span><span>{t(L, 'set.api.th_token')}</span><span>{t(L, 'set.api.th_permisos')}</span><span>{t(L, 'set.api.th_ultimo_uso')}</span><span>{t(L, 'set.api.th_creacion')}</span><span></span>
            </div>
            {KEYS.length === 0 && (
                <div class="key-empty" id="keyEmpty">{t(L, 'set.api.vacio')}</div>
            )}
            {KEYS.map((k) => (
                <div class:list={['key-trow', { revoked: k.revocada }]} data-id={k.id}>
                    <span class="key-cell-name">
                        <span class="key-nm">{k.nombre}</span>
                        <span style="display:flex;gap:0.3rem">
                            <span class={`key-mode ${k.mode}`}>{k.mode === 'test' ? t(L, 'set.api.prueba') : t(L, 'set.api.vivo')}</span>
                            <span class={`key-mode`} style={`background:${k.type === 'publishable' ? '#e0e7ff' : '#f1f5f9'}; color:${k.type === 'publishable' ? '#4f46e5' : '#475569'}`}>{k.type === 'publishable' ? t(L, 'set.api.publica') : t(L, 'set.api.secreta')}</span>
                        </span>
                    </span>
                    <code class="key-cell-token">{k.masked}</code>
                    <span class={`key-scope ${k.scope}`}>{k.scope === 'write' ? t(L, 'set.api.escritura') : t(L, 'set.api.lectura')}</span>
                    <span class="key-cell-muted">{k.ultimoUso || t(L, 'set.api.sin_uso')}</span>
                    <span class="key-cell-muted">{k.creada}</span>
                    <span class="key-cell-act">
                        {k.revocada
                            ? <span class="key-badge-revoked">{t(L, 'set.api.revocada')}</span>
                            : <button class="key-revoke" data-revoke={k.id}>{t(L, 'set.api.revocar')}</button>}
                    </span>
                </div>
            ))}
        </div>
    </div>

    <!-- ── ENDPOINTS ── -->
    <div class="dev-card">
        <h3 class="dev-card-title">{t(L, 'set.api.endpoints_titulo')}</h3>
        <p class="dev-note" style="margin: 0.4rem 0 1.2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
            <span>{t(L, 'set.api.endpoints_base_pre')} <code>https://cordhq.app/api/v1</code> {t(L, 'set.api.endpoints_base_post')} <code>Authorization: Bearer &lt;tu_clave&gt;</code>.</span>
            <span style="display:flex; gap: 0.8rem; font-size: 0.75rem;">
                <a href="/openapi.yaml" target="_blank" rel="noopener" style="color: var(--color-blue-deep); text-decoration: none; font-weight: 600;">{t(L, 'set.api.spec_openapi')}</a>
                <a href="/llms.txt" target="_blank" rel="noopener" style="color: var(--color-blue-deep); text-decoration: none; font-weight: 600;">{t(L, 'set.api.llms_txt')}</a>
            </span>
        </p>
        <div class="ep-rows">
            <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/me</code><span class="ep-d">{t(L, 'set.api.ep_me')}</span></div>
            <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/cotizaciones</code><span class="ep-d" set:html={t(L, 'set.api.ep_cot_list')} /></div>
            <div class="ep-row"><span class="ep-m post">POST</span><code class="ep-path">/cotizaciones</code><span class="ep-d">{t(L, 'set.api.ep_cot_create')}</span></div>
            <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/cotizaciones/:id</code><span class="ep-d">{t(L, 'set.api.ep_cot_detail')}</span></div>
            <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/clientes</code><span class="ep-d">{t(L, 'set.api.ep_cli_list')}</span></div>
            <div class="ep-row"><span class="ep-m post">POST</span><code class="ep-path">/clientes</code><span class="ep-d">{t(L, 'set.api.ep_cli_create')}</span></div>
            <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/productos</code><span class="ep-d">{t(L, 'set.api.ep_prod_list')}</span></div>
            <div class="ep-row"><span class="ep-m post">POST</span><code class="ep-path">/productos</code><span class="ep-d">{t(L, 'set.api.ep_prod_create')}</span></div>
            <div class="ep-row"><span class="ep-m get">GET</span><code class="ep-path">/cobranza</code><span class="ep-d">{t(L, 'set.api.ep_cobranza')}</span></div>
        </div>
        <div class="dev-terminal">
            <span class="ep-code-label">{t(L, 'set.api.ejemplo')}</span>
            <pre><code>curl https://cordhq.app/api/v1/cotizaciones \
  -H "Authorization: Bearer sk_live_xxxxxxxxxxxx"</code></pre>
        </div>
        <div style="margin-top: 1.5rem;">
            <button class="api-btn-ghost" id="btnAiPrompt" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 0.6rem;" data-i18n-copiado={t(L, 'set.api.prompt_copiado')}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                {t(L, 'set.api.generar_prompt')}
            </button>
        </div>
    </div>

    <!-- ── ACTIVIDAD DEL API ── -->
    <div class="dev-card">
        <div class="dev-card-header">
            <h3 class="dev-card-title">{t(L, 'set.api.actividad_titulo')}</h3>
            <button class="dev-refresh" id="actRefresh" title={t(L, 'set.api.actualizar')} data-i18n-actualizar={t(L, 'set.api.actualizar')} data-i18n-actualizando={t(L, 'set.api.actualizando')}>{t(L, 'set.api.actualizar')}</button>
        </div>
        <div class="dev-stats-grid">
            <div class="dev-stat-box"><span class="dev-stat-value editorial" id="actTotal">{ACTIVITY.total24}</span><span class="dev-stat-label">{t(L, 'set.api.requests_24h')}</span></div>
            <div class="dev-stat-box"><span class={`dev-stat-value editorial ${ACTIVITY.errores24 > 0 ? 'bad' : ''}`} id="actErr">{ACTIVITY.errores24}</span><span class="dev-stat-label">{t(L, 'set.api.errores_24h')}</span></div>
            <div class="dev-stat-box"><span class="dev-stat-value editorial" id="actLat">{ACTIVITY.latProm}<em>ms</em></span><span class="dev-stat-label">{t(L, 'set.api.latencia_prom')}</span></div>
        </div>
        <div class="act-list" id="actList" data-i18n-sin-actividad={t(L, 'set.api.sin_actividad')}>
            {ACTIVITY.recent.length === 0 && <p class="dev-empty" id="actEmpty">{t(L, 'set.api.sin_actividad')}</p>}
            {ACTIVITY.recent.map((r) => (
                <div class="act-row">
                    <span class={`act-m ${r.metodo.toLowerCase()}`}>{r.metodo}</span>
                    <code class="act-path">{r.ruta}</code>
                    <span class={`act-status ${r.status >= 400 ? 'bad' : 'ok'}`}>{r.status}</span>
                    <span class="act-lat">{r.ms != null ? `${r.ms}ms` : '—'}</span>
                    <span class="act-when">{r.cuando}{r.mode === 'test' ? ' · test' : ''}</span>
                </div>
            ))}
        </div>
    </div>
</div>
</SettingsShell>

<!-- Modal: crear API key (nombre + scope) -->
<dialog id="kCreate" class="kdlg"
    data-i18n-prueba={t(L, 'set.api.modal_nueva_prueba')} data-i18n-vivo={t(L, 'set.api.modal_nueva_vivo')}
    data-i18n-pruebas={t(L, 'set.api.pruebas')} data-i18n-produccion={t(L, 'set.api.produccion')}
    data-i18n-no-pudo-crear={t(L, 'set.api.no_pudo_crear')} data-i18n-disabled-test={t(L, 'set.api.disabled_test_env')}
    data-i18n-revocar-titulo={t(L, 'set.api.revocar_titulo')} data-i18n-revocar-body={t(L, 'set.api.revocar_body')} data-i18n-revocar-confirm={t(L, 'set.api.revocar_confirm')}>
    <div class="kdlg-inner">
        <h4 id="kCreateTitle">{t(L, 'set.api.modal_nueva_titulo')}</h4>
        <div class="s-field" style="margin-bottom:1.1rem">
            <label for="kName">{t(L, 'set.api.modal_nombre')}</label>
            <input class="s-input" id="kName" placeholder={t(L, 'set.api.modal_nombre_ph')} />
        </div>
        <div class="s-field">
            <label>{t(L, 'set.api.tipo_clave')}</label>
            <div class="scope-opts" style="margin-bottom: 1.1rem;">
                <label class="scope-opt">
                    <input type="radio" name="kType" value="secret" checked />
                    <span class="scope-body"><b>{t(L, 'set.api.tipo_secreta_titulo')}</b><i>{t(L, 'set.api.tipo_secreta_desc')}</i></span>
                </label>
                <label class="scope-opt">
                    <input type="radio" name="kType" value="publishable" />
                    <span class="scope-body"><b>{t(L, 'set.api.tipo_publica_titulo')}</b><i>{t(L, 'set.api.tipo_publica_desc')}</i></span>
                </label>
            </div>
        </div>
        <div class="s-field" id="kScopeField">
            <label>{t(L, 'set.api.permisos')}</label>
            <div class="scope-opts">
                <label class="scope-opt">
                    <input type="radio" name="kScope" value="read" checked />
                    <span class="scope-body"><b>{t(L, 'set.api.solo_lectura_titulo')}</b><i>{t(L, 'set.api.solo_lectura_desc')}</i></span>
                </label>
                <label class="scope-opt">
                    <input type="radio" name="kScope" value="write" />
                    <span class="scope-body"><b>{t(L, 'set.api.lectura_escritura_titulo')}</b><i>{t(L, 'set.api.lectura_escritura_desc')}</i></span>
                </label>
            </div>
        </div>
        <div class="wh-dlg-actions">
            <button type="button" class="api-btn-ghost" id="kCreateCancel">{t(L, 'set.api.cancelar')}</button>
            <button type="button" class="api-btn-solid" id="kCreateGo">{t(L, 'set.api.generar_clave')}</button>
        </div>
    </div>
</dialog>

<!-- Modal: clave recién creada (se muestra UNA vez) -->
<dialog id="kDialog" class="kdlg">
    <div class="kdlg-inner">
        <h4 id="kdlgTitle">{t(L, 'set.api.modal_clave_titulo')}</h4>
        <p class="kdlg-warn" set:html={t(L, 'set.api.modal_clave_warn')} />
        <div class="kdlg-key">
            <code id="kdlgSecret">sk_live_…</code>
            <button id="kdlgCopy" class="kdlg-copy" data-i18n-copiar={t(L, 'set.api.copiar')} data-i18n-copiada={t(L, 'set.api.copiada')}>{t(L, 'set.api.copiar')}</button>
        </div>
        <form method="dialog"><button class="kdlg-done">{t(L, 'set.api.listo_guardada')}</button></form>
    </div>
</dialog>

<script>
    function initApi() {
        const dialog = document.getElementById('kDialog') as HTMLDialogElement | null;
        const secretEl = document.getElementById('kdlgSecret');
        const newBtn = document.getElementById('kNew');
        const createDlg = document.getElementById('kCreate') as HTMLDialogElement | null;
        if (!dialog || !newBtn || !createDlg) return;

        // Segmented Vivo/Prueba → modo de la próxima clave (prueba por default).
        // Si el ENTORNO DE PRUEBA está activo (cookie/sandbox), el servidor fuerza
        // mode=test — el segmento "Vivo" se deshabilita para que la UI diga la verdad.
        const inTestEnv = document.cookie.split('; ').includes('cord_test_mode=1');
        let mode = inTestEnv || localStorage.getItem('cord_test_mode') === 'true' ? 'test' : 'live';

        const setModeUI = (newMode: string) => {
            mode = inTestEnv ? 'test' : newMode;
            document.querySelectorAll('.dev-seg-btn').forEach((x) => x.classList.remove('active'));
            const activeBtn = document.querySelector(`.dev-seg-btn[data-mode="${mode}"]`);
            if (activeBtn) activeBtn.classList.add('active');
        };
        setModeUI(mode);
        if (inTestEnv) {
            const liveBtn = document.querySelector('.dev-seg-btn[data-mode="live"]') as HTMLButtonElement | null;
            if (liveBtn) { liveBtn.disabled = true; liveBtn.title = createDlg.dataset.i18nDisabledTest || 'Estás en el entorno de prueba — sal del modo de prueba para generar llaves en vivo.'; }
        }

        document.querySelectorAll('.dev-seg-btn').forEach((b) => b.addEventListener('click', () => {
            setModeUI((b as HTMLElement).dataset.mode || 'test');
        }));

        // Sincroniza con el switch global "Entorno de prueba".
        window.addEventListener('cord:test_mode_changed', (e: any) => {
            setModeUI(e.detail.isTestMode ? 'test' : 'live');
        });

        const nameIn = document.getElementById('kName') as HTMLInputElement;
        const titleEl = document.getElementById('kCreateTitle')!;

        // Ocultar campo de scope si es Publishable Key
        document.querySelectorAll('input[name="kType"]').forEach((r) => {
            r.addEventListener('change', (e) => {
                const isPub = (e.target as HTMLInputElement).value === 'publishable';
                document.getElementById('kScopeField')!.style.display = isPub ? 'none' : 'block';
            });
        });
        newBtn.addEventListener('click', () => {
            titleEl.textContent = mode === 'test' ? (createDlg.dataset.i18nPrueba || 'Nueva API key de prueba') : (createDlg.dataset.i18nVivo || 'Nueva API key EN VIVO');
            nameIn.value = mode === 'test' ? (createDlg.dataset.i18nPruebas || 'Pruebas') : (createDlg.dataset.i18nProduccion || 'Producción');
            (createDlg.querySelector('input[name="kScope"][value="read"]') as HTMLInputElement).checked = true;
            (createDlg.querySelector('input[name="kType"][value="secret"]') as HTMLInputElement).checked = true;
            document.getElementById('kScopeField')!.style.display = 'block';
            createDlg.showModal(); nameIn.focus(); nameIn.select();
        });
        document.getElementById('kCreateCancel')?.addEventListener('click', () => createDlg.close());

        document.getElementById('kCreateGo')?.addEventListener('click', async () => {
            const nombre = nameIn.value.trim() || 'Sin nombre';
            const scope = (createDlg.querySelector('input[name="kScope"]:checked') as HTMLInputElement)?.value || 'read';
            const type = (createDlg.querySelector('input[name="kType"]:checked') as HTMLInputElement)?.value || 'secret';
            const go = document.getElementById('kCreateGo') as HTMLButtonElement;
            go.disabled = true;
            try {
                const res = await fetch('/api/keys', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nombre, scope, mode, type }),
                });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || (createDlg.dataset.i18nNoPudoCrear || 'No se pudo crear'));
                createDlg.close();
                if (secretEl) secretEl.textContent = d.secret;
                dialog.showModal();
                dialog.addEventListener('close', () => location.reload(), { once: true });
            } catch (err: any) {
                (window as any).cordToast?.(err.message || (createDlg.dataset.i18nNoPudoCrear || 'No se pudo crear la clave'), 'error');
            } finally { go.disabled = false; }
        });

        document.getElementById('kdlgCopy')?.addEventListener('click', async () => {
            const txt = secretEl?.textContent || '';
            const b = document.getElementById('kdlgCopy')!;
            const copiadaTxt = b.dataset.i18nCopiada || '✓ Copiada';
            const copiarTxt = b.dataset.i18nCopiar || 'Copiar';
            try { await navigator.clipboard.writeText(txt); b.textContent = copiadaTxt; setTimeout(() => (b.textContent = copiarTxt), 1800); } catch {}
        });

        document.querySelectorAll('[data-revoke]').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const id = (btn as HTMLElement).dataset.revoke!;
                const dlg = document.getElementById('kCreate');
                const titleTxt = dlg?.dataset.i18nRevocarTitulo || 'Revocar API key';
                if (!await (window as any).cordConfirm({ title: titleTxt, body: dlg?.dataset.i18nRevocarBody || 'Dejará de funcionar de inmediato y no se puede deshacer. ¿Revocar esta clave?', danger: true, confirmText: dlg?.dataset.i18nRevocarConfirm || 'Revocar' })) return;
                try {
                    const res = await fetch('/api/keys', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
                    if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'No se pudo revocar'); }
                    location.reload();
                } catch (err: any) { (window as any).cordToast?.(err.message || 'No se pudo revocar', 'error'); }
            });
        });

        const btnAi = document.getElementById('btnAiPrompt');
        if (btnAi) {
            btnAi.addEventListener('click', async () => {
                const prompt = `Eres un Desarrollador Backend Senior (experto en TypeScript, Node.js y frameworks modernos como Next.js).
Tu tarea es implementar la integración con la API REST de Flouvia Cord (un SaaS B2B) para mi aplicación.

== CONTEXTO TÉCNICO ==
- Base URL: https://cordhq.app/api/v1
- Autenticación: Header "Authorization: Bearer <TU_API_KEY>"
- Content-Type: application/json

== REQUERIMIENTO ==
Crea el código necesario para automatizar la creación de una cotización cuando un usuario realiza una acción en mi aplicación (por ejemplo, enviar un formulario B2B).
Debes estructurar el código siguiendo las mejores prácticas: separación de responsabilidades, manejo de errores de red (try/catch), y validación de variables de entorno. 
IMPORTANTE: Si estoy usando Next.js App Router, implementa esto como un Server Action (o Route Handler) para jamás exponer la API Key en el lado del cliente (browser).

== ESQUEMA DEL ENDPOINT (POST /cotizaciones) ==
El endpoint de Cord requiere este JSON de forma estricta:
{
  "send": boolean, // (Opcional) Si es true, la cotización se aprueba y se genera un link público inmediatamente. Si es false, se queda como borrador.
  "notas": string, // (Opcional) Campo de texto libre para uso interno o volcar detalles de un formulario.
  "cliente_id": string, // (Opcional) UUID del cliente si ya existe en el directorio de Cord.
  "items": [ // (OBLIGATORIO) Array con al menos 1 producto/servicio
    {
      "descripcion": string, // (Obligatorio) Nombre del concepto (ej. "Solicitud Cotización Web")
      "cantidad": number, // (Obligatorio) 
      "precio_unitario": number // (Obligatorio) Precio en la moneda base. Puedes mandar 0 si se negociará después por un vendedor.
    }
  ]
}

== SALIDA ESPERADA ==
- Escribe la función de integración (ej. \`src/actions/cord.ts\`).
- Incluye comentarios sobre cómo llamar a esta función de manera segura desde mi frontend.`;
                try {
                    await navigator.clipboard.writeText(prompt);
                    const original = btnAi.innerHTML;
                    btnAi.textContent = (btnAi as HTMLElement).dataset.i18nCopiado || '✓ Prompt copiado — Pégalo en ChatGPT o Cursor';
                    (btnAi as HTMLElement).style.color = '#6ee7b7';
                    setTimeout(() => { btnAi.innerHTML = original; (btnAi as HTMLElement).style.color = ''; }, 3500);
                } catch {}
            });
        }
    }

    // ── Actividad del API: refrescar sin recargar ──
    function initActivity() {
        const btn = document.getElementById('actRefresh');
        if (!btn) return;
        const i18nActualizar = btn.dataset.i18nActualizar || 'Actualizar';
        const i18nActualizando = btn.dataset.i18nActualizando || 'Actualizando…';
        btn.addEventListener('click', async () => {
            (btn as HTMLButtonElement).disabled = true; btn.textContent = i18nActualizando;
            try {
                const res = await fetch('/api/dev/activity');
                if (res.ok) {
                    const d = await res.json();
                    document.getElementById('actTotal')!.textContent = String(d.total24);
                    const errEl = document.getElementById('actErr')!;
                    errEl.textContent = String(d.errores24);
                    errEl.classList.toggle('bad', d.errores24 > 0);
                    document.getElementById('actLat')!.innerHTML = `${d.latProm}<em>ms</em>`;
                    renderActivity(d.recent);
                }
            } catch {}
            (btn as HTMLButtonElement).disabled = false; btn.textContent = i18nActualizar;
        });
    }
    function renderActivity(recent: any[]) {
        const list = document.getElementById('actList');
        if (!list) return;
        if (!recent.length) { list.innerHTML = `<p class="dev-empty">${list.dataset.i18nSinActividad || 'Sin actividad todavía. Cuando llames la API con una clave, las requests aparecerán aquí.'}</p>`; return; }
        const esc = (s: string) => String(s).replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c] || c));
        list.innerHTML = recent.map((r) => `
            <div class="act-row">
                <span class="act-m ${r.metodo.toLowerCase()}">${esc(r.metodo)}</span>
                <code class="act-path">${esc(r.ruta)}</code>
                <span class="act-status ${r.status >= 400 ? 'bad' : 'ok'}">${r.status}</span>
                <span class="act-lat">${r.ms != null ? r.ms + 'ms' : '—'}</span>
                <span class="act-when">${esc(r.cuando)}${r.mode === 'test' ? ' · test' : ''}</span>
            </div>`).join('');
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { initApi(); initActivity(); });
    else { initApi(); initActivity(); }
</script>
