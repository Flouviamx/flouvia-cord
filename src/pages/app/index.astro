    .chx-hbar-track { height: 8px; background: var(--chart-track); border-radius: 100px; overflow: hidden; }
    .chx-hbar-fill { height: 100%; border-radius: 100px; min-width: 4px; cursor: pointer; transition: width 0.7s var(--ease-spring), filter 0.2s, opacity 0.2s var(--ease-ios, ease); }
    .chx-hbar-fill:hover, .chx-hbar-fill:focus-visible { filter: brightness(1.15); outline: none; }
