    .dash-widget.is-dragging > .dash-card { box-shadow: 0 30px 60px -14px rgba(10,25,47,0.4); }
    /* Estilos del .widget-editbar (arrastrar/subir/bajar/tamaño/ocultar) viven en
       <style is:global> — se inyecta con set:html, así que nunca lleva data-astro-cid-*
