        <article class="dash-widget" data-widget="recientes" data-title={t(L, 'dash.w_recientes')} data-size-sm="2" data-size-lg="4" data-span="2">
            <Fragment set:html={EDITBAR} />
            <div class="dash-card">
                <div class="sec-head">
                    <h2 class="sec-title">{t(L, 'dash.recientes_titulo')}</h2>
                    <a href="/app/cotizaciones" class="sec-link">{t(L, 'dash.ver_todas')}</a>
                </div>
                <div class="quote-list">
                    {recientes.map((q) => (
                        <a href={`/app/cotizaciones/${q.id}`} class="quote-row">
                            <div class="qr-avatar">{q.clienteInicial}</div>
                            <div class="qr-info">
                                <span class="qr-folio">{q.folio}</span>
                                <span class="qr-client">{q.cliente}</span>
                            </div>
                            <span class="editorial qr-amount">{money(q.total ?? 0, 0)}</span>
                            <span class="status-pill" style={`color:${STATUS_META[q.status].color}; background:${STATUS_META[q.status].bg}`}>
                                {STATUS_META[q.status].label}
                            </span>
                        </a>
                    ))}
                </div>
            </div>
        </article>

        <article class="dash-widget" data-widget="actividad" data-title={t(L, 'dash.w_actividad')} data-size-sm="4" data-size-lg="4" data-span="4">
            <Fragment set:html={EDITBAR} />
            <div class="dash-card">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'dash.actividad_titulo')}</h2></div>
                <div class="feed">
                    {eventosFeed.map((e) => (
                        <a href={`/app/cotizaciones/${e.id}`} class="feed-item">
                            <span class="feed-dot" style={`background:${dotColor(e.tipo)}`}></span>
                            <div class="feed-body">
                                <span class="feed-text">{e.detalle}</span>
                                <span class="feed-meta">{e.folio} · {e.cuando}</span>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </article>

        <article class="dash-widget" data-widget="tareas" data-title={t(L, 'dash.w_tareas')} data-size-sm="4" data-size-lg="4" data-span="4">
            <Fragment set:html={EDITBAR} />
            <div class="dash-card tasks-card">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'dash.tareas_titulo')}</h2></div>
                <form class="task-add" id="taskAdd">
                    <input id="taskTitulo" class="task-input" placeholder={t(L, 'dash.tarea_ph')} autocomplete="off" required />
                    <input id="taskDue" class="task-date" type="date" aria-label={t(L, 'dash.tarea_fecha_limite')} />
                    <button class="task-btn" type="submit">{t(L, 'dash.agregar')}</button>
                </form>
                <div class="task-list" id="taskList">
                    {TAREAS.map((tarea) => (
                        <div class="task-row" data-id={tarea.id}>
                            <button class="task-check" data-done aria-label={t(L, 'dash.marcar_completada')}></button>
                            <div class="task-body">
                                <span class="task-title">{tarea.titulo}</span>
                                {(tarea.folio || tarea.due) && <span class="task-meta">{[tarea.folio, tarea.due].filter(Boolean).join(' · ')}</span>}
                            </div>
                            {tarea.vencida && <span class="task-overdue">{t(L, 'dash.vencida')}</span>}
                            <button class="task-del" data-del aria-label={t(L, 'dash.eliminar')}>×</button>
                        </div>
                    ))}
                    <p class="task-empty" id="taskEmpty" hidden={TAREAS.length > 0}>{t(L, 'dash.tareas_vacio')}</p>
                </div>
            </div>
        </article>

        <section class="dash-card widget-tray" id="widgetTray" hidden>
            <p class="widget-tray-title">{t(L, 'dash.widgets_ocultos')}</p>
            <div class="widget-tray-list" id="widgetTrayList"></div>
        </section>
    </div>
    <script is:inline>
        // Aplica orden/visibilidad/tamaño guardados ANTES del primer paint (sync, mitad del
        // parseo del HTML) — igual patrón que el anti-flash de tema/sidebar de AppLayout,
        // pero acotado a este contenedor porque el editor de widgets es propio del dashboard.
        (function () {
            try {
                var KEY = 'cord.dash.v1';
                var raw = JSON.parse(localStorage.getItem(KEY) || '{}');
                var order = Array.isArray(raw.order) ? raw.order : [];
                var hidden = Array.isArray(raw.hidden) ? raw.hidden : [];
                var sizes = raw.sizes && typeof raw.sizes === 'object' ? raw.sizes : {};
                var host = document.getElementById('dashWidgets');
                if (!host) return;
                var widgets = Array.prototype.slice.call(host.children).filter(function (w) { return w.dataset && w.dataset.widget; });
                var byId = {};
                widgets.forEach(function (w) { byId[w.dataset.widget] = w; });
                var finalOrder = order.filter(function (id) { return byId[id]; });
                widgets.forEach(function (w) { if (finalOrder.indexOf(w.dataset.widget) === -1) finalOrder.push(w.dataset.widget); });
                finalOrder.forEach(function (id) { host.appendChild(byId[id]); });
                hidden.forEach(function (id) { if (byId[id]) byId[id].hidden = true; });
                Object.keys(sizes).forEach(function (id) {
                    var w = byId[id];
                    if (!w) return;
                    var size = sizes[id] === 'lg' ? w.dataset.sizeLg : w.dataset.sizeSm;
                    if (size) w.dataset.span = size;
                });
            } catch (e) {}
        })();
    </script>

    {showTour && (
        <div id="demoTour" class="demo-tour-popover">
            <div class="demo-tour-inner">
                <span class="demo-tour-ico">✨</span>
                <div class="demo-tour-text">
                    <strong>{t(L, 'dash.tour_titulo')}</strong>
                    <p id="demoTourMsg">{t(L, 'dash.tour_msg_inicial')}</p>
                </div>
            </div>
        </div>
        <script define:vars={{ demoToken, tourMsgFinal: t(L, 'dash.tour_msg_final') }}>
            setTimeout(() => {
                const msg = document.getElementById('demoTourMsg');
                if (msg) msg.textContent = tourMsgFinal;

                // Simula al cliente abriendo el link público para disparar 'viewed'
                fetch('/q/' + demoToken).then(() => {
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                });
            }, 3500);
        </script>
        <style>
            .demo-tour-popover {
                position: fixed; bottom: 2rem; right: 2rem; z-index: 999;
                background: var(--color-bg); border: 1px solid var(--color-border);
                border-radius: 12px; padding: 16px 20px;
                box-shadow: 0 12px 30px rgba(0,0,0,0.12);
                animation: slideInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                max-width: 320px;
            }
            .demo-tour-inner { display: flex; gap: 14px; align-items: flex-start; }
            .demo-tour-ico { font-size: 1.5rem; line-height: 1; }
            .demo-tour-text strong { display: block; font-size: 0.95rem; font-weight: 600; color: var(--color-text); margin-bottom: 4px; }
            .demo-tour-text p { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; line-height: 1.4; }
            @keyframes slideInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        </style>
    )}
</AppLayout>

<style>
    /* ── Tarjeta Apple/Stripe compartida ── */
    .dash-card {
        background: var(--surface);
        border-radius: var(--card-radius);
        box-shadow: var(--card-shadow);
        padding: 1.5rem 1.7rem;
    }
    /* height:100% SOLO dentro del grid (para que dos tarjetas de la misma fila queden a la
       misma altura). ⚠️ NUNCA en `.dash-card` a secas: el hero es hijo directo de
       `.app-content`, que es flex item de `.app-main` (column, estirado a 100vh por
       `.app-shell`) — los navegadores tratan esa altura como DEFINIDA tras el layout, así
       que un `height:100%` ahí estira el hero a toda el área de contenido. */
    .dash-widget > .dash-card { height: 100%; }
    a.dash-card { display: block; text-decoration: none; transition: transform 0.3s var(--ease-spring), box-shadow 0.3s var(--ease-ios); }
    a.dash-card:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }

    .sec-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.1rem; }
    .sec-title { font-size: 0.98rem; font-weight: 600; letter-spacing: -0.01em; color: var(--color-text); margin: 0; }
    .sec-link { font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted); text-decoration: none; transition: color 0.2s; }
    .sec-link:hover { color: var(--color-blue-deep); }

    .chart-host { min-height: 160px; }
    .chart-host-tall { min-height: 220px; }

    /* ── Aviso de cobros ── */
    .cobros-nudge {
        display: flex; align-items: center; gap: 14px;
        padding: 1rem 1.3rem; margin-bottom: 1.4rem;
        background: var(--color-blue-deep); color: #fff;
        box-shadow: 0 2px 4px rgba(10,25,47,0.06), 0 20px 44px -18px rgba(10,25,47,0.35);
    }
    .cobros-nudge .cn-ico {
        flex-shrink: 0; width: 38px; height: 38px; border-radius: 11px;
        display: grid; place-items: center;
        background: rgba(255,255,255,0.1); color: #fff;
    }
    .cobros-nudge .cn-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .cobros-nudge .cn-text strong { font-size: 0.95rem; font-weight: 600; letter-spacing: -0.01em; }
    .cobros-nudge .cn-text span { font-size: 0.82rem; color: rgba(255,255,255,0.72); line-height: 1.4; }
    .cobros-nudge .cn-cta {
        flex-shrink: 0; margin-left: auto;
        background: #fff; color: var(--color-blue-deep);
        font-size: 0.85rem; font-weight: 600; text-decoration: none;
        padding: 9px 16px; border-radius: 999px;
        transition: transform 0.2s var(--ease-spring, ease), background 0.2s ease;
    }
    .cobros-nudge .cn-cta:hover { transform: scale(1.03); }
    .cobros-nudge .cn-cta:active { transform: scale(0.97); }
    .cobros-nudge .cn-close {
        flex-shrink: 0; width: 30px; height: 30px; border-radius: 8px;
        display: grid; place-items: center; cursor: pointer;
        background: transparent; border: none; color: rgba(255,255,255,0.6);
        transition: background 0.2s ease, color 0.2s ease;
    }
    .cobros-nudge .cn-close:hover { background: rgba(255,255,255,0.1); color: #fff; }
    @media (max-width: 640px) {
        .cobros-nudge { flex-wrap: wrap; }
        .cobros-nudge .cn-cta { margin-left: 0; width: 100%; text-align: center; order: 3; }
        .cobros-nudge .cn-close { position: absolute; }
    }

    /* ── Hero de dinero ── */
    /* ⚠️ z-index sobre el hero: AppLayout aplica `animation: app-fadein … both` a CADA hijo
       directo de `.app-content`, y su estado final (`transform: translateY(0)`) convierte a
       `.hero-rev` y a `#dashWidgets` en contextos de apilamiento hermanos. Con z-index auto
       pintan en orden del DOM → los widgets taparían el panel del selector de fechas, sin
       importar el z-index que tenga el panel (queda atrapado dentro del hero). Elevar el hero
       por encima del grid es lo que deja el panel visible; ambos siguen por debajo de la
       topbar sticky (z-index 50). */
    .hero-rev { padding: 1.7rem 1.9rem 1.4rem; margin-bottom: 1.4rem; position: relative; z-index: 20; }
    .hero-rev-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
    .hero-rev-metrics { display: inline-flex; gap: 4px; margin-bottom: 0.7rem; }
    .hero-metric-pill {
        appearance: none; border: none; background: transparent; cursor: pointer;
        font-family: var(--font-sans); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.2px;
        color: var(--color-text-muted); padding: 5px 11px; border-radius: 100px;
        transition: background 0.25s var(--ease-ios), color 0.25s var(--ease-ios);
    }
    .hero-metric-pill:hover { color: var(--color-text); }
    .hero-metric-pill.is-active { background: var(--color-bg-soft); color: var(--color-blue-deep); }
    .hero-rev-row { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; }
    .hero-rev-num { font-size: clamp(2.2rem, 4vw, 3rem); color: var(--color-blue-deep); line-height: 1; }
    .hero-rev-delta { display: inline-flex; align-items: center; gap: 4px; font-size: 0.86rem; font-weight: 700; padding: 3px 0; color: var(--color-ok); }
    .hero-rev-delta[hidden] { display: none; }
    .hero-rev-delta.is-down { color: var(--color-danger); }
    .hero-rev-delta-sub { font-weight: 500; color: var(--color-text-muted); margin-left: 2px; }
    .hero-rev-chart { position: relative; height: 240px; margin-top: 0.8rem; }
    .hero-rev-nota { margin: 0.5rem 0 0; font-size: 0.72rem; color: var(--color-text-muted); opacity: 0.85; }

    /* ══ Selector de rango estilo Shopify ══ */
    .dp-wrap { position: relative; flex-shrink: 0; }
    .dp-trigger {
        display: inline-flex; align-items: center; gap: 8px;
        appearance: none; font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600;
        color: var(--color-text); background: var(--color-bg-soft); border: 1px solid transparent;
        border-radius: 100px; padding: 8px 14px; cursor: pointer; transition: background 0.2s var(--ease-ios), border-color 0.2s;
    }
    .dp-trigger:hover { background: var(--row-hover); }
    .dp-trigger[aria-expanded="true"] { background: var(--surface); border-color: var(--color-blue-deep); box-shadow: 0 1px 3px rgba(10,25,47,0.1); }
    .dp-trigger svg:first-child { color: var(--color-text-muted); }
    .dp-trigger svg:last-child { color: var(--color-text-muted); transition: transform 0.2s; }
    .dp-trigger[aria-expanded="true"] svg:last-child { transform: rotate(180deg); }

    .dp-panel {
        position: absolute; top: calc(100% + 10px); right: 0; z-index: 30;
        display: flex; background: var(--surface); border-radius: 20px;
        box-shadow: 0 4px 16px rgba(10,25,47,0.1), 0 30px 70px -20px rgba(10,25,47,0.4);
        overflow: hidden; width: min(94vw, 660px);
    }
    .dp-panel[hidden] { display: none; }
    .dp-presets {
        display: flex; flex-direction: column; gap: 2px; padding: 1rem 0.7rem;
        width: 168px; flex-shrink: 0; border-right: 1px solid var(--color-border);
        max-height: 420px; overflow-y: auto;
    }
    .dp-preset-btn {
        appearance: none; border: none; background: transparent; text-align: left; cursor: pointer;
        font-family: var(--font-sans); font-size: 0.82rem; font-weight: 500; color: var(--color-text);
        padding: 8px 10px; border-radius: 9px; transition: background 0.15s var(--ease-ios);
    }
    .dp-preset-btn:hover { background: var(--row-hover); }
    .dp-preset-btn.is-active { background: var(--color-blue-deep); color: #fff; font-weight: 600; }
    .dp-preset-sep { height: 1px; background: var(--color-border); margin: 6px 4px; }

    .dp-main { flex: 1; display: flex; flex-direction: column; padding: 1rem 1.2rem; min-width: 0; }
    .dp-inputs { display: flex; align-items: center; gap: 10px; margin-bottom: 1rem; }
    .dp-input-field { flex: 1; display: flex; flex-direction: column; gap: 3px; }
    .dp-input-label { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: var(--color-text-muted); opacity: 0.75; }
    .dp-input-field input {
        font-family: var(--font-sans); font-size: 0.82rem; color: var(--color-text);
        background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: 9px;
        padding: 7px 10px; width: 100%;
    }
    .dp-input-arrow { color: var(--color-text-muted); flex-shrink: 0; margin-top: 14px; }
    .dp-cals { display: flex; gap: 1.6rem; }
    .dp-cal { flex: 1; min-width: 0; }
    .dp-cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
    .dp-cal-title { font-size: 0.82rem; font-weight: 600; color: var(--color-text); }
    .dp-cal-nav {
        appearance: none; border: none; background: var(--color-bg-soft); cursor: pointer;
        width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; color: var(--color-text);
        transition: background 0.15s;
    }
    .dp-cal-nav:hover { background: var(--row-hover); }
    .dp-cal-nav-spacer { width: 24px; }
    .dp-actions { display: flex; justify-content: flex-end; gap: 0.6rem; margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
    .dp-cancel {
        appearance: none; border: 1px solid var(--color-border); background: transparent; cursor: pointer;
        font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: var(--color-text);
        border-radius: 9px; padding: 8px 16px;
    }
    .dp-apply {
        appearance: none; border: none; cursor: pointer;
        font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff;
        background: var(--color-blue-deep); border-radius: 9px; padding: 8px 16px;
        transition: transform 0.2s var(--ease-spring);
    }
    .dp-apply:hover { transform: translateY(-1px); }

    @media (max-width: 720px) {
        .dp-panel { flex-direction: column; width: min(94vw, 340px); }
        .dp-presets { width: auto; flex-direction: row; flex-wrap: wrap; max-height: none; border-right: none; border-bottom: 1px solid var(--color-border); }
        .dp-preset-sep { display: none; }
        #dpCalRight { display: none; }
    }

    /* ── Botones "Personalizar / Listo / Restablecer" (topbar-actions) ── */
    .dash-edit-btn {
