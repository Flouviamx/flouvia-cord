    /* ══ Grid unitario de widgets ══ */
    /* `position: relative` = referencia del widget que se arrastra (va en `absolute`, NO en
       `fixed`: el `transform` de app-fadein en el ancestro lo anclaría a `.app-content`).
       `z-index: 1` lo deja explícitamente por debajo del hero (ver nota en `.hero-rev`). */
    #dashWidgets { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; position: relative; z-index: 1; }
    .dash-widget { position: relative; grid-column: span 1; }
    .dash-widget[data-span="1"] { grid-column: span 1; }
    .dash-widget[data-span="2"] { grid-column: span 2; }
    .dash-widget[data-span="4"] { grid-column: span 4; }
    .dash-widget[hidden] { display: none; }
    @media (max-width: 1199px) {
        .dash-widget { grid-column: 1 / -1 !important; }
    }
    .widget-tray { grid-column: 1 / -1; }
    .widget-tray[hidden] { display: none; }
    .widget-tray-title { font-size: 0.78rem; font-weight: 700; color: var(--color-text-muted); margin: 0 0 0.7rem; }

    /* ── Modo edición: wiggle + controles por widget (estilo iOS) ── */
    #dashWidgets[data-editing="1"] > .dash-widget:not(.is-dragging) > .dash-card {
        outline: 1.5px dashed var(--color-border); outline-offset: 3px;
    }
    #dashWidgets[data-editing="1"] > .dash-widget:not(.is-dragging) { cursor: grab; }
    #dashWidgets[data-editing="1"] > .dash-widget:not(.is-dragging) > .dash-card {
        animation: widget-wiggle 0.24s ease-in-out infinite;
    }
    #dashWidgets[data-editing="1"] > .dash-widget:nth-child(even):not(.is-dragging) > .dash-card { animation-delay: 0.05s; }
    #dashWidgets[data-editing="1"] > .dash-widget:nth-child(3n):not(.is-dragging) > .dash-card { animation-delay: 0.09s; }
    @keyframes widget-wiggle { 0%, 100% { transform: rotate(-0.45deg); } 50% { transform: rotate(0.45deg); } }
    @media (prefers-reduced-motion: reduce) {
        #dashWidgets[data-editing="1"] > .dash-widget > .dash-card { animation: none !important; }
    }
