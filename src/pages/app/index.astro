---
// Dashboard — pipeline, dinero, actividad reciente. Datos reales (Neon).
import AppLayout from '../../layouts/AppLayout.astro';
import { getDashboard, getTareas, getCFO, getAnalytics, getOrg, getSerieDiaria, getCobranza, getMyMembership, STATUS_META, money } from '../../lib/queries';
import { memberCan } from '../../lib/permissions';
import { currentLocale } from '../../lib/context';
import { t } from '../../i18n/app';
import DateRangePicker from '../../components/app/DateRangePicker.astro';
import WidgetGrid from '../../components/app/WidgetGrid.astro';

const L = currentLocale();
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const ME = await getMyMembership();
const canAnalytics = memberCan(ME, 'analitica');
const canCobranza = memberCan(ME, 'cobranza');
const EMPTY_CFO = { kpis: { dso: 0, concentracion: 0, totalEsperado: 0, totalPipeline: 0 }, semanas: [], silenciadas: [] } as any;
const EMPTY_ANALYTICS = { funnel: { enviadas: 0, vistas: 0, aprobadas: 0, pagadas: 0 }, kpis: { ticketPromedio: 0 }, margen: { pct: 0 }, clientes: [], productos: [] } as any;
const EMPTY_COBRANZA = { aging: [] } as any;
const [dash, TAREAS, CFO, ANALYTICS, ORG, SERIE, COBRANZA] = await Promise.all([
    getDashboard(), getTareas(), canAnalytics ? getCFO() : EMPTY_CFO, canAnalytics ? getAnalytics() : EMPTY_ANALYTICS,
    getOrg(), getSerieDiaria(), canCobranza ? getCobranza() : EMPTY_COBRANZA,
]);
// Aviso único para invitar a configurar cobros a quien aún no conecta su cuenta
// (existentes o nuevos). Se oculta permanentemente al conectar (server-side) o al
// descartarlo (localStorage, ver script abajo).
const mostrarNudgeCobros = !ORG.stripeAccountId;
const { quotes: COTIZACIONES, porCerrar, tasaCierre, abiertas, feed: eventosFeed } = dash;
const recientes = COTIZACIONES.slice(0, 5);
const seguimiento = dash.seguimiento;

// ── Datos para los widgets nuevos (Salud / Flujo / Silenciadas / Mix) ──
const { dso, concentracion, totalEsperado: ingresoEsperado, totalPipeline } = CFO.kpis;
const semanas = CFO.semanas;
const silenciadas = CFO.silenciadas.slice(0, 5);
const dsoTone = dso <= 30 ? 'ok' : dso <= 60 ? 'warn' : 'danger';
const concTone = concentracion >= 70 ? 'danger' : concentracion >= 40 ? 'warn' : 'ok';
const margenPct = Math.round(ANALYTICS.margen.pct);
const margenTone = margenPct < 10 ? 'ok' : margenPct < 25 ? 'warn' : 'danger';
const esperadoPct = totalPipeline > 0 ? Math.round((ingresoEsperado / totalPipeline) * 100) : 0;
const clientesTasa = [...ANALYTICS.clientes].filter(c => c.cotizaciones > 0).sort((a, b) => b.tasa - a.tasa).slice(0, 5);
const topProductos = ANALYTICS.productos.slice(0, 5);

const dotColor = (tipo: string) =>
    tipo === 'approved' || tipo === 'paid' ? '#10b981'
    : tipo === 'viewed' ? '#7c3aed'
    : tipo === 'sent' ? '#3b82f6'
    : tipo === 'rejected' ? '#ef4444'
    : '#cbd5e1';

// ── Hero de dinero (arriba de todo) ──
// Fuente única: getSerieDiaria() — 365 días, 3 métricas por día (cotizado/cerrado/
// cobrado), huecos ya rellenados a 0. El selector de fechas vive 100% en el cliente
// (recorta sobre los mismos 365 puntos ya cargados, sin ir al servidor para hero/
// tendencia); aquí solo calculamos el estado INICIAL ("Todo") para el primer render.
const diasSerie = SERIE.dias;
// Default del dashboard: últimos 30 días (no "Todo") — con 365 días de historia casi
// siempre vacíos salvo los más recientes, "Todo" dibuja una línea plana seguida de picos
// aplastados contra el borde derecho. 30 días es el default estándar de este tipo de
// dashboard (Stripe/Shopify) y coincide con el rango que aplica el script del cliente.
const heroTotal = diasSerie.slice(-30).reduce((s, d) => s + d.cerrado, 0);

// ── Ciclo de venta: embudo + pipeline por estado (segmentado) ──
const funnelSteps = [
    { label: t(L, 'dash.funnel_enviadas'), value: ANALYTICS.funnel.enviadas },
    { label: t(L, 'dash.funnel_vistas'), value: ANALYTICS.funnel.vistas },
    { label: t(L, 'dash.funnel_aprobadas'), value: ANALYTICS.funnel.aprobadas },
    { label: t(L, 'dash.funnel_pagadas'), value: ANALYTICS.funnel.pagadas },
];
const pipelineSegments = (['draft', 'sent', 'viewed', 'approved', 'paid'] as const).map((st) => {
    const stat = dash.statusStats.find((row) => row.status === st);
    return { key: st, label: `${STATUS_META[st].label} · ${stat?.n ?? 0}`, value: stat?.total ?? 0, color: STATUS_META[st].color };
});

// Nota: la tendencia mensual se deriva 100% en el cliente de la MISMA serie diaria de
// 365 días del hero (agregada por día/semana/mes según el ancho del rango elegido).

// ── Estado "Todo" (default) del embudo/rankings: exactamente lo que ANALYTICS ya trae,
// embebido para que el rango por defecto no dispare ningún fetch al cargar la página. ──
const rangoTodoFunnel = ANALYTICS.funnel;
const rangoTodoClientes = ANALYTICS.clientes;
const rangoTodoProductos = ANALYTICS.productos;

// ── Onboarding / Aha-moment Tour ──
const isDemo = dash.totalQuotes === 1 && String(COTIZACIONES[0]?.notas || '').includes('"is_demo": true');
const demoToken = isDemo ? COTIZACIONES[0].token : null;
const showTour = isDemo && COTIZACIONES[0].status === 'sent';

---

<AppLayout title="Dashboard — Cord" page="dashboard" heading={t(L, 'dash.heading')}>
    <Fragment slot="topbar-actions">
        <button type="button" class="dash-edit-btn" id="dashEditBtn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18M3 9v10a2 2 0 0 0 2 2h4m10-12v10a2 2 0 0 1-2 2H9"/></svg>
            {t(L, 'dash.personalizar')}
        </button>
        <button type="button" class="dash-edit-btn dash-edit-reset" id="dashResetBtn" hidden>{t(L, 'dash.restablecer')}</button>
        <button type="button" class="dash-edit-btn dash-edit-done" id="dashDoneBtn" hidden>{t(L, 'dash.listo')}</button>
    </Fragment>
    {mostrarNudgeCobros && (
        <div class="dash-card cobros-nudge" id="cobrosNudge" style="display:none">
            <div class="cn-ico">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2.5" fill="currentColor" fill-opacity="0.12"/><path d="M2 10h20"/></svg>
            </div>
            <div class="cn-text">
                <strong>{t(L, 'dash.nudge_titulo')}</strong>
                <span>{t(L, 'dash.nudge_desc')}</span>
            </div>
            <a class="cn-cta" href="/app/ajustes/cobros">{t(L, 'dash.nudge_cta')}</a>
            <button type="button" class="cn-close" id="cobrosNudgeClose" aria-label={t(L, 'dash.nudge_descartar')}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>
        <script is:inline>
            (function () {
                var el = document.getElementById('cobrosNudge');
                if (!el) return;
                if (localStorage.getItem('cord.cobros.nudge.dismissed') === '1') return;
                el.style.display = 'flex';
                var btn = document.getElementById('cobrosNudgeClose');
                if (btn) btn.addEventListener('click', function () {
                    localStorage.setItem('cord.cobros.nudge.dismissed', '1');
                    el.style.display = 'none';
                });
            })();
        </script>
    )}

    <!-- ═══ HERO — dinero (lo primero que se ve) ═══ -->
    <section class="dash-card hero-rev">
        <div class="hero-rev-top">
            <div class="hero-rev-main">
                <div class="hero-rev-metrics" role="tablist" aria-label={t(L, 'dash.hero_titulo')}>
                    <button type="button" class="hero-metric-pill is-active" data-metric="cerrado">{t(L, 'dash.hero_metric_cerrado')}</button>
                    <button type="button" class="hero-metric-pill" data-metric="cobrado">{t(L, 'dash.hero_metric_cobrado')}</button>
                    <button type="button" class="hero-metric-pill" data-metric="cotizado">{t(L, 'dash.hero_metric_cotizado')}</button>
                </div>
                <div class="hero-rev-row">
                    <span class="editorial hero-rev-num" id="heroNum" data-countup={heroTotal.toFixed(2)}>{money(heroTotal)}</span>
                    <span class="hero-rev-delta" id="heroDelta" hidden>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
                        <span id="heroDeltaVal">0%</span>
                        <span class="hero-rev-delta-sub">{t(L, 'dash.hero_vs_periodo')}</span>
                    </span>
                </div>
            </div>

            <DateRangePicker minISO={diasSerie[0]?.fecha ?? new Date().toISOString().slice(0, 10)} maxISO={diasSerie[diasSerie.length - 1]?.fecha ?? new Date().toISOString().slice(0, 10)} initialKey="30" storageKey="cord.dash.range.v1" />
        </div>
        <p class="hero-rev-nota">{t(L, 'dash.rango_nota')}</p>
        <div class="hero-rev-chart" id="heroChart"
            data-empty-msg={t(L, 'dash.sin_datos_rango')}
            data-points={JSON.stringify(diasSerie)}
            data-funnel-todo={JSON.stringify(rangoTodoFunnel)}
            data-clientes-todo={JSON.stringify(rangoTodoClientes)}
            data-productos-todo={JSON.stringify(rangoTodoProductos)}
        ></div>
    </section>

    <!--
        Widgets reordenables/ocultables/redimensionables — CADA TARJETA es unitaria (no por
        bloque). El hero de arriba queda SIEMPRE fijo, fuera de este contenedor. El orden y
        tamaño reales se aplican con un <script is:inline> justo después de cerrar este div:
        corre en medio del parseo del HTML, antes del primer paint, para que no haya flash
        del layout por defecto seguido de un salto al guardado.
    -->
    <WidgetGrid
        id="dashWidgets"
        storageKey="cord.dash.v1"
        editButtonId="dashEditBtn"
        doneButtonId="dashDoneBtn"
        resetButtonId="dashResetBtn"
        trayTitle={t(L, 'dash.widgets_ocultos')}
        resetConfirm={t(L, 'dash.confirmar_restablecer')}
        labels={{
            drag: t(L, 'dash.widget_arrastrar'), up: t(L, 'dash.widget_subir'),
            down: t(L, 'dash.widget_bajar'), resize: t(L, 'dash.widget_tamano'),
            remove: t(L, 'dash.widget_ocultar'),
        }}
    >

        <article class="dash-widget" data-widget="kpi-por-cerrar" data-title={t(L, 'dash.w_kpi_por_cerrar')} data-size-sm="1" data-size-lg="2" data-span="1">
            <div class="dash-card kpi-card">
                <span class="kpi-label">{t(L, 'dash.kpi_por_cerrar')}</span>
                <span class="editorial kpi-num" data-countup={porCerrar.toFixed(2)}>{money(porCerrar)}</span>
                <span class="kpi-sub">{tf('dash.kpi_cotizaciones_activas', { n: String(abiertas) })}</span>
                <div class="kpi-spark" id="kpiSpark" data-values={JSON.stringify(diasSerie.slice(-14).map(d => d.cotizado))}></div>
            </div>
        </article>

        <article class="dash-widget" data-widget="kpi-tasa" data-title={t(L, 'dash.w_kpi_tasa')} data-size-sm="1" data-size-lg="2" data-span="1" hidden={!canAnalytics}>
            <div class="dash-card kpi-card kpi-card-gauge">
                <span class="kpi-label">{t(L, 'dash.kpi_tasa_cierre')}</span>
                <div class="kpi-gauge" id="kpiTasaGauge" data-value={tasaCierre} data-tone={tasaCierre >= 40 ? 'ok' : tasaCierre >= 20 ? 'warn' : 'danger'}></div>
                <span class="kpi-sub">{t(L, 'dash.kpi_ultimos_90d')}</span>
            </div>
        </article>

        <article class="dash-widget" data-widget="kpi-ticket" data-title={t(L, 'dash.w_kpi_ticket')} data-size-sm="1" data-size-lg="2" data-span="1" hidden={!canAnalytics}>
            <div class="dash-card kpi-card">
                <span class="kpi-label">{t(L, 'dash.kpi_ticket_promedio')}</span>
                <span class="editorial kpi-num">{money(ANALYTICS.kpis.ticketPromedio, 0)}</span>
                <span class="kpi-sub">{t(L, 'dash.kpi_ticket_sub')}</span>
            </div>
        </article>

        <article class="dash-widget" data-widget="kpi-seguimiento" data-title={t(L, 'dash.w_kpi_seguimiento')} data-size-sm="1" data-size-lg="2" data-span="1">
            <a class="dash-card kpi-card kpi-link" href="/app/cotizaciones">
                <span class="kpi-label">{t(L, 'dash.kpi_por_seguimiento')}</span>
                <span class:list={['editorial', 'kpi-num', { 'kpi-warn': seguimiento > 0 }]}>{seguimiento}</span>
                <span class="kpi-sub">{seguimiento === 1 ? t(L, 'dash.kpi_vista_singular') : t(L, 'dash.kpi_vista_plural')}</span>
            </a>
        </article>

        <article class="dash-widget" data-widget="funnel" data-title={t(L, 'dash.w_funnel')} data-size-sm="2" data-size-lg="4" data-span="2" hidden={!canAnalytics}>
            <div class="dash-card">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'dash.funnel_titulo')}</h2></div>
                <div class="chart-host" id="funnelChart" data-steps={JSON.stringify(funnelSteps)}
                    data-labels={JSON.stringify({
                        enviadas: t(L, 'dash.funnel_enviadas'), vistas: t(L, 'dash.funnel_vistas'),
                        aprobadas: t(L, 'dash.funnel_aprobadas'), pagadas: t(L, 'dash.funnel_pagadas'),
                    })}
                ></div>
            </div>
        </article>

        <article class="dash-widget" data-widget="pipeline" data-title={t(L, 'dash.w_pipeline')} data-size-sm="2" data-size-lg="4" data-span="2" hidden={!canAnalytics}>
            <div class="dash-card">
                <div class="sec-head">
                    <h2 class="sec-title">{t(L, 'dash.pipeline_titulo')}</h2>
                    <a href="/app/cotizaciones" class="sec-link">{t(L, 'dash.ver_todas')}</a>
                </div>
                <div class="chart-host" id="pipeSegChart" data-segments={JSON.stringify(pipelineSegments)}></div>
            </div>
        </article>

        <article class="dash-widget" data-widget="tendencia" data-title={t(L, 'dash.w_tendencia')} data-size-sm="4" data-size-lg="4" data-span="4" hidden={!canAnalytics}>
            <div class="dash-card">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'dash.tendencia_titulo')}</h2></div>
                <div class="chart-host chart-host-tall" id="tendenciaChart"
                    data-lbl-cotizado={t(L, 'dash.tendencia_cotizado')} data-lbl-cerrado={t(L, 'dash.tendencia_cerrado')}
                ></div>
            </div>
        </article>

        <article class="dash-widget" data-widget="aging" data-title={t(L, 'dash.w_aging')} data-size-sm="2" data-size-lg="4" data-span="2" hidden={!canCobranza}>
            <div class="dash-card">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'dash.aging_titulo')}</h2></div>
                <div class="chart-host" id="agingChart" data-slices={JSON.stringify(COBRANZA.aging.map(a => ({ key: a.key, label: a.label, value: a.monto, color: a.color })))}></div>
            </div>
        </article>

        <article class="dash-widget" data-widget="flujo" data-title={t(L, 'dash.w_flujo')} data-size-sm="2" data-size-lg="4" data-span="2" hidden={!canAnalytics}>
            <div class="dash-card">
                <div class="sec-head">
                    <h2 class="sec-title">{t(L, 'dash.flujo_titulo')}</h2>
                    <a href="/app/informes?r=flujo" class="sec-link">{t(L, 'dash.tesoreria')}</a>
                </div>
                <div class="chart-host chart-host-tall" id="flowChart"
                    data-items={JSON.stringify(semanas.map((s) => ({ label: s.label, value: s.total, sub: s.n > 0 ? tf('dash.n_cot', { n: String(s.n) }) : '' })))}
                ></div>
            </div>
        </article>

        <article class="dash-widget" data-widget="salud" data-title={t(L, 'dash.w_salud')} data-size-sm="4" data-size-lg="4" data-span="4" hidden={!canAnalytics}>
            <div class="dash-card">
                <div class="sec-head">
                    <h2 class="sec-title">{t(L, 'dash.salud_titulo')}</h2>
                    <a href="/app/informes?r=finanzas" class="sec-link">{t(L, 'dash.ver_cfo')}</a>
                </div>
                <div class="health-grid">
                    <div class="health-cell">
                        <div class="health-gauge" id="gaugeDso" data-value={Math.min(dso, 90)} data-max="90" data-tone={dsoTone} data-suffix="d"></div>
                        <span class="health-label">{t(L, 'dash.dso_label')}</span>
                        <span class="health-sub"><span class:list={['health-dot', `h-${dsoTone}`]}></span>{dsoTone === 'ok' ? t(L, 'dash.dso_ok') : dsoTone === 'warn' ? t(L, 'dash.dso_warn') : t(L, 'dash.dso_danger')}</span>
                    </div>
                    <div class="health-cell">
                        <div class="health-gauge" id="gaugeConc" data-value={concentracion} data-max="100" data-tone={concTone} data-suffix="%"></div>
                        <span class="health-label">{t(L, 'dash.conc_label')}</span>
                        <span class="health-sub"><span class:list={['health-dot', `h-${concTone}`]}></span>{concentracion >= 70 ? t(L, 'dash.conc_danger') : concentracion >= 40 ? t(L, 'dash.conc_warn') : t(L, 'dash.conc_ok')}</span>
                    </div>
                    <div class="health-cell">
                        <div class="health-gauge" id="gaugeMargen" data-value={margenPct} data-max="50" data-tone={margenTone} data-suffix="%"></div>
                        <span class="health-label">{t(L, 'dash.margen_label')}</span>
                        <span class="health-sub">{t(L, 'dash.margen_sub')}</span>
                    </div>
                    <div class="health-cell">
                        <div class="health-gauge" id="gaugeEsperado" data-value={esperadoPct} data-max="100" data-tone="neutral" data-suffix="%"></div>
                        <span class="health-label">{t(L, 'dash.ingreso_esperado_label')}</span>
                        <span class="health-sub">{tf('dash.de_pipeline', { monto: money(totalPipeline, 0) })}</span>
                    </div>
                </div>
            </div>
        </article>

        <article class="dash-widget" data-widget="rank-clientes" data-title={t(L, 'dash.w_rank_clientes')} data-size-sm="2" data-size-lg="4" data-span="2" hidden={!canAnalytics}>
            <div class="dash-card">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'dash.rank_clientes_titulo')}</h2></div>
                {clientesTasa.length > 0
                    ? <div class="chart-host" id="rankClientesChart" data-items={JSON.stringify(clientesTasa.map(c => ({ label: c.empresa, value: c.tasa })))} data-format="pct"></div>
                    : <p class="rank-empty">{t(L, 'dash.rank_sin_historial')}</p>}
            </div>
        </article>

        <article class="dash-widget" data-widget="rank-productos" data-title={t(L, 'dash.w_rank_productos')} data-size-sm="2" data-size-lg="4" data-span="2" hidden={!canAnalytics}>
            <div class="dash-card">
                <div class="sec-head"><h2 class="sec-title">{t(L, 'dash.rank_productos_titulo')}</h2></div>
                {topProductos.length > 0
                    ? <div class="chart-host" id="rankProductosChart" data-items={JSON.stringify(topProductos.map(p => ({ label: p.nombre, value: p.importe })))} data-format="money" data-color="ok"></div>
                    : <p class="rank-empty">{t(L, 'dash.rank_sin_productos')}</p>}
            </div>
        </article>

        <article class="dash-widget" data-widget="seguimiento-lista" data-title={t(L, 'dash.w_seguimiento_lista')} data-size-sm="2" data-size-lg="4" data-span="2">
            <div class="dash-card">
                <div class="sec-head">
                    <h2 class="sec-title">{t(L, 'dash.seguimiento_titulo')}</h2>
                    {silenciadas.length > 0 && <span class="silence-count">{CFO.kpis.nSilenciadas}</span>}
                </div>
                {silenciadas.length > 0 ? (
                    <div class="silence-list">
                        {silenciadas.map((s) => (
                            <a href={`/app/cotizaciones/${s.id}`} class="silence-row">
                                <div class="silence-info">
                                    <span class="silence-folio">{s.folio}</span>
                                    <span class="silence-client">{s.empresa}</span>
                                </div>
                                <span class="silence-days">{tf('dash.sin_respuesta', { n: String(s.dias) })}</span>
                                <span class="editorial silence-total">{money(s.total, 0)}</span>
                                <span class="silence-go">→</span>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="silence-empty">
                        <span class="silence-empty-ico">✓</span>
                        <p>{t(L, 'dash.sin_silenciadas')}</p>
                    </div>
                )}
            </div>
        </article>

        <article class="dash-widget" data-widget="recientes" data-title={t(L, 'dash.w_recientes')} data-size-sm="2" data-size-lg="4" data-span="2">
            <div class="dash-card">
                <div class="sec-head">
                    <h2 class="sec-title">{t(L, 'dash.recientes_titulo')}</h2>
                    <a href="/app/cotizaciones" class="sec-link">{t(L, 'dash.ver_todas')}</a>
                </div>
                <div class="quote-list">
                    {recientes.map((q) => (
                        <a href={`/app/cotizaciones/${q.id}`} class="quote-row">
                            <div class="qr-avatar">{q.clienteInicial}</div>
                            <div class="qr-info">
                                <span class="qr-folio">{q.folio}</span>
                                <span class="qr-client">{q.cliente}</span>
                            </div>
                            <span class="editorial qr-amount">{money(q.total ?? 0, 0)}</span>
                            <span class="status-pill" style={`color:${STATUS_META[q.status].color}; background:${STATUS_META[q.status].bg}`}>
                                {STATUS_META[q.status].label}
                            </span>
                        </a>
                    ))}
