<script>
    import {
        mountLineChart, mountComboChart, mountBarChart, mountHBarChart,
        mountFunnel, mountDonut, mountSegBar, mountSparkline, mountGauge, onVisible,
    } from '../../lib/chart';
    import type { ChartHandle, LineChartHandle } from '../../lib/chart';

    const localeIntl = document.documentElement.lang === 'en' ? 'en-US' : 'es-MX';
    const moneyFmt = (n: number) => '$' + new Intl.NumberFormat(localeIntl, { maximumFractionDigits: 0 }).format(n);
    const moneyFmtFull = (n: number) => '$' + new Intl.NumberFormat(localeIntl, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
    const dateFmt = (iso: string) => {
        const d = new Date(iso + 'T00:00:00Z');
        return new Intl.DateTimeFormat(localeIntl, { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(d);
    };
    const monthFmt = (iso: string) => {
        const d = new Date(iso + 'T00:00:00Z');
        return new Intl.DateTimeFormat(localeIntl, { month: 'short', timeZone: 'UTC' }).format(d);
    };

    type Dia = { fecha: string; cotizado: number; cerrado: number; cobrado: number };
    type Range = { desde: string; hasta: string; key: string };

    // dias (365 puntos) es la ÚNICA fuente para hero Y tendencia — se parsea una vez aquí y
    // ambos widgets leen del mismo array, nunca de datos duplicados en el DOM.
    const heroEl = document.getElementById('heroChart');
    let dias: Dia[] = [];
    if (heroEl) { try { dias = JSON.parse(heroEl.dataset.points || '[]'); } catch { dias = []; } }
    const emptyMsg = heroEl?.dataset.emptyMsg || '';
    const primeraFecha = dias[0]?.fecha ?? '';
    const ultimaFecha = dias[dias.length - 1]?.fecha ?? '';

    const addDaysISO = (iso: string, n: number) => {
        const d = new Date(iso + 'T00:00:00Z');
        d.setUTCDate(d.getUTCDate() + n);
        return d.toISOString().slice(0, 10);
    };
    const spanDays = (desde: string, hasta: string) => {
        const a = new Date(desde + 'T00:00:00Z').getTime(), b = new Date(hasta + 'T00:00:00Z').getTime();
        return Math.round((b - a) / 86400000) + 1;
    };
    const clamp = (iso: string) => (iso < primeraFecha ? primeraFecha : iso > ultimaFecha ? ultimaFecha : iso);

    function rangeFor(key: string, customDesde?: string, customHasta?: string): Range {
        if (key === 'todo') return { desde: primeraFecha, hasta: ultimaFecha, key };
        if (key === 'custom' && customDesde && customHasta) return { desde: clamp(customDesde), hasta: clamp(customHasta), key };
        const n = parseInt(key, 10) || 30;
        return { desde: clamp(addDaysISO(ultimaFecha, -(n - 1))), hasta: ultimaFecha, key };
    }
    function compareRangeFor(r: Range): Range | null {
        if (r.key === 'todo') return null; // "Todo" ya es el histórico completo — no hay periodo "anterior"
        const n = spanDays(r.desde, r.hasta);
        const hasta = addDaysISO(r.desde, -1);
        const desde = addDaysISO(hasta, -(n - 1));
        if (desde < primeraFecha) return null; // sin suficiente historia detrás
        return { desde, hasta, key: 'compare' };
    }
    const sliceDias = (r: Range) => dias.filter((d) => d.fecha >= r.desde && d.fecha <= r.hasta);

    // ── Agregación adaptativa de la tendencia: día / semana / mes según el ancho del rango
    // elegido — un rango de 14 días con 6 barras mensuales sería absurdo. ──
    function aggregateTendencia(rows: Dia[]) {
        const n = rows.length;
        const bucketOf = (fecha: string) => {
            if (n <= 16) return fecha; // por día
            if (n <= 70) { // por semana (lunes de esa semana, UTC)
                const d = new Date(fecha + 'T00:00:00Z');
                const day = d.getUTCDay() || 7;
                d.setUTCDate(d.getUTCDate() - (day - 1));
                return d.toISOString().slice(0, 10);
            }
            return fecha.slice(0, 7); // por mes 'YYYY-MM'
        };
        const map = new Map<string, { cotizado: number; cerrado: number; first: string }>();
        rows.forEach((d) => {
            const key = bucketOf(d.fecha);
            const cur = map.get(key) ?? { cotizado: 0, cerrado: 0, first: d.fecha };
            cur.cotizado += d.cotizado; cur.cerrado += d.cerrado;
            map.set(key, cur);
        });
        const keys = [...map.keys()].sort();
        const labelFor = (key: string) => (n <= 16 ? dateFmt(key) : n <= 70 ? dateFmt(key) : monthFmt(key + '-01'));
        return {
            labels: keys.map(labelFor),
            cotizado: keys.map((k) => map.get(k)!.cotizado),
            cerrado: keys.map((k) => map.get(k)!.cerrado),
        };
    }

    // ── Hero ──
    let heroChart: LineChartHandle | null = null;
    let metric: 'cerrado' | 'cobrado' | 'cotizado' = 'cerrado';
    if (heroEl && dias.length) {
        heroChart = mountLineChart(heroEl, {
            points: [], comparePoints: [], height: 240,
            formatY: moneyFmtFull, formatYAxis: moneyFmt, formatX: dateFmt,
            valueLabel: '', compareLabel: '', emptyMessage: emptyMsg,
        });
    }
    const numEl = document.getElementById('heroNum');
    const deltaEl = document.getElementById('heroDelta');
    const deltaValEl = document.getElementById('heroDeltaVal');

    function refreshHero(r: Range) {
        if (!heroChart) return;
        const main = sliceDias(r).map((d) => ({ x: d.fecha, y: d[metric] }));
        const cmpRange = compareRangeFor(r);
        const cmp = cmpRange ? sliceDias(cmpRange).map((d) => ({ x: d.fecha, y: d[metric] })) : [];
        heroChart.setPoints(main, cmp);
        const total = main.reduce((s, p) => s + p.y, 0);
        const prevTotal = cmp.reduce((s, p) => s + p.y, 0);
        if (numEl) numEl.textContent = moneyFmtFull(total);
        const hasCompare = !!cmpRange && (total > 0 || prevTotal > 0);
        if (deltaEl) {
            if (!hasCompare) { deltaEl.hidden = true; }
            else {
                deltaEl.hidden = false;
                const delta = prevTotal > 0 ? Math.round(((total - prevTotal) / prevTotal) * 100) : 100;
                deltaEl.classList.toggle('is-down', delta < 0);
                const svgPath = deltaEl.querySelector('svg path');
                if (svgPath) svgPath.setAttribute('d', delta >= 0 ? 'M12 19V5M5 12l7-7 7 7' : 'M12 5v14M19 12l-7 7-7-7');
                if (deltaValEl) deltaValEl.textContent = `${Math.abs(delta)}%`;
            }
        }
    }

    // ── Tendencia mensual — se remonta (destroy+mount) en cada cambio de rango ──
    const tendenciaEl = document.getElementById('tendenciaChart');
    let tendenciaHandle: ChartHandle | null = null;
    const lblCotizado = tendenciaEl?.dataset.lblCotizado || '';
    const lblCerrado = tendenciaEl?.dataset.lblCerrado || '';
    function refreshTendencia(r: Range) {
        if (!tendenciaEl) return;
        tendenciaHandle?.destroy();
        const agg = aggregateTendencia(sliceDias(r));
        tendenciaHandle = mountComboChart(tendenciaEl, {
            labels: agg.labels, barValues: agg.cotizado, lineValues: agg.cerrado,
            barLabel: lblCotizado, lineLabel: lblCerrado,
            formatY: moneyFmt, formatYAxis: moneyFmt, height: 220, emptyMessage: emptyMsg,
        });
    }

    // ── Embudo + rankings — "Todo" usa los datos ya embebidos (cero fetch); cualquier otro
    // rango llama a /api/dashboard/rango una sola vez y remonta los 3 charts. ──
    const funnelEl = document.getElementById('funnelChart');
    const rankClientesEl = document.getElementById('rankClientesChart');
    const rankProductosEl = document.getElementById('rankProductosChart');
    let funnelHandle: ChartHandle | null = null, rankClientesHandle: ChartHandle | null = null, rankProductosHandle: ChartHandle | null = null;
    const funnelLabels = (() => { try { return JSON.parse(funnelEl?.dataset.labels || '{}'); } catch { return {}; } })();
    const todoData = {
        funnel: (() => { try { return JSON.parse(heroEl?.dataset.funnelTodo || '{}'); } catch { return {}; } })(),
        clientes: (() => { try { return JSON.parse(heroEl?.dataset.clientesTodo || '[]'); } catch { return []; } })(),
        productos: (() => { try { return JSON.parse(heroEl?.dataset.productosTodo || '[]'); } catch { return []; } })(),
    };
    const rangoCache = new Map<string, typeof todoData>();

    function buildFunnelSteps(funnel: any) {
        return [
            { label: funnelLabels.enviadas || 'Enviadas', value: funnel.enviadas || 0 },
            { label: funnelLabels.vistas || 'Vistas', value: funnel.vistas || 0 },
            { label: funnelLabels.aprobadas || 'Aprobadas', value: funnel.aprobadas || 0 },
            { label: funnelLabels.pagadas || 'Pagadas', value: funnel.pagadas || 0 },
        ];
    }
    function applyRangoData(data: typeof todoData) {
        if (funnelEl) {
            funnelHandle?.destroy();
            funnelHandle = mountFunnel(funnelEl, { steps: buildFunnelSteps(data.funnel), formatY: (v) => new Intl.NumberFormat(localeIntl).format(v), emptyMessage: emptyMsg });
        }
        if (rankClientesEl) {
            const items = (data.clientes || []).filter((c: any) => c.cotizaciones > 0).sort((a: any, b: any) => b.tasa - a.tasa).slice(0, 5)
                .map((c: any) => ({ label: c.empresa, value: c.tasa }));
            rankClientesHandle?.destroy();
            rankClientesHandle = mountHBarChart(rankClientesEl, { items, formatY: (v) => `${v}%`, emptyMessage: emptyMsg });
        }
        if (rankProductosEl) {
            const items = (data.productos || []).slice(0, 5).map((p: any) => ({ label: p.nombre, value: p.importe }));
            rankProductosHandle?.destroy();
            rankProductosHandle = mountHBarChart(rankProductosEl, { items, formatY: (v) => moneyFmt(v), color: 'var(--color-ok)', emptyMessage: emptyMsg });
        }
    }
    async function refreshRango(r: Range) {
        if (r.key === 'todo') { applyRangoData(todoData); return; }
        const cacheKey = `${r.desde}:${r.hasta}`;
        const cached = rangoCache.get(cacheKey);
        if (cached) { applyRangoData(cached); return; }
        try {
            const res = await fetch(`/api/dashboard/rango?desde=${r.desde}&hasta=${r.hasta}`);
            if (!res.ok) return;
            const data = await res.json();
            rangoCache.set(cacheKey, data);
            applyRangoData(data);
        } catch { /* deja el estado anterior visible si falla la red */ }
    }

    function applyRange(key: string, customDesde?: string, customHasta?: string) {
        const r = rangeFor(key, customDesde, customHasta);
        refreshHero(r);
        refreshTendencia(r);
        refreshRango(r);
    }
    // Default del dashboard: últimos 30 días (ver nota en el frontmatter de por qué NO es
    // "todo" — coincide con el heroTotal ya calculado server-side para el primer paint).
    applyRange('30');

    document.querySelectorAll<HTMLButtonElement>('.hero-metric-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.hero-metric-pill').forEach((b) => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            metric = (btn.dataset.metric as typeof metric) ?? 'cerrado';
            refreshHero(rangeFor(dpAppliedKeyRef.key, dpAppliedKeyRef.desde, dpAppliedKeyRef.hasta));
        });
    });

    // ═══ Selector de rango estilo Shopify: presets a la izquierda + 2 calendarios ═══
    const dpTrigger = document.getElementById('dpTrigger');
    const dpTriggerLabel = document.getElementById('dpTriggerLabel');
    const dpPanel = document.getElementById('dpPanel');
    const dpDesdeInput = document.getElementById('dpDesdeInput') as HTMLInputElement | null;
    const dpHastaInput = document.getElementById('dpHastaInput') as HTMLInputElement | null;
    const dpCalLeftGrid = document.querySelector('#dpCalLeft .dp-cal-grid');
    const dpCalRightGrid = document.querySelector('#dpCalRight .dp-cal-grid');
    const dpCalLeftTitle = document.querySelector('#dpCalLeft .dp-cal-title');
    const dpCalRightTitle = document.querySelector('#dpCalRight .dp-cal-title');
    const todoLabel = dpTrigger?.dataset.i18nTodo || 'Todo';

    type DP = { desde: string | null; hasta: string | null };
    let dpPending: DP = { desde: null, hasta: null };
    // Última selección APLICADA — es lo que alimenta el toggle de métrica del hero y lo
    // que el panel restaura si se vuelve a abrir sin cambiar nada. Arranca en "30" (mismo
    // default que applyRange('30') de arriba), no en "todo".
    let dpAppliedKeyRef: { key: string; desde: string; hasta: string } = rangeFor('30');
    let dpHover: string | null = null;
    let dpViewYear = 2000, dpViewMonth = 0;
    // Botones de día ACTIVOS ya renderizados (los deshabilitados no entran): permite repintar
    // la selección en hover sin volver a construir la grilla.
    let dayButtons: { iso: string; el: HTMLButtonElement }[] = [];

    function ymFromISO(iso: string) { const d = new Date(iso + 'T00:00:00Z'); return { y: d.getUTCFullYear(), m: d.getUTCMonth() }; }
    function setViewFromISO(iso: string) {
        const { y, m } = ymFromISO(iso);
        dpViewYear = y; dpViewMonth = m - 1;
        if (dpViewMonth < 0) { dpViewMonth = 11; dpViewYear--; }
    }
    if (ultimaFecha) setViewFromISO(ultimaFecha);

    const WEEKDAYS = (() => {
        const base = new Date(Date.UTC(2024, 0, 1)); // lunes
        return Array.from({ length: 7 }, (_, i) => {
            const d = new Date(base); d.setUTCDate(d.getUTCDate() + i);
            return new Intl.DateTimeFormat(localeIntl, { weekday: 'narrow', timeZone: 'UTC' }).format(d);
        });
    })();
    const inWindow = (iso: string) => iso >= primeraFecha && iso <= ultimaFecha;
    // ¿"iso" cae dentro de los 2 meses actualmente pintados (izq+der)? — determina si mover
    // el foco con flechas necesita recorrer la vista antes de re-renderizar.
    function isoInCurrentView(iso: string): boolean {
        const leftFirst = new Date(Date.UTC(dpViewYear, dpViewMonth, 1));
        let ry = dpViewYear, rm = dpViewMonth + 1;
        if (rm > 11) { rm = 0; ry++; }
        const rightLast = new Date(Date.UTC(ry, rm + 1, 0));
        const d = new Date(iso + 'T00:00:00Z');
        return d >= leftFirst && d <= rightLast;
    }
    // Navegación por teclado en la grilla (flechas + Enter): recorre al día vecino (clamped
    // a la ventana de 365 días), recorre el mes si hace falta, re-renderiza y regresa el
    // foco al botón real (nunca a una celda "out"/disabled del mes vecino).
    function focusDay(iso: string) {
        if (!isoInCurrentView(iso)) setViewFromISO(iso);
        renderCalendars();
        requestAnimationFrame(() => {
            const el = document.querySelector<HTMLButtonElement>(`.dp-day[data-iso="${iso}"]:not(:disabled)`);
            el?.focus();
        });
    }
    const fullDateFmt = (iso: string) => {
        const d = new Date(iso + 'T00:00:00Z');
        return new Intl.DateTimeFormat(localeIntl, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d);
    };
    const shortDateFmt = (iso: string) => {
        const d = new Date(iso + 'T00:00:00Z');
        return new Intl.DateTimeFormat(localeIntl, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d);
    };

    function renderMonth(gridEl: Element | null, titleEl: Element | null, year: number, month: number) {
        if (!gridEl || !titleEl) return;
        const first = new Date(Date.UTC(year, month, 1));
        // Solo la 1ª letra en mayúscula: `text-transform: capitalize` también subiría el
        // "de" de "julio de 2026" ("Julio De 2026"), que se ve mal.
        const titulo = new Intl.DateTimeFormat(localeIntl, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(first);
        titleEl.textContent = titulo.charAt(0).toUpperCase() + titulo.slice(1);
        const startDow = (first.getUTCDay() || 7) - 1; // 0 = lunes
        const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
        const daysInPrevMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
        gridEl.innerHTML = '';
        WEEKDAYS.forEach((w) => {
            const el = document.createElement('div'); el.className = 'dp-weekday'; el.textContent = w;
            gridEl.appendChild(el);
        });
        const cells: { iso: string; out: boolean }[] = [];
        for (let i = 0; i < startDow; i++) {
            const dayNum = daysInPrevMonth - startDow + 1 + i;
            cells.push({ iso: new Date(Date.UTC(year, month - 1, dayNum)).toISOString().slice(0, 10), out: true });
        }
        for (let d = 1; d <= daysInMonth; d++) cells.push({ iso: new Date(Date.UTC(year, month, d)).toISOString().slice(0, 10), out: false });
        while (cells.length < 42) {
            const last = new Date(cells[cells.length - 1].iso + 'T00:00:00Z');
            last.setUTCDate(last.getUTCDate() + 1);
            cells.push({ iso: last.toISOString().slice(0, 10), out: true });
        }
        cells.forEach((c) => {
            const btn = document.createElement('button');
            btn.type = 'button'; btn.className = 'dp-day';
            btn.dataset.iso = c.iso;
            btn.textContent = String(parseInt(c.iso.slice(8, 10), 10));
            const disabled = c.out || !inWindow(c.iso);
            if (disabled) { btn.classList.add(c.out ? 'is-out' : 'is-disabled'); btn.disabled = true; }
            if (c.iso === ultimaFecha) btn.classList.add('is-today');
            if (!disabled) {
                dayButtons.push({ iso: c.iso, el: btn });
                btn.addEventListener('click', () => onDayClick(c.iso));
                // ⚠️ El hover SOLO repinta clases (paintSelection), NUNCA re-renderiza la
                // grilla. Reconstruirla aquí destruía el botón bajo el cursor: un `click`
                // exige pointerdown y pointerup sobre el MISMO elemento, así que cualquier
                // micro-movimiento entre ambos cancelaba el clic y era imposible elegir un
                // día. (Además reconstruía 84 botones por cada píxel de movimiento.)
                btn.addEventListener('pointerenter', () => { dpHover = c.iso; paintSelection(); });
                btn.addEventListener('keydown', (e: KeyboardEvent) => {
                    if (e.key === 'ArrowRight') { e.preventDefault(); focusDay(clamp(addDaysISO(c.iso, 1))); }
                    else if (e.key === 'ArrowLeft') { e.preventDefault(); focusDay(clamp(addDaysISO(c.iso, -1))); }
                    else if (e.key === 'ArrowDown') { e.preventDefault(); focusDay(clamp(addDaysISO(c.iso, 7))); }
                    else if (e.key === 'ArrowUp') { e.preventDefault(); focusDay(clamp(addDaysISO(c.iso, -7))); }
                    else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onDayClick(c.iso); }
                });
            }
            gridEl.appendChild(btn);
        });
    }

    /** Repinta extremos/banda y los dos campos de fecha sobre los botones YA renderizados.
     *  Es la única función que corre en hover y al elegir un día — nada de rebuilds. */
    function paintSelection() {
        const d = dpPending.desde;
        // Mientras hay inicio sin fin, el día bajo el cursor previsualiza el fin.
        const h = dpPending.hasta ?? (d && dpHover ? dpHover : null);
        const lo = d && h ? (d < h ? d : h) : d;
        const hi = d && h ? (d < h ? h : d) : null;
        dayButtons.forEach(({ iso, el }) => {
            el.classList.toggle('is-start', !!lo && iso === lo);
            el.classList.toggle('is-end', !!hi && iso === hi);
            el.classList.toggle('is-in-range', !!(lo && hi && iso > lo && iso < hi));
        });
        if (dpDesdeInput) dpDesdeInput.value = d ? fullDateFmt(d) : '';
        if (dpHastaInput) dpHastaInput.value = dpPending.hasta ? fullDateFmt(dpPending.hasta) : (h && h !== d ? fullDateFmt(h) : '');
    }
    /** Reconstrucción COMPLETA de los dos meses. Solo al abrir, navegar de mes o elegir un
     *  preset — nunca en hover ni al elegir un día (ver paintSelection). */
    function renderCalendars() {
        dayButtons = [];
        renderMonth(dpCalLeftGrid, dpCalLeftTitle, dpViewYear, dpViewMonth);
        let ry = dpViewYear, rm = dpViewMonth + 1;
        if (rm > 11) { rm = 0; ry++; }
        renderMonth(dpCalRightGrid, dpCalRightTitle, ry, rm);
        paintSelection();
    }
    function onDayClick(iso: string) {
        // 1er clic (o clic con rango ya completo) fija el inicio y limpia el fin;
        // 2º clic fija el fin; un clic anterior al inicio se reinterpreta como nuevo inicio.
        if (!dpPending.desde || dpPending.hasta) dpPending = { desde: iso, hasta: null };
        else if (iso < dpPending.desde) dpPending = { desde: iso, hasta: null };
        else dpPending = { desde: dpPending.desde, hasta: iso };
        dpHover = null;
        document.querySelectorAll('.dp-preset-btn').forEach((b) => b.classList.remove('is-active'));
        document.querySelector('.dp-preset-btn[data-preset="custom"]')?.classList.add('is-active');
        paintSelection(); // repinta sin reconstruir: el botón recién pulsado sigue vivo
    }

    function computePreset(key: string): { desde: string; hasta: string } | 'todo' {
        const now = new Date(ultimaFecha + 'T00:00:00Z');
        switch (key) {
            case 'todo': return 'todo';
            case 'hoy': return { desde: ultimaFecha, hasta: ultimaFecha };
            case 'ayer': { const d = addDaysISO(ultimaFecha, -1); return { desde: d, hasta: d }; }
            case '7': return { desde: clamp(addDaysISO(ultimaFecha, -6)), hasta: ultimaFecha };
            case '30': return { desde: clamp(addDaysISO(ultimaFecha, -29)), hasta: ultimaFecha };
            case '90': return { desde: clamp(addDaysISO(ultimaFecha, -89)), hasta: ultimaFecha };
            case 'mes': return { desde: new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1)).toISOString().slice(0, 10), hasta: ultimaFecha };
            case 'mes_pasado': return {
                desde: new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, 1)).toISOString().slice(0, 10),
                hasta: new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 0)).toISOString().slice(0, 10),
            };
            case 'trimestre': { const qs = Math.floor(now.getUTCMonth() / 3) * 3; return { desde: new Date(Date.UTC(now.getUTCFullYear(), qs, 1)).toISOString().slice(0, 10), hasta: ultimaFecha }; }
            case 'ytd': return { desde: new Date(Date.UTC(now.getUTCFullYear(), 0, 1)).toISOString().slice(0, 10), hasta: ultimaFecha };
            default: return 'todo';
        }
    }
    document.querySelectorAll<HTMLButtonElement>('.dp-preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
            const key = btn.dataset.preset || 'todo';
            document.querySelectorAll('.dp-preset-btn').forEach((b) => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            if (key === 'custom') { dpPending = { desde: null, hasta: null }; renderCalendars(); return; }
            const r = computePreset(key);
            dpPending = r === 'todo' ? { desde: primeraFecha, hasta: ultimaFecha } : { desde: clamp(r.desde), hasta: clamp(r.hasta) };
            setViewFromISO(dpPending.hasta || ultimaFecha);
            renderCalendars();
        });
    });
    // Al salir del área de calendarios se limpia la previsualización de la banda.
    document.querySelector('.dp-cals')?.addEventListener('pointerleave', () => {
        if (dpHover === null) return;
        dpHover = null;
        paintSelection();
    });
    document.getElementById('dpPrev')?.addEventListener('click', () => { dpViewMonth--; if (dpViewMonth < 0) { dpViewMonth = 11; dpViewYear--; } renderCalendars(); });
    document.getElementById('dpNext')?.addEventListener('click', () => { dpViewMonth++; if (dpViewMonth > 11) { dpViewMonth = 0; dpViewYear++; } renderCalendars(); });

    function openPanel() {
        if (!dpPanel || !dpTrigger) return;
        dpPending = dpAppliedKeyRef.key === 'todo' ? { desde: null, hasta: null } : { desde: dpAppliedKeyRef.desde, hasta: dpAppliedKeyRef.hasta };
        document.querySelectorAll('.dp-preset-btn').forEach((b) => b.classList.toggle('is-active', (b as HTMLElement).dataset.preset === dpAppliedKeyRef.key || (dpAppliedKeyRef.key === 'custom' && (b as HTMLElement).dataset.preset === 'custom')));
        setViewFromISO(dpAppliedKeyRef.hasta || ultimaFecha);
        renderCalendars();
        dpPanel.hidden = false;
        dpTrigger.setAttribute('aria-expanded', 'true');
    }
    function closePanel() {
        if (!dpPanel || !dpTrigger) return;
        const hadFocusInside = dpPanel.contains(document.activeElement);
        dpPanel.hidden = true;
        dpTrigger.setAttribute('aria-expanded', 'false');
        if (hadFocusInside) dpTrigger.focus();
    }
    dpTrigger?.addEventListener('click', () => { if (!dpPanel) return; dpPanel.hidden ? openPanel() : closePanel(); });
    document.getElementById('dpCancel')?.addEventListener('click', closePanel);
    document.getElementById('dpApply')?.addEventListener('click', () => {
        if (dpPending.desde && !dpPending.hasta) dpPending.hasta = dpPending.desde;
        if (!dpPending.desde) {
            dpAppliedKeyRef = { key: 'todo', desde: primeraFecha, hasta: ultimaFecha };
            applyRange('todo');
            if (dpTriggerLabel) dpTriggerLabel.textContent = todoLabel;
        } else {
            dpAppliedKeyRef = { key: 'custom', desde: dpPending.desde, hasta: dpPending.hasta! };
            applyRange('custom', dpPending.desde, dpPending.hasta!);
            if (dpTriggerLabel) {
                dpTriggerLabel.textContent = dpPending.desde === dpPending.hasta
                    ? shortDateFmt(dpPending.desde)
                    : `${shortDateFmt(dpPending.desde)} – ${shortDateFmt(dpPending.hasta!)}`;
            }
        }
        closePanel();
    });
    document.addEventListener('click', (e) => {
        if (!dpPanel || dpPanel.hidden) return;
        // ⚠️ NO usar `e.target` + `contains()` aquí: al hacer clic en un día, onDayClick()
        // re-renderiza la grilla del calendario y DESPRENDE del DOM el botón que se acaba de
        // pulsar ANTES de que este listener corra en la fase de burbuja → `contains()` daría
        // false y el panel se cerraría en CADA clic de día (por eso "no deja seleccionar
        // fechas personalizadas"). `composedPath()` se calcula al despachar el evento, así
        // que conserva la ruta original aunque el nodo ya no exista.
        const path = e.composedPath();
        if (path.includes(dpPanel) || (dpTrigger && path.includes(dpTrigger))) return;
        closePanel();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && dpPanel && !dpPanel.hidden) closePanel(); });

    // ── KPIs: sparkline + gauge ──
    const sparkEl = document.getElementById('kpiSpark');
    if (sparkEl) {
        let values: number[] = [];
        try { values = JSON.parse(sparkEl.dataset.values || '[]'); } catch { values = []; }
        mountSparkline(sparkEl, { values, height: 30 });
    }
    const tasaGaugeEl = document.getElementById('kpiTasaGauge');
    if (tasaGaugeEl) {
        mountGauge(tasaGaugeEl, {
            value: Number(tasaGaugeEl.dataset.value || '0'),
            max: 100,
            size: 76,
            tone: (tasaGaugeEl.dataset.tone as any) || 'neutral',
            formatValue: (v) => `${Math.round(v)}%`,
        });
    }

    // ── Salud del pipeline: 4 gauges (snapshot de HOY — no sigue el rango) ──
    document.querySelectorAll<HTMLElement>('.health-gauge').forEach((el) => {
        const suffix = el.dataset.suffix || '';
        mountGauge(el, {
            value: Number(el.dataset.value || '0'),
            max: Number(el.dataset.max || '100'),
            size: 72,
            tone: (el.dataset.tone as any) || 'neutral',
            formatValue: (v) => `${Math.round(v)}${suffix}`,
        });
    });

    // ── Pipeline por estado (snapshot de HOY — no sigue el rango) ──
    const pipeSegEl = document.getElementById('pipeSegChart');
    if (pipeSegEl) {
        onVisible(pipeSegEl, () => {
            let segments: { key: string; label: string; value: number; color: string }[] = [];
            try { segments = JSON.parse(pipeSegEl.dataset.segments || '[]'); } catch { segments = []; }
            mountSegBar(pipeSegEl, { segments, formatY: (v) => moneyFmt(v), emptyMessage: emptyMsg });
        });
    }

    // ── Dinero por cobrar: dona + flujo esperado (snapshot de HOY — no sigue el rango) ──
    const agingEl = document.getElementById('agingChart');
    if (agingEl) {
        onVisible(agingEl, () => {
            let slices: { key: string; label: string; value: number; color: string }[] = [];
            try { slices = JSON.parse(agingEl.dataset.slices || '[]'); } catch { slices = []; }
            mountDonut(agingEl, { slices, formatY: moneyFmt, emptyMessage: emptyMsg });
        });
    }
    const flowEl = document.getElementById('flowChart');
    if (flowEl) {
        onVisible(flowEl, () => {
            let items: { label: string; value: number; sub?: string }[] = [];
            try { items = JSON.parse(flowEl.dataset.items || '[]'); } catch { items = []; }
            mountBarChart(flowEl, { items, formatY: moneyFmt, formatYAxis: moneyFmt, height: 220, emptyMessage: emptyMsg });
        });
    }
</script>

<script>
    // ═══ Editor de widgets — grid unitario, drag Pointer Events + FLIP, long-press,
    // wiggle y redimensionar, estilo iOS. Persistencia en localStorage (cord.dash.v1 =
    // {order[], hidden[], sizes{}}), misma convención que cord.pins.v1/cord.wb.v1. ═══
    (function () {
        const KEY = 'cord.dash.v1';
        const hostEl = document.getElementById('dashWidgets');
        if (!hostEl) return;
        const host: HTMLElement = hostEl;
        const editBtn = document.getElementById('dashEditBtn');
        const doneBtn = document.getElementById('dashDoneBtn');
        const resetBtn = document.getElementById('dashResetBtn');
        const trayEl = document.getElementById('widgetTray');
        const trayList = document.getElementById('widgetTrayList');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        type Prefs = { order: string[]; hidden: string[]; sizes: Record<string, 'sm' | 'lg'> };
        function getPrefs(): Prefs {
            try {
                const p = JSON.parse(localStorage.getItem(KEY) || '{}');
                return {
                    order: Array.isArray(p.order) ? p.order : [],
                    hidden: Array.isArray(p.hidden) ? p.hidden : [],
                    sizes: p.sizes && typeof p.sizes === 'object' ? p.sizes : {},
                };
            } catch { return { order: [], hidden: [], sizes: {} }; }
        }
        function setPrefs(p: Prefs) { try { localStorage.setItem(KEY, JSON.stringify(p)); } catch {} }

        function widgets(): HTMLElement[] {
            return Array.from(host.children).filter((w): w is HTMLElement => w instanceof HTMLElement && !!w.dataset.widget);
        }
        function persist() {
            const prefs = getPrefs();
            prefs.order = widgets().map((w) => w.dataset.widget!);
            setPrefs(prefs);
        }

        function currentSize(w: HTMLElement): 'sm' | 'lg' {
            return w.dataset.span === w.dataset.sizeLg && w.dataset.sizeLg !== w.dataset.sizeSm ? 'lg' : 'sm';
        }
        function applySize(w: HTMLElement, size: 'sm' | 'lg') {
            const span = size === 'lg' ? w.dataset.sizeLg! : w.dataset.sizeSm!;
            w.dataset.span = span;
            w.querySelector('.we-resize')?.classList.toggle('is-lg', size === 'lg');
        }

        function renderTray() {
            if (!trayEl || !trayList) return;
            const prefs = getPrefs();
            const all = widgets();
            const hiddenW = all.filter((w) => prefs.hidden.includes(w.dataset.widget!));
            trayEl.hidden = hiddenW.length === 0;
            trayList.innerHTML = '';
            hiddenW.forEach((w) => {
                const item = document.createElement('div');
                item.className = 'widget-tray-item';
                const label = document.createElement('span');
                label.textContent = w.dataset.title || w.dataset.widget || '';
                const add = document.createElement('button');
                add.type = 'button'; add.className = 'widget-tray-add'; add.setAttribute('aria-label', 'add'); add.textContent = '+';
                add.addEventListener('click', () => setHidden(w.dataset.widget!, false));
                item.append(label, add);
                trayList.appendChild(item);
            });
        }
        function setHidden(id: string, hide: boolean) {
            const prefs = getPrefs();
            prefs.hidden = hide ? Array.from(new Set([...prefs.hidden, id])) : prefs.hidden.filter((x) => x !== id);
            setPrefs(prefs);
            const w = widgets().find((x) => x.dataset.widget === id);
            if (w) w.hidden = hide;
            renderTray();
        }

        function enterEdit() {
            host.dataset.editing = '1';
            renderTray();
            if (editBtn) editBtn.hidden = true;
            if (doneBtn) doneBtn.hidden = false;
            if (resetBtn) resetBtn.hidden = false;
        }
        function exitEdit() {
            delete host.dataset.editing;
            if (trayEl) trayEl.hidden = true;
            if (editBtn) editBtn.hidden = false;
            if (doneBtn) doneBtn.hidden = true;
            if (resetBtn) resetBtn.hidden = true;
        }
        editBtn?.addEventListener('click', enterEdit);
        doneBtn?.addEventListener('click', exitEdit);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && host.dataset.editing === '1') exitEdit(); });
        resetBtn?.addEventListener('click', async () => {
            const confirmFn = (window as any).cordConfirm;
            const msg = host.dataset.i18nResetConfirm || '¿Restablecer?';
            const ok = confirmFn ? await confirmFn(msg) : confirm(msg);
            if (!ok) return;
            setPrefs({ order: [], hidden: [], sizes: {} });
            location.reload();
        });

        // ── FLIP genérico: ejecuta `mutate`, anima los widgets visibles desde su posición previa ──
        function flip(mutate: () => void) {
            const items = widgets().filter((w) => !w.hidden);
            const first = new Map(items.map((w) => [w, w.getBoundingClientRect()] as const));
            mutate();
            if (reduceMotion) return;
            requestAnimationFrame(() => {
                widgets().filter((w) => !w.hidden).forEach((w) => {
                    const f = first.get(w); if (!f) return;
                    const l = w.getBoundingClientRect();
                    const dx = f.left - l.left, dy = f.top - l.top;
                    if (!dx && !dy) return;
                    w.style.transition = 'none';
                    w.style.transform = `translate(${dx}px, ${dy}px)`;
                    w.getBoundingClientRect();
                    w.style.transition = 'transform 0.32s var(--ease-spring, cubic-bezier(0.22,1,0.36,1))';
                    w.style.transform = '';
                    w.addEventListener('transitionend', () => { w.style.transition = ''; }, { once: true });
                });
            });
        }

        // ── Botones por widget: subir · bajar · tamaño · ocultar ──
        widgets().forEach((w) => {
            const id = w.dataset.widget!;
            w.querySelector('.we-up')?.addEventListener('click', (e) => {
                e.stopPropagation();
                const prev = w.previousElementSibling;
                if (prev instanceof HTMLElement && prev.dataset.widget) flip(() => { host.insertBefore(w, prev); persist(); });
            });
            w.querySelector('.we-down')?.addEventListener('click', (e) => {
                e.stopPropagation();
                const next = w.nextElementSibling;
                if (next instanceof HTMLElement && next.dataset.widget) flip(() => { host.insertBefore(next, w); persist(); });
            });
            w.querySelector('.we-remove')?.addEventListener('click', (e) => { e.stopPropagation(); setHidden(id, true); });
            const resizeBtn = w.querySelector('.we-resize');
            if (w.dataset.sizeSm === w.dataset.sizeLg) { resizeBtn?.remove(); }
            else if (resizeBtn) {
                resizeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const next: 'sm' | 'lg' = currentSize(w) === 'sm' ? 'lg' : 'sm';
                    flip(() => {
                        applySize(w, next);
                        const prefs = getPrefs(); prefs.sizes[id] = next; setPrefs(prefs);
                    });
                });
            }
        });

        // ── Drag: Pointer Events + FLIP + long-press + auto-scroll (mecánica tipo iOS) ──
        let dragEl: HTMLElement | null = null;
        let dragStartX = 0, dragStartY = 0, dragOrigLeft = 0, dragOrigTop = 0, dragW = 0;
        let longPressTimer: ReturnType<typeof setTimeout> | null = null;
        let moved = false;
        let autoScrollRaf = 0;

        function widgetOffset(w: HTMLElement) {
            const hostRect = host.getBoundingClientRect();
            const r = w.getBoundingClientRect();
            return { left: r.left - hostRect.left, top: r.top - hostRect.top, width: r.width };
        }
        function beginDrag(w: HTMLElement, x: number, y: number) {
            dragEl = w;
            const r = widgetOffset(w);
            dragOrigLeft = r.left; dragOrigTop = r.top; dragW = r.width;
            dragStartX = x; dragStartY = y;
            w.classList.add('is-dragging');
            w.style.position = 'absolute';
            w.style.left = dragOrigLeft + 'px';
            w.style.top = dragOrigTop + 'px';
            w.style.width = dragW + 'px';
            w.style.zIndex = '50';
        }
        function moveDrag(x: number, y: number) {
            if (!dragEl) return;
            dragEl.style.left = (dragOrigLeft + (x - dragStartX)) + 'px';
            dragEl.style.top = (dragOrigTop + (y - dragStartY)) + 'px';

            cancelAnimationFrame(autoScrollRaf);
            autoScrollRaf = requestAnimationFrame(() => {
                const margin = 80;
                if (y < margin) window.scrollBy(0, -Math.ceil((margin - y) / 3));
                else if (y > window.innerHeight - margin) window.scrollBy(0, Math.ceil((margin - (window.innerHeight - y)) / 3));
            });

            const prevPE = dragEl.style.pointerEvents;
            dragEl.style.pointerEvents = 'none';
            const under = document.elementFromPoint(x, y) as HTMLElement | null;
            dragEl.style.pointerEvents = prevPE;
            const targetW = under?.closest<HTMLElement>('[data-widget]');
            if (targetW && targetW !== dragEl && !targetW.hidden && host.contains(targetW)) {
                const tr = targetW.getBoundingClientRect();
                const before = y < tr.top + tr.height / 2;
                flip(() => { if (before) host.insertBefore(dragEl!, targetW); else host.insertBefore(dragEl!, targetW.nextSibling); });
            }
        }
        function endDrag() {
            cancelAnimationFrame(autoScrollRaf);
            if (!dragEl) return;
            const w = dragEl;
            w.classList.remove('is-dragging');
            w.style.position = ''; w.style.left = ''; w.style.top = ''; w.style.width = ''; w.style.zIndex = '';
            dragEl = null;
            persist();
        }

        function attachMoveUp(pointerId: number) {
            const onMove = (ev: PointerEvent) => { moved = true; moveDrag(ev.clientX, ev.clientY); };
            const onUp = () => {
                document.removeEventListener('pointermove', onMove);
                document.removeEventListener('pointerup', onUp);
                document.removeEventListener('pointercancel', onUp);
                endDrag();
            };
            document.addEventListener('pointermove', onMove);
            document.addEventListener('pointerup', onUp);
            document.addEventListener('pointercancel', onUp);
        }

        host.addEventListener('pointerdown', (e: PointerEvent) => {
            const target = e.target as HTMLElement;
            if (target.closest('.widget-editbar')) return; // los botones tienen su propio handler
            const w = target.closest<HTMLElement>('[data-widget]');
            if (!w || !host.contains(w)) return;

            if (host.dataset.editing === '1') {
                moved = false;
                beginDrag(w, e.clientX, e.clientY);
                attachMoveUp(e.pointerId);
                return;
            }
            if (target.closest('a,button,input,textarea')) return; // fuera de edición, deja pasar clics/links normales

            moved = false;
            const startX = e.clientX, startY = e.clientY;
            longPressTimer = setTimeout(() => {
                if (moved) return;
                enterEdit();
                beginDrag(w, startX, startY);
                attachMoveUp(e.pointerId);
            }, 500);
            const onEarlyMove = (ev: PointerEvent) => {
                if (Math.abs(ev.clientX - startX) > 8 || Math.abs(ev.clientY - startY) > 8) {
                    moved = true;
                    if (longPressTimer) clearTimeout(longPressTimer);
                }
            };
            const onEarlyUp = () => {
                if (longPressTimer) clearTimeout(longPressTimer);
                document.removeEventListener('pointermove', onEarlyMove);
            };
            document.addEventListener('pointermove', onEarlyMove);
            document.addEventListener('pointerup', onEarlyUp, { once: true });
        });
    })();
</script>

<script>
    // Count-up ligero de los KPIs (vanilla, sin GSAP — la app no carga GSAP)
    document.addEventListener('DOMContentLoaded', () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const localeIntl = document.documentElement.lang === 'en' ? 'en-US' : 'es-MX';
        const fmt = (n: number) => '$' + new Intl.NumberFormat(localeIntl, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
        document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
            const target = parseFloat(el.dataset.countup || '0');
            const t0 = performance.now();
            const dur = 1100;
            const tick = (t: number) => {
                const p = Math.min((t - t0) / dur, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = fmt(target * eased);
                if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
        });
    });
</script>

<script>
    // ── Tareas / recordatorios ──
    document.getElementById('taskAdd')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const tEl = document.getElementById('taskTitulo') as HTMLInputElement;
        const dEl = document.getElementById('taskDue') as HTMLInputElement;
        const titulo = tEl.value.trim();
        if (!titulo) return;
        try {
            const res = await fetch('/api/tareas', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ titulo, due_date: dEl.value || null }) });
            if (!res.ok) throw new Error();
            location.reload();
        } catch { /* noop */ }
    });
    document.querySelectorAll<HTMLElement>('.task-row').forEach((row) => {
        const id = row.dataset.id;
        row.querySelector('[data-done]')?.addEventListener('click', async () => {
            await fetch('/api/tareas', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, done: true }) }).catch(() => {});
            row.remove();
        });
        row.querySelector('[data-del]')?.addEventListener('click', async () => {
            await fetch('/api/tareas', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) }).catch(() => {});
            row.remove();
        });
    });
</script>
