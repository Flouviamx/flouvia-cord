---
import Layout from '../layouts/Layout.astro';
import VerifyEmail from '../components/auth/VerifyEmail';
import '../styles/auth.css';
---

<Layout title="Verificar correo - Cord">
    <div class="auth-page">
        <a href="/" class="auth-logo">
            <img src="/imgs/logo-cord-navy.png" alt="Cord" height="26" />
        </a>

        <VerifyEmail client:only="react" />

        <p class="auth-page-footer">Hecho en México &nbsp;&middot;&nbsp; Datos cifrados</p>
    </div>
</Layout>

