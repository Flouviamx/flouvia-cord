    const isEnDoc = () => document.documentElement.lang === 'en';
    function initTabs() {
        const wrap = document.querySelector<HTMLElement>('[data-el-tabs]');
        if (!wrap) return;
        const tabs = Array.from(wrap.querySelectorAll<HTMLButtonElement>('.eli-tab'));
        const panels = Array.from(wrap.querySelectorAll<HTMLElement>('.el-panel'));
        const file = wrap.querySelector<HTMLElement>('#elActiveFile');
        const show = (id: string) => {
            tabs.forEach((t) => {
                const on = t.dataset.tab === id;
                t.classList.toggle('active', on);
                t.setAttribute('aria-selected', String(on));
                if (on && file) file.textContent = t.dataset.file || '';
            });
            panels.forEach((p) => { const on = p.dataset.panel === id; p.classList.toggle('active', on); p.hidden = !on; });
        };
        tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!)));
        const btn = wrap.querySelector<HTMLButtonElement>('[data-copy]');
        btn?.addEventListener('click', async () => {
            const active = wrap.querySelector<HTMLElement>('.el-panel.active');
            const text = active ? Array.from(active.querySelectorAll<HTMLElement>('.el-lc')).map((x) => x.dataset.raw ?? '').join('\n') : '';
            try {
                await navigator.clipboard.writeText(text);
                const label = btn.querySelector<HTMLElement>('[data-copy-label]');
                btn.classList.add('done');
                if (label) label.textContent = isEnDoc() ? 'Copied' : 'Copiado';
                setTimeout(() => { btn.classList.remove('done'); if (label) label.textContent = isEnDoc() ? 'Copy' : 'Copiar'; }, 2000);
            } catch {}
        });
    }
    function initSdk() {
        const wrap = document.querySelector<HTMLElement>('[data-sdk]');
        if (!wrap) return;
        const tabs = Array.from(wrap.querySelectorAll<HTMLButtonElement>('.els-tab'));
        const panels = Array.from(wrap.querySelectorAll<HTMLElement>('.els-panel'));
        tabs.forEach((t) => t.addEventListener('click', () => {
            tabs.forEach((x) => { const on = x === t; x.classList.toggle('active', on); x.setAttribute('aria-selected', String(on)); });
            panels.forEach((p) => { p.hidden = p.dataset.modPanel !== t.dataset.mod; });
        }));
    }
    function initCmd() {
        const box = document.querySelector<HTMLElement>('[data-install-cmd]');
        const btn = box?.querySelector<HTMLButtonElement>('.el-cmd-copy');
        let timer = 0;
        btn?.addEventListener('click', async () => {
            try { await navigator.clipboard.writeText('npm install @flouviahq/elements'); } catch { return; }
            // Reinicia la animación aunque se pulse dos veces seguidas.
            box!.classList.remove('done'); btn.classList.remove('done');
            void btn.offsetWidth;
            box!.classList.add('done'); btn.classList.add('done');
            clearTimeout(timer);
            timer = window.setTimeout(() => { box!.classList.remove('done'); btn.classList.remove('done'); }, 2200);
        });
    }
    function init() { initTabs(); initSdk(); initCmd(); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
</script>

<script>
    // Motion: el hero es una demo en bucle (el cursor aprueba, la consola
    // recibe cord:approved/cord:signed) y cada tarjeta del bento anima su
    // propia historia. Con reduced-motion todo queda en su estado final.
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const watch = (el: Element) => {
        const state = { on: false };
        new IntersectionObserver(([e]) => { state.on = e.isIntersecting; }, { threshold: 0.15 }).observe(el);
        return state;
    };
    const idle = (v: { on: boolean }) => !v.on || document.hidden;

    window.addEventListener('load', () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ── PAÍS: pestañas con cambio animado; rotan solas hasta que alguien elige ──
        const elc = document.querySelector<HTMLElement>('[data-elc]');
        if (elc) {
            const tabs = Array.from(elc.querySelectorAll<HTMLButtonElement>('.elc-tab'));
            const cards = Array.from(elc.querySelectorAll<HTMLElement>('.elc-card'));
            let cur = 0, auto = !reduced;
            const show = (k: number) => {
                if (k === cur) return;
                const from = cards[cur], to = cards[k];
                tabs.forEach((t, j) => { t.classList.toggle('on', j === k); t.setAttribute('aria-selected', String(j === k)); });
                cards.forEach((c, j) => c.setAttribute('aria-hidden', String(j !== k)));
                if (reduced) { from.classList.remove('on'); to.classList.add('on'); cur = k; return; }
                gsap.to(from, { opacity: 0, y: -10, rotateX: 6, duration: 0.3, ease: 'power2.in', transformPerspective: 1200, onComplete: () => from.classList.remove('on') });
                to.classList.add('on');
                gsap.fromTo(to, { opacity: 0, y: 14, rotateX: -6, transformPerspective: 1200 }, { opacity: 1, y: 0, rotateX: 0, duration: 0.55, delay: 0.15, ease: 'power3.out' });
                gsap.from(to.querySelectorAll('.elc-tr, .elc-sum > *, .elc-m, .elc-pay'), { opacity: 0, x: 8, duration: 0.4, stagger: 0.03, delay: 0.25 });
                cur = k;
            };
            tabs.forEach((t, k) => t.addEventListener('click', () => { auto = false; show(k); }));
            const vis = watch(elc);
            (async () => {
                for (;;) {
                    await sleep(4200);
                    if (!auto) return;
                    if (idle(vis)) continue;
                    show((cur + 1) % cards.length);
                }
            })();
        }

        // ── CARRUSEL "Conoce más" ──
        const elm = document.querySelector<HTMLElement>('[data-elm]');
        const track = elm?.querySelector<HTMLElement>('[data-elm-track]');
        if (elm && track) {
            const [prev, next] = Array.from(elm.querySelectorAll<HTMLButtonElement>('.elm-arrow'));
            const step = () => (track.querySelector<HTMLElement>('.elm-item')?.offsetWidth ?? 400) + 24;
            const sync = () => {
                prev.disabled = track.scrollLeft < 8;
                next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
            };
            prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
            next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
            track.addEventListener('scroll', sync, { passive: true });
            sync();
        }

        // ── Entrada del bento ──
        if (!reduced) {
            document.querySelectorAll<HTMLElement>('.pp-bcard-visual .elx').forEach((v) => {
                gsap.set(v, { y: 24, opacity: 0 });
                ScrollTrigger.create({ trigger: v.closest('.pp-bcard')!, start: 'top 85%', once: true, onEnter: () => gsap.to(v, { y: 0, opacity: 1, duration: 0.9, ease: 'power3.out', clearProps: 'transform' }) });
            });
        }

        // ── 0: skeleton -> cotización, con la altura que reporta cord:resize ──
        const b0 = document.querySelector<HTMLElement>('[data-elx="0"]');
        if (b0) {
            const frame = document.getElementById('elx0Frame');
            const skel = document.getElementById('elx0Skel');
            const mini = document.getElementById('elx0Mini');
            const h = document.getElementById('elx0H');
            if (reduced) { skel?.classList.add('gone'); mini?.classList.add('on'); frame?.classList.add('grown'); if (h) h.textContent = '612'; }
            else {
                const vis = watch(b0);
                (async () => {
                    for (;;) {
                        if (idle(vis)) { await sleep(400); continue; }
                        skel?.classList.remove('gone'); mini?.classList.remove('on'); frame?.classList.remove('grown'); if (h) h.textContent = '420';
                        await sleep(1500);
                        skel?.classList.add('gone'); mini?.classList.add('on'); frame?.classList.add('grown');
                        const o = { v: 420 };
                        gsap.to(o, { v: 612, duration: 0.7, ease: 'power2.out', onUpdate: () => { if (h) h.textContent = String(Math.round(o.v)); } });
                        await sleep(3600);
                    }
                })();
            }
        }

        // ── 1: el tema cambia entre light, dark y la marca del portal ──
        const b1 = document.querySelector<HTMLElement>('[data-elx="1"]');
        if (b1 && !reduced) {
            const cards = Array.from(b1.querySelectorAll<HTMLElement>('.elx1-card'));
            const theme = document.getElementById('elx1Theme');
            const names = ["'light'", "'dark'", "'light'"];
            const vis = watch(b1);
            let k = 0;
            (async () => {
                for (;;) {
                    await sleep(2000);
                    if (idle(vis)) continue;
                    k = (k + 1) % cards.length;
                    cards.forEach((c, j) => c.classList.toggle('is-on', j === k));
                    if (theme) theme.textContent = names[k];
                }
            })();
        }

        // ── 2: los eventos llegan uno por uno ──
        const b2 = document.querySelector<HTMLElement>('[data-elx="2"]');
        if (b2) {
            const rows = Array.from(b2.querySelectorAll<HTMLElement>('[data-r]'));
            if (reduced) rows.forEach((r) => r.classList.add('on'));
            else {
                const vis = watch(b2);
                (async () => {
                    for (;;) {
                        if (idle(vis)) { await sleep(400); continue; }
                        rows.forEach((r) => r.classList.remove('on'));
                        await sleep(500);
                        for (const r of rows) { r.classList.add('on'); await sleep(650); }
                        await sleep(3200);
                    }
                })();
            }
        }

        // ── 3: tu UI envía y Cord devuelve el link ──
        const b3 = document.querySelector<HTMLElement>('[data-elx="3"]');
        if (b3) {
            const btn = document.getElementById('elx3Btn');
            const toast = document.getElementById('elx3Toast');
            if (reduced) toast?.classList.add('on');
            else {
                const vis = watch(b3);
                (async () => {
                    for (;;) {
                        if (idle(vis)) { await sleep(400); continue; }
                        toast?.classList.remove('on');
                        await sleep(1800);
                        if (btn) await gsap.to(btn, { scale: 0.96, duration: 0.1, yoyo: true, repeat: 1 });
                        await sleep(300);
                        toast?.classList.add('on');
                        await sleep(3000);
                    }
                })();
            }
        }
    });
</script>

