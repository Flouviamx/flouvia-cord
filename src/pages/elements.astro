---
// /elements — Cord Elements: el SDK para llevar las cotizaciones de Cord al
// sitio de un tercero. Misma familia visual que /producto y /desarrolladores
// (hero 100dvh con banda diagonal, bento de tarjetas blancas, FAQ, cross-links de /producto) más lo
// que necesita un SDK: el hero es una calca 1:1 de /embed/demo dentro del
// portal de un cliente con su consola de eventos, instalación por stack, y un
// explorador de TODO lo que exporta el paquete — cada nombre de esta página
// existe en packages/elements/src (verifícalo ahí antes de editar el copy).
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/landing/Nav.astro';
import Footer from '../components/landing/Footer.astro';
import PageAnims from '../components/landing/PageAnims.astro';
