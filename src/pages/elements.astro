import { getLangFromUrl, publicPath } from '../i18n/utils';
import { DEV_PAGES } from '../lib/desarrolladores';
import { DEV_PAGES_EN } from '../lib/desarrolladores.en';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const l = (p: string) => publicPath(p, lang);
const tx = (es: string, en: string) => (isEn ? en : es);
const pages = isEn ? DEV_PAGES_EN : DEV_PAGES;
const devPage = pages.find((p) => p.slug === 'elements')!;

// ── Resaltado mínimo de código en build (sin dependencias) ──
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const TOK = /(\/\/.*$|<!--.*?-->)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|`[^`]*`)|(=>)|(<\/?[A-Za-z][\w.-]*|\/?>)|\b(import|from|export|default|function|return|const|async|await|if|new|try|catch|true|false)\b|(\b[A-Za-z_$][\w$]*(?=\())/g;
const hl = (line: string) => {
    let out = '';
    let last = 0;
    for (const m of line.matchAll(TOK)) {
        out += esc(line.slice(last, m.index));
        const cls = m[1] ? 'c-com' : m[2] ? 'c-str' : m[3] ? 'c-op' : m[4] ? 'c-tag' : m[5] ? 'c-kw' : 'c-fn';
        out += `<span class="${cls}">${esc(m[0])}</span>`;
        last = (m.index ?? 0) + m[0].length;
    }
    return out + esc(line.slice(last));
};
const lines = (code: string) => code.split('\n').map((t) => ({ raw: t, html: hl(t) || ' ' }));

const favicon = (domain: string) => `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${domain}&size=128`;

