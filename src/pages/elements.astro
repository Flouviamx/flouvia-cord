    .eli-body { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 1.4rem; align-items: stretch; }
    .eli-steps { list-style: none; margin: 0; padding: 1rem 1rem 1rem 0.8rem; display: flex; flex-direction: column; justify-content: center; gap: 1.6rem; }
    .eli-steps li { display: flex; gap: 14px; }
    .eli-n { flex-shrink: 0; font-family: ui-monospace, monospace; font-size: 0.72rem; font-weight: 700; color: #99a2af; padding-top: 3px; }
    .eli-steps b { display: block; font-size: 1rem; font-weight: 700; letter-spacing: -0.02em; color: #050505; margin-bottom: 4px; }
    .eli-steps p { margin: 0; font-size: 0.88rem; line-height: 1.55; color: var(--color-text-muted); }

    /* ════════ BENTO (idéntico a /producto) ════════ */
    .pp-bento { max-width: 1360px; margin: 0 auto; padding: 6rem 5% 5rem; display: grid; grid-template-columns: 5fr 7fr; gap: 1.2rem; }
    .pp-bcard-2, .pp-bcard-3 { grid-column: 1 / -1; }
    .pp-bcard {
        background: #fff; border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; min-height: 540px;
        box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 28px 56px -16px rgba(10,25,47,0.14), inset 0 1px 0 rgba(255,255,255,0.6);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    .pp-bcard:hover { transform: translateY(-6px); box-shadow: 0 2px 4px rgba(10,25,47,0.05), 0 38px 72px -18px rgba(10,25,47,0.2), inset 0 1px 0 rgba(255,255,255,0.6); }
    .pp-bcard-2, .pp-bcard-3 { flex-direction: row; min-height: 480px; }
    .pp-bcard-text { padding: 3rem 2.8rem 2rem; flex-shrink: 0; position: relative; z-index: 2; }
    .pp-bcard-2 .pp-bcard-text, .pp-bcard-3 .pp-bcard-text { flex: 0 0 40%; padding: 3.8rem 2.6rem 3.8rem 4rem; display: flex; flex-direction: column; justify-content: center; }
    .pp-bcard-visual { flex: 1; position: relative; overflow: hidden; min-height: 340px; background: #fff; }
    .pp-bcard-eyebrow { font-size: 0.6rem; font-weight: 800; letter-spacing: 2.8px; text-transform: uppercase; color: #b0b0b8; margin: 0 0 0.9rem; }
    .pp-bcard-h2 { font-size: clamp(1.35rem, 2.1vw, 1.85rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.035em; color: #050505; margin: 0 0 0.9rem; }
    .pp-bcard-copy { font-size: 0.875rem; line-height: 1.68; color: var(--color-text-muted); margin: 0 0 1.4rem; }
    .pp-bcard-bullets { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }
    .pp-bcard-bullets li { display: flex; align-items: flex-start; gap: 8px; font-size: 0.83rem; color: var(--color-text); font-weight: 500; line-height: 1.45; }
    .pp-bcard-bullets svg { width: 15px; height: 15px; color: var(--color-ok); flex-shrink: 0; margin-top: 1px; }

    /* Mockups del bento: ventanas claras sobre la tarjeta blanca */
    .elx { position: absolute; inset: 0; padding: 1.6rem 1.8rem 0; display: flex; flex-direction: column; align-items: center; }
    .pp-bcard-2 .elx, .pp-bcard-3 .elx { padding: 2rem 2.4rem; justify-content: center; }
    .elx-win { width: 100%; max-width: 560px; background: #fff; border-radius: 14px; box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 24px 50px -24px rgba(10,25,47,0.28), inset 0 0 0 1px rgba(10,25,47,0.07); overflow: hidden; }
    .elx-snip { padding: 10px 14px; background: #0b1526; color: #dbe4f0; font-family: ui-monospace, monospace; font-size: 0.68rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* 0 — carga y altura */
    .elx-0 .elx-win { background: #f5f5f7; }
    .elx0-frame { position: relative; margin: 14px; height: 150px; border-radius: 12px; background: #fff; box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 10px 24px -16px rgba(10,25,47,0.3); transition: height 0.7s cubic-bezier(.2,.8,.2,1); overflow: hidden; }
    .elx0-frame.grown { height: 228px; }
    .elx0-skel { position: absolute; inset: 0; padding: 16px; display: flex; flex-direction: column; gap: 10px; transition: opacity 0.35s; }
    .elx0-skel i { display: block; height: 12px; border-radius: 6px; background: linear-gradient(90deg, #f0f1f4 0%, #e5e7ec 40%, #f0f1f4 80%); background-size: 200% 100%; animation: elxShimmer 1.3s linear infinite; }
    .elx0-skel i:nth-child(1) { width: 45%; }
    .elx0-skel i:nth-child(2) { height: 36px; }
    .elx0-skel i:nth-child(3) { width: 80%; }
    .elx0-skel i:nth-child(4) { width: 60%; }
    .elx0-skel.gone { opacity: 0; }
    @keyframes elxShimmer { to { background-position: -200% 0; } }
    .elx0-mini { position: absolute; inset: 0; padding: 14px 16px; opacity: 0; transition: opacity 0.4s 0.15s; }
    .elx0-mini.on { opacity: 1; }
    .elx0-row { display: flex; align-items: center; gap: 8px; font-size: 0.72rem; margin-bottom: 12px; color: #0a192f; }
    .elx0-row em { margin-left: auto; font-style: normal; font-weight: 600; color: #5b6575; }
    .elx0-mini small { font-size: 0.5rem; letter-spacing: 0.22em; color: #a3aab6; font-weight: 600; }
    .elx0-mini strong { display: block; font-size: 1.35rem; letter-spacing: -0.04em; color: #0a192f; margin: 2px 0 10px; }
    .elx0-mini strong span { font-size: 0.6rem; color: #8a93a2; letter-spacing: 0; font-weight: 600; }
    .elx0-lines { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
    .elx0-lines i { height: 7px; border-radius: 4px; background: #f0f1f4; }
    .elx0-lines i:nth-child(2) { width: 82%; }
    .elx0-lines i:nth-child(3) { width: 64%; }
    .elx0-btn { display: block; text-align: center; padding: 7px 0; border-radius: 99px; background: #0d1b33; color: #fff; font-size: 0.66rem; font-weight: 600; }
    .elx0-ruler { margin: 0 14px 14px; padding: 7px 10px; border-radius: 8px; background: #fff; font-family: ui-monospace, monospace; font-size: 0.66rem; color: #5b6575; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.06); }
    .elx0-ruler .c-fn { color: #b45309; }
    .elx0-ruler b { color: #0a192f; }

    /* 1 — temas */
    .elx-1 { justify-content: center; gap: 1.2rem; padding-bottom: 1.6rem; }
    .elx1-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; width: 100%; max-width: 620px; }
    .elx1-card { position: relative; border-radius: 14px; padding: 26px 14px 14px; background: #fff; color: #0a192f; box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 16px 34px -20px rgba(10,25,47,0.35), inset 0 0 0 1px rgba(10,25,47,0.07); transition: transform 0.5s var(--ease-spring), box-shadow 0.5s; }
    .elx1-card.is-on { transform: translateY(-8px); box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 26px 44px -20px rgba(10,25,47,0.45), 0 0 0 2px #2f6df0; }
    .elx1-lbl { position: absolute; top: 8px; left: 10px; font-family: ui-monospace, monospace; font-size: 0.56rem; color: #8a93a2; }
    .elx1-h { display: flex; align-items: center; gap: 6px; font-size: 0.6rem; margin-bottom: 14px; white-space: nowrap; overflow: hidden; }
    .elx1-logo { flex-shrink: 0; width: 18px; height: 18px; border-radius: 5px; background: #0d1b33; color: #fff; display: grid; place-items: center; font-size: 0.46rem; font-weight: 700; }
    .elx1-card small { display: block; font-size: 0.46rem; letter-spacing: 0.2em; color: #a3aab6; font-weight: 600; }
    .elx1-card strong { display: block; font-size: 0.98rem; letter-spacing: -0.04em; margin-top: 2px; }
    .elx1-card em { font-style: normal; font-size: 0.54rem; color: #8a93a2; }
    .elx1-btn { display: block; margin-top: 14px; text-align: center; padding: 6px 0; border-radius: 99px; background: #0d1b33; color: #fff; font-size: 0.58rem; font-weight: 600; }
    .t-dark { background: #111827; color: #e5e7eb; box-shadow: 0 16px 34px -20px rgba(0,0,0,0.6), inset 0 0 0 1px rgba(255,255,255,0.06); }
    .t-dark .elx1-logo, .t-dark .elx1-btn { background: #e5e7eb; color: #111827; }
    .t-dark .elx1-lbl, .t-dark em, .t-dark small { color: #8b95a7; }
    .t-brand { border-radius: 20px; font-family: Georgia, 'Times New Roman', serif; }
    .t-brand .elx1-logo, .t-brand .elx1-btn { background: #0f766e; }
    .t-brand strong { color: #0f766e; }
    .t-brand .elx1-lbl { font-family: ui-monospace, monospace; }
    .elx1-code { max-width: 620px; width: 100%; padding: 10px 14px; border-radius: 10px; background: #0b1526; color: #dbe4f0; font-family: ui-monospace, monospace; font-size: 0.66rem; line-height: 1.6; }

    /* 2 — eventos */
    .elx2-win { max-width: 640px; }
    .elx2-head { display: flex; justify-content: space-between; align-items: center; padding: 11px 16px; border-bottom: 1px solid #eef0f3; font-size: 0.74rem; font-weight: 700; color: #0a192f; }
    .elx2-live { display: inline-flex; align-items: center; gap: 6px; font-size: 0.64rem; font-weight: 600; color: #059669; }
    .elx2-live i { width: 6px; height: 6px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,0.16); }
    .elx2-tbl { padding: 6px 0; }
    .elx2-r { display: grid; grid-template-columns: 62px 128px 1fr; gap: 10px; align-items: center; padding: 7px 16px; font-family: ui-monospace, monospace; font-size: 0.66rem; opacity: 0.15; transform: translateX(-6px); transition: opacity 0.4s, transform 0.4s, background 0.4s; }
    .elx2-r.on { opacity: 1; transform: none; }
    .elx2-r time { color: #a3aab6; }
    .elx2-r em { font-style: normal; color: #2f6df0; font-weight: 600; }
    .elx2-r span { color: #5b6575; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.6; }
    .elx2-r.is-ok.on { background: rgba(16,185,129,0.07); }
    .elx2-r.is-ok em { color: #059669; }
    .elx2-r.is-pay em { color: #b45309; }
    .elx2-code { padding: 10px 16px; background: #0b1526; color: #dbe4f0; font-family: ui-monospace, monospace; font-size: 0.66rem; }

    /* 3 — headless */
    .pp-bcard-3 .elx-3 { flex-direction: row; align-items: center; gap: 1.2rem; }
    .elx3-code { flex: 1.1; min-width: 0; padding: 14px 16px; border-radius: 14px; background: #0b1526; color: #dbe4f0; font-family: ui-monospace, monospace; font-size: 0.64rem; line-height: 1.75; white-space: pre; overflow: hidden; box-shadow: 0 24px 50px -28px rgba(5,11,20,0.6); }
    .elx3-l { min-height: 1.75em; overflow: hidden; text-overflow: ellipsis; }
    .elx3-ui { position: relative; flex: 0.9; min-width: 0; padding: 18px; border-radius: 6px; background: #fffaf3; border: 1.5px solid #1f2937; font-family: Georgia, 'Times New Roman', serif; color: #1f2937; box-shadow: 6px 6px 0 #1f2937; }
    .elx3-badge { position: absolute; top: -11px; left: 14px; padding: 2px 8px; background: #fbbf24; border: 1.5px solid #1f2937; font-family: var(--font-sans); font-size: 0.56rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .elx3-title { margin: 4px 0 12px; font-size: 0.92rem; font-weight: 700; }
    .elx3-row { display: grid; grid-template-columns: 1fr 44px 78px; gap: 6px; padding: 6px 0; border-bottom: 1px dashed #d6cfc2; font-size: 0.66rem; }
    .elx3-row b { text-align: right; font-weight: 400; }
    .elx3-row em { text-align: right; font-style: normal; }
    .elx3-tot { display: flex; justify-content: space-between; align-items: baseline; margin: 10px 0 12px; font-size: 0.66rem; }
    .elx3-tot strong { font-family: Georgia, serif; font-size: 1.05rem; }
    .elx3-btn { display: block; text-align: center; padding: 8px 0; background: #1f2937; color: #fffaf3; font-family: var(--font-sans); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.04em; }
    .elx3-toast { display: flex; align-items: center; gap: 7px; margin-top: 10px; padding: 7px 10px; background: #ecfdf5; border: 1px solid #a7f3d0; font-family: var(--font-sans); font-size: 0.64rem; font-weight: 600; color: #065f46; opacity: 0; transform: translateY(6px); transition: opacity 0.35s, transform 0.35s; }
    .elx3-toast svg { stroke: #059669; width: 11px; height: 11px; }
    .elx3-toast.on { opacity: 1; transform: none; }


    /* ════════ PAÍS ════════ */
    .elc { max-width: 1240px; margin: 0 auto; padding: 4rem 5% 6rem; display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 4rem; align-items: center; }
    .elc-text .el-h2 { margin-bottom: 1.2rem; }
    .elc-list { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem 1.6rem; }
    .elc-list li { display: flex; gap: 9px; align-items: flex-start; font-size: 0.9rem; line-height: 1.45; color: var(--color-text); }
    .elc-list svg { flex-shrink: 0; width: 17px; height: 17px; margin-top: 1px; fill: rgba(16,185,129,0.12); stroke: #059669; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .elc-demo { min-width: 0; }
    .elc-tabs { display: flex; gap: 0.4rem; margin-bottom: 1.1rem; flex-wrap: wrap; }
    .elc-tab { border: 0; cursor: pointer; padding: 9px 18px; border-radius: 999px; background: transparent; font: 600 0.92rem var(--font-sans); color: #5b6575; transition: background 0.3s, color 0.3s, box-shadow 0.3s; }
    .elc-tab:hover { color: #0a192f; background: rgba(10,25,47,0.05); }
    .elc-tab.on { background: #0a192f; color: #fff; box-shadow: 0 10px 22px -12px rgba(10,25,47,0.6); }
    .elc-tab:focus-visible { outline: 2px solid #2f6df0; outline-offset: 2px; }
    .elc-stage { position: relative; display: grid; padding: 2.2rem; border-radius: 28px; background: #fff; box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 28px 56px -16px rgba(10,25,47,0.14); }
    .elc-card { grid-area: 1 / 1; visibility: hidden; opacity: 0; max-width: 460px; width: 100%; justify-self: center; padding: 1.4rem 1.5rem 1.5rem; border-radius: 16px; background: #fff; box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 16px 36px -20px rgba(10,25,47,0.35), inset 0 0 0 1px rgba(10,25,47,0.07); }
    .elc-card.on { visibility: visible; opacity: 1; }
    .elc-head { display: flex; align-items: center; gap: 10px; padding-bottom: 12px; margin-bottom: 6px; border-bottom: 1px solid #eef0f3; }
    .elc-logo { width: 32px; height: 32px; border-radius: 9px; background: #0d1b33; color: #fff; display: grid; place-items: center; font-size: 0.68rem; font-weight: 700; flex-shrink: 0; }
    .elc-head b { display: block; font-size: 0.9rem; font-weight: 600; color: #0a192f; }
    .elc-head small { display: block; font-size: 0.7rem; color: #8a93a2; margin-top: 2px; }
    .elc-head em { margin-left: auto; font-style: normal; font-size: 0.74rem; color: #5b6575; white-space: nowrap; }
    .elc-th, .elc-tr { display: grid; grid-template-columns: 1fr 44px 110px; gap: 8px; text-align: right; align-items: center; }
    .elc-th { padding: 8px 0 6px; font-size: 0.6rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #a3aab6; }
    .elc-tr { padding: 8px 0; border-top: 1px solid #f1f2f5; font-size: 0.82rem; color: #8a93a2; }
    .elc-th span:first-child, .elc-tr span:first-child { text-align: left; color: #0a192f; font-weight: 500; }
    .elc-th span:first-child { color: #a3aab6; font-weight: 600; }
    .elc-tr b { font-weight: 600; color: #0a192f; }
    .elc-sum { display: grid; grid-template-columns: auto 130px; justify-content: end; gap: 4px 24px; padding-top: 10px; border-top: 1px solid #eef0f3; font-size: 0.8rem; color: #8a93a2; text-align: right; }
    .elc-sum b { color: #3b4658; font-weight: 600; }
    .elc-sum .elc-total { margin-top: 4px; padding-top: 6px; border-top: 1px solid #eef0f3; font-size: 0.95rem; font-weight: 700; color: #0a192f; }
    .elc-methods { display: flex; gap: 8px; margin: 1.1rem 0 0.8rem; }
    .elc-m { flex: 1; padding: 10px 12px; border-radius: 10px; font-size: 0.78rem; font-weight: 600; color: #5b6575; box-shadow: inset 0 0 0 1px #e5e7eb; }
    .elc-m.on { color: #0a192f; box-shadow: inset 0 0 0 1.5px #0a192f; }
    .elc-pay { display: block; text-align: center; padding: 12px 0; border-radius: 10px; background: #0d1b33; color: #fff; font-size: 0.86rem; font-weight: 600; }
    .elc-cfdi { display: block; margin-top: 10px; text-align: center; font-size: 0.72rem; color: #059669; font-weight: 600; }

    /* ════════ CARRUSEL ════════ */
    .elm { max-width: 1240px; margin: 0 auto; padding: 4rem 5% 5rem; }
    .elm-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 2.4rem; }
    .elm-head .el-h2 { margin: 0; }
    .elm-nav { display: flex; gap: 0.6rem; flex-shrink: 0; }
    .elm-arrow { width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; background: #fff; color: #0a192f; display: grid; place-items: center; box-shadow: 0 1px 2px rgba(10,25,47,0.06), 0 8px 18px -10px rgba(10,25,47,0.3); transition: transform 0.4s var(--ease-spring), opacity 0.3s; }
    .elm-arrow svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .elm-arrow:hover:not(:disabled) { transform: translateY(-2px); }
    .elm-arrow:disabled { opacity: 0.35; cursor: default; }
    .elm-track { list-style: none; margin: 0 -5%; padding: 0.6rem 5% 1.4rem; display: grid; grid-auto-flow: column; grid-auto-columns: min(460px, 82vw); gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 5%; scrollbar-width: none; }
    .elm-track::-webkit-scrollbar { display: none; }
    .elm-item { scroll-snap-align: start; min-width: 0; }
    .elm-vis { position: relative; height: 300px; border-radius: 24px; background: #fff; overflow: hidden; display: grid; place-items: center; padding: 1.6rem; box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 22px 44px -18px rgba(10,25,47,0.16); transition: transform 0.5s var(--ease-spring), box-shadow 0.5s; }
    .elm-item:hover .elm-vis { transform: translateY(-4px); box-shadow: 0 2px 4px rgba(10,25,47,0.05), 0 32px 60px -20px rgba(10,25,47,0.22); }
    .elm-t { margin: 1.4rem 0 0.5rem; padding-left: 12px; border-left: 2px solid #f59e0b; font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; color: #050505; }
    .elm-d { margin: 0; padding-left: 14px; font-size: 0.9rem; line-height: 1.6; color: var(--color-text-muted); }

    /* Mockups del carrusel */
    .mk { width: 100%; max-width: 360px; font-size: 0.74rem; color: #0a192f; }
    .mk-builder { padding: 16px; border-radius: 14px; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.08); }
    .mk-h { margin: 0 0 10px; font-weight: 700; font-size: 0.86rem; }
    .mk-builder label { display: block; font-size: 0.64rem; color: #8a93a2; font-weight: 600; margin-bottom: 10px; }
    .mk-in { display: flex; justify-content: space-between; align-items: center; margin-top: 4px; padding: 7px 10px; border-radius: 8px; background: #f5f5f7; color: #0a192f; font-size: 0.74rem; font-weight: 500; }
    .mk-in i { width: 6px; height: 6px; border-right: 1.5px solid #8a93a2; border-bottom: 1.5px solid #8a93a2; transform: rotate(45deg) translateY(-2px); }
    .mk-row { display: grid; grid-template-columns: 1fr 36px 80px; gap: 6px; padding: 7px 0; border-top: 1px solid #f1f2f5; text-align: right; }
    .mk-row span { text-align: left; }
    .mk-row em { font-style: normal; color: #8a93a2; }
    .mk-add { padding: 7px 0; border-top: 1px dashed #d8dce3; color: #2f6df0; font-weight: 600; }
    .mk-tot { display: flex; justify-content: space-between; align-items: baseline; margin: 6px 0 10px; color: #8a93a2; }
    .mk-tot b { font-size: 1.05rem; color: #0a192f; }
    .mk-btn { display: block; text-align: center; padding: 8px 0; border-radius: 99px; background: #0d1b33; color: #fff; font-weight: 600; }
    .mk-term { padding: 14px 16px; border-radius: 14px; background: #0b1526; color: #dbe4f0; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.68rem; }
