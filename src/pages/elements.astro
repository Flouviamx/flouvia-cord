---
// /elements — Cord Elements: el SDK para llevar las cotizaciones de Cord al
// sitio de un tercero. Misma familia visual que /producto y /desarrolladores
// (hero 100dvh con banda diagonal, bento de tarjetas blancas, FAQ, cross-links de /producto) más lo
// que necesita un SDK: el hero es una calca 1:1 de /embed/demo dentro del
// portal de un cliente con su consola de eventos, instalación por stack, y un
// explorador de TODO lo que exporta el paquete — cada nombre de esta página
// existe en packages/elements/src (verifícalo ahí antes de editar el copy).
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/landing/Nav.astro';
import Footer from '../components/landing/Footer.astro';
import PageAnims from '../components/landing/PageAnims.astro';
import FaqAccordion from '../components/landing/FaqAccordion.astro';
import DevHeroBand from '../components/desarrolladores/DevHeroBand.astro';
import DevMore from '../components/desarrolladores/DevMore.astro';
import ElementsHeroVisual from '../components/elements/ElementsHeroVisual.astro';
import ElementsAppearance from '../components/elements/ElementsAppearance.astro';
import ElementsCountry from '../components/elements/ElementsCountry.astro';
import ElementsMore from '../components/elements/ElementsMore.astro';
import { getLangFromUrl, publicPath } from '../i18n/utils';
import { DEV_PAGES } from '../lib/desarrolladores';
import { DEV_PAGES_EN } from '../lib/desarrolladores.en';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const l = (p: string) => publicPath(p, lang);
const tx = (es: string, en: string) => (isEn ? en : es);
const pages = isEn ? DEV_PAGES_EN : DEV_PAGES;
const devPage = pages.find((p) => p.slug === 'elements')!;

// ── Resaltado mínimo de código en build (sin dependencias) ──
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const TOK = /(\/\/.*$|<!--.*?-->)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|`[^`]*`)|(=>)|(<\/?[A-Za-z][\w.-]*|\/?>)|\b(import|from|export|default|function|return|const|async|await|if|new|try|catch|true|false)\b|(\b[A-Za-z_$][\w$]*(?=\())/g;
const hl = (line: string) => {
    let out = '';
    let last = 0;
    for (const m of line.matchAll(TOK)) {
        out += esc(line.slice(last, m.index));
        const cls = m[1] ? 'c-com' : m[2] ? 'c-str' : m[3] ? 'c-op' : m[4] ? 'c-tag' : m[5] ? 'c-kw' : 'c-fn';
        out += `<span class="${cls}">${esc(m[0])}</span>`;
        last = (m.index ?? 0) + m[0].length;
    }
    return out + esc(line.slice(last));
};
const lines = (code: string) => code.split('\n').map((t) => ({ raw: t, html: hl(t) || ' ' }));

const favicon = (domain: string) => `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${domain}&size=128`;

// ── Snippets por stack. `hi` = línea que "conecta" Cord (se resalta). ──
// Todos usan API real: CordCotizador (react/vue), <cord-quote> (Web
// Component, eventos sin prefijo cord:), FramerCordCotizador, embed.js.
const CODES = [
    {
        id: 'html', label: 'HTML', file: 'index.html', hi: 1,
        code: `<!-- ${tx('WordPress, Shopify, PHP o HTML plano', 'WordPress, Shopify, PHP or plain HTML')} -->
<script src="https://cordhq.app/embed.js" async></script>
<div data-cord-token="${tx('TU_TOKEN', 'YOUR_TOKEN')}"></div>`,
    },
    {
        id: 'react', label: 'React', file: 'Cotizacion.jsx', domain: 'react.dev', hi: 0,
        code: `import { CordCotizador } from '@flouviahq/elements/react';

export function Cotizacion({ token }) {
  return (
    <CordCotizador
      token={token}
      appearance={{ theme: 'auto' }}
      onApproved={(d) => console.log('${tx('Firmada por', 'Signed by')}', d.signed_by)}
      onPay={(d) => console.log('${tx('Pago abierto en', 'Payment opened at')}', d.url)}
    />
  );
}`,
    },
    {
        id: 'next', label: 'Next.js', file: 'app/cotizacion/page.tsx', domain: 'nextjs.org', hi: 1,
        code: `'use client';
import { CordCotizador } from '@flouviahq/elements/react';

export default function Page({ params }) {
  return (
    <CordCotizador
      token={params.token}
      onApproved={(d) => track('quote_signed', d.hash)}
    />
  );
}`,
    },
    {
        id: 'vue', label: 'Vue', file: 'Cotizacion.vue', domain: 'vuejs.org', hi: 1,
        code: `<script setup>
import { CordCotizador } from '@flouviahq/elements/vue';
const props = defineProps({ token: String });
const onApproved = (d) => console.log(d.signed_by);
</script>

<template>
  <CordCotizador :token="props.token" @approved="onApproved" />
</template>`,
    },
    {
        id: 'astro', label: 'Astro', file: 'Cotizacion.astro', domain: 'astro.build', hi: 6,
        code: `---
const { token } = Astro.props;
---
<cord-quote token={token} min-height="500"></cord-quote>

<script>
  import '@flouviahq/elements'; // ${tx('registra', 'registers')} <cord-quote>
  document.querySelector('cord-quote')
    ?.addEventListener('approved', (e) => console.log(e.detail));
</script>`,
    },
    {
        id: 'framer', label: 'Framer', file: 'Cotizador.tsx', domain: 'framer.com', hi: 1,
        code: `// ${tx('Code File nuevo en tu proyecto de Framer', 'New Code File in your Framer project')}
import { FramerCordCotizador } from '@flouviahq/elements/framer';

// ${tx('token y baseUrl aparecen en el panel de propiedades', 'token and baseUrl show up in the properties panel')}
export default FramerCordCotizador;`,
    },
    {
        id: 'webflow', label: 'Webflow', file: 'Custom code', domain: 'webflow.com', hi: 1,
        code: `<!-- ${tx('Ajustes del sitio › Custom code, antes de </body>', 'Site settings › Custom code, before </body>')} -->
<script src="https://cordhq.app/embed.js" async></script>

<!-- ${tx('En un Div Block, agrega el atributo personalizado', 'On a Div Block, add the custom attribute')} -->
<div data-cord-token="${tx('TU_TOKEN', 'YOUR_TOKEN')}"></div>`,
    },
].map((c) => ({ ...c, lines: lines(c.code) }));

// ── Explorador del SDK: cada export real del paquete, por punto de entrada ──
type Kind = 'component' | 'hook' | 'fn' | 'class' | 'attr' | 'event';
const KIND: Record<Kind, string> = {
    component: tx('Componente', 'Component'),
    hook: 'Hook',
    fn: tx('Función', 'Function'),
    class: tx('Clase', 'Class'),
    attr: tx('Atributo', 'Attribute'),
    event: tx('Evento', 'Event'),
};
const SDK: { id: string; path: string; label: string; lead: string; items: { n: string; k: Kind; d: string }[] }[] = [
    {
        id: 'react', path: '@flouviahq/elements/react', label: 'React',
        lead: tx('Componentes y hooks para React 17 o superior y Next.js. Ya trae la directiva "use client".', 'Components and hooks for React 17 or later and Next.js. It already ships the "use client" directive.'),
        items: [
            { n: '<CordCotizador>', k: 'component', d: tx('Muestra una cotización ya creada para que el cliente la vea, apruebe, negocie o pague. Callbacks tipados para cada evento y onStateChange con el estado en vivo.', 'Shows an existing quote so the client can view, approve, negotiate or pay. Typed callbacks for every event and onStateChange with the live state.') },
            { n: '<CordInvoice>', k: 'component', d: tx('La factura de /i/{token}: saldo, estado, partidas y PDF. El pago se abre en una ventana de Cord y onPaid avisa cuando se salda.', 'The invoice at /i/{token}: balance, status, line items and PDF. Payment opens in a Cord window and onPaid tells you when it is settled.') },
            { n: '<CordBuilder>', k: 'component', d: tx('Formulario listo para armar una cotización nueva, con las divisas, impuestos por línea y términos de tu cuenta. Compuesto: Header, Config, Items, Notes, Summary y SubmitButton.', 'A ready-made form to build a new quote, with your account\'s currencies, per-line taxes and terms. Compound: Header, Config, Items, Notes, Summary and SubmitButton.') },
            { n: '<CordFiscalForm>', k: 'component', d: tx('Datos fiscales del receptor con el mismo validador que el servidor: RFC con dígito verificador, régimen y uso de CFDI por tipo de persona; NIF/CIF en España, EIN en EE.UU.', 'Recipient tax details with the same validator as the server: RFC with check digit, tax regime and CFDI use by person type; NIF/CIF in Spain, EIN in the US.') },
            { n: '<CordProvider>', k: 'component', d: tx('Configura una vez: publishableKey o proxyUrl (nunca los dos), locale es o en, appearance y debug.', 'Configure once: publishableKey or proxyUrl (never both), locale es or en, appearance and debug.') },
            { n: 'useQuoteBuilder()', k: 'hook', d: tx('El estado del builder sin UI: partidas con key, cliente, moneda, totales con desglose por tasa y retenciones, validación y builder.submit().', 'The builder state with no UI: keyed line items, client, currency, totals with per-rate breakdown and withholdings, validation and builder.submit().') },
            { n: 'useCreateQuote()', k: 'hook', d: tx('Crea una cotización por tu proxy o con tu pk_ y te devuelve folio, token y link público. Un doble clic no la duplica.', 'Creates a quote through your proxy or with your pk_ and returns its number, token and public link. A double click never duplicates it.') },
            { n: 'useCordCatalog()', k: 'hook', d: tx('Tu catálogo de productos. El servidor oculta costo y margen a una llave pública.', 'Your product catalog. The server hides cost and margin from a publishable key.') },
            { n: 'useCordClients()', k: 'hook', d: tx('Tu directorio de clientes, sólo en modo proxy: con una pk_ responde clients_require_proxy sin tocar la red.', 'Your client directory, proxy mode only: with a pk_ it answers clients_require_proxy without touching the network.') },
        ],
    },
    {
        id: 'wc', path: '@flouviahq/elements', label: 'Web Components',
        lead: tx('Importarlo registra los elementos en Shadow DOM: tu CSS no los rompe y el suyo no toca tu página. Funciona en Astro, Svelte, Laravel, Rails o cualquier HTML.', 'Importing it registers the elements in Shadow DOM: your CSS can\'t break them and theirs never touches your page. Works in Astro, Svelte, Laravel, Rails or any HTML.'),
        items: [
            { n: '<cord-quote>', k: 'component', d: tx('Atributos token, base-url, min-height, appearance y debug. Los eventos llegan sin el prefijo: approved, pay, rejected. <cord-cotizador> sigue como alias.', 'Attributes token, base-url, min-height, appearance and debug. Events arrive without the prefix: approved, pay, rejected. <cord-cotizador> still works as an alias.') },
            { n: '<cord-invoice>', k: 'component', d: tx('La factura embebida con los mismos atributos. Emite además paid.', 'The embedded invoice with the same attributes. It also emits paid.') },
            { n: '<cord-fiscal-form>', k: 'component', d: tx('Elemento de formulario nativo: dentro de tu <form> aporta los datos fiscales y bloquea el envío mientras haya errores.', 'A native form element: inside your <form> it contributes the tax details and blocks submission while there are errors.') },
            { n: 'mountCotizador()', k: 'fn', d: tx('Monta el iframe en el elemento que le pases (document: "invoice" para una factura) y devuelve un controlador con destroy().', 'Mounts the iframe on any element you pass (document: "invoice" for an invoice) and returns a controller with destroy().') },
            { n: 'calculateDocumentTotals()', k: 'fn', d: tx('El mismo motor de totales que Cord usa en servidor: impuesto por línea, varias tasas y retenciones. Tu UI nunca muestra un total distinto.', 'The same totals engine Cord runs on the server: per-line tax, multiple rates and withholdings. Your own UI never shows a different total.') },
            { n: 'CordError', k: 'class', d: tx('Todo error trae status, un code estable, request_id y doc_url con la explicación.', 'Every error carries a status, a stable code, its request_id and a doc_url with the explanation.') },
            { n: 'enableDebug()', k: 'fn', d: tx('Barra de depuración en tu sitio con eventos, peticiones y avisos. Solo aparece con llaves pk_test_.', 'A debug bar on your site with events, requests and warnings. It only shows with pk_test_ keys.') },
        ],
    },
    {
        id: 'headless', path: '@flouviahq/elements/headless', label: 'Headless',
        lead: tx('El núcleo sin framework sobre el que están hechos React, Vue y los Web Components. Sin efectos al importar.', 'The framework-free core React, Vue and the Web Components are built on. No side effects on import.'),
        items: [
            { n: 'createQuoteBuilder()', k: 'fn', d: tx('Estado y acciones del cotizador: addProduct, updateItem, setMoneda, validate y submit, con suscripción a cambios.', 'Quote builder state and actions: addProduct, updateItem, setMoneda, validate and submit, with change subscriptions.') },
            { n: 'builder.draftWithAi()', k: 'fn', d: tx('Arma un borrador de partidas desde texto, en streaming. Llegan marcadas como sugeridas para que el cliente las revise.', 'Drafts line items from text, streamed. They arrive marked as suggested so the client reviews them.') },
            { n: 'createCordClient()', k: 'fn', d: tx('Cliente HTTP con reintentos, Idempotency-Key automática y la configuración de tu cuenta en caché con ETag.', 'HTTP client with retries, automatic Idempotency-Key and your account configuration cached with ETag.') },
            { n: 'createFiscalForm()', k: 'fn', d: tx('El formulario fiscal sin UI, con los catálogos del SAT y los validadores de RFC, NIF y EIN.', 'The tax form with no UI, with the SAT catalogs and the RFC, NIF and EIN validators.') },
        ],
    },
    {
        id: 'more', path: '/vue · /framer · /webflow', label: 'Vue, Framer, Webflow',
        lead: tx('Wrappers nativos para que cada plataforma lo sienta propio.', 'Native wrappers so each platform feels at home.'),
        items: [
            { n: 'CordCotizador · CordInvoice (Vue)', k: 'component', d: tx('Props token, baseUrl, minHeight y appearance; emiten cada evento (approved, pay, updated, status-changed, paid…) y state con el estado en vivo.', 'Props token, baseUrl, minHeight and appearance; they emit every event (approved, pay, updated, status-changed, paid…) and state with the live state.') },
            { n: 'useCordQuoteBuilder()', k: 'hook', d: tx('El builder headless como composable de Vue.', 'The headless builder as a Vue composable.') },
            { n: 'FramerCordCotizador', k: 'component', d: tx('Code Component con token y baseUrl editables desde el panel de propiedades de Framer.', 'A Code Component with token and baseUrl editable from the Framer properties panel.') },
            { n: 'data-cord-token', k: 'attr', d: tx('Webflow o HTML: agrega el atributo a cualquier Div Block y el script lo monta solo.', 'Webflow or HTML: add the attribute to any Div Block and the script mounts it on its own.') },
            { n: 'data-cord-document', k: 'attr', d: tx('"invoice" para mostrar una factura en vez de una cotización.', '"invoice" to show an invoice instead of a quote.') },
            { n: 'data-cord-appearance', k: 'attr', d: tx('El mismo objeto appearance en JSON: tema, variables, rules y layout.', 'The same appearance object as JSON: theme, variables, rules and layout.') },
        ],
    },
    {
        id: 'events', path: tx('Eventos del iframe', 'Iframe events'), label: tx('11 eventos', '11 events'),
        lead: tx('Los mismos en React, Vue, los Web Components y embed.js. Sin dominios autorizados llegan sin datos.', 'The same in React, Vue, the Web Components and embed.js. Without authorized domains they arrive without data.'),
        items: [
            { n: 'cord:ready', k: 'event', d: tx('Terminó de cargar: { status, folio, moneda, total }.', 'Finished loading: { status, folio, moneda, total }.') },
            { n: 'cord:viewed', k: 'event', d: tx('El cliente abrió el documento.', 'The client opened the document.') },
            { n: 'cord:approved', k: 'event', d: tx('Aprobó y firmó: { signed_by, hash }.', 'Approved and signed: { signed_by, hash }.') },
            { n: 'cord:signed', k: 'event', d: tx('Se emite junto con approved, por la misma acción: no lo cuentes dos veces.', 'Fires together with approved, for the same action: do not count it twice.') },
            { n: 'cord:rejected', k: 'event', d: tx('La rechazó: { comentario }.', 'Rejected it: { comentario }.') },
            { n: 'cord:message', k: 'event', d: tx('Escribió o hizo una contraoferta: { action, mensaje, propuesta }.', 'Wrote or made a counteroffer: { action, mensaje, propuesta }.') },
            { n: 'cord:item_comment', k: 'event', d: tx('Comentó una partida: { item_id, mensaje }.', 'Commented on a line item: { item_id, mensaje }.') },
            { n: 'cord:pay', k: 'event', d: tx('Pulsó pagar. Cord ya abrió el cobro en su ventana; { url } es solo un aviso.', 'Hit pay. Cord already opened the payment in its window; { url } is a notice only.') },
            { n: 'cord:updated', k: 'event', d: tx('El vendedor cambió la cotización mientras estaba abierta: { subtotal, total, moneda }.', 'The seller changed the quote while it was open: { subtotal, total, moneda }.') },
            { n: 'cord:status_changed', k: 'event', d: tx('Cambió el estado: { status }.', 'The status changed: { status }.') },
            { n: 'cord:paid', k: 'event', d: tx('Solo factura: quedó saldada. { folio, moneda, saldo }.', 'Invoice only: it was settled. { folio, moneda, saldo }.') },
        ],
    },
];


const STACK = [
    { label: 'HTML' }, { label: 'React', domain: 'react.dev' }, { label: 'Next.js', domain: 'nextjs.org' },
    { label: 'Vue', domain: 'vuejs.org' }, { label: 'Astro', domain: 'astro.build' }, { label: 'Framer', domain: 'framer.com' },
    { label: 'Webflow', domain: 'webflow.com' }, { label: 'WordPress', domain: 'wordpress.org' }, { label: 'Shopify', domain: 'shopify.com' },
];

const HEADLESS_CODE = lines(`const { items, totals, builder, formatMoney } =
  useQuoteBuilder({ catalog, onQuoteCreated });

return (
  <form onSubmit={(e) => { e.preventDefault(); builder.submit(); }}>
    {items.map((it) => (
      <MiFila key={it.key} item={it}
        onChange={(v) => builder.updateItem(it.key, v)} />
    ))}
    <MiTotal value={formatMoney(totals.total)} />
  </form>
);`);


// ── Datos estructurados ──
const SITE = 'https://cordhq.app';
const base = isEn ? `${SITE}/en` : SITE;
const faqSchema = {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: devPage.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: tx('Desarrolladores', 'Developers'), item: `${base}/desarrolladores/api` },
        { '@type': 'ListItem', position: 3, name: 'Cord Elements', item: `${base}/elements` },
    ],
};
const sdkSchema = {
    '@context': 'https://schema.org', '@type': 'SoftwareSourceCode',
    name: '@flouviahq/elements',
    description: devPage.metaDescription,
    codeRepository: 'https://www.npmjs.com/package/@flouviahq/elements',
    programmingLanguage: ['TypeScript', 'JavaScript'],
    runtimePlatform: ['Browser', 'Node.js', 'React', 'Vue'],
    license: 'https://opensource.org/licenses/MIT',
    author: { '@type': 'Organization', name: 'Cord', url: SITE },
    dateModified: devPage.updated,
};
const howToSchema = {
    '@context': 'https://schema.org', '@type': 'HowTo',
    name: tx('Cómo embeber una cotización de Cord en tu sitio', 'How to embed a Cord quote on your site'),
    step: (devPage.steps ?? []).map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.titulo, text: s.copy })),
};
---

<Layout title={devPage.metaTitle!} description={devPage.metaDescription!}>
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(sdkSchema)} />
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
    <Nav />
    <main>
        <!-- ════════ HERO ════════ -->
        <section class="pp-hero">
            <div class="pp-hero-mesh" aria-hidden="true"></div>
            <DevHeroBand />
            <div class="pp-hero-inner">
                <div class="pp-hero-text">
                    <p class="el-kicker reveal">{devPage.eyebrow}</p>
                    <h1 class="pp-title masked-title" set:html={devPage.titulo} />
                    <p class="pp-sub reveal">{devPage.sub}</p>
                    <div class="pp-actions reveal">
                        <a href={l('/registro')} class="pp-btn-primary">
                            <span>{tx('Empezar gratis', 'Start for free')}</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                        <a href="#sdk" class="pp-btn-ghost">{tx('Explorar el SDK', 'Explore the SDK')}</a>
                    </div>
                    <div class="el-cmd reveal" data-install-cmd>
                        <code><span class="el-cmd-prompt">$</span>npm install @flouviahq/elements</code>
                        <button class="el-cmd-copy" type="button" aria-label={tx('Copiar comando', 'Copy command')}>
                            <svg class="cp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                            <svg class="cp-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                            <span class="cp-tip" aria-hidden="true">{tx('Copiado', 'Copied')}</span>
                        </button>
                    </div>
                    <p class="pp-plan reveal">{devPage.plan}</p>
                </div>

                <div class="pp-hero-visual">
                    <div class="reveal-mockup"><div class="pp-mockup"><ElementsHeroVisual isEn={isEn} /></div></div>
                </div>
            </div>
        </section>

        <!-- ════════ STACK ════════ -->
        <section class="el-stack" aria-label={tx('Plataformas compatibles', 'Supported platforms')}>
            <p class="el-stack-t reveal">{tx('Funciona donde ya vive tu cliente', 'Works where your client already lives')}</p>
            <ul class="el-stack-row">
                {STACK.map((s) => (
                    <li class="reveal">
                        {s.domain ? <img src={favicon(s.domain)} alt="" width="20" height="20" loading="lazy" /> : (
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="8 5 3 12 8 19"/><polyline points="16 5 21 12 16 19"/></svg>
                        )}
                        <span>{s.label}</span>
                    </li>
                ))}
            </ul>
        </section>

        <!-- ════════ INSTALAR ════════ -->
        <section class="eli" id="instalar">
            <div class="eli-head">
                <h2 class="el-h2 masked-title">{tx('Elige tu stack. El resultado es el mismo.', 'Pick your stack. The result is the same.')}</h2>
                <p class="el-lead reveal">{tx('Cambia sólo cómo cargas el cotizador. La cotización, tu marca y los eventos son idénticos en todos.', 'Only the way you load the quote builder changes. The quote, your brand and the events are identical in every one.')}</p>
            </div>
            <div class="eli-card reveal-mockup" data-el-tabs>
