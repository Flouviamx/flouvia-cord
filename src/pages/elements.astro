// ── Datos estructurados ──
const SITE = 'https://cordhq.app';
const base = isEn ? `${SITE}/en` : SITE;
const faqSchema = {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: devPage.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: tx('Desarrolladores', 'Developers'), item: `${base}/desarrolladores/api` },
        { '@type': 'ListItem', position: 3, name: 'Cord Elements', item: `${base}/elements` },
    ],
};
const sdkSchema = {
    '@context': 'https://schema.org', '@type': 'SoftwareSourceCode',
    name: '@flouviahq/elements',
    description: devPage.metaDescription,
    codeRepository: 'https://www.npmjs.com/package/@flouviahq/elements',
    programmingLanguage: ['TypeScript', 'JavaScript'],
    runtimePlatform: ['Browser', 'Node.js', 'React', 'Vue'],
    license: 'https://opensource.org/licenses/MIT',
    author: { '@type': 'Organization', name: 'Cord', url: SITE },
