    .el-cmd-copy.done .cp-ico { opacity: 0; transform: scale(0.4) rotate(20deg); }
    .el-cmd-copy.done .cp-ok { opacity: 1; transform: none; animation: cpDraw 0.42s 0.08s ease-out forwards; }
    .el-cmd-copy::before { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 0 rgba(16,185,129,0.55); pointer-events: none; }
    .el-cmd-copy.done::before { animation: cpRing 0.75s ease-out; }
    .cp-tip { position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translate(-50%, 6px) scale(0.9); padding: 5px 10px; border-radius: 8px; background: #0a192f; color: #fff; font: 600 0.72rem var(--font-sans); white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.4s var(--ease-spring); }
    .cp-tip::after { content: ''; position: absolute; top: 100%; left: 50%; margin-left: -5px; border: 5px solid transparent; border-top-color: #0a192f; }
    .el-cmd-copy.done .cp-tip { opacity: 1; transform: translate(-50%, 0) scale(1); }
    @keyframes cpPop { 0% { transform: scale(1); } 35% { transform: scale(0.86); } 70% { transform: scale(1.1); } 100% { transform: scale(1); } }
    @keyframes cpDraw { to { stroke-dashoffset: 0; } }
    @keyframes cpRing { from { box-shadow: 0 0 0 0 rgba(16,185,129,0.55); } to { box-shadow: 0 0 0 12px rgba(16,185,129,0); } }
    .el-copybtn .cp-swap { position: relative; width: 13px; height: 13px; display: inline-grid; }
    .el-copybtn .cp-swap svg { grid-area: 1 / 1; transition: transform 0.4s var(--ease-spring), opacity 0.2s; }
    .el-copybtn .cp-ok { opacity: 0; transform: scale(0.4); stroke-dasharray: 24; stroke-dashoffset: 24; }
    .el-copybtn.done .cp-ico { opacity: 0; transform: scale(0.4); }
    .el-copybtn.done .cp-ok { opacity: 1; transform: none; animation: cpDraw 0.4s 0.06s ease-out forwards; }
    .el-copybtn.done { background: rgba(16,185,129,0.16); animation: cpPop 0.45s var(--ease-spring); }
    @media (prefers-reduced-motion: reduce) {
        .el-cmd.done::after, .el-cmd-copy.done, .el-cmd-copy.done::before, .el-copybtn.done { animation: none; }
        .el-cmd-copy.done .cp-ok, .el-copybtn.done .cp-ok { animation: none; stroke-dashoffset: 0; }
    }

    .elq-logo { width: 22px; height: 22px; border-radius: 6px; background: #0d1b33; color: #fff; display: grid; place-items: center; font-size: 0.56rem; font-weight: 700; flex-shrink: 0; }

    /* ════════ STACK ════════ */
    .el-stack { max-width: 1200px; margin: 0 auto; padding: 1.5rem 5% 2rem; text-align: center; }
    .el-stack-t { font-size: 0.8rem; font-weight: 600; color: #8a93a2; margin: 0 0 1.3rem; }
    .el-stack-row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
    .el-stack-row li { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border-radius: 99px; background: #fff; font-size: 0.82rem; font-weight: 600; color: #3b4658; box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 8px 20px -14px rgba(10,25,47,0.2); }
    .el-stack-row img { width: 18px; height: 18px; border-radius: 4px; }
    .el-stack-row svg { width: 18px; height: 18px; color: #e34f26; }

    /* ════════ COMPARTIDOS ════════ */
    .el-h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.035em; color: #050505; margin: 0 0 1rem; }
    .el-lead, .el-copy { font-size: 1.02rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }
    /* Encabezado de sección: título a la izquierda, texto a la derecha */
    .eli-head { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 1.5rem 4rem; align-items: end; margin: 0 0 3rem; text-align: left; }
    .eli-head .el-h2 { margin: 0; max-width: 620px; }
    .eli-head .el-lead { max-width: 460px; justify-self: end; }

    /* Código (oscuro, igual que los snippets del resto del sitio) */
    .el-code { background: #0b1526; border-radius: 16px; overflow: hidden; min-width: 0; box-shadow: 0 30px 70px -36px rgba(5,11,20,0.6), inset 0 0 0 1px rgba(255,255,255,0.05); }
    .el-code-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 14px; border-bottom: 1px solid rgba(255,255,255,0.07); }
    .el-code-file { display: inline-flex; align-items: center; gap: 8px; min-width: 0; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.74rem; color: rgba(255,255,255,0.62); white-space: nowrap; overflow: hidden; }
    .el-code-file svg { width: 14px; height: 14px; flex-shrink: 0; color: rgba(255,255,255,0.4); }
    .el-copybtn { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; font: 600 0.72rem var(--font-sans); color: rgba(255,255,255,0.65); background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 5px 10px; cursor: pointer; transition: background 0.2s, color 0.2s; }
    .el-copybtn svg { width: 13px; height: 13px; display: block; }
    .el-copybtn:hover { background: rgba(255,255,255,0.12); color: #fff; }
    .el-copybtn.done { color: #6ee7b7; border-color: rgba(110,231,183,0.4); }
    .el-panel { padding: 0.9rem 0 1.1rem; overflow-x: auto; }
    .el-panel[hidden] { display: none; }
    .el-cl { display: flex; padding: 0 1.2rem; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.8rem; line-height: 1.85; white-space: pre; }
    .el-ln { flex-shrink: 0; width: 22px; text-align: right; margin-right: 16px; color: rgba(255,255,255,0.2); user-select: none; }
    .el-lc { color: #dbe4f0; }
    .el-cl-hl { background: rgba(59,130,246,0.13); box-shadow: inset 2px 0 0 #3b82f6; }
    :global(.c-com) { color: #6b7a90; }
    :global(.c-str) { color: #a5d6a7; }
    :global(.c-tag) { color: #93c5fd; }
    :global(.c-kw) { color: #c4b5fd; }
    :global(.c-fn) { color: #fcd34d; }
    :global(.c-op) { color: #f9a8d4; }

    /* ════════ INSTALAR ════════ */
    .eli { max-width: 1200px; margin: 0 auto; padding: 5rem 5% 2rem; }
    .eli-card { background: #fff; border-radius: 28px; padding: 1.4rem; box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 28px 56px -16px rgba(10,25,47,0.14); }
    .eli-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; padding: 0.2rem 0.2rem 1.2rem; }
    .eli-tab { display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 99px; border: 0; cursor: pointer; background: #f5f5f7; font: 600 0.8rem var(--font-sans); color: #5b6575; transition: background 0.25s, color 0.25s, box-shadow 0.25s; }
    .eli-tab img { width: 16px; height: 16px; border-radius: 4px; }
    .eli-tab svg { width: 16px; height: 16px; color: #e34f26; }
    .eli-tab:hover { color: #0a192f; background: #eceef2; }
    .eli-tab.active { background: #0a192f; color: #fff; box-shadow: 0 8px 20px -10px rgba(10,25,47,0.6); }
    .eli-tab:focus-visible, .els-tab:focus-visible { outline: 2px solid #2f6df0; outline-offset: 2px; }
    .eli-body { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 1.4rem; align-items: stretch; }
    .eli-steps { list-style: none; margin: 0; padding: 1rem 1rem 1rem 0.8rem; display: flex; flex-direction: column; justify-content: center; gap: 1.6rem; }
    .eli-steps li { display: flex; gap: 14px; }
    .eli-n { flex-shrink: 0; font-family: ui-monospace, monospace; font-size: 0.72rem; font-weight: 700; color: #99a2af; padding-top: 3px; }
    .eli-steps b { display: block; font-size: 1rem; font-weight: 700; letter-spacing: -0.02em; color: #050505; margin-bottom: 4px; }
    .eli-steps p { margin: 0; font-size: 0.88rem; line-height: 1.55; color: var(--color-text-muted); }

    /* ════════ BENTO (idéntico a /producto) ════════ */
    .pp-bento { max-width: 1360px; margin: 0 auto; padding: 6rem 5% 5rem; display: grid; grid-template-columns: 5fr 7fr; gap: 1.2rem; }
    .pp-bcard-2, .pp-bcard-3 { grid-column: 1 / -1; }
    .pp-bcard {
        background: #fff; border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; min-height: 540px;
        box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 28px 56px -16px rgba(10,25,47,0.14), inset 0 1px 0 rgba(255,255,255,0.6);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    .pp-bcard:hover { transform: translateY(-6px); box-shadow: 0 2px 4px rgba(10,25,47,0.05), 0 38px 72px -18px rgba(10,25,47,0.2), inset 0 1px 0 rgba(255,255,255,0.6); }
    .pp-bcard-2, .pp-bcard-3 { flex-direction: row; min-height: 480px; }
    .pp-bcard-text { padding: 3rem 2.8rem 2rem; flex-shrink: 0; position: relative; z-index: 2; }
    .pp-bcard-2 .pp-bcard-text, .pp-bcard-3 .pp-bcard-text { flex: 0 0 40%; padding: 3.8rem 2.6rem 3.8rem 4rem; display: flex; flex-direction: column; justify-content: center; }
    .pp-bcard-visual { flex: 1; position: relative; overflow: hidden; min-height: 340px; background: #fff; }
    .pp-bcard-eyebrow { font-size: 0.6rem; font-weight: 800; letter-spacing: 2.8px; text-transform: uppercase; color: #b0b0b8; margin: 0 0 0.9rem; }
    .pp-bcard-h2 { font-size: clamp(1.35rem, 2.1vw, 1.85rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.035em; color: #050505; margin: 0 0 0.9rem; }
    .pp-bcard-copy { font-size: 0.875rem; line-height: 1.68; color: var(--color-text-muted); margin: 0 0 1.4rem; }
    .pp-bcard-bullets { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }
    .pp-bcard-bullets li { display: flex; align-items: flex-start; gap: 8px; font-size: 0.83rem; color: var(--color-text); font-weight: 500; line-height: 1.45; }
    .pp-bcard-bullets svg { width: 15px; height: 15px; color: var(--color-ok); flex-shrink: 0; margin-top: 1px; }

    /* Mockups del bento: ventanas claras sobre la tarjeta blanca */
    .elx { position: absolute; inset: 0; padding: 1.6rem 1.8rem 0; display: flex; flex-direction: column; align-items: center; }
    .pp-bcard-2 .elx, .pp-bcard-3 .elx { padding: 2rem 2.4rem; justify-content: center; }
    .elx-win { width: 100%; max-width: 560px; background: #fff; border-radius: 14px; box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 24px 50px -24px rgba(10,25,47,0.28), inset 0 0 0 1px rgba(10,25,47,0.07); overflow: hidden; }
    .elx-snip { padding: 10px 14px; background: #0b1526; color: #dbe4f0; font-family: ui-monospace, monospace; font-size: 0.68rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* 0 — carga y altura */
    .elx-0 .elx-win { background: #f5f5f7; }
    .elx0-frame { position: relative; margin: 14px; height: 150px; border-radius: 12px; background: #fff; box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 10px 24px -16px rgba(10,25,47,0.3); transition: height 0.7s cubic-bezier(.2,.8,.2,1); overflow: hidden; }
    .elx0-frame.grown { height: 228px; }
    .elx0-skel { position: absolute; inset: 0; padding: 16px; display: flex; flex-direction: column; gap: 10px; transition: opacity 0.35s; }
    .elx0-skel i { display: block; height: 12px; border-radius: 6px; background: linear-gradient(90deg, #f0f1f4 0%, #e5e7ec 40%, #f0f1f4 80%); background-size: 200% 100%; animation: elxShimmer 1.3s linear infinite; }
    .elx0-skel i:nth-child(1) { width: 45%; }
    .elx0-skel i:nth-child(2) { height: 36px; }
    .elx0-skel i:nth-child(3) { width: 80%; }
    .elx0-skel i:nth-child(4) { width: 60%; }
    .elx0-skel.gone { opacity: 0; }
    @keyframes elxShimmer { to { background-position: -200% 0; } }
    .elx0-mini { position: absolute; inset: 0; padding: 14px 16px; opacity: 0; transition: opacity 0.4s 0.15s; }
    .elx0-mini.on { opacity: 1; }
    .elx0-row { display: flex; align-items: center; gap: 8px; font-size: 0.72rem; margin-bottom: 12px; color: #0a192f; }
    .elx0-row em { margin-left: auto; font-style: normal; font-weight: 600; color: #5b6575; }
    .elx0-mini small { font-size: 0.5rem; letter-spacing: 0.22em; color: #a3aab6; font-weight: 600; }
    .elx0-mini strong { display: block; font-size: 1.35rem; letter-spacing: -0.04em; color: #0a192f; margin: 2px 0 10px; }
    .elx0-mini strong span { font-size: 0.6rem; color: #8a93a2; letter-spacing: 0; font-weight: 600; }
    .elx0-lines { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
    .elx0-lines i { height: 7px; border-radius: 4px; background: #f0f1f4; }
    .elx0-lines i:nth-child(2) { width: 82%; }
    .elx0-lines i:nth-child(3) { width: 64%; }
    .elx0-btn { display: block; text-align: center; padding: 7px 0; border-radius: 99px; background: #0d1b33; color: #fff; font-size: 0.66rem; font-weight: 600; }
    .elx0-ruler { margin: 0 14px 14px; padding: 7px 10px; border-radius: 8px; background: #fff; font-family: ui-monospace, monospace; font-size: 0.66rem; color: #5b6575; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.06); }
    .elx0-ruler .c-fn { color: #b45309; }
    .elx0-ruler b { color: #0a192f; }

    /* 2 — eventos */
    .elx2-win { max-width: 640px; }
    .elx2-head { display: flex; justify-content: space-between; align-items: center; padding: 11px 16px; border-bottom: 1px solid #eef0f3; font-size: 0.74rem; font-weight: 700; color: #0a192f; }
    .elx2-live { display: inline-flex; align-items: center; gap: 6px; font-size: 0.64rem; font-weight: 600; color: #059669; }
    .elx2-live i { width: 6px; height: 6px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,0.16); }
    .elx2-tbl { padding: 6px 0; }
    .elx2-r { display: grid; grid-template-columns: 62px 128px 1fr; gap: 10px; align-items: center; padding: 7px 16px; font-family: ui-monospace, monospace; font-size: 0.66rem; opacity: 0.15; transform: translateX(-6px); transition: opacity 0.4s, transform 0.4s, background 0.4s; }
    .elx2-r.on { opacity: 1; transform: none; }
    .elx2-r time { color: #a3aab6; }
    .elx2-r em { font-style: normal; color: #2f6df0; font-weight: 600; }
    .elx2-r span { color: #5b6575; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.6; }
    .elx2-r.is-ok.on { background: rgba(16,185,129,0.07); }
    .elx2-r.is-ok em { color: #059669; }
    .elx2-r.is-pay em { color: #b45309; }
    .elx2-code { padding: 10px 16px; background: #0b1526; color: #dbe4f0; font-family: ui-monospace, monospace; font-size: 0.66rem; }

    /* 3 — headless */
    .pp-bcard-2 .elx-3 { flex-direction: row; align-items: center; gap: 1.2rem; }
    .elx3-code { flex: 1.1; min-width: 0; padding: 14px 16px; border-radius: 14px; background: #0b1526; color: #dbe4f0; font-family: ui-monospace, monospace; font-size: 0.64rem; line-height: 1.75; white-space: pre; overflow: hidden; box-shadow: 0 24px 50px -28px rgba(5,11,20,0.6); }
    .elx3-l { min-height: 1.75em; overflow: hidden; text-overflow: ellipsis; }
    .elx3-ui { position: relative; flex: 0.9; min-width: 0; padding: 18px; border-radius: 6px; background: #fffaf3; border: 1.5px solid #1f2937; font-family: Georgia, 'Times New Roman', serif; color: #1f2937; box-shadow: 6px 6px 0 #1f2937; }
    .elx3-badge { position: absolute; top: -11px; left: 14px; padding: 2px 8px; background: #fbbf24; border: 1.5px solid #1f2937; font-family: var(--font-sans); font-size: 0.56rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .elx3-title { margin: 4px 0 12px; font-size: 0.92rem; font-weight: 700; }
    .elx3-row { display: grid; grid-template-columns: 1fr 44px 78px; gap: 6px; padding: 6px 0; border-bottom: 1px dashed #d6cfc2; font-size: 0.66rem; }
    .elx3-row b { text-align: right; font-weight: 400; }
    .elx3-row em { text-align: right; font-style: normal; }
    .elx3-tot { display: flex; justify-content: space-between; align-items: baseline; margin: 10px 0 12px; font-size: 0.66rem; }
    .elx3-tot strong { font-family: Georgia, serif; font-size: 1.05rem; }
    .elx3-btn { display: block; text-align: center; padding: 8px 0; background: #1f2937; color: #fffaf3; font-family: var(--font-sans); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.04em; }
    .elx3-toast { display: flex; align-items: center; gap: 7px; margin-top: 10px; padding: 7px 10px; background: #ecfdf5; border: 1px solid #a7f3d0; font-family: var(--font-sans); font-size: 0.64rem; font-weight: 600; color: #065f46; opacity: 0; transform: translateY(6px); transition: opacity 0.35s, transform 0.35s; }
    .elx3-toast svg { stroke: #059669; width: 11px; height: 11px; }
    .elx3-toast.on { opacity: 1; transform: none; }


    /* ════════ EXPLORADOR DEL SDK ════════ */
    .els { max-width: 1240px; margin: 0 auto; padding: 4rem 5% 6rem; }
    .els-card { display: grid; grid-template-columns: 300px 1fr; background: #fff; border-radius: 28px; overflow: hidden; box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 28px 56px -16px rgba(10,25,47,0.14); }
    .els-nav { display: flex; flex-direction: column; gap: 4px; padding: 1.2rem; background: #fafafb; border-right: 1px solid rgba(10,25,47,0.06); }
    .els-tab { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; text-align: left; padding: 12px 14px; border-radius: 14px; border: 0; background: transparent; cursor: pointer; transition: background 0.25s, box-shadow 0.25s; }
    .els-tab b { font: 700 0.9rem var(--font-sans); letter-spacing: -0.01em; color: #3b4658; }
    .els-tab code { grid-column: 1; font-family: ui-monospace, monospace; font-size: 0.66rem; color: #99a2af; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .els-tab span { grid-row: 1 / span 2; grid-column: 2; align-self: center; min-width: 24px; height: 24px; border-radius: 99px; display: grid; place-items: center; background: #eef0f3; font: 700 0.68rem var(--font-sans); color: #5b6575; }
    .els-tab:hover { background: #f1f2f5; }
    .els-tab.active { background: #fff; box-shadow: 0 1px 2px rgba(10,25,47,0.06), 0 10px 24px -14px rgba(10,25,47,0.25); }
    .els-tab.active b { color: #050505; }
    .els-tab.active span { background: #0a192f; color: #fff; }
    .els-panels { padding: 2rem 2.4rem 2.2rem; min-width: 0; }
    .els-panel[hidden] { display: none; }
    .els-lead { margin: 0 0 1.4rem; font-size: 0.92rem; line-height: 1.55; color: var(--color-text-muted); }
    .els-lead code { display: block; margin-bottom: 6px; font-family: ui-monospace, monospace; font-size: 0.84rem; font-weight: 600; color: #0a192f; }
    .els-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; }
    .els-list li { padding: 1rem 0; border-top: 1px solid var(--color-border); display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
    .els-name { font-family: ui-monospace, monospace; font-size: 0.82rem; font-weight: 600; color: #050505; }
    .els-kind { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 7px; border-radius: 99px; background: #f1f2f5; color: #5b6575; }
    .k-component { background: #eef4ff; color: #2f5fc4; }
    .k-hook { background: #f3efff; color: #6d4bc4; }
    .k-fn { background: #fff6e6; color: #a15c07; }
    .k-class { background: #eafaf3; color: #04785a; }
    .k-event { background: #ecfdf5; color: #047857; }
    .els-list p { flex-basis: 100%; margin: 0; font-size: 0.84rem; line-height: 1.55; color: var(--color-text-muted); }

    /* ════════ RESPONSIVE ════════ */
    @media (max-width: 1100px) {
        .els-card { grid-template-columns: 1fr; }
        .els-nav { flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid rgba(10,25,47,0.06); padding: 0.8rem; }
        .els-tab { flex: 0 0 auto; min-height: 44px; }
        .els-tab code { display: none; }
        .els-tab span { grid-row: 1; }
    }
    @media (max-width: 1000px) {
        .pp-hero { align-items: flex-start; padding-bottom: calc(var(--band-t) * 0.5); }
        .pp-hero-inner { grid-template-columns: 1fr; gap: 2.5rem; padding: 6rem 6% 3rem; }
        .pp-hero-visual { margin: 0; }
        .eli-body { grid-template-columns: 1fr; }
        .eli-steps { padding: 0.4rem 0.4rem 0.6rem; }
