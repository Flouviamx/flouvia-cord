    .mkc-iv-parties small { margin-top: 1px; font-size: 6.5px; color: #8a8f99; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-iv-lh { display: flex; justify-content: space-between; padding-bottom: 5px; border-bottom: 1px solid rgba(10,25,47,0.07); }
    .mkc-iv-lr { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 5px 0; border-bottom: 1px solid rgba(10,25,47,0.045); }
