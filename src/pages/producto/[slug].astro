    .mkc-iv-lr small { font-size: 6.5px; font-weight: 500; color: #9ca3af; }
    .mkc-iv-lr b { font-size: 8px; color: #4b5563; white-space: nowrap; }
    .mkc-iv-tots { margin-top: 8px; }
