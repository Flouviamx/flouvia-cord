    .mkc-zone-h > div { display: flex; flex-direction: column; gap: 3px; }
    .mkc-zone-h span { font-size: 7px; font-weight: 800; letter-spacing: 0.14em; color: #5b6472; }
    .mkc-zone-h b { font-size: 14px; font-weight: 680; letter-spacing: -0.035em; color: #0f1729; }
    .mkc-zone-h p { max-width: 190px; margin: 0; font-size: 9px; line-height: 1.45; color: #5b6472; text-align: right; }
    .mkc-sh { display: flex; flex-direction: column; gap: 2px; padding-bottom: 7px; margin-bottom: 8px; border-bottom: 1px solid rgba(10,25,47,0.07); }
    .mkc-sh b { display: flex; align-items: center; font-size: 11.5px; font-weight: 600; letter-spacing: -0.01em; color: #0f1729; }
    .mkc-sh > span { font-size: 9px; line-height: 1.4; color: #5b6472; }
    .mkc-sh-r { flex-direction: row; align-items: center; justify-content: space-between; }
    .mkc-sh-r em { font-style: normal; font-size: 9.5px; font-weight: 650; color: #0a192f; white-space: nowrap; }
    .mkc-kl { display: flex; align-items: center; font-size: 7.5px; font-weight: 800; letter-spacing: 1.1px; text-transform: uppercase; color: #5b6472; opacity: 0.85; white-space: nowrap; }
    .mkc-snap { display: inline-flex; margin-left: 5px; padding: 1px 5px; border-radius: 99px; background: #f5f5f7; font-style: normal; font-size: 6.5px; font-weight: 750; letter-spacing: 0.04em; text-transform: uppercase; color: #5b6472; }
    .mkc-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; flex: 0 0 auto; background: #10b981; }

    /* ── Pagos: el cliente paga en su teléfono y el cobro aparece en Cobros ── */
    .mkc-py { height: 500px; }
    .mkc-py-app { margin-left: 172px; min-width: 640px; height: 468px; }
    .mkc-py-phone { left: 0; top: 16px; }
