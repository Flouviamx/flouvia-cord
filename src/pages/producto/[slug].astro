    .mkc-eq-ra { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
    .mkc-eq-ra u { font-size: 8.5px; font-weight: 600; color: #0a192f; text-decoration: none; white-space: nowrap; }
    .mkc-eq-ra s, .mkc-eq-mh s { width: 20px; height: 20px; display: grid; place-items: center; color: #5b6472; text-decoration: none; border-radius: 6px; }
    .mkc-eq-ra s { color: #99a2af; }
    .mkc-eq-ra s svg, .mkc-eq-mh s svg { width: 10px; height: 10px; }
    .mkc-eq-org { visibility: hidden; opacity: 0; position: absolute; left: 12px; top: 50px; z-index: 6; width: 216px; display: flex; flex-direction: column; padding: 5px; background: #fff; border-radius: 12px; box-shadow: 0 30px 60px -12px rgba(10,25,47,0.3), 0 0 0 1px rgba(10,25,47,0.07); transform-origin: 8% 0; }
    .mkc-eq-ol { padding: 5px 7px 3px; font-size: 7.5px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: #5b6472; }
    .mkc-eq-oi { display: flex; align-items: center; gap: 7px; padding: 5px 6px; border-radius: 6px; }
    .mkc-eq-oi.sel { background: rgba(10,25,47,0.035); }
    .mkc-eq-oi > i { width: 20px; height: 20px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-style: normal; font-size: 8.5px; font-weight: 700; color: #fff; background: linear-gradient(135deg, #1b3a64, #0a192f); border-radius: 6px; }
    .mkc-eq-oi > i.alt { background: #475569; }
    .mkc-eq-oi > i.usr { color: #5b6472; background: #e9ebef; border-radius: 50%; }
    .mkc-eq-oi > span { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .mkc-eq-oi b { font-size: 9.5px; font-weight: 500; color: #0f1729; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-eq-oi small { font-size: 8px; color: #5b6472; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-eq-oi > svg { width: 11px; height: 11px; color: #0a192f; }
    .mkc-eq-kids { display: flex; flex-direction: column; margin: 1px 0 2px 16px; padding-left: 6px; border-left: 1px solid rgba(10,25,47,0.1); }
    .mkc-eq-kids .mkc-eq-oi > i { width: 16px; height: 16px; font-size: 7px; border-radius: 4px; }
    .mkc-eq-kids .mkc-eq-oi b { font-size: 9px; }
    .mkc-eq-od { height: 1px; margin: 4px 2px; background: rgba(10,25,47,0.07); }
    .mkc-eq-oa { display: flex; align-items: center; gap: 7px; padding: 5px 6px; font-size: 9.5px; font-weight: 500; color: #0f1729; }
    .mkc-eq-oa > svg { width: 12px; height: 12px; color: #5b6472; }
    .mkc-eq-oa > svg.c { width: 10px; height: 10px; margin-left: auto; opacity: 0.5; }
    .mkc-eq-oa.amber > svg { color: #d97706; }
    .mkc-eq-oa.red, .mkc-eq-oa.red > svg { color: #dc2626; }
    .mkc-eq-sw { position: relative; width: 22px; height: 13px; margin-left: auto; background: rgba(10,25,47,0.13); border-radius: 99px; }
    .mkc-eq-sw::after { content: ''; position: absolute; left: 2px; top: 2px; width: 9px; height: 9px; background: #fff; border-radius: 50%; box-shadow: 0 1px 2px rgba(10,25,47,0.25); }
    .mkc-eq-scrim { position: absolute; inset: 0; z-index: 7; background: rgba(10,25,47,0.28); border-radius: inherit; opacity: 0; visibility: hidden; }
    .mkc-eq-modal { position: absolute; left: 50%; top: 50%; z-index: 8; width: 300px; margin: -196px 0 0 -150px; overflow: hidden; background: #fff; border-radius: 16px; box-shadow: 0 30px 70px -20px rgba(10,25,47,0.55), 0 0 0 1px rgba(10,25,47,0.06); opacity: 0; visibility: hidden; }
    .mkc-eq-mh { display: flex; align-items: center; justify-content: space-between; padding: 12px 12px 9px 14px; border-bottom: 1px solid rgba(10,25,47,0.07); }
    .mkc-eq-mh b { font-size: 12px; font-weight: 700; letter-spacing: -0.02em; color: #0f1729; }
    .mkc-eq-mb { display: flex; flex-direction: column; padding: 10px 14px 6px; }
    .mkc-eq-mb label { margin-bottom: 4px; font-size: 8.5px; font-weight: 600; color: #0f1729; }
    .mkc-eq-in { min-height: 26px; display: flex; align-items: center; padding: 0 9px; font-size: 10px; color: #0f1729; background: #f5f5f7; border: 1px solid transparent; border-radius: 8px; }
    .mkc-eq-in.on { background: #fff; border-color: rgba(10,25,47,0.18); box-shadow: 0 0 0 3px rgba(10,25,47,0.06); }
    .mkc-eq-pre { display: flex; gap: 2px; margin-top: 10px; padding: 2px; background: #f5f5f7; border-radius: 9px; }
    .mkc-eq-pre i { flex: 1; text-align: center; font-style: normal; font-size: 8.5px; font-weight: 600; padding: 5px 3px; color: #5b6472; border-radius: 7px; white-space: nowrap; }
    .mkc-eq-pre i.on { color: #0f1729; background: #fff; box-shadow: 0 1px 3px rgba(10,25,47,0.1); }
    .mkc-eq-pd { margin: 6px 0 2px; font-size: 8px; line-height: 1.45; color: #5b6472; }
    .mkc-eq-g { margin-top: 7px; font-size: 6.5px; font-weight: 800; letter-spacing: 1.1px; text-transform: uppercase; color: #99a2af; }
    .mkc-eq-p { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 4px 0; border-top: 1px solid rgba(10,25,47,0.07); }
    .mkc-eq-g + .mkc-eq-p { border-top: 0; }
    .mkc-eq-p b { font-size: 9.5px; font-weight: 600; color: #0f1729; }
    .mkc-eq-p i { position: relative; width: 22px; height: 13px; flex-shrink: 0; background: #e3e5ea; border-radius: 99px; transition: background 0.25s; }
    .mkc-eq-p i::after { content: ''; position: absolute; left: 2px; top: 2px; width: 9px; height: 9px; background: #fff; border-radius: 50%; box-shadow: 0 1px 2px rgba(10,25,47,0.25); transition: transform 0.25s; }
    .mkc-eq-p i.on { background: #0a192f; }
    .mkc-eq-p i.on::after { transform: translateX(9px); }
    .mkc-eq-mf { display: flex; justify-content: flex-end; gap: 6px; padding: 10px 14px 12px; border-top: 1px solid rgba(10,25,47,0.07); }
    .mkc-eq-app .mkc-toast { z-index: 9; }



    /* ════════ STATS ════════ */
    .pp-stats {
        padding: 5.5rem 5%;
    }
    .pp-stats-inner {
        max-width: 800px; margin: 0 auto;
        display: flex; flex-direction: column;
    }
    .pp-stat { 
        display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
        padding: 1.6rem 0;
        border-bottom: 1px solid var(--color-border);
    }
    .pp-stat:first-child { border-top: 1px solid var(--color-border); }
    .pp-stat-label { font-size: 1.1rem; color: var(--color-text-muted); font-weight: 500; }
    .pp-stat-label::first-letter { text-transform: uppercase; }
    .pp-stat-dots {
        flex: 1; border-bottom: 1px dotted var(--color-border);
        opacity: 0.6; position: relative; top: -5px;
    }
    .pp-stat-num {
        font-size: 1.4rem; color: var(--color-text); font-weight: 600; letter-spacing: -0.02em;
    }

    /* ════════ BENTO GRID — ElevenLabs / Stripe style ════════ */
    .pp-bento {
        max-width: 1360px;
        margin: 0 auto;
        padding: 6rem 5% 5rem;
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: 1.2rem;
    }

    /* Cards 0 and 1 sit side-by-side; card 2+ span full width */
    .pp-bcard-2,
    .pp-bcard-3 {
        grid-column: 1 / -1;
    }

    .pp-bcard {
        background: #fff;
        border-radius: 28px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 540px;
        box-shadow:
            0 2px 4px rgba(10,25,47,0.04),
            0 28px 56px -16px rgba(10,25,47,0.14),
            inset 0 1px 0 rgba(255,255,255,0.6);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    .pp-bcard:hover {
        transform: translateY(-6px);
        box-shadow:
            0 2px 4px rgba(10,25,47,0.05),
            0 38px 72px -18px rgba(10,25,47,0.2),
            inset 0 1px 0 rgba(255,255,255,0.6);
    }

    /* Full-width cards: text left, visual right */
    .pp-bcard-2,
    .pp-bcard-3 {
        flex-direction: row;
        min-height: 480px;
    }

    /* Text sits in the upper-left — same apple-gray surface */
    .pp-bcard-text {
        padding: 3rem 2.8rem 2rem;
        flex-shrink: 0;
        position: relative;
        z-index: 2;
    }

    /* In full-width (row) cards, text takes ~40% */
    .pp-bcard-2 .pp-bcard-text,
    .pp-bcard-3 .pp-bcard-text {
        flex: 0 0 40%;
        padding: 3.8rem 2.6rem 3.8rem 4rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* Visual area: same surface as the card — single uniform color */
    .pp-bcard-visual {
        flex: 1;
        position: relative;
        overflow: hidden;
        min-height: 340px;
        background: #fff;
    }

    .pp-bcard-eyebrow {
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 2.8px;
        text-transform: uppercase;
        color: #b0b0b8;
        margin: 0 0 0.9rem;
    }

    .pp-bcard-h2 {
        font-size: clamp(1.35rem, 2.1vw, 1.85rem);
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: -0.035em;
        color: #050505;
        margin: 0 0 0.9rem;
    }

    .pp-bcard-copy {
        font-size: 0.875rem;
        line-height: 1.68;
        color: var(--color-text-muted);
        margin: 0 0 1.4rem;
    }

    .pp-bcard-bullets {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }

    .pp-bcard-bullets li {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.83rem;
        color: var(--color-text);
        font-weight: 500;
        line-height: 1.45;
    }

    .pp-bcard-bullets svg {
        width: 15px;
        height: 15px;
        color: var(--color-ok);
        flex-shrink: 0;
        margin-top: 1px;
    }

    /* ════════ CROSS-LINKS ════════ */

    /* ── Responsive bento ── */
    @media (max-width: 960px) {
        .pp-bento {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            padding: 4rem 5% 3rem;
        }
        .pp-bcard-2,
        .pp-bcard-3 {
            flex-direction: column;
            min-height: 500px;
        }
        .pp-bcard-2 .pp-bcard-text,
        .pp-bcard-3 .pp-bcard-text {
            flex: none;
            padding: 2.8rem 2.4rem 1.6rem;
        }
        .pp-bcard-2 .pp-bcard-visual,
        .pp-bcard-3 .pp-bcard-visual {
            border-left: none;
            border-top: 1px solid rgba(0,0,0,0.055);
        }
        .pp-bcard { min-height: 460px; }
    }

    .pp-more {
        max-width: 1080px; margin: 0 auto;
        padding: 6rem 5% 8rem;
    }
    .pp-more-head { text-align: center; margin-bottom: 3.2rem; }
    .pp-more-list { display: flex; flex-direction: column; }
    .pp-more-row {
        display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
        padding: 1.6rem 0.4rem; border-bottom: 1px solid var(--color-border);
        text-decoration: none;
        transition: padding-left 0.4s var(--ease-spring), background 0.3s;
    }
    .pp-more-row:first-child { border-top: 1px solid var(--color-border); }
    .pp-more-row:hover { padding-left: 1.2rem; }
    /* Fila de documentación (docs.cordhq.app) — hairline como el resto, con icono
       duotone al frente para distinguirla de los cross-links de producto. */
    .pp-docs-row { gap: 1rem; }
    .pp-docs-ico {
        flex-shrink: 0;
        width: 38px; height: 38px;
        display: grid; place-items: center;
        border-radius: 11px;
        background: var(--color-bg-soft);
        color: var(--color-blue-deep);
        box-shadow: inset 0 0 0 1px rgba(10, 25, 47, 0.06);
        transition: background 0.4s var(--ease-spring), transform 0.4s var(--ease-spring);
    }
    .pp-docs-ico svg { width: 19px; height: 19px; }
    .pp-docs-row:hover .pp-docs-ico { background: #fff; transform: scale(1.04); }
    .pp-more-info { display: flex; flex-direction: column; gap: 0.3rem; }
    .pp-more-info b { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.3px; color: var(--color-text); }
    .pp-more-info span { font-size: 0.88rem; line-height: 1.5; color: var(--color-text-muted); }
    .pp-more-arrow {
        flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
        background: rgba(10,25,47,0.05); color: var(--color-blue-deep);
        display: flex; align-items: center; justify-content: center;
        transition: background 0.35s, color 0.35s, transform 0.5s var(--ease-spring);
    }
    .pp-more-arrow svg { width: 14px; height: 14px; }
    .pp-more-row:hover .pp-more-arrow { background: var(--color-blue-deep); color: #fff; transform: translateX(3px); }

    /* ── FAQ padding override ── */
    :global(.pp-faq-acc) { padding: 5rem 5% 3rem; }

    /* ════════ RESPONSIVE ════════ */
    @media (max-width: 1000px) {
        .pp-hero {
            min-height: 100dvh;
            align-items: flex-start;
            padding-bottom: calc(var(--band-t) * 0.5);
        }
        .pp-hero-inner {
            grid-template-columns: 1fr;
            gap: 0;
            padding: 1rem 6% 1rem;
        }
        .pp-hero-text {
            padding-bottom: 2.5rem;
            text-align: left;
        }
        .pp-hero-visual {
            margin-left: 0;
            margin-right: 0;
            justify-content: flex-start;
            min-width: 0;
        }
        .pp-mockup-wrap { max-width: 100%; }
    }
    @media (max-width: 860px) {
        .pp-hero { padding-top: 8.5rem; }
        .mk-row { grid-template-columns: 1.4fr 0.5fr 1fr; }
        .mk-row span:nth-child(4) { display: none; }
    }

    /* ══════════════════════════════════════════════════════════════════
       MÓVIL (<=760px) — el mockup del hero se RE-COMPONE, no se encoge.
       Antes se escalaba una ventana de 900px a 390: quedaba recortada por
       ambos lados y con tipografía de 6px. Aquí cada mockup adopta la
       forma que la app real toma en móvil.
    ══════════════════════════════════════════════════════════════════ */
    @media (max-width: 760px) {
        .pp-hero-visual { overflow: visible; }
        .pp-mockup-wrap { perspective: none; }
        .mk-window { border-radius: 14px; }
        .mk-window::before { border-radius: 14px; }
        .mk-bar { padding: 11px 13px; gap: 10px; }
        .mk-bar-title { font-size: 0.8rem; }
        .mk-bar-actions { flex-shrink: 0; }


        /* ── hero calca: la app en su forma móvil (sidebar en drawer, una columna) ── */
        .mkc-app { --gut: 12px; padding: 8px; border-radius: 16px; }
        .mkc-ed-stage > .mkc-app, .mkc-tr-app, .mkc-ap-app { min-width: 0; height: auto; margin-left: 0; }
        .mkc-rail { display: none; }
        .mkc-top { gap: 6px; padding: 5px 5px 5px 6px; }
        .mkc-burger { display: flex; width: 28px; height: 28px; align-items: center; justify-content: center; color: #5b6472; }
        .mkc-burger svg { width: 16px; height: 16px; }
        .mkc-search { flex: 0 0 auto; padding: 6px; border-radius: 8px; }
        .mkc-search span, .mkc-search kbd { display: none; }
        .mkc-search svg { width: 14px; height: 14px; }
        .mkc-top-r .mkc-ti:nth-child(n+3) { display: none; }
        .mkc-create { font-size: 12px; padding: 6px 9px; }
        .mkc-pgh { padding: 14px var(--gut) 12px; }
        .mkc-title { font-size: 20px; }
        .mkc-crumbs { font-size: 11px; }
        .mkc-cursor { display: none; }

        .mkc-ed { grid-template-columns: 1fr; gap: 14px; padding: 0 var(--gut) 4px; }
        .mkc-client { flex-direction: column; align-items: stretch; }
        .mkc-chips i { font-size: 11.5px; padding: 6px 12px; }
        .mkc-field { font-size: 12.5px; padding: 9px 11px; }
        .mkc-ed-main > .mkc-step:first-child, .mkc-lh, .mkc-add, .mkc-ed-stage .mkc-lr:nth-of-type(n+5) { display: none; }
        .mkc-lr {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
            grid-template-areas: "name name name" "qty nego nego" "list margin amount";
            gap: 7px 8px; padding: 11px 0;
        }
        .mkc-lr-n { grid-area: name; font-size: 13px; }
        .mkc-lr-n small { font-size: 11px; }
        .mkc-lr > .mkc-in:nth-child(2) { grid-area: qty; }
        .mkc-lr > .mkc-lista { grid-area: list; font-size: 11.5px; }
        .mkc-lr > .mkc-in.deal { grid-area: nego; }
        .mkc-lr > .mkc-imp { grid-area: amount; font-size: 13px; }
        .mkc-lr > .mkc-mg { grid-area: margin; justify-self: start; font-size: 11px; }
        .mkc-in { font-size: 13px; padding: 8px 10px; }
        .mkc-sum { padding: 14px; }
        .mkc-sum .mkc-sf, .mkc-sum-draft { display: none; }
        .mkc-sl { font-size: 12px; }
        .mkc-sl .editorial { font-size: 12.5px; }
        .mkc-sl-tot .editorial { font-size: 21px; }
        .mkc-send { font-size: 13px; padding: 11px; }

        .mkc-lp { height: 480px; }
        .mkc-br { display: none; }
        .mkc-lp-phone { left: 50%; top: 4px; margin-left: -118px; }

        .mkc-tr { padding: 0; }
        .mkc-tr-phone, .mkc-stp .mkc-stp-s:not(.cur) b, .mkc-tr .mkc-dih, .mkc-tr .mkc-dir, .mkc-tr .mkc-dm > .mkc-sec, .mkc-tr .mkc-sec-2, .mkc-tr .mkc-tl { display: none; }
        .mkc-stp { padding-bottom: 14px; }
        .mkc-stp-s:not(:last-child)::after { margin: 0 5px; }
        .mkc-dg, .mkc-tr-app .mkc-dg { grid-template-columns: 1fr; gap: 6px; padding: 0 var(--gut) 6px; }
        .mkc-tr-app .mkc-dh-tot b { font-size: 21px; }
        .mkc-dh { flex-wrap: wrap; }
        .mkc-dh-n { font-size: 14.5px; }
        .mkc-dh-m { font-size: 11px; white-space: normal; }
        .mkc-lv { font-size: 10.5px; }
        .mkc-dh-tot { width: 100%; flex-direction: row; align-items: baseline; justify-content: space-between; gap: 8px; }
        .mkc-dh-tot b { font-size: 21px; margin-left: auto; }
        .mkc-at-sum { font-size: 13px; }
        .mkc-at-f, .mkc-at-l, .mkc-at-v, .mkc-at-n { font-size: 11px; }
        .mkc-at-r { grid-template-columns: 112px minmax(0, 1fr) 42px; }
        .mkc-tl-b b { font-size: 12px; }
        .mkc-tl-b span { font-size: 10.5px; }
        .mkc-sec { font-size: 13px; }

        .mkc-apb { flex-direction: column; align-items: stretch; gap: 10px; }
        .mkc-apb-i b { font-size: 13px; }
