    .mkc-ci-who strong { font-size: 10.5px; font-weight: 600; color: #0f1729; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-ci-who small { font-size: 8.5px; color: #5b6472; white-space: nowrap; }
