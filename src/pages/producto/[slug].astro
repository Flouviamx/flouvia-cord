    .pp-bcard-visual .bm-bold,
    .pp-bcard-visual b { color: #050505 !important; }
    .pp-bcard-visual .editorial { color: #050505 !important; font-weight: 700; }
    .pp-bcard-visual .bm-head,
    .pp-bcard-visual .bm-head * { color: rgba(0,0,0,0.4) !important; }
    .pp-bcard-visual .bm-row span { color: #374151 !important; }
    .pp-bcard-visual i { color: rgba(0,0,0,0.38) !important; }
    .pp-bcard-visual .bm-divider { background: rgba(0,0,0,0.07) !important; }
    .pp-bcard-visual .bm-row { border-bottom-color: rgba(0,0,0,0.05) !important; }
    .pp-bcard-visual .bm-active { background: rgba(10,25,47,0.035) !important; }
    /* Semantic colors */
    .pp-bcard-visual .bm-green,
    .pp-bcard-visual .mk-green { color: #059669 !important; }
    .pp-bcard-visual .bm-orange { color: #d97706 !important; }
    /* Light pills */
    .pp-bcard-visual .bm-pill {
        background: #ffffff !important;
        border: 1px solid rgba(0,0,0,0.09) !important;
        box-shadow: 0 4px 14px rgba(0,0,0,0.11) !important;
    }
    .pp-bcard-visual .bm-pill * { color: #111827 !important; }
    /* Navy accent pill stays dark */
    .pp-bcard-visual .bm-pill-dark {
        background: #0a192f !important;
        border-color: transparent !important;
        box-shadow: 0 4px 14px rgba(10,25,47,0.3) !important;
    }
    .pp-bcard-visual .bm-pill-dark,
    .pp-bcard-visual .bm-pill-dark * { color: #ffffff !important; }
    /* Status dots */
    .pp-bcard-visual .bm-dot-blue { background: #3b82f6 !important; }
    .pp-bcard-visual .bm-dot-green { background: #10b981 !important; }
    /* Toast */
    .pp-bcard-visual .bm-toast {
        background: #ffffff !important;
        border: 1px solid rgba(0,0,0,0.08) !important;
        box-shadow: 0 4px 16px rgba(0,0,0,0.12) !important;
    }
    .pp-bcard-visual .bm-toast * { color: #111827 !important; }
    /* Chip */
    .pp-bcard-visual .mk-chip {
        background: rgba(5,150,105,0.1) !important;
        color: #059669 !important;
    }
    /* Progress bars */
    .pp-bcard-visual .bm-margin-bar-bg { background: rgba(0,0,0,0.07) !important; }
    .pp-bcard-visual .bm-margin-bar-fill { background: linear-gradient(90deg, #10b981, #34d399) !important; }
    .pp-bcard-visual .bm-credit-bar-bg { background: rgba(0,0,0,0.07) !important; }
    .pp-bcard-visual .bm-credit-bar-fill { background: linear-gradient(90deg, #10b981, #34d399) !important; }
    /* Avatars */
    .pp-bcard-visual .bm-avatar,
    .pp-bcard-visual .bm-avatar-sm { background: #0a192f !important; color: #ffffff !important; }
    /* Chat bubbles */
    .pp-bcard-visual .bm-msg-in { background: #f3f4f6 !important; color: #111827 !important; }
    .pp-bcard-visual .bm-msg-out { background: #0a192f !important; color: #fff !important; }
    /* Brand */
    .pp-bcard-visual .bm-brand-dots span { background: #d1d5db !important; }
    .pp-bcard-visual .bm-brand-card { background: #f9fafb !important; }
    /* Tags */
    .pp-bcard-visual .bm-tag-warn { background: rgba(245,158,11,0.1) !important; color: #d97706 !important; }
    .pp-bcard-visual .bm-tag-blue { background: rgba(37,99,235,0.1) !important; color: #2563eb !important; }
    /* Large total number */
    .pp-bcard-visual .bm-large { color: #050505 !important; }
    /* Fake cursor */
    .pp-bcard-visual .bm-fake-cursor svg { stroke: #0a192f !important; }

    /* Full-width (row) cards: big mockup fills the right column, bleeds bottom */
    .pp-bcard-2 .pp-bcard-visual .bm-wrap,
    .pp-bcard-3 .pp-bcard-visual .bm-wrap {
        padding: 0 1rem;
        align-items: flex-end;
        justify-content: center;
    }
    .pp-bcard-2 .pp-bcard-visual .bm-stage,
    .pp-bcard-3 .pp-bcard-visual .bm-stage {
        width: max(360px, 88%);
        transform: translateY(3%);
        transform-origin: bottom center;
    }
    /* Ventana completa en card full-width — centrada en TODO el espacio
       visual disponible (no solo horizontal, también vertical): antes
       quedaba pegada arriba con un hueco grande abajo y se veía desalineada. */
    .pp-bcard-2 .pp-bcard-visual .bm-wrap:has(.bm-app),
    .pp-bcard-3 .pp-bcard-visual .bm-wrap:has(.bm-app) {
        padding: 2rem;
        align-items: center;
        justify-content: center;
    }
    .pp-bcard-2 .pp-bcard-visual .bm-stage:has(.bm-app),
    .pp-bcard-3 .pp-bcard-visual .bm-stage:has(.bm-app) {
        width: 100%;
        max-width: 600px;
        transform: none;
    }
</style>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('DOMContentLoaded', () => {
        // ── MOCKUP SCALING (Móvil) ──
        const heroWrap = document.querySelector('.pp-mockup-wrap');
        const heroSpace = document.querySelector('.pp-space');
        const heroScaler = document.querySelector('.pp-scaler');
        const heroMk = document.querySelector('.pp-mockup');
        if (heroWrap && heroSpace && heroScaler && heroMk) {
            // Bajo 760px el mockup tiene layout propio y no se escala.
            const MOBILE_MAX = 760;
            const scaleHero = () => {
                gsap.set(heroScaler, { clearProps: 'scale,transform' });
                const baseWidth = (heroScaler as HTMLElement).offsetWidth;

                if (window.innerWidth <= MOBILE_MAX) {
                    gsap.set(heroScaler, { scale: 1, clearProps: 'transform' });
                    (heroSpace as HTMLElement).style.height = 'auto';
                } else if (window.innerWidth <= baseWidth) {
                    const scale = window.innerWidth / baseWidth;
                    gsap.set(heroScaler, { scale: scale, transformOrigin: 'center top' });
                    (heroSpace as HTMLElement).style.height = `${(heroMk as HTMLElement).offsetHeight * scale}px`;
                } else {
                    gsap.set(heroScaler, { scale: 1, transformOrigin: 'center top' });
                    (heroSpace as HTMLElement).style.height = 'auto';
                }
            };
            window.addEventListener('resize', scaleHero);
            scaleHero();
        }

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) {
            // Entrada limpia de los BlockMockups: fade + rise (sin rotación 3D — igual al index)
            const blocks = document.querySelectorAll('.pp-block-visual');
            blocks.forEach((block) => {
                const stage = block.querySelector('.bm-stage');
                if (!stage) return;

                const internals = block.querySelectorAll('.bm-card, .bm-floating, .bm-search, .bm-timeline, .bm-board-col, .bm-stage > div');
                const glow = block.querySelector('.bm-glow');

                gsap.set(internals, { y: 28, opacity: 0 });
                if (glow) gsap.set(glow, { opacity: 0, scale: 0.6 });

                ScrollTrigger.create({
                    trigger: block,
                    start: 'top 85%',
                    once: true,
                    onEnter: () => {
                        gsap.to(internals, {
                            y: 0, opacity: 1,
                            duration: 0.9, ease: 'power3.out', stagger: 0.08, clearProps: 'transform',
                        });
                        if (glow) gsap.to(glow, { opacity: 1, scale: 1, duration: 1.6, ease: 'power3.out' });
                    },
                });
            });
            
            // ───────────────────────── HERO MOCKUP ─────────────────────────
            // El "settle" del mockup del hero (perspectiva → plano con el scroll) lo
            // maneja PageAnims.astro, idéntico al index. Aquí solo viven las
            // micro-historias que se auto-reproducen DENTRO del mockup (motion graphics):
            // cursor que negocia el precio, aprobación, timeline, timbrado, crédito.
            const wrap = document.querySelector('.pp-mockup-wrap');
            if (wrap) {
                // ── Hero calca: helpers (posiciones en coordenadas de layout, inmunes al settle 3D) ──
                const mkcPos = (stage, el) => {
                    let x = 0, y = 0, n = el;
                    while (n && n !== stage) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent; }
                    return { x, y, w: el.offsetWidth, h: el.offsetHeight };
                };
                const mkcMoney = (v) => '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const mkcCount = (el, from, to, dur, pre = '') => {
                    const o = { v: from };
                    return gsap.to(o, { v: to, duration: dur, ease: 'power2.out', onUpdate: () => { el.textContent = pre + mkcMoney(o.v); } });
                };
                const mkcDur = (s) => (s >= 60 ? Math.floor(s / 60) + 'm ' + (s % 60) + 's' : s + 's');

                // Editor: el cursor aplica el precio sugerido y todo el resumen se recalcula en vivo
                const edHero = document.getElementById('edHero');
                if (edHero) {
                    const cursor = document.getElementById('edCursor');
                    const hintW = document.getElementById('edHintW');
                    const hint = document.getElementById('edHint');
                    const nego = document.getElementById('edNego');
                    const imp = document.getElementById('edImp');
                    const mg = document.getElementById('edMg');
                    const sub = document.getElementById('edSub');
                    const save = document.getElementById('edSave');
                    const tax = document.getElementById('edTax');
                    const tot = document.getElementById('edTot');
                    const moving = [nego, imp, mg, sub, save, tax, tot];
                    const before = () => {
                        hintW.classList.remove('mkc-gone'); gsap.set(hintW, { opacity: 1 }); gsap.set(hint, { color: '' });
                        nego.textContent = '180.00'; nego.classList.remove('deal');
                        imp.textContent = '$61,200.00'; mg.textContent = '31%';
                        sub.textContent = '$173,280.00'; save.textContent = '−$11,040.00';
                        tax.textContent = '$27,724.80'; tot.textContent = '$201,004.80';
                    };
                    const loop = (first) => {
                        const tl = gsap.timeline({ onComplete: () => loop(false) });
                        if (!first) tl.to(moving, { opacity: 0.25, duration: 0.25 }).call(before).to(moving, { opacity: 1, duration: 0.35 });
                        else tl.call(before);
                        tl.call(() => {
                            const h = mkcPos(edHero, hint);
                            gsap.set(cursor, { x: h.x + h.w * 0.5 + 150, y: h.y + 150, scale: 1 });
                        });
                        tl.to(cursor, { opacity: 1, duration: 0.3 }, '+=0.9');
                        tl.to(cursor, { x: () => { const h = mkcPos(edHero, hint); return h.x + h.w * 0.55; }, y: () => { const h = mkcPos(edHero, hint); return h.y + h.h * 0.3; }, duration: 1.05, ease: 'power3.inOut' });
                        tl.to(hint, { color: '#059669', duration: 0.2 });
                        tl.to(cursor, { scale: 0.82, duration: 0.09, yoyo: true, repeat: 1 }, '<');
                        tl.call(() => { nego.textContent = '168.50'; nego.classList.add('deal'); });
                        tl.fromTo(nego, { borderColor: '#0a192f', boxShadow: '0 0 0 3px rgba(10,25,47,0.10)', backgroundColor: '#ffffff' }, { borderColor: 'rgba(0,0,0,0)', boxShadow: '0 0 0 0 rgba(10,25,47,0)', backgroundColor: '#ebebee', duration: 0.9, ease: 'power2.in', delay: 0.5 }, '<');
                        tl.add(mkcCount(imp, 61200, 57290, 0.8), '<-0.45');
                        tl.add(mkcCount(sub, 173280, 169370, 0.9), '<0.1');
                        tl.add(mkcCount(save, 11040, 14950, 0.9, '−'), '<');
                        tl.add(mkcCount(tax, 27724.8, 27099.2, 0.9), '<');
                        tl.add(mkcCount(tot, 201004.8, 196469.2, 1.0), '<');
                        tl.call(() => { mg.textContent = '26%'; }, null, '<0.3');
                        tl.fromTo(mg, { scale: 1.18 }, { scale: 1, duration: 0.35, ease: 'back.out(2)' }, '<');
                        tl.to(hintW, { opacity: 0, duration: 0.35 }, '<0.2');
                        tl.call(() => hintW.classList.add('mkc-gone'));
                        tl.fromTo(tot, { color: '#059669' }, { color: '#0f1729', duration: 1.2 }, '<');
                        tl.to(cursor, { x: '+=70', y: '+=120', opacity: 0, duration: 0.8, ease: 'power2.in' }, '<0.3');
                        tl.to({}, { duration: 3.4 });
                    };
                    ScrollTrigger.create({ trigger: edHero, start: 'top 90%', once: true, onEnter: () => loop(true) });
                }

                // Link público: el cliente firma desde su teléfono y la cotización queda aprobada
                const lpHero = document.getElementById('lpHero');
                if (lpHero) {
                    const phone = lpHero.querySelector('.mkc-lp-phone');
                    const name = document.getElementById('lpName');
                    const caret = document.getElementById('lpCaret');
                    const chk = document.getElementById('lpChk');
                    const cta = document.getElementById('lpCta');
                    const done = document.getElementById('lpDone');
                    const ring = document.getElementById('lpRing');
                    const tick = document.getElementById('lpTick');
                    const extras = [document.getElementById('lpCredit'), document.getElementById('lpAudit')];
                    const full = name.textContent || '';
                    gsap.set(ring, { strokeDasharray: 145 });
                    gsap.set(tick, { strokeDasharray: 40 });
                    const blink = gsap.to(caret, { opacity: 1, duration: 0.5, repeat: -1, yoyo: true, ease: 'steps(1)', paused: true });
                    const reset = () => {
                        name.textContent = ''; chk.classList.remove('on'); cta.classList.remove('busy');
                        gsap.set(cta, { opacity: 0.45, scale: 1 }); gsap.set(done, { autoAlpha: 0 });
                        gsap.set(ring, { strokeDashoffset: 145 }); gsap.set(tick, { strokeDashoffset: 40 }); gsap.set(extras, { opacity: 0, y: 8 });
                        blink.play(0);
                    };
                    const loop = () => {
                        const tl = gsap.timeline({ onComplete: loop });
                        tl.to(done, { autoAlpha: 0, duration: 0.35 }).call(reset).to({}, { duration: 0.7 });
                        for (let i = 1; i <= full.length; i++) tl.call(() => { name.textContent = full.slice(0, i); }, null, '+=0.065');
                        tl.to({}, { duration: 0.35 });
                        tl.call(() => chk.classList.add('on'));
                        tl.fromTo(chk, { scale: 0.7 }, { scale: 1, duration: 0.3, ease: 'back.out(2.2)' }, '<');
                        tl.to(cta, { opacity: 1, duration: 0.3 }, '<0.1');
                        tl.call(() => { blink.pause(); gsap.set(caret, { opacity: 0 }); }, null, '+=0.35');
                        tl.to(cta, { scale: 0.96, duration: 0.1, yoyo: true, repeat: 1, ease: 'power2.inOut' });
                        tl.call(() => cta.classList.add('busy'));
                        tl.to(done, { autoAlpha: 1, duration: 0.35 }, '+=0.65');
                        tl.to(ring, { strokeDashoffset: 0, duration: 0.6, ease: 'power2.out' }, '<0.05');
                        tl.to(tick, { strokeDashoffset: 0, duration: 0.4, ease: 'power2.out' }, '-=0.2');
                        tl.to(extras, { opacity: 1, y: 0, duration: 0.45, stagger: 0.12, ease: 'power2.out' }, '-=0.1');
                        tl.to({}, { duration: 3.6 });
                    };
                    ScrollTrigger.create({ trigger: lpHero, start: 'top 90%', once: true, onEnter: () => gsap.delayedCall(0.8, loop) });
                    if (phone) gsap.to(phone, { y: 6, duration: 3.9, ease: 'sine.inOut', yoyo: true, repeat: -1 });
                }

                // Seguimiento: el cliente baja a las partidas y el vendedor lo ve en ese instante
                const trHero = document.getElementById('trHero');
                if (trHero) {
                    const phone = trHero.querySelector('.mkc-tr-phone');
                    const scroller = document.getElementById('trScroll');
                    const items = document.getElementById('trItems');
                    const sticky = document.getElementById('trSticky');
                    const sec = document.getElementById('trSec');
                    const live = document.getElementById('trLive');
                    const rowRes = trHero.querySelector('[data-sec="resumen"]');
                    const rowPar = trHero.querySelector('[data-sec="partidas"]');
                    const bar = document.getElementById('trBar');
                    const val = document.getElementById('trVal');
                    const totEl = document.getElementById('trTot');
                    const [secRes, secPar] = [rowRes.querySelector('.mkc-at-l').textContent, rowPar.querySelector('.mkc-at-l').textContent];
                    const deep = () => -Math.max(0, items.offsetTop - 10);
                    const loop = (first) => {
                        const tl = gsap.timeline({ onComplete: () => loop(false) });
                        const clock = { s: 210 };
                        if (!first) tl.to(scroller, { y: 0, duration: 1.1, ease: 'power2.inOut' }).to(sticky, { opacity: 0, y: 14, duration: 0.3 }, '<');
                        else { gsap.set(scroller, { y: 0 }); gsap.set(sticky, { opacity: 0, y: 14 }); }
                        tl.call(() => {
                            sec.textContent = ' — ' + secRes; rowRes.classList.add('on'); rowPar.classList.remove('on');
                            val.textContent = '3m 30s'; totEl.textContent = '6m 47s'; gsap.set(bar, { width: '97%' });
                        });
                        tl.fromTo(live, { backgroundColor: 'rgba(16,185,129,0.22)' }, { backgroundColor: 'rgba(16,185,129,0.1)', duration: 0.7 }, '<');
                        tl.to(scroller, { y: deep, duration: 1.5, ease: 'power2.inOut' }, '+=1.6');
                        tl.to(sticky, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '-=0.6');
                        tl.call(() => { sec.textContent = ' — ' + secPar; rowRes.classList.remove('on'); rowPar.classList.add('on'); }, null, '-=0.2');
                        tl.fromTo(live, { backgroundColor: 'rgba(16,185,129,0.24)', scale: 1.06 }, { backgroundColor: 'rgba(16,185,129,0.1)', scale: 1, duration: 0.6, ease: 'power2.out' }, '<');
                        tl.to(clock, { s: 220, duration: 3.2, ease: 'none', onUpdate: () => { const s = Math.round(clock.s); val.textContent = mkcDur(s); totEl.textContent = mkcDur(s + 197); } }, '<');
                        tl.to(bar, { width: '100%', duration: 3.2, ease: 'none' }, '<');
                        tl.to({}, { duration: 2.4 });
                    };
                    ScrollTrigger.create({ trigger: trHero, start: 'top 90%', once: true, onEnter: () => gsap.delayedCall(0.6, () => loop(true)) });
                    if (phone) gsap.to(phone, { y: 6, duration: 3.9, ease: 'sine.inOut', yoyo: true, repeat: -1 });
                }

                // Aprobaciones: gerencia aprueba y la cotización sale al cliente
                const apHero = document.getElementById('apHero');
                if (apHero) {
                    const cursor = document.getElementById('apCursor');
                    const ok = document.getElementById('apOk');
                    const bannerW = document.getElementById('apBannerW');
                    const pillA = document.getElementById('apPillA');
                    const pillB = document.getElementById('apPillB');
                    const fresh = document.getElementById('apNew');
                    const hot = apHero.querySelector('.mkc-dir-hot');
                    const s1 = document.getElementById('apS1');
                    const s2 = document.getElementById('apS2');
                    const stepTo = (sent) => { s1.classList.toggle('cur', !sent); s1.classList.toggle('done', sent); s2.classList.toggle('cur', sent); };
                    const loop = (first) => {
                        const tl = gsap.timeline({ onComplete: () => loop(false) });
                        if (!first) {
                            tl.to(fresh, { height: 0, opacity: 0, duration: 0.4, ease: 'power2.inOut' })
                              .set(fresh, { display: 'none' })
                              .to(bannerW, { height: 'auto', opacity: 1, duration: 0.5, ease: 'power2.out' }, '<')
                              .to(pillB, { opacity: 0, duration: 0.3 }, '<').to(pillA, { opacity: 1, duration: 0.3 }, '<')
                              .set(ok, { opacity: 1 })
                              .call(() => stepTo(false), null, '<');
                        }
                        tl.call(() => {
                            const r = mkcPos(apHero, hot);
                            gsap.set(cursor, { x: r.x + r.w * 0.62, y: r.y + r.h + 70, scale: 1 });
                        });
                        tl.to(cursor, { opacity: 1, duration: 0.3 }, '+=1.1');
                        tl.to(cursor, { x: () => { const r = mkcPos(apHero, hot); return r.x + r.w * 0.55; }, y: () => { const r = mkcPos(apHero, hot); return r.y + r.h * 0.5; }, duration: 0.8, ease: 'power2.inOut' });
                        tl.to(hot, { backgroundColor: 'rgba(10,25,47,0.035)', duration: 0.25 }, '-=0.2');
                        tl.to(cursor, { x: () => { const r = mkcPos(apHero, ok); return r.x + r.w * 0.5; }, y: () => { const r = mkcPos(apHero, ok); return r.y + r.h * 0.6; }, duration: 1.0, ease: 'power3.inOut' }, '+=0.9');
                        tl.to(hot, { backgroundColor: 'rgba(10,25,47,0)', duration: 0.3 }, '<');
                        tl.to(cursor, { scale: 0.82, duration: 0.09, yoyo: true, repeat: 1 });
                        tl.to(ok, { opacity: 0.6, duration: 0.15 }, '<');
                        tl.to(bannerW, { height: 0, opacity: 0, duration: 0.5, ease: 'power2.inOut' }, '+=0.45');
                        tl.to(pillA, { opacity: 0, duration: 0.3 }, '<0.1').to(pillB, { opacity: 1, duration: 0.3 }, '<');
                        tl.call(() => stepTo(true), null, '<');
                        tl.set(fresh, { display: 'block', height: 0, opacity: 0 });
                        tl.to(fresh, { height: 'auto', opacity: 1, duration: 0.5, ease: 'power2.out' });
                        tl.to(cursor, { x: '+=80', y: '+=110', opacity: 0, duration: 0.8, ease: 'power2.in' }, '<');
                        tl.to({}, { duration: 3.2 });
                    };
                    ScrollTrigger.create({ trigger: apHero, start: 'top 90%', once: true, onEnter: () => loop(true) });
                }

                // CFDI Animation
                const cfdiStamp = document.getElementById('cfdiStamp');
                if (cfdiStamp) {
                    const check = cfdiStamp.querySelector('.mk-check');
                    const ring = cfdiStamp.querySelector('.mk-stamp-ring');
                    gsap.to(check, { 
                        scale: 1, duration: 0.6, ease: 'back.out(1.5)',
                        scrollTrigger: { trigger: '.mk-cfdi', start: 'top 80%', once: true }
                    });
                    gsap.fromTo(ring, { scale: 0.5, opacity: 1 }, { scale: 2, opacity: 0, duration: 1,
                        scrollTrigger: { trigger: '.mk-cfdi', start: 'top 80%', once: true }
                    });
                }
                
                // Clientes Animation
                const cliItems = document.querySelectorAll('.cli-item');
                if (cliItems.length) {
                    const bars = document.querySelectorAll('.mk-credit-bar i');
                    gsap.to(cliItems, {
                        opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power2.out',
                        scrollTrigger: { trigger: '.mk-cli', start: 'top 80%', once: true }
                    });
                    gsap.to(bars, {
                        scaleX: 1, duration: 1, stagger: 0.1, ease: 'power3.out', delay: 0.4,
                        scrollTrigger: { trigger: '.mk-cli', start: 'top 80%', once: true }
                    });
                }

                // Cobranza IA — chat LIBRE sobre el hero con "escribiendo…" real (loop)
                const arFree = document.getElementById('arFree');
                if (arFree) {
                    const steps = [...arFree.querySelectorAll('[data-cf]')];
                    const approve = document.getElementById('cfApprove');
                    const cuotas = arFree.querySelectorAll('.cf-cuota');
                    const makeTyping = (isOut) => {
                        const m = document.createElement('div');
                        m.className = 'cf-typing-msg ' + (isOut ? 'cf-out' : 'cf-in');
                        m.innerHTML = '<div class="cf-dots"><span></span><span></span><span></span></div>';
                        return m;
                    };
                    const reset = () => { gsap.set(steps, { opacity: 0, y: 16, scale: 0.96 }); gsap.set(cuotas, { opacity: 0, x: -8 }); arFree.querySelectorAll('.cf-typing-msg').forEach(n => n.remove()); };
                    reset();
                    ScrollTrigger.create({
                        trigger: arFree, start: 'top 80%', once: true,
                        onEnter: () => {
                            const tl = gsap.timeline({ delay: 0.4, repeat: -1, repeatDelay: 3.2 });
                            steps.forEach((s, i) => {
                                const isOut = s.classList.contains('cf-out');
                                const isPlan = s.classList.contains('cf-plan');
                                if (!isPlan) {
                                    // aparece "escribiendo…" en el lugar del mensaje, luego lo reemplaza la burbuja
                                    tl.call(() => {
                                        const t = makeTyping(isOut); s.parentNode.insertBefore(t, s); s._t = t;
                                        gsap.fromTo(t, { opacity: 0, scale: 0.8, y: 8 }, { opacity: 1, scale: 1, y: 0, duration: 0.3, ease: 'back.out(2)' });
                                    }, null, i === 0 ? '>' : '+=0.45');
                                    tl.to({}, { duration: 0.75 });
                                    tl.call(() => { if (s._t) { const t = s._t; gsap.to(t, { opacity: 0, scale: 0.8, duration: 0.2, onComplete: () => t.remove() }); } });
                                    tl.to(s, { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: 'back.out(1.4)' }, '+=0.06');
                                } else {
                                    tl.to(s, { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: 'back.out(1.3)' }, '+=0.5');
                                    tl.to(cuotas, { opacity: 1, x: 0, duration: 0.4, stagger: 0.12, ease: 'power2.out' }, '-=0.1');
                                    if (approve) tl.fromTo(approve, { boxShadow: '0 6px 16px -4px rgba(10,25,47,0.4), 0 0 0 0 rgba(10,25,47,0)' }, { boxShadow: '0 6px 16px -4px rgba(10,25,47,0.4), 0 0 0 6px rgba(10,25,47,0.12)', duration: 0.6, yoyo: true, repeat: 1, ease: 'sine.inOut' }, '+=0.15');
                                }
                            });
                            // cierre del loop: se desvanece y reinicia
                            tl.to(steps, { opacity: 0, y: 10, duration: 0.5, stagger: 0.04 }, '+=1.6');
                            tl.add(() => reset());
                        },
                    });
                }

                // Multi-divisa Animation (count-up de la tasa + pop del lock + flash del total MXN)
                const fxHero = document.getElementById('fxHero');
                if (fxHero) {
                    const rate = document.getElementById('fxRate');
                    const lock = document.getElementById('fxLock');
                    const mxn = document.getElementById('fxMxn');
                    gsap.set(lock, { opacity: 0, scale: 0.6 });
                    ScrollTrigger.create({
                        trigger: fxHero, start: 'top 78%', once: true,
                        onEnter: () => {
                            const obj = { v: 17.9 };
                            gsap.timeline({ delay: 0.5 })
                                .to(obj, { v: 18.50, duration: 1, ease: 'power2.out', onUpdate: () => { if (rate) rate.textContent = '$' + obj.v.toFixed(2) + ' MXN'; } })
                                .to(lock, { opacity: 1, scale: 1, duration: 0.45, ease: 'back.out(1.6)' }, '-=0.25')
                                .fromTo(mxn, { backgroundColor: 'rgba(16,185,129,0.18)' }, { backgroundColor: '#f8fafc', duration: 1.1, ease: 'power2.out' }, '-=0.1');
                        },
                    });
                }

                // Cord Payments — el cliente paga con tarjeta dentro del link y el cobro
                // se confirma hacia la cuenta conectada del negocio (loop auto-reproducido).
                const payHero = document.getElementById('payHero');
                if (payHero) {
                    const payLines = payHero.querySelectorAll('.mk-pay-line');
                    const cardField = document.getElementById('payCardField');
                    const payForm = document.getElementById('payForm');
                    const payBtn = document.getElementById('payBtn');
                    const payOk = document.getElementById('paySuccess');
                    const payRing = payHero.querySelector('.mk-pay-ring');
                    const payTick = payHero.querySelector('.mk-pay-tick');
                    const payDep = payHero.querySelector('.mk-pay-ok-dep');
                    gsap.set(payLines, { opacity: 0, x: -10 });
                    ScrollTrigger.create({
                        trigger: payHero, start: 'top 78%', once: true,
                        onEnter: () => {
                            gsap.to(payLines, { opacity: 1, x: 0, duration: 0.5, stagger: 0.09, ease: 'power2.out', delay: 0.3 });
                            gsap.timeline({ delay: 1.25, repeat: -1, repeatDelay: 2.2 })
                                .fromTo(cardField, { boxShadow: '0 1px 2px rgba(10,25,47,0.04)' }, { boxShadow: '0 1px 2px rgba(10,25,47,0.04), 0 0 0 3px rgba(10,25,47,0.10)', duration: 0.45, ease: 'sine.out' })
                                .to(cardField, { boxShadow: '0 1px 2px rgba(10,25,47,0.04)', duration: 0.4, ease: 'sine.in' }, '+=0.35')
                                .to(payBtn, { scale: 0.97, duration: 0.12, ease: 'power2.in' })
                                .to(payBtn, { scale: 1, duration: 0.18, ease: 'power2.out' })
                                .to(payForm, { opacity: 0, y: -6, duration: 0.35, ease: 'power2.in' }, '+=0.15')
                                .to(payOk, { opacity: 1, duration: 0.3 }, '-=0.12')
                                .fromTo(payRing, { scale: 0.55, opacity: 1 }, { scale: 1.7, opacity: 0, duration: 0.9, ease: 'power2.out' }, '<')
                                .fromTo(payTick, { scale: 0, rotation: -32 }, { scale: 1, rotation: 0, duration: 0.55, ease: 'back.out(2)' }, '<0.05')
                                .fromTo(payDep, { opacity: 0, y: 9 }, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '-=0.2')
                                .to(payOk, { opacity: 0, duration: 0.45 }, '+=2.6')
                                .to(payForm, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '<');
                        },
                    });
                }

                // Cord Invoicing Animation (pill "Timbrada" + flash del saldo por cobrar)
                const intlHero = document.getElementById('intlHero');
                if (intlHero) {
                    const fiscal = document.getElementById('intlFiscal');
                    const pill = document.getElementById('intlPill');
                    gsap.set(pill, { opacity: 0, scale: 0.6, y: -6 });
                    ScrollTrigger.create({
                        trigger: intlHero, start: 'top 78%', once: true,
                        onEnter: () => {
                            gsap.timeline({ delay: 0.5 })
                                .to(pill, { opacity: 1, scale: 1, y: 0, duration: 0.5, ease: 'back.out(1.6)' })
                                .fromTo(fiscal, { backgroundColor: 'rgba(16,185,129,0.2)' }, { backgroundColor: '#f8fafc', duration: 1.1, ease: 'power2.out' }, '-=0.1');
                        },
                    });
                }

                // Finanzas / CFO — count-up KPIs + barras que crecen + insight + pulso del pico
                const finHero = document.getElementById('finHero');
                if (finHero) {
                    const bars = finHero.querySelectorAll('.mk-fin-bar i');
                    const insight = document.getElementById('finInsight');
                    const k1 = document.getElementById('finK1');
                    const k2 = document.getElementById('finK2');
                    const hot = finHero.querySelector('.mk-fin-bar-hot i');
                    gsap.set(insight, { opacity: 0, y: 10 });
                    const countTo = (el, to) => { const o = { v: 0 }; return gsap.to(o, { v: to, duration: 1.1, ease: 'power2.out', onUpdate: () => { if (el) el.textContent = '$' + o.v.toFixed(2) + 'M'; } }); };
                    ScrollTrigger.create({
                        trigger: finHero, start: 'top 78%', once: true,
                        onEnter: () => {
                            const tl = gsap.timeline({ delay: 0.35 });
                            tl.to(bars, { scaleY: 1, duration: 0.85, stagger: 0.09, ease: 'power3.out' })
                              .add(countTo(k1, parseFloat(k1.dataset.to)), '<')
                              .add(countTo(k2, parseFloat(k2.dataset.to)), '<0.15')
                              .to(insight, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3');
                            if (hot) gsap.to(hot, { filter: 'brightness(1.12)', duration: 1.1, yoyo: true, repeat: -1, ease: 'sine.inOut', delay: 1.4 });
                        },
                    });
                }

                // Equipo — filas entran en cascada + el botón invitar pulsa
                const teamHero = document.getElementById('teamHero');
                if (teamHero) {
                    const rows = teamHero.querySelectorAll('.team-item');
                    const invite = document.getElementById('teamInvite');
                    gsap.set(rows, { opacity: 0, x: -14 });
                    gsap.set(invite, { opacity: 0, y: 8 });
                    ScrollTrigger.create({
                        trigger: teamHero, start: 'top 78%', once: true,
                        onEnter: () => {
                            gsap.timeline({ delay: 0.35 })
                                .to(rows, { opacity: 1, x: 0, duration: 0.6, stagger: 0.11, ease: 'power2.out' })
                                .to(invite, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2');
                        },
                    });
                }



                // ── Ambient float sutil para TODOS los mockups del hero (toque Linear, sobrio) ──
                const heroMock = wrap.querySelector('.pp-mockup > *');
                if (heroMock) {
                    gsap.to(heroMock, { y: '-=7', duration: 4.6, ease: 'sine.inOut', yoyo: true, repeat: -1 });
                }

            }

            // ───────────────────────── BLOCK MOCKUPS GSAP ─────────────────────────
            // Editor M0 (Discount Row & Cursor)
            const bEditor0 = document.querySelector('.bm-editor-m0');
            if (bEditor0) {
                const cursor = bEditor0.querySelector('.bm-fake-cursor');
                const row = bEditor0.querySelector('.bm-row-target');
                const chip = bEditor0.querySelector('.mk-chip');
                const price = bEditor0.querySelector('.price-val');
                const obj = { val: 191.48 };

                if (cursor && row && chip && price) {
                    ScrollTrigger.create({
                        trigger: bEditor0, start: 'top 85%',
                        onEnter: () => {
                            const tl = gsap.timeline({ repeat: -1, repeatDelay: 2.2 });
                            tl.set(cursor, { x: 210, y: 230, opacity: 0 })
                              .set(chip, { opacity: 0, scale: 0.5 })
                              .to(cursor, { opacity: 1, duration: 0.4 })
                              .to(cursor, { x: 330, y: 118, duration: 1, ease: 'power3.inOut' })
                              .to(cursor, { scale: 0.85, duration: 0.1, yoyo: true, repeat: 1 })
                              .to(row, { backgroundColor: 'rgba(16,185,129,0.12)', duration: 0.3 })
                              .to(chip, { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(1.5)' })
                              .to(row, { backgroundColor: 'transparent', duration: 0.3 })
                              .to(obj, { val: 168.50, duration: 0.8, onUpdate: () => price.textContent = `$${obj.val.toFixed(2)}` }, '-=0.3')
                              .to(cursor, { opacity: 0, y: '+=30', duration: 0.5 });
                        }
                    });
                }
            }

            // Editor M1 (catálogo — filas en cascada + caret que teclea)
            const bEditor1 = document.querySelector('.bm-editor-m1');
            if (bEditor1) {
                const rows = bEditor1.querySelectorAll('.cat-r');
                const caret = bEditor1.querySelector('.bm-search-caret');
                if (caret) gsap.to(caret, { opacity: 0, duration: 0.5, repeat: -1, yoyo: true, ease: 'steps(1)' });
                if (rows.length) {
                    ScrollTrigger.create({
                        trigger: bEditor1, start: 'top 85%', once: true,
                        onEnter: () => gsap.fromTo(rows, { opacity: 0, x: -10 }, { opacity: 1, x: 0, stagger: 0.1, duration: 0.55, ease: 'power2.out', delay: 0.3 }),
                    });
                }
            }

            // Editor M2 (resumen — filas de totales en cascada)
            const bEditor2 = document.querySelector('.bm-editor-m2');
            if (bEditor2) {
                const rows = bEditor2.querySelectorAll('.bm-stag-row');
                if (rows.length) {
                    ScrollTrigger.create({
                        trigger: bEditor2, start: 'top 85%', once: true,
                        onEnter: () => gsap.fromTo(rows, { opacity: 0, x: -10 }, { opacity: 1, x: 0, stagger: 0.14, duration: 0.6, ease: 'power2.out', delay: 0.3 }),
                    });
                }
            }

            // ── Ventanas completas del bento (bm-app): cascada de filas al entrar ──
            document.querySelectorAll('.pp-bcard-visual .bm-app').forEach((app) => {
                const stage = app.closest('.bm-stage');
                if (stage && /bm-editor-m/.test(stage.className || '')) return; // editor tiene su propia animación
                const rows = app.querySelectorAll('.bm-kv, .bm-step, .bm-cc-b, .bm-stat, .bm-tot-r, .bm-g:not(.bm-g-head)');
                if (!rows.length) return;
                gsap.set(rows, { opacity: 0, y: 10 });
                ScrollTrigger.create({
                    trigger: app, start: 'top 88%', once: true,
                    onEnter: () => gsap.to(rows, { opacity: 1, y: 0, duration: 0.5, stagger: 0.07, ease: 'power2.out', delay: 0.2, clearProps: 'transform' }),
                });
                const approve = app.querySelector('.bm-lp-approve');
                if (approve) gsap.to(approve, { boxShadow: '0 6px 16px -4px rgba(10,25,47,0.4), 0 0 0 5px rgba(10,25,47,0.12)', duration: 1, repeat: -1, yoyo: true, ease: 'sine.inOut' });
            });

        }
    });
</script>
