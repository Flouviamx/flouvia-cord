                            tl.call(() => fields[k].classList.add('on'));
                            typed(full[k]).forEach((s) => tl.call(() => { el.textContent = s; }, null, k === 0 ? '+=0.07' : '+=0.1'));
                            tl.call(() => fields[k].classList.remove('on'), null, '+=0.18');
                        });
                        tl.to(btn, { opacity: 1, duration: 0.25 });
                        tl.to(btn, { scale: 0.96, duration: 0.1, yoyo: true, repeat: 1, ease: 'power2.inOut' }, '+=0.4');
                        tl.call(() => { btnT.textContent = busyLabel; });
                        tl.to([form, mp], { autoAlpha: 0, duration: 0.25 }, '+=0.95');
                        tl.to(ok, { autoAlpha: 1, duration: 0.3 });
                        tl.to(ring, { strokeDashoffset: 0, duration: 0.6, ease: 'power2.out' }, '<0.05');
                        tl.to(tick, { strokeDashoffset: 0, duration: 0.4, ease: 'power2.out' }, '-=0.2');
                        tl.to(list, { y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.15');
                        tl.to(hot, { opacity: 1, duration: 0.45 }, '<0.1');
                        tl.fromTo(hot, { backgroundColor: 'rgba(16,185,129,0.16)' }, { immediateRender: false, backgroundColor: 'rgba(16,185,129,0)', duration: 2.6, ease: 'power1.in' }, '<0.25');
                        const o = { v: pFrom };
                        tl.to(o, { v: pTo, duration: 1.3, ease: 'power2.out', onUpdate: () => { pend.textContent = tplPend.replace('{m}', m0(o.v)); } }, '<');
                        tl.fromTo(bell, { scale: 1 }, { immediateRender: false, scale: 1.9, duration: 0.25, yoyo: true, repeat: 1, ease: 'power2.out' }, '<');
                        tl.to({}, { duration: 3.6 });
                        tl.to([ok, pend], { autoAlpha: 0, duration: 0.35 });
                        tl.to(hot, { opacity: 0, duration: 0.3 }, '<');
                        tl.to(list, { y: () => -hot.offsetHeight, duration: 0.5, ease: 'power2.inOut' }, '<0.1');
                        tl.call(reset);
                        tl.to([form, mp, pend], { autoAlpha: 1, duration: 0.4 });
                    };
                    gsap.set(form, { autoAlpha: 1 });
                    ScrollTrigger.create({ trigger: pyHero, start: 'top 90%', once: true, onEnter: () => gsap.delayedCall(0.6, loop) });
                    if (phone) gsap.to(phone, { y: 6, duration: 3.9, ease: 'sine.inOut', yoyo: true, repeat: -1 });
                }

                // Facturación: el cliente abona desde el link de la factura y el saldo baja en su detalle
                const faHero = document.getElementById('faHero');
                if (faHero) {
                    const $ = (id) => document.getElementById(id);
                    const cur = faHero.dataset.cur || '$';
                    const fm = (v) => cur + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    const page = $('faPage'), scroll = $('faScroll'), box = $('faBox'), amt = $('faAmt'), amtF = $('faAmtF'), cont = $('faCont'), partial = $('faPartial');
                    const phSaldo = $('faPhSaldo'), phPag = $('faPhPag'), phDue = $('faPhDue'), phPay = $('faPhPayAmt'), phNew = $('faPhNew');
                    const headSaldo = $('faHeadSaldo'), pag = $('faPag'), due = $('faDue'), newPago = $('faNewPago'), newTl = $('faNewTl'), bell = $('faBell');
                    const grid = faHero.querySelector('.mkc-fa-grid');
                    const contLabel = cont.textContent, busy = cont.dataset.busy, amtFull = amt.textContent;
                    const TOTAL = 196469.2, PAID0 = 60000, PAID1 = 100000;
                    const paint = (paid, hero) => {
                        const bal = TOTAL - paid;
                        if (hero) phSaldo.textContent = fm(bal);
                        phPag.textContent = '−' + fm(paid); pag.textContent = '−' + fm(paid);
                        phDue.textContent = fm(bal); due.textContent = fm(bal); phPay.textContent = fm(bal);
                        headSaldo.textContent = headSaldo.dataset.lbl + ' ' + fm(bal);
                    };
                    const maxY = () => -Math.max(0, scroll.offsetHeight - page.clientHeight);
                    const reset = () => {
                        paint(PAID0, true);
                        gsap.set(scroll, { y: 0 });
                        gsap.set([box, phNew, newPago, newTl], { height: 0, opacity: 0 });
                        amt.textContent = ''; amtF.classList.remove('on'); cont.textContent = contLabel;
                    };
                    reset();
                    const loop = () => {
                        const tl = gsap.timeline({ onComplete: loop });
                        tl.to({}, { duration: 1.2 });
                        tl.to(scroll, { y: maxY, duration: 1.5, ease: 'power2.inOut' });
                        tl.to(partial, { scale: 0.96, duration: 0.1, yoyo: true, repeat: 1, ease: 'power2.inOut' }, '+=0.35');
                        tl.to(box, { height: 'auto', opacity: 1, duration: 0.45, ease: 'power2.out' });
                        tl.to(scroll, { y: () => maxY() - 96, duration: 0.45, ease: 'power2.out' }, '<');
                        tl.call(() => amtF.classList.add('on'), null, '+=0.15');
                        for (let i = 1; i <= amtFull.length; i++) tl.call(() => { amt.textContent = amtFull.slice(0, i); }, null, '+=0.07');
                        tl.call(() => amtF.classList.remove('on'), null, '+=0.3');
                        tl.to(cont, { scale: 0.94, duration: 0.1, yoyo: true, repeat: 1, ease: 'power2.inOut' }, '+=0.15');
                        tl.call(() => { cont.textContent = busy; });
                        tl.to(box, { height: 0, opacity: 0, duration: 0.4, ease: 'power2.inOut' }, '+=1');
                        tl.to(scroll, { y: () => maxY() + 84, duration: 0.4, ease: 'power2.inOut' }, '<');
                        tl.to(phNew, { height: 'auto', opacity: 1, duration: 0.4, ease: 'power2.out' }, '<');
                        const o = { v: PAID0 };
                        tl.to(o, { v: PAID1, duration: 1.2, ease: 'power2.out', onUpdate: () => paint(o.v, false) }, '<');
                        tl.to(newPago, { height: 'auto', opacity: 1, duration: 0.5, ease: 'power2.out' }, '<0.1');
                        tl.fromTo(newPago.firstElementChild, { backgroundColor: 'rgba(16,185,129,0.16)' }, { immediateRender: false, backgroundColor: 'rgba(16,185,129,0)', duration: 2.6, ease: 'power1.in' }, '<0.2');
                        tl.to(newTl, { height: 'auto', opacity: 1, duration: 0.5, ease: 'power2.out' }, '<');
                        tl.fromTo(bell, { scale: 1 }, { immediateRender: false, scale: 1.9, duration: 0.25, yoyo: true, repeat: 1, ease: 'power2.out' }, '<');
                        tl.to(scroll, { y: 0, duration: 1.4, ease: 'power2.inOut' }, '+=0.7');
                        const h = { v: TOTAL - PAID0 };
                        tl.to(h, { v: TOTAL - PAID1, duration: 1.1, ease: 'power2.out', onUpdate: () => { phSaldo.textContent = fm(h.v); } }, '-=0.45');
                        tl.to({}, { duration: 4.2 });
                        tl.to([page, grid], { opacity: 0, duration: 0.3 });
                        tl.call(reset);
                        tl.to([page, grid], { opacity: 1, duration: 0.4 });
                    };
                    ScrollTrigger.create({ trigger: faHero, start: 'top 90%', once: true, onEnter: () => gsap.delayedCall(0.6, loop) });
                    const phone = faHero.querySelector('.mkc-fa-phone');
                    if (phone) gsap.to(phone, { y: 6, duration: 3.9, ease: 'sine.inOut', yoyo: true, repeat: -1 });
                }

                // Workflows: la espera vence, el correo llega al teléfono del cliente y la ejecución queda registrada
                const wfHero = document.getElementById('wfHero');
                if (wfHero) {
                    const $ = (id) => document.getElementById(id);
                    const phone = $('wfPhone'), lock = $('wfLock'), notif = $('wfNotif'), mailView = $('wfMailView');
                    const tabEd = $('wfTabEd'), tabRuns = $('wfTabRuns'), canvas = $('wfCanvas'), runs = $('wfRuns'), runNew = $('wfRunNew'), mailNode = $('wfMail');
                    const tab = (onRuns) => { tabEd.classList.toggle('on', !onRuns); tabRuns.classList.toggle('on', onRuns); };
                    const setLock = (on) => phone.classList.toggle('is-lock', on);
                    const reset = () => {
                        setLock(true); gsap.set(lock, { autoAlpha: 1 }); gsap.set(notif, { y: -24, autoAlpha: 0, scale: 1 });
                        tab(false); gsap.set(canvas, { autoAlpha: 1 }); gsap.set(runs, { autoAlpha: 0 });
                        gsap.set(runNew, { height: 0, opacity: 0 });
                    };
                    reset();
                    const loop = () => {
                        const tl = gsap.timeline({ onComplete: loop });
                        tl.fromTo(mailNode, { scale: 1 }, { scale: 1.035, duration: 0.28, yoyo: true, repeat: 1, ease: 'power2.inOut' }, 0.9);
                        tl.to(notif, { y: 0, autoAlpha: 1, duration: 0.55, ease: 'back.out(1.5)' }, '+=0.15');
                        tl.to(notif, { scale: 0.97, duration: 0.12, yoyo: true, repeat: 1, ease: 'power2.inOut' }, '+=1.7');
                        tl.call(() => setLock(false));
                        tl.to(lock, { autoAlpha: 0, duration: 0.45, ease: 'power2.out' });
                        tl.fromTo(mailView, { y: 12, opacity: 0.4 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power2.out' }, '<');
                        tl.call(() => tab(true), null, '+=2.2');
                        tl.to(canvas, { autoAlpha: 0, duration: 0.3 }, '<');
                        tl.to(runs, { autoAlpha: 1, duration: 0.3 }, '<0.1');
                        tl.to(runNew, { height: 'auto', opacity: 1, duration: 0.5, ease: 'power2.out' }, '+=0.25');
                        tl.fromTo(runNew.firstElementChild, { backgroundColor: 'rgba(59,130,246,0.12)' }, { immediateRender: false, backgroundColor: 'rgba(59,130,246,0)', duration: 2.4, ease: 'power1.in' }, '<0.2');
                        tl.call(() => tab(false), null, '+=2.4');
                        tl.to(runs, { autoAlpha: 0, duration: 0.3 }, '<');
                        tl.to(canvas, { autoAlpha: 1, duration: 0.35 }, '<0.1');
                        tl.call(() => setLock(true), null, '+=2.2');
                        tl.set(notif, { y: -24, autoAlpha: 0 }, '<');
                        tl.to(lock, { autoAlpha: 1, duration: 0.45 }, '<');
                        tl.set(runNew, { height: 0, opacity: 0 });
                    };
                    ScrollTrigger.create({ trigger: wfHero, start: 'top 90%', once: true, onEnter: () => gsap.delayedCall(0.4, loop) });
                    gsap.to(phone, { y: 6, duration: 3.9, ease: 'sine.inOut', yoyo: true, repeat: -1 });
                }

                // Finanzas: el flujo de 90 días se arma por fuente y la caja se acumula
                const fnHero = document.getElementById('fnHero');
                if (fnHero) {
                    const fills = fnHero.querySelectorAll('.mkc-fn-fill');
                    const hbars = fnHero.querySelectorAll('.mkc-fn-ht i');
                    const line = document.getElementById('fnLine'), area = document.getElementById('fnArea2');
                    const nums = [...fnHero.querySelectorAll('[data-fn-n]')];
                    const fmt = (el, v) => el.hasAttribute('data-pct') ? Math.round(v) + '%' : Math.round(v).toLocaleString('en-US');
                    const reset = () => {
                        gsap.set([fills, hbars], { scaleX: 0 });
                        gsap.set(line, { strokeDasharray: 1, strokeDashoffset: 1 }); gsap.set(area, { opacity: 0 });
                        nums.forEach((el) => { el.textContent = fmt(el, 0); });
                        gsap.set(nums, { opacity: 0 });
                    };
                    reset();
                    const loop = () => {
                        const tl = gsap.timeline({ onComplete: loop });
                        tl.to(fills, { scaleX: 1, duration: 0.75, stagger: 0.07, ease: 'power3.out' }, 0.2);
                        tl.to(nums, { opacity: 1, duration: 0.3 }, 0.2);
                        nums.forEach((el) => {
                            const o = { v: 0 };
                            tl.to(o, { v: Number(el.dataset.fnN), duration: 1.3, ease: 'power2.out', onUpdate: () => { el.textContent = fmt(el, o.v); } }, 0.2);
                        });
                        tl.to(hbars, { scaleX: 1, duration: 0.7, stagger: 0.09, ease: 'power3.out' }, 0.55);
                        tl.to(line, { strokeDashoffset: 0, duration: 1.7, ease: 'power2.inOut' }, 0.6);
                        tl.to(area, { opacity: 1, duration: 0.8 }, 1.5);
                        tl.to({}, { duration: 5.6 });
                        tl.to([...nums, area], { opacity: 0, duration: 0.3 });
                        tl.to([fills, hbars], { scaleX: 0, duration: 0.4, ease: 'power2.in' }, '<');
                        tl.to(line, { strokeDashoffset: 1, duration: 0.4, ease: 'power2.in' }, '<');
                        tl.call(reset);
                    };
                    ScrollTrigger.create({ trigger: fnHero, start: 'top 90%', once: true, onEnter: () => gsap.delayedCall(0.4, loop) });
                }

                // Equipo: cambias de organización, invitas con permisos exactos y la invitación queda en la tabla
                const eqHero = document.getElementById('eqHero');
                if (eqHero) {
                    const $ = (id) => document.getElementById(id);
                    const org = $('eqOrg'), orgBtn = $('eqOrgBtn'), scrim = $('eqScrim'), modal = $('eqModal'), add = $('eqAdd'), send = $('eqSend');
                    const emailF = $('eqEmailF'), email = $('eqEmail'), pd = $('eqPd'), row = $('eqNewRow'), toast = $('eqToast');
                    const seats = $('eqSeats'), bar = $('eqSeatBar'), cAll = $('eqCAll'), cInv = $('eqCInv');
                    const presets = [...modal.querySelectorAll('[data-p]')], toggles = [...modal.querySelectorAll('[data-k]')];
                    const mail = email.textContent, tpl = seats.dataset.tpl;
                    const VEND = ['cotizar', 'clientes', 'productos', 'analitica'];
                    const setPreset = (p) => { presets.forEach((el) => el.classList.toggle('on', el.dataset.p === p)); pd.textContent = pd.dataset[p]; };
                    const setToggles = (keys) => toggles.forEach((el) => el.classList.toggle('on', keys.includes(el.dataset.k)));
                    const setCount = (n) => { seats.textContent = tpl.replace('{n}', n); bar.style.width = (n / 15 * 100) + '%'; cAll.textContent = n + 1; cInv.textContent = n - 5; };
                    const toggleOn = (tl, id) => tl.call(() => $(id).classList.add('on'));
                    gsap.set(toast, { autoAlpha: 0, y: 8 });
                    const loop = () => {
                        const tl = gsap.timeline({ onComplete: loop });
                        tl.call(() => orgBtn.classList.add('is-open'), null, 0.5);
                        tl.fromTo(org, { autoAlpha: 0, y: -4, scale: 0.98 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.3, ease: 'power2.out' }, '<');
                        tl.to(org, { autoAlpha: 0, y: -4, scale: 0.98, duration: 0.25, ease: 'power2.in' }, 2.6);
                        tl.call(() => orgBtn.classList.remove('is-open'), null, '<');
                        tl.to(add, { scale: 0.95, duration: 0.1, yoyo: true, repeat: 1 }, '+=0.45');
                        tl.call(() => { email.textContent = ''; emailF.classList.add('on'); setPreset('vendedor'); setToggles(VEND); });
                        tl.to(scrim, { autoAlpha: 1, duration: 0.3 });
                        tl.fromTo(modal, { autoAlpha: 0, scale: 0.96 }, { autoAlpha: 1, scale: 1, duration: 0.35, ease: 'power2.out' }, '<');
                        tl.set(row, { height: 0, opacity: 0 }, '<');
                        tl.call(() => setCount(5), null, '<');
                        for (let i = 1; i <= mail.length; i++) tl.call(() => { email.textContent = mail.slice(0, i); }, null, i === 1 ? '+=0.3' : '+=0.035');
                        tl.call(() => emailF.classList.remove('on'), null, '+=0.2');
                        tl.to(presets[2], { scale: 0.94, duration: 0.1, yoyo: true, repeat: 1 }, '+=0.35');
                        tl.call(() => { setPreset('lectura'); setToggles([]); });
                        toggleOn(tl.to({}, { duration: 0.75 }), 'eqPCob');
                        tl.call(() => setPreset('custom'));
                        toggleOn(tl.to({}, { duration: 0.55 }), 'eqPInf');
                        tl.to(send, { scale: 0.95, duration: 0.1, yoyo: true, repeat: 1 }, '+=0.6');
                        tl.to(modal, { autoAlpha: 0, scale: 0.97, duration: 0.25, ease: 'power2.in' }, '+=0.1');
                        tl.to(scrim, { autoAlpha: 0, duration: 0.3 }, '<');
                        tl.to(row, { height: 'auto', opacity: 1, duration: 0.5, ease: 'power2.out' });
                        tl.fromTo(row.firstElementChild, { backgroundColor: 'rgba(245,158,11,0.14)' }, { immediateRender: false, backgroundColor: 'rgba(245,158,11,0)', duration: 2.6, ease: 'power1.in' }, '<0.2');
                        tl.call(() => setCount(6), null, '<');
                        tl.to(toast, { autoAlpha: 1, y: 0, duration: 0.35, ease: 'power2.out' }, '<');
                        tl.to(toast, { autoAlpha: 0, y: 8, duration: 0.3 }, '+=2.2');
                        tl.to({}, { duration: 1.2 });
                    };
                    ScrollTrigger.create({ trigger: eqHero, start: 'top 90%', once: true, onEnter: loop });
                }

                // ── Ambient float sutil para TODOS los mockups del hero (toque Linear, sobrio) ──
                const heroMock = wrap.querySelector('.pp-mockup > *');
                if (heroMock) {
                    gsap.to(heroMock, { y: '-=7', duration: 4.6, ease: 'sine.inOut', yoyo: true, repeat: -1 });
                }

            }

            // ───────────────────────── BLOCK MOCKUPS GSAP ─────────────────────────
            // Editor M0 (Discount Row & Cursor)
            const bEditor0 = document.querySelector('.bm-editor-m0');
            if (bEditor0) {
                const cursor = bEditor0.querySelector('.bm-fake-cursor');
                const row = bEditor0.querySelector('.bm-row-target');
                const chip = bEditor0.querySelector('.mk-chip');
                const price = bEditor0.querySelector('.price-val');
                const obj = { val: 191.48 };

                if (cursor && row && chip && price) {
                    ScrollTrigger.create({
                        trigger: bEditor0, start: 'top 85%',
                        onEnter: () => {
                            const tl = gsap.timeline({ repeat: -1, repeatDelay: 2.2 });
                            tl.set(cursor, { x: 210, y: 230, opacity: 0 })
                              .set(chip, { opacity: 0, scale: 0.5 })
                              .to(cursor, { opacity: 1, duration: 0.4 })
                              .to(cursor, { x: 330, y: 118, duration: 1, ease: 'power3.inOut' })
                              .to(cursor, { scale: 0.85, duration: 0.1, yoyo: true, repeat: 1 })
                              .to(row, { backgroundColor: 'rgba(16,185,129,0.12)', duration: 0.3 })
                              .to(chip, { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(1.5)' })
                              .to(row, { backgroundColor: 'transparent', duration: 0.3 })
                              .to(obj, { val: 168.50, duration: 0.8, onUpdate: () => price.textContent = `$${obj.val.toFixed(2)}` }, '-=0.3')
                              .to(cursor, { opacity: 0, y: '+=30', duration: 0.5 });
                        }
                    });
                }
            }

            // Editor M1 (catálogo — filas en cascada + caret que teclea)
            const bEditor1 = document.querySelector('.bm-editor-m1');
            if (bEditor1) {
                const rows = bEditor1.querySelectorAll('.cat-r');
                const caret = bEditor1.querySelector('.bm-search-caret');
                if (caret) gsap.to(caret, { opacity: 0, duration: 0.5, repeat: -1, yoyo: true, ease: 'steps(1)' });
                if (rows.length) {
                    ScrollTrigger.create({
                        trigger: bEditor1, start: 'top 85%', once: true,
                        onEnter: () => gsap.fromTo(rows, { opacity: 0, x: -10 }, { opacity: 1, x: 0, stagger: 0.1, duration: 0.55, ease: 'power2.out', delay: 0.3 }),
                    });
                }
            }

            // Editor M2 (resumen — filas de totales en cascada)
            const bEditor2 = document.querySelector('.bm-editor-m2');
            if (bEditor2) {
                const rows = bEditor2.querySelectorAll('.bm-stag-row');
                if (rows.length) {
                    ScrollTrigger.create({
                        trigger: bEditor2, start: 'top 85%', once: true,
                        onEnter: () => gsap.fromTo(rows, { opacity: 0, x: -10 }, { opacity: 1, x: 0, stagger: 0.14, duration: 0.6, ease: 'power2.out', delay: 0.3 }),
                    });
                }
            }

            // ── Ventanas completas del bento (bm-app): cascada de filas al entrar ──
            document.querySelectorAll('.pp-bcard-visual .bm-app').forEach((app) => {
                const stage = app.closest('.bm-stage');
                if (stage && /bm-editor-m/.test(stage.className || '')) return; // editor tiene su propia animación
                const rows = app.querySelectorAll('.bm-kv, .bm-step, .bm-cc-b, .bm-stat, .bm-tot-r, .bm-g:not(.bm-g-head)');
                if (!rows.length) return;
                gsap.set(rows, { opacity: 0, y: 10 });
                ScrollTrigger.create({
                    trigger: app, start: 'top 88%', once: true,
                    onEnter: () => gsap.to(rows, { opacity: 1, y: 0, duration: 0.5, stagger: 0.07, ease: 'power2.out', delay: 0.2, clearProps: 'transform' }),
                });
                const approve = app.querySelector('.bm-lp-approve');
                if (approve) gsap.to(approve, { boxShadow: '0 6px 16px -4px rgba(10,25,47,0.4), 0 0 0 5px rgba(10,25,47,0.12)', duration: 1, repeat: -1, yoyo: true, ease: 'sine.inOut' });
            });

        }
    });
</script>
