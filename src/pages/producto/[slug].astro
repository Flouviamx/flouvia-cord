    .mkc-py-tr > span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-py-tr b { font-size: 10px; font-weight: 600; }
    .mkc-py-m { display: flex; align-items: center; gap: 6px; color: #5b6472; font-size: 9.5px; }
    .mkc-py-m i { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .mkc-py-d { color: #5b6472; font-size: 9.5px; }
