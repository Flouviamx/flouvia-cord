    .mkc-py-body { overflow: hidden; }
    .mkc-py-hot { margin: 0 -6px; padding-left: 6px; padding-right: 6px; border-radius: 7px; }

    /* Página de pago (q/[token]/pay) a ancho de teléfono */
    .mkc-py-phone .mkc-phone-scr { background: #f5f5f7; }
    .mkc-py-phone .mkc-ios { background: linear-gradient(#f5f5f7 72%, rgba(245,245,247,0)); }
    .mkc-pp { display: flex; flex-direction: column; gap: 7px; padding: 6px 9px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif; }
