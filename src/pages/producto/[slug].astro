    .mkc-py-cols > div { min-width: 0; padding: 12px 14px 13px; }
    .mkc-py-cols > div + div { border-left: 1px solid rgba(10,25,47,0.07); }
    .mkc-py-saldo { display: flex; flex-direction: column; justify-content: center; gap: 6px; }
    .mkc-py-saldo b { font-size: 29px; line-height: 1; letter-spacing: -0.05em; color: #0a192f; white-space: nowrap; }
    .mkc-py-saldo b small { margin-right: 4px; font-size: 11px; letter-spacing: 0; color: #5b6472; }
    .mkc-py-saldo small { font-size: 9.5px; color: #5b6472; }
    .mkc-py-side .mkc-sh b { font-size: 10.5px; white-space: nowrap; }
