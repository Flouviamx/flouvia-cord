    /* ════════ STATS ════════ */
    .pp-stats {
        padding: 5.5rem 5%;
    }
    .pp-stats-inner {
        max-width: 800px; margin: 0 auto;
        display: flex; flex-direction: column;
    }
    .pp-stat { 
        display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
        padding: 1.6rem 0;
        border-bottom: 1px solid var(--color-border);
    }
    .pp-stat:first-child { border-top: 1px solid var(--color-border); }
    .pp-stat-label { font-size: 1.1rem; color: var(--color-text-muted); font-weight: 500; }
    .pp-stat-label::first-letter { text-transform: uppercase; }
    .pp-stat-dots {
        flex: 1; border-bottom: 1px dotted var(--color-border);
        opacity: 0.6; position: relative; top: -5px;
    }
    .pp-stat-num {
        font-size: 1.4rem; color: var(--color-text); font-weight: 600; letter-spacing: -0.02em;
    }

    /* ════════ BENTO GRID — ElevenLabs / Stripe style ════════ */
    .pp-bento {
        max-width: 1360px;
        margin: 0 auto;
        padding: 6rem 5% 5rem;
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: 1.2rem;
    }

    /* Cards 0 and 1 sit side-by-side; card 2+ span full width */
    .pp-bcard-2,
    .pp-bcard-3 {
        grid-column: 1 / -1;
    }

    .pp-bcard {
        background: #fff;
        border-radius: 28px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 540px;
        box-shadow:
            0 2px 4px rgba(10,25,47,0.04),
            0 28px 56px -16px rgba(10,25,47,0.14),
            inset 0 1px 0 rgba(255,255,255,0.6);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    .pp-bcard:hover {
        transform: translateY(-6px);
        box-shadow:
            0 2px 4px rgba(10,25,47,0.05),
            0 38px 72px -18px rgba(10,25,47,0.2),
            inset 0 1px 0 rgba(255,255,255,0.6);
    }

    /* Full-width cards: text left, visual right */
    .pp-bcard-2,
    .pp-bcard-3 {
        flex-direction: row;
        min-height: 480px;
    }

    /* Text sits in the upper-left — same apple-gray surface */
    .pp-bcard-text {
