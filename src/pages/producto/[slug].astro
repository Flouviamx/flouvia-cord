    .mkc-iv-partial { display: flex; justify-content: center; margin-top: 6px; padding: 7px; font-size: 8px; font-weight: 600; color: #4a5567; border: 1px solid #e5e7eb; border-radius: 99px; }
    .mkc-iv-box { height: 0; opacity: 0; overflow: hidden; }
    .mkc-iv-box-in { margin-top: 7px; padding: 9px; background: #f5f5f7; border: 1px solid #e5e7eb; border-radius: 11px; }
