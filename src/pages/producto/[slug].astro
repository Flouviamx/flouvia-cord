    .mkc-pp-amt small { font-size: 9px; }
    .mkc-pp-flow { display: grid; }
    .mkc-pp-flow > * { grid-area: 1 / 1; }
    .mkc-pp-form { display: flex; flex-direction: column; gap: 6px; }
    .mkc-pp-lg { font-size: 8.5px; font-weight: 600; color: #4a5567; }
