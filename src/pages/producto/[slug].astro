    .mkc-iv-in { flex: 1; min-height: 22px; display: flex; align-items: center; justify-content: flex-end; padding: 0 8px; font-size: 10px; font-weight: 600; color: #111827; background: #fff; border: 1px solid transparent; border-radius: 8px; font-variant-numeric: tabular-nums; }
    .mkc-iv-in.on { border-color: rgba(10,25,47,0.28); box-shadow: 0 0 0 2px rgba(10,25,47,0.06); }
    .mkc-iv-box-in p { margin: 6px 0 8px; font-size: 6.5px; line-height: 1.45; color: #6b7280; }
    .mkc-iv-acts { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
    .mkc-iv-acts span { display: flex; justify-content: center; padding: 6px; font-size: 8px; font-weight: 650; color: #4a5567; background: #fff; border-radius: 99px; white-space: nowrap; }
