    /* ══ HERO CALCA · Pagos y finanzas (cobros · cobranza/agente · editor FX · clientes/[id] · informes flujo) ══ */
    .mkc-pad { display: flex; flex-direction: column; gap: 10px; padding: 0 var(--gut) 0 10px; min-width: 0; }
    .mkc-range { display: inline-flex; align-items: center; gap: 6px; padding: 5px 8px; font-size: 10.5px; font-weight: 600; color: #0f1729; background: #fff; border-radius: 8px; box-shadow: 0 0 0 1px rgba(10,25,47,0.08), 0 1px 2px rgba(10,25,47,0.05); white-space: nowrap; }
    .mkc-range svg { width: 11px; height: 11px; color: #5b6472; }
    .mkc-range .mkc-range-c { width: 8px; height: 8px; }
    .mkc-zone, .mkc-panel { background: #fff; border-radius: 16px; box-shadow: 0 1px 2px rgba(10,25,47,0.03), 0 14px 32px -20px rgba(10,25,47,0.18), inset 0 0 0 1px rgba(10,25,47,0.04); min-width: 0; }
    .mkc-panel { padding: 12px 14px; }
