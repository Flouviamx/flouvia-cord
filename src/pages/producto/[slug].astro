    .mkc-pp-foot { display: flex; gap: 5px; margin: 1px 4px 0; font-size: 7.5px; line-height: 1.45; color: #9aa2af; text-align: left; }
    .mkc-pp-foot svg { flex-shrink: 0; width: 8px; height: 8px; margin-top: 1px; opacity: 0.7; }

    /* ── Cobranza IA (cobranza/agente): el agente propone un plan y espera tu visto bueno ── */
    .mkc-ci-app { min-width: 820px; height: 486px; }
    .mkc-pgh-sub { font-size: 10px; color: #5b6472; white-space: nowrap; }
    .mkc-btn { display: inline-flex; align-items: center; padding: 5px 10px; font-size: 10px; font-weight: 600; color: #0f1729; background: #fff; border-radius: 99px; box-shadow: 0 0 0 1px rgba(10,25,47,0.1); white-space: nowrap; }
    .mkc-ci-acts { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .mkc-ci-state { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; font-size: 9.5px; font-weight: 700; color: #b45309; background: rgba(245,158,11,0.12); border-radius: 99px; white-space: nowrap; }
