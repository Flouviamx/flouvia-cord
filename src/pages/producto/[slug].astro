    .mkc-pp-in { display: flex; align-items: center; justify-content: space-between; gap: 4px; height: 25px; padding: 0 8px; font-size: 9.5px; color: #050505; background: #f5f5f7; border: 1px solid transparent; border-radius: 7px; font-variant-numeric: tabular-nums; }
    .mkc-pp-in.on { background: #fff; border-color: #14365c; box-shadow: 0 0 0 2px rgba(10,25,47,0.08); }
    .mkc-pp-v { min-width: 0; white-space: nowrap; overflow: hidden; }
    .mkc-pp-v:empty::before { content: attr(data-ph); color: #aab2bf; }
    .mkc-pp-cards { display: flex; gap: 3px; }
    .mkc-pp-cards img { width: 11px; height: 11px; border-radius: 3px; }
    .mkc-pp-cards i { display: flex; align-items: center; justify-content: center; width: 17px; height: 11px; border-radius: 2px; font-style: normal; font-size: 4.5px; font-weight: 900; letter-spacing: 0.02em; }
    .mkc-pp-cards .v { color: #1a1f71; background: #fff; box-shadow: inset 0 0 0 0.5px rgba(10,25,47,0.2); font-style: italic; font-size: 5px; }
    .mkc-pp-cards .m { background: #fff; box-shadow: inset 0 0 0 0.5px rgba(10,25,47,0.2); }
    .mkc-pp-cards .m b { width: 6px; height: 6px; border-radius: 50%; background: #eb001b; }
    .mkc-pp-cards .m b + b { margin-left: -2.5px; background: #f79e1b; mix-blend-mode: multiply; }
    .mkc-pp-cards .a { color: #fff; background: #1f72cd; }
    .mkc-pp-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
    .mkc-pp-btn { display: flex; align-items: center; justify-content: center; gap: 5px; margin-top: 3px; padding: 8px; font-size: 10px; font-weight: 600; letter-spacing: -0.01em; color: #fff; background: #14365c; border-radius: 99px; box-shadow: 0 8px 18px -8px rgba(10,25,47,0.5); }
    .mkc-pp-btn svg { width: 10px; height: 10px; }
    .mkc-pp-ok { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; text-align: center; visibility: hidden; opacity: 0; }
    .mkc-pp-ok svg { width: 38px; height: 38px; margin-bottom: 2px; }
    .mkc-pp-ok b { font-size: 11px; font-weight: 600; color: #050505; }
    .mkc-pp-ok span { max-width: 170px; font-size: 8.5px; line-height: 1.5; color: #6b7686; }
    .mkc-pp-ok em { margin-top: 2px; font-style: normal; font-size: 9px; font-weight: 600; color: #0a192f; }
