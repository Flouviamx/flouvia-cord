    .mkc-py-chips { display: grid; gap: 4px; }
    .mkc-py-chips span { display: flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 99px; background: #f5f5f7; font-size: 9px; }
    .mkc-py-chips strong { font-weight: 600; color: #0f1729; }
    .mkc-py-chips small { color: #5b6472; }
    .mkc-py-bank { margin: 6px 0 0; font-size: 8.5px; color: #5b6472; white-space: nowrap; }
    .mkc-py-th, .mkc-py-tr { display: grid; grid-template-columns: 58px minmax(0, 1.4fr) minmax(0, 1.4fr) 62px 76px; gap: 10px; align-items: center; }
    .mkc-py-th { padding-bottom: 6px; font-size: 7.5px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: #5b6472; border-bottom: 1px solid rgba(10,25,47,0.07); }
