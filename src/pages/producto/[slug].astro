    .mkc-iv-dl { display: flex; justify-content: center; gap: 12px; margin-top: 10px; font-size: 7.5px; font-weight: 650; color: #0a192f; }
    .mkc-iv-uuid { margin: 8px 0 0; font-size: 6px; color: #9ca3af; word-break: break-all; }
    .mkc-iv-pow { margin: 3px 0 0; font-size: 6px; color: #9ca3af; }

    /* ── Workflows (workflows/[id]): la escalera corre sola y el correo le llega al cliente ── */
    .mkc-wf { height: 510px; }
    .mkc-wf-app { margin-left: 172px; min-width: 660px; height: 500px; }
    .mkc-wf-phone { left: 0; top: 20px; }
    .mkc-wf-bar { display: flex; align-items: center; gap: 7px; padding: 12px var(--gut) 9px 10px; }
    .mkc-wf-x, .mkc-wf-more { width: 24px; height: 24px; flex-shrink: 0; display: grid; place-items: center; color: #0f1729; background: #fff; border-radius: 8px; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.09); }
    .mkc-wf-x svg { width: 11px; height: 11px; }
    .mkc-wf-more svg { width: 12px; height: 12px; color: #5b6472; }
    .mkc-wf-name { min-width: 0; font-size: 13px; font-weight: 700; letter-spacing: -0.03em; color: #0f1729; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-wf-badge { flex-shrink: 0; font-size: 8.5px; font-weight: 700; padding: 3px 8px; border-radius: 99px; color: #047857; background: rgba(16,185,129,0.12); }
    .mkc-wf-acts { display: flex; align-items: center; gap: 5px; margin-left: auto; flex-shrink: 0; }
    .mkc-wf-btn { font-size: 9.5px; font-weight: 600; padding: 5px 10px; border-radius: 99px; color: #0f1729; background: #fff; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.1); white-space: nowrap; }
    .mkc-wf-btn.pri { color: #fff; background: #0a192f; box-shadow: 0 6px 14px -8px rgba(10,25,47,0.6); }
    @container (max-width: 880px) { .mkc-wf-save { display: none; } }
    .mkc-wf-tabs { display: flex; gap: 16px; margin: 0 var(--gut) 9px 10px; border-bottom: 1px solid rgba(10,25,47,0.08); }
    .mkc-wf-tabs span { padding: 0 1px 6px; font-size: 10.5px; font-weight: 600; color: #5b6472; }
    .mkc-wf-tabs span.on { color: #0f1729; box-shadow: inset 0 -2px 0 #0a192f; }
    .mkc-wf-app .mkc-main { min-height: 0; }
    .mkc-wf-body { position: relative; flex: 1; min-height: 0; display: grid; margin: 0 var(--gut) 0 10px; }
    .mkc-wf-body > * { grid-area: 1 / 1; min-height: 0; min-width: 0; }
    .mkc-wf-canvas { position: relative; overflow: hidden; border-radius: 16px 16px 0 0; background-color: #f8f8fa; background-image: radial-gradient(rgba(10,25,47,0.13) 1px, transparent 1px); background-size: 14px 14px; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.08); }
    .mkc-wf-flow { display: flex; flex-direction: column; align-items: center; padding-top: 18px; }
    .mkc-wf-node { position: relative; width: 206px; display: flex; align-items: center; gap: 8px; padding: 8px 7px 8px 9px; background: #fff; border-radius: 11px; box-shadow: 0 0 0 1px rgba(10,25,47,0.09), 0 1px 2px rgba(10,25,47,0.04), 0 8px 20px -14px rgba(10,25,47,0.3); }
    .mkc-wf-ic { width: 24px; height: 24px; flex-shrink: 0; display: grid; place-items: center; border-radius: 8px; color: #0a192f; background: #f5f5f7; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.08); }
    .mkc-wf-ic :global(svg), .mkc-wf-dia :global(svg) { width: 13px; height: 13px; }
    .mkc-wf-tx { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
    .mkc-wf-tx small { font-size: 7.5px; color: #5b6472; }
    .mkc-wf-tx b { font-size: 9.5px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; color: #0f1729; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
    .mkc-wf-tx em { font-style: normal; font-size: 8px; color: #5b6472; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-wf-dots { width: 18px; height: 18px; flex-shrink: 0; display: grid; place-items: center; color: #99a2af; }
    .mkc-wf-dots svg { width: 11px; height: 11px; }
    .mkc-wf-node.is-empty { background: transparent; box-shadow: none; outline: 1.3px dashed rgba(10,25,47,0.2); outline-offset: -1px; }
    .mkc-wf-node.is-empty .mkc-wf-ic { background: #fff; }
    .mkc-wf-node.is-empty b { color: #0a192f; }
    .mkc-wf-node.is-sel { box-shadow: 0 0 0 1px #0a192f, 0 0 0 4px rgba(10,25,47,0.08), 0 8px 20px -14px rgba(10,25,47,0.3); }
    .mkc-wf-link { display: block; width: 1.5px; height: 20px; background: rgba(10,25,47,0.18); }
    .mkc-wf-dia { position: relative; width: 34px; height: 34px; display: grid; place-items: center; color: #0a192f; }
    .mkc-wf-dia::before { content: ''; position: absolute; inset: 6px; border-radius: 7px; transform: rotate(45deg); background: #fff; box-shadow: 0 0 0 1px rgba(10,25,47,0.1), 0 8px 18px -12px rgba(10,25,47,0.3); }
    .mkc-wf-dia :global(svg) { position: relative; }
    .mkc-wf-cs { margin-top: 9px; }
    .mkc-wf-cs::before { content: ''; position: absolute; left: 50%; top: -10px; width: 1.5px; height: 9px; background: rgba(10,25,47,0.18); }
    .mkc-wf-brs { position: relative; display: grid; grid-template-columns: 1fr 1fr; column-gap: 22px; margin-top: 12px; padding-top: 20px; }
    .mkc-wf-brs::before { content: ''; position: absolute; top: 0; left: calc(25% - 5px); right: calc(25% - 5px); height: 20px; border: 1.5px solid rgba(10,25,47,0.18); border-bottom: none; border-radius: 10px 10px 0 0; }
    .mkc-wf-brs::after { content: ''; position: absolute; top: -12px; left: 50%; width: 1.5px; height: 12px; background: rgba(10,25,47,0.18); }
    .mkc-wf-br { display: flex; flex-direction: column; align-items: center; min-width: 0; }
    .mkc-wf-lbl { margin-bottom: 9px; padding: 3px 9px; font-size: 8px; font-weight: 600; color: #5b6472; background: #fff; border-radius: 99px; box-shadow: 0 0 0 1px rgba(10,25,47,0.09); white-space: nowrap; }
    .mkc-wf-zoom { position: absolute; left: 10px; bottom: 10px; display: flex; flex-direction: column; overflow: hidden; background: #fff; border-radius: 9px; box-shadow: 0 0 0 1px rgba(10,25,47,0.09), 0 6px 14px -10px rgba(10,25,47,0.3); }
    .mkc-wf-zoom span { width: 24px; height: 24px; display: grid; place-items: center; color: #5b6472; }
    .mkc-wf-zoom span + span { border-top: 1px solid rgba(10,25,47,0.08); }
    .mkc-wf-zoom svg { width: 11px; height: 11px; }
    .mkc-wf-runs { overflow: hidden; visibility: hidden; opacity: 0; }
    .mkc-wf-runs-bar { display: flex; justify-content: flex-end; margin-bottom: 4px; }
    .mkc-wf-rw { overflow: hidden; }
    .mkc-wf-run { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 9px 5px; border-bottom: 1px solid rgba(10,25,47,0.08); border-radius: 8px; }
    .mkc-wf-run > span { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .mkc-wf-run b { font-size: 10px; font-weight: 600; color: #0f1729; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-wf-run small { font-size: 8.5px; color: #5b6472; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-wf-run em { font-style: normal; font-size: 8.5px; color: #5b6472; white-space: nowrap; }
    .mkc-wf-pill { justify-self: start; display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; font-style: normal; font-size: 8px; font-weight: 700; border-radius: 99px; white-space: nowrap; }
    .mkc-wf-pill::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .mkc-wf-pill.ok { color: #047857; background: rgba(16,185,129,0.12); }
    .mkc-wf-pill.fail { color: #b91c1c; background: rgba(239,68,68,0.1); }
    .mkc-wf-pill.wait { color: #1d4ed8; background: rgba(59,130,246,0.1); }

    /* El correo del workflow en Mail (iOS), con la notificación en pantalla bloqueada */
    .mkc-wf-phone .mkc-phone-scr { background: #fff; }
    .mkc-wf-phone .mkc-ios { background: linear-gradient(#fff 72%, rgba(255,255,255,0)); }
    .mkc-wf-phone.is-lock .mkc-ios { color: #fff; background: none; }
    .mkc-wf-phone.is-lock .mkc-ios > b { visibility: hidden; }
    .mkc-wf-phone.is-lock .mkc-ios-sig i, .mkc-wf-phone.is-lock .mkc-ios-bat i { background: #fff; }
    .mkc-wf-phone.is-lock .mkc-ios-bat { border-color: rgba(255,255,255,0.55); }
    .mkc-wf-phone.is-lock .mkc-home { background: #fff; }
    .mkc-ml { display: flex; flex-direction: column; padding: 2px 12px 0; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif; color: #111; }
    .mkc-ml-nav { display: flex; align-items: center; justify-content: space-between; height: 24px; font-size: 10.5px; color: #007aff; }
    .mkc-ml-nav span { display: flex; align-items: center; gap: 1px; }
    .mkc-ml-nav .r { gap: 12px; }
    .mkc-ml-nav svg { width: 13px; height: 13px; }
    .mkc-ml-head { display: flex; align-items: center; gap: 8px; padding: 8px 0 7px; border-bottom: 0.5px solid rgba(0,0,0,0.12); }
    .mkc-ml-head i { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-style: normal; font-size: 9.5px; font-weight: 600; color: #fff; background: linear-gradient(#aeb4bf, #868d99); border-radius: 50%; }
    .mkc-ml-head span { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .mkc-ml-head b { font-size: 10.5px; font-weight: 600; }
    .mkc-ml-head small { font-size: 8.5px; color: #8e8e93; }
    .mkc-ml-head em { align-self: flex-start; font-style: normal; font-size: 8.5px; color: #8e8e93; }
    .mkc-ml-subj { display: block; margin: 8px 0 2px; font-size: 12.5px; font-weight: 700; line-height: 1.25; letter-spacing: -0.02em; }
    .mkc-ml-body { display: flex; flex-direction: column; align-items: flex-start; gap: 7px; padding: 10px 2px 0; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    .mkc-ml-body img { width: 40px; height: auto; margin-bottom: 3px; }
    .mkc-ml-body b { font-size: 9.5px; font-weight: 500; color: #111827; }
    .mkc-ml-body p { margin: 0; font-size: 9px; line-height: 1.6; color: #374151; }
    .mkc-ml-cta { margin: 4px 0; padding: 6px 11px; font-size: 9px; font-weight: 500; color: #fff; background: #0a192f; border-radius: 6px; }
    .mkc-ml-body small { font-size: 7.5px; line-height: 1.5; color: #6b7280; }
    .mkc-ml-body u { display: block; color: #2563eb; text-decoration: none; }
    .mkc-ml-body em { align-self: stretch; margin-top: 6px; padding-top: 8px; font-style: normal; font-size: 7px; color: #9ca3af; border-top: 1px solid #e5e7eb; }
    .mkc-ml-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 44px; display: flex; align-items: flex-start; justify-content: space-around; padding-top: 9px; color: #007aff; background: rgba(249,249,249,0.97); border-top: 0.5px solid rgba(0,0,0,0.1); }
    .mkc-ml-bar svg { width: 15px; height: 15px; }
    .mkc-ml-lock { position: absolute; inset: 0; z-index: 5; display: flex; flex-direction: column; align-items: center; padding-top: 50px; color: #fff; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif; background: radial-gradient(ellipse 80% 55% at 25% 18%, rgba(92,96,160,0.75), transparent 62%), radial-gradient(ellipse 75% 55% at 85% 85%, rgba(122,78,120,0.7), transparent 60%), linear-gradient(170deg, #161c38 0%, #262244 55%, #33263f 100%); visibility: hidden; opacity: 0; }
    .mkc-ml-date { font-size: 10px; font-weight: 500; opacity: 0.9; }
    .mkc-ml-clock { margin-top: 1px; font-size: 52px; font-weight: 600; line-height: 1; letter-spacing: -0.02em; }
    .mkc-ml-notif { display: flex; gap: 8px; width: calc(100% - 16px); margin-top: 26px; padding: 9px 10px; color: #111; background: rgba(250,250,252,0.9); border-radius: 16px; box-shadow: 0 10px 24px -12px rgba(0,0,0,0.5); }
    .mkc-ml-app { width: 26px; height: 26px; flex-shrink: 0; display: grid; place-items: center; font-style: normal; background: linear-gradient(#45a6ff, #0a6cf0); border-radius: 7px; }
    .mkc-ml-app svg { width: 15px; height: 15px; }
    .mkc-ml-notif > span { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
    .mkc-ml-notif .t { display: flex; justify-content: space-between; gap: 6px; }
    .mkc-ml-notif b, .mkc-ml-notif strong { font-size: 9px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mkc-ml-notif em { font-style: normal; font-size: 8px; color: #6b7280; }
    .mkc-ml-notif small { font-size: 8.5px; line-height: 1.35; color: #3c3c43; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
    .mkc-ml-lb { position: absolute; bottom: 26px; width: 30px; height: 30px; display: grid; place-items: center; background: rgba(255,255,255,0.14); border-radius: 50%; }
    .mkc-ml-lb.l { left: 22px; }
    .mkc-ml-lb.r { right: 22px; }
    .mkc-ml-lb svg { width: 14px; height: 14px; }

    /* ── Equipo (ajustes/equipo + selector de organizaciones): invitas con permisos exactos ── */
    .mkc-eq-app { min-width: 820px; height: 500px; }
    .mkc-rail-org.is-open { box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px rgba(10,25,47,0.22); }
    .mkc-ti-on { color: #fff; background: #0a192f; border-radius: 7px; }
    .mkc-eq-page { display: flex; flex-direction: column; min-width: 0; padding: 13px var(--gut) 0 10px; }
    .mkc-eq-crumb { display: flex; align-items: center; gap: 4px; font-size: 9.5px; font-weight: 600; color: #5b6472; }
    .mkc-eq-crumb svg { width: 10px; height: 10px; }
    .mkc-eq-crumb i { font-style: normal; color: #c4cad3; margin: 0 2px; }
    .mkc-eq-crumb b { color: #0f1729; font-weight: 600; }
    .mkc-eq-h { margin-top: 6px; font-size: 18px; font-weight: 700; letter-spacing: -0.035em; line-height: 1.1; color: #0f1729; }
    .mkc-eq-desc { margin-top: 3px; font-size: 9.5px; color: #5b6472; }
    .mkc-eq-tabs { align-self: flex-start; display: inline-flex; gap: 2px; margin-top: 11px; padding: 2px; background: rgba(10,25,47,0.065); border-radius: 9px; }
    .mkc-eq-tabs i { font-style: normal; font-size: 9.5px; font-weight: 600; padding: 5px 10px; color: #5b6472; border-radius: 7px; }
    .mkc-eq-tabs i.on { color: #0f1729; background: #fff; box-shadow: 0 1px 3px rgba(10,25,47,0.12); }
    .mkc-eq-seats { display: flex; align-items: center; gap: 12px; margin-top: 13px; }
    .mkc-eq-seats > b { font-size: 11.5px; color: #0f1729; white-space: nowrap; }
    .mkc-eq-bar { flex: 0 0 140px; height: 4px; overflow: hidden; background: rgba(10,25,47,0.08); border-radius: 99px; }
    .mkc-eq-bar i { display: block; height: 100%; background: #0a192f; border-radius: 99px; }
    .mkc-eq-sa { display: flex; gap: 5px; margin-left: auto; }
    .mkc-eq-btn { font-size: 9.5px; font-weight: 600; padding: 6px 11px; color: #0f1729; background: #fff; border-radius: 99px; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.1); white-space: nowrap; }
    .mkc-eq-btn.pri { color: #fff; background: #0a192f; box-shadow: 0 6px 14px -8px rgba(10,25,47,0.6); }
    .mkc-eq-chips { display: flex; gap: 5px; margin: 11px 0 8px; }
    .mkc-eq-chips i { font-style: normal; font-size: 9px; font-weight: 600; padding: 5px 10px; color: #5b6472; background: rgba(10,25,47,0.06); border-radius: 99px; white-space: nowrap; }
    .mkc-eq-chips i b { margin-left: 2px; font-weight: 700; opacity: 0.7; }
    .mkc-eq-chips i.on { color: #fff; background: #0a192f; }
    .mkc-eq-th, .mkc-eq-r { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.95fr) minmax(0, 1.1fr) 118px; gap: 12px; align-items: center; }
    .mkc-eq-th { padding: 0 6px 6px; font-size: 7.5px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: #5b6472; border-bottom: 1px solid rgba(10,25,47,0.08); }
    .mkc-eq-r { padding: 6px 6px; border-bottom: 1px solid rgba(10,25,47,0.06); border-radius: 7px; }
    .mkc-eq-r > span { min-width: 0; }
    .mkc-eq-r.is-off { opacity: 0.6; }
    .mkc-eq-rw { overflow: hidden; }
    .mkc-eq-m { display: flex; align-items: center; gap: 8px; }
    .mkc-eq-m > i { width: 24px; height: 24px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-style: normal; font-size: 8.5px; font-weight: 700; color: #5b6472; background: #e9ebef; border-radius: 8px; }
