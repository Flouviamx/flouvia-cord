---
// Página de producto — una por feature (estilo Stripe: hero + mockup que vende,
// stats, bloques de detalle alternados, cross-links y CTA). Mismo lenguaje de
// animación que el index via PageAnims.astro.
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/landing/Nav.astro';
import Footer from '../../components/landing/Footer.astro';
import PageAnims from '../../components/landing/PageAnims.astro';
import BlockMockup from '../../components/producto/BlockMockup.astro';
import CordDynamicBg from '../../components/CordDynamicBg.jsx';
import FeatureShowcase from '../../components/producto/FeatureShowcase.astro';
import QuoteBuilderDemo from '../../components/producto/QuoteBuilderDemo.astro';
import PaymentRailsMatrix from '../../components/producto/PaymentRailsMatrix.astro';
import FaqAccordion from '../../components/landing/FaqAccordion.astro';
import { FEATURES } from '../../lib/producto';
import { FEATURES_EN } from '../../lib/producto.en';
import { flagSrc } from '../../lib/flags';
import { getLangFromUrl } from '../../i18n/utils';

export function getStaticPaths() {
    return FEATURES.map((f) => ({ params: { slug: f.slug }, props: { feature: f } }));
}

const lang = getLangFromUrl(Astro.url);
const isEn = Astro.props.isEn || lang === 'en';
const currentFeature = Astro.props.feature || Astro.props.feature;
const feature = isEn && currentFeature ? FEATURES_EN.find((f) => f.slug === currentFeature.slug) || currentFeature : currentFeature;
// Mapa de 3 features relacionados por feature — curados por contexto
// ⚠️ Todo slug listado aquí DEBE existir en FEATURES. El `.filter(Boolean)` de
// abajo descarta en silencio los que no, así que un slug muerto no rompe el
// build: simplemente deja la página con dos cross-links en vez de tres. Ya pasó
// con 'cfdi', que quedó huérfano cuando el feature se renombró a 'facturacion'.
const RELATED: Record<string, string[]> = {
    'editor':          ['link-publico', 'seguimiento', 'facturacion'],
    'link-publico':    ['pagos', 'editor', 'seguimiento'],
    'seguimiento':     ['link-publico', 'editor', 'cobranza-ia'],
    'clientes-credito':['facturacion', 'cobranza-ia', 'finanzas'],
    'cobranza-ia':     ['clientes-credito', 'workflows', 'finanzas'],
    'divisas':         ['pagos', 'facturacion', 'clientes-credito'],
    'facturacion':     ['pagos', 'divisas', 'clientes-credito'],
    'pagos':           ['facturacion', 'workflows', 'divisas'],
    'workflows':       ['seguimiento', 'cobranza-ia', 'facturacion'],
    'finanzas':        ['cobranza-ia', 'clientes-credito'],
    'aprobaciones':    ['editor', 'equipo', 'negociacion'],
    'equipo':          ['aprobaciones', 'editor', 'clientes-credito'],
    'negociacion':     ['editor', 'link-publico', 'aprobaciones'],

};
// Link contextual a la documentación (docs.cordhq.app) por feature. Cada valor es una
// ruta REAL de src/content/docs/{es,en}/ — verificada, no inventar (ya hubo un bug de
// 404 silenciosos por inventar slugs). ⚠️ La URL conserva el prefijo /docs a propósito:
// es el path que matchea ruta en Astro y devuelve 200 (ver src/middleware.ts).
const DOCS_PATH: Record<string, string> = {
    'editor':           'cotizacion/resumen',
    'link-publico':     'cotizacion/envio',
    'seguimiento':      'gestion/cotizaciones',
    'clientes-credito': 'pagos/credito',
    'cobranza-ia':      'pagos/cobranza-ia',
    'divisas':          'pagos/tesoreria-fx',
    'facturacion':      'pagos/facturacion',
    'pagos':            'pagos/onboarding',
    'workflows':        'automatizacion/workflows',
    'finanzas':         'gestion/dashboard',
    'aprobaciones':     'cuenta/configuracion',
    'equipo':           'cuenta/resumen',
    'negociacion':      'interaccion/chat',

};
// Grupo del megamenú (Nav.astro) al que pertenece cada feature: decide la paleta de la banda del hero.
const BAND_GROUP: Record<string, 'ventas' | 'pagos' | 'operacion'> = {
    'editor': 'ventas', 'link-publico': 'ventas', 'seguimiento': 'ventas', 'aprobaciones': 'ventas', 'negociacion': 'ventas',
    'pagos': 'pagos', 'cobranza-ia': 'pagos', 'divisas': 'pagos', 'clientes-credito': 'pagos', 'finanzas': 'pagos',
    'facturacion': 'operacion', 'workflows': 'operacion', 'equipo': 'operacion',
};
const BAND_PALS = {
    ventas: {
        stops: ['#3A2EE8', '#2563EB', '#0EA5E9', '#22D3EE'],
        shader: { base: '#2E4BF5', color1: '#67E8F9', color2: '#818CF8', color3: '#38BDF8' },
    },
    pagos: {
        stops: ['#065F46', '#059669', '#10B981', '#2DD4BF'],
        shader: { base: '#07875F', color1: '#6EE7B7', color2: '#2DD4BF', color3: '#BEF264' },
    },
    operacion: {
        stops: ['#5B21B6', '#7C3AED', '#DB2777', '#F97316'],
        shader: { base: '#6B3CF0', color1: '#C084FC', color2: '#F472B6', color3: '#FDBA74' },
    },
};
const band = BAND_PALS[BAND_GROUP[feature.slug] ?? 'ventas'];
const bandStyle = band.stops.map((c, i) => `--band-${i}:${c}`).join(';');

const docsUrl = isEn ? `https://docs.cordhq.app/en/docs/${DOCS_PATH[feature.slug] ?? 'resumen'}` : `https://docs.cordhq.app/docs/${DOCS_PATH[feature.slug] ?? 'resumen'}`;

const allFeatures = isEn ? FEATURES_EN : FEATURES;
const relatedSlugs = RELATED[feature.slug] ?? [];
const otros = relatedSlugs
    .map((s) => allFeatures.find((f) => f.slug === s))
    .filter(Boolean) as typeof allFeatures;
const tituloPlano = feature.titulo.replace(/<br\s*\/?>/gi, ' ');

// ── Datos estructurados (JSON-LD) — FAQPage: lo que extraen los AI Overviews.
const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: feature.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
};

// BreadcrumbList (jul 2026, auditoría SEO/AI-SEO — mismo criterio que /index
// y /precios): antes estas 12 páginas no tenían ninguna señal de jerarquía;
// esto le dice a Google/IA "esta es una feature DENTRO del producto Cord",
// ayuda a Google a mostrar el breadcrumb en el resultado de búsqueda y
// refuerza (junto con el metaTitle sin "by Flouvia") que Cord es el
// producto, no una sub-página de Flouvia.
const SITE = 'https://cordhq.app';
const base = isEn ? `${SITE}/en` : SITE;
// Solo 2 niveles: no existe un índice real de /producto que enlazar (mismo
// caso que /soluciones — ver docs/estado/app-rutas.md), y un ListItem con URL
// duplicada no cumple las guías de datos estructurados de Google.
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: feature.nav, item: `${base}/producto/${feature.slug}` },
    ],
};

// SoftwareApplication por feature (ago 2026). `/index` ya lo declaraba para el
// producto completo, pero cada página de feature es la que compite por su
// keyword y llegaba sin ninguna señal de "esto es software con un precio".
// `featureList` sale de los bullets reales, no de una lista aparte que se
// desincronizaría del copy a la primera edición.
const appSchema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `Cord — ${feature.nav}`,
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: ({ facturacion: 'Invoicing', pagos: 'Payments', workflows: 'Workflow automation' } as Record<string, string>)[feature.slug],
    operatingSystem: 'Web',
    url: `${base}/producto/${feature.slug}`,
    description: feature.metaDescription ?? feature.sub,
    featureList: feature.blocks.flatMap((b) => b.bullets ?? []),
    offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'MXN',
        description: isEn ? 'Free plan available' : 'Plan gratuito disponible',
        url: `${base}/precios`,
    },
};

// HowTo solo donde hay un procedimiento REAL que el producto ejecuta. Un HowTo
// genérico ("cómo usar la función") es exactamente el marcado que Google
// penaliza por no describir una tarea. Hoy solo facturación lo tiene.
const HOWTO: Record<string, { name: string; steps: { name: string; text: string }[] }> = {
    facturacion: isEn ? {
        name: 'How to issue an invoice in Cord',
        steps: [
            { name: 'Create the draft', text: 'Open Invoices, pick the client and enter the line items. The draft consumes no invoice number and no stamp.' },
            { name: 'Issue it', text: 'Issuing reserves the next sequential number and stamps the document: real CFDI 4.0 with the SAT in Mexico, a commercial invoice with your own numbering elsewhere.' },
            { name: 'Send it to your client', text: 'Cord emails the invoice with its PDF and a link to its own page, where the client sees the balance and can pay by card.' },
            { name: 'Follow the balance', text: 'Card payments from the link and wires you record by hand both reduce the same balance. At zero the invoice is marked paid.' },
        ],
    } : {
        name: 'Cómo emitir una factura en Cord',
        steps: [
            { name: 'Crea el borrador', text: 'Entra a Facturas, elige el cliente y captura los conceptos. El borrador no consume folio ni timbre.' },
            { name: 'Emítela', text: 'Al emitir se reserva el folio consecutivo y se timbra el documento: CFDI 4.0 real ante el SAT en México, factura comercial con folio propio en el resto.' },
            { name: 'Mándala a tu cliente', text: 'Cord envía la factura por correo con su PDF y el link a su propia página, donde el cliente ve el saldo y puede pagar con tarjeta.' },
            { name: 'Sigue el saldo', text: 'Los pagos con tarjeta desde el link y las transferencias que registras a mano bajan el mismo saldo. Al llegar a cero, la factura se marca pagada.' },
        ],
    },
};
HOWTO.workflows = isEn ? {
    name: 'How to publish a workflow in Cord',
    steps: [
        { name: 'Open Workflows', text: 'Open Workflows in the side menu and start from one of the 9 ready ideas or from scratch.' },
        { name: 'Choose the trigger', text: 'Pick one of the 44 Cord events, or a fixed schedule read in your business time zone.' },
        { name: 'Add the steps', text: 'Add actions, conditions, waits and lookups under "Do this". Event data such as {{client}} or {{total}} fills in at run time.' },
        { name: 'Test and publish', text: 'Test the draft against the latest real event —lookups run, actions do not— and press Publish.' },
    ],
} : {
    name: 'Cómo publicar un workflow en Cord',
    steps: [
        { name: 'Abre Workflows', text: 'Entra a Workflows en el menú lateral y empieza desde una de las 9 ideas listas o desde cero.' },
        { name: 'Elige el disparador', text: 'Elige uno de los 44 eventos de Cord, o un horario fijo interpretado en la zona horaria de tu negocio.' },
        { name: 'Agrega los pasos', text: 'Agrega acciones, condiciones, esperas y consultas en "Haz esto". Los datos del evento, como {{cliente}} o {{total}}, se completan al ejecutar.' },
        { name: 'Prueba y publica', text: 'Prueba el borrador contra el último evento real —las consultas corren, las acciones no— y pulsa Publicar.' },
    ],
};
const howto = HOWTO[feature.slug];
const howtoSchema = howto ? {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: howto.name,
    description: feature.metaDescription ?? feature.sub,
    step: howto.steps.map((step, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: step.name,
        text: step.text,
    })),
} : null;

// Iconos del hero-calca (mismos trazos que Sidebar.astro y la topbar de AppLayout).
const MKI = {
    inicio: '<rect x="3" y="3" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="14" y="14" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
    cotizaciones: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8" stroke-opacity="0.5"/><line x1="16" y1="13" x2="8" y2="13" stroke-opacity="0.5"/><line x1="16" y1="17" x2="8" y2="17" stroke-opacity="0.5"/>',
    clientes: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4" fill="currentColor" fill-opacity="0.25" stroke="none"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87" stroke-opacity="0.5"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke-opacity="0.5"/>',
    productos: '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5" stroke-opacity="0.5"/><path d="M12 22V12" stroke-opacity="0.5"/>',
    facturas: '<path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><polyline points="15 2 15 7 20 7" stroke-opacity="0.5"/><path d="M9 13h6" stroke-opacity="0.55"/><path d="M9 17h4" stroke-opacity="0.55"/>',
    cobros: '<circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.1" stroke="none"/><path d="M12 2v20" stroke-opacity="0.5"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
    cobranza: '<rect width="20" height="14" x="2" y="5" rx="2" fill="currentColor" fill-opacity="0.15" stroke="none"/><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10" stroke-opacity="0.5"/>',
    informes: '<rect x="3" y="3" width="18" height="18" rx="4" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M7 16l3-3 2.5 2.5L17 10"/><path d="M15 10h2v2" stroke-opacity="0.55"/>',
    equipo: '<circle cx="9" cy="8" r="3.4" fill="currentColor" fill-opacity="0.15"/><path d="M2.8 20.2a6.2 6.2 0 0 1 12.4 0" stroke-opacity="0.8"/><circle cx="17.2" cy="9.4" r="2.4" fill="currentColor" fill-opacity="0.15" stroke-opacity="0.75"/><path d="M16 14.1a5 5 0 0 1 5.2 4.8" stroke-opacity="0.55"/>',
    panel: '<rect x="4" y="5" width="16" height="14" rx="2.5"/><rect x="4" y="5" width="7" height="14" rx="2.5" fill="currentColor" fill-opacity="0.3" stroke="none"/>',
    search: '<circle cx="11" cy="11" r="7.5" fill="currentColor" fill-opacity="0.1"/><line x1="21" y1="21" x2="16.4" y2="16.4"/>',
    plus: '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>',
    caret: '<polyline points="6 9 12 15 18 9"/>',
    bell: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" fill="currentColor" fill-opacity="0.12"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
    help: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z" fill="currentColor" fill-opacity="0.1"/><path d="M9.1 9a2.9 2.9 0 0 1 5.6 1c0 2-2.9 2.9-2.9 2.9"/><line x1="12" y1="17" x2="12" y2="17"/>',
    moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor" fill-opacity="0.12"/>',
    gear: '<circle cx="12" cy="12" r="3" fill="currentColor" fill-opacity="0.15"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
    lock: '<rect x="4" y="11" width="16" height="10" rx="2" fill="currentColor" fill-opacity="0.15"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
    back: '<polyline points="15 18 9 12 15 6"/>',
    fwd: '<polyline points="9 18 15 12 9 6"/>',
    reload: '<path d="M20.5 12a8.5 8.5 0 1 1-2.5-6"/><polyline points="20.5 3.5 20.5 8.5 15.5 8.5"/>',
    share: '<path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" fill="currentColor" fill-opacity="0.1"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/>',
    check: '<polyline points="20 6 9 17 4 12"/>',
    arrow: '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="currentColor" fill-opacity="0.12"/>',
    clock: '<circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.12"/><polyline points="12 7 12 12 15.5 14"/>',
    chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" fill="currentColor" fill-opacity="0.12"/>',
    doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="currentColor" fill-opacity="0.12"/><polyline points="14 2 14 8 20 8"/>',
    burger: '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>',
    cursor: '<path d="M5.5 3.2 19 14.6l-6.1.5 3.5 7.3-2.6 1.2-3.4-7.4-4.9 4.6z"/>',
    cal: '<rect x="3" y="4" width="18" height="17" rx="3" fill="currentColor" fill-opacity="0.12"/><path d="M3 10h18M8 2v4M16 2v4"/>',
};
const MK_RAIL: { k: keyof typeof MKI; on?: boolean; sep?: boolean }[] = [
    { k: 'inicio' }, { k: 'cotizaciones', on: true }, { k: 'clientes' }, { k: 'productos' },
    { k: 'facturas', sep: true }, { k: 'cobros' }, { k: 'cobranza' },
    { k: 'informes', sep: true }, { k: 'equipo' },
];
---

<Layout
    title={feature.metaTitle ?? `${feature.nav} — Cord`}
    description={feature.metaDescription ?? feature.sub}
>
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqSchema)}
    />
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(appSchema)}
    />
    {howtoSchema && (
        <script
            slot="head"
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(howtoSchema)}
        />
    )}
    <Nav />
    <main>
        <!-- ── HERO ── -->
        <section class="pp-hero">
            <div class="pp-hero-mesh" aria-hidden="true"></div>
            <div class="pp-band" aria-hidden="true" style={bandStyle}>
                <CordDynamicBg client:only="react" colors={band.shader} backdrop="transparent" grain={false} />
            </div>
            <div class="pp-hero-inner">
                <div class="pp-hero-text">
                    <h1 class="pp-title masked-title" set:html={feature.titulo} />
                    <p class="pp-sub reveal">{feature.sub}</p>
                    <div class="pp-actions reveal">
                        <a href="/sign-up" class="pp-btn-primary">
                            <span>{isEn ? 'Start for free' : 'Empezar gratis'}</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                        <a href="/q/demo" class="pp-btn-ghost">{isEn ? 'See a real quote' : 'Ver una cotización real'}</a>
                    </div>
                    <p class="pp-plan reveal">{feature.plan}</p>
                </div>

                <!-- Mockup específico del feature -->
                <div class="pp-hero-visual">
                <div class="pp-space">
                <div class="pp-scaler">
                <div class="pp-mockup-wrap reveal-mockup">
                    <div class="pp-mesh-bg" aria-hidden="true"></div>
                    <div class="pp-glow" aria-hidden="true"></div>

                    <div class="pp-mockup">

                        {feature.slug === 'editor' && (
                            <div class="mkc-stage mkc-ed-stage" id="edHero" aria-hidden="true">
                              <div class="mkc-app">
                                <aside class="mkc-rail">
                                    <span class="mkc-rail-org">M</span>
