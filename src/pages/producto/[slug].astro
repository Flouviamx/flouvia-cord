    /* ══════════════════════════════════════════════════════════
       BENTO MOCKUPS — Light mode, screenshot-on-surface look
       Stripe/ElevenLabs bleed: stage overflows the bottom,
       card overflow:hidden clips it → cropped screenshot effect
    ══════════════════════════════════════════════════════════ */

    /* Mockups VIEJOS (bm-card): peek al fondo con corte sutil */
    .pp-bcard-visual .bm-wrap {
        position: absolute;
