    .mkc-pp-back svg { width: 10px; height: 10px; }
    .mkc-pp-card { display: flex; flex-direction: column; gap: 9px; padding: 11px 11px 12px; background: #fff; border-radius: 18px; border: 1px solid rgba(10,25,47,0.05); box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 18px 36px -14px rgba(10,25,47,0.12); }
    .mkc-pp-brand { display: flex; align-items: center; gap: 8px; }
