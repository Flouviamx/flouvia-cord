    .mkc-iv-tots .t { margin-top: 3px; padding-top: 5px; border-top: 1px solid #eceff3; color: #111827; font-weight: 500; }
    .mkc-iv-tots .d { margin-top: 3px; padding-top: 5px; border-top: 1px solid #0a192f; color: #050505; font-size: 10px; font-weight: 600; }
    .mkc-iv-pagos { margin-top: 11px; }
