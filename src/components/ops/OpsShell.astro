---
import { iconInner, type IconName } from '../../lib/icons';
import OpsActionDialog from './OpsActionDialog.astro';
import OpsCommand from './OpsCommand.astro';

type OpsSection =
  | 'overview' | 'activity' | 'organizations' | 'users' | 'revenue' | 'invoices' | 'workflows'
  | 'integrations' | 'webhooks' | 'usage' | 'status' | 'security' | 'database';

interface Props {
  active: OpsSection;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { active, eyebrow = 'Cord Ops', title, subtitle } = Astro.props;
const operator = Astro.locals.opsOperator;

// Iconos del registro único "Cord Glass" (regla 9): la gramática la impone
// iconInner(), no cada icono.
const groups: { label: string; items: { id: OpsSection; href: string; label: string; icon: IconName; key: string }[] }[] = [
  { label: 'General', items: [
    { id: 'overview', href: '/ops', label: 'Resumen', icon: 'overview', key: 'r' },
    { id: 'activity', href: '/ops/activity', label: 'Actividad', icon: 'pulse', key: 'a' },
  ] },
  { label: 'Negocio', items: [
    { id: 'organizations', href: '/ops/organizations', label: 'Organizaciones', icon: 'building', key: 'o' },
    { id: 'users', href: '/ops/users', label: 'Usuarios', icon: 'user', key: 'u' },
    { id: 'revenue', href: '/ops/revenue', label: 'Ingresos', icon: 'trending-up', key: 'm' },
    { id: 'invoices', href: '/ops/invoices', label: 'Facturas', icon: 'invoice', key: 'f' },
    { id: 'workflows', href: '/ops/workflows', label: 'Workflows', icon: 'workflow', key: 'w' },
    { id: 'integrations', href: '/ops/integrations', label: 'Integraciones', icon: 'plug', key: 'i' },
    { id: 'webhooks', href: '/ops/webhooks', label: 'Webhooks', icon: 'send', key: 'h' },
  ] },
  { label: 'Plataforma', items: [
    { id: 'usage', href: '/ops/usage', label: 'Uso y costos', icon: 'chart', key: 'c' },
    { id: 'status', href: '/ops/status', label: 'Disponibilidad', icon: 'check-circle', key: 'd' },
    { id: 'security', href: '/ops/security', label: 'Seguridad', icon: 'shield', key: 's' },
    { id: 'database', href: '/ops/database', label: 'Base de datos', icon: 'database', key: 'b' },
  ] },
];
const section = groups.flatMap((g) => g.items).find((item) => item.id === active)!;
const isDetail = title !== section.label;

const method = operator?.authMethod === 'passkey' ? 'Passkey de Ops'
  : operator?.authMethod === 'local_session_password' ? 'Sesión local' : 'Contraseña y TOTP';
const initial = (operator?.email || '?').charAt(0).toUpperCase();

// Tiempo restante del tope absoluto de 8 h. La inactividad (30 min) la aplica
// el servidor; aquí se avisa antes de que la sesión caiga a media tarea.
const ABSOLUTE_MS = 8 * 60 * 60 * 1000;
const remainingMs = operator ? Math.max(0, operator.authenticatedAt.getTime() + ABSOLUTE_MS - Date.now()) : 0;
const remainingLabel = remainingMs >= 3_600_000
  ? `${Math.floor(remainingMs / 3_600_000)} h ${Math.floor((remainingMs % 3_600_000) / 60_000)} min`
  : `${Math.max(1, Math.floor(remainingMs / 60_000))} min`;
const svg = (name: IconName) => iconInner(name);
---

<a class="ops-skip" href="#ops-content">Saltar al contenido</a>
<div class="ops-app-shell" data-ops-shell>
  <aside class="ops-app-sidebar" id="ops-sidebar" aria-label="Navegación de Ops">
    <a class="ops-app-brand" href="/ops" aria-label="Cord Ops, resumen">
      <span>CORD</span><i></i><small>Ops</small><b title="Consola interna con acceso privilegiado">Interno</b>
    </a>

    <nav class="ops-app-nav" aria-label="Secciones">
      {groups.map((group) => (
        <Fragment>
          <div class="ops-nav-group" aria-hidden="true">{group.label}</div>
          {group.items.map((item) => (
            <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg(item.icon)} />
              {item.label}
            </a>
          ))}
        </Fragment>
      ))}
    </nav>

    <div class="ops-app-sidebar-bottom">
      <div class="ops-operator-card">
        <span class="ops-avatar" aria-hidden="true">{initial}</span>
        <strong>{operator?.email}</strong>
        <small class="ops-operator-role">{operator?.role === 'admin' ? 'Administrador' : 'Solo lectura'} · {method}</small>
        <div class="ops-operator-actions">
          <button id="ops-shell-logout" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('logout')} />
            Cerrar sesión
          </button>
        </div>
      </div>
    </div>
  </aside>
  <div class="ops-drawer-backdrop" data-ops-drawer-close aria-hidden="true"></div>

  <div class="ops-app-main">
    <header class="ops-topbar">
      <button class="ops-icon-button ops-menu-button" type="button" aria-controls="ops-sidebar" aria-expanded="false" aria-label="Abrir navegación" data-ops-drawer-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('menu')} />
      </button>
      <nav class="ops-crumbs" aria-label="Ubicación">
        <a href="/ops">Ops</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('chevron-right')} />
        {isDetail ? (
          <Fragment>
            <a href={section.href}>{section.label}</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('chevron-right')} />
            <span aria-current="page">{title}</span>
          </Fragment>
        ) : <span aria-current="page">{section.label}</span>}
      </nav>
      <button class="ops-command-trigger" type="button" data-ops-command-open aria-label="Buscar en Cord Ops">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('search')} />
        <span>Buscar</span>
        <span class="ops-command-keys"><kbd class="ops-kbd">⌘</kbd><kbd class="ops-kbd">K</kbd></span>
      </button>
      <div class="ops-topbar-end">
        <span class:list={['ops-session-pill', remainingMs < 30 * 60_000 && 'warn']} title={`Sesión privilegiada · ${method}. Se cierra tras 30 min sin uso o al cumplir 8 h.`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('lock')} />
          <span>Sesión · </span>{remainingLabel}
        </span>
        <button class="ops-icon-button ops-theme-button" type="button" data-ops-theme data-mode="system" aria-label="Tema: según el sistema. Cambiar tema">
          <svg data-theme-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('contrast')} />
          <svg data-theme-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('sun')} />
          <svg data-theme-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('moon')} />
        </button>
      </div>
    </header>

    <main class="ops-app-content" id="ops-content" tabindex="-1">
      <header class="ops-page-header">
        <div><p>{eyebrow}</p><h1>{title}</h1>{subtitle && <span>{subtitle}</span>}</div>
        <div class="ops-page-actions"><slot name="actions" /></div>
      </header>
      <slot />
    </main>
  </div>
</div>
<OpsActionDialog />
<OpsCommand nav={groups.flatMap((g) => g.items)} isAdmin={operator?.role === 'admin'} />

<script>
  const shell = document.querySelector<HTMLElement>('[data-ops-shell]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-ops-drawer-toggle]');
  const sidebar = document.getElementById('ops-sidebar');

  // Cajón de navegación (< 880 px). Esc y tocar fuera lo cierran; al cerrar,
  // el foco vuelve al botón que lo abrió.
  function setDrawer(open: boolean) {
    if (!shell || !toggle) return;
    shell.classList.toggle('drawer-open', open);
    // Con el cajón abierto, el contenido de atrás no recibe foco ni toques.
    shell.querySelector('.ops-app-main')?.toggleAttribute('inert', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar navegación' : 'Abrir navegación');
    if (open) sidebar?.querySelector<HTMLElement>('a[aria-current="page"], a')?.focus();
    else toggle.focus();
  }
  toggle?.addEventListener('click', () => setDrawer(!shell?.classList.contains('drawer-open')));
  document.querySelectorAll('[data-ops-drawer-close]').forEach((el) => el.addEventListener('click', () => setDrawer(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && shell?.classList.contains('drawer-open')) setDrawer(false);
  });
  // Si la ventana crece por encima de 880 px con el cajón abierto, no queda
  // backdrop para cerrarlo: se cierra solo y el contenido deja de estar inerte.
  window.matchMedia('(min-width: 881px)').addEventListener('change', (event) => {
    if (!event.matches || !shell?.classList.contains('drawer-open')) return;
    shell.classList.remove('drawer-open');
    shell.querySelector('.ops-app-main')?.removeAttribute('inert');
    toggle?.setAttribute('aria-expanded', 'false');
  });

  // Tema: sistema → claro → oscuro. Se guarda en cookie para que el servidor
  // pinte el siguiente documento ya con el tema correcto.
  const themeButton = document.querySelector<HTMLButtonElement>('[data-ops-theme]');
  const LABELS: Record<string, string> = { system: 'según el sistema', light: 'claro', dark: 'oscuro' };
  const current = document.documentElement.dataset.theme;
  let mode = current === 'light' || current === 'dark' ? current : 'system';
  function paintTheme() {
    if (!themeButton) return;
    themeButton.dataset.mode = mode;
    themeButton.setAttribute('aria-label', `Tema: ${LABELS[mode]}. Cambiar tema`);
  }
  paintTheme();
  themeButton?.addEventListener('click', () => {
    mode = mode === 'system' ? 'light' : mode === 'light' ? 'dark' : 'system';
    const secure = window.location.protocol === 'https:' ? '; secure' : '';
    if (mode === 'system') {
      delete document.documentElement.dataset.theme;
      document.cookie = `cord_ops_theme=; path=/; max-age=0; samesite=strict${secure}`;
    } else {
      document.documentElement.dataset.theme = mode;
      document.cookie = `cord_ops_theme=${mode}; path=/; max-age=31536000; samesite=strict${secure}`;
    }
    document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', mode === 'system' ? 'light dark' : mode);
    paintTheme();
  });

  document.getElementById('ops-shell-logout')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    try { await fetch('/api/ops/auth', { method: 'DELETE' }); }
    finally { window.location.replace('/ops/login'); }
  });
</script>
