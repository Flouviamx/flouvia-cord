---
import { opsAgo, opsActorLabel, opsDate, opsEventLabel } from '../../lib/ops-format';
import { iconInner, type IconName } from '../../lib/icons';

interface Props {
  events: any[];
  showOrg?: boolean;
  empty?: string;
}

const { events, showOrg = true, empty = 'Sin actividad registrada.' } = Astro.props;

// Iconos del registro "Cord Glass" (regla 9), uno por familia de evento.
const icon: Record<string, IconName> = {
  quote: 'quote',
  invoice: 'invoice',
  payment: 'card',
  alert: 'alert',
  catalog: 'products',
  system: 'clock',
};

function subject(e: any): string | null {
  if (e.object === 'quote' && e.quote_folio) return e.quote_folio;
  if (e.object === 'invoice' && e.invoice_number) return e.invoice_number.length > 20 ? null : e.invoice_number;
  if ((e.object === 'client' || e.object === 'product') && e.subject_name) return e.subject_name;
  return null;
}
---
<div class="ops-feed">
  {events.map((e) => {
    const [label, kind] = opsEventLabel(String(e.type));
    const who = opsActorLabel(String(e.actor), e.user_name);
    const what = subject(e);
    return (
      <div class="ops-feed-row">
        <span class:list={['ops-feed-icon', kind]}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner(icon[kind] ?? 'clock')} /></span>
        <div class="ops-feed-text">
          {e.user_id ? <a href={`/ops/users/${e.user_id}`}>{who}</a> : <strong>{who}</strong>} {label}{what && <Fragment> <strong>{what}</strong></Fragment>}
          {showOrg && <span class="ops-sub"><a href={`/ops/organizations/${e.org_id}`}>{e.org_nombre}</a> · <span class="ops-code">{e.type}</span></span>}
          {!showOrg && <span class="ops-sub ops-code">{e.type}</span>}
        </div>
        <time datetime={new Date(e.created_at).toISOString()} title={opsDate(e.created_at)}>{opsAgo(e.created_at)}</time>
      </div>
    );
  })}
  {events.length === 0 && <div class="ops-empty">{empty}</div>}
</div>
