---
// Tarjeta de Mercado Pago en Ajustes › Cobros.
//
// Vive en su propio componente porque su LUGAR depende del país: donde Mercado
// Pago es el único riel es lo primero de la pantalla; donde convive con Cord
// Payments (México, Brasil) va DESPUÉS, como alternativa — Cord Payments es la
// prioridad. Sus estilos y su script viajan con ella (regla 11).
import { t, type AppLocale } from '../../i18n/app';

interface Props {
    lang: AppLocale;
    conectado: boolean;
    flash: string | null;
    /** true = Cord Payments también está disponible en el país: esta es la alternativa. */
    alterno: boolean;
}

const { lang: L, conectado: mpConectado, flash: mpFlash, alterno } = Astro.props;
---

<section class:list={['mp-card', { 'is-alterno': alterno }]} data-mp>
    <div class="mp-head">
        <img class="mp-logo" src="/imgs/integrations/mercadopago.svg" alt="" width="44" height="44" />
        <div class="mp-head-text">
            <span class="mp-eyebrow">{t(L, 'set.cobros.mp.eyebrow')}</span>
            <h2 class="editorial mp-title">{t(L, 'set.cobros.mp.titulo')}</h2>
        </div>
        <span class="mp-pill" data-estado={mpConectado ? 'on' : 'off'}>
            {mpConectado ? t(L, 'set.integ.conectado') : t(L, 'set.integ.sin_conectar')}
        </span>
    </div>
    <p class="mp-desc">{alterno ? t(L, 'set.cobros.mp.desc_alterno') : t(L, 'set.cobros.mp.desc_unico')}</p>
    {mpFlash && ['conectada', 'cancelada', 'estado', 'error'].includes(mpFlash) && (
        <p class="mp-flash" data-bad={mpFlash !== 'conectada' ? '1' : undefined}>{t(L, `set.cobros.mp.flash_${mpFlash}` as any)}</p>
    )}
    <div class="mp-actions">
        <button type="button" class="mp-btn" data-mp-connect>{mpConectado ? t(L, 'set.cobros.mp.reconectar') : t(L, 'set.cobros.mp.conectar')}</button>
        {mpConectado && <button type="button" class="mp-btn is-ghost" data-mp-off>{t(L, 'set.integ.wa.desconectar')}</button>}
        <span class="mp-msg" data-mp-msg data-i18n-err={t(L, 'settings.no_se_pudo_guardar')}></span>
    </div>
</section>

<style>
    /* Mercado Pago: el segundo riel. No compite visualmente con el alta de
       Cord Payments — es una tarjeta aparte, no un paso del mismo asistente. */
    .mp-card { margin-bottom: 2.2rem; padding: 1.25rem 1.4rem 1.35rem; border-radius: 22px; background: var(--color-bg-soft); border: 1px solid var(--color-border); }
    .mp-card.is-alterno { margin-top: 2rem; }
    .mp-head { display: flex; align-items: center; gap: 14px; }
    .mp-logo { width: 44px; height: 44px; border-radius: 13px; flex-shrink: 0; box-shadow: 0 1px 2px rgba(10, 25, 47, 0.08); }
    .mp-head-text { flex: 1; min-width: 0; }
    .mp-eyebrow { font-size: 0.64rem; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase; color: var(--color-text-muted); }
    .mp-title { font-size: 1.15rem; margin: 0.35rem 0 0; color: var(--color-text); }
    .mp-pill { flex-shrink: 0; align-self: flex-start; font-size: 0.7rem; font-weight: 700; padding: 4px 10px; border-radius: 100px; background: var(--surface); color: var(--color-text-muted); }
    .mp-pill[data-estado="on"] { color: var(--color-ok); }
    .mp-desc { font-size: 0.9rem; line-height: 1.6; color: var(--color-text-muted); max-width: 62ch; margin: 0.8rem 0 1rem; }
    .mp-flash { font-size: 0.82rem; margin: 0 0 1rem; color: var(--color-ok); }
    .mp-flash[data-bad] { color: var(--color-danger); }
    .mp-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .mp-btn { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 100px; padding: 9px 18px; cursor: pointer; }
    .mp-btn.is-ghost { color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); }
    .mp-btn:disabled { opacity: 0.6; cursor: wait; }
    .mp-btn:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }
    .mp-msg { font-size: 0.78rem; font-weight: 600; color: var(--color-danger); }
    @media (max-width: 880px) { .mp-btn { min-height: 44px; } }
</style>

<script>
    // Alta y baja de Mercado Pago. El alta se abre en la misma pestaña: el
    // proveedor regresa al callback, que es quien guarda las credenciales.
    (function initMercadoPago() {
        const run = () => {
            const connect = document.querySelector<HTMLButtonElement>('[data-mp-connect]');
            const off = document.querySelector<HTMLButtonElement>('[data-mp-off]');
            const msg = document.querySelector<HTMLElement>('[data-mp-msg]');
            if (!connect) return;

            const fail = (text: string) => {
                if (!msg) return;
                msg.textContent = text;
                setTimeout(() => { msg.textContent = ''; }, 4000);
            };

            connect.addEventListener('click', async () => {
                connect.disabled = true;
                try {
                    const res = await fetch('/api/billing/mercadopago/connect', { method: 'POST' });
                    const data = await res.json();
                    if (!res.ok || !data.redirect) throw new Error(data.error || '');
                    window.location.href = data.redirect;
                } catch (err: any) {
                    fail(err.message || msg?.dataset.i18nErr || '');
                    connect.disabled = false;
                }
            });

            off?.addEventListener('click', async () => {
                off.disabled = true;
                try {
                    const res = await fetch('/api/billing/mercadopago/connect', { method: 'DELETE' });
                    if (!res.ok) throw new Error();
                    window.location.href = '/app/ajustes/cobros';
                } catch {
                    fail(msg?.dataset.i18nErr || '');
                    off.disabled = false;
                }
            });
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
        else run();
    })();
</script>
