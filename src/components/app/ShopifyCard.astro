---
import { t, type AppLocale } from '../../i18n/app';

interface Props {
    lang: AppLocale;
    conexion: { shop: string; estado: string; tienda: string | null; ultimaSync: string | null; pedidos: string; puedePedidos: boolean } | null;
    /** La app de Cord existe del lado de Shopify; sin esto no hay a dónde mandar a la persona. */
    disponible: boolean;
    flash: string | null;
    /** Dominio sugerido cuando la persona llega desde el panel de Shopify. */
    tiendaSugerida?: string | null;
}

const { lang: L, conexion, disponible, flash, tiendaSugerida = null } = Astro.props;
const FLASH = ['conectada', 'cancelada', 'estado', 'firma', 'error'];
const conectada = conexion?.estado === 'activa';
const fecha = conexion?.ultimaSync
    ? new Date(conexion.ultimaSync).toLocaleString(L === 'en' ? 'en-US' : 'es-MX', { dateStyle: 'medium', timeStyle: 'short' })
    : null;
---

<div class="s-block" data-shopify>
    <h3>{t(L, 'set.integ.det.conexion')}</h3>
    <div class="s-body">
        {flash && FLASH.includes(flash) && (
            <p class="shp-flash" data-bad={flash !== 'conectada' ? '1' : undefined}>{t(L, `set.integ.shopify.flash_${flash}` as any)}</p>
        )}

        <p class="shp-que">{t(L, 'set.integ.shopify.que_hace')}</p>

        {conectada ? (
            <Fragment>
                <p class="shp-conn">
                    {t(L, 'set.integ.shopify.conectado_a')} <b>{conexion?.tienda || conexion?.shop}</b>
                    <span class="shp-sub">{conexion?.shop}</span>
                </p>
                <p class="shp-sync">
                    {t(L, 'set.integ.shopify.ultima_sync')} {fecha ?? t(L, 'set.integ.shopify.nunca')}
                </p>
                <div class="shp-actions">
                    <button class="shp-btn-solid" id="shpSync">{t(L, 'set.integ.shopify.sincronizar')}</button>
                    <button class="shp-btn-ghost" id="shpOff">{t(L, 'set.integ.shopify.desconectar')}</button>
                </div>

                <div class="shp-pedidos">
                    <h4>{t(L, 'set.integ.shopify.pedidos_titulo')}</h4>
                    <p class="shp-que">{t(L, 'set.integ.shopify.pedidos_desc')}</p>
                    {conexion?.puedePedidos ? (
                        <div class="s-field">
                            <label for="shpPedidos">{t(L, 'set.integ.shopify.pedidos_titulo')}</label>
                            <select class="s-input" id="shpPedidos">
                                <option value="no" selected={conexion?.pedidos !== 'aprobada' && conexion?.pedidos !== 'pagada'}>{t(L, 'set.integ.shopify.pedidos_no')}</option>
                                <option value="aprobada" selected={conexion?.pedidos === 'aprobada'}>{t(L, 'set.integ.shopify.pedidos_aprobada')}</option>
                                <option value="pagada" selected={conexion?.pedidos === 'pagada'}>{t(L, 'set.integ.shopify.pedidos_pagada')}</option>
                            </select>
                        </div>
                    ) : (
                        <p class="shp-permiso">
                            {t(L, 'set.integ.shopify.pedidos_permiso')}
                            <button class="shp-btn-ghost shp-reconectar" id="shpReconectar" data-shop={conexion?.shop}>{t(L, 'set.integ.shopify.reconectar')}</button>
                        </p>
                    )}
                </div>
            </Fragment>
        ) : (
            <Fragment>
                <div class="s-field">
                    <label for="shpShop">{t(L, 'set.integ.shopify.dominio')}</label>
                    <input class="s-input" id="shpShop" value={tiendaSugerida ?? ''} placeholder="mi-tienda.myshopify.com"
                        autocomplete="off" spellcheck="false" disabled={!disponible} />
                    <span class="s-hint">{t(L, 'set.integ.shopify.dominio_hint')}</span>
                </div>
                <div class="shp-actions">
                    <button class="shp-btn-solid" id="shpConnect" disabled={!disponible}>{t(L, 'set.integ.shopify.conectar')}</button>
                </div>
            </Fragment>
        )}

        <span class="shp-msg" id="shpMsg"
            data-i18n-no-conecto={t(L, 'set.integ.shopify.no_conecto')}
            data-i18n-no-desconecto={t(L, 'set.integ.shopify.no_desconecto')}
            data-i18n-tienda={t(L, 'shopify.err.tienda')}
            data-i18n-sincronizando={t(L, 'set.integ.shopify.sincronizando')}
            data-i18n-resultado={t(L, 'set.integ.shopify.resultado')}
            data-i18n-pedidos-guardado={t(L, 'set.integ.shopify.pedidos_guardado')}></span>
    </div>
</div>

<style>
    .shp-flash { font-size: 0.82rem; margin: 0 0 1rem; color: var(--color-ok); }
    .shp-flash[data-bad] { color: var(--color-danger); }
    .shp-que { font-size: 0.85rem; line-height: 1.5; color: var(--color-text-muted); margin: 0 0 1rem; max-width: 62ch; }
    .shp-conn { font-size: 0.9rem; margin: 0 0 0.35rem; color: var(--color-text); }
    .shp-sub { display: block; margin-top: 2px; font-size: 0.78rem; color: var(--color-text-muted); }
    .shp-sync { font-size: 0.82rem; color: var(--color-text-muted); margin: 0 0 1rem; }
    .shp-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .shp-pedidos { margin-top: 1.6rem; padding-top: 1.3rem; border-top: 1px solid var(--color-border); }
    .shp-pedidos h4 { font-size: 0.86rem; font-weight: 650; color: var(--color-text); margin: 0 0 0.35rem; }
    .shp-permiso { font-size: 0.85rem; line-height: 1.5; color: var(--color-text-muted); margin: 0; }
    .shp-reconectar { margin-left: 0.5rem; }
    .shp-msg { display: block; margin-top: 0.8rem; min-height: 1.2em; font-size: 0.78rem; font-weight: 600; }
    .shp-msg:global(.ok) { color: var(--color-ok); }
    .shp-msg:global(.err) { color: var(--color-danger); }
    .shp-btn-solid { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 9px; padding: 9px 18px; cursor: pointer; }
    .shp-btn-solid:disabled, .shp-btn-ghost:disabled { opacity: 0.6; cursor: not-allowed; }
    .shp-btn-ghost { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 9px; padding: 9px 16px; cursor: pointer; }
    .shp-btn-solid:focus-visible, .shp-btn-ghost:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }

    @media (max-width: 560px) {
        .shp-actions { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
        .shp-btn-solid, .shp-btn-ghost { min-height: 46px; width: 100%; }
    }
</style>

<script>
    function initShopify() {
        const msg = document.getElementById('shpMsg');
        if (!msg) return;
        const flash = (text: string, ok: boolean) => {
            msg.textContent = text;
            msg.className = 'shp-msg ' + (ok ? 'ok' : 'err');
        };

        const connect = document.getElementById('shpConnect') as HTMLButtonElement | null;
        connect?.addEventListener('click', async () => {
            const shop = (document.getElementById('shpShop') as HTMLInputElement | null)?.value.trim() || '';
            if (!shop) { flash(msg.dataset.i18nTienda || '', false); return; }
            connect.disabled = true;
            try {
                const res = await fetch('/api/integraciones/shopify/conectar', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ shop }),
                });
                const d = await res.json();
                if (!res.ok || !d.redirect) throw new Error(d.error || '');
                window.location.href = d.redirect;
            } catch (err: any) {
                flash(err.message || msg.dataset.i18nNoConecto || '', false);
                connect.disabled = false;
            }
        });

        const off = document.getElementById('shpOff') as HTMLButtonElement | null;
        off?.addEventListener('click', async () => {
            off.disabled = true;
            try {
                const res = await fetch('/api/integraciones/shopify/conectar', { method: 'DELETE' });
                if (!res.ok) throw new Error();
                window.location.href = window.location.pathname;
            } catch {
                flash(msg.dataset.i18nNoDesconecto || '', false);
                off.disabled = false;
            }
        });

        // El disparador se guarda al elegirlo: un botón "guardar" extra para un
        // solo campo es un paso que la gente olvida y luego cree que quedó puesto.
        const pedidos = document.getElementById('shpPedidos') as HTMLSelectElement | null;
        pedidos?.addEventListener('change', async () => {
            pedidos.disabled = true;
            try {
                const res = await fetch('/api/integraciones/shopify/pedidos', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ disparador: pedidos.value }),
                });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || '');
                flash(msg.dataset.i18nPedidosGuardado || '', true);
            } catch (err: any) {
                flash(err.message || '', false);
            } finally {
                pedidos.disabled = false;
            }
        });

        // Reconectar es la MISMA instalación, con la tienda que ya está guardada:
        // Shopify vuelve a pedir permiso y esta vez incluye el de pedidos.
        const reconectar = document.getElementById('shpReconectar') as HTMLButtonElement | null;
        reconectar?.addEventListener('click', async () => {
            reconectar.disabled = true;
            try {
                const res = await fetch('/api/integraciones/shopify/conectar', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ shop: reconectar.dataset.shop || '' }),
                });
                const d = await res.json();
                if (!res.ok || !d.redirect) throw new Error(d.error || '');
                window.location.href = d.redirect;
            } catch (err: any) {
                flash(err.message || msg.dataset.i18nNoConecto || '', false);
                reconectar.disabled = false;
            }
        });

        const sync = document.getElementById('shpSync') as HTMLButtonElement | null;
        sync?.addEventListener('click', async () => {
            sync.disabled = true;
            flash(msg.dataset.i18nSincronizando || '', true);
            try {
                const res = await fetch('/api/integraciones/shopify/sync', { method: 'POST' });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || '');
                const plantilla = msg.dataset.i18nResultado || '';
                flash(plantilla.replace('{productos}', String(d.productos ?? 0)).replace('{clientes}', String(d.clientes ?? 0)), true);
            } catch (err: any) {
                flash(err.message || '', false);
            } finally {
                sync.disabled = false;
            }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initShopify);
    else initShopify();
</script>
