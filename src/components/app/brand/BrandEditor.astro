---
import { iconInner } from '../../../lib/icons';
import { currentLocale } from '../../../lib/context';
import { DEFAULT_BRAND } from '../../../lib/brand-profile';
import { getEntitlementContext } from '../../../lib/org-entitlements';
import { planIncludes } from '../../../lib/entitlements';
import '../../../styles/brand-editor.css';
interface Props { org: any; mode: 'identity' | 'portal'; }
const { org, mode } = Astro.props;
const L = currentLocale();
const say = (es:string,en:string) => L === 'en' ? en : es;
const profile = org.brandProfile ?? DEFAULT_BRAND;
const canRemove = planIncludes((await getEntitlementContext(org.id)).effectivePlan,'remove_branding');
const palettes = [ ['Tinta','Ink','#0a192f','#64748b'], ['Bosque','Forest','#185b48','#a7c4ae'], ['Arcilla','Clay','#8b4637','#d9b7a7'], ['Índigo','Indigo','#443b87','#bab4da'], ['Océano','Ocean','#146179','#a6d3df'], ['Grafito','Graphite','#343434','#b8b8b4'] ];
---
<div class="brand-editor" id="brandEditor" data-mode={mode} data-locale={L} data-primary={org.colorMarca} data-secondary={org.colorSecundario} data-logo={org.logoUrl} data-banner={org.portalBanner} data-welcome={org.portalBienvenida} data-chat={String(org.portalMostrarChat)} data-powered={String(canRemove ? org.portalPowered : true)}>
    <input type="hidden" data-field="brand_profile" id="brandProfile" value={JSON.stringify(profile)} />
    <div class="be-toolbar">
        <p>{say('Tu marca, en cada propuesta.','Your brand, in every proposal.')} <span>{say('Los cambios se aplican al guardar.','Changes apply when you save.')}</span></p>
        <div><button type="button" id="brandUndo" disabled>{say('Deshacer cambios','Undo changes')}</button><button type="button" id="brandReset">{say('Restaurar estilo','Reset style')}</button></div>
    </div>
    <div class="be-layout">
        <div class="be-controls">
            {mode === 'identity' ? <>
                <section class="be-section">
                    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('image')}></svg>{say('Logotipo','Logo')}</h3>
                    <p class="be-description">{say('Una identidad compartida con tus documentos y enlaces. La variante de contraste se usa en encabezados de color de documentos, portal y correos.','A shared identity for documents and links. The alternate logo is used on colored document, portal and email headers.')}</p>
                    <div class="be-logos">
                        {[['primary',say('Principal','Primary'),org.logoUrl],['dark',say('Sobre color','On color'),profile.logoDark]].map(([kind,label,url]) => <div class:list={['be-logo-tile',{'on-color':kind === 'dark'}]}>
                            <span class="be-label">{label}</span>
                            <div class="be-logo-art"><img data-logo-img={kind} src={url || undefined} alt={label} hidden={!url}/><span data-logo-fallback={kind} hidden={!!url}>{org.inicial}</span></div>
                            <label class="be-upload"><input type="file" data-logo-file={kind} accept="image/png,image/jpeg,image/webp,image/svg+xml"/><span>{say('Subir imagen','Upload image')}</span></label>
                            <button type="button" class="be-remove" data-logo-remove={kind}>{say('Quitar','Remove')}</button>
                        </div>)}
                    </div>
                    <input type="hidden" data-brand-option="logoDark" value={profile.logoDark}/>
                    <input type="hidden" id="brandLogo" data-field="logo_url" value={org.logoUrl}/>
                    <p class="be-help">PNG, JPG, SVG, WEBP · {say('Hasta 1 MB. Se conserva la proporción.','Up to 1 MB. Original proportions preserved.')}</p>
                    <label class="be-label" for="brandLogoSize">{say('Tamaño del logo','Logo size')}</label>
                    <select class="s-input" id="brandLogoSize" data-brand-option="logoSize">{[['small','Pequeño','Small'],['medium','Mediano','Medium'],['large','Grande','Large']].map(([v,es,en])=><option value={v} selected={profile.logoSize===v}>{say(es,en)}</option>)}</select>
                </section>
                <section class="be-section">
                    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('palette')}></svg>{say('Paleta de marca','Brand palette')}</h3>
                    <p class="be-description">{say('Empieza con una combinación o usa tus colores exactos.','Start with a palette or use your exact colors.')}</p>
                    <div class="be-palettes">{palettes.map(([es,en,a,b])=><button type="button" data-palette={`${a},${b}`} aria-label={say(es,en)} aria-pressed="false"><span style={`background:${a}`}></span><span style={`background:${b}`}></span><b>{say(es,en)}</b></button>)}</div>
                    <div class="be-color-fields">{[['brandPrimary','color_marca',org.colorMarca,say('Principal','Primary')],['brandSecondary','color_secundario',org.colorSecundario,say('Secundario','Secondary')]].map(([id,field,value,label])=><div><label class="be-label" for={id}>{label}</label><div class="be-color"><input type="color" data-color-for={id} value={value || org.colorMarca} aria-label={label}/><input id={id} class="s-input" data-field={field} value={value} maxlength="7" placeholder={org.colorMarca} pattern={field==='color_marca'?'#[0-9a-fA-F]{6}':'(#[0-9a-fA-F]{6})?'} required={field==='color_marca'}/></div></div>)}</div>
                    <p class="be-help">{say('El texto del botón se adapta al color para mantener su legibilidad.','Button text adapts to your color to stay readable.')}</p>
                </section>
                <section class="be-section">
                    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('type')}></svg>{say('Tipografía','Typography')}</h3>
                    <div class="be-options">{[['system','Sistema','System','-apple-system,sans-serif'],['humanist','Humanista','Humanist','Verdana,sans-serif'],['editorial','Editorial','Editorial','Georgia,serif']].map(([value,es,en,font])=><label class="be-option"><input type="radio" name="brandFont" data-brand-option="font" value={value} checked={profile.font===value}/><span class="be-type" style={`font-family:${font}`}>Aa</span><b>{say(es,en)}</b></label>)}</div>
                    <p class="be-help">{say('Se aplica al portal, cotizaciones y correos. Las facturas comerciales usan una fuente equivalente para impresión.','Applies to the portal, quotes and emails. Commercial invoices use an equivalent print font.')}</p>
                </section>
                <a class="be-next" href="/app/ajustes/portal">{say('Personalizar la composición y los mensajes del portal','Customize portal layout and messages')} <span>→</span></a>
                <a class="be-next" href="/app/ajustes/pdf">{say('Diseñar el documento PDF','Design your PDF document')} <span>→</span></a>
                <a class="be-next" href="/app/ajustes/correo">{say('Personalizar los correos al cliente','Customize client emails')} <span>→</span></a>
            </> : <>
                <div class="be-inherited"><span class="be-swatch" style={`background:${org.colorMarca}`}></span><div><b>{say('Identidad compartida','Shared identity')}</b><p>{say('Usa el logo, la paleta y la tipografía de tu marca.','Uses your brand’s logo, palette and typography.')}</p></div><a href="/app/ajustes/branding">{say('Editar','Edit')} →</a></div>
                <section class="be-section">
                    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('template')}></svg>{say('Composición','Layout')}</h3>
                    <p class="be-help">{say('Este estilo también se comparte con los correos y las facturas comerciales. Las cotizaciones tienen su propia composición en Documento PDF.','This style is also shared with emails and commercial invoices. Quotes have their own layout in PDF document settings.')}</p>
                    <div class="be-options">{[['classic','Esencial','Essential'],['soft','Suave','Soft'],['contrast','Contraste','Contrast']].map(([value,es,en])=><label class="be-option"><input type="radio" name="brandHeader" data-brand-option="header" value={value} checked={profile.header===value}/><span class={`be-layout-sample ${value}`}><i></i><i></i><i></i></span><b>{say(es,en)}</b></label>)}</div>
                    <div class="be-selects"><div><label class="be-label" for="brandCorners">{say('Bordes','Corners')}</label><select class="s-input" id="brandCorners" data-brand-option="corners">{[['precise','Definidos','Precise'],['soft','Suaves','Soft'],['round','Redondeados','Rounded']].map(([v,es,en])=><option value={v} selected={profile.corners===v}>{say(es,en)}</option>)}</select></div><div><label class="be-label" for="brandDensity">{say('Espaciado','Spacing')}</label><select class="s-input" id="brandDensity" data-brand-option="density"><option value="comfortable" selected={profile.density==='comfortable'}>{say('Amplio','Comfortable')}</option><option value="compact" selected={profile.density==='compact'}>{say('Compacto','Compact')}</option></select></div></div>
                </section>
                <section class="be-section">
                    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chat')}></svg>{say('Mensajes','Messages')}</h3>
                    <label class="be-label" for="brandBanner">{say('Aviso superior','Top announcement')}</label><input class="s-input" id="brandBanner" data-field="portal_banner" value={org.portalBanner} maxlength="200" placeholder={say('Un detalle que tu cliente debe conocer','A detail your client should know')}/>
                    <p class="be-help">{say('Déjalo vacío para ocultarlo.','Leave empty to hide.')}</p>
                    <label class="be-label" for="brandWelcome">{say('Bienvenida','Welcome message')}</label><textarea class="s-input" id="brandWelcome" data-field="portal_bienvenida" rows="3" maxlength="280" placeholder={say('Gracias por considerarnos. Estamos para ayudarte.','Thank you for considering us. We’re here to help.')}>{org.portalBienvenida}</textarea>
                </section>
                <section class="be-section">
                    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('sliders')}></svg>{say('Interacción','Interaction')}</h3>
                    <label class="s-toggle"><input type="checkbox" id="brandChat" data-field="portal_mostrar_chat" checked={org.portalMostrarChat}/><span class="s-toggle-track" aria-hidden="true"><span class="s-toggle-thumb"></span></span><span class="s-toggle-text">{say('Comentarios y contrapropuestas','Comments and counteroffers')}</span></label>
                    <p class="be-help">{say('Permite conversar sobre la propuesta desde el enlace.','Let clients discuss the proposal from its link.')}</p>
                    <label class="s-toggle"><input type="checkbox" id="brandPowered" data-field={canRemove?'portal_powered':undefined} checked={!canRemove || org.portalPowered} disabled={!canRemove}/><span class="s-toggle-track" aria-hidden="true"><span class="s-toggle-thumb"></span></span><span class="s-toggle-text">{say('Mostrar la marca de Cord','Show Cord branding')}</span></label>
                    {!canRemove && <p class="be-help"><a href="/app/ajustes/plan">{say('Consulta tu plan para quitar la marca de Cord.','Review your plan to remove Cord branding.')}</a></p>}
                </section>
            </>}
            <p id="brandError" class="be-error" role="alert" hidden></p>
        </div>
        <aside class="be-preview">
            <div class="be-preview-bar"><span>{say('Vista del cliente','Client view')}</span><div class="be-devices" role="group" aria-label={say('Tamaño de vista previa','Preview size')}><button type="button" data-preview-size="desktop" aria-pressed="true">{say('Escritorio','Desktop')}</button><button type="button" data-preview-size="mobile" aria-pressed="false">{say('Móvil','Mobile')}</button></div></div>
            <div class="be-preview-surfaces" role="group" aria-label={say('Vista previa','Preview')}>
                {[['portal','Portal','Portal'],['quote','Cotización','Quote'],['pdf','PDF','PDF'],['email','Correo','Email']].map(([key,es,en])=><button type="button" data-brand-surface-view={key} aria-pressed={key==='portal'?'true':'false'}>{say(es,en)}</button>)}
            </div>
            <div class="be-preview-compare" role="group" aria-label={say('Comparar cambios','Compare changes')}><button type="button" data-brand-compare="draft" aria-pressed="true">{say('Con tus cambios','Your draft')}</button><button type="button" data-brand-compare="saved" aria-pressed="false">{say('Guardado','Saved')}</button></div>
            <div class="be-preview-stage" data-size="desktop"><iframe id="brandPreview" src="/app/ajustes/marca-preview" title={say('Vista previa de cotización con tu marca','Quote preview with your brand')}></iframe></div>
            <p class="be-preview-note">{say('Cotización de ejemplo · No genera actividad ni envíos.','Sample quote · No activity or messages are generated.')}</p>
        </aside>
    </div>
</div>
<script>
    import { initBrandEditor } from '../../../lib/brand-editor';
    initBrandEditor();
</script>
