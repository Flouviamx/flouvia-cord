---
// PlanPaywallModal — upsell CONTEXTUAL: se abre desde cualquier elemento con
// `data-plan-paywall-open="<id>"` dentro de una pantalla que sí funciona
// (límite de asientos, de llaves de API, de webhooks). Cerrar solo descarta el
// modal y respeta el "no" del usuario.
//
// Una PÁGINA bloqueada no usa este modal: usa PlanGate, que deja ver la página
// desenfocada detrás y conserva la navegación. Antes el bloqueo de página era
// este mismo <dialog> abierto en automático: tapaba también el menú lateral y
// cerrarlo redirigía a otra ruta, así que el usuario quedaba atrapado entre
// pagar o salir.
//
// El contenido (planes, ciclo, CTA, medición) vive en PlanUpsell: una sola
// fuente para los dos bloqueos.
import PlanUpsell, { type PaywallFeature } from './PlanUpsell.astro';
import type { PlanId } from '../../lib/entitlements';
// El esqueleto viaja CON el componente (regla 12).
import '../../styles/modal.css';

interface Props {
    id?: string;
    title: string;
    desc: string;
    requiredPlan: PlanId;
    locale?: 'es' | 'en';
    feature?: PaywallFeature;
}
const { id = 'planPaywallModal', title, desc, requiredPlan, locale = 'es', feature } = Astro.props;
---

<dialog
    class="modal ppm"
    id={id}
    data-ppm
    aria-labelledby={`${id}Title`}
    aria-describedby={`${id}Desc`}
    tabindex="-1">
    <div class="ppm-body">
        <PlanUpsell id={id} title={title} desc={desc} requiredPlan={requiredPlan} locale={locale} feature={feature} surface="contextual" />
    </div>
</dialog>

<script>
    // Regla 13: se difiere a DOMContentLoaded.
    function initPaywallModals() {
        document.querySelectorAll<HTMLDialogElement>('dialog[data-ppm]').forEach((dlg) => {
            if (dlg.dataset.ppmReady === '1') return;
            dlg.dataset.ppmReady = '1';
            dlg.querySelector('[data-ppm-close]')?.addEventListener('click', () => dlg.close());
            // Clic en el backdrop: el <dialog> recibe el evento con target = sí mismo.
            dlg.addEventListener('click', (event) => { if (event.target === dlg) dlg.close(); });
        });

        // Delegación: también alcanza triggers que llegan después por
        // `innerHTML`, como las pestañas del Workbench.
        if (document.documentElement.dataset.ppmDelegated === '1') return;
        document.documentElement.dataset.ppmDelegated = '1';
        document.addEventListener('click', (event) => {
            const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-plan-paywall-open]');
            if (!trigger) return;
            const modalId = trigger.dataset.planPaywallOpen;
            const dlg = modalId ? document.getElementById(modalId) as HTMLDialogElement | null : null;
            if (!dlg?.matches('dialog[data-ppm]')) return;
            event.preventDefault();
            if (dlg.open) return;
            dlg.showModal();
            dlg.querySelector('[data-pu]')?.dispatchEvent(new CustomEvent('cord:paywall-open'));
            // El UA enfocaba el primer botón y dibujaba un aro permanente
            // alrededor de la X. El dialog recibe el foco; Tab sigue visible.
            requestAnimationFrame(() => dlg.focus({ preventScroll: true }));
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPaywallModals);
    else initPaywallModals();
</script>

<style>
    .ppm { width: min(520px, calc(100vw - 2rem)); border-radius: 26px; }
    .ppm:focus { outline: none; }
    .ppm[open] { animation: ppm-in 0.32s var(--ease-spring); }
    .ppm::backdrop { background: rgba(10,25,47,0.42); }
    .ppm-body {
        flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
        padding: 1.5rem 1.6rem calc(1.4rem + env(safe-area-inset-bottom, 0px));
    }
    @keyframes ppm-in {
        from { opacity: 0; transform: translateY(10px) scale(0.985); }
        to { opacity: 1; transform: none; }
    }
    @media (prefers-reduced-motion: reduce) { .ppm[open] { animation: none; } }
    @media (max-width: 560px) { .ppm-body { padding: 1.25rem 1.1rem calc(1.2rem + env(safe-area-inset-bottom, 0px)); } }
</style>
