---
import WidgetCard from './WidgetCard.astro';
import ChartPreview from './ChartPreview.astro';
import WidgetHeader from './WidgetHeader.astro';
import type { Props as CardProps } from './WidgetCard.astro';
interface Props extends Omit<CardProps, 'contentClass'> {
    kind: 'line' | 'bar' | 'hbar' | 'funnel' | 'segbar';
    data: Array<Record<string, unknown>>;
    format?: 'money' | 'number' | 'pct';
    emptyTitle: string;
    emptyDescription?: string;
    emptyIcon?: string;
}
const {kind, data, format = 'money', emptyTitle, emptyDescription, emptyIcon = "chart", ...card} = Astro.props;
const dataKey = kind === 'line' ? 'data-points' : kind === 'funnel' ? 'data-steps' : kind === 'segbar' ? 'data-segments' : 'data-items';
---
<WidgetCard {...card} compact={card.compact ?? 2} expanded={card.expanded ?? 4}>
    <WidgetHeader title={card.title} description={card.description} />
    <div class="chart-host report-chart" data-chart={kind} data-format={format}
        {...{[dataKey]:JSON.stringify(data)}} data-empty-icon={emptyIcon} data-empty-title={emptyTitle} data-empty-desc={emptyDescription}></div>
    <ChartPreview title={card.title} kind={kind} data={data} />
    <slot />
</WidgetCard>
