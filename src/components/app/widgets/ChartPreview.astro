---
/** Static miniature from the same data, including widgets not mounted yet. */
interface Props { title:string; kind:string; data:Array<Record<string,unknown>>; }
const {title,kind,data} = Astro.props;
const values = data.map(row => Math.max(0,Number(kind === 'line' ? row.y : row.value) || 0));
const max = Math.max(1,...values);
const sum = values.reduce((a,b) => a+b,0);
const points = values.map((value,i) => `${12+i/Math.max(1,values.length-1)*296},${118-value/max*96}`).join(' ');
const rows = data.slice(0,5);
---
<template data-widget-preview>
    <div class="dash-card" style="width:360px;height:220px;padding:24px">
        <strong style="display:block;font-size:16px;margin-bottom:20px">{title}</strong>
        <svg viewBox="0 0 320 130" width="100%" height="130" aria-hidden="true" style="color:var(--chart-fill,var(--color-blue-deep))">
            {kind === 'line' ? <polyline points={points} fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/> :
             kind === 'segbar' ? values.map((value,i) => <rect x={sum ? values.slice(0,i).reduce((a,b)=>a+b,0)/sum*320 : 0} y="40" width={sum ? value/sum*320 : 0} height="34" fill={String(data[i].color || 'currentColor')} />) :
             rows.map((row,i) => <g><text x="0" y={i*25+12} fill="var(--color-text-muted)" font-size="10">{String(row.label || '').slice(0,18)}</text><rect x="115" y={i*25+2} width={(values[i] || 0)/max*200} height="12" rx="4" fill="currentColor" opacity={1-i*.12}/></g>)}
        </svg>
    </div>
</template>
