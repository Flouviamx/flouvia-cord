---
import { t, type AppLocale } from '../../i18n/app';
import { fmtRelative } from '../../lib/fmt-server';
import { WORKFLOW_TEMPLATES, type WorkflowHealth } from '../../lib/workflows/service';
import { findAction, findTrigger, TRIGGER_CATEGORIES } from '../../lib/workflows/catalog';
import { BRAND_LOGOS, BRAND_TILES, WORKFLOW_ICONS } from '../../lib/workflows/icons';
import type { Step } from '../../lib/workflows/definition';

interface Props {
    lang: AppLocale;
    workflows: Record<string, any>[];
    limit: number | null;
    health: WorkflowHealth | null;
}

const { lang: L, workflows: WORKFLOWS, limit, health: HEALTH } = Astro.props;
const tf = (key: string, vars: Record<string, string | number>) => {
    let out = t(L, key as any);
    for (const k in vars) out = out.split(`{${k}}`).join(String(vars[k]));
    return out;
};
const activos = WORKFLOWS.filter((w) => w.estado === 'active').length;
const ESTADO = {
    draft: t(L, 'wf.estado.draft'),
    active: t(L, 'wf.estado.active'),
    paused: t(L, 'wf.estado.paused'),
} as const;
const categoryLabel = (key: string) => TRIGGER_CATEGORIES.find((c) => c.key === key)?.label[L] ?? '';
const triggerOf = (w: any) => findTrigger(w.trigger_publicado || w.trigger_borrador);

type ChainItem = { logo?: string; tile?: boolean; svg?: string };
const MAX_CHAIN = 4;
function chainOf(trigger: string, steps: Step[]): { items: ChainItem[]; extra: number } {
    const items: ChainItem[] = [{ svg: WORKFLOW_ICONS[findTrigger(trigger)?.category ?? 'trigger'] ?? WORKFLOW_ICONS.trigger }];
    const walk = (list: Step[]) => {
        for (const s of list) {
            if (s.type === 'action') {
                const brand = findAction(s.action)?.brand;
                items.push(brand && BRAND_LOGOS[brand] ? { logo: BRAND_LOGOS[brand], tile: BRAND_TILES.has(brand) } : { svg: WORKFLOW_ICONS[s.action] ?? WORKFLOW_ICONS.action });
            } else if (s.type === 'wait') {
                items.push({ svg: WORKFLOW_ICONS.wait });
            } else if (s.type === 'query') {
                items.push({ svg: WORKFLOW_ICONS.query });
            } else if (s.type === 'condition' || s.type === 'wait_until') {
                // Solo estos dos tienen ramas. El `else` suelto de antes daba
                // por hecho que todo lo que no era acción ni espera era una
                // condición, así que un paso nuevo reventaba la lista entera.
                items.push({ svg: s.type === 'wait_until' ? WORKFLOW_ICONS.wait_until : WORKFLOW_ICONS.condition });
                walk(s.then);
                walk(s.else);
            }
        }
    };
    walk(steps);
    return { items: items.slice(0, MAX_CHAIN), extra: Math.max(0, items.length - MAX_CHAIN) };
}
const IDEAS = WORKFLOW_TEMPLATES.map((tpl) => {
    const def = tpl.definicion(L);
    return { tpl, trig: findTrigger(def.trigger), chain: chainOf(def.trigger, def.steps) };
});
const ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const GLYPH = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.75" width="10" height="7.5" rx="2.5" fill="currentColor" fill-opacity="0.15" stroke="none"/><rect x="2.5" y="2.75" width="10" height="7.5" rx="2.5"/><path d="m6.6 4.9 3.2 1.6-3.2 1.6z" fill="currentColor" stroke-width="1"/><rect x="11.5" y="13.75" width="10" height="7.5" rx="2.5" fill="currentColor" fill-opacity="0.15" stroke="none"/><rect x="11.5" y="13.75" width="10" height="7.5" rx="2.5"/><path d="M14.5 17.5h4" stroke-opacity="0.55"/><path d="M7.5 10.25v4a3.25 3.25 0 0 0 3.25 3.25h.75" stroke-opacity="0.7"/></svg>';
---

<div class="wfl" data-error={t(L, 'wf.error_guardar')}>
    <div class="wfl-top">
        <p class="wfl-intro">{t(L, 'wf.intro')}</p>
        {limit !== null && (
            <span class="wfl-cupo" data-full={activos >= limit ? '1' : undefined}>{tf('wf.cupo', { usados: activos, limite: limit })}</span>
        )}
    </div>

    {HEALTH && HEALTH.total > 0 && (
        <section class="wfl-health" aria-label={t(L, 'wf.salud_titulo')}>
            <div class="wfl-health-head">
                <h2>{t(L, 'wf.salud_titulo')}</h2>
                <span>{tf('wf.salud_ventana', { dias: HEALTH.dias })}</span>
            </div>
            <div class="wfl-kpis">
                <span class="wfl-kpi"><b class="editorial">{HEALTH.total}</b><small>{t(L, 'wf.salud_total')}</small></span>
                <span class="wfl-kpi"><b class="editorial">{HEALTH.exitosas}</b><small>{t(L, 'wf.salud_exitosas')}</small></span>
                <span class="wfl-kpi" data-bad={HEALTH.fallidas > 0 ? '1' : undefined}><b class="editorial">{HEALTH.fallidas}</b><small>{t(L, 'wf.salud_fallidas')}</small></span>
                <span class="wfl-kpi"><b class="editorial">{HEALTH.esperando}</b><small>{t(L, 'wf.salud_esperando')}</small></span>
            </div>
            {HEALTH.causas.length > 0 ? (
                <div class="wfl-causas">
                    <span class="wfl-causas-title">{t(L, 'wf.salud_causas')}</span>
                    <ul>
                        {HEALTH.causas.map((c) => (
                            <li>
                                <span class="wfl-causa-n">{c.n}</span>
                                <span class="wfl-causa-text">
                                    <strong>{c.mensaje}</strong>
                                    <small>{c.workflow}{c.ultima ? ` · ${fmtRelative(c.ultima)}` : ''}</small>
                                </span>
                            </li>
                        ))}
                    </ul>
                </div>
            ) : (
                <p class="wfl-causas-ok">{t(L, 'wf.salud_sin_fallos')}</p>
            )}
        </section>
    )}

    {WORKFLOWS.length > 0 ? (
        <section class="surface-card pad-0 wfl-card" aria-label={t(L, 'wf.heading')}>
            <div class="wfl-head">
                <span>{t(L, 'wf.th_nombre')}</span>
                <span>{t(L, 'wf.th_disparador')}</span>
                <span class="wfl-num">{t(L, 'wf.th_ejecuciones')}</span>
                <span>{t(L, 'wf.th_estado')}</span>
            </div>
            {WORKFLOWS.map((w) => {
                const trig = triggerOf(w);
                const estadoKey = (w.estado as keyof typeof ESTADO) in ESTADO ? (w.estado as keyof typeof ESTADO) : 'draft';
                return (
                    <a class="wfl-row" href={`/app/workflows/${w.id}`}>
                        <span class="wfl-name">
                            <span class="wfl-glyph" aria-hidden="true" set:html={trig ? (WORKFLOW_ICONS[trig.category] ?? GLYPH) : GLYPH} />
                            <span class="wfl-name-text">
                                <strong>{w.nombre}</strong>
                                <small>{fmtRelative(w.updated_at)}</small>
                            </span>
                        </span>
                        <span class="wfl-trigger">
                            {trig ? (
                                <Fragment>
                                    <span>{trig.label[L]}</span>
                                    <small>{categoryLabel(trig.category)}</small>
                                </Fragment>
                            ) : <span class="wfl-muted">{t(L, 'wf.sin_disparador')}</span>}
                        </span>
                        <span class="wfl-num">
                            <span class="editorial">{Number(w.runs_30d)}</span>
                            {Number(w.fallidas_30d) > 0 && <small class="wfl-failed">{tf('wf.fallidas', { n: Number(w.fallidas_30d) })}</small>}
                        </span>
                        <span class="wfl-estado-cell"><span class="status-pill wfl-estado" data-estado={estadoKey}>{ESTADO[estadoKey]}</span></span>
                    </a>
                );
            })}
        </section>
    ) : (
        <section class="surface-card wfl-empty">
            <span class="wfl-empty-glyph" aria-hidden="true" set:html={GLYPH} />
            <div class="wfl-empty-text">
                <h2>{t(L, 'wf.vacio_titulo')}</h2>
                <p>{t(L, 'wf.vacio_desc')}</p>
            </div>
            <button type="button" class="wfl-empty-btn" data-wf-create>{t(L, 'wf.nuevo')}</button>
        </section>
    )}

    <section class="wfl-ideas" aria-labelledby="wfl-ideas-title">
        <h2 class="wfl-ideas-title" id="wfl-ideas-title">{t(L, 'wf.plantillas')}</h2>
        <div class="wfl-grid">
            {IDEAS.map(({ tpl, trig, chain }) => (
                <button type="button" class="surface-card wfl-idea" data-wf-create={tpl.key}>
                    <span class="wfl-chain" aria-hidden="true">
                        {chain.items.map((item, i) => (
                            <Fragment>
                                {i > 0 && <span class="wfl-chain-arrow" set:html={ARROW} />}
                                <span class:list={["wfl-chain-node", { "is-tile": item.tile }]}>
                                    {item.logo ? <img src={item.logo} alt="" width="18" height="18" loading="lazy" /> : <Fragment set:html={item.svg} />}
                                </span>
                            </Fragment>
                        ))}
                        {chain.extra > 0 && <span class="wfl-chain-more">+{chain.extra}</span>}
                    </span>
                    <span class="wfl-idea-title">{tpl.nombre[L]}</span>
                    <span class="wfl-idea-desc">{tpl.descripcion[L]}</span>
                    <span class="wfl-idea-foot">
                        {trig && <span class="wfl-idea-trigger">{trig.label[L]}</span>}
                        <span class="wfl-idea-use">
                            {t(L, 'wf.usar_plantilla')}
                            <span set:html={ARROW} />
                        </span>
                    </span>
                </button>
            ))}
        </div>
    </section>
</div>

<style>
    /* Panel de salud: el conteo por CAUSA es lo que convierte "algo falla" en
       "Slack se desconectó el martes". */
    .wfl-health { margin-bottom: 1.4rem; padding: 1.15rem 1.35rem 1.25rem; border-radius: 22px; background: var(--color-bg-soft); border: 1px solid var(--color-border); }
    .wfl-health-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 0.9rem; }
    .wfl-health-head h2 { margin: 0; font-size: 0.95rem; font-weight: 650; letter-spacing: -0.02em; }
    .wfl-health-head span { font-size: 0.76rem; color: var(--color-text-muted); }
    .wfl-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
    .wfl-kpi { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-radius: 14px; background: var(--surface); }
    .wfl-kpi b { font-size: 1.28rem; line-height: 1.1; }
    .wfl-kpi small { font-size: 0.72rem; color: var(--color-text-muted); }
    .wfl-kpi[data-bad] b { color: var(--color-danger); }
    .wfl-causas { margin-top: 1rem; }
    .wfl-causas-title { display: block; margin-bottom: 0.5rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: var(--color-text-muted); }
    .wfl-causas ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .wfl-causas li { display: flex; align-items: flex-start; gap: 10px; padding: 9px 12px; border-radius: 12px; background: var(--surface); }
    .wfl-causa-n { flex-shrink: 0; min-width: 26px; padding: 1px 7px; border-radius: 7px; background: rgba(220, 38, 38, 0.1); color: var(--color-danger); font-size: 0.76rem; font-weight: 700; text-align: center; }
    .wfl-causa-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .wfl-causa-text strong { font-size: 0.83rem; font-weight: 500; }
    .wfl-causa-text small { font-size: 0.73rem; color: var(--color-text-muted); }
    .wfl-causas-ok { margin: 1rem 0 0; font-size: 0.82rem; color: var(--color-text-muted); }
    @media (max-width: 880px) {
        .wfl-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    .wfl { display: flex; flex-direction: column; gap: 1.75rem; }
    .wfl-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; }
    .wfl-intro { margin: 0; max-width: 620px; font-size: 0.92rem; line-height: 1.55; color: var(--color-text-muted); text-wrap: pretty; }
    .wfl-cupo {
        flex-shrink: 0; font-size: 0.76rem; font-weight: 600; color: var(--color-text-muted);
        padding: 6px 12px; border-radius: 100px; background: var(--surface); box-shadow: var(--card-shadow);
    }
    .wfl-cupo[data-full] { color: #b45309; }

    .wfl-card { overflow: hidden; }
    .wfl-head, .wfl-row {
        display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1.3fr) 150px 110px;
        gap: 1rem; align-items: center; padding: 0.95rem 1.5rem;
    }
    .wfl-head { padding-top: 1.05rem; padding-bottom: 0.75rem; font-size: 0.72rem; font-weight: 600; color: var(--color-text-muted); }
    .wfl-row { text-decoration: none; color: var(--color-text); border-top: 1px solid var(--color-border); transition: background 0.2s var(--ease-ios); }
    .wfl-row:hover { background: var(--row-hover); }
    .wfl-row:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: -2px; }
    .wfl-name { display: flex; align-items: center; gap: 0.8rem; min-width: 0; }
    .wfl-glyph { width: 36px; height: 36px; border-radius: 11px; flex-shrink: 0; display: grid; place-items: center; color: var(--color-blue-deep); background: var(--color-bg-soft); }
    .wfl-glyph :global(svg) { width: 18px; height: 18px; }
    .wfl-name-text, .wfl-trigger { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .wfl-name-text strong { font-size: 0.9rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wfl-name-text small, .wfl-trigger small { font-size: 0.74rem; color: var(--color-text-muted); }
    .wfl-trigger span { font-size: 0.84rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wfl-muted { color: var(--color-text-muted); }
    .wfl-num { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; text-align: right; }
    .wfl-num .editorial { font-size: 0.95rem; color: var(--color-blue-deep); }
    .wfl-failed { font-size: 0.72rem; color: var(--color-danger); font-weight: 600; }
    .wfl-estado[data-estado="draft"] { color: #5b6472; background: rgba(91,100,114,0.1); }
    .wfl-estado[data-estado="active"] { color: #047857; background: rgba(16,185,129,0.12); }
    .wfl-estado[data-estado="paused"] { color: #b45309; background: rgba(245,158,11,0.14); }
    :global(html[data-theme="dark"]) .wfl-estado[data-estado="draft"] { color: #c3cad5; background: rgba(195,202,213,0.12); }
    :global(html[data-theme="dark"]) .wfl-estado[data-estado="active"] { color: #34d399; background: rgba(16,185,129,0.18); }
    :global(html[data-theme="dark"]) .wfl-estado[data-estado="paused"] { color: #fbbf24; background: rgba(245,158,11,0.18); }
    :global(html[data-theme="dark"]) .wfl-cupo[data-full] { color: #fbbf24; }

    .wfl-empty { display: flex; align-items: center; gap: 1.1rem; padding: 1.6rem 1.7rem; }
    .wfl-empty-glyph { width: 48px; height: 48px; border-radius: 14px; flex-shrink: 0; display: grid; place-items: center; color: var(--color-blue-deep); background: var(--color-bg-soft); }
    .wfl-empty-glyph :global(svg) { width: 24px; height: 24px; }
    .wfl-empty-text { flex: 1; min-width: 0; }
    .wfl-empty h2 { margin: 0 0 0.25rem; font-size: 1.05rem; font-weight: 600; letter-spacing: -0.02em; color: var(--color-text); }
    .wfl-empty p { margin: 0; font-size: 0.86rem; color: var(--color-text-muted); }
    .wfl-empty-btn {
        flex-shrink: 0; font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; cursor: pointer;
        color: #fff; background: var(--color-blue-deep); border: none; padding: 10px 18px; border-radius: 100px;
        transition: transform 0.3s var(--ease-spring);
    }
    .wfl-empty-btn:hover { transform: translateY(-1px); }
    .wfl-empty-btn:active { transform: scale(0.97); }
    .wfl-empty-btn:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }

    .wfl-ideas { display: flex; flex-direction: column; gap: 0.9rem; }
    .wfl-ideas-title { margin: 0; font-size: 0.98rem; font-weight: 600; letter-spacing: -0.01em; color: var(--color-text); }
    .wfl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
    .wfl-idea {
        display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; width: 100%; min-height: 100%;
        padding: 1.25rem 1.35rem 1.1rem; border: none; cursor: pointer; text-align: left;
        font-family: var(--font-sans); color: var(--color-text);
        transition: transform 0.3s var(--ease-spring), box-shadow 0.3s var(--ease-ios);
    }
    .wfl-idea:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }
    .wfl-idea:active { transform: scale(0.99); }
    .wfl-idea:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 3px; }
    .wfl-chain { display: flex; align-items: center; gap: 6px; margin-bottom: 0.45rem; }
    .wfl-chain-node {
        width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center;
        color: var(--color-blue-deep); background: var(--color-bg-soft);
    }
    .wfl-chain-node :global(svg) { width: 17px; height: 17px; }
    .wfl-chain-node img { width: 18px; height: 18px; border-radius: 4px; }
    .wfl-chain-node.is-tile { background: none; overflow: hidden; }
    .wfl-chain-node.is-tile img { width: 100%; height: 100%; border-radius: inherit; object-fit: cover; }
    .wfl-chain-arrow { display: grid; color: var(--color-text-muted); opacity: 0.55; }
    .wfl-chain-arrow :global(svg) { width: 12px; height: 12px; }
    .wfl-chain-more { font-size: 0.72rem; font-weight: 600; color: var(--color-text-muted); padding-left: 2px; }
    .wfl-idea-title { font-size: 0.92rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; }
    .wfl-idea-desc { font-size: 0.8rem; line-height: 1.5; color: var(--color-text-muted); text-wrap: pretty; flex: 1; }
    .wfl-idea-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; width: 100%; margin-top: 0.4rem; }
    .wfl-idea-trigger {
        font-size: 0.7rem; font-weight: 600; color: var(--color-text-muted); background: var(--color-bg-soft);
        padding: 4px 10px; border-radius: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
    }
    .wfl-idea-use { display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0; font-size: 0.8rem; font-weight: 600; color: var(--color-blue-deep); }
    .wfl-idea-use :global(svg) { width: 13px; height: 13px; transition: transform 0.3s var(--ease-spring); }
    .wfl-idea:hover .wfl-idea-use :global(svg) { transform: translateX(3px); }
    :global(html[data-theme="dark"]) .wfl-glyph,
    :global(html[data-theme="dark"]) .wfl-empty-glyph,
    :global(html[data-theme="dark"]) .wfl-chain-node,
    :global(html[data-theme="dark"]) .wfl-idea-use,
    :global(html[data-theme="dark"]) .wfl-num .editorial { color: #dbe4f0; }
    [data-wf-create][aria-busy="true"] { opacity: 0.6; pointer-events: none; }

    @media (prefers-reduced-motion: reduce) {
        .wfl-idea, .wfl-idea:hover, .wfl-idea-use :global(svg) { transition: none; transform: none; }
    }

    @media (max-width: 880px) {
        .wfl-top { align-items: flex-start; flex-direction: column; gap: 0.75rem; }
        .wfl-head { display: none; }
        .wfl-row {
            grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name estado" "trigger num";
            row-gap: 0.5rem; padding: 1rem 1.1rem;
        }
        .wfl-row:first-of-type { border-top: none; }
        .wfl-name { grid-area: name; }
        .wfl-trigger { grid-area: trigger; }
        .wfl-num { grid-area: num; }
        .wfl-estado-cell { grid-area: estado; justify-self: end; }
        .wfl-empty { flex-direction: column; align-items: flex-start; }
        .wfl-empty-btn { width: 100%; min-height: 46px; }
        .wfl-grid { grid-template-columns: 1fr; }
        .wfl-idea { min-height: 44px; }
    }
</style>

<script>
    const errorMsg = document.querySelector<HTMLElement>('.wfl')?.dataset.error || '';
    document.querySelectorAll<HTMLButtonElement>('[data-wf-create]').forEach((btn) => {
        btn.addEventListener('click', async () => {
            btn.setAttribute('aria-busy', 'true');
            try {
                const res = await fetch('/api/workflows', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(btn.dataset.wfCreate ? { plantilla: btn.dataset.wfCreate } : {}),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.id) throw new Error(data.error || errorMsg);
                window.location.href = `/app/workflows/${data.id}`;
            } catch (err) {
                btn.removeAttribute('aria-busy');
                (window as any).cordToast?.((err as Error).message || errorMsg, 'error');
            }
        });
    });
</script>
