---
import ChartWidget from '../widgets/ChartWidget.astro';
import MetricWidget from '../widgets/MetricWidget.astro';
import WidgetCard from '../widgets/WidgetCard.astro';
import ScopeTag from '../widgets/ScopeTag.astro';
import { money } from '../../../lib/queries';
import WidgetEmpty from '../WidgetEmpty.astro';
const { data: D, L } = Astro.props;
const es = L !== 'en';
---
<ChartWidget tone="commercial" id="clientes-ranking" compact={2} expanded={4} title={es ? 'Clientes por valor cerrado' : 'Clients by closed value'} description={es ? 'Quién convierte valor, no solo volumen de cotizaciones.' : 'Who converts value, not just quote volume.'} kind="hbar" data={D.clientes.map((row: any) => ({ label: row.empresa, value: row.cerrado, sub: `${row.tasa}%` }))} emptyTitle={es ? 'Sin cierres por cliente' : 'No closings by client'} emptyIcon="clients"></ChartWidget>
<WidgetCard tone="commercial" id="clientes-tabla" title={es ? 'Conversión por cliente' : 'Client conversion'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Conversión por cliente' : 'Client conversion'}</h2><p>{es ? 'Cierres dentro de la cohorte seleccionada.' : 'Wins inside the selected cohort.'}</p></div></div><div class="report-list">{D.clientes.length ? D.clientes.map((row: any) => <a href={`/app/clientes/${row.id}`}><span><strong>{row.empresa}</strong><small>{row.aprobadas} / {row.cotizaciones} · {row.tasa}%</small></span><b class="editorial">{money(row.cerrado, 0)}</b></a>) : <WidgetEmpty icon="clients" title={es ? 'Sin clientes en este rango' : 'No clients in this range'} />}</div></WidgetCard>
<WidgetCard tone="commercial" id="clientes-cohortes" title={es ? 'Nuevos vs. recurrentes' : 'New vs. returning'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Nuevos vs. recurrentes' : 'New vs. returning'}</h2><p>{es ? 'Valor cerrado según la madurez de la relación.' : 'Closed value by relationship maturity.'}</p></div></div><div class="chart-host report-chart" data-chart="bar" data-items={JSON.stringify(D.cohortes.map((row: any) => ({ label: row.tipo === 'nuevo' ? (es ? 'Nuevos' : 'New') : (es ? 'Recurrentes' : 'Returning'), value: row.cerrado, sub: `${row.clientes}` }))) } data-empty-icon="clients" data-empty-title={es ? 'Sin cohortes en este rango' : 'No cohorts in this range'}></div></WidgetCard>
<WidgetCard tone="commercial" id="clientes-riesgo" title={es ? 'Clientes en riesgo' : 'Clients at risk'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Clientes en riesgo' : 'Clients at risk'}</h2><p>{es ? 'Tienen historial, pero ninguna actividad en 90 días.' : 'They have history, but no activity in 90 days.'}<ScopeTag scope="hoy" /></p></div></div><div class="report-list">{D.enRiesgo.length ? D.enRiesgo.map((row: any) => <a href={`/app/clientes/${row.id}`}><span><strong>{row.empresa}</strong><small>{row.nivel} · {row.cotizaciones} {es ? 'cotizaciones' : 'quotes'}</small></span><b class="editorial">{money(row.cerrado, 0)}</b></a>) : <p class="report-empty">{es ? 'No hay clientes inactivos con historial.' : 'No inactive clients with history.'}</p>}</div></WidgetCard>
<WidgetCard tone="commercial" id="clientes-matriz" title={es ? 'Nivel y comportamiento' : 'Tier and behavior'} compact={4} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Matriz nivel × comportamiento de pago' : 'Tier × payment behavior matrix'}</h2><p>{es ? 'Cruza el nivel comercial con la puntualidad histórica real.' : 'Crosses commercial tier with actual historical payment timing.'}<ScopeTag scope="hoy" /></p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.matriz.map((row: any) => ({ label: `${row.nivel} · ${row.comportamiento === 'puntual' ? (es ? 'Puntual' : 'On time') : row.comportamiento === 'ligero' ? (es ? '1–7 días tarde' : '1–7 days late') : (es ? 'Más de 7 días tarde' : 'Over 7 days late')}`, value: row.cerrado, sub: `${row.clientes}` }))) } data-empty-icon="clients" data-empty-title={es ? 'Sin datos de comportamiento' : 'No behavior data'}></div></WidgetCard>

<MetricWidget id="clientes-opcional-riesgo" optional title={es ? 'Relaciones por reactivar' : 'Relationships to reactivate'} value={D.enRiesgoTotal ?? D.enRiesgo.length} description={es ? 'Clientes con historial y sin actividad en 90 días' : 'Clients with history and no activity in 90 days'} />
