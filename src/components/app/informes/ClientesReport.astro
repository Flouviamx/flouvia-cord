---
import { money } from '../../../lib/queries';
const { data: D, L } = Astro.props;
const es = L !== 'en';
---
<article class="dash-widget" data-widget="clientes-ranking" data-title={es ? 'Clientes por cierre' : 'Clients by closed value'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Clientes por valor cerrado' : 'Clients by closed value'}</h2><p>{es ? 'Quién convierte valor, no solo volumen de cotizaciones.' : 'Who converts value, not just quote volume.'}</p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.clientes.map((row: any) => ({ label: row.empresa, value: row.cerrado, sub: `${row.tasa}%` }))) }></div></div></article>
<article class="dash-widget" data-widget="clientes-tabla" data-title={es ? 'Conversión por cliente' : 'Client conversion'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Conversión por cliente' : 'Client conversion'}</h2><p>{es ? 'Cierres dentro de la cohorte seleccionada.' : 'Wins inside the selected cohort.'}</p></div></div><div class="report-list">{D.clientes.map((row: any) => <div><span><strong>{row.empresa}</strong><small>{row.aprobadas} / {row.cotizaciones} · {row.tasa}%</small></span><b class="editorial">{money(row.cerrado, 0)}</b></div>)}</div></div></article>
<article class="dash-widget" data-widget="clientes-cohortes" data-title={es ? 'Nuevos vs. recurrentes' : 'New vs. returning'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Nuevos vs. recurrentes' : 'New vs. returning'}</h2><p>{es ? 'Valor cerrado según la madurez de la relación.' : 'Closed value by relationship maturity.'}</p></div></div><div class="chart-host report-chart" data-chart="bar" data-items={JSON.stringify(D.cohortes.map((row: any) => ({ label: row.tipo === 'nuevo' ? (es ? 'Nuevos' : 'New') : (es ? 'Recurrentes' : 'Returning'), value: row.cerrado, sub: `${row.clientes}` }))) }></div></div></article>
<article class="dash-widget" data-widget="clientes-riesgo" data-title={es ? 'Clientes en riesgo' : 'Clients at risk'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Clientes en riesgo' : 'Clients at risk'}</h2><p>{es ? 'Tienen historial, pero ninguna actividad en 90 días.' : 'They have history, but no activity in 90 days.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="report-list">{D.enRiesgo.length ? D.enRiesgo.map((row: any) => <a href={`/app/clientes/${row.id}`}><span><strong>{row.empresa}</strong><small>{row.nivel} · {row.cotizaciones} {es ? 'cotizaciones' : 'quotes'}</small></span><b class="editorial">{money(row.cerrado, 0)}</b></a>) : <p class="report-empty">{es ? 'No hay clientes inactivos con historial.' : 'No inactive clients with history.'}</p>}</div></div></article>
<article class="dash-widget" data-widget="clientes-matriz" data-title={es ? 'Nivel y comportamiento' : 'Tier and behavior'} data-span="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Matriz nivel × comportamiento de pago' : 'Tier × payment behavior matrix'}</h2><p>{es ? 'Cruza el nivel comercial con la puntualidad histórica real.' : 'Crosses commercial tier with actual historical payment timing.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.matriz.map((row: any) => ({ label: `${row.nivel} · ${row.comportamiento === 'puntual' ? (es ? 'Puntual' : 'On time') : row.comportamiento === 'ligero' ? (es ? '1–7 días tarde' : '1–7 days late') : (es ? 'Más de 7 días tarde' : 'Over 7 days late')}`, value: row.cerrado, sub: `${row.clientes}` }))) }></div></div></article>
