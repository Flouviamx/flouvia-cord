---
import { money } from '../../../lib/queries';
import WidgetEmpty from '../WidgetEmpty.astro';
const { data: D, L } = Astro.props;
const es = L !== 'en';
---
<article class="dash-widget" data-widget="fin-mrr" data-title="MRR" data-span="1" data-size-sm="1" data-size-lg="2"><div class="dash-card report-kpi"><span class="kpi-label">MRR {es ? 'CONTRATADO' : 'CONTRACTED'}</span><strong class="editorial report-kpi-value">{money(D.mrr.activo, 0)}</strong><small>{D.mrr.nIgualas} {es ? 'igualas activas' : 'active retainers'}</small></div></article>
<article class="dash-widget" data-widget="fin-arr" data-title="ARR" data-span="1" data-size-sm="1" data-size-lg="2"><div class="dash-card report-kpi"><span class="kpi-label">ARR</span><strong class="editorial report-kpi-value">{money(D.mrr.arr, 0)}</strong><small>{es ? 'MRR anualizado' : 'Annualized MRR'}</small></div></article>
<article class="dash-widget" data-widget="fin-dso" data-title="DSO" data-span="1" data-size-sm="1" data-size-lg="2"><div class="dash-card report-kpi"><span class="kpi-label">DSO</span><strong class="editorial report-kpi-value">{D.kpis.dso || '—'}{D.kpis.dso > 0 && <em>d</em>}</strong><small>{es ? 'tiempo estimado a cobro' : 'estimated time to collection'}</small></div></article>
<article class="dash-widget" data-widget="fin-riesgo-mrr" data-title={es ? 'MRR en riesgo' : 'MRR at risk'} data-span="1" data-size-sm="1" data-size-lg="2"><div class="dash-card report-kpi"><span class="kpi-label">MRR {es ? 'EN RIESGO' : 'AT RISK'}</span><strong class="editorial report-kpi-value is-danger">{money(D.mrr.enRiesgo, 0)}</strong><small>past_due / cancel_at_period_end</small></div></article>
<article class="dash-widget" data-widget="fin-pipeline" data-title={es ? 'Pipeline ponderado' : 'Weighted pipeline'} data-span="2" data-size-sm="2" data-size-lg="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Pipeline ponderado por cliente' : 'Client-weighted pipeline'}</h2><p>{es ? 'Probabilidad y tiempo derivados del historial real.' : 'Probability and timing from actual history.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.rankClientes.slice(0, 8).map((row: any) => ({ label: row.empresa, value: row.valorEsperado, sub: `${row.tasaPct}%` }))) } data-empty-icon="clients" data-empty-title={es ? 'Sin pipeline ponderado' : 'No weighted pipeline'}></div></div></article>
<article class="dash-widget" data-widget="fin-concentracion" data-title={es ? 'Concentración' : 'Concentration'} data-span="2" data-size-sm="2" data-size-lg="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Concentración del pipeline' : 'Pipeline concentration'}</h2><p>{es ? 'Exposición al cliente de mayor peso.' : 'Exposure to the largest client.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="report-focus"><strong class="editorial">{D.kpis.concentracion}%</strong><span>{D.rankClientes[0]?.empresa ?? '—'}</span></div></div></article>
<article class="dash-widget" data-widget="fin-niveles" data-title={es ? 'Rentabilidad por nivel' : 'Profitability by tier'} data-span="4" data-size-sm="4" data-size-lg="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Rentabilidad por nivel de cliente' : 'Profitability by client tier'}</h2><p>{es ? 'Contrasta descuento configurado, tasa de cierre y valor cerrado.' : 'Compares configured discount, close rate, and closed value.'}</p></div></div><div class="report-list">{D.niveles.length ? D.niveles.map((row: any) => <div><span><strong>{row.nivel}</strong><small>{Math.round(row.descuento)}% {es ? 'descuento' : 'discount'} · {row.tasa}% {es ? 'cierre' : 'close rate'} · n={row.enviadas}</small></span><b class="editorial">{money(row.cerrado, 0)}</b></div>) : <WidgetEmpty icon="clients" title={es ? 'Sin niveles configurados' : 'No tiers configured'} />}</div></div></article>
