---
import MetricWidget from '../widgets/MetricWidget.astro';
import WidgetCard from '../widgets/WidgetCard.astro';
import { money } from '../../../lib/queries';
import WidgetEmpty from '../WidgetEmpty.astro';
const { data: D, L } = Astro.props;
const es = L !== 'en';
---
<WidgetCard tone="finance" id="fin-mrr" title="MRR" compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">MRR {es ? 'CONTRATADO' : 'CONTRACTED'}</span><strong class="editorial report-kpi-value">{money(D.mrr.activo, 0)}</strong><small>{D.mrr.nIgualas} {es ? 'igualas activas' : 'active retainers'}</small></WidgetCard>
<WidgetCard tone="finance" id="fin-arr" title="ARR" compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">ARR</span><strong class="editorial report-kpi-value">{money(D.mrr.arr, 0)}</strong><small>{es ? 'MRR anualizado' : 'Annualized MRR'}</small></WidgetCard>
<WidgetCard tone="finance" id="fin-dso" title="DSO" compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">DSO</span><strong class="editorial report-kpi-value">{D.kpis.dso || '—'}{D.kpis.dso > 0 && <em>d</em>}</strong><small>{es ? 'tiempo estimado a cobro' : 'estimated time to collection'}</small></WidgetCard>
<WidgetCard tone="finance" id="fin-riesgo-mrr" title={es ? 'MRR en riesgo' : 'MRR at risk'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">MRR {es ? 'EN RIESGO' : 'AT RISK'}</span><strong class="editorial report-kpi-value is-danger">{money(D.mrr.enRiesgo, 0)}</strong><small>past_due / cancel_at_period_end</small></WidgetCard>
<WidgetCard tone="finance" id="fin-pipeline" title={es ? 'Pipeline ponderado' : 'Weighted pipeline'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Pipeline ponderado por cliente' : 'Client-weighted pipeline'}</h2><p>{es ? 'Probabilidad y tiempo derivados del historial real.' : 'Probability and timing from actual history.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.rankClientes.slice(0, 8).map((row: any) => ({ label: row.empresa, value: row.valorEsperado, sub: `${row.tasaPct}%` }))) } data-empty-icon="clients" data-empty-title={es ? 'Sin pipeline ponderado' : 'No weighted pipeline'}></div></WidgetCard>
<WidgetCard tone="finance" id="fin-concentracion" title={es ? 'Concentración' : 'Concentration'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Concentración del pipeline' : 'Pipeline concentration'}</h2><p>{es ? 'Exposición al cliente de mayor peso.' : 'Exposure to the largest client.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="report-focus"><strong class="editorial">{D.kpis.concentracion}%</strong><span>{D.rankClientes[0]?.empresa ?? '—'}</span></div></WidgetCard>
<WidgetCard tone="finance" id="fin-niveles" title={es ? 'Rentabilidad por nivel' : 'Profitability by tier'} compact={4} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Rentabilidad por nivel de cliente' : 'Profitability by client tier'}</h2><p>{es ? 'Contrasta descuento configurado, tasa de cierre y valor cerrado.' : 'Compares configured discount, close rate, and closed value.'}</p></div></div><div class="report-list">{D.niveles.length ? D.niveles.map((row: any) => <div><span><strong>{row.nivel}</strong><small>{Math.round(row.descuento)}% {es ? 'descuento' : 'discount'} · {row.tasa}% {es ? 'cierre' : 'close rate'} · n={row.enviadas}</small></span><b class="editorial">{money(row.cerrado, 0)}</b></div>) : <WidgetEmpty icon="clients" title={es ? 'Sin niveles configurados' : 'No tiers configured'} />}</div></WidgetCard>

<MetricWidget id="fin-opcional-igualas" optional tone="finance" title={es ? 'Igualas activas' : 'Active retainers'} value={D.mrr.nIgualas} description={es ? 'Contratos que aportan ingreso recurrente' : 'Contracts contributing recurring revenue'} details={[{label:'MRR',value:money(D.mrr.activo,0)},{label:'ARR',value:money(D.mrr.arr,0)}]} />
