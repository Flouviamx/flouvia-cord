---
import { money } from '../../../lib/queries';
const { data: D, L } = Astro.props;
const es = L !== 'en';
---
<article class="dash-widget" data-widget="cob-cartera" data-title={es ? 'Cartera' : 'Receivables'} data-span="1"><div class="dash-card report-kpi"><span class="kpi-label">{es ? 'POR COBRAR' : 'RECEIVABLES'}</span><strong class="editorial report-kpi-value">{money(D.resumen.totalPorCobrar, 0)}</strong><small>{D.resumen.nPorCobrar} {es ? 'documentos' : 'documents'}</small></div></article>
<article class="dash-widget" data-widget="cob-vencido" data-title={es ? 'Vencido' : 'Overdue'} data-span="1"><div class="dash-card report-kpi"><span class="kpi-label">{es ? 'VENCIDO' : 'OVERDUE'}</span><strong class="editorial report-kpi-value is-danger">{money(D.resumen.totalVencido, 0)}</strong><small>{D.resumen.nVencidas} {es ? 'cuentas' : 'accounts'}</small></div></article>
<article class="dash-widget" data-widget="cob-esperado30" data-title={es ? 'Cobranza esperada' : 'Expected collections'} data-span="1"><div class="dash-card report-kpi"><span class="kpi-label">{es ? 'COBRANZA ESPERADA · 30D' : 'EXPECTED COLLECTIONS · 30D'}</span><strong class="editorial report-kpi-value">{money(D.resumen.esperado30, 0)}</strong><small>{es ? 'cartera cierta, timing estimado' : 'certain receivables, estimated timing'}</small></div></article>
<article class="dash-widget" data-widget="cob-retraso" data-title={es ? 'Retraso medio' : 'Average delay'} data-span="1"><div class="dash-card report-kpi"><span class="kpi-label">{es ? 'RETRASO MEDIO' : 'AVERAGE DELAY'}</span><strong class="editorial report-kpi-value">{D.resumen.avgDelay}<em>d</em></strong><small>{es ? 'contra el plazo pactado' : 'against agreed terms'}</small></div></article>
<article class="dash-widget" data-widget="cob-aging" data-title="Aging" data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">Aging</h2><p>{es ? 'Composición de la cartera por antigüedad.' : 'Receivables composition by age.'}</p></div></div><div class="chart-host report-chart" data-chart="donut" data-slices={JSON.stringify(D.aging.map((row: any) => ({ key: row.key, label: row.label, value: row.monto, color: row.color }))) }></div></div></article>
<article class="dash-widget" data-widget="cob-exposicion" data-title={es ? 'Exposición por cliente' : 'Client exposure'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Exposición por cliente' : 'Client exposure'}</h2><p>{es ? 'Saldo abierto frente al límite configurado.' : 'Open balance against configured limit.'}</p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.clientes.slice(0, 8).map((row: any) => ({ label: row.empresa, value: row.saldo, sub: row.limite ? `${row.uso}%` : '' }))) }></div></div></article>
<article class="dash-widget" data-widget="cob-promesas" data-title={es ? 'Cumplimiento de promesas' : 'Promise compliance'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Cumplimiento de promesas de pago' : 'Payment promise compliance'}</h2><p>{es ? 'Compromisos cerrados como cumplidos frente a incumplidos.' : 'Promises closed as fulfilled versus missed.'}</p></div></div><div class="report-focus"><strong class="editorial">{D.promesas.cumplimientoPct}%</strong><span>{D.promesas.cumplidas} {es ? 'cumplidas' : 'fulfilled'} · {D.promesas.incumplidas} {es ? 'incumplidas' : 'missed'} · {D.promesas.pendientesVencidas} {es ? 'vencidas pendientes' : 'overdue pending'}</span></div></div></article>
<article class="dash-widget" data-widget="cob-histograma" data-title={es ? 'DSO real vs. pactado' : 'Actual vs. agreed DSO'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'DSO real vs. pactado' : 'Actual vs. agreed DSO'}</h2><p>{es ? 'Cuánto se desvía el pago real del plazo acordado.' : 'How actual payment deviates from agreed terms.'}</p></div></div><div class="chart-host report-chart" data-chart="bar" data-format="number" data-items={JSON.stringify(D.payBehavior.histograma.map((row: any) => ({ label: row.label, value: row.n }))) }></div></div></article>
