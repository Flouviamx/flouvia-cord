---
import ChartWidget from '../widgets/ChartWidget.astro';
import MetricWidget from '../widgets/MetricWidget.astro';
import WidgetCard from '../widgets/WidgetCard.astro';
import { money } from '../../../lib/queries';
const { data: D, L } = Astro.props;
const es = L !== 'en';
---
<WidgetCard tone="finance" id="cob-cartera" title={es ? 'Cartera' : 'Receivables'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">{es ? 'POR COBRAR' : 'RECEIVABLES'}</span><strong class="editorial report-kpi-value">{money(D.resumen.totalPorCobrar, 0)}</strong><small>{D.resumen.nPorCobrar} {es ? 'documentos' : 'documents'}</small></WidgetCard>
<WidgetCard tone="finance" id="cob-vencido" title={es ? 'Vencido' : 'Overdue'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">{es ? 'VENCIDO' : 'OVERDUE'}</span><strong class="editorial report-kpi-value is-danger">{money(D.resumen.totalVencido, 0)}</strong><small>{D.resumen.nVencidas} {es ? 'cuentas' : 'accounts'}</small></WidgetCard>
<WidgetCard tone="finance" id="cob-esperado30" title={es ? 'Cobranza esperada' : 'Expected collections'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">{es ? 'COBRANZA ESPERADA · 30D' : 'EXPECTED COLLECTIONS · 30D'}</span><strong class="editorial report-kpi-value">{money(D.resumen.esperado30, 0)}</strong><small>{es ? 'cartera cierta, timing estimado' : 'certain receivables, estimated timing'}</small></WidgetCard>
<WidgetCard tone="finance" id="cob-retraso" title={es ? 'Retraso medio' : 'Average delay'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">{es ? 'RETRASO MEDIO' : 'AVERAGE DELAY'}</span><strong class="editorial report-kpi-value">{D.resumen.avgDelay}<em>d</em></strong><small>{es ? 'contra el plazo pactado' : 'against agreed terms'}</small></WidgetCard>
<WidgetCard tone="finance" id="cob-aging" title="Aging" compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">Aging</h2><p>{es ? 'Composición de la cartera por antigüedad.' : 'Receivables composition by age.'}</p></div></div><div class="chart-host report-chart" data-chart="donut" data-slices={JSON.stringify(D.aging.map((row: any) => ({ key: row.key, label: row.label, value: row.monto, color: row.color }))) } data-empty-icon="money" data-empty-title={es ? 'Sin cartera pendiente' : 'No pending receivables'} data-empty-desc={es ? 'No tienes cuentas por cobrar abiertas.' : 'You have no open receivables.'}></div></WidgetCard>
<ChartWidget tone="finance" id="cob-exposicion" compact={2} expanded={4} title={es ? 'Exposición por cliente' : 'Client exposure'} description={es ? 'Saldo abierto frente al límite configurado.' : 'Open balance against configured limit.'} kind="hbar" data={D.clientes.slice(0, 8).map((row: any) => ({ label: row.empresa, value: row.saldo, sub: row.limite ? `${row.uso}%` : '' }))} emptyTitle={es ? 'Sin exposición por cliente' : 'No client exposure'} emptyIcon="clients"></ChartWidget>
<WidgetCard tone="finance" id="cob-promesas" title={es ? 'Cumplimiento de promesas' : 'Promise compliance'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Cumplimiento de promesas de pago' : 'Payment promise compliance'}</h2><p>{es ? 'Compromisos cerrados como cumplidos frente a incumplidos.' : 'Promises closed as fulfilled versus missed.'}</p></div></div><div class="report-focus"><strong class="editorial">{D.promesas.cumplimientoPct}%</strong><span>{D.promesas.cumplidas} {es ? 'cumplidas' : 'fulfilled'} · {D.promesas.incumplidas} {es ? 'incumplidas' : 'missed'} · {D.promesas.pendientesVencidas} {es ? 'vencidas pendientes' : 'overdue pending'}</span></div></WidgetCard>
<WidgetCard tone="finance" id="cob-histograma" title={es ? 'DSO real vs. pactado' : 'Actual vs. agreed DSO'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'DSO real vs. pactado' : 'Actual vs. agreed DSO'}</h2><p>{es ? 'Cuánto se desvía el pago real del plazo acordado.' : 'How actual payment deviates from agreed terms.'}</p></div></div><div class="chart-host report-chart" data-chart="bar" data-format="number" data-items={JSON.stringify(D.payBehavior.histograma.map((row: any) => ({ label: row.label, value: row.n }))) } data-empty-icon="chart" data-empty-title={es ? 'Sin historial de pagos' : 'No payment history'}></div></WidgetCard>

<MetricWidget id="cob-opcional-documentos" optional tone="finance" title={es ? 'Documentos por cobrar' : 'Outstanding documents'} value={D.resumen.nPorCobrar} description={es ? 'Documentos pendientes de cobro hoy' : 'Documents awaiting collection today'} details={[{label:es ? 'Vencidos' : 'Overdue',value:D.resumen.nVencidas},{label:es ? 'Importe pendiente' : 'Outstanding amount',value:money(D.resumen.totalPorCobrar,0)}]} />
