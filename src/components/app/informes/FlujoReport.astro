---
import { money } from '../../../lib/queries';
const { data: D, L } = Astro.props;
const es = L !== 'en';
const total90 = D.semanas.reduce((sum: number, week: any) => sum + week.total, 0);
const cumulative = D.dias.reduce((rows: any[], day: any) => {
    const previous = rows.at(-1)?.y ?? 0;
    rows.push({ x: day.fecha, y: previous + day.esperado });
    return rows;
}, []);
const max = Math.max(1, ...D.semanas.map((week: any) => week.total));
---
<article class="dash-widget" data-widget="flujo-total" data-title={es ? 'Ingreso esperado' : 'Expected inflow'} data-span="1"><div class="dash-card report-kpi"><span class="kpi-label">{es ? 'PRÓXIMOS 90 DÍAS' : 'NEXT 90 DAYS'}</span><strong class="editorial report-kpi-value">{money(total90, 0)}</strong><small>{es ? 'cartera + pipeline + igualas' : 'receivables + pipeline + retainers'}</small></div></article>
<article class="dash-widget" data-widget="flujo-fuera" data-title={es ? 'Fuera del horizonte' : 'Beyond horizon'} data-span="1"><div class="dash-card report-kpi"><span class="kpi-label">{es ? 'FUERA DEL HORIZONTE' : 'BEYOND HORIZON'}</span><strong class="editorial report-kpi-value">{money(D.fueraDeHorizonte.valorEsperado, 0)}</strong><small>{D.fueraDeHorizonte.n} {es ? 'movimientos desde el día 91' : 'movements from day 91'}</small></div></article>
<article class="dash-widget" data-widget="flujo-mrr" data-title="MRR" data-span="1"><div class="dash-card report-kpi"><span class="kpi-label">MRR</span><strong class="editorial report-kpi-value">{money(D.mrr.activo, 0)}</strong><small>{D.mrr.nIgualas} {es ? 'igualas' : 'retainers'}</small></div></article>
<article class="dash-widget" data-widget="flujo-cartera" data-title={es ? 'Cartera cierta' : 'Certain receivables'} data-span="1"><div class="dash-card report-kpi"><span class="kpi-label">{es ? 'CARTERA CIERTA' : 'CERTAIN RECEIVABLES'}</span><strong class="editorial report-kpi-value">{money(D.kpis.totalCartera, 0)}</strong><small>{es ? 'sin ponderar por cierre' : 'not weighted by close rate'}</small></div></article>
<article class="dash-widget" data-widget="flujo-concentracion" data-title={es ? 'Concentración a 30 días' : '30-day concentration'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Riesgo de concentración · 30 días' : 'Concentration risk · 30 days'}</h2><p>{es ? 'Participación del cliente principal en el flujo esperado inmediato.' : 'Largest client share of near-term expected inflow.'}</p></div><strong class="editorial report-kpi-value">{D.kpis.concentracionFlujo30}%</strong></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.flujo30Clientes.slice(0, 6).map((row: any) => ({ label: row.empresa, value: row.valor }))) }></div></div></article>
<article class="dash-widget" data-widget="flujo-semanas" data-title={es ? 'Flujo semanal' : 'Weekly flow'} data-span="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Flujo semanal · 90 días' : 'Weekly flow · 90 days'}</h2><p>{es ? 'Tres fuentes separadas para no confundir certeza con probabilidad.' : 'Three separate sources to distinguish certainty from probability.'}</p></div><div class="flow-legend"><span class="is-cartera">{es ? 'Cartera' : 'Receivables'}</span><span class="is-pipeline">Pipeline</span><span class="is-mrr">MRR</span></div></div><div class="flow-weeks">{D.semanas.map((week: any) => <div class="flow-week"><span class="flow-week-label">{week.label}</span><div class="flow-week-track" title={money(week.total, 0)}><i class="is-cartera" style={`width:${week.cartera / max * 100}%`}></i><i class="is-pipeline" style={`width:${week.pipeline / max * 100}%`}></i><i class="is-mrr" style={`width:${week.recurrente / max * 100}%`}></i></div><strong class="editorial">{week.total ? money(week.total, 0) : '—'}</strong></div>)}</div></div></article>
<article class="dash-widget" data-widget="flujo-acumulado" data-title={es ? 'Caja acumulada' : 'Cumulative cash'} data-span="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Curva acumulada de caja' : 'Cumulative cash curve'}</h2><p>{es ? 'Suma diaria del escenario esperado.' : 'Daily accumulation of the expected scenario.'}</p></div></div><div class="chart-host report-chart" data-chart="line" data-points={JSON.stringify(cumulative)}></div></div></article>
