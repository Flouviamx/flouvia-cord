---
import ChartWidget from '../widgets/ChartWidget.astro';
import MetricWidget from '../widgets/MetricWidget.astro';
import WidgetCard from '../widgets/WidgetCard.astro';
import { money } from '../../../lib/queries';
const { data: D, L } = Astro.props;
const es = L !== 'en';
const pct = (a: number, b: number) => b ? Math.round((a / b) * 100) : 0;
const lost = D.losses.rejected.monto + D.losses.expired.monto;
const maturity = D.summary.sent ? {
    won: pct(D.summary.approved, D.summary.sent),
    lost: pct(D.losses.rejected.n + D.losses.expired.n, D.summary.sent),
} : { won: 0, lost: 0 };
const open = Math.max(0, 100 - maturity.won - maturity.lost);
---
<WidgetCard tone="commercial" id="resumen-cierre" title={es ? 'Tasa de cierre' : 'Close rate'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">{es ? 'TASA DE CIERRE' : 'CLOSE RATE'}</span><strong class="editorial report-kpi-value" data-report-bind="close-rate">{pct(D.summary.approved, D.summary.sent)}%</strong><small data-report-bind="close-rate-sub">{D.summary.approved} / {D.summary.sent} {es ? 'cotizaciones enviadas' : 'sent quotes'}</small></WidgetCard>
<WidgetCard tone="commercial" id="resumen-cerrado" title={es ? 'Valor cerrado' : 'Closed value'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">{es ? 'VALOR CERRADO' : 'CLOSED VALUE'}</span><strong class="editorial report-kpi-value" data-report-bind="closed">{money(D.summary.cerrado, 0)}</strong><small>{es ? 'Cohorte creada en el rango' : 'Cohort created in range'}</small></WidgetCard>
<WidgetCard tone="commercial" id="resumen-velocidad" title={es ? 'Velocidad del pipeline' : 'Pipeline velocity'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">{es ? 'VELOCIDAD DEL PIPELINE' : 'PIPELINE VELOCITY'}</span><strong class="editorial report-kpi-value" data-report-bind="velocity">{money(D.summary.cerrado / Math.max(1, D.series.length), 0)}</strong><small>{es ? 'cerrado por día del rango' : 'closed per range day'}</small></WidgetCard>
<WidgetCard tone="commercial" id="resumen-riesgo" title={es ? 'Valor perdido' : 'Lost value'} compact={1} expanded={2} contentClass="report-kpi"><span class="kpi-label">{es ? 'VALOR PERDIDO' : 'LOST VALUE'}</span><strong class="editorial report-kpi-value is-danger" data-report-bind="lost">{money(lost, 0)}</strong><small data-report-bind="lost-sub">{D.losses.rejected.n + D.losses.expired.n} {es ? 'cotizaciones' : 'quotes'}</small></WidgetCard>
<ChartWidget tone="commercial" id="resumen-evolucion" compact={2} expanded={4} title={es ? 'Movimiento comercial' : 'Commercial movement'} description={es ? 'Valor cerrado por fecha de origen de la cotización.' : 'Closed value by quote creation date.'} kind="line" data={D.series.map((day: any) => ({ x: day.fecha, y: day.cerrado }))} emptyTitle={es ? 'Sin cierres en este rango' : 'No closings in this range'} emptyDescription={es ? 'Ajusta el rango de fechas o revisa cuando tengas cotizaciones cerradas.' : 'Adjust the date range or check back once you have closed quotes.'} emptyIcon="chart"></ChartWidget>
<ChartWidget tone="commercial" id="resumen-madurez" compact={2} expanded={4} title={es ? 'Madurez de la cohorte' : 'Cohort maturity'} description={es ? 'Qué pasó con lo cotizado dentro del rango.' : 'What happened to quotes created in range.'} kind="segbar" data={!D.summary.sent ? [] : [{ key: 'won', label: es ? 'Ganado' : 'Won', value: maturity.won, color: '#059669' }, { key: 'lost', label: es ? 'Perdido' : 'Lost', value: maturity.lost, color: '#ef4444' }, { key: 'open', label: es ? 'Aún abierto' : 'Still open', value: open, color: '#8b95a5' }]} format="pct" emptyTitle={es ? 'Sin cotizaciones en este rango' : 'No quotes in this range'} emptyIcon="funnel"><p class="report-explain">{es ? 'Un rango reciente puede tener poco cierre porque la cohorte todavía no madura; no necesariamente porque esté rindiendo mal.' : 'A recent range may show little closing because its cohort has not matured yet, not because it is underperforming.'}</p></ChartWidget>

<MetricWidget id="resumen-opcional-decididas" optional title={es ? 'Cotizaciones decididas' : 'Decided quotes'} value={D.summary.approved + D.losses.rejected.n + D.losses.expired.n} description={es ? 'Ganadas, rechazadas o vencidas de la cohorte' : 'Won, rejected or expired in the cohort'} details={[{label:es ? 'Ganadas' : 'Won',value:D.summary.approved},{label:es ? 'Rechazadas' : 'Rejected',value:D.losses.rejected.n},{label:es ? 'Vencidas' : 'Expired',value:D.losses.expired.n}]} />
