---
import { money } from '../../../lib/queries';
const { data: D, L } = Astro.props;
const es = L !== 'en';
const funnel = [
    { label: es ? 'Enviadas' : 'Sent', value: D.funnel.sent },
    { label: es ? 'Vistas' : 'Viewed', value: D.funnel.views },
    { label: es ? 'Aprobadas' : 'Approved', value: D.funnel.approved },
    { label: es ? 'Pagadas' : 'Paid', value: D.funnel.paid },
];
---
<article class="dash-widget" data-widget="comercial-embudo" data-title={es ? 'Embudo' : 'Funnel'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Dónde se rompe la conversión' : 'Where conversion breaks'}</h2><p>{es ? 'La base incluye toda cotización que salió, aunque terminara rechazada o vencida.' : 'The base includes every quote that went out, even if rejected or expired.'}</p></div></div><div class="chart-host report-chart" data-chart="funnel" data-steps={JSON.stringify(funnel)} data-format="number"></div></div></article>
<article class="dash-widget" data-widget="comercial-pipeline" data-title="Pipeline" data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">Pipeline</h2><p>{es ? 'Foto de hoy por etapa.' : 'Today’s snapshot by stage.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="chart-host report-chart" data-chart="bar" data-items={JSON.stringify(D.pipeline.map((row: any) => ({ label: row.key, value: row.monto, sub: `${row.n}` }))) }></div></div></article>
<article class="dash-widget" data-widget="comercial-detenidas" data-title={es ? 'Detenidas' : 'Stalled'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Cotizaciones que necesitan movimiento' : 'Quotes that need a next move'}</h2><p>{es ? 'Sin actividad durante siete días o más.' : 'No activity for seven days or more.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="report-list">{D.stalled.length ? D.stalled.map((row: any) => <a href={`/app/cotizaciones/${row.id}`}><span><strong>{row.empresa}</strong><small>{row.folio} · {row.dias}d</small></span><b class="editorial">{money(row.total, 0)}</b></a>) : <p class="report-empty">{es ? 'No hay seguimientos detenidos.' : 'No stalled follow-ups.'}</p>}</div></div></article>
<article class="dash-widget" data-widget="comercial-descuento" data-title={es ? 'Costo de negociación' : 'Negotiation cost'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Costo de la negociación' : 'Negotiation cost'}</h2><p>{es ? 'Productos que más valor han cedido.' : 'Products that have conceded the most value.'}</p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.discounts.map((row: any) => ({ label: row.nombre, value: row.cedido, sub: `${Math.round(row.pct)}%` }))) }></div></div></article>
<article class="dash-widget" data-widget="comercial-tiempo-etapa" data-title={es ? 'Tiempo por etapa' : 'Time by stage'} data-span="2"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Tiempo mediano por etapa' : 'Median time by stage'}</h2><p>{es ? 'La mediana evita que unos pocos casos extremos distorsionen el ciclo.' : 'The median keeps a few outliers from distorting the cycle.'}</p></div></div><div class="chart-host report-chart" data-chart="bar" data-format="number" data-items={JSON.stringify(D.stageTiming.map((row: any) => ({ label: row.label, value: row.dias, sub: es ? 'días' : 'days' }))) }></div></div></article>
