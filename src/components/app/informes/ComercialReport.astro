---
import ChartWidget from '../widgets/ChartWidget.astro';
import MetricWidget from '../widgets/MetricWidget.astro';
import WidgetCard from '../widgets/WidgetCard.astro';
import { money } from '../../../lib/queries';
import { t } from '../../../i18n/app';
const { data: D, L } = Astro.props;
const es = L !== 'en';
const funnel = [
    { label: es ? 'Enviadas' : 'Sent', value: D.funnel.sent },
    { label: es ? 'Vistas' : 'Viewed', value: D.funnel.views },
    { label: es ? 'Aprobadas' : 'Approved', value: D.funnel.approved },
    { label: es ? 'Pagadas' : 'Paid', value: D.funnel.paid },
];
---
<ChartWidget tone="commercial" id="comercial-embudo" compact={2} expanded={4} title={es ? 'Dónde se rompe la conversión' : 'Where conversion breaks'} description={es ? 'La base incluye toda cotización que salió, aunque terminara rechazada o vencida.' : 'The base includes every quote that went out, even if rejected or expired.'} kind="funnel" data={funnel} format="number" emptyTitle={es ? 'Sin envíos en este rango' : 'No sends in this range'} emptyDescription={es ? 'El embudo aparece en cuanto envíes tu primera cotización del periodo.' : 'The funnel appears once you send your first quote for the period.'} emptyIcon="funnel"></ChartWidget>
<WidgetCard tone="commercial" id="comercial-pipeline" title="Pipeline" compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">Pipeline</h2><p>{es ? 'Foto de hoy por etapa.' : 'Today’s snapshot by stage.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="chart-host report-chart" data-chart="bar" data-items={JSON.stringify(D.pipeline.map((row: any) => ({ label: t(L, `cot.col.${row.key}` as any), value: row.monto, sub: `${row.n}` }))) } data-empty-icon="chart" data-empty-title={es ? 'Pipeline vacío hoy' : 'Pipeline is empty today'} data-empty-desc={es ? 'No hay cotizaciones abiertas en ninguna etapa.' : 'No open quotes in any stage.'}></div></WidgetCard>
<WidgetCard tone="commercial" id="comercial-detenidas" title={es ? 'Detenidas' : 'Stalled'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Cotizaciones que necesitan movimiento' : 'Quotes that need a next move'}</h2><p>{es ? 'Sin actividad durante siete días o más.' : 'No activity for seven days or more.'}<span class="snapshot-tag">{es ? 'hoy' : 'today'}</span></p></div></div><div class="report-list">{D.stalled.length ? D.stalled.map((row: any) => <a href={`/app/cotizaciones/${row.id}`}><span><strong>{row.empresa}</strong><small>{row.folio} · {row.dias}d</small></span><b class="editorial">{money(row.total, 0)}</b></a>) : <p class="report-empty">{es ? 'No hay seguimientos detenidos.' : 'No stalled follow-ups.'}</p>}</div></WidgetCard>
<WidgetCard tone="commercial" id="comercial-descuento" title={es ? 'Costo de negociación' : 'Negotiation cost'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Costo de la negociación' : 'Negotiation cost'}</h2><p>{es ? 'Productos que más valor han cedido.' : 'Products that have conceded the most value.'}</p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.discounts.map((row: any) => ({ label: row.nombre, value: row.cedido, sub: `${Math.round(row.pct)}%` }))) } data-empty-icon="money" data-empty-title={es ? 'Sin descuentos registrados' : 'No discounts recorded'}></div></WidgetCard>
<ChartWidget tone="commercial" id="comercial-tiempo-etapa" compact={2} expanded={4} title={es ? 'Tiempo mediano por etapa' : 'Median time by stage'} description={es ? 'La mediana evita que unos pocos casos extremos distorsionen el ciclo.' : 'The median keeps a few outliers from distorting the cycle.'} kind="bar" data={D.stageTiming.map((row: any) => ({ label: t(L, `inf.etapa.${row.key}` as any), value: row.dias, sub: es ? 'días' : 'days' }))} format="number" emptyTitle={es ? 'Aún sin datos de tiempo' : 'No timing data yet'} emptyIcon="calendar"></ChartWidget>

<MetricWidget id="comercial-opcional-atencion" optional title={es ? 'Seguimientos detenidos' : 'Stalled follow-ups'} value={D.stalled.length} description={es ? 'Cotizaciones sin actividad durante siete días o más' : 'Quotes inactive for seven days or more'} />
