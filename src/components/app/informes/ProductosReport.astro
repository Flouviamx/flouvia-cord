---
import { money } from '../../../lib/queries';
import WidgetEmpty from '../WidgetEmpty.astro';
const { data: D, L } = Astro.props;
const es = L !== 'en';
---
<article class="dash-widget" data-widget="productos-importe" data-title={es ? 'Productos por importe' : 'Products by amount'} data-span="2" data-size-sm="2" data-size-lg="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Productos por importe cotizado' : 'Products by quoted amount'}</h2><p>{es ? 'Demanda dentro del rango elegido.' : 'Demand inside the selected range.'}</p></div></div><div class="chart-host report-chart" data-chart="hbar" data-items={JSON.stringify(D.productos.map((row: any) => ({ label: row.nombre, value: row.importe, sub: `${row.cotizaciones}` }))) } data-empty-icon="products" data-empty-title={es ? 'Sin productos cotizados' : 'No quoted products'}></div></div></article>
<article class="dash-widget" data-widget="productos-volumen" data-title={es ? 'Volumen por producto' : 'Product volume'} data-span="2" data-size-sm="2" data-size-lg="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Volumen por producto' : 'Product volume'}</h2><p>{es ? 'Unidades cotizadas y presencia en propuestas.' : 'Quoted units and proposal presence.'}</p></div></div><div class="report-list">{D.productos.length ? D.productos.map((row: any) => <div><span><strong>{row.nombre}</strong><small>{row.cotizaciones} {es ? 'cotizaciones' : 'quotes'}</small></span><b class="editorial">{row.cantidad} · {money(row.importe, 0)}</b></div>) : <WidgetEmpty icon="products" title={es ? 'Sin volumen registrado' : 'No volume recorded'} />}</div></div></article>
<article class="dash-widget" data-widget="productos-elasticidad" data-title={es ? 'Elasticidad del descuento' : 'Discount elasticity'} data-span="2" data-size-sm="2" data-size-lg="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Curva de elasticidad del descuento' : 'Discount elasticity curve'}</h2><p>{es ? 'Tasa de cierre por banda; reutiliza el motor de pricing del editor.' : 'Close rate by band, using the editor pricing engine.'}</p></div></div><div class="chart-host report-chart" data-chart="bar" data-format="pct" data-items={JSON.stringify(D.pricingBands.map((row: any) => ({ label: `${row.band}%`, value: row.winRate * 100, sub: `n=${row.sample}` }))) } data-empty-icon="products" data-empty-title={es ? 'Sin datos de elasticidad' : 'No elasticity data'}></div></div></article>
<article class="dash-widget" data-widget="productos-cierre" data-title={es ? 'Cierre por producto' : 'Close rate by product'} data-span="2" data-size-sm="2" data-size-lg="4"><div class="dash-card"><div class="sec-head"><div><h2 class="sec-title">{es ? 'Tasa de cierre por producto' : 'Close rate by product'}</h2><p>{es ? 'Qué productos ganan, no solo cuáles se cotizan.' : 'Which products win, not only which are quoted.'}</p></div></div><div class="chart-host report-chart" data-chart="hbar" data-format="pct" data-items={JSON.stringify(D.cierre.map((row: any) => ({ label: row.nombre, value: row.tasa, sub: `n=${row.decididas}` }))) } data-empty-icon="products" data-empty-title={es ? 'Sin tasa de cierre por producto' : 'No close rate by product'}></div></div></article>
