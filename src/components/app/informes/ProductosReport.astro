---
import ChartWidget from '../widgets/ChartWidget.astro';
import WidgetCard from '../widgets/WidgetCard.astro';
import { money } from '../../../lib/queries';
import ListWidget from '../widgets/ListWidget.astro';
const { data: D, L } = Astro.props;
const es = L !== 'en';
---
<ChartWidget tone="commercial" id="productos-importe" compact={2} expanded={4} title={es ? 'Productos por importe cotizado' : 'Products by quoted amount'} description={es ? 'Demanda dentro del rango elegido.' : 'Demand inside the selected range.'} kind="hbar" data={D.productos.map((row: any) => ({ label: row.nombre, value: row.importe, sub: `${row.cotizaciones}` }))} emptyTitle={es ? 'Sin productos cotizados' : 'No quoted products'} emptyIcon="products"></ChartWidget>
<ListWidget id="productos-volumen" tone="commercial" title={es ? 'Volumen por producto' : 'Product volume'} description={es ? 'Unidades cotizadas y presencia en propuestas.' : 'Quoted units and proposal presence.'}
    rows={D.productos.map((row: any) => ({title:row.nombre,subtitle:`${row.cotizaciones} ${es ? 'cotizaciones' : 'quotes'}`,value:`${row.cantidad} · ${money(row.importe,0)}`}))}
    emptyTitle={es ? 'Sin volumen registrado' : 'No volume recorded'} />
<WidgetCard tone="commercial" id="productos-elasticidad" title={es ? 'Elasticidad del descuento' : 'Discount elasticity'} compact={2} expanded={4}><div class="sec-head"><div><h2 class="sec-title">{es ? 'Curva de elasticidad del descuento' : 'Discount elasticity curve'}</h2><p>{es ? 'Tasa de cierre por banda; reutiliza el motor de pricing del editor.' : 'Close rate by band, using the editor pricing engine.'}</p></div></div><div class="chart-host report-chart" data-chart="bar" data-format="pct" data-items={JSON.stringify(D.pricingBands.map((row: any) => ({ label: `${row.band}%`, value: row.winRate * 100, sub: `n=${row.sample}` }))) } data-empty-icon="products" data-empty-title={es ? 'Sin datos de elasticidad' : 'No elasticity data'}></div></WidgetCard>
<ChartWidget tone="commercial" id="productos-cierre" compact={2} expanded={4} title={es ? 'Tasa de cierre por producto' : 'Close rate by product'} description={es ? 'Qué productos ganan, no solo cuáles se cotizan.' : 'Which products win, not only which are quoted.'} kind="hbar" data={D.cierre.map((row: any) => ({ label: row.nombre, value: row.tasa, sub: `n=${row.decididas}` }))} format="pct" emptyTitle={es ? 'Sin tasa de cierre por producto' : 'No close rate by product'} emptyIcon="products"></ChartWidget>

<ChartWidget id="productos-opcional-unidades" optional title={es ? 'Unidades por producto' : 'Units by product'} description={es ? 'Cantidad cotizada en el rango seleccionado' : 'Quoted units in the selected range'} kind="bar" format="number" data={D.productos.map((row: any) => ({label:row.nombre,value:row.cantidad}))} emptyTitle={es ? 'Sin unidades cotizadas' : 'No quoted units'} />
