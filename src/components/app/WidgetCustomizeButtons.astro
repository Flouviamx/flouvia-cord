---
// Los tres botones que gobiernan el modo de edición de un WidgetGrid:
// Personalizar → Biblioteca · Restablecer · Listo. En modo edición los tres
// son botones redondos de icono (con aria-label y tooltip), idénticos en toda la app.
//
// WidgetGrid NO los renderiza a propósito (solo recibe sus ids y les alterna
// `hidden`), así que cada una de las cinco páginas con widgets autoraba su
// propio markup y su propio CSS: `dash-`, `reports-`, `cbr-`, `cbz-`, `cia-`.
// Solo el dashboard llevaba ícono, informes pintaba "Personalizar" en azul
// sólido con los textos hardcodeados, y agente ni siquiera tenía la regla de
// rescate `[hidden]`. Este componente es el markup ÚNICO; su CSS vive en
// `src/styles/widgets.css` porque un `<style>` scopeado de la página anfitriona
// no alcanza al markup que renderiza otro componente (regla 11).
import { currentLocale } from '../../lib/context';
import { t } from '../../i18n/app';

interface Props {
    /** ids que se le pasan al WidgetGrid correspondiente. */
    editId: string;
    resetId: string;
    doneId: string;
}

const { editId, resetId, doneId } = Astro.props;
const L = currentLocale();
import { iconInner } from '../../lib/icons';
---

<button type="button" class="widget-edit-btn is-customize" id={editId}>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('sliders')}></svg>
    <span>{t(L, 'widgets.personalizar')}</span>
</button>
<button type="button" class="widget-edit-btn is-icon" id={`${editId}Library`} aria-expanded="false" aria-label={t(L, 'widgets.biblioteca')} data-tip={t(L, 'widgets.biblioteca')} hidden>
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('grid-plus')}></svg>
</button>
<button type="button" class="widget-edit-btn is-icon" id={resetId} aria-label={t(L, 'widgets.restablecer')} data-tip={t(L, 'widgets.restablecer')} hidden>
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('undo')}></svg>
</button>
<button type="button" class="widget-edit-btn is-icon is-done" id={doneId} aria-label={t(L, 'widgets.listo')} data-tip={t(L, 'widgets.listo')} hidden>
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('check')}></svg>
</button>
