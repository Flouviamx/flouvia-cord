---
// SettingsShell — chasis de las sub-páginas de Ajustes (estilo Stripe).
// Encabezado "Configuración › Categoría" + BARRA DE PESTAÑAS horizontal de la
// categoría (NO rail lateral) + contenido. Si `save`, pinta la barra de guardar
// y corre el guardado genérico que lee los [data-field] → PATCH /api/org.
// Si `perm` está presente, verifica el permiso del usuario y muestra acceso
// denegado inline (sin redirigir) si no lo tiene.
import '../../styles/settings.css';
import SettingsSaveFooter from './SettingsSaveFooter.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import AccessGate from './AccessGate.astro';
import { localizedCategoryOfTab } from '../../lib/settings';
import { getMyMembership, getOrg } from '../../lib/queries';
import { memberCan, type PermKey } from '../../lib/permissions';
import { currentLocale } from '../../lib/context';
import { t } from '../../i18n/app';

interface Props {
    title: string;       // título del documento
    tab: string;         // id de la pestaña activa (deriva la categoría)
    intro?: string;      // bajada opcional bajo las pestañas
    save?: boolean;      // ¿barra de guardar + guardado genérico?
    perm?: PermKey;      // permiso requerido para ver el contenido
}
const { title, tab, intro, save = false, perm } = Astro.props;
const L = currentLocale();
const ORG = await getOrg();
const category = localizedCategoryOfTab(tab, L, ORG.countryCode)!;
const single = category.tabs.length <= 1;
// Puede ser undefined en una sub-ruta que reusa el `tab` de su padre
// (p. ej. /app/ajustes/sso/[id] pasa tab="sso"); la miga simplemente no
// muestra el último nivel en ese caso.
const activeTab = category.tabs.find((tb) => tb.id === tab);

const ME = perm ? await getMyMembership() : null;
const hasAccess = !perm || memberCan(ME!, perm);
import { iconInner } from '../../lib/icons';
---

{/* El título visible es "Ajustes"/"Settings" (antes fijo en español) y el
    fijado se nombra como en ⌘K: "Ajustes · Impuestos". Sin esto, toda pestaña
    fijada salía como "Ajustes" y no se distinguía de las demás. */}
<AppLayout title={title} page="ajustes" heading={t(L, 'topbar.ajustes')}
           pinLabel={`${t(L, 'topbar.ajustes')} · ${activeTab?.label ?? category.label}`}>
    <div class="set2">
        {/* La miga incluye la PESTAÑA actual, no sólo "Configuración". El <h2>
            de abajo muestra la CATEGORÍA, así que estando en Impuestos la
            página entera decía "Cotizaciones" y el nombre real sólo aparecía
            en la pestaña activa. Con la ruta completa la página se identifica
            sola. Se omite cuando la categoría tiene una sola pestaña: ahí el
            <h2> ya la nombra y repetirla sería ruido. */}
        <nav class="set2-crumb-row" aria-label={t(L, 'settings.configuracion')}>
            <a href="/app/ajustes" class="set2-crumb">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('chevron-left')}></svg>
                {t(L, 'settings.configuracion')}
            </a>
            {!single && activeTab && (
                <>
                    <span class="set2-crumb-sep" aria-hidden="true">/</span>
                    <span class="set2-crumb-here">{activeTab.label}</span>
                </>
            )}
        </nav>
        <header class="set2-heading">
            <span class="set2-category-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={category.icon}/></span>
            <div><h2 class="set2-title">{category.label}</h2><p class="set2-desc">{category.desc}</p></div>
        </header>

        {!single && (
            <nav class="set2-tabs-row" aria-label={t(L, 'settings.pestanas_de').replace('{label}', category.label)}>
                <div class="set2-tabs">
                    {category.tabs.map((tb) => (
                        <a href={tb.href} class:list={['set2-tab', { active: tb.id === tab }]} aria-current={tb.id === tab ? 'page' : undefined}>{tb.label}</a>
                    ))}
                </div>
            </nav>
        )}

        <div class="set2-content" data-settings-form>
            {!hasAccess && (
                <AccessGate class="is-inset" title={t(L, 'settings.sin_acceso')} desc={t(L, 'settings.sin_acceso_desc')} />
            )}
            {hasAccess && intro && <p class="set2-intro">{intro}</p>}
            {hasAccess && <slot />}
            {hasAccess && save && (
                <SettingsSaveFooter buttonId="sBtn" messageId="sMsg" />
            )}
        </div>
    </div>
</AppLayout>



<script>
    import { initSettingsForm } from '../../lib/settings-form';
    import { setSaveState } from '../../lib/settings-save-feedback';
    // Guardado genérico de Ajustes: junta todos los [data-field] del formulario
    // y los manda a PATCH /api/org (que solo toca los campos presentes).
    // Feedback compartido: carga durante fetch, check en éxito y mensaje en error.
    function initSettingsSave() {
        const btn = document.getElementById('sBtn') as HTMLButtonElement | null;
        const msg = document.getElementById('sMsg');
        const form = document.querySelector('[data-settings-form]');
        if (!btn || !msg || !form) return;

        const cp = document.getElementById('oColorPick') as HTMLInputElement | null;
        const ct = document.getElementById('oColor') as HTMLInputElement | null;
        if (cp && ct) {
            cp.addEventListener('input', () => { ct.value = cp.value; ct.dispatchEvent(new Event('input', { bubbles: true })); });
            ct.addEventListener('input', () => { if (/^#[0-9a-fA-F]{6}$/.test(ct.value)) cp.value = ct.value; });
        }

        // ── Detección de cambios sin guardar (estilo Stripe) ──
        // Serializa los [data-field]; si difiere del snapshot inicial, la barra
        // entra en estado "dirty" (botón resaltado + aviso al salir de la página).
        const serialize = () => {
            const state: Record<string, unknown> = {};
            form.querySelectorAll('[data-field]').forEach((node) => {
                const el = node as HTMLInputElement;
                const k = el.dataset.field!;
                if (el.type === 'checkbox') state[k] = el.checked;
                else if (el.type === 'radio') { if (el.checked) state[k] = el.value; }
                else state[k] = el.value;
            });
            return JSON.stringify(state);
        };
        let baseline = serialize();
        let dirty = false;
        const syncDirty = () => {
            const now = serialize() !== baseline;
            if (now === dirty) return;
            dirty = now;
            btn.classList.toggle('dirty', dirty);
        };
        form.addEventListener('input', syncDirty);
        form.addEventListener('change', syncDirty);


        // ⌘S / Ctrl+S guarda (en vez del "Guardar página" del navegador).
        window.addEventListener('keydown', (e) => {
            if (window.matchMedia('(max-width: 880px)').matches) return;
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') {
                e.preventDefault();
                if (!btn.disabled) btn.click();
            }
        });

        btn.addEventListener('click', async () => {
            if (btn.disabled) return;
            if (Array.from(form.querySelectorAll<HTMLInputElement>('[data-field]')).some((field) => !field.reportValidity())) return;
            const submitted = serialize();
            const previous = JSON.parse(baseline);
            const body: Record<string, unknown> = {};
            form.querySelectorAll('[data-field]').forEach((node) => {
                const el = node as HTMLInputElement;
                const k = el.dataset.field!;
                if (el.disabled) return;
                if (el.type === 'checkbox') body[k] = el.checked;
                else if (el.type === 'radio') { if (el.checked) body[k] = el.value; }
                else body[k] = el.value;
            });

            for (const key of Object.keys(body)) if (body[key] === previous[key]) delete body[key];
            if (!Object.keys(body).length) return;
            setSaveState(btn, 'saving');

            try {
                const send = () => fetch('/api/org', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                let res = await send();
                if (res.status === 428 && typeof (window as any).cordStepUp === 'function') {
                    const confirmed = await (window as any).cordStepUp();
                    if (!confirmed) throw new Error('Necesitas confirmar tu identidad para guardar este cambio');
                    res = await send();
                }
                const d = await res.json();
                if (!res.ok) {
                    const field = Array.from(form.querySelectorAll<HTMLInputElement>('[data-field]')).find(f=>f.dataset.field===d.field);
                    if(field){field.setCustomValidity(d.error);field.reportValidity();field.addEventListener('input',()=>field.setCustomValidity(''),{once:true});}
                    throw new Error(d.error || btn.dataset.i18nErr || 'No se pudo guardar');
                }

                baseline = submitted;
                syncDirty();
                setSaveState(btn, 'saved');
                document.dispatchEvent(new CustomEvent('cord:settings-saved', { detail: body }));

            } catch (err: any) {
                setSaveState(btn, 'error', err.message || btn.dataset.i18nErr);
            }
        });
    }
    const init=()=>{initSettingsForm();initSettingsSave();};
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
</script>
