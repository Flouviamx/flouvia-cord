---
import WidgetEditButtons from './WidgetEditButtons.astro';

interface Props {
    id?: string;
    storageKey: string;
    class?: string;
    editButtonId?: string;
    doneButtonId?: string;
    resetButtonId?: string;
    trayTitle: string;
    resetConfirm: string;
    labels: { drag: string; up: string; down: string; resize: string; remove: string };
}
const {
    id, storageKey, class: className, editButtonId = '', doneButtonId = '', resetButtonId = '',
    trayTitle, resetConfirm, labels,
} = Astro.props;
---
<div
    id={id}
    class={className}
    data-widget-grid
    data-storage-key={storageKey}
    data-edit-button={editButtonId}
    data-done-button={doneButtonId}
    data-reset-button={resetButtonId}
    data-reset-confirm={resetConfirm}
>
    <slot />
    <section class="dash-card widget-tray" data-widget-tray hidden>
        <p class="widget-tray-title">{trayTitle}</p>
        <div class="widget-tray-list" data-widget-tray-list></div>
    </section>
    <WidgetEditButtons {...labels} />
</div>
<script is:inline>
    // Pre-paint sincronico. La clave siempre sale del dataset del grid, nunca
    // queda hardcodeada en el componente ni en el modulo interactivo.
    (function () {
        var host = document.currentScript && document.currentScript.previousElementSibling;
        if (!host || !host.matches('[data-widget-grid]')) return;
        try {
            var raw = JSON.parse(localStorage.getItem(host.dataset.storageKey) || '{}');
            var order = Array.isArray(raw.order) ? raw.order : [];
            var hidden = Array.isArray(raw.hidden) ? raw.hidden : [];
            var sizes = raw.sizes && typeof raw.sizes === 'object' ? raw.sizes : {};
            var widgets = Array.prototype.slice.call(host.querySelectorAll('[data-widget]')).filter(function (w) { return w.closest('[data-widget-grid]') === host; });
            var byId = {};
            widgets.forEach(function (w) { byId[w.dataset.widget] = w; });
            var finalOrder = order.filter(function (widgetId) { return byId[widgetId]; });
            widgets.forEach(function (w) { if (finalOrder.indexOf(w.dataset.widget) === -1) finalOrder.push(w.dataset.widget); });
            var rank = {}; finalOrder.forEach(function (widgetId, index) { rank[widgetId] = index; });
            var parents = [];
            widgets.forEach(function (w) { if (parents.indexOf(w.parentElement) === -1) parents.push(w.parentElement); });
            parents.forEach(function (parent) {
                widgets.filter(function (w) { return w.parentElement === parent; })
                    .sort(function (a, b) { return rank[a.dataset.widget] - rank[b.dataset.widget]; })
                    .forEach(function (w) { parent.appendChild(w); });
            });
            hidden.forEach(function (widgetId) { if (byId[widgetId]) byId[widgetId].hidden = true; });
            Object.keys(sizes).forEach(function (widgetId) {
                var w = byId[widgetId]; if (!w) return;
                var span = sizes[widgetId] === 'lg' ? w.dataset.sizeLg : w.dataset.sizeSm;
                if (span) w.dataset.span = span;
            });
        } catch (e) {}
    })();
</script>

<script>
    type Prefs = { order: string[]; hidden: string[]; sizes: Record<string, 'sm' | 'lg'> };

    function mountGrid(host: HTMLElement) {
        if (host.dataset.widgetReady === '1') return;
        host.dataset.widgetReady = '1';
        const key = host.dataset.storageKey || '';
        const tray = host.querySelector<HTMLElement>('[data-widget-tray]');
        const trayList = host.querySelector<HTMLElement>('[data-widget-tray-list]');
        const template = host.querySelector<HTMLTemplateElement>('[data-widget-edit-template]');
        const editButton = document.getElementById(host.dataset.editButton || '');
        const doneButton = document.getElementById(host.dataset.doneButton || '');
        const resetButton = document.getElementById(host.dataset.resetButton || '');
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const widgets = () => Array.from(host.querySelectorAll<HTMLElement>('[data-widget]'))
            .filter((el) => el.closest('[data-widget-grid]') === host);
        const getPrefs = (): Prefs => {
            try {
                const value = JSON.parse(localStorage.getItem(key) || '{}');
                return { order: Array.isArray(value.order) ? value.order : [], hidden: Array.isArray(value.hidden) ? value.hidden : [], sizes: value.sizes && typeof value.sizes === 'object' ? value.sizes : {} };
            } catch { return { order: [], hidden: [], sizes: {} }; }
        };
        const setPrefs = (prefs: Prefs) => { try { localStorage.setItem(key, JSON.stringify(prefs)); } catch {} };
        const persistOrder = () => { const prefs = getPrefs(); prefs.order = widgets().map((w) => w.dataset.widget!); setPrefs(prefs); };

        widgets().forEach((widget) => {
            if (!widget.querySelector('.widget-editbar') && template) widget.prepend(template.content.cloneNode(true));
        });
        template?.remove();

        function flip(mutate: () => void) {
            const visible = widgets().filter((w) => !w.hidden);
            const first = new Map(visible.map((w) => [w, w.getBoundingClientRect()] as const));
            mutate();
            if (reduceMotion) return;
            requestAnimationFrame(() => widgets().filter((w) => !w.hidden).forEach((w) => {
                const before = first.get(w); if (!before) return;
                const after = w.getBoundingClientRect();
                const x = before.left - after.left, y = before.top - after.top;
                if (!x && !y) return;
                w.style.transition = 'none'; w.style.transform = `translate(${x}px, ${y}px)`; w.getBoundingClientRect();
                w.style.transition = 'transform .32s var(--ease-spring)'; w.style.transform = '';
                w.addEventListener('transitionend', () => { w.style.transition = ''; }, { once: true });
            }));
        }
        function renderTray() {
            if (!tray || !trayList) return;
            const prefs = getPrefs();
            const hidden = widgets().filter((w) => prefs.hidden.includes(w.dataset.widget!));
            tray.hidden = hidden.length === 0; trayList.innerHTML = '';
            hidden.forEach((w) => {
                const item = document.createElement('div'); item.className = 'widget-tray-item';
                const label = document.createElement('span'); label.textContent = w.dataset.title || w.dataset.widget || '';
                const add = document.createElement('button'); add.type = 'button'; add.className = 'widget-tray-add'; add.textContent = '+'; add.setAttribute('aria-label', label.textContent || '');
                add.addEventListener('click', () => setHidden(w.dataset.widget!, false)); item.append(label, add); trayList.appendChild(item);
            });
        }
        function setHidden(id: string, hidden: boolean) {
            const prefs = getPrefs();
            prefs.hidden = hidden ? [...new Set([...prefs.hidden, id])] : prefs.hidden.filter((value) => value !== id);
            setPrefs(prefs); const widget = widgets().find((w) => w.dataset.widget === id); if (widget) widget.hidden = hidden; renderTray();
        }
        function enterEdit() { host.dataset.editing = '1'; renderTray(); if (editButton) editButton.hidden = true; if (doneButton) doneButton.hidden = false; if (resetButton) resetButton.hidden = false; }
        function exitEdit() { delete host.dataset.editing; if (tray) tray.hidden = true; if (editButton) editButton.hidden = false; if (doneButton) doneButton.hidden = true; if (resetButton) resetButton.hidden = true; }
        editButton?.addEventListener('click', enterEdit); doneButton?.addEventListener('click', exitEdit);
        document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && host.dataset.editing === '1') exitEdit(); });
        resetButton?.addEventListener('click', async () => {
            const confirmFn = (window as any).cordConfirm;
            const ok = confirmFn ? await confirmFn(host.dataset.resetConfirm || '') : confirm(host.dataset.resetConfirm || '');
            if (!ok) return; setPrefs({ order: [], hidden: [], sizes: {} }); location.reload();
        });

        widgets().forEach((widget) => {
            const id = widget.dataset.widget!;
            widget.querySelector('.we-up')?.addEventListener('click', (event) => { event.stopPropagation(); const previous = widget.previousElementSibling; if (previous instanceof HTMLElement && previous.dataset.widget) flip(() => { widget.parentElement?.insertBefore(widget, previous); persistOrder(); }); });
            widget.querySelector('.we-down')?.addEventListener('click', (event) => { event.stopPropagation(); const next = widget.nextElementSibling; if (next instanceof HTMLElement && next.dataset.widget) flip(() => { widget.parentElement?.insertBefore(next, widget); persistOrder(); }); });
            widget.querySelector('.we-remove')?.addEventListener('click', (event) => { event.stopPropagation(); setHidden(id, true); });
            const resize = widget.querySelector<HTMLElement>('.we-resize');
            if (widget.dataset.sizeSm === widget.dataset.sizeLg) resize?.remove();
            else resize?.addEventListener('click', (event) => { event.stopPropagation(); const prefs = getPrefs(); const next = widget.dataset.span === widget.dataset.sizeLg ? 'sm' : 'lg'; flip(() => { widget.dataset.span = next === 'lg' ? widget.dataset.sizeLg : widget.dataset.sizeSm; resize.classList.toggle('is-lg', next === 'lg'); prefs.sizes[id] = next; setPrefs(prefs); }); });
        });

        let dragging: HTMLElement | null = null;
        let startX = 0, startY = 0, originLeft = 0, originTop = 0;
        function begin(widget: HTMLElement, x: number, y: number) {
            const parentRect = widget.parentElement?.getBoundingClientRect() ?? host.getBoundingClientRect();
            const rect = widget.getBoundingClientRect();
            dragging = widget; startX = x; startY = y; originLeft = rect.left - parentRect.left; originTop = rect.top - parentRect.top;
            widget.classList.add('is-dragging'); Object.assign(widget.style, { position: 'absolute', left: `${originLeft}px`, top: `${originTop}px`, width: `${rect.width}px`, zIndex: '50' });
        }
        function move(x: number, y: number) {
            if (!dragging) return;
            dragging.style.left = `${originLeft + x - startX}px`; dragging.style.top = `${originTop + y - startY}px`;
            dragging.style.pointerEvents = 'none'; const under = document.elementFromPoint(x, y) as HTMLElement | null; dragging.style.pointerEvents = '';
            const target = under?.closest<HTMLElement>('[data-widget]');
            if (target && target !== dragging && target.parentElement === dragging.parentElement && !target.hidden) {
                const rect = target.getBoundingClientRect();
                flip(() => target.parentElement?.insertBefore(dragging!, y < rect.top + rect.height / 2 ? target : target.nextSibling));
            }
        }
        function end() { if (!dragging) return; const widget = dragging; dragging = null; widget.classList.remove('is-dragging'); Object.assign(widget.style, { position: '', left: '', top: '', width: '', zIndex: '' }); persistOrder(); }
        host.addEventListener('pointerdown', (event) => {
            if (host.dataset.editing !== '1' || (event.target as HTMLElement).closest('.widget-editbar')) return;
            const widget = (event.target as HTMLElement).closest<HTMLElement>('[data-widget]'); if (!widget) return;
            event.preventDefault(); begin(widget, event.clientX, event.clientY);
            const onMove = (moveEvent: PointerEvent) => move(moveEvent.clientX, moveEvent.clientY);
            const onUp = () => { document.removeEventListener('pointermove', onMove); document.removeEventListener('pointerup', onUp); end(); };
            document.addEventListener('pointermove', onMove); document.addEventListener('pointerup', onUp);
        });
    }

    const mountAll = () => document.querySelectorAll<HTMLElement>('[data-widget-grid]').forEach(mountGrid);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountAll, { once: true }); else mountAll();
</script>
