---
import WidgetEditButtons from './WidgetEditButtons.astro';
import { currentLocale } from '../../lib/context';
import { t } from '../../i18n/app';
const L = currentLocale();

interface Props {
    id?: string;
    storageKey: string;
    class?: string;
    editButtonId?: string;
    doneButtonId?: string;
    resetButtonId?: string;
    trayTitle: string;
    resetConfirm: string;
    labels: { drag: string; up: string; down: string; resize: string; remove: string };
    /** Layout guardado en servidor para ESTE grid (ME.widgetPrefs?.[storageKey]), si existe. */
    serverPrefs?: Record<string, unknown>;
    /** Copy de la biblioteca de widgets ocultos. */
    librarySearchPlaceholder?: string;
    libraryNoResults?: string;
    libraryAddLabel?: string;
}
const {
    id, storageKey, class: className, editButtonId = '', doneButtonId = '', resetButtonId = '',
    trayTitle, resetConfirm, labels, serverPrefs,
    librarySearchPlaceholder = '', libraryNoResults = '', libraryAddLabel = '+',
} = Astro.props;
---
<div
    id={id}
    class={className}
    data-widget-grid
    data-storage-key={storageKey}
    data-edit-button={editButtonId}
    data-done-button={doneButtonId}
    data-reset-button={resetButtonId}
    data-reset-confirm={resetConfirm}
    data-server-prefs={serverPrefs && Object.keys(serverPrefs).length ? JSON.stringify(serverPrefs) : ''}
    data-library-search-ph={librarySearchPlaceholder}
    data-library-no-results={libraryNoResults}
    data-library-add-label={libraryAddLabel}
    data-library-visible-label={t(L, 'widgets.en_pantalla')}
>
    <slot />
    <section class="dash-card widget-tray" data-widget-tray hidden>
        <p class="widget-tray-title">{t(L, 'widgets.biblioteca')}</p>
        <div class="widget-tray-list" data-widget-tray-list></div>
    </section>
    <WidgetEditButtons {...labels} />
</div>
<script is:inline>
    // Pre-paint sincronico. La clave siempre sale del dataset del grid, nunca
    // queda hardcodeada en el componente ni en el modulo interactivo.
    //
    // Merge servidor↔localStorage: last-writer-wins por grid COMPLETO usando el
    // reloj `at` que viaja en el propio prefs (nunca merge campo a campo — fusionar
    // dos reordenamientos produce un layout que nadie pidió). Si gana el servidor,
    // se escribe a localStorage en esta misma pasada (converge sin red). Si gana
    // local, se marca prefsDirty para que el módulo interactivo lo empuje al montar.
    (function () {
        var host = document.currentScript && document.currentScript.previousElementSibling;
        if (!host || !host.matches('[data-widget-grid]')) return;
        try {
            var local = JSON.parse(localStorage.getItem(host.dataset.storageKey) || '{}');
            var serverRaw = host.dataset.serverPrefs;
            var server = serverRaw ? JSON.parse(serverRaw) : null;
            var raw = local;
            if (server && (Number(server.at) || 0) > (Number(local.at) || 0)) {
                raw = server;
                try { localStorage.setItem(host.dataset.storageKey, JSON.stringify(server)); } catch (e) {}
            } else if (server) {
                host.dataset.prefsDirty = '1';
            }
            var order = Array.isArray(raw.order) ? raw.order : [];
            var hidden = Array.isArray(raw.hidden) ? raw.hidden : [];
            var sizes = raw.sizes && typeof raw.sizes === 'object' ? raw.sizes : {};
            var widgets = Array.prototype.slice.call(host.querySelectorAll('[data-widget]')).filter(function (w) { return w.closest('[data-widget-grid]') === host; });
            var byId = {};
            widgets.forEach(function (w) {
                byId[w.dataset.widget] = w;
                if (w.dataset.widgetOptional === '1') w.hidden = hidden.indexOf(w.dataset.widget) !== -1 || order.indexOf(w.dataset.widget) === -1;
                // A metric without a chart or detailed view has one honest size.
                if (w.dataset.sizeSm === '1' && !w.querySelector('[data-chart], .kpi-spark, .kpi-gauge, [data-widget-detail]')) {
                    w.dataset.sizeLg = w.dataset.sizeSm;
                    w.dataset.span = w.dataset.sizeSm;
                }
            });
            var finalOrder = order.filter(function (widgetId) { return byId[widgetId]; });
            widgets.forEach(function (w) { if (finalOrder.indexOf(w.dataset.widget) === -1) finalOrder.push(w.dataset.widget); });
            var rank = {}; finalOrder.forEach(function (widgetId, index) { rank[widgetId] = index; });
            var parents = [];
            widgets.forEach(function (w) { if (parents.indexOf(w.parentElement) === -1) parents.push(w.parentElement); });
            parents.forEach(function (parent) {
                widgets.filter(function (w) { return w.parentElement === parent; })
                    .sort(function (a, b) { return rank[a.dataset.widget] - rank[b.dataset.widget]; })
                    .forEach(function (w) { parent.insertBefore(w, parent === host ? host.querySelector('[data-widget-tray]') : null); });
            });
            hidden.forEach(function (widgetId) { if (byId[widgetId]) byId[widgetId].hidden = true; });
            Object.keys(sizes).forEach(function (widgetId) {
                var w = byId[widgetId]; if (!w) return;
                var span = sizes[widgetId] === 'lg' ? w.dataset.sizeLg : w.dataset.sizeSm;
                if (span) w.dataset.span = span;
            });
        } catch (e) {}
    })();
</script>

<script>
    import { iconSvg } from '../../lib/icons';
    import { optionalWidgetHidden } from '../../lib/widget-defaults';
    type Prefs = { order: string[]; hidden: string[]; sizes: Record<string, 'sm' | 'lg'>; rev?: number; at?: number };

    // Debounce compartido por TODOS los grids de la página: cada uno empuja bajo
    // su propia storageKey, pero un solo timer evita ráfagas de PUT si el usuario
    // reordena varios widgets seguidos en el mismo grid.
    const pushTimers = new Map<string, ReturnType<typeof setTimeout>>();
    const pendingPush = new Map<string, Prefs>();
    function pushNow(key: string, prefs: Prefs) {
        fetch('/api/app/widget-prefs', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key, prefs }),
            keepalive: true,
        }).catch(() => {}); // sin red o sin sesión: localStorage ya guardó, no hay nada que romper
    }
    function queuePush(key: string, prefs: Prefs) {
        pendingPush.set(key, prefs);
        const existing = pushTimers.get(key);
        if (existing) clearTimeout(existing);
        pushTimers.set(key, setTimeout(() => { pendingPush.delete(key); pushNow(key, prefs); }, 800));
    }
    // Red de seguridad: si la pestaña se cierra antes de que el debounce dispare,
    // sendBeacon manda lo pendiente (solo admite POST — el endpoint acepta ambos).
    addEventListener('pagehide', () => {
        pendingPush.forEach((prefs, key) => {
            navigator.sendBeacon?.('/api/app/widget-prefs', new Blob([JSON.stringify({ key, prefs })], { type: 'application/json' }));
        });
    });

    function mountGrid(host: HTMLElement) {
        if (host.dataset.widgetReady === '1') return;
        host.dataset.widgetReady = '1';
        const key = host.dataset.storageKey || '';

        // El pre-paint (is:inline) ya decidió quién ganó el merge servidor↔local.
        // Si ganó local, el servidor se quedó atrás — empújalo una vez al montar,
        // sin esperar a que el usuario toque algo.
        if (host.dataset.prefsDirty === '1') {
            delete host.dataset.prefsDirty;
            try {
                const current = JSON.parse(localStorage.getItem(key) || '{}');
                if (current && typeof current === 'object') queuePush(key, current);
            } catch {}
        }
        const tray = host.querySelector<HTMLElement>('[data-widget-tray]');
        const trayList = host.querySelector<HTMLElement>('[data-widget-tray-list]');
        const template = host.querySelector<HTMLTemplateElement>('[data-widget-edit-template]');
        const editButton = document.getElementById(host.dataset.editButton || '');
        const doneButton = document.getElementById(host.dataset.doneButton || '');
        const resetButton = document.getElementById(host.dataset.resetButton || '');
        const libraryButton = document.getElementById(`${host.dataset.editButton}Library`);
        let libraryOpen = false;
        if (tray) host.prepend(tray);
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const mobileLayout = matchMedia('(max-width: 880px)');
        const syncInputMode = () => {
            if (mobileLayout.matches) host.dataset.touchLayout = '1';
            else delete host.dataset.touchLayout;
        };
        syncInputMode();
        mobileLayout.addEventListener('change', syncInputMode);
        const widgets = () => Array.from(host.querySelectorAll<HTMLElement>('[data-widget]'))
            .filter((el) => el.closest('[data-widget-grid]') === host);
        const getPrefs = (): Prefs => {
            try {
                const value = JSON.parse(localStorage.getItem(key) || '{}');
                return {
                    order: widgets().map(w => w.dataset.widget!),
                    hidden: [...new Set([...(Array.isArray(value.hidden) ? value.hidden : []), ...widgets().filter(w => w.dataset.widgetOptional === '1' && optionalWidgetHidden(w.dataset.widget!, Array.isArray(value.order) ? value.order : [], Array.isArray(value.hidden) ? value.hidden : [])).map(w => w.dataset.widget!)])],
                    sizes: value.sizes && typeof value.sizes === 'object' ? value.sizes : {},
                    rev: typeof value.rev === 'number' ? value.rev : 0,
                    at: typeof value.at === 'number' ? value.at : 0,
                };
            } catch { return { order: widgets().map(w => w.dataset.widget!), hidden: widgets().filter(w => w.dataset.widgetOptional === '1').map(w => w.dataset.widget!), sizes: {}, rev: 0, at: 0 }; }
        };
        const setPrefs = (prefs: Prefs) => {
            const stamped: Prefs = { ...prefs, rev: (prefs.rev ?? 0) + 1, at: Date.now() };
            try { localStorage.setItem(key, JSON.stringify(stamped)); } catch {}
            queuePush(key, stamped);
        };
        const persistOrder = () => { const prefs = getPrefs(); prefs.order = widgets().map((w) => w.dataset.widget!); setPrefs(prefs); };

        widgets().forEach((widget) => {
            if (!widget.querySelector('.widget-editbar') && template) widget.prepend(template.content.cloneNode(true));
        });
        template?.remove();

        function flip(mutate: () => void) {
            const visible = widgets().filter((w) => !w.hidden);
            const first = new Map(visible.map((w) => [w, w.getBoundingClientRect()] as const));
            mutate();
            if (reduceMotion) return;
            requestAnimationFrame(() => widgets().filter((w) => !w.hidden).forEach((w) => {
                const before = first.get(w); if (!before) return;
                const after = w.getBoundingClientRect();
                const x = before.left - after.left, y = before.top - after.top;
                if (!x && !y) return;
                w.style.transition = 'none'; w.style.transform = `translate(${x}px, ${y}px)`; w.getBoundingClientRect();
                w.style.transition = 'transform .32s var(--ease-spring)'; w.style.transform = '';
                w.addEventListener('transitionend', () => { w.style.transition = ''; }, { once: true });
            }));
        }
        // Biblioteca de widgets ocultos: buscador + agrupado por
        // data-group + preview real del widget (clonado del DOM, sin montar sus
        // gráficas — mountAll() nunca ve el clon porque no se le pasa como root).
        // Nunca es un <dialog>: Regla 12, AppLayout no carga modal.css en estas páginas.
        let librarySearch = '';
        let libraryFilter: 'all' | 'available' = 'all';
        function renderTray() {
            if (!tray || !trayList) return;
            const prefs = getPrefs();
            const available = widgets().filter((w) => !w.hidden || w.dataset.widgetOptional === '1' || prefs.hidden.includes(w.dataset.widget!));
            tray.hidden = !libraryOpen; trayList.innerHTML = '';
            if (!libraryOpen) return;

            tray.classList.add('wx-library');
            const filters = document.createElement('div'); filters.className = 'wx-lib-filters';
            const en = document.documentElement.lang.startsWith('en');
            for (const mode of ['all', 'available'] as const) {
                const button = document.createElement('button'); button.type = 'button';
                const count = mode === 'all' ? available.length : available.filter(w => w.hidden).length;
                button.textContent = `${mode === 'all' ? (en ? 'All widgets' : 'Todos') : (en ? 'To add' : 'Para agregar')} · ${count}`;
                button.setAttribute('aria-pressed', String(libraryFilter === mode));
                button.addEventListener('click', () => { libraryFilter = mode; renderTray(); });
                filters.appendChild(button);
            }
            trayList.appendChild(filters);

            {
                const search = document.createElement('label');
                search.className = 'wx-lib-search';
                search.innerHTML = '' + iconSvg('search') + '';
                const input = document.createElement('input');
                input.type = 'search'; input.autocomplete = 'off';
                input.placeholder = host.dataset.librarySearchPh || '';
                input.setAttribute('aria-label', input.placeholder);
                input.value = librarySearch;
                input.addEventListener('input', () => { librarySearch = input.value; renderRows(); });
                search.appendChild(input);
                trayList.appendChild(search);
            }

            const rowsHost = document.createElement('div');
            rowsHost.className = 'wx-lib-rows';
            trayList.appendChild(rowsHost);

            function renderRows() {
                rowsHost.innerHTML = '';
                const q = librarySearch.trim().toLocaleLowerCase();
                const visible = available.filter((w) => {
                    if (libraryFilter === 'available' && !w.hidden) return false;
                    if (!q) return true;
                    const hay = `${w.dataset.title || ''} ${w.dataset.desc || ''}`.toLocaleLowerCase();
                    return hay.includes(q);
                });
                const groups = Array.from(new Set(visible.map((w) => w.dataset.group || '')));
                const hasGroups = groups.some((g) => g) && groups.length > 1;
                if (!hasGroups) {
                    visible.forEach((w) => rowsHost.appendChild(libraryRow(w)));
                } else {
                    groups.forEach((g) => {
                        const inGroup = visible.filter((w) => (w.dataset.group || '') === g);
                        if (!inGroup.length) return;
                        if (g) {
                            const label = document.createElement('p');
                            label.className = 'wx-lib-group-label';
                            label.textContent = g;
                            rowsHost.appendChild(label);
                        }
                        inGroup.forEach((w) => rowsHost.appendChild(libraryRow(w)));
                    });
                }
                if (!visible.length) {
                    const empty = document.createElement('p');
                    empty.className = 'wx-lib-noresults';
                    empty.textContent = host.dataset.libraryNoResults || '';
                    rowsHost.appendChild(empty);
                }
            }
            renderRows();
        }
        function libraryRow(w: HTMLElement) {
            const row = document.createElement('div'); row.className = 'wx-lib-row';
            const preview = document.createElement('div'); preview.className = 'wx-lib-preview';
            const previewTemplate = w.querySelector<HTMLTemplateElement>('template[data-widget-preview]');
            const card = previewTemplate?.content.firstElementChild || w.querySelector('.dash-card, .surface-card');
            if (card) {
                const clone = card.cloneNode(true) as HTMLElement;
                clone.removeAttribute('id');
                clone.querySelectorAll('[id]').forEach((n) => n.removeAttribute('id'));
                // Previews must not become inputs to page controllers (team rows,
                // chart sinks, totals, etc.). Keep only Astro's styling attributes.
                [clone, ...Array.from(clone.querySelectorAll<HTMLElement>('*'))].forEach((node) => {
                    Array.from(node.attributes).forEach((attr) => {
                        if (attr.name.startsWith('data-') && !attr.name.startsWith('data-astro-')) node.removeAttribute(attr.name);
                    });
                });
                clone.setAttribute('inert', '');
                preview.setAttribute('aria-hidden', 'true');
                // Fit the actual card, without a second miniature card frame.
                const rect = card.getBoundingClientRect();
                const width = previewTemplate ? 360 : rect.width || (w.dataset.sizeSm === '1' ? 280 : 520);
                const height = previewTemplate ? 220 : rect.height || 180;
                const scale = Math.min(128 / width, 86 / height);
                clone.style.width = `${width}px`;
                clone.style.height = `${height}px`;
                clone.style.transform = `translate(-50%, -50%) scale(${scale})`;
                preview.appendChild(clone);
            }
            const info = document.createElement('div'); info.className = 'wx-lib-info';
            const strong = document.createElement('strong'); strong.textContent = w.dataset.title || w.dataset.widget || '';
            info.appendChild(strong);
            if (w.dataset.desc) { const small = document.createElement('small'); small.textContent = w.dataset.desc; info.appendChild(small); }
            const add = document.createElement('button'); add.type = 'button'; add.className = 'wx-lib-add';
            add.textContent = w.hidden ? host.dataset.libraryAddLabel || '+' : host.dataset.libraryVisibleLabel || '';
            add.disabled = !w.hidden;
            add.setAttribute('aria-label', `${add.textContent} ${strong.textContent}`);
            add.addEventListener('click', () => setHidden(w.dataset.widget!, false));
            row.append(preview, info, add);
            return row;
        }
        function setHidden(id: string, hidden: boolean) {
            const prefs = getPrefs();
            prefs.hidden = hidden ? [...new Set([...prefs.hidden, id])] : prefs.hidden.filter((value) => value !== id);
            setPrefs(prefs); const widget = widgets().find((w) => w.dataset.widget === id); if (widget) widget.hidden = hidden; if (hidden) { libraryOpen = true; libraryButton?.setAttribute('aria-expanded', 'true'); } renderTray();
        }
        function setContentInert(inert: boolean) {
            widgets().forEach((w) => Array.from(w.children).forEach((child) => {
                if (!(child instanceof HTMLElement) || child.classList.contains('widget-editbar')) return;
                if (inert && !child.inert) { child.inert = true; child.dataset.widgetInert = '1'; }
                else if (!inert && child.dataset.widgetInert) { child.inert = false; delete child.dataset.widgetInert; }
            }));
        }
        function enterEdit() { host.dataset.editing = '1'; setContentInert(true); if (libraryButton) libraryButton.hidden = false; renderTray(); if (editButton) editButton.hidden = true; if (doneButton) doneButton.hidden = false; if (resetButton) resetButton.hidden = false; }
        function exitEdit() { if (dragging) end(); delete host.dataset.editing; setContentInert(false); libraryOpen = false; if (libraryButton) { libraryButton.hidden = true; libraryButton.setAttribute('aria-expanded', 'false'); } if (tray) tray.hidden = true; if (editButton) editButton.hidden = false; if (doneButton) doneButton.hidden = true; if (resetButton) resetButton.hidden = true; }
        libraryButton?.addEventListener('click', () => { libraryOpen = !libraryOpen; libraryButton.setAttribute('aria-expanded', String(libraryOpen)); renderTray(); });
        editButton?.addEventListener('click', enterEdit); doneButton?.addEventListener('click', exitEdit);
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && host.dataset.editing === '1') { if (dragging) end(false); else exitEdit(); }
        });
        resetButton?.addEventListener('click', async () => {
            const confirmFn = (window as any).cordConfirm;
            const ok = confirmFn ? await confirmFn(host.dataset.resetConfirm || '') : confirm(host.dataset.resetConfirm || '');
            if (!ok) return; setPrefs({ order: [], hidden: [], sizes: {} }); location.reload();
        });

        widgets().forEach((widget) => {
            const id = widget.dataset.widget!;
            widget.querySelector('.we-up')?.addEventListener('click', (event) => { event.stopPropagation(); const siblings = widgets().filter((w) => !w.hidden && w.parentElement === widget.parentElement); const previous = siblings[siblings.indexOf(widget) - 1]; if (previous instanceof HTMLElement && previous.dataset.widget) flip(() => { widget.parentElement?.insertBefore(widget, previous); persistOrder(); }); });
            widget.querySelector('.we-down')?.addEventListener('click', (event) => { event.stopPropagation(); const siblings = widgets().filter((w) => !w.hidden && w.parentElement === widget.parentElement); const next = siblings[siblings.indexOf(widget) + 1]; if (next instanceof HTMLElement && next.dataset.widget) flip(() => { widget.parentElement?.insertBefore(next, widget); persistOrder(); }); });
            widget.querySelector('.we-remove')?.addEventListener('click', (event) => { event.stopPropagation(); setHidden(id, true); });
            const sizeControls = widget.querySelector<HTMLElement>('.we-sizes');
            const syncSize = () => {
                widget.dataset.widgetSize = widget.dataset.span === widget.dataset.sizeLg && widget.dataset.sizeLg !== widget.dataset.sizeSm ? 'lg' : 'sm';
                widget.querySelectorAll<HTMLButtonElement>('.we-size').forEach((button) => {
                    button.setAttribute('aria-pressed', String(button.dataset.size === widget.dataset.widgetSize));
                });
            };
            syncSize();
            if (widget.dataset.sizeSm === widget.dataset.sizeLg) sizeControls?.remove();
            else sizeControls?.addEventListener('click', (event) => {
                const button = (event.target as HTMLElement).closest<HTMLElement>('.we-size');
                if (!button) return;
                event.stopPropagation();
                const next = button.dataset.size === 'lg' ? 'lg' : 'sm';
                if (next === widget.dataset.widgetSize) return;
                flip(() => {
                    widget.dataset.span = next === 'lg' ? widget.dataset.sizeLg : widget.dataset.sizeSm;
                    syncSize(); const prefs = getPrefs(); prefs.sizes[id] = next; setPrefs(prefs);
                });
            });
        });

        let dragging: HTMLElement | null = null;
        let ghost: HTMLElement | null = null;
        let startX = 0, startY = 0, pointerX = 0, pointerY = 0;
        let scrollFrame = 0;
        let originalNext: ChildNode | null = null;
        let cleanupPointer: (() => void) | null = null;
        function begin(widget: HTMLElement, x: number, y: number) {
            const rect = widget.getBoundingClientRect();
            dragging = widget; originalNext = widget.nextSibling;
            startX = x - rect.left; startY = y - rect.top;
            // Keep the real widget in flow as the landing position. A visual copy
            // follows the pointer without collapsing the grid or moving live charts.
            ghost = widget.cloneNode(true) as HTMLElement;
            ghost.removeAttribute('id'); ghost.removeAttribute('data-widget');
            ghost.querySelectorAll('[id]').forEach((node) => node.removeAttribute('id'));
            ghost.querySelector('.widget-editbar')?.remove();
            ghost.classList.add('widget-drag-ghost'); ghost.setAttribute('inert', '');
            ghost.setAttribute('aria-hidden', 'true');
            Object.assign(ghost.style, { width: `${rect.width}px`, height: `${rect.height}px` });
            widget.parentElement!.appendChild(ghost);
            widget.classList.add('is-dragging');
            move(x, y);
            const autoScroll = () => {
                if (!dragging) return;
                const edge = 72;
                const dy = pointerY < edge ? -12 : pointerY > innerHeight - edge ? 12 : 0;
                if (dy) { window.scrollBy(0, dy); move(pointerX, pointerY); }
                scrollFrame = requestAnimationFrame(autoScroll);
            };
            scrollFrame = requestAnimationFrame(autoScroll);
        }
        function move(x: number, y: number) {
            if (!dragging || !ghost) return;
            pointerX = x; pointerY = y;
            const parentRect = ghost.parentElement!.getBoundingClientRect();
            ghost.style.transform = `translate3d(${x - startX - parentRect.left}px, ${y - startY - parentRect.top}px, 0) scale(1.015)`;
            const target = document.elementFromPoint(x, y)?.closest<HTMLElement>('[data-widget]');
            if (!target || target === dragging || target.hidden || target.parentElement !== dragging.parentElement) return;
            const rect = target.getBoundingClientRect();
            const own = dragging.getBoundingClientRect();
            const sameRow = Math.abs(own.top - rect.top) < Math.min(own.height, rect.height) / 2;
            const before = sameRow ? x < rect.left + rect.width / 2 : y < rect.top + rect.height / 2;
            const anchor = before ? target : target.nextSibling;
            if (anchor === dragging || dragging.nextSibling === anchor) return;
            flip(() => target.parentElement?.insertBefore(dragging!, anchor));
        }
        function end(commit = true) {
            cleanupPointer?.(); cleanupPointer = null;
            cancelAnimationFrame(scrollFrame);
            if (!dragging) return;
            const widget = dragging; dragging = null;
            ghost?.remove(); ghost = null;
            widget.classList.remove('is-dragging');
            if (commit) persistOrder();
            else widget.parentElement?.insertBefore(widget, originalNext);
        }
        host.addEventListener('pointerdown', (event) => {
            const target = event.target as HTMLElement;
            if (event.button !== 0 || mobileLayout.matches || host.dataset.editing !== '1' || target.closest('.we-btn:not(.we-drag), .we-sizes')) return;
            const widget = target.closest<HTMLElement>('[data-widget]');
            if (!widget || widget.closest('[data-widget-grid]') !== host) return;
            event.preventDefault();
            const pointerId = event.pointerId;
            const initialX = event.clientX, initialY = event.clientY;
            const onMove = (e: PointerEvent) => {
                if (e.pointerId !== pointerId) return;
                if (!dragging && Math.hypot(e.clientX - initialX, e.clientY - initialY) < 5) return;
                if (!dragging) begin(widget, initialX, initialY);
                move(e.clientX, e.clientY);
            };
            const onUp = (e: PointerEvent) => { if (e.pointerId === pointerId) end(e.type !== 'pointercancel'); };
            const onBlur = () => end(false);
            cleanupPointer = () => {
                document.removeEventListener('pointermove', onMove);
                document.removeEventListener('pointerup', onUp);
                document.removeEventListener('pointercancel', onUp);
                window.removeEventListener('blur', onBlur);
            };
            document.addEventListener('pointermove', onMove);
            document.addEventListener('pointerup', onUp);
            document.addEventListener('pointercancel', onUp);
            window.addEventListener('blur', onBlur);
        });
    }

    const mountAll = () => document.querySelectorAll<HTMLElement>('[data-widget-grid]').forEach(mountGrid);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountAll, { once: true }); else mountAll();
</script>
