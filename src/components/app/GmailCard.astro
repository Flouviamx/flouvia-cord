---
import SettingsSection from './settings/SettingsSection.astro';
import { t, type AppLocale } from '../../i18n/app';

interface Props {
    lang: AppLocale;
    conexion: { cuenta: string; estado: string } | null;
    /** Personas del equipo con el complemento de Gmail autorizado. */
    complemento: number;
    disponible: boolean;
    flash: string | null;
}

const { lang: L, conexion, complemento, disponible, flash } = Astro.props;
const FLASH = ['conectado', 'cancelada', 'estado', 'cuenta', 'permiso', 'error'];
---

<SettingsSection icon="sliders" class="s-block">
    <Fragment slot="heading">{t(L, 'gmail.titulo')}</Fragment>
    <div class="s-body">
        {flash && FLASH.includes(flash) && (
            <p class="gm-flash" data-bad={flash !== 'conectado' ? '1' : undefined}>{t(L, `gmail.flash_${flash}` as any)}</p>
        )}
        <p class="gm-que">{t(L, 'gmail.que_hace')}</p>

        {conexion ? (
            <Fragment>
                {conexion.estado === 'error' && <p class="gm-flash" data-bad="1">{t(L, 'gmail.reconectar_aviso')}</p>}
                <p class="gm-conn">{t(L, 'gmail.envia_desde')} <b>{conexion.cuenta}</b></p>
                <div class="gm-actions">
                    {conexion.estado === 'error' && <button class="gm-btn-solid" data-gm-conectar>{t(L, 'gmail.reconectar')}</button>}
                    <button class="gm-btn-ghost" data-gm-off>{t(L, 'gmail.desconectar')}</button>
                </div>
            </Fragment>
        ) : (
            <div class="gm-actions">
                <button class="gm-btn-solid" data-gm-conectar disabled={!disponible}>{t(L, 'gmail.conectar')}</button>
                {!disponible && <span class="gm-pronto">{t(L, 'gmail.no_disponible')}</span>}
            </div>
        )}
        <p class="gm-nota">{t(L, 'gmail.nota')}</p>

        <div class="gm-addon">
            <p class="gm-addon-t">{t(L, 'gmail.complemento_titulo')}</p>
            <p class="gm-conn">{complemento > 0
                ? t(L, complemento === 1 ? 'gmail.complemento_uno' : 'gmail.complemento_varios').replace('{n}', String(complemento))
                : t(L, 'gmail.complemento_ninguno')}</p>
            {complemento > 0 && <button class="gm-btn-ghost" data-gm-addon-off>{t(L, 'gmail.complemento_desconectar')}</button>}
        </div>
        <span class="gm-msg" data-gm-msg
            data-i18n-no-conecto={t(L, 'gmail.err.no_conecto')}
            data-i18n-no-desconecto={t(L, 'gmail.err.no_desconecto')}
            data-i18n-confirmar-addon={t(L, 'gmail.complemento_confirmar')}></span>
    </div>
</SettingsSection>

<style>
    .gm-flash { font-size: 0.82rem; margin: 0 0 1rem; color: var(--color-ok); }
    .gm-flash[data-bad] { color: var(--color-danger); }
    .gm-que { font-size: 0.85rem; line-height: 1.5; color: var(--color-text-muted); margin: 0 0 1rem; max-width: 62ch; }
    .gm-conn { font-size: 0.9rem; margin: 0 0 1rem; color: var(--color-text); }
    .gm-nota { font-size: 0.78rem; line-height: 1.5; color: var(--color-text-muted); margin: 1rem 0 0; max-width: 62ch; }
    .gm-addon { border-top: 1px solid var(--color-border); margin-top: 1.4rem; padding-top: 1.2rem; }
    .gm-addon-t { font-size: 0.82rem; font-weight: 700; margin: 0 0 0.4rem; color: var(--color-text); }
    .gm-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .gm-pronto { font-size: 0.78rem; color: var(--color-text-muted); }
    .gm-msg { display: block; margin-top: 0.8rem; min-height: 1.2em; font-size: 0.78rem; font-weight: 600; color: var(--color-danger); }
    .gm-btn-solid { display: inline-flex; align-items: center; font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 9px; padding: 9px 18px; cursor: pointer; }
    .gm-btn-solid:disabled, .gm-btn-ghost:disabled { opacity: 0.6; cursor: not-allowed; }
    .gm-btn-ghost { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 9px; padding: 9px 16px; cursor: pointer; }
    .gm-btn-solid:focus-visible, .gm-btn-ghost:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }

    @media (max-width: 560px) {
        .gm-actions { display: grid; grid-template-columns: 1fr; width: 100%; }
        .gm-btn-solid, .gm-btn-ghost { min-height: 46px; width: 100%; justify-content: center; text-align: center; }
        .gm-addon .gm-btn-ghost { width: 100%; }
    }
</style>

<script>
    function initGmail() {
        const msg = document.querySelector<HTMLElement>('[data-gm-msg]');
        if (!msg) return;
        const fallo = (text: string) => { msg.textContent = text; };
        const pedir = (metodo: string) => fetch('/api/integraciones/gmail/conectar', { method: metodo, headers: { 'Content-Type': 'application/json' } });

        const conectar = document.querySelector<HTMLButtonElement>('[data-gm-conectar]');
        conectar?.addEventListener('click', async () => {
            conectar.disabled = true;
            try {
                const res = await pedir('POST');
                const d = await res.json();
                if (!res.ok || !d.redirect) throw new Error(d.error || '');
                window.location.href = d.redirect;
            } catch (err: any) {
                fallo(err.message || msg.dataset.i18nNoConecto || '');
                conectar.disabled = false;
            }
        });

        const off = document.querySelector<HTMLButtonElement>('[data-gm-off]');
        off?.addEventListener('click', async () => {
            off.disabled = true;
            try {
                const res = await pedir('DELETE');
                if (!res.ok) throw new Error();
                window.location.href = window.location.pathname;
            } catch {
                fallo(msg.dataset.i18nNoDesconecto || '');
                off.disabled = false;
            }
        });

        const addonOff = document.querySelector<HTMLButtonElement>('[data-gm-addon-off]');
        addonOff?.addEventListener('click', async () => {
            if (!window.confirm(msg.dataset.i18nConfirmarAddon || '')) return;
            addonOff.disabled = true;
            try {
                const res = await fetch('/api/integraciones/gmail/complemento', { method: 'DELETE' });
                if (!res.ok) throw new Error();
                window.location.href = window.location.pathname;
            } catch {
                fallo(msg.dataset.i18nNoDesconecto || '');
                addonOff.disabled = false;
            }
        });
    }
    initGmail();
</script>
