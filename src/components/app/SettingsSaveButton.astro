---
import { currentLocale } from '../../lib/context';
import { t } from '../../i18n/app';
interface Props {
    id?: string;
    type?: 'button' | 'submit';
    label?: string;
    disabled?: boolean;
    [key: string]: unknown;
}
const L = currentLocale();
const {id, type = 'button', label = t(L,'settings.guardar_cambios'), disabled = false, ...attrs} = Astro.props;
---
<button {...attrs} id={id} type={type} disabled={disabled} class="s-save" data-save-button
    data-i18n-saved={t(L,'settings.cambios_guardados')} data-i18n-err={t(L,'settings.no_se_pudo_guardar')} aria-busy="false">
    <span class="s-save-label">{label}</span>
    <span class="s-save-progress"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="2" opacity=".2"/><path d="M10 3a7 7 0 0 1 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{L === 'en' ? 'Saving…' : 'Guardando…'}</span>
    <span class="s-save-success"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.4" opacity=".35"/><path d="m7 12 3.5 3.5L17 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{L === 'en' ? 'Saved' : 'Guardado'}</span>
</button>
<script>
    import { setSaveState } from '../../lib/settings-save-feedback';
    document.addEventListener('cord:save-state', (event) => {
        const e = event as CustomEvent<{state:'saving'|'saved'|'error';message?:string}>;
        if (e.target instanceof HTMLButtonElement && e.target.matches('[data-save-button]')) setSaveState(e.target, e.detail.state, e.detail.message);
    });
</script>
<style is:global>
    .settings-save-footer { display:flex; align-items:center; justify-content:flex-end; gap:1rem; width:100%; margin-top:1.5rem; padding-top:1rem;  }
    [data-save-button].s-save { display:inline-grid; grid-template-areas:"state"; place-items:center; position:relative; overflow:hidden; flex-shrink:0; width:auto; min-width:174px; min-height:48px; padding:13px 25px; border:0; border-radius:14px; background:var(--color-blue-deep); color:#fff; font:600 .88rem var(--font-sans); cursor:pointer; box-shadow:0 8px 22px -12px #0a192f55; transition:background .3s ease,box-shadow .3s ease,transform .25s var(--ease-spring); }
    [data-save-button] > span { grid-area:state; display:flex; align-items:center; justify-content:center; gap:.6rem; transition:opacity .2s ease,transform .35s var(--ease-spring); }
    [data-save-button] .s-save-progress, [data-save-button] .s-save-success { visibility:hidden; opacity:0; transform:translateY(9px); }
    [data-save-button] svg { width:22px; height:22px; flex-shrink:0; }
    [data-save-button]:hover:not(:disabled) { transform:translateY(-1px); box-shadow:0 10px 24px -12px #0a192f66; }
    [data-save-button]:active:not(:disabled) { transform:scale(.97); }
    [data-save-button]:focus-visible { outline:3px solid var(--color-text-muted); outline-offset:4px; }
    [data-save-button]:disabled { cursor:default; }
    [data-save-button].dirty:not(.saving):not(.saved) { box-shadow:0 8px 22px -12px #0a192f55,0 0 0 3px var(--color-border); }
    [data-save-button]:is(.saving,.saved) .s-save-label { visibility:hidden; opacity:0; transform:translateY(-9px); }
    [data-save-button].saving .s-save-progress, [data-save-button].saved .s-save-success { visibility:visible; opacity:1; transform:translateY(0); }
    [data-save-button].saving .s-save-progress svg { animation:settings-save-spin .8s linear infinite; }
    [data-save-button].saved { background:#167663; color:#fff; animation:settings-save-settle .48s var(--ease-spring); box-shadow:0 8px 24px -12px #16766366; }
    .s-save-success path { stroke-dasharray:18; stroke-dashoffset:18; }
    .saved .s-save-success path { animation:settings-save-check .38s .12s ease forwards; }
    .settings-save-footer .s-saved { order:-1; margin:0; max-width:55ch; color:var(--color-ok); font-size:.8rem; line-height:1.5; opacity:0; transition:opacity .2s; }
    .settings-save-footer .s-saved.show { opacity:1; }
    .settings-save-footer .s-saved.error { color:var(--color-danger); }
    @keyframes settings-save-spin { to { transform:rotate(360deg); } }
    @keyframes settings-save-check { to { stroke-dashoffset:0; } }
    @keyframes settings-save-settle { 0% { transform:scale(.97); } 55% { transform:scale(1.025); } 100% { transform:scale(1); } }
    @media(max-width:600px) { .settings-save-footer { flex-wrap:wrap; } .settings-save-footer .s-saved { flex-basis:100%; text-align:right; } }
    @media(prefers-reduced-motion:reduce) { [data-save-button], [data-save-button] > span, [data-save-button] svg, [data-save-button] path { animation:none !important; transition:none !important; transform:none !important; } .saved .s-save-success path { stroke-dashoffset:0; } }
</style>
