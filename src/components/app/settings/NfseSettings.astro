---
// Ajustes › Datos fiscales › NFS-e (Brasil, Sistema Nacional NFS-e).
//
// Lo que el negocio aporta (certificado ICP-Brasil de su CNPJ, municipio,
// serie de la DPS, régimen ante el Simples Nacional y código del servicio) y
// un estado honesto: mientras falte cualquiera, o mientras Cord no tenga la
// NFS-e activa, las facturas siguen como documento comercial y aquí se dice
// exactamente eso (regla 15). Sin la NFS-e activa en el despliegue no se
// ofrece ningún control: no hay consumidor que lo lea.
//
// El certificado y la llave viajan una sola vez (multipart a /api/fiscal/nfse)
// y nunca vuelven: la pantalla solo conoce el resumen (vigencia, titular).
import type { EstadoNfse } from '../../../lib/fiscal/latam/nfse/estado';
import { OP_SIMPLES, REG_AP_SIMPLES, REG_ESPECIAL, SERIE_MAX } from '../../../lib/fiscal/latam/nfse/constantes';
import { FALTANTE_EN, FALTANTE_ES, servicoSuportado } from '../../../lib/fiscal/latam/nfse/ajustes';
import { SERVICOS_NACIONAIS } from '../../../lib/fiscal/latam/nfse/servicos';

interface Props { estado: EstadoNfse; locale: 'es' | 'en'; }
const { estado, locale } = Astro.props;
const en = locale === 'en';

const FALTANTE = en ? FALTANTE_EN : FALTANTE_ES;
const faltantes = estado.faltantes.map((f) => FALTANTE[f] ?? f);
const prueba = estado.entorno === 'homologacion';
const cred = estado.credencial;
const caduca = cred?.caduca?.slice(0, 10) ?? '';
const titulo = !estado.habilitado
    ? (en ? 'Coming soon' : 'Próximamente')
    : estado.listo
        ? (prueba ? (en ? 'Connected to the NFS-e test environment' : 'Conectado al ambiente de pruebas de la NFS-e') : (en ? 'NFS-e active' : 'NFS-e activa'))
        : (en ? 'Not connected yet' : 'Aún sin conectar');
const sub = estado.listo
    ? (prueba
        ? (en ? 'NFS-e are generated in the restricted production (test) environment and have no legal validity.' : 'Las NFS-e se generan en el ambiente de producción restringida (pruebas) y no tienen validez jurídica.')
        : (en ? `Certificate valid until ${caduca} · ${cred?.identificador}` : `Certificado vigente hasta ${caduca} · ${cred?.identificador}`))
    : (en ? `Missing: ${faltantes.join(', ')}.` : `Falta: ${faltantes.join(', ')}.`);
const A = estado.ajustes;
const servicos = SERVICOS_NACIONAIS.filter((s) => servicoSuportado(s.codigo));
const codigoBonito = (c: string) => c.replace(/^(\d{2})(\d{2})(\d{2})$/, '$1.$2.$3');
const corto = (t: string) => (t.length > 96 ? `${t.slice(0, 95).trimEnd()}…` : t);
const opcion = (o: { es: string; en: string }) => (en ? o.en : o.es);
---

<div class="nfse" data-nfse data-entorno={estado.entorno}>
    <p class="nfse-intro">{en
        ? 'In Brazil, services are invoiced with the NFS-e, generated by the national NFS-e system from a declaration (DPS) signed with your ICP-Brasil certificate. Connect it so Cord issues the NFS-e of each invoice and prints its access key and QR code on the PDF. Until then, invoices are issued as commercial documents without tax validity.'
        : 'En Brasil los servicios se facturan con la NFS-e, que genera el Sistema Nacional NFS-e a partir de una declaración (DPS) firmada con tu certificado ICP-Brasil. Conéctalo para que Cord emita la NFS-e de cada factura e imprima su chave de acceso y el código QR en el PDF. Mientras tanto, las facturas se emiten como documento comercial sin validez fiscal.'}</p>
    <p class="nfse-intro">{en
        ? 'The NFS-e covers services only. If your business sells goods, their invoice (NF-e) is authorized by your state SEFAZ, and Cord does not issue it yet.'
        : 'La NFS-e cubre solo servicios. Si tu negocio vende productos, su nota fiscal (NF-e) la autoriza la SEFAZ de tu estado, y Cord todavía no la emite.'}</p>

    <div class="nfse-state" data-on={estado.listo ? '1' : '0'} data-nfse-state>
        <span class="nfse-dot" aria-hidden="true"></span>
        <span class="nfse-state-info">
            <span class="nfse-state-title" data-nfse-title>{titulo}</span>
            <span class="nfse-state-sub" data-nfse-sub>{estado.habilitado
                ? sub
                : (en ? 'The NFS-e is not available in Cord yet. Your invoices are still issued as commercial documents; we will let you know when you can connect it.' : 'La NFS-e todavía no está disponible en Cord. Tus facturas se siguen emitiendo como documento comercial; te avisaremos cuando puedas conectarla.')}</span>
            {estado.habilitado && cred?.verificacionError && (
                <span class="nfse-state-err" data-nfse-verif>{cred.verificacionError}</span>
            )}
        </span>
        {estado.habilitado && (
            <button type="button" class="nfse-btn-ghost" data-nfse-remove style={cred ? '' : 'display:none'}>
                {en ? 'Disconnect' : 'Desconectar'}
            </button>
        )}
    </div>

    {estado.habilitado && (
        <Fragment>
            <div class="nfse-grid">
                <div class="s-field">
                    <label for="nfseMun">{en ? 'Municipality of your establishment (IBGE code)' : 'Municipio de tu establecimiento (código IBGE)'}</label>
                    <input class="s-input" id="nfseMun" inputmode="numeric" maxlength="7" autocomplete="off" value={A.municipio ?? ''} placeholder="3550308" />
                    <span class="nfse-help" data-nfse-mun-nome>{estado.municipio ? `${estado.municipio.nome} / ${estado.municipio.uf}` : (en ? '7 digits; for example, 3550308 is São Paulo.' : '7 dígitos; por ejemplo, 3550308 es São Paulo.')}</span>
                </div>
                <div class="s-field">
                    <label for="nfseIm">{en ? 'Municipal registration (if your municipality requires it)' : 'Inscripción municipal (si tu municipio la exige)'}</label>
                    <input class="s-input" id="nfseIm" maxlength="15" autocomplete="off" value={A.inscricaoMunicipal ?? ''} />
                </div>
                <div class="s-field">
                    <label for="nfseOp">{en ? 'Simples Nacional status' : 'Situación ante el Simples Nacional'}</label>
                    <select class="s-input" id="nfseOp">
                        <option value="" selected={!A.opSimpNac}>{en ? 'Choose…' : 'Elige…'}</option>
                        {OP_SIMPLES.map((o) => <option value={o.id} selected={A.opSimpNac === o.id}>{opcion(o)}</option>)}
                    </select>
                </div>
                <div class="s-field" data-nfse-solo-sn>
                    <label for="nfseRegAp">{en ? 'Simples Nacional assessment (ME/EPP)' : 'Apuración del Simples Nacional (ME/EPP)'}</label>
                    <select class="s-input" id="nfseRegAp">
                        <option value="" selected={!A.regApTribSN}>{en ? 'Choose…' : 'Elige…'}</option>
                        {REG_AP_SIMPLES.map((o) => <option value={o.id} selected={A.regApTribSN === o.id}>{opcion(o)}</option>)}
                    </select>
                </div>
                <div class="s-field" data-nfse-solo-sn>
                    <label for="nfseAliqSn">{en ? 'Approximate Simples Nacional taxes (%)' : 'Tributos aproximados del Simples Nacional (%)'}</label>
                    <input class="s-input" id="nfseAliqSn" inputmode="decimal" autocomplete="off" value={A.aliquotaSimples ?? ''} placeholder="6.00" />
                </div>
                <div class="s-field">
                    <label for="nfseRegEsp">{en ? 'Special municipal tax regime' : 'Régimen especial de tributación municipal'}</label>
                    <select class="s-input" id="nfseRegEsp">
                        {REG_ESPECIAL.map((o) => <option value={o.id} selected={(A.regEspTrib ?? 0) === o.id}>{opcion(o)}</option>)}
                    </select>
                </div>
                <div class="s-field nfse-wide">
                    <label for="nfseServ">{en ? 'Service (national list, LC 116/2003)' : 'Servicio (lista nacional, LC 116/2003)'}</label>
                    <select class="s-input" id="nfseServ">
                        <option value="" selected={!A.servico}>{en ? 'Choose…' : 'Elige…'}</option>
                        {servicos.map((s) => <option value={s.codigo} title={s.descricao} selected={A.servico === s.codigo}>{`${codigoBonito(s.codigo)} · ${corto(s.descricao)}`}</option>)}
                    </select>
                </div>
                <div class="s-field">
                    <label for="nfseServMun">{en ? 'Municipal tax code (optional, 3 digits)' : 'Código de tributación municipal (opcional, 3 dígitos)'}</label>
                    <input class="s-input" id="nfseServMun" inputmode="numeric" maxlength="3" autocomplete="off" value={A.servicoMunicipal ?? ''} />
                </div>
                <div class="s-field">
                    <label for="nfseRet">{en ? 'Withholding profile that is the ISS withheld by the client' : 'Perfil de retención que es el ISS retenido por el cliente'}</label>
                    <select class="s-input" id="nfseRet">
                        <option value="" selected={!A.retencaoIssId}>{en ? 'None: ISS is never withheld' : 'Ninguno: el ISS no se retiene'}</option>
                        {estado.retencoes.map((r) => <option value={r.id} selected={A.retencaoIssId === r.id}>{`${r.nome} (${r.tasa} %)`}</option>)}
                    </select>
                </div>
                <div class="s-field">
                    <label for="nfseSerie">{en ? `DPS series (1 to ${SERIE_MAX}), exclusive to Cord` : `Serie de la DPS (1 a ${SERIE_MAX}), exclusiva de Cord`}</label>
                    <input class="s-input" id="nfseSerie" inputmode="numeric" maxlength="5" autocomplete="off" value={A.serie ?? ''} placeholder="900" />
                </div>
                <div class="s-field">
                    <label for="nfseNum">{en ? 'First DPS number (optional)' : 'Primer número de DPS (opcional)'}</label>
                    <input class="s-input" id="nfseNum" inputmode="numeric" autocomplete="off" value={A.numeroInicial ?? ''} placeholder="1" />
                </div>
            </div>
            <p class="nfse-hint">{en
                ? 'Cord declares one service per NFS-e (all the lines of the invoice under the code above), provided in your municipality, with ISS included in the price: lines cannot add tax on top. Services taxed where they are provided, construction works, events, exports and federal withholdings are not issued by Cord yet. Use a DPS series that no other system of yours uses.'
                : 'Cord declara un servicio por NFS-e (todos los conceptos de la factura con el código de arriba), prestado en tu municipio y con el ISS incluido en el precio: los conceptos no pueden sumar impuesto. Los servicios que tributan donde se prestan, obras, eventos, exportaciones y retenciones federales todavía no los emite Cord. Usa una serie de DPS que no use ningún otro sistema tuyo.'}</p>
            <div class="nfse-actions">
                <button type="button" class="nfse-btn-solid" data-nfse-save>{en ? 'Save NFS-e settings' : 'Guardar ajustes de la NFS-e'}</button>
                <span class="nfse-msg" data-nfse-msg-ajustes></span>
            </div>

            <div class="nfse-cert">
                <span class="nfse-cert-title">{en ? 'ICP-Brasil digital certificate (A1)' : 'Certificado digital ICP-Brasil (A1)'}</span>
                <div class="nfse-mode" role="radiogroup" aria-label={en ? 'Certificate format' : 'Formato del certificado'}>
                    <label><input type="radio" name="nfseModo" value="p12" checked /> {en ? '.pfx / .p12 file' : 'Archivo .pfx / .p12'}</label>
                    <label><input type="radio" name="nfseModo" value="pem" /> {en ? 'Certificate + private key' : 'Certificado + llave privada'}</label>
                </div>
                <div class="nfse-files is-single" data-nfse-p12>
                    <label class="nfse-drop">
                        <input type="file" id="nfseP12" accept=".pfx,.p12" />
                        <span class="nfse-drop-ico">.pfx</span>
                        <span class="nfse-drop-t">{en ? 'e-CNPJ certificate' : 'Certificado e-CNPJ'}</span>
                        <span class="nfse-drop-s" data-nfse-name="nfseP12">{en ? 'Choose your .pfx/.p12 file' : 'Elige tu archivo .pfx/.p12'}</span>
                    </label>
                </div>
                <div class="nfse-files" data-nfse-pem hidden>
                    <label class="nfse-drop">
                        <input type="file" id="nfseCrt" accept=".crt,.pem,.cer" />
                        <span class="nfse-drop-ico">.crt</span>
                        <span class="nfse-drop-t">{en ? 'Certificate' : 'Certificado'}</span>
                        <span class="nfse-drop-s" data-nfse-name="nfseCrt">{en ? 'Issued to your CNPJ' : 'Emitido para tu CNPJ'}</span>
                    </label>
                    <label class="nfse-drop">
                        <input type="file" id="nfseKey" accept=".key,.pem" />
                        <span class="nfse-drop-ico">.key</span>
                        <span class="nfse-drop-t">{en ? 'Private key' : 'Llave privada'}</span>
                        <span class="nfse-drop-s" data-nfse-name="nfseKey">{en ? 'The key of that certificate' : 'La llave de ese certificado'}</span>
                    </label>
                </div>
                <div class="s-field nfse-pass">
                    <label for="nfsePass">{en ? 'Certificate password' : 'Contraseña del certificado'}</label>
                    <input class="s-input" id="nfsePass" type="password" autocomplete="off" />
                </div>
                <div class="nfse-actions">
                    <button type="button" class="nfse-btn-solid" data-nfse-upload>{en ? 'Upload certificate' : 'Subir certificado'}</button>
                    <span class="nfse-msg" data-nfse-msg-cert></span>
                </div>
            </div>
        </Fragment>
    )}
</div>

<style>
    .nfse-intro { font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.55; margin: 0 0 0.8rem; }
    .nfse-state { display: flex; align-items: center; gap: 11px; border: 1px solid var(--color-border); border-radius: 10px; padding: 12px 14px; margin: 0.4rem 0 1.2rem; }
    .nfse-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--color-text-muted); flex-shrink: 0; }
    .nfse-state[data-on="1"] .nfse-dot { background: var(--color-ok); box-shadow: 0 0 0 3px rgba(16,185,129,0.18); }
    .nfse-state-info { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .nfse-state-title { font-size: 0.86rem; font-weight: 600; color: var(--color-text); }
    .nfse-state-sub { font-size: 0.76rem; color: var(--color-text-muted); line-height: 1.45; }
    .nfse-state-err { font-size: 0.76rem; color: var(--color-err, #c0392b); line-height: 1.45; }
    .nfse-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1rem; }
    .nfse-wide { grid-column: 1 / -1; }
    .nfse-help { display: block; font-size: 0.72rem; color: var(--color-text-muted); margin-top: 4px; }
    .nfse-hint { font-size: 0.76rem; color: var(--color-text-muted); line-height: 1.5; margin: 0.8rem 0 0; }
    .nfse-cert { border-top: 1px solid var(--color-border); margin-top: 1.4rem; padding-top: 1.2rem; }
    .nfse-cert-title { display: block; font-size: 0.84rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.7rem; }
    .nfse-mode { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; font-size: 0.8rem; color: var(--color-text); margin-bottom: 0.9rem; }
    .nfse-mode label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; min-height: 32px; }
    .nfse-files { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .nfse-files.is-single { grid-template-columns: minmax(0, 260px); }
    .nfse-files[hidden] { display: none; }
    .nfse-drop { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; border: 1.5px dashed var(--color-border); border-radius: 12px; padding: 1.2rem 1rem; cursor: pointer; background: var(--color-bg-soft); transition: border-color 0.2s, background 0.2s; }
    .nfse-drop:hover { border-color: var(--color-blue-deep); }
    .nfse-drop.has-file { border-style: solid; border-color: var(--color-ok); background: rgba(16,185,129,0.06); }
    .nfse-drop input { display: none; }
    .nfse-drop:focus-within { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }
    .nfse-drop-ico { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; color: var(--color-blue-deep); }
    .nfse-drop-t { font-size: 0.82rem; font-weight: 600; color: var(--color-text); }
    .nfse-drop-s { font-size: 0.72rem; color: var(--color-text-muted); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .nfse-pass { max-width: 50%; margin-top: 1rem; }
    .nfse-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.1rem; }
    .nfse-btn-solid { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 999px; padding: 9px 18px; cursor: pointer; transition: transform 0.2s var(--ease-spring), opacity 0.2s; }
    .nfse-btn-solid:hover { transform: scale(1.02); }
    .nfse-btn-solid:active { transform: scale(0.98); }
    .nfse-btn-solid:disabled { opacity: 0.6; cursor: progress; transform: none; }
    .nfse-btn-ghost { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; color: var(--color-text); background: transparent; border: 1px solid var(--color-border); border-radius: 999px; padding: 7px 14px; cursor: pointer; }
    .nfse-msg { font-size: 0.78rem; line-height: 1.45; }
    .nfse-msg.ok { color: var(--color-ok); }
    .nfse-msg.err { color: var(--color-err, #c0392b); }
    @media (max-width: 880px) {
        .nfse-grid, .nfse-files { grid-template-columns: 1fr; }
        .nfse-pass { max-width: none; }
        .nfse-btn-solid, .nfse-btn-ghost { min-height: 44px; }
    }
</style>

<script>
    // Etiquetas de lo que falta: el servidor manda códigos, la pantalla los dice.
    const FALTANTE: Record<string, [string, string]> = {
        documento: ['CNPJ (o CPF) del negocio', 'your business CNPJ (or CPF)'],
        municipio: ['municipio del establecimiento (código IBGE)', 'the municipality of your establishment (IBGE code)'],
        serie: ['serie de la DPS', 'the DPS series'],
        regime: ['situación ante el Simples Nacional', 'your Simples Nacional status'],
        regime_sn: ['régimen de apuración del Simples Nacional', 'your Simples Nacional assessment regime'],
        aliquota_simples: ['porcentaje de tributos del Simples Nacional', 'your Simples Nacional tax percentage'],
        servico: ['código del servicio (lista nacional)', 'the service code (national list)'],
        certificado: ['certificado digital ICP-Brasil', 'the ICP-Brasil digital certificate'],
        certificado_vencido: ['certificado digital vigente', 'a valid digital certificate'],
        certificado_documento: ['certificado a nombre del CNPJ del negocio', 'a certificate issued to your business CNPJ'],
    };

    function initNfse() {
        const root = document.querySelector<HTMLElement>('[data-nfse]');
        if (!root) return;
        const en = document.documentElement.lang === 'en';
        const i = en ? 1 : 0;
        const q = <T extends Element>(s: string) => root.querySelector<T>(s);
        const state = q<HTMLElement>('[data-nfse-state]');
        const title = q<HTMLElement>('[data-nfse-title]');
        const sub = q<HTMLElement>('[data-nfse-sub]');
        const removeBtn = q<HTMLButtonElement>('[data-nfse-remove]');
        const saveBtn = q<HTMLButtonElement>('[data-nfse-save]');
        const uploadBtn = q<HTMLButtonElement>('[data-nfse-upload]');
        if (!state || !saveBtn || !uploadBtn) return;
        const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';

        // Los campos del Simples Nacional solo aplican a ME/EPP.
        const opSel = document.getElementById('nfseOp') as HTMLSelectElement | null;
        const soloSn = () => root.querySelectorAll<HTMLElement>('[data-nfse-solo-sn]').forEach((el) => { el.hidden = opSel?.value !== '3'; });
        opSel?.addEventListener('change', soloSn);
        soloSn();

        const flash = (sel: string, text: string, ok: boolean, sticky = false) => {
            const el = q<HTMLElement>(sel);
            if (!el) return;
            el.textContent = text;
            el.className = 'nfse-msg ' + (ok ? 'ok' : 'err');
            if (ok && !sticky) setTimeout(() => { el.textContent = ''; el.className = 'nfse-msg'; }, 5000);
        };

        // Repinta el estado con la vista que devuelve /api/fiscal/nfse.
        const pintar = (v: any) => {
            const prueba = v.entorno === 'homologacion';
            state.setAttribute('data-on', v.listo ? '1' : '0');
            if (title) title.textContent = v.listo
                ? (prueba ? (en ? 'Connected to the NFS-e test environment' : 'Conectado al ambiente de pruebas de la NFS-e') : (en ? 'NFS-e active' : 'NFS-e activa'))
                : (en ? 'Not connected yet' : 'Aún sin conectar');
            if (sub) sub.textContent = v.listo
                ? (prueba
                    ? (en ? 'NFS-e are generated in the restricted production (test) environment and have no legal validity.' : 'Las NFS-e se generan en el ambiente de producción restringida (pruebas) y no tienen validez jurídica.')
                    : (en ? `Certificate valid until ${v.credencial?.caduca} · ${v.credencial?.identificador}` : `Certificado vigente hasta ${v.credencial?.caduca} · ${v.credencial?.identificador}`))
                : (en ? 'Missing: ' : 'Falta: ') + (v.faltantes || []).map((f: string) => FALTANTE[f]?.[i] ?? f).join(', ') + '.';
            const verif = q<HTMLElement>('[data-nfse-verif]');
            if (verif) verif.remove();
            if (v.credencial?.verificacion_error) {
                const e = document.createElement('span');
                e.className = 'nfse-state-err';
                e.setAttribute('data-nfse-verif', '');
                e.textContent = v.credencial.verificacion_error;
                sub?.after(e);
            }
            const mun = q<HTMLElement>('[data-nfse-mun-nome]');
            if (mun && v.municipio) mun.textContent = `${v.municipio.nome} / ${v.municipio.uf}`;
            if (removeBtn) removeBtn.style.display = v.credencial ? '' : 'none';
        };

        // Formato del certificado: .pfx/.p12, o .crt + .key.
        const pem = q<HTMLElement>('[data-nfse-pem]');
        const p12 = q<HTMLElement>('[data-nfse-p12]');
        root.querySelectorAll<HTMLInputElement>('input[name="nfseModo"]').forEach((r) => r.addEventListener('change', () => {
            const esPem = r.value === 'pem' && r.checked;
            if (pem) pem.hidden = !esPem;
            if (p12) p12.hidden = esPem;
        }));
        root.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((input) => input.addEventListener('change', () => {
            const f = input.files?.[0];
            const name = q<HTMLElement>(`[data-nfse-name="${input.id}"]`);
            if (name && f) name.textContent = f.name;
            input.closest('.nfse-drop')?.classList.toggle('has-file', !!f);
        }));

        saveBtn.addEventListener('click', async () => {
            const body = {
                municipio: val('nfseMun'),
                inscricao_municipal: val('nfseIm'),
                op_simples: val('nfseOp') === '' ? undefined : Number(val('nfseOp')),
                reg_ap_simples: val('nfseRegAp'),
                aliquota_simples: val('nfseAliqSn'),
                reg_especial: Number(val('nfseRegEsp') || 0),
                servico: val('nfseServ'),
                servico_municipal: val('nfseServMun'),
                retencao_iss_id: val('nfseRet'),
                serie: val('nfseSerie'),
                numero_inicial: val('nfseNum'),
            };
            saveBtn.disabled = true;
            try {
                const res = await fetch('/api/fiscal/nfse', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                const d = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(d.error || '');
                pintar(d);
                flash('[data-nfse-msg-ajustes]', d.aviso || (en ? 'NFS-e settings saved.' : 'Ajustes de la NFS-e guardados.'), !d.aviso, !!d.aviso);
            } catch (err: any) {
                flash('[data-nfse-msg-ajustes]', err?.message || (en ? 'Could not save the NFS-e settings' : 'No se pudieron guardar los ajustes de la NFS-e'), false);
            } finally { saveBtn.disabled = false; }
        });

        uploadBtn.addEventListener('click', async () => {
            const modoPem = !!root.querySelector<HTMLInputElement>('input[name="nfseModo"][value="pem"]:checked');
            const pass = (document.getElementById('nfsePass') as HTMLInputElement | null)?.value ?? '';
            const fd = new FormData();
            if (!modoPem) {
                const f = (document.getElementById('nfseP12') as HTMLInputElement | null)?.files?.[0];
                if (!f) { flash('[data-nfse-msg-cert]', en ? 'Choose your .pfx/.p12 file first.' : 'Elige primero tu archivo .pfx/.p12.', false); return; }
                fd.append('p12', f);
                fd.append('password', pass);
            } else {
                const crt = (document.getElementById('nfseCrt') as HTMLInputElement | null)?.files?.[0];
                const key = (document.getElementById('nfseKey') as HTMLInputElement | null)?.files?.[0];
                if (!crt || !key) { flash('[data-nfse-msg-cert]', en ? 'Choose the certificate and its private key.' : 'Elige el certificado y su llave privada.', false); return; }
                fd.append('crt', crt);
                fd.append('key', key);
                if (pass) fd.append('key_password', pass);
            }
            uploadBtn.disabled = true;
            const orig = uploadBtn.textContent;
            uploadBtn.textContent = en ? 'Uploading…' : 'Subiendo…';
            try {
                const res = await fetch('/api/fiscal/nfse', { method: 'POST', body: fd });
                const d = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(d.error || '');
                const passIn = document.getElementById('nfsePass') as HTMLInputElement | null;
                if (passIn) passIn.value = '';
                pintar(d);
                flash('[data-nfse-msg-cert]', d.aviso || (en ? 'Certificate uploaded.' : 'Certificado cargado.'), !d.aviso, !!d.aviso);
                if (!d.aviso) (window as any).cordToast?.(en ? 'Digital certificate uploaded' : 'Certificado digital cargado', 'ok');
            } catch (err: any) {
                flash('[data-nfse-msg-cert]', err?.message || (en ? 'Could not upload the certificate' : 'No se pudo subir el certificado'), false);
            } finally { uploadBtn.disabled = false; uploadBtn.textContent = orig; }
        });

        removeBtn?.addEventListener('click', async () => {
            const ok = await (window as any).cordConfirm?.({
                title: en ? 'Disconnect the NFS-e' : 'Desconectar la NFS-e',
                body: en
                    ? 'New invoices will be issued as commercial documents, without an NFS-e, until you upload a certificate again. Disconnect?'
                    : 'Las facturas nuevas se emitirán como documento comercial, sin NFS-e, hasta que subas un certificado de nuevo. ¿Desconectar?',
                danger: true,
                confirmText: en ? 'Disconnect' : 'Desconectar',
            });
            if (!ok) return;
            removeBtn.disabled = true;
            try {
                const res = await fetch('/api/fiscal/nfse', { method: 'DELETE' });
                const d = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(res.status === 409 && typeof d.error === 'string' ? d.error : '');
                pintar(d);
                flash('[data-nfse-msg-cert]', en ? 'Digital certificate disconnected.' : 'Certificado digital desconectado.', true);
            } catch (err: any) {
                flash('[data-nfse-msg-cert]', err?.message || (en ? 'Could not disconnect the certificate' : 'No se pudo desconectar el certificado'), false);
            } finally { removeBtn.disabled = false; }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initNfse);
    else initNfse();
</script>
