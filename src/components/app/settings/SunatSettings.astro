---
// Ajustes › Datos fiscales › Factura electrónica con SUNAT (Perú).
//
// Lo que el negocio aporta (certificado digital de su RUC, usuario SOL
// secundario, serie y cómo se declaran sus ventas) y un estado honesto:
// mientras falte cualquiera, o mientras Cord no tenga SUNAT activo, las
// facturas siguen como documento comercial y aquí se dice exactamente eso
// (regla 15). Sin SUNAT activo en el despliegue no se ofrece ningún control.
//
// El certificado, su llave y la clave SOL viajan una sola vez (multipart a
// /api/fiscal/sunat) y nunca vuelven: la pantalla conoce el resumen.
import type { EstadoSunat } from '../../../lib/fiscal/latam/sunat/estado';

interface Props { estado: EstadoSunat; locale: 'es' | 'en'; }
const { estado, locale } = Astro.props;
const en = locale === 'en';

const FALTANTE: Record<string, [string, string]> = {
    ruc: ['el RUC de tu negocio (arriba, en Identidad de facturación)', 'your business RUC (above, under Invoice identity)'],
    razon_social: ['la razón social (arriba)', 'the legal name (above)'],
    serie: ['la serie de facturas', 'the invoice series'],
    concepto: ['qué vendes', 'what you sell'],
    certificado: ['el certificado digital', 'the digital certificate'],
    certificado_vencido: ['un certificado vigente (el actual venció)', 'a valid certificate (the current one expired)'],
    certificado_ruc: ['un certificado a nombre de tu RUC', 'a certificate issued to your RUC'],
    usuario_sol: ['el usuario SOL secundario y su clave', 'the secondary SOL user and its password'],
    detracciones: ['facturas con detracción, que Cord todavía no emite', 'invoices with SPOT withholding, which Cord does not issue yet'],
    percepcion: ['facturas con percepción del IGV, que Cord todavía no emite', 'invoices with IGV perception, which Cord does not issue yet'],
};
const faltantes = estado.faltantes.map((f) => FALTANTE[f]?.[en ? 1 : 0] ?? f);
const prueba = estado.entorno === 'homologacion';
const cred = estado.credencial;
const caduca = cred?.caduca?.slice(0, 10) ?? '';
const titulo = !estado.habilitado
    ? (en ? 'Coming soon' : 'Próximamente')
    : estado.listo
        ? (prueba ? (en ? 'Connected to the SUNAT test service (beta)' : 'Conectado al servicio de pruebas (beta) de SUNAT') : (en ? 'Electronic invoicing with SUNAT active' : 'Factura electrónica con SUNAT activa'))
        : (en ? 'Not connected yet' : 'Aún sin conectar');
const sub = estado.listo
    ? (prueba
        ? (en ? 'Invoices are sent to the SUNAT test service and have no tax validity.' : 'Las facturas se envían al servicio de pruebas de SUNAT y no tienen validez fiscal.')
        : (en ? `Certificate valid until ${caduca} · RUC ${cred?.identificador}` : `Certificado vigente hasta ${caduca} · RUC ${cred?.identificador}`))
    : (en ? `Missing: ${faltantes.join(', ')}.` : `Falta: ${faltantes.join(', ')}.`);
const A = estado.ajustes;
---

<div class="sunat" data-sunat data-entorno={estado.entorno}>
    <p class="sunat-intro">{en
        ? 'In Peru each invoice must be sent to SUNAT, which accepts it with a receipt (CDR). Connect your digital certificate and your secondary SOL user so Cord signs every invoice and credit note, sends it to SUNAT and prints the QR code and the hash on the PDF. Until then, invoices are issued as commercial documents without tax validity.'
        : 'En Perú cada factura se envía a SUNAT, que la acepta con una constancia de recepción (CDR). Conecta el certificado digital de tu negocio y tu usuario SOL secundario para que Cord firme cada factura y nota de crédito, la envíe a SUNAT e imprima el código QR y el valor resumen en el PDF. Mientras tanto, las facturas se emiten como documento comercial sin validez fiscal.'}</p>

    <div class="sunat-state" data-on={estado.listo ? '1' : '0'} data-sunat-state>
        <span class="sunat-dot" aria-hidden="true"></span>
        <span class="sunat-state-info">
            <span class="sunat-state-title" data-sunat-title>{titulo}</span>
            <span class="sunat-state-sub" data-sunat-sub>{estado.habilitado
                ? sub
                : (en ? 'Electronic invoicing with SUNAT is not available in Cord yet. Your invoices are still issued as commercial documents; we will let you know when you can connect it.' : 'La factura electrónica con SUNAT todavía no está disponible en Cord. Tus facturas se siguen emitiendo como documento comercial; te avisaremos cuando puedas conectarla.')}</span>
            {estado.habilitado && cred?.verificacionError && (
                <span class="sunat-state-err" data-sunat-verif>{cred.verificacionError}</span>
            )}
        </span>
        {estado.habilitado && (
            <button type="button" class="sunat-btn-ghost" data-sunat-remove style={cred ? '' : 'display:none'}>
                {en ? 'Disconnect' : 'Desconectar'}
            </button>
        )}
    </div>

    {estado.habilitado && (
        <Fragment>
            <div class="sunat-grid">
                <div class="s-field">
                    <label for="sunatSerie">{en ? 'Invoice series' : 'Serie de facturas'}</label>
                    <input class="s-input" id="sunatSerie" value={A.serie ?? ''} placeholder="F001" maxlength="4" autocomplete="off" />
                </div>
                <div class="s-field">
                    <label for="sunatConcepto">{en ? 'What you sell' : 'Qué vendes'}</label>
                    <select class="s-input" id="sunatConcepto">
                        <option value="" selected={!A.concepto}>{en ? 'Choose…' : 'Elige…'}</option>
                        <option value="bienes" selected={A.concepto === 'bienes'}>{en ? 'Goods' : 'Bienes'}</option>
                        <option value="servicios" selected={A.concepto === 'servicios'}>{en ? 'Services' : 'Servicios'}</option>
                    </select>
                </div>
                <div class="s-field">
                    <label for="sunatUltF">{en ? 'Last invoice number issued outside Cord' : 'Último número de factura emitido fuera de Cord'}</label>
                    <input class="s-input" id="sunatUltF" type="number" inputmode="numeric" min="0" step="1" value={A.ultimoNumeroFactura ?? ''} placeholder="0" />
                </div>
                <div class="s-field">
                    <label for="sunatUltNc">{en ? 'Last credit note number issued outside Cord' : 'Último número de nota de crédito emitido fuera de Cord'}</label>
                    <input class="s-input" id="sunatUltNc" type="number" inputmode="numeric" min="0" step="1" value={A.ultimoNumeroNotaCredito ?? ''} placeholder="0" />
                </div>
                <div class="s-field">
                    <label for="sunatSinIgv">{en ? 'Items without IGV are' : 'Tus conceptos sin IGV son'}</label>
                    <select class="s-input" id="sunatSinIgv">
                        <option value="" selected={!A.afectacionSinIgv}>{en ? 'Choose…' : 'Elige…'}</option>
                        <option value="20" selected={A.afectacionSinIgv === '20'}>{en ? 'Exempt (exonerado)' : 'Exonerados'}</option>
                        <option value="30" selected={A.afectacionSinIgv === '30'}>{en ? 'Not subject (inafecto)' : 'Inafectos'}</option>
                    </select>
                </div>
                <div class="s-field">
                    <label for="sunatEst">{en ? 'Establishment code' : 'Código de establecimiento'}</label>
                    <input class="s-input" id="sunatEst" value={A.establecimiento ?? ''} placeholder="0000" maxlength="4" inputmode="numeric" autocomplete="off" />
                </div>
                <div class="s-field">
                    <label for="sunatNombre">{en ? 'Trade name (optional)' : 'Nombre comercial (opcional)'}</label>
                    <input class="s-input" id="sunatNombre" value={A.nombreComercial ?? ''} maxlength="200" autocomplete="off" />
                </div>
            </div>
            <div class="sunat-checks">
                <label><input type="checkbox" id="sunatMype" checked={!!A.regimenMype} /> {en ? 'Small restaurant, hotel or lodging business under the reduced IGV regime (Law 31556)' : 'MYPE de restaurantes, hoteles o alojamientos turísticos con IGV reducido (Ley 31556)'}</label>
                <label><input type="checkbox" id="sunatSpot" checked={!!A.detracciones} /> {en ? 'I sell goods or services subject to the SPOT withholding system (detracciones)' : 'Vendo bienes o servicios sujetos al sistema de detracciones (SPOT)'}</label>
                <label><input type="checkbox" id="sunatPerc" checked={!!A.agentePercepcion} /> {en ? 'I am an IGV perception agent' : 'Soy agente de percepción del IGV'}</label>
                <label><input type="checkbox" id="sunatExcl" checked={!!A.excluidoRetenciones} /> {en ? 'My customers do not withhold IGV from me (good taxpayer, withholding or perception agent)' : 'No me retienen IGV (buen contribuyente, agente de retención o de percepción)'}</label>
            </div>
            <div class="s-field sunat-wide">
                <label for="sunatAgentes">{en ? 'RUC of customers that are IGV withholding agents' : 'RUC de tus clientes que son agentes de retención del IGV'}</label>
                <textarea class="s-input" id="sunatAgentes" rows="2" placeholder="20100066603, 20131312955">{(A.agentesRetencion ?? []).join(', ')}</textarea>
            </div>
            <p class="sunat-hint">{en
                ? 'Use a series dedicated to Cord (for example F001) and, if you already issued invoices in it from another system, write the last number so Cord continues after it. A customer that is a withholding agent keeps 3 % of credit invoices above S/ 700: the invoice declares the net amount pending. Cord does not issue boletas, nor invoices with SPOT or IGV perception yet.'
                : 'Usa una serie dedicada a Cord (por ejemplo F001) y, si ya emitiste facturas en ella desde otro sistema, escribe el último número para que Cord continúe después. Un cliente agente de retención retiene el 3 % de las facturas al crédito de más de S/ 700: la factura declara el monto neto pendiente. Cord todavía no emite boletas, ni facturas con detracción o percepción.'}</p>
            <div class="sunat-actions">
                <button type="button" class="sunat-btn-solid" data-sunat-save>{en ? 'Save SUNAT settings' : 'Guardar ajustes de SUNAT'}</button>
                <span class="sunat-msg" data-sunat-msg-ajustes></span>
            </div>

            <div class="sunat-cert">
                <span class="sunat-cert-title">{en ? 'Secondary SOL user' : 'Usuario SOL secundario'}</span>
                <div class="sunat-grid">
                    <div class="s-field">
                        <label for="sunatUsuario">{en ? 'User (without the RUC)' : 'Usuario (sin el RUC)'}</label>
                        <input class="s-input" id="sunatUsuario" value={estado.usuarioSol ?? ''} maxlength="20" autocomplete="off" />
                    </div>
                    <div class="s-field">
                        <label for="sunatClave">{en ? 'Password' : 'Clave SOL'}</label>
                        <input class="s-input" id="sunatClave" type="password" autocomplete="new-password" />
                    </div>
                </div>
                <p class="sunat-hint">{prueba
                    ? (en ? 'In the SUNAT test service any user works; in production it must be a secondary user with the electronic document sending profile.' : 'En el servicio de pruebas de SUNAT cualquier usuario sirve; en producción debe ser un usuario secundario con el perfil de envío de comprobantes electrónicos.')
                    : (en ? 'Create it in SUNAT Operaciones en Línea as a secondary user with the electronic document sending profile.' : 'Créalo en SUNAT Operaciones en Línea como usuario secundario con el perfil de envío de comprobantes electrónicos.')}</p>
                <div class="sunat-actions">
                    <button type="button" class="sunat-btn-solid" data-sunat-sol>{en ? 'Save SOL user' : 'Guardar usuario SOL'}</button>
                    <span class="sunat-msg" data-sunat-msg-sol></span>
                </div>
            </div>

            <div class="sunat-cert">
                <span class="sunat-cert-title">{en ? 'Digital certificate' : 'Certificado digital'}</span>
                <div class="sunat-mode" role="radiogroup" aria-label={en ? 'Certificate format' : 'Formato del certificado'}>
                    <label><input type="radio" name="sunatModo" value="p12" checked /> {en ? '.p12 / .pfx file' : 'Archivo .p12 / .pfx'}</label>
                    <label><input type="radio" name="sunatModo" value="pem" /> {en ? 'Certificate + private key' : 'Certificado + llave privada'}</label>
                </div>
                <div class="sunat-files is-single" data-sunat-p12>
                    <label class="sunat-drop">
                        <input type="file" id="sunatP12" accept=".p12,.pfx" />
                        <span class="sunat-drop-ico">.p12</span>
                        <span class="sunat-drop-t">{en ? 'Certificate with key' : 'Certificado con llave'}</span>
                        <span class="sunat-drop-s" data-sunat-name="sunatP12">{en ? 'Issued for your RUC' : 'Emitido para tu RUC'}</span>
                    </label>
                </div>
                <div class="sunat-files" data-sunat-pem hidden>
                    <label class="sunat-drop">
                        <input type="file" id="sunatCrt" accept=".crt,.pem,.cer" />
                        <span class="sunat-drop-ico">.crt</span>
                        <span class="sunat-drop-t">{en ? 'Certificate' : 'Certificado'}</span>
                        <span class="sunat-drop-s" data-sunat-name="sunatCrt">{en ? 'Issued for your RUC' : 'Emitido para tu RUC'}</span>
                    </label>
                    <label class="sunat-drop">
                        <input type="file" id="sunatKey" accept=".key,.pem" />
                        <span class="sunat-drop-ico">.key</span>
                        <span class="sunat-drop-t">{en ? 'Private key' : 'Llave privada'}</span>
                        <span class="sunat-drop-s" data-sunat-name="sunatKey">{en ? 'The one that matches the certificate' : 'La que corresponde al certificado'}</span>
                    </label>
                </div>
                <div class="s-field sunat-pass">
                    <label for="sunatPass">{en ? 'Password (if it has one)' : 'Contraseña (si tiene)'}</label>
                    <input class="s-input" id="sunatPass" type="password" autocomplete="off" />
                </div>
                <p class="sunat-hint">{en
                    ? 'The certificate must name your RUC and, in production, be registered with SUNAT (Operaciones en Línea, digital certificate update).'
                    : 'El certificado debe mencionar tu RUC y, en producción, estar registrado en SUNAT (Operaciones en Línea, actualización de certificado digital).'}</p>
                <div class="sunat-actions">
                    <button type="button" class="sunat-btn-solid" data-sunat-upload>{en ? 'Upload certificate' : 'Subir certificado'}</button>
                    <span class="sunat-msg" data-sunat-msg-cert></span>
                </div>
            </div>
        </Fragment>
    )}
</div>

<style>
    .sunat-intro { font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.55; margin: 0 0 1.1rem; }
    .sunat-state { display: flex; align-items: center; gap: 11px; border: 1px solid var(--color-border); border-radius: 10px; padding: 12px 14px; margin-bottom: 1.2rem; }
    .sunat-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--color-text-muted); flex-shrink: 0; }
    .sunat-state[data-on="1"] .sunat-dot { background: var(--color-ok); box-shadow: 0 0 0 3px rgba(16,185,129,0.18); }
    .sunat-state-info { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .sunat-state-title { font-size: 0.86rem; font-weight: 600; color: var(--color-text); }
    .sunat-state-sub { font-size: 0.76rem; color: var(--color-text-muted); line-height: 1.45; }
    .sunat-state-err { font-size: 0.76rem; color: var(--color-err, #c0392b); line-height: 1.45; }
    .sunat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1rem; }
    .sunat-wide { margin-top: 0.9rem; }
    .sunat-checks { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 1rem; font-size: 0.8rem; color: var(--color-text); }
    .sunat-checks label { display: flex; align-items: flex-start; gap: 8px; cursor: pointer; min-height: 32px; line-height: 1.45; }
    .sunat-checks input { margin-top: 3px; }
    .sunat-hint { font-size: 0.76rem; color: var(--color-text-muted); line-height: 1.5; margin: 0.8rem 0 0; }
    .sunat-cert { border-top: 1px solid var(--color-border); margin-top: 1.4rem; padding-top: 1.2rem; }
    .sunat-cert-title { display: block; font-size: 0.84rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.7rem; }
    .sunat-mode { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; font-size: 0.8rem; color: var(--color-text); margin-bottom: 0.9rem; }
    .sunat-mode label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; min-height: 32px; }
    .sunat-files { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .sunat-files.is-single { grid-template-columns: minmax(0, 260px); }
    .sunat-files[hidden] { display: none; }
    .sunat-drop { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; border: 1.5px dashed var(--color-border); border-radius: 12px; padding: 1.2rem 1rem; cursor: pointer; background: var(--color-bg-soft); transition: border-color 0.2s, background 0.2s; }
    .sunat-drop:hover { border-color: var(--color-blue-deep); }
    .sunat-drop.has-file { border-style: solid; border-color: var(--color-ok); background: rgba(16,185,129,0.06); }
    .sunat-drop input { display: none; }
    .sunat-drop:focus-within { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }
    .sunat-drop-ico { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; color: var(--color-blue-deep); }
    .sunat-drop-t { font-size: 0.82rem; font-weight: 600; color: var(--color-text); }
    .sunat-drop-s { font-size: 0.72rem; color: var(--color-text-muted); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sunat-pass { max-width: 50%; margin-top: 1rem; }
    .sunat-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.1rem; }
    .sunat-btn-solid { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 999px; padding: 9px 18px; cursor: pointer; transition: transform 0.2s var(--ease-spring), opacity 0.2s; }
    .sunat-btn-solid:hover { transform: scale(1.02); }
    .sunat-btn-solid:active { transform: scale(0.98); }
    .sunat-btn-solid:disabled { opacity: 0.6; cursor: progress; transform: none; }
    .sunat-btn-ghost { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; color: var(--color-text); background: transparent; border: 1px solid var(--color-border); border-radius: 999px; padding: 7px 14px; cursor: pointer; }
    .sunat-msg { font-size: 0.78rem; line-height: 1.45; }
    .sunat-msg.ok { color: var(--color-ok); }
    .sunat-msg.err { color: var(--color-err, #c0392b); }
    @media (max-width: 880px) {
        .sunat-grid, .sunat-files { grid-template-columns: 1fr; }
        .sunat-pass { max-width: none; }
        .sunat-btn-solid, .sunat-btn-ghost { min-height: 44px; }
        .sunat-checks label { min-height: 44px; }
    }
</style>

<script>
    // Etiquetas de lo que falta: el servidor manda códigos, la pantalla los dice.
    const FALTANTE: Record<string, [string, string]> = {
        ruc: ['el RUC de tu negocio (arriba, en Identidad de facturación)', 'your business RUC (above, under Invoice identity)'],
        razon_social: ['la razón social (arriba)', 'the legal name (above)'],
        serie: ['la serie de facturas', 'the invoice series'],
        concepto: ['qué vendes', 'what you sell'],
        certificado: ['el certificado digital', 'the digital certificate'],
        certificado_vencido: ['un certificado vigente (el actual venció)', 'a valid certificate (the current one expired)'],
        certificado_ruc: ['un certificado a nombre de tu RUC', 'a certificate issued to your RUC'],
        usuario_sol: ['el usuario SOL secundario y su clave', 'the secondary SOL user and its password'],
        detracciones: ['facturas con detracción, que Cord todavía no emite', 'invoices with SPOT withholding, which Cord does not issue yet'],
        percepcion: ['facturas con percepción del IGV, que Cord todavía no emite', 'invoices with IGV perception, which Cord does not issue yet'],
    };

    function initSunat() {
        const root = document.querySelector<HTMLElement>('[data-sunat]');
        if (!root) return;
        const en = document.documentElement.lang === 'en';
        const i = en ? 1 : 0;
        const q = <T extends Element>(s: string) => root.querySelector<T>(s);
        const state = q<HTMLElement>('[data-sunat-state]');
        const title = q<HTMLElement>('[data-sunat-title]');
        const sub = q<HTMLElement>('[data-sunat-sub]');
        const removeBtn = q<HTMLButtonElement>('[data-sunat-remove]');
        const saveBtn = q<HTMLButtonElement>('[data-sunat-save]');
        const solBtn = q<HTMLButtonElement>('[data-sunat-sol]');
        const uploadBtn = q<HTMLButtonElement>('[data-sunat-upload]');
        if (!state || !saveBtn || !uploadBtn || !solBtn) return;
        const prueba = root.dataset.entorno === 'homologacion';

        const flash = (sel: string, text: string, ok: boolean, sticky = false) => {
            const el = q<HTMLElement>(sel);
            if (!el) return;
            el.textContent = text;
            el.className = 'sunat-msg ' + (ok ? 'ok' : 'err');
            if (ok && !sticky) setTimeout(() => { el.textContent = ''; el.className = 'sunat-msg'; }, 5000);
        };

        // Repinta el estado con la vista que devuelve /api/fiscal/sunat.
        const pintar = (v: any) => {
            state.setAttribute('data-on', v.listo ? '1' : '0');
            if (title) title.textContent = v.listo
                ? (prueba ? (en ? 'Connected to the SUNAT test service (beta)' : 'Conectado al servicio de pruebas (beta) de SUNAT') : (en ? 'Electronic invoicing with SUNAT active' : 'Factura electrónica con SUNAT activa'))
                : (en ? 'Not connected yet' : 'Aún sin conectar');
            if (sub) sub.textContent = v.listo
                ? (prueba
                    ? (en ? 'Invoices are sent to the SUNAT test service and have no tax validity.' : 'Las facturas se envían al servicio de pruebas de SUNAT y no tienen validez fiscal.')
                    : (en ? `Certificate valid until ${v.credencial?.caduca} · RUC ${v.credencial?.identificador}` : `Certificado vigente hasta ${v.credencial?.caduca} · RUC ${v.credencial?.identificador}`))
                : (en ? 'Missing: ' : 'Falta: ') + (v.faltantes || []).map((f: string) => FALTANTE[f]?.[i] ?? f).join(', ') + '.';
            q<HTMLElement>('[data-sunat-verif]')?.remove();
            if (v.credencial?.verificacion_error) {
                const e = document.createElement('span');
                e.className = 'sunat-state-err';
                e.setAttribute('data-sunat-verif', '');
                e.textContent = v.credencial.verificacion_error;
                sub?.after(e);
            }
            if (removeBtn) removeBtn.style.display = v.credencial ? '' : 'none';
        };

        const enviar = async (method: string, body: BodyInit, json: boolean) => {
            const res = await fetch('/api/fiscal/sunat', { method, body, ...(json ? { headers: { 'Content-Type': 'application/json' } } : {}) });
            const d = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(typeof d.error === 'string' ? d.error : '');
            return d;
        };

        const pem = q<HTMLElement>('[data-sunat-pem]');
        const p12 = q<HTMLElement>('[data-sunat-p12]');
        root.querySelectorAll<HTMLInputElement>('input[name="sunatModo"]').forEach((r) => r.addEventListener('change', () => {
            const esP12 = r.value === 'p12' && r.checked;
            if (pem) pem.hidden = esP12;
            if (p12) p12.hidden = !esP12;
        }));
        root.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((input) => input.addEventListener('change', () => {
            const f = input.files?.[0];
            const name = q<HTMLElement>(`[data-sunat-name="${input.id}"]`);
            if (name && f) name.textContent = f.name;
            input.closest('.sunat-drop')?.classList.toggle('has-file', !!f);
        }));

        const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null)?.value ?? '';
        const marcado = (id: string) => !!(document.getElementById(id) as HTMLInputElement | null)?.checked;

        saveBtn.addEventListener('click', async () => {
            const body = {
                serie: val('sunatSerie').trim() || undefined,
                concepto: val('sunatConcepto') || undefined,
                ultimo_numero_factura: val('sunatUltF'),
                ultimo_numero_nota_credito: val('sunatUltNc'),
                afectacion_sin_igv: val('sunatSinIgv'),
                establecimiento: val('sunatEst'),
                nombre_comercial: val('sunatNombre'),
                regimen_mype: marcado('sunatMype'),
                detracciones: marcado('sunatSpot'),
                agente_percepcion: marcado('sunatPerc'),
                excluido_retenciones: marcado('sunatExcl'),
                agentes_retencion: val('sunatAgentes'),
            };
            saveBtn.disabled = true;
            try {
                const d = await enviar('PATCH', JSON.stringify(body), true);
                pintar(d);
                flash('[data-sunat-msg-ajustes]', d.aviso || (en ? 'SUNAT settings saved.' : 'Ajustes de SUNAT guardados.'), !d.aviso, !!d.aviso);
            } catch (err: any) {
                flash('[data-sunat-msg-ajustes]', err?.message || (en ? 'Could not save the SUNAT settings' : 'No se pudieron guardar los ajustes de SUNAT'), false);
            } finally { saveBtn.disabled = false; }
        });

        solBtn.addEventListener('click', async () => {
            solBtn.disabled = true;
            try {
                const d = await enviar('PATCH', JSON.stringify({ usuario_sol: val('sunatUsuario'), clave_sol: val('sunatClave') }), true);
                const clave = document.getElementById('sunatClave') as HTMLInputElement | null;
                if (clave) clave.value = '';
                pintar(d);
                flash('[data-sunat-msg-sol]', d.aviso || (en ? 'SOL user saved.' : 'Usuario SOL guardado.'), !d.aviso, !!d.aviso);
            } catch (err: any) {
                flash('[data-sunat-msg-sol]', err?.message || (en ? 'Could not save the SOL user' : 'No se pudo guardar el usuario SOL'), false);
            } finally { solBtn.disabled = false; }
        });

        uploadBtn.addEventListener('click', async () => {
            const modoP12 = !!root.querySelector<HTMLInputElement>('input[name="sunatModo"][value="p12"]:checked');
            const pass = val('sunatPass');
            const fd = new FormData();
            if (modoP12) {
                const f = (document.getElementById('sunatP12') as HTMLInputElement | null)?.files?.[0];
                if (!f) { flash('[data-sunat-msg-cert]', en ? 'Choose your .p12/.pfx file first.' : 'Elige primero tu archivo .p12/.pfx.', false); return; }
                fd.append('p12', f);
                fd.append('password', pass);
            } else {
                const crt = (document.getElementById('sunatCrt') as HTMLInputElement | null)?.files?.[0];
                const key = (document.getElementById('sunatKey') as HTMLInputElement | null)?.files?.[0];
                if (!crt || !key) { flash('[data-sunat-msg-cert]', en ? 'Choose the certificate and its private key.' : 'Elige el certificado y su llave privada.', false); return; }
                fd.append('crt', crt);
                fd.append('key', key);
                if (pass) fd.append('key_password', pass);
            }
            uploadBtn.disabled = true;
            const orig = uploadBtn.textContent;
            uploadBtn.textContent = en ? 'Uploading…' : 'Subiendo…';
            try {
                const d = await enviar('POST', fd, false);
                const passIn = document.getElementById('sunatPass') as HTMLInputElement | null;
                if (passIn) passIn.value = '';
                pintar(d);
                flash('[data-sunat-msg-cert]', d.aviso || (en ? 'Certificate uploaded.' : 'Certificado cargado.'), !d.aviso, !!d.aviso);
                if (!d.aviso) (window as any).cordToast?.(en ? 'SUNAT certificate uploaded' : 'Certificado para SUNAT cargado', 'ok');
            } catch (err: any) {
                flash('[data-sunat-msg-cert]', err?.message || (en ? 'Could not upload the certificate' : 'No se pudo subir el certificado'), false);
            } finally { uploadBtn.disabled = false; uploadBtn.textContent = orig; }
        });

        removeBtn?.addEventListener('click', async () => {
            const ok = await (window as any).cordConfirm?.({
                title: en ? 'Disconnect SUNAT' : 'Desconectar SUNAT',
                body: en
                    ? 'New invoices will be issued as commercial documents, without being sent to SUNAT, until you upload a certificate again. Disconnect?'
                    : 'Las facturas nuevas se emitirán como documento comercial, sin enviarse a SUNAT, hasta que subas un certificado de nuevo. ¿Desconectar?',
                danger: true,
                confirmText: en ? 'Disconnect' : 'Desconectar',
            });
            if (!ok) return;
            removeBtn.disabled = true;
            try {
                pintar(await enviar('DELETE', '', false));
                flash('[data-sunat-msg-cert]', en ? 'Certificate disconnected.' : 'Certificado desconectado.', true);
            } catch (err: any) {
                flash('[data-sunat-msg-cert]', err?.message || (en ? 'Could not disconnect the certificate' : 'No se pudo desconectar el certificado'), false);
            } finally { removeBtn.disabled = false; }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSunat);
    else initSunat();
</script>
