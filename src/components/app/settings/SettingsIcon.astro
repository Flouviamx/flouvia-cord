---
import { iconInner, type IconName } from '../../../lib/icons';

interface Props { name?: string; }
const map: Record<string, IconName> = {
    building: 'building', contact: 'id', globe: 'globe', clock: 'clock', document: 'document',
    sliders: 'sliders', shield: 'shield', key: 'key', users: 'clients', card: 'card', chart: 'chart',
    mail: 'mail', link: 'link', archive: 'archive', alert: 'alert', code: 'code',
    bell: 'bell', calendar: 'calendar-clock', quote: 'quote',
};
const { name = 'sliders' } = Astro.props;
---
<svg class="settings-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner(map[name] ?? 'sliders')}></svg>
