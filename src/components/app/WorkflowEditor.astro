        .wfe-branch { width: 100%; }
        .wfe-list { width: 100%; }
        .wfe-panel { position: fixed; z-index: 910; top: auto; left: 0; right: 0; bottom: 0; width: 100%; max-height: 88dvh; border-radius: 22px 22px 0 0; padding-bottom: env(safe-area-inset-bottom); animation-name: wfeSheet; }
        @keyframes wfeSheet { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
