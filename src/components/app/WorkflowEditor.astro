</style>

<script>
    import {
        OPERATORS, TRIGGER_CATEGORIES, WAIT_MAX_DAYS, WORKFLOW_ACTIONS, WORKFLOW_TRIGGERS, MAX_CONDITIONS,
        findAction, findTrigger, type Lang, type WorkflowField,
    } from '../../lib/workflows/catalog';
    import { sanitizeDefinition, validateForPublish, type Condition, type Step, type WorkflowDefinition } from '../../lib/workflows/definition';

    const root = document.querySelector<HTMLElement>('[data-wf-editor]');
    const raw = document.getElementById('wfData')?.textContent;
    if (root && raw) boot(root, JSON.parse(raw));

    function boot(root: HTMLElement, data: any) {
        const L: Lang = data.lang === 'en' ? 'en' : 'es';
        const S = data.str;
        const id: string = data.workflow.id;
        const toast = (msg: string, type: 'ok' | 'error' | 'info' = 'ok') => (window as any).cordToast?.(msg, type);
        const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

        const state = {
            nombre: data.workflow.nombre as string,
            estado: data.workflow.estado as 'draft' | 'active' | 'paused',
            def: sanitizeDefinition(data.workflow.definicion) as WorkflowDefinition,
            publicado: data.workflow.publicado ? JSON.stringify(sanitizeDefinition(data.workflow.publicado)) : null as string | null,
            saved: '',
            selected: null as null | { kind: 'trigger' } | { kind: 'step'; id: string },
            showIssues: false,
            zoom: 1,
        };
        state.saved = snapshot();

        function snapshot() { return JSON.stringify({ n: state.nombre, d: sanitizeDefinition(state.def) }); }
        const isDirty = () => snapshot() !== state.saved;
        const hasUnpublished = () => state.publicado !== null && JSON.stringify(sanitizeDefinition(state.def)) !== state.publicado;

        function el<K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, string | boolean | undefined> = {}, children: (Node | string | null | undefined)[] = []) {
            const node = document.createElement(tag);
            for (const [k, v] of Object.entries(attrs)) {
                if (v === undefined || v === false) continue;
                if (k === 'class') node.className = String(v);
                else if (k === 'text') node.textContent = String(v);
                else node.setAttribute(k, v === true ? '' : String(v));
            }
            for (const c of children) if (c !== null && c !== undefined) node.append(c);
            return node;
        }
        const svg = (markup: string) => { const s = el('span', { class: 'wfe-svg', 'aria-hidden': 'true' }); s.innerHTML = markup; return s.firstElementChild ?? s; };
        const fill = (tpl: string, vars: Record<string, string | number>) => Object.entries(vars).reduce((s, [k, v]) => s.split(`{${k}}`).join(String(v)), tpl);
        const uid = () => Array.from(crypto.getRandomValues(new Uint8Array(6)), (b) => b.toString(16).padStart(2, '0')).join('');

        const ICON = {
            quotes: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="currentColor" fill-opacity="0.13"/><path d="M14 2v6h6" stroke-opacity="0.6"/><path d="M8 13h8M8 17h5" stroke-opacity="0.6"/></svg>',
            approvals: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z" fill="currentColor" fill-opacity="0.13"/><path d="m9 12 2 2 4-4" stroke-opacity="0.8"/></svg>',
            payments: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="currentColor" fill-opacity="0.13"/><path d="M2.5 10h19" stroke-opacity="0.6"/><path d="M6.5 15h3" stroke-opacity="0.6"/></svg>',
            invoices: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15l-3-2-2 2-2-2-2 2-2-2-3 2V4a2 2 0 0 1 2-2z" fill="currentColor" fill-opacity="0.13"/><path d="M9 11h6M9 15h4" stroke-opacity="0.6"/></svg>',
            clients: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" fill="currentColor" fill-opacity="0.13"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" stroke-opacity="0.7"/></svg>',
            products: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5z" fill="currentColor" fill-opacity="0.13"/><path d="m3.3 7.5 8.7 5 8.7-5M12 22V12.5" stroke-opacity="0.6"/></svg>',
            tasks: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2.5" fill="currentColor" fill-opacity="0.13"/><path d="m8 12 2.5 2.5L16 9" stroke-opacity="0.8"/></svg>',
            trigger: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7z" fill="currentColor" fill-opacity="0.13"/></svg>',
            plus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>',
            create_task: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2.5" fill="currentColor" fill-opacity="0.13"/><path d="M12 9v6M9 12h6" stroke-opacity="0.8"/></svg>',
            notify_team: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="currentColor" fill-opacity="0.13"/><path d="m4 7 8 6 8-6" stroke-opacity="0.7"/></svg>',
            slack_message: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z" fill="currentColor" fill-opacity="0.13"/><path d="M8 9h8M8 12h5" stroke-opacity="0.6"/></svg>',
            action: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16l13-8z" fill="currentColor" fill-opacity="0.13"/></svg>',
            condition: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.2" fill="currentColor" fill-opacity="0.2"/><path d="M12 7.2v4.3M12 11.5 6 17M12 11.5l6 5.5" stroke-opacity="0.75"/><circle cx="6" cy="19" r="2" fill="currentColor" fill-opacity="0.2"/><circle cx="18" cy="19" r="2" fill="currentColor" fill-opacity="0.2"/></svg>',
            wait: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.13"/><path d="M12 7v5l3 2" stroke-opacity="0.8"/></svg>',
            dots: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>',
            search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
            close: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>',
        } as Record<string, string>;

        type List = Step[];
        function findStep(id: string, list: List = state.def.steps): { step: Step; list: List; index: number } | null {
            for (let i = 0; i < list.length; i++) {
                const s = list[i];
                if (s.id === id) return { step: s, list, index: i };
                if (s.type === 'condition') {
                    const found = findStep(id, s.then) ?? findStep(id, s.else);
                    if (found) return found;
                }
            }
            return null;
        }
        function depthOf(target: List, list: List = state.def.steps, depth = 1): number {
            if (list === target) return depth;
            for (const s of list) {
                if (s.type === 'condition') {
                    const d = depthOf(target, s.then, depth + 1) || depthOf(target, s.else, depth + 1);
                    if (d) return d;
                }
            }
            return 0;
        }
        const trigger = () => findTrigger(state.def.trigger);
        const fields = (): WorkflowField[] => trigger()?.fields ?? [];

        function clone(step: Step): Step {
            const copy = JSON.parse(JSON.stringify(step)) as Step;
            const reid = (s: Step) => { s.id = uid(); if (s.type === 'condition') { s.then.forEach(reid); s.else.forEach(reid); } };
            reid(copy);
            return copy;
        }

        function conditionText(c: Condition) {
            const f = fields().find((x) => x.key === c.field);
            if (!f) return '';
            const op = OPERATORS[f.type].find((o) => o.op === c.op);
            if (!op) return f.label[L];
            let value = c.value === null || c.value === undefined ? '' : String(c.value);
            if (f.type === 'enum') value = f.options?.find((o) => o.value === c.value)?.label[L] ?? value;
            if (f.type === 'number' && value !== '' && Number.isFinite(Number(value))) value = Number(value).toLocaleString(L === 'en' ? 'en-US' : 'es-MX');
            return [f.label[L], op.label[L], op.needsValue ? value : ''].filter(Boolean).join(' ');
        }
        function stepSummary(step: Step): { eyebrow: string; title: string; sub: string; icon: string } {
            if (step.type === 'wait') {
                return { eyebrow: S.espera, title: step.days === 1 ? S.esperarDia : fill(S.esperarDias, { n: step.days }), sub: '', icon: ICON.wait };
            }
            if (step.type === 'condition') {
                const first = step.conditions[0] ? conditionText(step.conditions[0]) : '';
                const more = step.conditions.length > 1 ? ` ${fill(S.yMas, { n: step.conditions.length - 1 })}` : '';
                return { eyebrow: S.condicion, title: first ? `${first}${more}` : S.defineCondicion, sub: '', icon: ICON.condition };
            }
            const def = findAction(step.action);
            const sub = def ? String(step.params.titulo ?? step.params.asunto ?? step.params.mensaje ?? '') : '';
            return { eyebrow: S.accion, title: def ? def.label[L] : S.eligeAccion, sub, icon: def ? ICON[def.key] : ICON.action };
        }

        function issues() { return validateForPublish(sanitizeDefinition(state.def), L); }

        const flow = $('[data-flow]');
        function render() {
            const current = state.showIssues ? issues() : [];
            const issueFor = (stepId: string | null) => current.find((i) => i.stepId === stepId);
            flow.replaceChildren();

            const trig = trigger();
            const triggerIssue = state.showIssues && !trig ? current.find((i) => i.stepId === null) : undefined;
            const tNode = el('button', {
                type: 'button', class: `wfe-node${trig ? '' : ' is-empty'}`, 'data-selected': String(state.selected?.kind === 'trigger'),
                'data-issue': String(Boolean(triggerIssue)),
            }, [
                el('span', { class: 'wfe-node-icon' }, [svg(trig ? ICON[trig.category] : ICON.plus)]),
                el('span', { class: 'wfe-node-text' }, [
                    el('span', { class: 'wfe-node-eyebrow', text: S.cuando }),
                    el('span', { class: 'wfe-node-title', text: trig ? trig.label[L] : S.agregarDisparador }),
                    trig ? el('span', { class: 'wfe-node-sub', text: TRIGGER_CATEGORIES.find((c) => c.key === trig.category)?.label[L] }) : null,
                ]),
            ]);
            tNode.addEventListener('click', () => { if (trig) select({ kind: 'trigger' }); else openPicker(); });
            flow.append(tNode);
            flow.append(renderList(state.def.steps, issueFor));
            updateChrome();
        }

        function link(list: List, index: number) {
            const plus = el('button', { type: 'button', class: 'wfe-plus', 'aria-label': S.agregarPaso }, [svg(ICON.plus)]);
            plus.addEventListener('click', (e) => { e.stopPropagation(); openAddMenu(plus, list, index); });
            return el('div', { class: 'wfe-link' }, [plus]);
        }

        function renderList(list: List, issueFor: (id: string | null) => { message: string } | undefined) {
            const wrap = el('div', { class: 'wfe-list' });
            list.forEach((step, index) => {
                wrap.append(link(list, index));
                wrap.append(renderStep(step, list, index, issueFor));
            });
            wrap.append(el('div', { class: 'wfe-link' }));
            const add = el('button', { type: 'button', class: 'wfe-node is-empty' }, [
                el('span', { class: 'wfe-node-icon' }, [svg(ICON.plus)]),
                el('span', { class: 'wfe-node-text' }, [
                    el('span', { class: 'wfe-node-eyebrow', text: S.hazEsto }),
                    el('span', { class: 'wfe-node-title', text: S.agregarPaso }),
                ]),
            ]);
            add.addEventListener('click', () => openAddMenu(add, list, list.length));
            wrap.append(add);
            return wrap;
        }

        function stepMenuButton(step: Step, list: List, index: number) {
            const btn = el('button', { type: 'button', class: 'wfe-node-menu', 'aria-label': S.pasoMenu, 'aria-haspopup': 'menu' }, [svg(ICON.dots)]);
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                openMenu(btn, [
                    index > 0 ? { label: S.pasoArriba, run: () => { list.splice(index - 1, 0, list.splice(index, 1)[0]); changed(); } } : null,
                    index < list.length - 1 ? { label: S.pasoAbajo, run: () => { list.splice(index + 1, 0, list.splice(index, 1)[0]); changed(); } } : null,
                    { label: S.pasoDuplicar, run: () => { list.splice(index + 1, 0, clone(step)); changed(); } },
                    { label: S.pasoEliminar, danger: true, run: () => {
                        list.splice(index, 1);
                        if (state.selected?.kind === 'step' && !findStep(state.selected.id)) closePanel();
                        changed();
                    } },
                ]);
            });
            return btn;
        }

        function renderStep(step: Step, list: List, index: number, issueFor: (id: string | null) => { message: string } | undefined) {
            const info = stepSummary(step);
            const issue = issueFor(step.id);
            const selected = state.selected?.kind === 'step' && state.selected.id === step.id;
            const card = el('div', {
                class: 'wfe-node', role: 'button', tabindex: '0', 'data-step': step.id,
                'data-selected': String(selected), 'data-issue': String(Boolean(issue)),
            }, [
                el('span', { class: 'wfe-node-icon' }, [svg(info.icon)]),
                el('span', { class: 'wfe-node-text' }, [
                    el('span', { class: 'wfe-node-eyebrow', text: info.eyebrow }),
                    el('span', { class: 'wfe-node-title', text: info.title }),
                    info.sub ? el('span', { class: 'wfe-node-sub', text: info.sub }) : null,
                    issue ? el('span', { class: 'wfe-node-issue', text: issue.message }) : null,
                ]),
                stepMenuButton(step, list, index),
            ]);
            const open = () => select({ kind: 'step', id: step.id });
            card.addEventListener('click', open);
            card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
            if (step.type !== 'condition') return card;

            const diamond = el('button', { type: 'button', class: 'wfe-diamond', 'aria-label': S.condicion, 'data-selected': String(selected), 'data-issue': String(Boolean(issue)) }, [svg(ICON.condition)]);
            diamond.addEventListener('click', open);
            card.classList.add('wfe-cond-summary');
            const branch = (label: string, items: List) => el('div', { class: 'wfe-branch' }, [
                el('span', { class: 'wfe-branch-label', text: label }),
                renderListInBranch(items, issueFor),
            ]);
            return el('div', { class: 'wfe-cond' }, [
                diamond, card,
                el('div', { class: 'wfe-branches' }, [branch(S.siCumple, step.then), branch(S.siNoCumple, step.else)]),
            ]);
        }

        function renderListInBranch(list: List, issueFor: (id: string | null) => { message: string } | undefined) {
            const inner = renderList(list, issueFor);
            inner.firstElementChild?.remove();
            return inner;
        }

        let openMenuEl: HTMLElement | null = null;
        function closeMenus() {
            openMenuEl?.remove(); openMenuEl = null;
            const addmenu = $('[data-addmenu]'); addmenu.hidden = true; addmenu.replaceChildren();
            const more = $('[data-more-menu]'); more.hidden = true; $('[data-more]').setAttribute('aria-expanded', 'false');
        }
        function place(menu: HTMLElement, anchor: HTMLElement) {
            const r = anchor.getBoundingClientRect();
            const host = root.getBoundingClientRect();
            menu.style.left = `${Math.max(0, Math.min(r.left - host.left, host.width - 240))}px`;
            menu.style.top = `${r.bottom - host.top + 6}px`;
        }
        function openMenu(anchor: HTMLElement, items: ({ label: string; danger?: boolean; run: () => void } | null)[]) {
            closeMenus();
            const menu = el('div', { class: 'wfe-addmenu', role: 'menu' });
            for (const item of items) {
                if (!item) continue;
                const b = el('button', { type: 'button', role: 'menuitem', text: item.label, style: item.danger ? 'color:var(--color-danger)' : undefined });
                b.addEventListener('click', () => { closeMenus(); item.run(); });
                menu.append(b);
            }
            root.append(menu);
            place(menu, anchor);
            openMenuEl = menu;
            (menu.querySelector('button') as HTMLElement | null)?.focus();
        }
        function openAddMenu(anchor: HTMLElement, list: List, index: number) {
            closeMenus();
            const menu = $('[data-addmenu]');
            const canNest = depthOf(list) < 4;
            const options: { label: string; icon: string; make: () => Step }[] = [
                { label: S.menuAccion, icon: ICON.action, make: () => ({ id: uid(), type: 'action', action: '', params: {} }) },
                ...(canNest ? [{ label: S.menuCondicion, icon: ICON.condition, make: (): Step => ({ id: uid(), type: 'condition', match: 'all', conditions: [], then: [], else: [] }) }] : []),
                { label: S.menuEspera, icon: ICON.wait, make: () => ({ id: uid(), type: 'wait', days: 1 }) },
            ];
            for (const opt of options) {
                const b = el('button', { type: 'button', role: 'menuitem' }, [svg(opt.icon), el('span', { text: opt.label })]);
                b.addEventListener('click', () => {
                    closeMenus();
                    const step = opt.make();
                    list.splice(index, 0, step);
                    changed();
                    select({ kind: 'step', id: step.id });
                });
                menu.append(b);
            }
            menu.hidden = false;
            place(menu, anchor);
            (menu.querySelector('button') as HTMLElement | null)?.focus();
        }

        const panel = $('[data-panel]');
        const scrim = $('[data-scrim]');
        const mobile = () => window.matchMedia('(max-width: 880px)').matches;
        function select(sel: NonNullable<typeof state.selected>) {
            state.selected = sel;
            render();
            renderPanel();
            const target = sel.kind === 'step' ? flow.querySelector(`[data-step="${sel.id}"]`) : flow.firstElementChild;
            if (!mobile()) target?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
        function closePanel() {
            state.selected = null;
            panel.hidden = true;
            scrim.hidden = true;
            render();
        }
        scrim.addEventListener('click', closePanel);

        function panelShell(title: string, body: Node[], extra?: Node) {
            const closeBtn = el('button', { type: 'button', class: 'wfe-icon-btn', 'aria-label': S.cerrar }, [svg(ICON.close)]);
            closeBtn.addEventListener('click', closePanel);
            const done = el('button', { type: 'button', class: 'wfe-btn wfe-btn-primary', text: S.listo });
            done.addEventListener('click', closePanel);
            panel.replaceChildren(
                el('div', { class: 'wfe-panel-head' }, [el('h2', { text: title }), closeBtn]),
                el('div', { class: 'wfe-panel-body' }, [...body, ...(extra ? [extra] : [])]),
                el('div', { class: 'wfe-panel-foot' }, [done]),
            );
            panel.setAttribute('aria-label', title);
            panel.hidden = false;
            scrim.hidden = !mobile();
        }

        function variablesBlock(target: () => HTMLInputElement | HTMLTextAreaElement | null) {
            const chips = el('div', { class: 'wfe-chips' });
            for (const f of fields()) {
                const chip = el('button', { type: 'button', class: 'wfe-chip' }, [f.label[L], f.live ? el('small', { text: ` · ${S.enVivo}` }) : null]);
                chip.addEventListener('click', () => {
                    const input = target();
                    if (!input) return;
                    const token = `{{${f.key}}}`;
                    const start = input.selectionStart ?? input.value.length;
                    const end = input.selectionEnd ?? input.value.length;
                    input.value = input.value.slice(0, start) + token + input.value.slice(end);
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                    input.focus();
                    input.setSelectionRange(start + token.length, start + token.length);
                });
                chips.append(chip);
            }
            return el('div', { class: 'wfe-field' }, [
                el('span', { class: 'wfe-field-label', text: S.variables }),
                el('p', { class: 'wfe-hint', text: S.variablesHint }),
                chips,
            ]);
        }

        function renderPanel() {
            const sel = state.selected;
            if (!sel) return;
            if (sel.kind === 'trigger') {
                const trig = trigger();
                if (!trig) { openPicker(); return; }
                const change = el('button', { type: 'button', class: 'wfe-btn wfe-btn-ghost', text: S.cambiar });
                change.addEventListener('click', openPicker);
                const fieldsList = el('div', { class: 'wfe-chips' }, fields().map((f) => el('span', { class: 'wfe-chip', text: f.label[L] })));
                panelShell(S.panelDisparador, [
                    el('div', { class: 'wfe-summary-card' }, [
                        el('span', { class: 'wfe-node-icon' }, [svg(ICON[trig.category])]),
                        el('span', { class: 'wfe-node-text' }, [
                            el('span', { class: 'wfe-node-title', text: trig.label[L] }),
                            el('span', { class: 'wfe-node-sub', text: TRIGGER_CATEGORIES.find((c) => c.key === trig.category)?.label[L] }),
                        ]),
                        change,
                    ]),
                    el('div', { class: 'wfe-field' }, [el('span', { class: 'wfe-field-label', text: S.variables }), fieldsList]),
                ]);
                return;
            }
            const found = findStep(sel.id);
            if (!found) { closePanel(); return; }
            const step = found.step;

            if (step.type === 'wait') {
                const input = el('input', { class: 'wfe-input', type: 'number', min: '1', max: String(WAIT_MAX_DAYS), inputmode: 'numeric', value: String(step.days), id: `wait-${step.id}` }) as HTMLInputElement;
                input.addEventListener('input', () => {
                    const n = Math.floor(Number(input.value));
                    if (Number.isFinite(n) && n >= 1) { step.days = Math.min(WAIT_MAX_DAYS, n); changed(false); }
                });
                panelShell(S.panelEspera, [
                    el('div', { class: 'wfe-field' }, [el('label', { for: `wait-${step.id}`, text: S.dias }), input, el('p', { class: 'wfe-hint', text: S.esperaHint })]),
                ]);
                return;
            }

            if (step.type === 'action') {
                const def = findAction(step.action);
                if (!def) {
                    const choice = el('div', { class: 'wfe-choice' });
                    for (const a of WORKFLOW_ACTIONS) {
                        const b = el('button', { type: 'button' }, [
                            el('span', { class: 'wfe-node-icon' }, [svg(ICON[a.key])]),
                            el('span', {}, [el('strong', { text: a.label[L] }), el('span', { text: a.description[L] })]),
                        ]);
                        b.addEventListener('click', () => { step.action = a.key; step.params = {}; changed(); renderPanel(); });
                        choice.append(b);
                    }
                    panelShell(S.panelAccion, [choice]);
                    return;
                }
                let lastText: HTMLInputElement | HTMLTextAreaElement | null = null;
                const change = el('button', { type: 'button', class: 'wfe-btn wfe-btn-ghost', text: S.cambiar });
                change.addEventListener('click', () => { step.action = ''; step.params = {}; changed(); renderPanel(); });
                const body: Node[] = [
                    el('div', { class: 'wfe-summary-card' }, [
                        el('span', { class: 'wfe-node-icon' }, [svg(ICON[def.key])]),
                        el('span', { class: 'wfe-node-text' }, [el('span', { class: 'wfe-node-title', text: def.label[L] }), el('span', { class: 'wfe-node-sub', text: def.description[L] })]),
                        change,
                    ]),
                ];
                for (const p of def.params) {
                    const fid = `p-${step.id}-${p.key}`;
                    let control: HTMLElement;
                    if (p.kind === 'choice') {
                        const choice = el('select', { class: 'wfe-select', id: fid }) as HTMLSelectElement;
                        choice.append(el('option', { value: '', text: S.elige }));
                        for (const o of p.options ?? []) choice.append(el('option', { value: o.value, text: o.label[L], selected: step.params[p.key] === o.value }));
                        choice.addEventListener('change', () => { if (choice.value) step.params[p.key] = choice.value; else delete step.params[p.key]; changed(false); });
                        control = choice;
                    } else if (p.kind === 'days') {
                        const input = el('input', { class: 'wfe-input', type: 'number', min: '0', max: String(p.max ?? 365), inputmode: 'numeric', id: fid, value: step.params[p.key] === undefined ? '' : String(step.params[p.key]) }) as HTMLInputElement;
                        input.addEventListener('input', () => {
                            if (input.value === '') delete step.params[p.key];
                            else if (Number.isFinite(Number(input.value))) step.params[p.key] = Math.max(0, Math.min(p.max ?? 365, Math.floor(Number(input.value))));
                            changed(false);
                        });
                        control = input;
                    } else {
                        const input = (p.kind === 'template_long'
                            ? el('textarea', { class: 'wfe-textarea', id: fid, maxlength: String(p.max ?? 2000) })
                            : el('input', { class: 'wfe-input', id: fid, maxlength: String(p.max ?? 200) })) as HTMLInputElement | HTMLTextAreaElement;
                        input.value = String(step.params[p.key] ?? '');
                        input.addEventListener('input', () => { step.params[p.key] = input.value; changed(false); });
                        input.addEventListener('focus', () => { lastText = input; });
                        if (!lastText) lastText = input;
                        control = input;
                    }
                    body.push(el('div', { class: 'wfe-field' }, [el('label', { for: fid, text: p.label[L] }), control, p.hint ? el('p', { class: 'wfe-hint', text: p.hint[L] }) : null]));
                }
                if (trigger() && def.params.some((p) => p.kind === 'template' || p.kind === 'template_long')) {
                    body.push(variablesBlock(() => lastText));
                }
                panelShell(S.panelAccion, body);
                return;
            }

            const available = fields();
            const segment = el('div', { class: 'wfe-segment', role: 'group' });
            for (const m of ['all', 'any'] as const) {
                const b = el('button', { type: 'button', 'aria-pressed': String(step.match === m), text: m === 'all' ? S.todas : S.alguna });
                b.addEventListener('click', () => { step.match = m; changed(false); renderPanel(); });
                segment.append(b);
            }
            const rows: Node[] = step.conditions.map((c, i) => {
                const field = available.find((f) => f.key === c.field);
                const fieldSel = el('select', { class: 'wfe-select', 'aria-label': S.campo }) as HTMLSelectElement;
                fieldSel.append(el('option', { value: '', text: S.elige }));
                for (const f of available) fieldSel.append(el('option', { value: f.key, text: f.label[L], selected: f.key === c.field }));
                fieldSel.addEventListener('change', () => {
                    const f = available.find((x) => x.key === fieldSel.value);
                    c.field = fieldSel.value;
                    c.op = f ? OPERATORS[f.type][0].op : ('eq' as any);
                    c.value = null;
                    changed(false); renderPanel();
                });
                const parts: Node[] = [fieldSel];
                if (field) {
                    const opSel = el('select', { class: 'wfe-select', 'aria-label': S.operador }) as HTMLSelectElement;
                    for (const o of OPERATORS[field.type]) opSel.append(el('option', { value: o.op, text: o.label[L], selected: o.op === c.op }));
                    opSel.addEventListener('change', () => { c.op = opSel.value as any; changed(false); renderPanel(); });
                    parts.push(opSel);
                    const op = OPERATORS[field.type].find((o) => o.op === c.op);
                    if (op?.needsValue) {
                        if (field.type === 'enum') {
                            const valSel = el('select', { class: 'wfe-select', 'aria-label': S.valor }) as HTMLSelectElement;
                            valSel.append(el('option', { value: '', text: S.elige }));
                            for (const o of field.options ?? []) valSel.append(el('option', { value: o.value, text: o.label[L], selected: o.value === c.value }));
                            valSel.addEventListener('change', () => { c.value = valSel.value || null; changed(false); });
                            parts.push(valSel);
                        } else {
                            const valInput = el('input', { class: 'wfe-input', 'aria-label': S.valor, type: field.type === 'number' ? 'number' : 'text', inputmode: field.type === 'number' ? 'decimal' : undefined, value: c.value === null || c.value === undefined ? '' : String(c.value) }) as HTMLInputElement;
                            valInput.addEventListener('input', () => {
                                c.value = field.type === 'number' ? (valInput.value === '' ? null : Number(valInput.value)) : valInput.value;
                                changed(false);
                            });
                            parts.push(valInput);
                        }
                    }
                }
                const remove = el('button', { type: 'button', class: 'wfe-link-btn is-danger', text: S.quitar });
                remove.addEventListener('click', () => { step.conditions.splice(i, 1); changed(false); renderPanel(); });
                return el('div', { class: 'wfe-cond-row' }, [
                    el('div', { class: 'wfe-cond-row-head' }, [el('span', { text: `${S.condicion} ${i + 1}` }), remove]),
                    ...parts,
                ]);
            });
            const addCond = el('button', { type: 'button', class: 'wfe-link-btn', text: `+ ${S.agregarOtra}` });
            addCond.addEventListener('click', () => {
                const f = available[0];
                step.conditions.push({ field: f?.key ?? '', op: f ? OPERATORS[f.type][0].op : ('eq' as any), value: null });
                changed(false); renderPanel();
            });
            panelShell(S.panelCondicion, [
                el('div', { class: 'wfe-field' }, [el('span', { class: 'wfe-field-label', text: S.continuarSi }), segment]),
                ...rows,
                step.conditions.length < MAX_CONDITIONS && available.length ? addCond : null,
            ].filter(Boolean) as Node[]);
        }

        const picker = $('[data-picker]');
        function openPicker() {
            closeMenus();
            let category = '';
            const input = el('input', { type: 'search', placeholder: S.buscarDisparador, 'aria-label': S.buscarDisparador, autocomplete: 'off' }) as HTMLInputElement;
            const chips = el('div', { class: 'wfe-chips', role: 'group' });
            const list = el('div', { class: 'wfe-picker-list' });
            const cats = [{ key: '', label: S.todos }, ...TRIGGER_CATEGORIES.map((c) => ({ key: c.key, label: c.label[L] }))];
            const drawChips = () => {
                chips.replaceChildren(...cats.map((c) => {
                    const b = el('button', { type: 'button', class: 'wfe-chip', 'aria-pressed': String(category === c.key), text: c.label });
                    b.addEventListener('click', () => { category = c.key; drawChips(); drawList(); });
                    return b;
                }));
            };
            const drawList = () => {
                const q = input.value.trim().toLowerCase();
                const items = WORKFLOW_TRIGGERS.filter((tr) => (!category || tr.category === category) && (!q || tr.label[L].toLowerCase().includes(q)));
                list.replaceChildren(...(items.length ? items.map((tr) => {
                    const b = el('button', { type: 'button', class: 'wfe-picker-item' }, [
                        el('span', { class: 'wfe-node-icon' }, [svg(ICON[tr.category])]),
                        el('span', { class: 'lbl', text: tr.label[L] }),
                        el('span', { class: 'cat', text: TRIGGER_CATEGORIES.find((c) => c.key === tr.category)?.label[L] }),
                    ]);
                    b.addEventListener('click', () => {
                        state.def.trigger = tr.type;
                        closePicker();
                        changed();
                        select({ kind: 'trigger' });
                    });
                    return b;
                }) : [el('p', { class: 'wfe-picker-empty', text: S.sinResultados })]));
            };
            input.addEventListener('input', drawList);
            const card = el('div', { class: 'wfe-picker-card' }, [
                el('div', { class: 'wfe-picker-top' }, [el('div', { class: 'wfe-search' }, [svg(ICON.search), input]), chips]),
                list,
            ]);
            picker.replaceChildren(card);
            picker.hidden = false;
            drawChips(); drawList();
            input.focus();
        }
        function closePicker() { picker.hidden = true; picker.replaceChildren(); }
        picker.addEventListener('click', (e) => { if (e.target === picker) closePicker(); });

        const nameInput = $<HTMLInputElement>('[data-name]');
        nameInput.addEventListener('input', () => { state.nombre = nameInput.value; updateChrome(); });
        function updateChrome() {
            const badge = $('[data-badge]');
            badge.dataset.estado = state.estado;
            badge.textContent = S.estado[state.estado];
            $('[data-dirty]').hidden = !hasUnpublished() || state.estado === 'draft';
            const publishBtn = $('[data-publish]');
            publishBtn.textContent = state.publicado ? S.publicarCambios : S.publicar;
            const pauseBtn = $('[data-toggle-pause]');
            pauseBtn.textContent = state.estado === 'paused' ? S.reanudar : S.pausar;
            pauseBtn.hidden = state.estado === 'draft';
            const count = issues().length;
            const issuesEl = $('[data-issues]');
            issuesEl.hidden = !state.showIssues || count === 0;
            issuesEl.textContent = fill(S.pendientes, { n: count });
        }

        function changed(rerenderPanelToo = true) {
            render();
            if (rerenderPanelToo && state.selected && !panel.hidden) renderPanel();
        }

        async function save(quiet = false): Promise<boolean> {
            const btn = $('[data-save]');
            btn.setAttribute('aria-busy', 'true');
            try {
                const res = await fetch(`/api/workflows/${id}`, {
                    method: 'PATCH', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nombre: state.nombre.trim(), definicion: state.def }),
                });
                const body = await res.json().catch(() => ({}));
                if (!res.ok) { toast(body.error || S.errorGuardar, 'error'); return false; }
                state.saved = snapshot();
                if (!quiet) toast(S.guardado);
                return true;
            } catch {
                toast(S.errorGuardar, 'error');
                return false;
            } finally {
                btn.removeAttribute('aria-busy');
            }
        }
        $('[data-save]').addEventListener('click', () => save());

        function focusIssue(pending: { stepId: string | null; message: string }[]) {
            state.showIssues = true;
            render();
            toast(pending[0].message, 'error');
            if (pending[0].stepId && findStep(pending[0].stepId)) select({ kind: 'step', id: pending[0].stepId });
            else if (!trigger()) openPicker();
        }

        $('[data-issues]').addEventListener('click', () => { const pending = issues(); if (pending.length) focusIssue(pending); });

        $('[data-publish]').addEventListener('click', async () => {
            const pending = issues();
            if (pending.length) { focusIssue(pending); return; }
            const btn = $('[data-publish]');
            if (!(await save(true))) return;
            btn.setAttribute('aria-busy', 'true');
            try {
                const res = await fetch(`/api/workflows/${id}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'publish' }) });
                const body = await res.json().catch(() => ({}));
                if (res.status === 422 && Array.isArray(body.issues) && body.issues.length) { focusIssue(body.issues); return; }
                if (!res.ok) { toast(body.error || S.errorGuardar, 'error'); return; }
                state.estado = 'active';
                state.publicado = JSON.stringify(sanitizeDefinition(state.def));
                state.showIssues = false;
                render();
                toast(S.publicado);
            } catch {
                toast(S.errorGuardar, 'error');
            } finally {
                btn.removeAttribute('aria-busy');
            }
        });

        const moreBtn = $('[data-more]');
        const moreMenu = $('[data-more-menu]');
        moreBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const open = moreMenu.hidden;
            closeMenus();
            moreMenu.hidden = !open;
            moreBtn.setAttribute('aria-expanded', String(open));
            if (open) (moreMenu.querySelector('button:not([hidden])') as HTMLElement | null)?.focus();
        });
        $('[data-toggle-pause]').addEventListener('click', async () => {
            closeMenus();
            const action = state.estado === 'paused' ? 'resume' : 'pause';
            const res = await fetch(`/api/workflows/${id}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action }) });
            const body = await res.json().catch(() => ({}));
            if (!res.ok) { toast(body.error || S.errorGuardar, 'error'); return; }
            state.estado = body.estado;
            updateChrome();
            toast(action === 'pause' ? S.pausadoToast : S.reanudadoToast);
        });
        $('[data-duplicate]').addEventListener('click', async () => {
            closeMenus();
            if (isDirty() && !(await save(true))) return;
            const res = await fetch(`/api/workflows/${id}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'duplicate' }) });
            const body = await res.json().catch(() => ({}));
            if (!res.ok || !body.id) { toast(body.error || S.errorGuardar, 'error'); return; }
            window.location.href = `/app/workflows/${body.id}`;
        });
        $('[data-delete]').addEventListener('click', async () => {
            closeMenus();
            const confirmFn = (window as any).cordConfirm;
            const ok = confirmFn ? await confirmFn({ title: S.eliminar, body: S.eliminarDesc, danger: true, confirmText: S.eliminar }) : false;
            if (!ok) return;
            const res = await fetch(`/api/workflows/${id}`, { method: 'DELETE' });
            if (!res.ok) { toast(S.errorGuardar, 'error'); return; }
            state.saved = snapshot();
            window.location.href = '/app/workflows';
        });

        root.querySelectorAll<HTMLButtonElement>('[data-tab-btn]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const tab = btn.dataset.tabBtn!;
                root.querySelectorAll<HTMLButtonElement>('[data-tab-btn]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
                root.querySelectorAll<HTMLElement>('[data-tab]').forEach((section) => { section.hidden = section.dataset.tab !== tab; });
                if (tab === 'runs') loadRuns();
                else closePanel();
            });
        });

        const canvas = $('[data-canvas]');
        root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const mode = btn.dataset.zoom;
                if (mode === 'in') state.zoom = Math.min(1.4, Math.round((state.zoom + 0.1) * 10) / 10);
                else if (mode === 'out') state.zoom = Math.max(0.5, Math.round((state.zoom - 0.1) * 10) / 10);
                else {
                    flow.style.setProperty('--wf-zoom', '1');
                    const ratio = Math.min(1, canvas.clientWidth / flow.offsetWidth, canvas.clientHeight / flow.offsetHeight);
                    state.zoom = Math.max(0.5, Math.floor(ratio * 100) / 100);
                }
                flow.style.setProperty('--wf-zoom', String(state.zoom));
                centerCanvas();
            });
        });
        function centerCanvas() {
            canvas.scrollLeft = Math.max(0, (canvas.scrollWidth - canvas.clientWidth) / 2);
        }

        const runsList = $('[data-runs-list]');
        $('[data-runs-refresh]').addEventListener('click', loadRuns);
        function runSummary(run: any) {
            const d = run.event_data ?? {};
            return [d.folio, d.numero, d.cliente, d.empresa, d.titulo, d.nombre].filter((v) => typeof v === 'string' && v).slice(0, 2).join(' · ');
        }
        const when = (iso: string) => new Date(iso).toLocaleString(L === 'en' ? 'en-US' : 'es-MX', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        function stepLabel(snapshotDef: WorkflowDefinition | null, stepId: string) {
            const find = (list: Step[]): Step | null => {
                for (const s of list) {
                    if (s.id === stepId) return s;
                    if (s.type === 'condition') { const f = find(s.then) ?? find(s.else); if (f) return f; }
                }
                return null;
            };
            const s = find(sanitizeDefinition(snapshotDef).steps) ?? find(state.def.steps);
            return s ? stepSummary(s).title : stepId;
        }
        async function loadRuns() {
            runsList.replaceChildren();
            let runs: any[] = [];
            try {
                const res = await fetch(`/api/workflows/${id}/runs`);
                runs = (await res.json()).runs ?? [];
            } catch { toast(S.errorGuardar, 'error'); }
            if (!runs.length) {
                runsList.append(el('div', { class: 'wfe-runs-empty' }, [el('h3', { text: S.runsVacioTitulo }), el('p', { text: S.runsVacioDesc })]));
                return;
            }
            for (const run of runs) {
                const detail = el('div', { class: 'wfe-run-detail', hidden: true });
                const row = el('button', { type: 'button', class: 'wfe-run-row', 'aria-expanded': 'false' }, [
                    el('span', { class: 'wfe-pill', 'data-s': run.status, text: S.run[run.status] ?? run.status }),
                    el('span', { class: 'wfe-run-main' }, [
                        el('strong', { text: findTrigger(run.event_type)?.label[L] ?? run.event_type }),
                        el('small', { text: runSummary(run) }),
                    ]),
                    el('span', { class: 'wfe-run-when', text: when(run.created_at) }),
                ]);
                row.addEventListener('click', () => {
                    const open = detail.hidden;
                    detail.hidden = !open;
                    row.setAttribute('aria-expanded', String(open));
                });
                const steps = el('ol', { class: 'wfe-run-steps' }, (Array.isArray(run.log) ? run.log : []).map((entry: any) => el('li', {}, [
                    el('span', { class: `res ${entry.resultado}`, text: S.paso[entry.resultado] ?? entry.resultado }),
                    el('span', { text: stepLabel(run.publicado, entry.step) }),
                    entry.detalle && entry.resultado === 'error' ? el('small', { text: entry.detalle }) : null,
                ])));
                detail.append(steps);
                if (run.status === 'waiting') detail.append(el('p', { class: 'wfe-hint', text: fill(S.continua, { fecha: when(run.run_at) }) }));
                const lastDetail = Array.isArray(run.log) ? run.log.at(-1)?.detalle : null;
                if (run.error && run.status !== 'succeeded' && run.error !== lastDetail) detail.append(el('p', { class: 'wfe-run-error', text: run.error }));
                if (run.attempts > 0 && run.status !== 'succeeded') detail.append(el('p', { class: 'wfe-hint', text: fill(S.intento, { n: run.attempts }) }));
                const actions = el('div', { class: 'wfe-run-actions' });
                const act = async (action: 'retry' | 'cancel') => {
                    const res = await fetch(`/api/workflows/runs/${run.id}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action }) });
                    const body = await res.json().catch(() => ({}));
                    if (!res.ok) { toast(body.error || S.errorGuardar, 'error'); return; }
                    loadRuns();
                };
                if (run.status === 'failed') {
                    const b = el('button', { type: 'button', class: 'wfe-btn wfe-btn-ghost', text: S.reintentar });
                    b.addEventListener('click', () => act('retry'));
                    actions.append(b);
                }
                if (run.status === 'queued' || run.status === 'waiting') {
                    const b = el('button', { type: 'button', class: 'wfe-btn wfe-btn-ghost', text: S.cancelar });
                    b.addEventListener('click', () => act('cancel'));
                    actions.append(b);
                }
                if (actions.childElementCount) detail.append(actions);
                runsList.append(el('div', { class: 'wfe-run' }, [row, detail]));
            }
        }

        document.addEventListener('click', (e) => {
            const target = e.target as Node;
            if (openMenuEl && !openMenuEl.contains(target)) closeMenus();
            const addmenu = $('[data-addmenu]');
            if (!addmenu.hidden && !addmenu.contains(target)) closeMenus();
            if (!moreMenu.hidden && !moreMenu.contains(target) && target !== moreBtn) closeMenus();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (!picker.hidden) closePicker();
                else if (openMenuEl || !$('[data-addmenu]').hidden || !moreMenu.hidden) closeMenus();
                else if (!panel.hidden) closePanel();
            }
            if (!mobile() && (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') { e.preventDefault(); save(); }
        });
        window.addEventListener('beforeunload', (e) => { if (isDirty()) e.preventDefault(); });

        render();
        centerCanvas();
    }
</script>
