---
import { t, type AppLocale } from '../../i18n/app';
import { sanitizeDefinition } from '../../lib/workflows/definition';

interface Props {
    lang: AppLocale;
    workflow: { id: string; nombre: string; estado: string; definicion: unknown; publicado: unknown };
}

const { lang: L, workflow: wf } = Astro.props;

const STR = {
    volver: t(L, 'wf.volver'), nombreAria: t(L, 'wf.nombre_aria'), guardar: t(L, 'wf.guardar'), publicar: t(L, 'wf.publicar'),
    publicarCambios: t(L, 'wf.publicar_cambios'), mas: t(L, 'wf.mas'), pausar: t(L, 'wf.pausar'), reanudar: t(L, 'wf.reanudar'),
    duplicar: t(L, 'wf.duplicar'), eliminar: t(L, 'wf.eliminar'), eliminarDesc: t(L, 'wf.eliminar_desc'),
    cambiosSinPublicar: t(L, 'wf.cambios_sin_publicar'), guardado: t(L, 'wf.guardado'), publicado: t(L, 'wf.publicado'),
    pausadoToast: t(L, 'wf.pausado_toast'), reanudadoToast: t(L, 'wf.reanudado_toast'), errorGuardar: t(L, 'wf.error_guardar'),
    pendientes: t(L, 'wf.pendientes'), tabEditor: t(L, 'wf.tab_editor'), tabEjecuciones: t(L, 'wf.tab_ejecuciones'),
    cuando: t(L, 'wf.cuando'), agregarDisparador: t(L, 'wf.agregar_disparador'), hazEsto: t(L, 'wf.haz_esto'),
    agregarPaso: t(L, 'wf.agregar_paso'), menuAccion: t(L, 'wf.menu_accion'), menuCondicion: t(L, 'wf.menu_condicion'),
    menuEspera: t(L, 'wf.menu_espera'), siCumple: t(L, 'wf.si_cumple'), siNoCumple: t(L, 'wf.si_no_cumple'),
    accion: t(L, 'wf.accion'), condicion: t(L, 'wf.condicion'), espera: t(L, 'wf.espera'), esperarDias: t(L, 'wf.esperar_dias'),
    esperarDia: t(L, 'wf.esperar_dia'), eligeAccion: t(L, 'wf.elige_accion'), defineCondicion: t(L, 'wf.define_condicion'),
    yMas: t(L, 'wf.y_mas'), pasoMenu: t(L, 'wf.paso_menu'), pasoEliminar: t(L, 'wf.paso_eliminar'), pasoDuplicar: t(L, 'wf.paso_duplicar'),
    pasoArriba: t(L, 'wf.paso_arriba'), pasoAbajo: t(L, 'wf.paso_abajo'), panelDisparador: t(L, 'wf.panel_disparador'),
    panelAccion: t(L, 'wf.panel_accion'), panelCondicion: t(L, 'wf.panel_condicion'), panelEspera: t(L, 'wf.panel_espera'),
    listo: t(L, 'wf.listo'), cambiar: t(L, 'wf.cambiar'), cerrar: t(L, 'wf.cerrar'), variables: t(L, 'wf.variables'),
    variablesHint: t(L, 'wf.variables_hint'), enVivo: t(L, 'wf.en_vivo'), continuarSi: t(L, 'wf.continuar_si'),
    todas: t(L, 'wf.todas'), alguna: t(L, 'wf.alguna'), campo: t(L, 'wf.campo'), operador: t(L, 'wf.operador'),
    valor: t(L, 'wf.valor'), agregarOtra: t(L, 'wf.agregar_otra'), quitar: t(L, 'wf.quitar'), elige: t(L, 'wf.elige'),
    dias: t(L, 'wf.dias'), esperaHint: t(L, 'wf.espera_hint'), buscarDisparador: t(L, 'wf.buscar_disparador'),
    todos: t(L, 'wf.todos'), sinResultados: t(L, 'wf.sin_resultados'), acercar: t(L, 'wf.acercar'), alejar: t(L, 'wf.alejar'),
    ajustar: t(L, 'wf.ajustar'), runsVacioTitulo: t(L, 'wf.runs_vacio_titulo'), runsVacioDesc: t(L, 'wf.runs_vacio_desc'),
    reintentar: t(L, 'wf.reintentar'), cancelar: t(L, 'wf.cancelar'), actualizar: t(L, 'wf.actualizar'),
    intento: t(L, 'wf.intento'), continua: t(L, 'wf.continua'),
    run: {
        queued: t(L, 'wf.run.queued'), running: t(L, 'wf.run.running'), waiting: t(L, 'wf.run.waiting'),
        succeeded: t(L, 'wf.run.succeeded'), failed: t(L, 'wf.run.failed'), canceled: t(L, 'wf.run.canceled'),
    },
    paso: {
        ok: t(L, 'wf.paso.ok'), error: t(L, 'wf.paso.error'), si: t(L, 'wf.paso.si'), no: t(L, 'wf.paso.no'), esperando: t(L, 'wf.paso.esperando'),
    },
    estado: { draft: t(L, 'wf.estado.draft'), active: t(L, 'wf.estado.active'), paused: t(L, 'wf.estado.paused') },
};

const DATA = {
    lang: L,
    workflow: {
        id: wf.id,
        nombre: wf.nombre,
        estado: wf.estado,
        definicion: sanitizeDefinition(wf.definicion),
        publicado: wf.publicado ? sanitizeDefinition(wf.publicado) : null,
    },
    str: STR,
};
---

<div class="wfe" data-wf-editor>
    <script is:inline type="application/json" id="wfData" set:html={JSON.stringify(DATA).replace(/</g, '\\u003c')}></script>

    <header class="wfe-bar">
        <a class="wfe-close" href="/app/workflows" aria-label={STR.volver}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </a>
        <input class="wfe-name" data-name value={wf?.nombre} maxlength="120" aria-label={STR.nombreAria} />
        <span class="wfe-badge" data-badge></span>
        <span class="wfe-dirty" data-dirty hidden>{STR.cambiosSinPublicar}</span>
        <div class="wfe-actions">
            <button type="button" class="wfe-btn wfe-btn-ghost" data-save>{STR.guardar}</button>
            <button type="button" class="wfe-btn wfe-btn-primary" data-publish>{STR.publicar}</button>
            <div class="wfe-more">
                <button type="button" class="wfe-icon-btn" data-more aria-haspopup="menu" aria-expanded="false" aria-label={STR.mas}>
                    <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
                </button>
                <div class="wfe-menu" role="menu" data-more-menu hidden>
                    <button type="button" role="menuitem" data-toggle-pause></button>
                    <button type="button" role="menuitem" data-duplicate>{STR.duplicar}</button>
                    <button type="button" role="menuitem" class="wfe-danger" data-delete>{STR.eliminar}</button>
                </div>
            </div>
        </div>
    </header>

    <div class="wfe-tabs" role="tablist">
        <button type="button" role="tab" class="wfe-tab" aria-selected="true" data-tab-btn="editor">{STR.tabEditor}</button>
        <button type="button" role="tab" class="wfe-tab" aria-selected="false" data-tab-btn="runs">{STR.tabEjecuciones}</button>
        <button type="button" class="wfe-issues" data-issues hidden></button>
    </div>

    <section class="wfe-stage" data-tab="editor">
        <div class="wfe-canvas" data-canvas>
            <div class="wfe-flow" data-flow></div>
        </div>
        <div class="wfe-zoom" aria-label="zoom">
            <button type="button" data-zoom="in" aria-label={STR.acercar}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
            <button type="button" data-zoom="out" aria-label={STR.alejar}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
            <button type="button" data-zoom="fit" aria-label={STR.ajustar}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V5h4M20 9V5h-4M4 15v4h4M20 15v4h-4"/></svg></button>
        </div>
        <aside class="wfe-panel" data-panel hidden role="dialog" aria-modal="false"></aside>
    </section>

    <section class="wfe-runs" data-tab="runs" hidden>
        <div class="wfe-runs-bar"><button type="button" class="wfe-btn wfe-btn-ghost" data-runs-refresh>{STR.actualizar}</button></div>
        <div data-runs-list></div>
    </section>

    <div class="wfe-scrim" data-scrim hidden></div>
    <div class="wfe-addmenu" data-addmenu role="menu" hidden></div>
    <div class="wfe-picker" data-picker hidden role="dialog" aria-modal="true" aria-label={STR.buscarDisparador}></div>
</div>

<style is:global>
    .wfe {
        --wf-dot: rgba(10, 25, 47, 0.13);
        --wf-card: var(--surface, #fff);
        --wf-line: rgba(10, 25, 47, 0.18);
        --wf-accent: var(--color-blue-deep);
        --wf-issue: #dc2626;
        --wf-shadow: 0 1px 2px rgba(10,25,47,0.04), 0 10px 30px -18px rgba(10,25,47,0.22);
        position: relative; display: flex; flex-direction: column; gap: 0.9rem;
    }
    html[data-theme="dark"] .wfe { --wf-dot: rgba(255,255,255,0.1); --wf-line: rgba(255,255,255,0.22); --wf-accent: #9ec5ff; --wf-issue: #f87171; }
    .wfe [hidden] { display: none !important; }
    .wfe button { font-family: var(--font-sans); }
    .wfe :focus-visible { outline: 2px solid var(--wf-accent); outline-offset: 2px; }

    .wfe-bar { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
    .wfe-close, .wfe-icon-btn {
        width: 38px; height: 38px; display: grid; place-items: center; flex-shrink: 0; border-radius: 11px; cursor: pointer;
        color: var(--color-text); background: var(--surface); border: 1px solid var(--color-border); transition: background 0.2s, transform 0.25s var(--ease-spring);
    }
    .wfe-close svg, .wfe-icon-btn svg { width: 17px; height: 17px; }
    .wfe-close:hover, .wfe-icon-btn:hover { background: var(--color-bg-soft); }
    .wfe-close:active, .wfe-icon-btn:active { transform: scale(0.95); }
    .wfe-name {
        min-width: 6ch; max-width: min(520px, 50vw); flex: 0 1 auto; field-sizing: content; font-family: var(--font-sans); font-size: 1.35rem; font-weight: 700; letter-spacing: -0.03em;
        color: var(--color-text); background: transparent; border: 1px solid transparent; border-radius: 10px; padding: 4px 8px;
    }
    .wfe-name:hover { background: var(--color-bg-soft); }
    .wfe-name:focus { outline: none; background: var(--editor-field, #f5f5f7); border-color: rgba(10,25,47,0.15); }
    .wfe-badge { font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: 100px; white-space: nowrap; }
    .wfe-badge[data-estado="draft"] { color: #5b6472; background: rgba(91,100,114,0.1); }
    .wfe-badge[data-estado="active"] { color: #047857; background: rgba(16,185,129,0.12); }
    .wfe-badge[data-estado="paused"] { color: #b45309; background: rgba(245,158,11,0.14); }
    .wfe-dirty { font-size: 0.74rem; color: var(--color-text-muted); }
    .wfe-actions { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; }
    .wfe-btn {
        font-size: 0.82rem; font-weight: 600; padding: 9px 16px; border-radius: 100px; cursor: pointer; white-space: nowrap;
        transition: transform 0.3s var(--ease-spring), background 0.2s, opacity 0.2s;
    }
    .wfe-btn:active { transform: scale(0.97); }
    .wfe-btn[aria-busy="true"] { opacity: 0.6; pointer-events: none; }
    .wfe-btn-ghost { color: var(--color-text); background: var(--surface); border: 1px solid var(--color-border); }
    .wfe-btn-ghost:hover { background: var(--color-bg-soft); }
    .wfe-btn-primary { color: #fff; background: var(--color-blue-deep); border: 1px solid var(--color-blue-deep); box-shadow: 0 6px 18px -8px rgba(10,25,47,0.5); }
    .wfe-btn-primary:hover { transform: translateY(-1px); }
    html[data-theme="dark"] .wfe-btn-primary { background: #e8eefb; color: #0a192f; border-color: #e8eefb; }
    .wfe-more { position: relative; }
    .wfe-menu {
        position: absolute; right: 0; top: calc(100% + 6px); z-index: 40; min-width: 200px; padding: 6px; border-radius: 14px;
        background: var(--surface); border: 1px solid var(--color-border); box-shadow: var(--editor-panel-shadow, 0 16px 40px -8px rgba(10,25,47,0.18));
    }
    .wfe-menu button, .wfe-addmenu button {
        display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; font-size: 0.84rem; color: var(--color-text);
        background: none; border: none; border-radius: 9px; padding: 9px 11px; cursor: pointer;
    }
    .wfe-menu button:hover, .wfe-addmenu button:hover, .wfe-menu button:focus-visible, .wfe-addmenu button:focus-visible { background: var(--color-bg-soft); outline: none; }
    .wfe-menu .wfe-danger { color: var(--color-danger); }
    .wfe-addmenu svg { width: 18px; height: 18px; color: var(--wf-accent); flex-shrink: 0; }

    .wfe-tabs { display: flex; align-items: center; gap: 1.2rem; border-bottom: 1px solid var(--color-border); }
    .wfe-tab {
        font-size: 0.86rem; font-weight: 600; color: var(--color-text-muted); background: none; border: none; cursor: pointer;
        padding: 0.55rem 0 0.7rem; border-bottom: 2px solid transparent; margin-bottom: -1px;
    }
    .wfe-tab[aria-selected="true"] { color: var(--color-text); border-bottom-color: var(--wf-accent); }
    .wfe-issues { margin-left: auto; font-size: 0.76rem; font-weight: 600; color: var(--wf-issue); cursor: pointer; background: none; border: none; }

    .wfe-stage { position: relative; }
    .wfe-canvas {
        position: relative; height: calc(100dvh - 250px); min-height: 520px; overflow: auto; border-radius: 22px;
        background-color: var(--color-bg-soft); background-image: radial-gradient(var(--wf-dot) 1px, transparent 1px); background-size: 18px 18px;
        box-shadow: inset 0 0 0 1px var(--color-border);
    }
    .wfe-flow { display: flex; flex-direction: column; align-items: center; padding: 56px 48px 120px; min-width: max-content; zoom: var(--wf-zoom, 1); }
    .wfe-zoom {
        position: absolute; left: 16px; bottom: 16px; display: flex; flex-direction: column; border-radius: 12px; overflow: hidden;
        background: var(--surface); box-shadow: 0 0 0 1px var(--color-border), var(--wf-shadow);
    }
    .wfe-zoom button { width: 38px; height: 38px; display: grid; place-items: center; background: none; border: none; color: var(--color-text-muted); cursor: pointer; }
    .wfe-zoom button + button { border-top: 1px solid var(--color-border); }
    .wfe-zoom button:hover { color: var(--color-text); background: var(--color-bg-soft); }
    .wfe-zoom svg { width: 16px; height: 16px; }

    .wfe-list { display: flex; flex-direction: column; align-items: center; }
    .wfe-node {
        position: relative; width: 340px; display: flex; align-items: center; gap: 12px; text-align: left; cursor: pointer;
        padding: 14px 14px 14px 16px; border-radius: 16px; background: var(--wf-card); color: var(--color-text);
        border: 1px solid var(--color-border); box-shadow: var(--wf-shadow); transition: box-shadow 0.25s, border-color 0.25s, transform 0.3s var(--ease-spring);
    }
    .wfe-node:hover { transform: translateY(-1px); }
    .wfe-node[data-selected="true"] { border-color: var(--wf-accent); box-shadow: 0 0 0 3px rgba(10,25,47,0.08), var(--wf-shadow); }
    html[data-theme="dark"] .wfe-node[data-selected="true"] { box-shadow: 0 0 0 3px rgba(158,197,255,0.18), var(--wf-shadow); }
    .wfe-node[data-issue="true"] { border-color: var(--wf-issue); }
    .wfe-node.is-empty { background: transparent; box-shadow: none; border: 1.5px dashed var(--wf-line); }
    .wfe-node.is-empty:hover { background: var(--wf-card); border-style: solid; }
    .wfe-node-icon { width: 36px; height: 36px; flex-shrink: 0; display: grid; place-items: center; border-radius: 11px; color: var(--wf-accent); background: var(--color-bg-soft); box-shadow: inset 0 0 0 1px var(--color-border); }
    .wfe-node.is-empty .wfe-node-icon { background: var(--wf-card); }
    .wfe-node-icon svg { width: 18px; height: 18px; }
    .wfe-node-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
    .wfe-node-eyebrow { font-size: 0.72rem; color: var(--color-text-muted); }
    .wfe-node-title { font-size: 0.9rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .wfe-node.is-empty .wfe-node-title { color: var(--wf-accent); }
    .wfe-node-sub { font-size: 0.76rem; color: var(--color-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wfe-node-issue { font-size: 0.72rem; color: var(--wf-issue); font-weight: 600; }
    .wfe-node-menu { width: 30px; height: 30px; flex-shrink: 0; display: grid; place-items: center; border-radius: 8px; border: none; background: none; color: var(--color-text-muted); cursor: pointer; }
    .wfe-node-menu:hover { background: var(--color-bg-soft); color: var(--color-text); }
    .wfe-node-menu svg { width: 16px; height: 16px; }

    .wfe-link { display: flex; flex-direction: column; align-items: center; height: 46px; justify-content: center; position: relative; }
    .wfe-link::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 1.5px; transform: translateX(-50%); background: var(--wf-line); }
    .wfe-plus {
        position: relative; z-index: 1; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
        color: var(--wf-accent); background: var(--wf-card); border: 1.5px solid var(--wf-line); opacity: 0; transform: scale(0.85);
        transition: opacity 0.2s, transform 0.25s var(--ease-spring), border-color 0.2s;
    }
    .wfe-plus svg { width: 13px; height: 13px; }
    .wfe-link:hover .wfe-plus, .wfe-plus:focus-visible { opacity: 1; transform: scale(1); }
    .wfe-plus:hover { border-color: var(--wf-accent); }

    .wfe-diamond {
        width: 58px; height: 58px; display: grid; place-items: center; cursor: pointer; border: none; background: none; padding: 0; position: relative;
    }
    .wfe-diamond::before {
        content: ''; position: absolute; inset: 8px; border-radius: 12px; transform: rotate(45deg);
        background: var(--wf-card); border: 1px solid var(--color-border); box-shadow: var(--wf-shadow); transition: border-color 0.25s;
    }
    .wfe-diamond[data-selected="true"]::before { border-color: var(--wf-accent); }
    .wfe-diamond[data-issue="true"]::before { border-color: var(--wf-issue); }
    .wfe-diamond svg { position: relative; width: 20px; height: 20px; color: var(--wf-accent); }
    .wfe-cond { display: flex; flex-direction: column; align-items: center; }
    .wfe-cond-summary { margin-top: 14px; }
    .wfe-cond-summary::before { content: ''; position: absolute; left: 50%; top: -15px; width: 1.5px; height: 14px; background: var(--wf-line); }
    .wfe-branches { display: grid; grid-template-columns: 1fr 1fr; column-gap: 36px; align-items: start; position: relative; margin-top: 18px; padding-top: 30px; }
    .wfe-branches::before { content: ''; position: absolute; top: 0; left: calc(25% - 9px); right: calc(25% - 9px); height: 30px; border: 1.5px solid var(--wf-line); border-bottom: none; border-radius: 14px 14px 0 0; }
    .wfe-branches::after { content: ''; position: absolute; top: -18px; left: 50%; width: 1.5px; height: 18px; background: var(--wf-line); }
    .wfe-branch { display: flex; flex-direction: column; align-items: center; min-width: 0; }
    .wfe-branch-label {
        font-size: 0.74rem; font-weight: 600; color: var(--color-text-muted); padding: 5px 12px; border-radius: 100px;
        background: var(--wf-card); box-shadow: 0 0 0 1px var(--color-border); margin-bottom: 14px; white-space: nowrap;
    }
    .wfe-end { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--wf-line); background: var(--color-bg-soft); margin-top: 4px; }

    .wfe-scrim { position: fixed; inset: 0; z-index: 900; background: rgba(10,25,47,0.28); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
    .wfe-panel {
        position: absolute; top: 12px; right: 12px; bottom: 12px; z-index: 30; width: min(400px, calc(100% - 24px));
        display: flex; flex-direction: column; background: var(--editor-panel, #fff); border-radius: 22px;
        box-shadow: var(--editor-panel-shadow, 0 16px 40px -8px rgba(10,25,47,0.2)); animation: wfeSlide 0.32s var(--ease-spring);
    }
    @media (min-width: 881px) {
        .wfe-stage:has(.wfe-panel:not([hidden])) .wfe-flow { padding-right: 440px; }
    }
    @keyframes wfeSlide { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
    .wfe-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 18px 20px 14px; border-bottom: 1px solid var(--color-border); }
    .wfe-panel-head h2 { margin: 0; font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; color: var(--color-text); }
    .wfe-panel-body { flex: 1; overflow-y: auto; padding: 18px 20px; display: flex; flex-direction: column; gap: 18px; }
    .wfe-panel-foot { padding: 14px 20px; border-top: 1px solid var(--color-border); display: flex; justify-content: flex-end; }
    .wfe-field { display: flex; flex-direction: column; gap: 6px; }
    .wfe-field > label, .wfe-field-label { font-size: 0.8rem; font-weight: 600; color: var(--color-text); }
    .wfe-hint { font-size: 0.74rem; line-height: 1.45; color: var(--color-text-muted); margin: 0; }
    .wfe-input, .wfe-select, .wfe-textarea {
        width: 100%; box-sizing: border-box; font-family: var(--font-sans); font-size: 0.88rem; color: var(--color-text);
        background: var(--editor-field, #f5f5f7); border: 1px solid transparent; border-radius: 11px; padding: 10px 12px;
        transition: border-color 0.2s, background 0.2s;
    }
    .wfe-textarea { min-height: 96px; resize: vertical; line-height: 1.5; }
    .wfe-input:hover, .wfe-select:hover, .wfe-textarea:hover { background: var(--editor-field-hover, #ececee); }
    .wfe-input:focus, .wfe-select:focus, .wfe-textarea:focus { outline: none; border-color: rgba(10,25,47,0.15); box-shadow: 0 0 0 3px var(--editor-focus-ring, rgba(10,25,47,0.08)); }
