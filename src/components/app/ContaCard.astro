---
import SettingsSection from './settings/SettingsSection.astro';
import { t, type AppLocale } from '../../i18n/app';

interface Props {
    lang: AppLocale;
    proveedor: 'quickbooks' | 'xero';
    conexion: {
        cuenta: string; cuentaNombre: string | null; ultimaSync: string | null; estado: string;
        aviso?: { motivo: 'impuesto' | 'retenciones' | 'descuadre'; tasa: number | null } | null;
    } | null;
    /** Pagos: si la conexión tiene permiso y, en Xero, la cuenta de banco elegida. */
    pagos: { permiso: boolean; cuenta: string | null } | null;
    disponible: boolean;
    flash: string | null;
}

const { lang: L, proveedor, conexion, pagos, disponible, flash } = Astro.props;
const FLASH = ['conectada', 'cancelada', 'estado', 'empresa', 'error'];
const esQb = proveedor === 'quickbooks';
const conectada = Boolean(conexion) && conexion?.estado !== 'desconectada';
const fecha = conexion?.ultimaSync
    ? new Date(conexion.ultimaSync).toLocaleString(L === 'en' ? 'en-US' : 'es-MX', { dateStyle: 'medium', timeStyle: 'short' })
    : null;
const pct = (tasa: number) => `${Number((tasa * 100).toFixed(4))}%`;
const textoAviso = (a: { motivo: string; tasa: number | null }) =>
    a.motivo === 'impuesto' && a.tasa === null
        ? t(L, 'conta.aviso.impuesto_general')
        : t(L, `conta.aviso.${a.motivo}` as any).replace('{tasa}', a.tasa === null ? '' : pct(a.tasa));
const aviso = conexion?.aviso ? textoAviso(conexion.aviso) : null;
---

<SettingsSection icon="sliders" class="s-block" data-conta={proveedor}>
    <Fragment slot="heading">{t(L, 'set.integ.det.conexion')}</Fragment>
    <div class="s-body">
        {flash && FLASH.includes(flash) && (
            <p class="ct-flash" data-bad={flash !== 'conectada' ? '1' : undefined}>{t(L, `conta.flash_${flash}` as any)}</p>
        )}

        <p class="ct-que">{t(L, esQb ? 'conta.qb.que_hace' : 'conta.x.que_hace')}</p>

        {conectada ? (
            <Fragment>
                {conexion?.estado === 'error' && <p class="ct-flash" data-bad="1">{t(L, 'conta.reconectar_aviso')}</p>}
                {aviso && <p class="ct-flash" data-bad="1">{aviso}</p>}
                <p class="ct-conn">
                    {t(L, 'conta.conectado_a')} <b>{conexion?.cuentaNombre || conexion?.cuenta}</b>
                </p>
                <p class="ct-sync">{t(L, 'conta.ultima_sync')} {fecha ?? t(L, 'conta.nunca')}</p>
                <div class="ct-actions">
                    <button class="ct-btn-solid" data-ct-sync>{t(L, 'conta.contabilizar')}</button>
                    <button class="ct-btn-ghost" data-ct-off>{t(L, 'conta.desconectar')}</button>
                </div>

                <div class="ct-pagos">
                    <h4>{t(L, 'conta.pagos_titulo')}</h4>
                    <p class="ct-que">{t(L, esQb ? 'conta.qb.pagos' : 'conta.x.pagos')}</p>
                    {!esQb && !pagos?.permiso && (
                        <p class="ct-flash" data-bad="1">{t(L, 'conta.x.pagos_permiso')}
                            <button class="ct-btn-ghost ct-inline" data-ct-conectar>{t(L, 'conta.x.reconectar_pagos')}</button>
                        </p>
                    )}
                    {!esQb && pagos?.permiso && (
                        <div class="s-field">
                            <label for="ctCuenta">{t(L, 'conta.x.cuenta_label')}</label>
                            <select class="s-input" id="ctCuenta" data-actual={pagos.cuenta ?? ''}>
                                <option value="">{t(L, 'conta.x.cuenta_elige')}</option>
                            </select>
                        </div>
                    )}
                </div>
            </Fragment>
        ) : (
            <div class="ct-actions">
                <button class="ct-btn-solid" data-ct-conectar disabled={!disponible}>
                    {t(L, esQb ? 'conta.conectar_qb' : 'conta.conectar_xero')}
                </button>
                {!disponible && <span class="ct-pronto">{t(L, 'conta.no_disponible')}</span>}
            </div>
        )}

        <span class="ct-msg" data-ct-msg
            data-proveedor={proveedor}
            data-i18n-no-conecto={t(L, 'conta.err.no_conecto')}
            data-i18n-no-desconecto={t(L, 'conta.err.no_desconecto')}
            data-i18n-enviando={t(L, 'conta.contabilizando')}
            data-i18n-resultado={t(L, 'conta.resultado')}
            data-i18n-omitidas={t(L, 'conta.omitidas')}
            data-i18n-impuesto={t(L, 'conta.aviso.impuesto')}
            data-i18n-impuesto-general={t(L, 'conta.aviso.impuesto_general')}
            data-i18n-retenciones={t(L, 'conta.aviso.retenciones')}
            data-i18n-descuadre={t(L, 'conta.aviso.descuadre')}
            data-i18n-pagos={t(L, 'conta.resultado_pagos')}
            data-i18n-cuenta-guardada={t(L, 'conta.x.cuenta_guardada')}
            data-i18n-sin-cuentas={t(L, 'conta.x.sin_cuentas')}></span>
    </div>
</SettingsSection>

<style>
    .ct-flash { font-size: 0.82rem; margin: 0 0 1rem; color: var(--color-ok); }
    .ct-flash[data-bad] { color: var(--color-danger); }
    .ct-que { font-size: 0.85rem; line-height: 1.5; color: var(--color-text-muted); margin: 0 0 1rem; max-width: 62ch; }
    .ct-conn { font-size: 0.9rem; margin: 0 0 0.35rem; color: var(--color-text); }
    .ct-sync { font-size: 0.82rem; color: var(--color-text-muted); margin: 0 0 1rem; }
    .ct-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .ct-pagos { margin-top: 1.6rem; padding-top: 1.3rem; border-top: 1px solid var(--color-border); }
    .ct-pagos h4 { font-size: 0.86rem; font-weight: 650; color: var(--color-text); margin: 0 0 0.35rem; }
    .ct-inline { margin-left: 0.5rem; padding: 5px 12px; }
    .ct-pronto { font-size: 0.78rem; color: var(--color-text-muted); }
    .ct-msg { display: block; margin-top: 0.8rem; min-height: 1.2em; font-size: 0.78rem; font-weight: 600; }
    .ct-msg:global(.ok) { color: var(--color-ok); }
    .ct-msg:global(.err) { color: var(--color-danger); }
    .ct-btn-solid { display: inline-flex; align-items: center; font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 9px; padding: 9px 18px; cursor: pointer; }
    .ct-btn-solid:disabled, .ct-btn-ghost:disabled { opacity: 0.6; cursor: not-allowed; }
    .ct-btn-ghost { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 9px; padding: 9px 16px; cursor: pointer; }
    .ct-btn-solid:focus-visible, .ct-btn-ghost:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }

    @media (max-width: 560px) {
        .ct-actions { display: grid; grid-template-columns: 1fr; width: 100%; }
        .ct-btn-solid, .ct-btn-ghost { min-height: 46px; width: 100%; justify-content: center; }
    }
</style>

<script>
    function initConta() {
        const msg = document.querySelector<HTMLElement>('[data-ct-msg]');
        if (!msg) return;
        const proveedor = msg.dataset.proveedor;
        const flash = (text: string, ok: boolean) => {
            msg.textContent = text;
            msg.className = 'ct-msg ' + (ok ? 'ok' : 'err');
        };
        const pedir = (ruta: string, metodo: string) => fetch(ruta, {
            method: metodo, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ proveedor }),
        });

        const conectar = document.querySelector<HTMLButtonElement>('[data-ct-conectar]');
        conectar?.addEventListener('click', async () => {
            conectar.disabled = true;
            try {
                const res = await pedir('/api/integraciones/contabilidad/conectar', 'POST');
                const d = await res.json();
                if (!res.ok || !d.redirect) throw new Error(d.error || '');
                window.location.href = d.redirect;
            } catch (err: any) {
                flash(err.message || msg.dataset.i18nNoConecto || '', false);
                conectar.disabled = false;
            }
        });

        const off = document.querySelector<HTMLButtonElement>('[data-ct-off]');
        off?.addEventListener('click', async () => {
            off.disabled = true;
            try {
                const res = await pedir('/api/integraciones/contabilidad/conectar', 'DELETE');
                if (!res.ok) throw new Error();
                window.location.href = window.location.pathname;
            } catch {
                flash(msg.dataset.i18nNoDesconecto || '', false);
                off.disabled = false;
            }
        });

        const sync = document.querySelector<HTMLButtonElement>('[data-ct-sync]');
        sync?.addEventListener('click', async () => {
            sync.disabled = true;
            flash(msg.dataset.i18nEnviando || '', true);
            try {
                const res = await pedir('/api/integraciones/contabilidad/sync', 'POST');
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || '');
                const facturas = (msg.dataset.i18nResultado || '').replace('{facturas}', String(d.facturas ?? 0));
                const pagosTxt = d.pagos ? ' ' + (msg.dataset.i18nPagos || '').replace('{enviados}', String(d.pagos.enviados ?? 0)).replace('{recibidos}', String(d.pagos.recibidos ?? 0)) : '';
                const listo = facturas + pagosTxt;
                if (!d.omitidas) return flash(listo, true);
                const a = d.aviso || {};
                const plantilla = a.motivo === 'impuesto' && a.tasa == null ? msg.dataset.i18nImpuestoGeneral
                    : a.motivo === 'retenciones' ? msg.dataset.i18nRetenciones
                    : a.motivo === 'descuadre' ? msg.dataset.i18nDescuadre
                    : msg.dataset.i18nImpuesto;
                const tasa = a.tasa == null ? '' : `${Number((a.tasa * 100).toFixed(4))}%`;
                const omitidas = (msg.dataset.i18nOmitidas || '').replace('{n}', String(d.omitidas));
                flash(`${listo} ${omitidas} ${(plantilla || '').replace('{tasa}', tasa)}`, false);
            } catch (err: any) {
                flash(err.message || '', false);
            } finally {
                sync.disabled = false;
            }
        });
    }
    function initCuenta() {
        const sel = document.getElementById('ctCuenta') as HTMLSelectElement | null;
        const msg = document.querySelector<HTMLElement>('[data-ct-msg]');
        if (!sel || !msg) return;
        const actual = sel.dataset.actual || '';
        fetch('/api/integraciones/contabilidad/cuentas')
            .then((r) => (r.ok ? r.json() : null))
            .then((d) => {
                const cuentas = d && Array.isArray(d.cuentas) ? d.cuentas : [];
                if (!cuentas.length) { msg.textContent = msg.dataset.i18nSinCuentas || ''; msg.className = 'ct-msg err'; return; }
                for (const c of cuentas) {
                    const o = document.createElement('option');
                    o.value = c.id; o.textContent = c.nombre; o.selected = c.id === actual;
                    sel.appendChild(o);
                }
            })
            .catch(() => {});
        sel.addEventListener('change', async () => {
            if (!sel.value) return;
            sel.disabled = true;
            try {
                const res = await fetch('/api/integraciones/contabilidad/cuentas', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cuenta: sel.value }),
                });
                if (!res.ok) throw new Error();
                msg.textContent = msg.dataset.i18nCuentaGuardada || ''; msg.className = 'ct-msg ok';
            } catch {
                msg.className = 'ct-msg err';
            } finally {
                sel.disabled = false;
            }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCuenta);
    else initCuenta();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initConta);
    else initConta();
</script>
