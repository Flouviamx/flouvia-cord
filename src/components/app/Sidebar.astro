---
// Sidebar — navegación principal de la app (estilo Linear / Stripe).
//
// - La estructura sale de `src/lib/sidebar-nav.ts`: el mismo dato arma el menú,
//   los atajos `G` + letra, sus filas en el panel de atajos y el icono que hereda
//   cada fijado.
// - El marco es ESTÁTICO: sin animación de entrada ni indicador posicionado por
//   JS. Cada navegación recarga la página, así que cualquier animación del marco
//   corría en cada clic y hacía sentir la app más lenta. El activo es un fondo
//   fijo; el hover es otro tinte, más tenue, y nunca le roba el lugar.
// - Fijados y grupos plegados son preferencias por miembro
//   (org_members.widget_prefs) y se pintan aquí en el SSR: pintarlos desde JS
//   empujaba todo el menú hacia abajo en cada carga.

import { getSidebarBadges, getOrg, getUserProfile, getPlanUsage } from '../../lib/queries';
import CustomOrgSwitcher from './CustomOrgSwitcher';
import { currentLocale } from '../../lib/context';
import { t } from '../../i18n/app';
import { iconInner } from '../../lib/icons';
import { SIDEBAR_NAV, sanitizeSidebarPrefs, sidebarIconFor, type SidebarBadge, type SidebarNavItem } from '../../lib/sidebar-nav';

interface Props {
    page: string;     // id de la página activa (ver SIDEBAR_NAV)
    prefs?: unknown;  // org_members.widget_prefs['cord.sidebar.v1'], sin validar
}

const { page, prefs } = Astro.props;
const L = currentLocale();

const [badges, ORG, userProfile, usage] = await Promise.all([
    getSidebarBadges(),
    getOrg(),
    getUserProfile(),
    // El medidor es informativo: si el plan no se puede leer, la sidebar sigue.
    getPlanUsage().catch(() => null),
]);
const orgLogoUrl = ORG.logoUrl || '';

const BADGES: Record<SidebarBadge, { n: number; tone: 'neutral' | 'danger'; tip: string }> = {
    seguimiento: {
        n: badges.seguimiento, tone: 'neutral',
        tip: `${badges.seguimiento} ${t(L, badges.seguimiento === 1 ? 'dash.kpi_vista_singular' : 'dash.kpi_vista_plural')}`,
    },
    vencidas: {
        n: badges.vencidas, tone: 'danger',
        tip: `${badges.vencidas} ${t(L, badges.vencidas === 1 ? 'sidebar.badge.vencida' : 'sidebar.badge.vencidas')}`,
    },
};
const badgeOf = (it: SidebarNavItem) => {
    const b = it.badge ? BADGES[it.badge] : null;
    return b && b.n > 0 ? b : null;
};

const saved = sanitizeSidebarPrefs(prefs);
const collapsedGroups = new Set(saved.collapsed);
const sectionActive = (it: SidebarNavItem) => page === it.id || !!it.children?.some((c) => c.id === page);

// Misma llave que usa el script para comparar fijados: la ruta, salvo Informes,
// donde cada reporte (?r=) es una página distinta.
const pinKey = (href: string) => {
    const u = new URL(href, 'http://cord.local');
    return u.pathname === '/app/informes' ? `${u.pathname}?r=${u.searchParams.get('r') || 'resumen'}` : u.pathname;
};
const here = pinKey(Astro.url.pathname + Astro.url.search);
const pins = (saved.pins ?? []).map((p) => ({ ...p, icon: sidebarIconFor(p.href), active: pinKey(p.href) === here }));

const showPlan = !!usage && !usage.ilimitado;
const toggleLabel = t(L, 'sidebar.alternar_menu');
---

<div class="sb-backdrop" id="sbBackdrop" aria-hidden="true"></div>
<aside class="sidebar" id="sidebar">
    <div class="sb-account">
        <CustomOrgSwitcher client:load orgLogoUrl={orgLogoUrl} user={userProfile} activeOrg={ORG} locale={L} />
    </div>

    <!-- Acciones del drawer — solo móvil (en escritorio viven en la topbar) -->
    <div class="sb-mobile-actions">
        <button class="sb-action-row" id="sbHelp" type="button" data-id="ayuda">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('help')}></svg>
            <span>{t(L, 'sidebar.ayuda')}</span>
        </button>
        <a href="/app/ajustes" class="sb-action-row" data-id="config">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('gear')}></svg>
            <span>{t(L, 'sidebar.configuracion')}</span>
        </a>
    </div>

    <nav class="sb-nav" aria-label={t(L, 'sidebar.aria.nav')}>
        <!-- Fijados: SSR desde las preferencias del miembro; el script los vuelve a
             pintar clonando #sbPinTpl, así hay un solo markup de fila. -->
        <div
            class="sb-group sb-pins" id="sbPins" hidden={!pins.length}
            data-pins={JSON.stringify(saved.pins ?? [])}
            data-pins-saved={saved.pins ? '1' : '0'}
            data-collapsed={JSON.stringify(saved.collapsed)}
            data-pin-on={t(L, 'sidebar.pin.quitar_menu')} data-pin-off={t(L, 'layout.aria.fijar_menu')}
            data-pin-toast-on={t(L, 'sidebar.pin.toast_on')} data-pin-toast-off={t(L, 'sidebar.pin.toast_off')}
        >
            <div class="sb-group-head">{t(L, 'sidebar.grupo.fijados')}</div>
            <div class="sb-pin-list" id="sbPinList">
                {pins.map((p) => (
                    <div class="sb-pin-row" draggable="true" data-href={p.href}>
                        <a href={p.href} class:list={['sb-item', { active: p.active }]} aria-current={p.active ? 'page' : undefined} data-tip={p.label}>
                            <svg class="sb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner(p.icon)}></svg>
                            <span class="sb-item-label">{p.label}</span>
                        </a>
                        <button type="button" class="sb-pin-x" aria-label={t(L, 'sidebar.pin.quitar')}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('x')}></svg>
                        </button>
                    </div>
                ))}
            </div>
            <template id="sbPinTpl">
                <div class="sb-pin-row" draggable="true">
                    <a href="/app" class="sb-item">
                        <svg class="sb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></svg>
                        <span class="sb-item-label"></span>
                    </a>
                    <button type="button" class="sb-pin-x" aria-label={t(L, 'sidebar.pin.quitar')}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('x')}></svg>
                    </button>
                </div>
            </template>
        </div>

        {SIDEBAR_NAV.map((group) => {
            const open = !group.label || !collapsedGroups.has(group.id) || group.items.some(sectionActive);
            return (
                <div class:list={['sb-group', { 'sb-group-flat': !group.label }]} data-group={group.id}>
                    {group.label && (
                        <button type="button" class="sb-group-label" aria-expanded={open ? 'true' : 'false'} aria-controls={`sbGroup-${group.id}`}>
                            <span>{t(L, group.label)}</span>
                            <svg class="sb-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-down')}></svg>
                        </button>
                    )}
                    <div class="sb-group-content" id={`sbGroup-${group.id}`}>
                        <div class="sb-group-inner">
                            {group.items.map((it) => {
                                const b = badgeOf(it);
                                const label = t(L, it.label);
                                const inSection = sectionActive(it);
                                return (
                                    <Fragment>
                                        <a
                                            href={it.href} data-id={it.id} data-key={it.key}
                                            data-tip={label} data-tip-sub={b?.tip}
                                            class:list={['sb-item', { active: page === it.id, 'is-section': inSection && page !== it.id }]}
                                            aria-current={page === it.id ? 'page' : undefined}
                                        >
                                            <svg class="sb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner(it.icon)}></svg>
                                            <span class="sb-item-label">{label}</span>
                                            {b && (
                                                <span class:list={['sb-badge', b.tone]} title={b.tip}>
                                                    <span aria-hidden="true">{b.n > 99 ? '99+' : b.n}</span>
                                                    <span class="sb-sr">{b.tip}</span>
                                                </span>
                                            )}
                                            {it.key && !b && (
                                                <span class="sb-shortcut" aria-hidden="true"><kbd>G</kbd><kbd>{it.key.toUpperCase()}</kbd></span>
                                            )}
                                        </a>
                                        {it.children && inSection && (
                                            <div class="sb-sub">
                                                {it.children.map((c) => (
                                                    <a
                                                        href={c.href} data-id={c.id} data-tip={`${label} · ${t(L, c.label)}`}
                                                        class:list={['sb-item', { active: page === c.id }]}
                                                        aria-current={page === c.id ? 'page' : undefined}
                                                    >
                                                        <svg class="sb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner(c.icon)}></svg>
                                                        <span class="sb-item-label">{t(L, c.label)}</span>
                                                    </a>
                                                ))}
                                            </div>
                                        )}
                                    </Fragment>
                                );
                            })}
                        </div>
                    </div>
                </div>
            );
        })}
    </nav>

    <div class="sb-footer">
        {showPlan && usage && (
            <a class:list={['sb-plan', { warn: usage.pct >= 80 && !usage.excedido, full: usage.excedido }]} href="/app/ajustes/plan">
                <span class="sb-plan-top">
                    <span>{t(L, 'set.plan.cotizaciones_activas')}</span>
                    <span class="sb-plan-count">{usage.usadas} / {usage.limite}</span>
                </span>
                <span class="sb-plan-bar" aria-hidden="true"><span style={`width:${usage.pct}%`}></span></span>
                <span class="sb-plan-cta">{t(L, 'sidebar.plan.mejorar')}</span>
            </a>
        )}
        <div class="sb-footer-row">
            <button class="sb-toggle" id="sbToggleFloating" type="button" aria-label={toggleLabel} aria-controls="sidebar" title={`${toggleLabel}  [`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('sidebar')}></svg>
            </button>
        </div>
    </div>
</aside>
<!-- Tooltip del modo colapsado. Fuera del <aside> a propósito: el backdrop-filter
     del aside lo vuelve bloque contenedor de todo `position: fixed` interno, y el
     overflow del nav recortaría un tooltip absoluto. -->
<div class="sb-tip" id="sbTip" aria-hidden="true"></div>

<style>
    /* ── Marco ── */
    .sidebar {
        width: var(--sidebar-w);
        flex-shrink: 0;
        /* Pill flotante de vidrio — mismo material que la topbar vía --sb-* */
        background: var(--sb-bg);
        backdrop-filter: blur(40px) saturate(1.8);
        -webkit-backdrop-filter: blur(40px) saturate(1.8);
        border: none;
        box-shadow: var(--sb-shadow);
        border-radius: 22px;
        margin: 1rem;
        height: calc(100vh - 2rem);
        display: flex; flex-direction: column;
        padding: 0.9rem 0.6rem 0.7rem;
        position: sticky; top: 1rem;
        z-index: 800;
        transition: width 0.24s var(--ease-spring), padding 0.24s var(--ease-spring);
    }
    /* Los fondos de --sb-bg (72% claro, 75% oscuro) DEPENDEN del blur para verse
       sólidos. Sin él —GPU sin composición, "Reducir transparencia" del SO,
       navegador viejo— la sidebar se transparenta. El test cubre las DOS formas
       con `or`: un `not (backdrop-filter: …)` a secas no dispara en un navegador
       que soporta la estándar pero recibió sólo la prefijada. */
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .sidebar { background: var(--sb-bg-solid); }
    }

    .sb-account { position: relative; padding-bottom: 0.55rem; margin-bottom: 0.45rem; }
    .sb-account::after {
        content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
        background: linear-gradient(to right, transparent, var(--sb-divider) 25%, var(--sb-divider) 75%, transparent);
    }

    /* ── Nav ── */
    .sb-nav {
        display: flex; flex-direction: column;
        overflow-y: auto; flex: 1; min-height: 0;
        scrollbar-width: none;
    }
    .sb-nav::-webkit-scrollbar { display: none; }
    .sb-group { display: flex; flex-direction: column; }
    .sb-group + .sb-group { margin-top: 0.7rem; }

    .sb-group-label, .sb-group-head {
        display: flex; align-items: center; gap: 4px;
        padding: 4px 10px 4px; margin-bottom: 1px;
        font-family: inherit; font-size: 0.72rem; font-weight: 500; letter-spacing: 0;
        color: var(--sb-label);
    }
    .sb-group-label {
        width: fit-content; max-width: 100%;
        background: none; border: none; border-radius: 6px; cursor: pointer; text-align: left;
        transition: color 0.12s;
    }
    .sb-group-label:hover { color: var(--sb-text-strong); }
    .sb-group-chevron { width: 11px; height: 11px; opacity: 0; transition: opacity 0.12s, transform 0.2s var(--ease-ios); }
    .sb-group-label:hover .sb-group-chevron,
    .sb-group-label:focus-visible .sb-group-chevron,
    .sb-group-label[aria-expanded="false"] .sb-group-chevron { opacity: 0.8; }
    .sb-group-label[aria-expanded="false"] .sb-group-chevron { transform: rotate(-90deg); }

    .sb-group-content { display: grid; grid-template-rows: 1fr; transition: grid-template-rows 0.22s var(--ease-ios); }
    .sb-group-inner { display: flex; flex-direction: column; gap: 1px; min-height: 0; overflow: hidden; }
    .sb-group-label[aria-expanded="false"] + .sb-group-content { grid-template-rows: 0fr; }
    /* Plegado también fuera del orden de tabulación, no solo fuera de la vista. */
    .sb-group-label[aria-expanded="false"] + .sb-group-content .sb-group-inner { visibility: hidden; transition: visibility 0s 0.22s; }

    /* ── Ítem: fila de 30px. El activo es un fondo fijo; el hover, otro más tenue. ── */
    .sb-item {
        position: relative;
        display: flex; align-items: center; gap: 10px;
        height: 30px; padding: 0 8px 0 10px; border-radius: 8px;
        font-size: 0.84rem; font-weight: 500; letter-spacing: -0.005em;
        color: var(--sb-text); text-decoration: none;
        transition: background-color 0.12s, color 0.12s;
    }
    .sb-ico { width: 16px; height: 16px; flex-shrink: 0; opacity: var(--sb-icon-op); transition: opacity 0.12s; }
    .sb-item-label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sb-item:hover { background: var(--sb-hover-bg); color: var(--sb-text-strong); }
    .sb-item:hover .sb-ico { opacity: 0.9; }
    .sb-item.is-section { color: var(--sb-text-strong); }
    .sb-item.active { background: var(--sb-active-bg); color: var(--sb-text-active); }
    .sb-item.active .sb-ico, .sb-item.is-section .sb-ico { opacity: 1; }

    /* Foco de teclado visible (regla 5). */
    .sb-item:focus-visible,
    .sb-group-label:focus-visible,
    .sb-action-row:focus-visible,
    .sb-pin-x:focus-visible,
    .sb-plan:focus-visible,
    .sb-toggle:focus-visible { outline: 2px solid var(--sb-text-active); outline-offset: -2px; }

    /* Sub-páginas de una sección (Cobranza → Agente IA): con sangría y una guía. */
    .sb-sub { position: relative; display: flex; flex-direction: column; gap: 1px; padding-left: 23px; }
    .sb-sub::before {
        content: ''; position: absolute; left: 17px; top: 3px; bottom: 3px; width: 1px;
        background: var(--sb-divider);
    }
    .sb-sub .sb-item { padding-left: 12px; }
    .sb-sub .sb-ico { display: none; }

    /* ── Contador: solo lo accionable. Neutro gris; vencidas en tinte, no rojo sólido. ── */
    .sb-badge {
        flex-shrink: 0; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 6px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 0.68rem; font-weight: 600; font-variant-numeric: tabular-nums;
        color: var(--sb-badge-text); background: var(--sb-badge-bg);
    }
    .sb-badge.danger { color: var(--sb-danger-text); background: var(--sb-danger-bg); }
    .sb-sr {
        position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
    }

    /* Atajo `G` + letra: aparece al detenerse sobre el ítem, no al pasar de largo. */
    .sb-shortcut { display: inline-flex; gap: 2px; opacity: 0; transition: opacity 0.12s; }
    .sb-item:hover .sb-shortcut { opacity: 1; transition-delay: 0.45s; }
    .sb-shortcut kbd, .sb-tip :global(kbd) {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 16px; height: 16px; padding: 0 3px; border-radius: 4px;
        font-family: inherit; font-size: 0.62rem; font-weight: 600; line-height: 1;
        color: var(--sb-label); background: var(--sb-badge-bg);
    }

    /* ── Fijados ── */
    .sb-pins[hidden] { display: none; }
    .sb-pins + .sb-group { margin-top: 0.7rem; }
    .sb-pin-list { display: flex; flex-direction: column; gap: 1px; }
    .sb-pin-row { position: relative; display: flex; }
    .sb-pin-row .sb-item { flex: 1; min-width: 0; }
    .sb-pin-row:hover .sb-item { padding-right: 32px; }
    .sb-pin-x {
        position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
        width: 22px; height: 22px; border-radius: 6px;
        display: inline-flex; align-items: center; justify-content: center;
        border: none; background: none; cursor: pointer; color: var(--sb-label);
        opacity: 0; transition: opacity 0.12s, color 0.12s, background-color 0.12s;
    }
    .sb-pin-x svg { width: 12px; height: 12px; }
    .sb-pin-row:hover .sb-pin-x, .sb-pin-x:focus-visible { opacity: 1; }
    .sb-pin-x:hover { color: var(--sb-text-strong); background: var(--sb-hover-bg); }
    .sb-pin-row.dragging { opacity: 0.4; }
    .sb-pin-row.drop-before::before, .sb-pin-row.drop-after::after {
        content: ''; position: absolute; left: 8px; right: 8px; height: 2px; border-radius: 2px;
        background: var(--sb-text-active); pointer-events: none;
    }
    .sb-pin-row.drop-before::before { top: -1px; }
    .sb-pin-row.drop-after::after { bottom: -1px; }
    .sb-pin-row.is-new { animation: sb-pin-in 0.2s var(--ease-ios); }
    @keyframes sb-pin-in { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: none; } }

    /* ── Pie: medidor del plan + colapsar ── */
    .sb-footer { display: flex; flex-direction: column; gap: 0.5rem; padding-top: 0.6rem; }
    .sb-footer-row { display: flex; justify-content: flex-end; }
    .sb-plan {
        display: flex; flex-direction: column; gap: 6px;
        padding: 9px 10px; border-radius: 10px;
        text-decoration: none; background: var(--sb-hover-bg);
        transition: background-color 0.12s;
    }
    .sb-plan:hover { background: var(--sb-active-bg); }
    .sb-plan-top { display: flex; justify-content: space-between; gap: 8px; font-size: 0.74rem; color: var(--sb-text); }
    .sb-plan-count { color: var(--sb-text-strong); font-weight: 600; font-variant-numeric: tabular-nums; }
    .sb-plan-bar { height: 4px; border-radius: 2px; background: var(--sb-badge-bg); overflow: hidden; }
    .sb-plan-bar > span { display: block; height: 100%; border-radius: inherit; background: var(--sb-text-active); }
    .sb-plan.warn .sb-plan-bar > span { background: #d97706; }
    .sb-plan.full .sb-plan-bar > span { background: var(--color-danger); }
    .sb-plan-cta { font-size: 0.74rem; font-weight: 600; color: var(--sb-text-active); }

    .sb-toggle {
        width: 28px; height: 28px; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        background: none; border: none; cursor: pointer; color: var(--sb-text);
        transition: background-color 0.12s, color 0.12s;
    }
    .sb-toggle:hover { background: var(--sb-hover-bg); color: var(--sb-text-strong); }
    .sb-toggle svg { width: 16px; height: 16px; }

    /* ── Tooltip del modo colapsado (lo posiciona el script) ── */
    .sb-tip {
        position: fixed; left: 0; top: 0; z-index: 900;
        display: flex; align-items: center; gap: 8px;
        padding: 6px 8px 6px 10px; border-radius: 8px;
        background: #0f1a2b; color: #fff;
        font-size: 0.76rem; font-weight: 500; white-space: nowrap;
        box-shadow: 0 10px 28px -10px rgba(0,0,0,0.5), inset 0 0 0 0.5px rgba(255,255,255,0.08);
        pointer-events: none; opacity: 0; transform: translateX(-3px);
        transition: opacity 0.1s, transform 0.1s;
    }
    .sb-tip.show { opacity: 1; transform: none; }
    .sb-tip :global(.sb-tip-sub) { color: rgba(255,255,255,0.6); }
    .sb-tip :global(kbd) { color: rgba(255,255,255,0.8); background: rgba(255,255,255,0.14); }
    .sb-tip :global(.sb-tip-keys) { display: inline-flex; gap: 2px; }

    /* ── Rail colapsado (solo escritorio) ── */
    @media (min-width: 881px) {
        :global(.sb-collapsed) .sidebar { padding-left: 0; padding-right: 0; }
        :global(.sb-collapsed) .sb-nav { align-items: center; }
        :global(.sb-collapsed) .sb-group { width: 100%; align-items: center; }
        :global(.sb-collapsed) .sb-group + .sb-group,
        :global(.sb-collapsed) .sb-pins + .sb-group { position: relative; margin-top: 8px; padding-top: 8px; }
        :global(.sb-collapsed) .sb-group + .sb-group::before,
        :global(.sb-collapsed) .sb-pins + .sb-group::before {
            content: ''; position: absolute; top: 0; left: 50%; width: 16px; margin-left: -8px; height: 1px;
            background: var(--sb-divider);
        }
        :global(.sb-collapsed) .sb-group-label,
        :global(.sb-collapsed) .sb-group-head { display: none; }
        /* En el rail se ven todos los ítems: plegar un grupo es cosa del menú ancho. */
        :global(.sb-collapsed) .sb-group-label + .sb-group-content { grid-template-rows: 1fr; }
        :global(.sb-collapsed) .sb-group-label + .sb-group-content .sb-group-inner { visibility: visible; }
        :global(.sb-collapsed) .sb-group-inner { align-items: center; }
        :global(.sb-collapsed) .sb-item { width: 40px; height: 36px; padding: 0; gap: 0; justify-content: center; border-radius: 10px; }
        :global(.sb-collapsed) .sb-ico { width: 18px; height: 18px; }
        :global(.sb-collapsed) .sb-item-label,
        :global(.sb-collapsed) .sb-shortcut,
        :global(.sb-collapsed) .sb-pin-x,
        :global(.sb-collapsed) .sb-plan { display: none; }
        :global(.sb-collapsed) .sb-pin-row:hover .sb-item { padding-right: 0; }
        :global(.sb-collapsed) .sb-sub { padding-left: 0; }
        :global(.sb-collapsed) .sb-sub .sb-item { padding: 0; }
        :global(.sb-collapsed) .sb-sub::before { display: none; }
        :global(.sb-collapsed) .sb-sub .sb-ico { display: block; }
        /* Contador → punto */
        :global(.sb-collapsed) .sb-badge {
            position: absolute; top: 6px; right: 7px;
            min-width: 0; width: 7px; height: 7px; padding: 0; border-radius: 50%;
            font-size: 0; background: var(--sb-text);
            box-shadow: 0 0 0 2px var(--sb-bg-solid);
        }
        :global(.sb-collapsed) .sb-badge.danger { background: var(--color-danger); }
        :global(.sb-collapsed) .sb-footer-row { justify-content: center; }
        /* Cuenta en el rail: mismo aire arriba (padding del aside) que abajo, y la
           línea corta y centrada como la de los grupos, no a todo lo ancho. */
        :global(.sb-collapsed) .sb-account { display: flex; justify-content: center; padding-bottom: 0.9rem; margin-bottom: 0.5rem; }
        :global(.sb-collapsed) .sb-account::after { left: 50%; right: auto; width: 16px; margin-left: -8px; background: var(--sb-divider); }
    }

    .sb-backdrop { display: none; }
    .sb-mobile-actions { display: none; }

    /* ── Móvil: drawer táctil (regla 16) ── */
    @media (max-width: 880px) {
        .sidebar {
            position: fixed; top: 0; left: 0; height: 100dvh; width: min(88vw, 360px); z-index: 300;
            transform: translate3d(calc(-100% - 1px), 0, 0);
            visibility: hidden;
            pointer-events: none;
            transition: transform 0.34s var(--ease-spring), visibility 0s linear 0.34s;
            box-shadow: 0 0 60px rgba(0,0,0,0.4);
            margin: 0; border-radius: 0 22px 22px 0;
            padding-left: 0.7rem; padding-right: 0.7rem;
            /* Respeta el notch arriba y la barra de inicio abajo (iPhone) */
            padding-top: calc(1.2rem + env(safe-area-inset-top));
            padding-bottom: calc(1rem + env(safe-area-inset-bottom));
            overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch;
            /* Sobre el fondo oscurecido el vidrio se veía gris: el drawer es sólido. */
            background: var(--sb-bg-solid);
        }
        /* Un solo scroll (el del drawer): el nav anidado escondía los últimos grupos. */
        .sb-nav { flex: none; overflow: visible; }
        .sb-footer { margin-top: auto; }
        :global(.app-shell.nav-open) .sidebar {
            transform: translate3d(0, 0, 0);
            visibility: visible;
            pointer-events: auto;
            transition: transform 0.34s var(--ease-spring), visibility 0s;
        }
        .sb-backdrop {
            display: block; position: fixed; inset: 0; z-index: 290;
            background: rgba(10,25,47,0.45); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
            opacity: 0; visibility: hidden; transition: opacity 0.3s var(--ease-ios), visibility 0s 0.3s;
        }
        :global(.app-shell.nav-open) .sb-backdrop { opacity: 1; visibility: visible; transition: opacity 0.3s var(--ease-ios); }

        .sb-mobile-actions { display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.2rem; }
        .sb-action-row {
            display: flex; align-items: center; gap: 14px; width: 100%;
            min-height: 48px; padding: 0 14px; border-radius: 14px; cursor: pointer;
            background: var(--sb-hover-bg); border: none; text-align: left; text-decoration: none;
            font-family: var(--font-sans); font-size: 0.95rem; font-weight: 500;
            color: var(--sb-text-strong);
        }
        .sb-action-row svg { width: 20px; height: 20px; flex-shrink: 0; opacity: 0.85; }
        .sb-action-row:active { background: var(--sb-active-bg); }

        /* Objetivos táctiles de 44px; sin atajos, sin tooltips, sin hover. */
        .sb-item { height: 44px; padding: 0 14px; gap: 14px; border-radius: 12px; font-size: 0.95rem; }
        .sb-ico { width: 20px; height: 20px; }
        .sb-sub { padding-left: 29px; }
        .sb-sub::before { left: 23px; }
        .sb-group-label, .sb-group-head { padding: 10px 14px 6px; font-size: 0.8rem; }
        .sb-group-chevron { opacity: 0.8; }
        .sb-group + .sb-group { margin-top: 1rem; }
        .sb-shortcut, .sb-tip { display: none; }
        /* Sin hover no hay forma de descubrir la X: en el drawer siempre se ve. */
        .sb-pin-row .sb-item { padding-right: 52px; }
        .sb-pin-x { opacity: 1; width: 44px; height: 44px; right: 0; }
        .sb-toggle { display: none; }
    }
</style>

<script>
    import { iconInner } from '../../lib/icons';
    import { LEGACY_ROUTES } from '../../lib/informes';

    const mobileUi = () => window.matchMedia('(max-width: 880px)').matches;
    const root = document.documentElement;
    const nav = document.querySelector('.sb-nav') as HTMLElement | null;
    const pinsEl = document.getElementById('sbPins') as HTMLElement | null;

    // ── Preferencias del miembro (fijados + grupos plegados) → servidor ──
    const PREFS_URL = '/api/app/sidebar-prefs';
    const parse = <T,>(raw: string | undefined, fallback: T): T => { try { return raw ? JSON.parse(raw) : fallback; } catch { return fallback; } };
    type Pin = { href: string; label: string };
    let pins: Pin[] = parse<Pin[]>(pinsEl?.dataset.pins, []);
    let collapsed: string[] = parse<string[]>(pinsEl?.dataset.collapsed, []);
    let saveTimer = 0;
    const save = () => {
        clearTimeout(saveTimer);
        saveTimer = window.setTimeout(() => {
            fetch(PREFS_URL, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pins, collapsed }),
                keepalive: true,
            }).catch(() => {}); // sin red: la UI ya refleja el cambio; se reintenta en el siguiente
        }, 250);
    };

    // ── Drawer (móvil) ──
    function initDrawer() {
        const shell = document.querySelector('.app-shell');
        const burger = document.getElementById('navBurger');
        const backdrop = document.getElementById('sbBackdrop');
        if (!shell || !burger) return;
        const close = () => { shell.classList.remove('nav-open'); document.body.style.overflow = ''; };
        burger.addEventListener('click', () => {
            const open = shell.classList.toggle('nav-open');
            document.body.style.overflow = open ? 'hidden' : '';
        });
        backdrop?.addEventListener('click', close);
        document.querySelector('.sidebar')?.addEventListener('click', (e) => {
            if ((e.target as HTMLElement).closest('a')) close();
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        document.getElementById('sbHelp')?.addEventListener('click', () => {
            close();
            document.getElementById('helpBtn')?.click();
        });
    }

    // ── Colapsar (persistente por dispositivo: es una preferencia de pantalla) ──
    function initCollapse() {
        const btn = document.getElementById('sbToggleFloating');
        const sync = () => btn?.setAttribute('aria-expanded', String(!root.classList.contains('sb-collapsed')));
        const toggle = () => {
            const v = !root.classList.contains('sb-collapsed');
            root.classList.toggle('sb-collapsed', v);
            try { localStorage.setItem('cord.sb.collapsed', v ? '1' : '0'); } catch (e) {}
            hideTip();
            sync();
        };
        btn?.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
        // Lo invoca el atajo `[` de AppLayout.
        (window as any).__cordToggleSidebar = () => { if (!mobileUi()) toggle(); };
        sync();
    }

    // ── Grupos plegables ──
    function initGroups() {
        document.querySelectorAll<HTMLButtonElement>('.sb-group-label').forEach((btn) => {
            btn.addEventListener('click', () => {
                if (root.classList.contains('sb-collapsed') && !mobileUi()) return;
                const open = btn.getAttribute('aria-expanded') !== 'true';
                btn.setAttribute('aria-expanded', String(open));
                const id = (btn.closest('.sb-group') as HTMLElement | null)?.dataset.group;
                if (!id) return;
                collapsed = open ? collapsed.filter((g) => g !== id) : [...new Set([...collapsed, id])];
                save();
            });
        });
    }

    // ── Tooltip del rail colapsado: etiqueta · contador · atajo ──
    const tip = document.getElementById('sbTip');
    function hideTip() { tip?.classList.remove('show'); }
    function initTooltip() {
        if (!nav || !tip) return;
        const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
        const show = (item: HTMLElement) => {
            if (!root.classList.contains('sb-collapsed') || mobileUi()) return;
            const { tip: label = '', tipSub: sub, key } = item.dataset;
            tip.innerHTML = `<span>${esc(label)}</span>`
                + (sub ? `<span class="sb-tip-sub">${esc(sub)}</span>` : '')
                + (key ? `<span class="sb-tip-keys"><kbd>G</kbd><kbd>${esc(key.toUpperCase())}</kbd></span>` : '');
            const r = item.getBoundingClientRect();
            tip.style.left = `${Math.round(r.right + 10)}px`;
            tip.style.top = `${Math.round(r.top + r.height / 2 - tip.offsetHeight / 2)}px`;
            tip.classList.add('show');
        };
        const target = (e: Event) => (e.target as HTMLElement).closest<HTMLElement>('.sb-item[data-tip]');
        nav.addEventListener('mouseover', (e) => { const it = target(e); if (it) show(it); });
        nav.addEventListener('mouseleave', hideTip);
        nav.addEventListener('focusin', (e) => { const it = target(e); if (it) show(it); });
        nav.addEventListener('focusout', hideTip);
        nav.addEventListener('scroll', hideTip, { passive: true });
    }

    // ── Fijados ──
    function initPins() {
        const list = document.getElementById('sbPinList');
        const tpl = document.getElementById('sbPinTpl') as HTMLTemplateElement | null;
        const pinBtn = document.getElementById('phPin');
        if (!pinsEl || !list || !tpl) return;
        const d = pinsEl.dataset;

        const hrefKey = (href: string) => {
            const url = new URL(href, location.origin);
            return url.pathname === '/app/informes' ? `${url.pathname}?r=${url.searchParams.get('r') || 'resumen'}` : url.pathname;
        };
        const here = () => hrefKey(location.href);
        const isPinned = () => pins.some((p) => hrefKey(p.href) === here());

        // Icono heredado de la sección: el mismo criterio que sidebarIconFor()
        // (prefijo más largo), leído del menú ya pintado para no duplicar la tabla.
        const navItems = [...document.querySelectorAll<HTMLAnchorElement>('.sb-group[data-group] .sb-item')];
        const iconFor = (href: string) => {
            const path = new URL(href, location.origin).pathname.replace(/\/+$/, '') || '/app';
            let best: HTMLAnchorElement | null = null;
            for (const a of navItems) {
                const h = a.getAttribute('href') || '';
                const hit = h === '/app' ? path === '/app' : path === h || path.startsWith(h + '/');
                if (hit && (!best || h.length > (best.getAttribute('href') || '').length)) best = a;
            }
            return best?.querySelector('svg')?.innerHTML || iconInner('pin');
        };

        const render = (fresh?: string) => {
            list.replaceChildren(...pins.map((p) => {
                const row = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
                const a = row.querySelector('a') as HTMLAnchorElement;
                const active = hrefKey(p.href) === here();
                row.dataset.href = p.href;
                a.setAttribute('href', p.href);
                a.dataset.tip = p.label;
                a.classList.toggle('active', active);
                if (active) a.setAttribute('aria-current', 'page');
                (a.querySelector('.sb-item-label') as HTMLElement).textContent = p.label;
                (a.querySelector('svg') as SVGElement).innerHTML = iconFor(p.href);
                if (fresh && p.href === fresh) row.classList.add('is-new');
                return row;
            }));
            pinsEl.hidden = !pins.length;
        };
        const syncBtn = () => {
            if (!pinBtn) return;
            const on = isPinned();
            pinBtn.classList.toggle('pinned', on);
            pinBtn.setAttribute('title', on ? (d.pinOn || '') : (d.pinOff || ''));
        };
        const commit = (fresh?: string) => { render(fresh); syncBtn(); save(); };

        // Migración única: los fijados vivían en localStorage. Si el servidor
        // nunca guardó fijados, se adoptan los locales y se suben.
        try {
            const LEGACY_KEY = 'cord.pins.v1';
            const local = JSON.parse(localStorage.getItem(LEGACY_KEY) || '[]');
            if (d.pinsSaved !== '1' && Array.isArray(local) && local.length) {
                pins = local
                    .filter((p: any) => p && typeof p.href === 'string' && typeof p.label === 'string')
                    .map((p: any) => ({ href: LEGACY_ROUTES[p.href as keyof typeof LEGACY_ROUTES] || p.href, label: p.label }));
                commit();
            }
            if (local.length) localStorage.removeItem(LEGACY_KEY);
        } catch (e) {}

        // Quitar
        list.addEventListener('click', (e) => {
            const x = (e.target as HTMLElement).closest('.sb-pin-x');
            if (!x) return;
            e.preventDefault(); e.stopPropagation();
            const href = (x.closest('.sb-pin-row') as HTMLElement | null)?.dataset.href;
            pins = pins.filter((p) => p.href !== href);
            commit();
        });

        // Reordenar arrastrando (solo escritorio, regla 16)
        let dragHref: string | null = null;
        const clearDrop = () => list.querySelectorAll('.drop-before, .drop-after').forEach((r) => r.classList.remove('drop-before', 'drop-after'));
        list.addEventListener('dragstart', (e) => {
            const row = (e.target as HTMLElement).closest<HTMLElement>('.sb-pin-row');
            if (!row || mobileUi()) { e.preventDefault(); return; }
            dragHref = row.dataset.href || null;
            e.dataTransfer!.effectAllowed = 'move';
            row.classList.add('dragging');
            hideTip();
        });
        list.addEventListener('dragover', (e) => {
            const row = (e.target as HTMLElement).closest<HTMLElement>('.sb-pin-row');
            if (!row || !dragHref) return;
            e.preventDefault();
            clearDrop();
            if (row.dataset.href === dragHref) return;
            const r = row.getBoundingClientRect();
            row.classList.add(e.clientY < r.top + r.height / 2 ? 'drop-before' : 'drop-after');
        });
        list.addEventListener('drop', (e) => {
            const row = (e.target as HTMLElement).closest<HTMLElement>('.sb-pin-row');
            if (!row || !dragHref || row.dataset.href === dragHref) return;
            e.preventDefault();
            const before = row.classList.contains('drop-before');
            const moved = pins.find((p) => p.href === dragHref);
            if (!moved) return;
            const rest = pins.filter((p) => p.href !== dragHref);
            const at = rest.findIndex((p) => p.href === row.dataset.href);
            rest.splice(before ? at : at + 1, 0, moved);
            pins = rest;
            commit();
        });
        list.addEventListener('dragend', () => {
            dragHref = null;
            clearDrop();
            list.querySelectorAll('.dragging').forEach((r) => r.classList.remove('dragging'));
        });

        // Fijar / quitar la página actual (botón del page-head y tecla X)
        const toggle = () => {
            const key = here();
            if (isPinned()) {
                pins = pins.filter((p) => hrefKey(p.href) !== key);
                if (d.pinToastOn) (window as any).cordToast?.(d.pinToastOn);
                commit();
            } else {
                const label = (document.querySelector('.ph-title')?.textContent || document.title).replace(/\s+/g, ' ').trim().slice(0, 80);
                pins = [...pins, { href: key, label }].slice(-12);
                if (d.pinToastOff) (window as any).cordToast?.(d.pinToastOff, 'ok');
                commit(key);
            }
        };
        pinBtn?.addEventListener('click', toggle);
        (window as any).__cordTogglePin = toggle;
        syncBtn();
    }

    function init() {
        initDrawer();
        initCollapse();
        initGroups();
        initTooltip();
        initPins();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
</script>
