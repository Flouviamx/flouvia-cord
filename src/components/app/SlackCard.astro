---
import { t, type AppLocale } from '../../i18n/app';

interface Props {
    lang: AppLocale;
    webhook: string;
    canal?: string;
    equipo?: string;
    oauth?: boolean;
    flash?: string | null;
}

const { lang: L, webhook, canal = '', equipo = '', oauth = false, flash = null } = Astro.props;
const FLASH = ['conectado', 'cancelada', 'estado', 'error'];
---

<div class="s-block" data-slack>
    <h3>{t(L, 'set.integ.det.conexion')}</h3>
    <div class="s-body">
        {flash && FLASH.includes(flash) && (
            <p class="slk-flash" data-bad={flash !== 'conectado' ? '1' : undefined}>{t(L, `set.integ.slack.flash_${flash}` as any)}</p>
        )}

        {oauth && (
            <div class="slk-oauth">
                {webhook && (
                    <p class="slk-conn">
                        {canal ? <>{t(L, 'set.integ.slack.conectado_a')} <b>{canal}</b>{equipo && ` · ${equipo}`}</> : t(L, 'set.integ.slack.webhook_propio_estado')}
                    </p>
                )}
                {!webhook && <p class="slk-hint">{t(L, 'set.integ.slack.elige_canal')}</p>}
                <div class="slk-actions">
                    <button class="slk-btn-solid" id="slkAdd">{webhook ? t(L, 'set.integ.slack.cambiar') : t(L, 'set.integ.slack.anadir')}</button>
                    {webhook && <button class="slk-btn-ghost" id="slkTest">{t(L, 'set.integ.enviar_prueba')}</button>}
                    {webhook && <button class="slk-btn-ghost" id="slkDisc">{t(L, 'set.integ.slack.desconectar')}</button>}
                </div>
            </div>
        )}

        <details class:list={['slk-manual', { solo: !oauth }]} open={!oauth} data-oauth={oauth ? '1' : undefined}>
            {oauth && (
                <summary>
                    <svg class="slk-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5"/></svg>
                    {t(L, 'set.integ.slack.manual_titulo')}
                </summary>
            )}
            <div class="slk-manual-body">
                <div class="s-field">
                    <label for="slkUrl">{t(L, 'set.integ.webhook_url')}</label>
                    <input class="s-input" id="slkUrl" value={oauth && canal ? '' : webhook} placeholder="https://hooks.slack.com/services/T000/B000/xxxx" autocomplete="off" spellcheck="false" />
                    <span class="s-hint slk-hint-line">{t(L, 'set.integ.webhook_hint_pre')} <b>{t(L, 'set.integ.webhook_hint_mid')}</b>{t(L, 'set.integ.webhook_hint_post')} <a href="/app/ajustes/notificaciones">{t(L, 'set.integ.notificaciones')}</a>.</span>
                </div>
                <div class="slk-actions">
                    <button class="slk-btn-solid" id="slkSave">{t(L, 'set.integ.guardar')}</button>
                    {!oauth && <button class="slk-btn-ghost" id="slkTest">{t(L, 'set.integ.enviar_prueba')}</button>}
                </div>
            </div>
        </details>
        <span class="slk-msg" id="slkMsg"
            data-i18n-url-debe-ser={t(L, 'set.integ.url_debe_ser')} data-i18n-guardado={t(L, 'set.integ.guardado')}
            data-i18n-no-guardo={t(L, 'set.integ.no_guardo')} data-i18n-mensaje-enviado={t(L, 'set.integ.mensaje_enviado')}
            data-i18n-no-envio={t(L, 'set.integ.no_envio')} data-i18n-no-conecto={t(L, 'set.integ.slack.no_conecto')}
            data-i18n-no-desconecto={t(L, 'set.integ.slack.no_desconecto')}></span>
    </div>
</div>

<style>
    .slk-flash { font-size: 0.82rem; margin: 0 0 1rem; color: var(--color-ok); }
    .slk-flash[data-bad] { color: var(--color-danger); }
    .slk-oauth { margin-bottom: 0.4rem; }
    .slk-conn { font-size: 0.9rem; margin: 0 0 0.8rem; color: var(--color-text); }
    .slk-hint { font-size: 0.85rem; margin: 0 0 0.8rem; color: var(--color-text-muted); line-height: 1.45; }
    .slk-manual { border-top: 1px solid var(--color-border); padding-top: 0.9rem; }
    .slk-manual.solo { border-top: 0; padding-top: 0; }
    .slk-manual > summary {
        list-style: none; display: inline-flex; align-items: center; gap: 6px;
        font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted);
        cursor: pointer; padding: 6px 10px 6px 6px; margin-left: -6px; border-radius: 9px;
        transition: background 0.15s ease, color 0.15s ease;
    }
    .slk-manual > summary::-webkit-details-marker { display: none; }
    .slk-manual > summary:hover { background: var(--color-bg-soft); color: var(--color-text); }
    .slk-manual > summary:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }
    .slk-chev { width: 15px; height: 15px; flex-shrink: 0; transition: transform 0.2s ease; }
    .slk-manual[open] > summary .slk-chev { transform: rotate(90deg); }
    .slk-manual-body { display: flex; flex-direction: column; gap: 1.1rem; margin-top: 0.85rem; }
    .slk-manual.solo .slk-manual-body { margin-top: 0; }
    .slk-hint-line { line-height: 1.55; }
    @media (prefers-reduced-motion: reduce) { .slk-chev, .slk-manual > summary { transition: none; } }
    .slk-msg { display: block; margin-top: 0.8rem; min-height: 1.2em; }
    .slk-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .slk-msg { font-size: 0.78rem; font-weight: 600; }
    .slk-msg:global(.ok) { color: var(--color-ok); }
    .slk-msg:global(.err) { color: var(--color-danger); }
    .slk-btn-solid { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 9px; padding: 9px 18px; cursor: pointer; }
    .slk-btn-solid:disabled, .slk-btn-ghost:disabled { opacity: 0.6; cursor: wait; }
    .slk-btn-ghost { font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 9px; padding: 9px 16px; cursor: pointer; }
    .slk-btn-solid:focus-visible, .slk-btn-ghost:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 2px; }

    @media (max-width: 560px) {
        .slk-actions { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
        .slk-msg { grid-column: 1 / -1; }
        .slk-btn-solid, .slk-btn-ghost { min-height: 46px; width: 100%; }
    }
</style>

<script>
    function initSlack() {
        const urlIn = document.getElementById('slkUrl') as HTMLInputElement | null;
        const saveBtn = document.getElementById('slkSave') as HTMLButtonElement | null;
        const testBtn = document.getElementById('slkTest') as HTMLButtonElement | null;
        const addBtn = document.getElementById('slkAdd') as HTMLButtonElement | null;
        const discBtn = document.getElementById('slkDisc') as HTMLButtonElement | null;
        const msg = document.getElementById('slkMsg');
        const status = document.querySelector<HTMLElement>('[data-integ-status]');
        if (!urlIn || !saveBtn || !msg) return;

        const flash = (text: string, ok: boolean) => { msg.textContent = text; msg.className = 'slk-msg ' + (ok ? 'ok' : 'err'); setTimeout(() => { msg.textContent = ''; msg.className = 'slk-msg'; }, 3200); };

        saveBtn.addEventListener('click', async () => {
            const url = urlIn.value.trim();
            const viaOauth = !!urlIn.closest('[data-oauth]');
            if ((viaOauth && !url) || (url && !/^https:\/\/hooks\.slack\.com\//.test(url))) { flash(msg.dataset.i18nUrlDebeSer || '', false); return; }
            saveBtn.disabled = true;
            try {
                const res = await fetch('/api/org/prefs', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slack_webhook_url: url }) });
                if (!res.ok) throw new Error();
                if (status) {
                    status.textContent = (url ? status.dataset.labelOn : status.dataset.labelOff) || '';
                    status.dataset.estado = url ? 'on' : 'off';
                }
                flash(msg.dataset.i18nGuardado || '', true);
            } catch { flash(msg.dataset.i18nNoGuardo || '', false); } finally { saveBtn.disabled = false; }
        });

        addBtn?.addEventListener('click', async () => {
            addBtn.disabled = true;
            try {
                const res = await fetch('/api/integraciones/slack/conectar', { method: 'POST' });
                const d = await res.json();
                if (!res.ok || !d.redirect) throw new Error(d.error || '');
                window.location.href = d.redirect;
            } catch (err: any) { flash(err.message || msg.dataset.i18nNoConecto || '', false); addBtn.disabled = false; }
        });

        discBtn?.addEventListener('click', async () => {
            discBtn.disabled = true;
            try {
                const res = await fetch('/api/integraciones/slack/conectar', { method: 'DELETE' });
                if (!res.ok) throw new Error();
                window.location.href = window.location.pathname;
            } catch { flash(msg.dataset.i18nNoDesconecto || '', false); discBtn.disabled = false; }
        });

        testBtn?.addEventListener('click', async () => {
            testBtn!.disabled = true;
            try {
                const res = await fetch('/api/integraciones/slack-test', { method: 'POST' });
                const d = await res.json();
                if (!res.ok) throw new Error(d.error || '');
                flash(msg.dataset.i18nMensajeEnviado || '', true);
            } catch (err: any) { flash(err.message || msg.dataset.i18nNoEnvio || '', false); } finally { testBtn!.disabled = false; }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSlack);
    else initSlack();
</script>
