    :global(.flow-product::after) { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(115deg,rgba(255,255,255,.09),transparent 18%,transparent 72%,rgba(96,196,175,.035)); pointer-events: none; content: ''; }
