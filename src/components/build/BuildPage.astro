---
import Layout from '../../layouts/Layout.astro';
import Nav from '../landing/Nav.astro';
import Footer from '../landing/Footer.astro';
import BuildWall3D from './BuildWall3D';
import '../../styles/build-edition.css';
import { getLangFromUrl } from '../../i18n/utils';
import { buildText } from '../../i18n/build';
const lang = getLangFromUrl(Astro.url);
const t = buildText(lang);

const positions = [
    { id: '01', tier: 'Presenting Partner', price: '$50,000', startingOfferCents: 5000000, size: 'principal', label: t("Presenta Cord Flow completo"), available: true },
    { id: '02', tier: 'Flow Partner', price: '$20,000', startingOfferCents: 2000000, size: 'feature', label: t("Etapa · Propuesta"), available: true },
    { id: '03', tier: 'Flow Partner', price: '$20,000', startingOfferCents: 2000000, size: 'feature', label: t("Etapa · Aprobación"), available: true },
    { id: '04', tier: 'Flow Partner', price: '$20,000', startingOfferCents: 2000000, size: 'feature', label: t("Etapa · Pago"), available: true },
    { id: '05', tier: 'Flow Partner', price: '$7,500', startingOfferCents: 750000, size: 'build', label: t("Etapa · Negocio activo"), available: true },
    { id: '06', tier: 'Founding Partner', price: '$7,500', startingOfferCents: 750000, size: 'build', label: t("Nodo fundador 01"), available: true },
    { id: '07', tier: 'Founding Partner', price: '$7,500', startingOfferCents: 750000, size: 'build', label: t("Nodo fundador 02"), available: true },
    { id: '08', tier: 'Founding Partner', price: '$7,500', startingOfferCents: 750000, size: 'build', label: t("Nodo fundador 03"), available: true },
    { id: '09', tier: 'Founding Partner', price: '$7,500', startingOfferCents: 750000, size: 'build', label: t("Nodo fundador 04"), available: true },
    { id: '10', tier: 'Founding Partner', price: '$7,500', startingOfferCents: 750000, size: 'build', label: t("Nodo fundador 05"), available: true },
] as const;
---

<Layout
    title={t("The Cord Build — Tu marca en la historia de Cord")}
    description={t("Diez marcas acompañarán el próximo sprint público de Cord. Elige una posición en Cord Flow y forma parte del camino a 100 negocios activos.")}
    image="/build-og.png"
    noindex={true}
>
    <Nav />

    <main class="build-page">
        <section class="hero" aria-labelledby="hero-title">
            <div class="hero-aurora" aria-hidden="true"></div>
            <div class="hero-inner">
                <div class="hero-top">
                    <h1 id="hero-title" class="masked-title">{t("Tu marca en la próxima etapa de Cord.")}</h1>
                    <div class="hero-copy">
                    <p>{t("Durante 30 días construiremos Cord Flow en público: una venta que pasa de propuesta a pago sin romperse. Diez marcas fundadoras acompañarán cada entrega.")}</p>
                    <div class="hero-actions">
                        <a class="primary-cta" href="#posiciones"><span>{t("Elegir una posición")}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg><i aria-hidden="true"></i></a>
                        <a class="text-link" href="#historial">{t("Ver disponibilidad")}</a>
                    </div>
                    </div>
                </div>

                <div class="founder-bento" aria-label={t("La edición fundadora de Cord")}>
                    <article class="founder-edition">
                        <div class="edition-signature"><img src="/imgs/logo-cord-white.png" alt="Cord" width="78" height="30" /><span>Build / 001</span></div>
                        <div class="edition-title"><span class="edition-ten editorial" aria-hidden="true">10</span><h2>{t("Diez marcas. El primer capítulo.")}</h2></div>
                        <div class="edition-places" aria-label={t("Diez posiciones de la edición fundadora")}>
                            {positions.map((position) => <a href="#posiciones" data-edition-position={position.id} aria-label={`${lang === 'en' ? 'Explore spot' : 'Explorar posición'} ${position.id}`}><span>{position.id}</span><i aria-hidden="true"></i></a>)}
                        </div>
                        <div class="edition-foot"><span id="hero-bid-count">{t("Consultando ofertas…")}</span><a href="#historial">{t("Historial público")} <span aria-hidden="true">↗</span></a></div>
                    </article>
                    <article class="founder-presence">
                        <div class="presence-symbol" aria-hidden="true"><svg viewBox="0 0 260 100" fill="none"><path d="M-15 36C50 70 64 10 112 42S190 73 275 28" stroke="currentColor" stroke-width="2"/><circle cx="131" cy="51" r="23" fill="#fcfcfc" stroke="currentColor" stroke-width="1.5"/><path d="M123 59l16-16m-13 0h13v13" stroke="currentColor" stroke-width="1.5"/></svg></div>
                        <h3>{t("Tu logo. Tu sitio. Tu lugar en Cord.")}</h3>
                        <p>{t("Una marca visible, un enlace directo. El cordón cambia con cada oferta confirmada.")}</p>
                    </article>
                    <article class="founder-scale">
                        <span class="scale-duration editorial" aria-hidden="true">06<span>{t("meses")}</span></span>
                        <div><h3>{t("Cord Scale incluido.")}</h3><p>{t("Seis meses para las marcas ganadoras, después de liquidar su posición.")}</p></div>
                    </article>
                </div>
                <div class="build-facts" aria-label={t("Datos del sprint")}>
                    <p><strong>{t("30 días")}</strong><span>{t("de construcción pública")}</span></p>
                    <p><strong>{t("10 lugares")}</strong><span>{t("para marcas partner")}</span></p>
                    <p><strong>{t("100 negocios")}</strong><span>{t("como meta verificable")}</span></p>
                    <p><strong id="hero-countdown">{t("7 días")}</strong><span>{t("para cerrar la subasta")}</span></p>
                </div>
            </div>
        </section>

        <section class="promise" aria-labelledby="promise-title">
            <div class="section-intro">
                <h2 id="promise-title">{t("Tu marca entra al flujo que Cord está construyendo.")}</h2>
                <p>{t("No es inventario decorativo. Cada posición queda vinculada a una etapa del producto, a entregas públicas y a un archivo permanente y verificable.")}</p>
            </div>
            <div class="promise-list">
                <article><span>01</span><div><h3>{t("Producto, no sólo presencia")}</h3><p>{t("Tu posición aparece dentro de Cord Flow, en el muro físico y en las demostraciones públicas del sprint.")}</p></div></article>
                <article><span>02</span><div><h3>{t("Distribución con contexto")}</h3><p>{t("Build updates, launch report, perfil con backlink y una pieza conjunta conectan tu marca con una entrega real.")}</p></div></article>
                <article><span>03</span><div><h3>Founding access</h3><p>{t("Cord Scale durante 6 meses, acceso anticipado, sesión privada de producto y lugar permanente en el archivo del build.")}</p></div></article>
            </div>
        </section>

        <section class="positions" id="posiciones" aria-labelledby="positions-title">
            <div class="section-intro positions-intro">
                <h2 id="positions-title">{t("Una subasta que cualquiera puede auditar.")}</h2>
                <p>{t("Elige una posición, supera la oferta vigente y deja una garantía fija reembolsable. Si otra marca te supera, el reembolso se inicia automáticamente.")}</p>
            </div>

            <div class="position-experience">
                <BuildWall3D positions={positions} lang={lang} client:only="react">
                    <div slot="fallback" class="bw3-loading"><span></span><small>{t("INICIANDO CORD FLOW")}</small></div>
                </BuildWall3D>

                <aside class="position-detail" aria-live="polite">
                    <div class="detail-status"><span id="detail-number">{t("POSICIÓN 01")}</span><span id="detail-status">{t("CONSULTANDO")}</span></div>
                    <div>
                        <p id="detail-label">{t("Presenta todo el sprint")}</p>
                        <h3 id="detail-tier">Presenting Partner</h3>
                    </div>
                    <ul id="detail-benefits">
                        <li>{t("Naming “Cord Flow presented by [tu marca]”")}</li>
                        <li>{t("Presencia principal en producto, muro físico y build updates")}</li>
                        <li>{t("Caso conjunto, perfil y lugar en el launch report")}</li>
                        <li>{t("Cord Scale durante 6 meses")}</li>
                    </ul>
                    <div class="detail-price"><small id="detail-price-label">{t("OFERTA INICIAL · MXN")}</small><strong class="editorial" id="detail-price">$50,000</strong><span id="detail-owner">{t("Sin ofertas todavía")}</span></div>
                    <button class="proposal-cta" id="proposal-cta" type="button" disabled>{t("Consultando posición…")}</button>
                    <small class="detail-note" id="payment-status">{t("Comprobando disponibilidad y oferta mínima.")}</small>
                </aside>
            </div>

            <div class="auction-ledger" id="historial">
                <div class="ledger-head">
                    <div><h3>{t("Posiciones e historial.")}</h3></div>
                    <div class="ledger-tabs" role="tablist" aria-label={t("Vista de subasta")}>
                        <button type="button" class="is-active" role="tab" aria-selected="true" data-ledger-tab="positions">{t("Posiciones")}</button>
                        <button type="button" role="tab" aria-selected="false" data-ledger-tab="history">{t("Historial")} <span id="history-count">0</span></button>
                    </div>
                </div>
                <div id="ledger-content" class="ledger-content" aria-live="polite"><p>{t("Cargando actividad verificada…")}</p></div>
            </div>
        </section>

        <section class="auction-rules" id="reglas" aria-labelledby="rules-title">
            <div class="section-intro">
                <h2 id="rules-title">{t("Gana la oferta más alta. El historial no se borra.")}</h2>
                <p>{t("Cada pago deja una entrada verificable. Una oferta en los últimos 10 minutos extiende el cierre otros 10 para evitar que alguien gane en el último segundo.")}</p>
            </div>
            <div class="rules-grid">
                <article><span>01</span><h3>{t("Oferta y garantía")}</h3><p>{t("Cada posición tiene una garantía fija y visible para todos. Sólo un webhook firmado puede convertir el pago en oferta líder.")}</p></article>
                <article><span>02</span><h3>{t("Si te superan")}</h3><p>{t("Tu marca sale de la posición y el reembolso de la garantía se solicita automáticamente. Tu participación permanece en el historial.")}</p></article>
                <article><span>03</span><h3>{t("Al cierre")}</h3><p>{t("La garantía se descuenta del total. La marca ganadora liquida el saldo antes de activar sus seis meses de Cord Scale.")}</p></article>
            </div>
        </section>

        <section class="sprint" aria-labelledby="sprint-title">
            <div class="section-intro sprint-intro">
                <h2 id="sprint-title">{t("30 días. Una meta que cualquiera puede comprobar.")}</h2>
                <p>{t("No prometemos impresiones inventadas. Publicaremos el progreso real del producto y el camino a 100 negocios activos.")}</p>
            </div>
            <div class="sprint-track">
                <article><span>{t("DÍA 01")}</span><h3>{t("Abrimos Cord Flow")}</h3><p>{t("Confirmamos partners, publicamos la meta y abrimos el tablero de progreso.")}</p></article>
                <article><span>{t("DÍA 10")}</span><h3>{t("Primer lanzamiento")}</h3><p>{t("Entregamos la primera mejora del sprint y contamos qué aprendimos construyéndola.")}</p></article>
                <article><span>{t("DÍA 20")}</span><h3>{t("El producto en uso")}</h3><p>{t("Compartimos negocios activos, propuestas enviadas y los primeros casos reales.")}</p></article>
                <article><span>{t("DÍA 30")}</span><h3>Launch report</h3><p>{t("Cerramos con resultados, contenido de partners y el reporte público del reto.")}</p></article>
            </div>
        </section>

        <div class="payment-modal" id="payment-modal" hidden>
            <button class="payment-backdrop" id="payment-backdrop" type="button" aria-label={t("Cerrar pago")}></button>
            <section class="payment-sheet" role="dialog" aria-modal="true" aria-labelledby="payment-title">
                <button class="payment-close" id="payment-close" type="button" aria-label={t("Cerrar")}>×</button>
                <div class="payment-summary">
                    <img src="/imgs/logo-cord-navy.png" alt="Cord" />
                    <div>
                        <span>{t("CORD FLOW · POSICIÓN")} <b id="payment-position">01</b></span>
                        <h2 id="payment-title">Presenting Partner</h2>
                    </div>
                    <div class="payment-total"><small>{t("GARANTÍA REEMBOLSABLE · MXN")}</small><strong class="editorial" id="payment-price">$5,000</strong><span>{t("Oferta total:")} <b id="payment-offer">$50,000</b></span></div>
                    <ul>
                        <li>{t("Tu oferta sólo entra al historial después del pago")}</li>
                        <li>{t("Cord Scale incluido durante 6 meses para ganadores")}</li>
                        <li>{t("Garantía acreditada al ganador o reembolsada si lo superan")}</li>
                    </ul>
                    <p><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> {t("El número de tu tarjeta nunca toca los servidores de Cord.")}</p>
                </div>
                <div class="payment-form">
                    <h3>{t("Presenta tu oferta")}</h3>
                    <p>{t("La garantía confirma que la oferta es real. Su monto y la oferta mínima se validan otra vez en el servidor.")}</p>
                    <p class="payment-preview-note" id="payment-preview-note" hidden>{t("Vista previa: puedes preparar tu marca, pero la subasta todavía no acepta pagos ni registra ofertas.")}</p>
                    <div class="bid-fields" id="bid-fields">
                        <label>{t("Marca")}<input id="bid-brand" name="brand" autocomplete="organization" maxlength="80" required /></label>
                        <label>{t("Correo de contacto")}<input id="bid-email" name="email" type="email" autocomplete="email" required /></label>
                        <label>{t("Sitio web")}<input id="bid-website" name="website" type="url" inputmode="url" placeholder="https://" required /></label>
                        <label>{t("Tu oferta · MXN")}<input id="bid-offer" name="offer" type="number" inputmode="numeric" min="50000" step="500" required /></label>
                        <label class="bid-logo">Logo <small>{t("PNG, JPG o WebP · máximo 256 KB")}</small>
                            <span class="bid-logo-drop">
                                <input id="bid-logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" required />
                                <img id="bid-logo-preview" alt={t("Vista previa del logo")} hidden />
                                <span id="bid-logo-label"><b aria-hidden="true">＋</b> {t("Subir logo")}</span>
                            </span>
                        </label>
                        <label class="bid-consent"><input id="bid-terms" name="terms" type="checkbox" required /><span>{t("Acepto las")} <a href="#reglas">{t("reglas de la subasta")}</a> {t("y autorizo el cobro de la garantía.")}</span></label>
                        <button class="bid-continue" id="bid-continue" type="button">{t("Continuar al pago seguro")} <span aria-hidden="true">→</span></button>
                    </div>
                    <div class="payment-loading" id="payment-loading" hidden><span></span><span></span><span></span></div>
                    <div id="payment-element"></div>
                    <p class="payment-error" id="payment-error" hidden></p>
                    <button class="payment-confirm" id="payment-confirm" type="button" hidden>{t("Pagar garantía")} <span aria-hidden="true">→</span></button>
                    <small class="payment-powered">{t("Procesamiento seguro de pagos")}</small>
                </div>
            </section>
        </div>

    </main>

    <Footer
        ctaTitle={t("Tu marca puede entrar a Cord Flow.")}
        ctaSub={t("Diez posiciones, una semana de subasta y un historial que cualquiera puede comprobar.")}
    />
</Layout>

<script>
    import { buildText } from '../../i18n/build';
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    const t = buildText(lang);
    const number = document.querySelector<HTMLElement>('#detail-number');
    const label = document.querySelector<HTMLElement>('#detail-label');
    const tier = document.querySelector<HTMLElement>('#detail-tier');
    const price = document.querySelector<HTMLElement>('#detail-price');
    const priceLabel = document.querySelector<HTMLElement>('#detail-price-label');
    const owner = document.querySelector<HTMLElement>('#detail-owner');
    const detailStatus = document.querySelector<HTMLElement>('#detail-status');
    const benefits = document.querySelector<HTMLUListElement>('#detail-benefits');
    const cta = document.querySelector<HTMLButtonElement>('#proposal-cta');
    const paymentStatus = document.querySelector<HTMLElement>('#payment-status');
    let selectedPosition = '01';
    let selectedTier = 'Presenting Partner';
    let selectedPrice = '$50,000';
    let selectedMinimumCents = 5000000;
    let selectedDepositCents = 500000;
    let auctionReady = false;
    let selectedClosed = false;
    let bidPreparing = false;
    let paymentSubmitting = false;
    let stripe: any = null;
    let elements: any = null;
    let paymentElement: any = null;
    let paymentRequestId: string | null = null;
    let paymentRequestPosition: string | null = null;
    const modal = document.querySelector<HTMLElement>('#payment-modal');
    const paymentPosition = document.querySelector<HTMLElement>('#payment-position');
    const paymentTier = document.querySelector<HTMLElement>('#payment-title');
    const paymentPrice = document.querySelector<HTMLElement>('#payment-price');
    const paymentOffer = document.querySelector<HTMLElement>('#payment-offer');
    const paymentLoading = document.querySelector<HTMLElement>('#payment-loading');
    const paymentError = document.querySelector<HTMLElement>('#payment-error');
    const paymentConfirm = document.querySelector<HTMLButtonElement>('#payment-confirm');
    const bidFields = document.querySelector<HTMLElement>('#bid-fields');
    const bidContinue = document.querySelector<HTMLButtonElement>('#bid-continue');
    const bidBrand = document.querySelector<HTMLInputElement>('#bid-brand');
    const bidEmail = document.querySelector<HTMLInputElement>('#bid-email');
    const bidWebsite = document.querySelector<HTMLInputElement>('#bid-website');
    const bidOffer = document.querySelector<HTMLInputElement>('#bid-offer');
    const bidLogo = document.querySelector<HTMLInputElement>('#bid-logo');
    const bidLogoPreview = document.querySelector<HTMLImageElement>('#bid-logo-preview');
    const bidLogoLabel = document.querySelector<HTMLElement>('#bid-logo-label');
    const bidTerms = document.querySelector<HTMLInputElement>('#bid-terms');
    const previewNote = document.querySelector<HTMLElement>('#payment-preview-note');
    let selectedLogoDataUrl = '';

    const formatMoney = (cents: number) => new Intl.NumberFormat(lang === 'en' ? 'en-US' : 'es-MX', {
        style: 'currency', currency: 'MXN', maximumFractionDigits: 0,
    }).format(cents / 100);

    const tierBenefits: Record<string, string[]> = {
        principal: [t("Naming “Cord Flow presented by [tu marca]”"), t("Presencia principal en producto, muro físico y build updates"), t("Caso conjunto, perfil y lugar en el launch report"), t("Cord Scale durante 6 meses")],
        feature: [t("Posición vinculada a una etapa real de Cord Flow"), t("Cuatro menciones durante el sprint"), t("Pieza conjunta, perfil y backlink permanente"), t("Cord Scale durante 6 meses")],
        build: [t("Nodo fundador dentro de Cord Flow"), t("Presencia en fotografías y archivo del sprint"), t("Mención en el launch report y sesión de producto"), t("Cord Scale durante 6 meses")],
    };

    type BuildPosition = { id: string; tier: string; price: string; startingOfferCents: number; size: 'principal' | 'feature' | 'build'; label: string; currentOfferCents?: number | null; nextOfferCents?: number; bidDepositCents?: number; currentBrand?: string | null; bidCount?: number; status?: string };

    window.addEventListener('build-position-select', (event) => {
            const position = (event as CustomEvent<BuildPosition>).detail;
            if (!position?.id) return;
            if (number) number.textContent = `${lang === 'en' ? 'SPOT' : 'POSICIÓN'} ${position.id}`;
            if (label) label.textContent = position.label;
            if (tier) tier.textContent = position.tier;
            const nextOffer = Number(position.nextOfferCents || position.startingOfferCents);
            const hasLeader = Number(position.currentOfferCents || 0) > 0;
            if (price) price.textContent = formatMoney(nextOffer);
            if (priceLabel) priceLabel.textContent = hasLeader ? t("SIGUIENTE OFERTA MÍNIMA · MXN") : t("OFERTA INICIAL · MXN");
            if (owner) owner.textContent = hasLeader ? `${position.currentBrand || t("Marca verificada")} ${lang === 'en' ? 'leads' : 'lidera'} · ${position.bidCount || 1} ${lang === 'en' ? 'bid' : 'oferta'}${position.bidCount === 1 ? '' : 's'}` : t("Sin ofertas todavía");
            selectedClosed = position.status !== 'open';
            if (benefits) benefits.innerHTML = tierBenefits[position.size].map((item) => `<li>${item}</li>`).join('');
            selectedPosition = position.id;
            selectedTier = position.tier;
            selectedPrice = formatMoney(nextOffer);
            selectedMinimumCents = nextOffer;
            selectedDepositCents = Number(position.bidDepositCents || (position.id === '01' ? 500000 : ['02','03','04'].includes(position.id) ? 200000 : 100000));
            if (paymentRequestPosition && paymentRequestPosition !== position.id) {
                paymentElement?.destroy();
                paymentElement = null;
                elements = null;
                paymentRequestId = null;
                paymentRequestPosition = null;
                if (bidContinue) bidContinue.disabled = false;
            }
            if (paymentStatus) paymentStatus.textContent = lang === 'en' ? `Fixed ${formatMoney(selectedDepositCents)} deposit, securely processed by Stripe.` : `Garantía fija de ${formatMoney(selectedDepositCents)} procesada de forma segura por Stripe.`;
            syncControls();
    });

    const closePayment = () => {
        if (!modal) return;
        modal.hidden = true;
        document.documentElement.style.overflow = '';
        cta?.focus();
    };
    document.querySelector('#payment-close')?.addEventListener('click', closePayment);
    document.querySelector('#payment-backdrop')?.addEventListener('click', closePayment);

    cta?.addEventListener('click', () => {
        if (!auctionReady || selectedClosed) return;
        if (paymentPosition) paymentPosition.textContent = selectedPosition;
        if (paymentTier) paymentTier.textContent = selectedTier;
        if (paymentOffer) paymentOffer.textContent = selectedPrice;
        if (paymentPrice) paymentPrice.textContent = formatMoney(selectedDepositCents);
        if (bidOffer) { bidOffer.min = String(selectedMinimumCents / 100); bidOffer.value = String(selectedMinimumCents / 100); }
        if (modal) modal.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        const resume = Boolean(paymentElement && elements && paymentRequestPosition === selectedPosition);
        if (bidFields) bidFields.hidden = resume;
        if (paymentLoading) paymentLoading.hidden = true;
        if (paymentConfirm) paymentConfirm.hidden = !resume;
        if (paymentError) paymentError.hidden = true;
        syncControls();
        (resume ? paymentConfirm : bidBrand)?.focus();
    });

    modal?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { closePayment(); return; }
        if (event.key !== 'Tab') return;
        const focusable = Array.from(modal.querySelectorAll<HTMLElement>('button:not(:disabled),a[href],input:not(:disabled),iframe,[tabindex="0"]'))
            .filter((element) => element.getClientRects().length > 0 && !element.classList.contains('payment-backdrop'));
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });
    bidTerms?.closest('label')?.querySelector('a')?.addEventListener('click', closePayment);

    bidOffer?.addEventListener('input', () => {
        const cents = Math.round(Number(bidOffer.value || 0) * 100);
        if (paymentOffer) paymentOffer.textContent = formatMoney(cents);
    });

    bidLogo?.addEventListener('change', async () => {
        selectedLogoDataUrl = '';
        bidLogo.setCustomValidity('');
        if (bidLogoPreview) { bidLogoPreview.hidden = true; bidLogoPreview.removeAttribute('src'); }
        if (bidLogoLabel) bidLogoLabel.textContent = t("Subir logo");
        const file = bidLogo.files?.[0];
        if (!file) return;
        if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type) || file.size > 256 * 1024) {
            bidLogo.setCustomValidity(t("Usa un PNG, JPG o WebP de máximo 256 KB."));
            bidLogo.reportValidity();
            bidLogo.value = '';
            return;
        }
        bidLogo.setCustomValidity('');
        selectedLogoDataUrl = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result || ''));
            reader.onerror = () => reject(new Error(t("No pudimos leer el logo.")));
            reader.readAsDataURL(file);
        }).catch(() => '');
        if (!selectedLogoDataUrl) {
            bidLogo.setCustomValidity(t("No pudimos leer este archivo."));
            bidLogo.reportValidity();
            return;
        }
        if (bidLogoPreview) { bidLogoPreview.src = selectedLogoDataUrl; bidLogoPreview.hidden = false; }
        if (bidLogoLabel) bidLogoLabel.textContent = t("Cambiar logo");
    });

    bidContinue?.addEventListener('click', async () => {
        if (!auctionReady || auctionData.paymentsEnabled !== true || selectedClosed) return;
        const fields = [bidBrand, bidEmail, bidWebsite, bidOffer, bidLogo, bidTerms].filter(Boolean) as HTMLInputElement[];
        const invalid = fields.find((field) => !field.reportValidity());
        if (invalid) return invalid.focus();
        const offerAmountCents = Math.round(Number(bidOffer?.value || 0) * 100);
        if (offerAmountCents < selectedMinimumCents) {
            bidOffer?.setCustomValidity(lang === 'en' ? `The minimum bid is ${formatMoney(selectedMinimumCents)}.` : `La oferta mínima es ${formatMoney(selectedMinimumCents)}.`);
            bidOffer?.reportValidity();
            bidOffer?.setCustomValidity('');
            return;
        }
        if (!bidBrand?.value.trim() || !bidEmail?.value.trim() || !bidWebsite?.value.trim() || !selectedLogoDataUrl) return;
        bidContinue.disabled = true;
        bidPreparing = true;
        bidContinue.textContent = t("Validando oferta…");
        if (paymentLoading) paymentLoading.hidden = false;
        if (paymentError) paymentError.hidden = true;
        try {
            const requestId = paymentRequestId || crypto.randomUUID();
            paymentRequestId = requestId;
            paymentRequestPosition = selectedPosition;
            const response = await fetch('/api/build/payment-intent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    positionId: selectedPosition,
                    requestId,
                    brandName: bidBrand.value.trim(),
                    contactEmail: bidEmail.value.trim(),
                    websiteUrl: bidWebsite.value.trim(),
                    logoDataUrl: selectedLogoDataUrl,
                    offerAmountCents,
                    acceptedTerms: Boolean(bidTerms?.checked),
                }),
            });
            const data = await response.json();
            if (!response.ok || !data.clientSecret || !data.publishableKey) {
                if (data.nextOfferCents && bidOffer) {
                    selectedMinimumCents = Number(data.nextOfferCents);
                    bidOffer.min = String(selectedMinimumCents / 100);
                    bidOffer.value = String(selectedMinimumCents / 100);
                    paymentRequestId = null;
                }
                throw new Error(lang === 'en' ? (data.nextOfferCents ? `The minimum bid has changed to ${formatMoney(Number(data.nextOfferCents))}.` : t("No pudimos iniciar la garantía.")) : data.error || t("No pudimos iniciar la garantía."));
            }
            if (!(window as any).Stripe) {
                await new Promise<void>((resolve, reject) => {
                    const script = document.createElement('script');
                    script.src = 'https://js.stripe.com/v3/';
                    script.onload = () => resolve();
                    script.onerror = () => reject(new Error(t("No pudimos cargar el formulario seguro.")));
                    document.head.appendChild(script);
                });
            }
            stripe = (window as any).Stripe(data.publishableKey, { locale: lang });
            elements = stripe.elements({
                clientSecret: data.clientSecret,
                appearance: {
                    theme: 'stripe',
                    variables: { colorPrimary: '#0a192f', colorText: '#0a192f', borderRadius: '12px', fontFamily: 'Inter, system-ui, sans-serif' },
                },
            });
            paymentElement?.destroy();
            paymentElement = elements.create('payment', { layout: 'tabs' });
            paymentElement.mount('#payment-element');
            if (paymentOffer) paymentOffer.textContent = formatMoney(Number(data.offerAmountCents));
            if (paymentPrice) paymentPrice.textContent = formatMoney(Number(data.depositAmountCents));
            if (paymentLoading) paymentLoading.hidden = true;
            if (bidFields) bidFields.hidden = true;
            if (paymentConfirm) paymentConfirm.hidden = false;
        } catch (error) {
            bidContinue.disabled = false;
            bidContinue.innerHTML = `${t('Continuar al pago seguro')} <span aria-hidden="true">→</span>`;
            const message = error instanceof Error ? error.message : t("No pudimos iniciar la garantía. Intenta de nuevo.");
            if (paymentStatus) paymentStatus.textContent = message;
            if (paymentLoading) paymentLoading.hidden = true;
            if (paymentError) { paymentError.textContent = message; paymentError.hidden = false; }
        } finally {
            bidPreparing = false;
        }
    });

    paymentConfirm?.addEventListener('click', async () => {
        if (!stripe || !elements || !auctionReady || auctionData.paymentsEnabled !== true || selectedClosed) return;
        paymentConfirm.disabled = true;
        paymentSubmitting = true;
        paymentConfirm.textContent = t("Procesando…");
        try {
            const { error } = await stripe.confirmPayment({
                elements,
                confirmParams: { return_url: `${location.origin}${lang === 'en' ? '/en/build' : '/build'}?payment=return&position=${selectedPosition}` },
            });
            if (error && paymentError) {
                paymentError.textContent = error.message || t("No pudimos confirmar el pago.");
                paymentError.hidden = false;
            }
        } catch {
            if (paymentError) {
                paymentError.textContent = t("Se interrumpió la conexión. Comprueba el estado del pago antes de reintentarlo.");
                paymentError.hidden = false;
            }
        } finally {
            paymentSubmitting = false;
            paymentConfirm.disabled = false;
            paymentConfirm.innerHTML = `${t('Pagar garantía')} <span aria-hidden="true">→</span>`;
            syncControls();
        }
    });

    type AuctionPosition = { id: string; tier: string; status: string; startingOfferCents: number; currentOfferCents: number | null; nextOfferCents: number; minIncrementCents: number; bidDepositCents: number; currentBrand: string | null; logoUrl?: string | null; websiteUrl?: string | null; bidCount: number };
    type AuctionHistory = { id: string; positionId: string; brandName: string; offerAmountCents: number; status: string; at: string; outbidAt?: string | null };
    type AuctionData = { auction?: { status: string; endsAt: string }; positions?: AuctionPosition[]; history?: AuctionHistory[]; committedAmountCents?: number; paymentsEnabled?: boolean };
    let auctionData: AuctionData = {};
    const syncControls = () => {
        const ended = auctionData.auction?.status === 'closed' || auctionData.auction?.status === 'cancelled'
            || (auctionData.paymentsEnabled === true && Date.parse(auctionData.auction?.endsAt || '') <= Date.now());
        const canPay = auctionReady && !ended && !selectedClosed && auctionData.auction?.status === 'live' && auctionData.paymentsEnabled === true;
        const preview = auctionReady && !ended && !selectedClosed && !canPay;
        if (cta) {
            cta.disabled = !auctionReady || selectedClosed || ended;
            cta.textContent = !auctionReady ? t("Consultando posición…") : ended || selectedClosed ? t("Posición no disponible") : preview ? t("Preparar mi marca →") : t("Ofertar por esta posición →");
        }
        if (detailStatus) detailStatus.textContent = !auctionReady ? t("SIN CONEXIÓN") : ended || selectedClosed ? t("CERRADA") : preview ? t("VISTA PREVIA") : t("SUBASTA ABIERTA");
        if (paymentStatus && !canPay) paymentStatus.textContent = !auctionReady
            ? t("No podemos confirmar la disponibilidad. Reintenta abajo.")
            : ended || selectedClosed ? t("Esta posición no acepta nuevas ofertas.")
            : t("Puedes preparar tu marca. Los pagos aún no están habilitados.");
        if (previewNote) previewNote.hidden = !preview;
        if (bidContinue && !bidPreparing) {
            bidContinue.disabled = !canPay;
            bidContinue.textContent = canPay ? t("Continuar al pago seguro →") : t("Pagos aún no habilitados");
        }
        if (paymentConfirm) paymentConfirm.disabled = !canPay || paymentSubmitting;
    };
    let ledgerMode: 'positions' | 'history' = 'positions';
    const ledger = document.querySelector<HTMLElement>('#ledger-content');
    const escapeHTML = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character] || character);
    const relativeTime = (iso: string) => {
        const delta = Math.max(0, Date.now() - new Date(iso).getTime());
        const minutes = Math.floor(delta / 60000);
        if (minutes < 1) return t("ahora");
        if (minutes < 60) return lang === 'en' ? `${minutes} min ago` : `hace ${minutes} min`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return lang === 'en' ? `${hours} h ago` : `hace ${hours} h`;
        return lang === 'en' ? `${Math.floor(hours / 24)} d ago` : `hace ${Math.floor(hours / 24)} d`;
    };
    const renderLedger = () => {
        if (!ledger) return;
        if (!auctionReady) {
            ledger.innerHTML = `<div class="ledger-empty"><strong>${t("No pudimos actualizar la subasta.")}</strong><p>${t("Comprueba tu conexión. No se aceptan pagos sin verificar la disponibilidad.")}</p><button type="button" data-auction-retry>${t("Volver a intentar")}</button></div>`;
            return;
        }
        if (ledgerMode === 'history') {
            const rows = auctionData.history || [];
            ledger.innerHTML = rows.length ? `<div class="ledger-table">${rows.map((item) => `
                <article class="ledger-row history-row">
                    <span class="ledger-id">${escapeHTML(item.positionId)}</span>
                    <div><strong>${escapeHTML(item.brandName)}</strong><small>${item.status === 'leading' ? t("Lidera la posición") : item.status === 'won' ? t("Oferta ganadora") : item.status === 'outbid_refunding' ? t("Oferta superada · reembolso en proceso") : t("Oferta superada · reembolso procesado")}</small></div>
                    <strong class="editorial">${formatMoney(item.offerAmountCents)} MXN</strong>
                    <time datetime="${escapeHTML(item.at)}">${relativeTime(item.at)}</time>
                </article>`).join('')}</div>` : `<div class="ledger-empty"><strong>${t("El historial empieza con la primera oferta verificada.")}</strong><p>${t("No mostramos actividad simulada.")}</p></div>`;
            return;
        }
        const rows = auctionData.positions || [];
        ledger.innerHTML = rows.length ? `<div class="ledger-table">${rows.map((item) => `
            <article class="ledger-row">
                <span class="ledger-id">${escapeHTML(item.id)}</span>
                <div><strong>${escapeHTML(item.tier)}</strong><small>${item.currentBrand ? `${lang === 'en' ? 'Leading: ' : 'Lidera '}${escapeHTML(item.currentBrand)}` : item.status === 'open' ? t("Sin ofertas todavía") : t("No disponible")}</small></div>
                <div><strong class="editorial">${formatMoney(item.currentOfferCents || item.startingOfferCents)} MXN</strong><small>${item.bidCount} ${lang === 'en' ? 'bid' : 'oferta'}${item.bidCount === 1 ? '' : 's'}</small></div>
                <button type="button" data-position="${escapeHTML(item.id)}">${auctionData.paymentsEnabled !== true ? t("Ver posición") : item.currentOfferCents ? t("Sobrepujar") : t("Ofertar")}</button>
            </article>`).join('')}</div>` : `<div class="ledger-empty"><strong>${t("No pudimos cargar las posiciones.")}</strong><p>${t("Actualiza la página para intentarlo de nuevo.")}</p></div>`;
    };

    document.querySelectorAll<HTMLButtonElement>('[data-ledger-tab]').forEach((button) => {
        button.addEventListener('click', () => {
            ledgerMode = button.dataset.ledgerTab === 'history' ? 'history' : 'positions';
            document.querySelectorAll<HTMLButtonElement>('[data-ledger-tab]').forEach((tab) => {
                const active = tab === button;
                tab.classList.toggle('is-active', active);
                tab.setAttribute('aria-selected', String(active));
            });
            renderLedger();
        });
    });
    ledger?.addEventListener('click', (event) => {
        const retry = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-auction-retry]');
        if (retry) {
            retry.disabled = true;
            retry.textContent = t("Actualizando…");
            window.dispatchEvent(new CustomEvent('build-auction-refresh'));
            return;
        }
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-position]');
        if (!button?.dataset.position) return;
        window.dispatchEvent(new CustomEvent('build-position-request', { detail: { id: button.dataset.position } }));
        document.querySelector('.position-detail')?.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'center' });
    });

    let countdownTimer = 0;
    const updateCountdown = () => {
        const output = document.querySelector<HTMLElement>('#hero-countdown');
        if (output && auctionData.paymentsEnabled !== true) { output.textContent = t("Próximamente"); return; }
        const end = auctionData.auction?.endsAt ? new Date(auctionData.auction.endsAt).getTime() : 0;
        if (!output || !end) return;
        const remaining = Math.max(0, end - Date.now());
        const days = Math.floor(remaining / 86400000);
        const hours = Math.floor((remaining % 86400000) / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        output.textContent = remaining ? `${days}d ${hours}h ${minutes}m` : t("Subasta cerrada");
    };
    window.addEventListener('build-auction-update', (event) => {
        auctionData = (event as CustomEvent<AuctionData>).detail || {};
        auctionReady = true;
        const totalBids = (auctionData.positions || []).reduce((sum, item) => sum + item.bidCount, 0);
        const heroBidCount = document.querySelector<HTMLElement>('#hero-bid-count');
        const historyCount = document.querySelector<HTMLElement>('#history-count');
        if (heroBidCount) heroBidCount.textContent = lang === 'en' ? `${totalBids} VERIFIED BID${totalBids === 1 ? '' : 'S'}` : `${totalBids} OFERTA${totalBids === 1 ? '' : 'S'} VERIFICADA${totalBids === 1 ? '' : 'S'}`;
        if (historyCount) historyCount.textContent = String((auctionData.history || []).length);
        document.querySelectorAll<HTMLAnchorElement>('[data-edition-position]').forEach((spot) => {
            const position = auctionData.positions?.find((item) => item.id === spot.dataset.editionPosition);
            spot.classList.toggle('has-brand', Boolean(position?.currentBrand));
            spot.title = position?.currentBrand || `${lang === 'en' ? 'Explore spot' : 'Explorar posición'} ${position?.id || ''}`;
        });
        syncControls();
        renderLedger(); updateCountdown();
        clearInterval(countdownTimer);
        countdownTimer = window.setInterval(updateCountdown, 30000);
    });
    window.addEventListener('build-auction-error', () => {
        auctionReady = false;
        syncControls();
        renderLedger();
    });

    window.dispatchEvent(new CustomEvent('build-auction-ready'));

    const anchorLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let scrollAnimation = 0;

    anchorLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
            const hash = link.getAttribute('href');
            if (!hash || hash === '#') return;
            const target = document.querySelector<HTMLElement>(hash);
            if (!target) return;
            event.preventDefault();
            if (link.dataset.editionPosition) window.dispatchEvent(new CustomEvent('build-position-request', { detail: { id: link.dataset.editionPosition } }));
            cancelAnimationFrame(scrollAnimation);

            const start = window.scrollY;
            const destination = Math.max(0, start + target.getBoundingClientRect().top - 92);
            if (reducedMotion.matches) {
                window.scrollTo(0, destination);
                history.replaceState(null, '', hash);
                return;
            }

            const distance = destination - start;
            const duration = Math.min(1100, Math.max(680, Math.abs(distance) * .46));
            const startedAt = performance.now();
            const step = (now: number) => {
                const progress = Math.min(1, (now - startedAt) / duration);
                const eased = progress < .5
                    ? 8 * Math.pow(progress, 4)
                    : 1 - Math.pow(-2 * progress + 2, 4) / 2;
                window.scrollTo(0, start + distance * eased);
                if (progress < 1) {
                    scrollAnimation = requestAnimationFrame(step);
                    return;
                }
                history.replaceState(null, '', hash);
                const arrival = target.querySelector<HTMLElement>('.section-intro') || target;
                arrival.animate(
                    [{ opacity: .72, transform: 'translateY(14px)' }, { opacity: 1, transform: 'translateY(0)' }],
                    { duration: 620, easing: 'cubic-bezier(.16,1,.3,1)' },
                );
            };
            scrollAnimation = requestAnimationFrame(step);
        });
    });
</script>

