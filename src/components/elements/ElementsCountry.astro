    .ecx-sl.neg b { color: #8a5a12; }
    .ecx-total { margin-top: 4px; padding-top: 8px; border-top: 1px solid #eef0f3; align-items: baseline; }
    .ecx-total span { font-size: 0.86rem; font-weight: 600; color: #0a192f; }
