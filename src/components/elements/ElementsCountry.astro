    .ecx-org-id em { font-style: normal; font-weight: 600; color: #3b4658; }
    .ecx-date { margin-left: auto; text-align: right; flex-shrink: 0; }
    .ecx-date small { display: block; font-size: 0.62rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #6b7280; }
    .ecx-date .ecx-roll { font-size: 0.8rem; font-weight: 600; color: #3b4658; font-variant-numeric: tabular-nums; }

    .ecx-th, .ecx-tr { display: grid; grid-template-columns: minmax(0, 1fr) 52px 128px; gap: 10px; align-items: center; text-align: right; }
    .ecx-th { padding: 12px 0 6px; font-size: 0.6rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #6b7280; }
