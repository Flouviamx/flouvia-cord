---
// ElementsCountry — "Se adapta al país de tu negocio." para /elements.
//
// La misma cotización embebida, vista desde cuatro cuentas de país distinto
// (reglas 21, 23, 24 y 28): divisa y formato del monto, impuesto POR LÍNEA con
// su nombre local, retención donde aplica, identificación fiscal del perfil,
// fecha en el formato del locale y los rieles de cobro que existen en ese país.
//
// Todo lo que aparece aquí sale de src/lib/countries.ts — verifícalo ahí antes
// de editar un dato:
//   · MX — IVA 16% (TAX_PRESETS.MX), RFC, Cord Payments (tarjeta + SPEI) y
//          Mercado Pago (MERCADOPAGO_COUNTRIES), CFDI 4.0 solo aquí.
//   · US — Sales tax TX 6.25% (US_STATE_TAX.TX), EIN, tarjeta.
//   · ES — IVA 21% + Retención IRPF 15% (TAX_PRESETS.ES). El IRPF es del
//          autónomo, por eso el emisor es una persona física con NIF y el
//          cliente una S.L.
//   · CO — IVA 19% + ReteFuente 2,5% (TAX_PRESETS.CO), NIT. Stripe Connect no
//          abre cuentas en Colombia (CONNECT_COUNTRIES); el riel en línea es
//          Mercado Pago, que es lo único que se ofrece.
//
// La tarjeta va en el idioma del NEGOCIO (US en inglés, MX/ES/CO en español),
// no en el del visitante; lo que rodea a la tarjeta sí usa `isEn`.
// El HTML por defecto es el estado final de México: con reduced-motion o sin
// JS se ve completo y correcto.

interface Props {
    isEn?: boolean;
}

const { isEn = false } = Astro.props;
const tx = (es: string, en: string) => (isEn ? en : es);
const uid = 'ecx' + Math.random().toString(36).slice(2, 8);

type Method = { kind: 'card' | 'bank' | 'wallet'; label: string; sub: string };
type Country = {
    id: string;
    code: string;
    tab: string;
    lang: string;
    org: string;
    ini: string;
    taxId: string;
    taxVal: string;
    folio: string;
    client: string;
    status: string;
    issuedLabel: string;
    issued: string;
    validLabel: string;
    valid: string;
    th: [string, string, string];
    items: { name: string; tax: string; unit: string; qty: string; amt: string }[];
    lines: { l: string; v: string; neg?: boolean }[];
    totalLabel: string;
    total: string;
    payLabel: string;
    methods: Method[];
    sel: number;
    detail:
        | { kind: 'card'; number: string; exp: string; cvc: string; numberPh: string; expPh: string }
        | { kind: 'bank'; rows: [string, string][]; note: string }
        | { kind: 'wallet'; note: string };
    pay: string;
    cfdi?: string;
    profile: { currency: string; tax: string; locale: string; tz: string };
};

const COUNTRIES: Country[] = [
    {
        id: 'mx', code: 'MX', tab: tx('México', 'Mexico'), lang: 'es-MX',
        org: 'Materiales del Valle', ini: 'MV', taxId: 'RFC', taxVal: 'MVA190312KT1',
        folio: 'COT-0151', client: 'Distribuidora El Zarco', status: 'Enviada',
        issuedLabel: 'Emitida', issued: '19 oct 2026', validLabel: 'Vigente hasta', valid: '2 nov 2026',
        th: ['Concepto', 'Cant.', 'Importe'],
        items: [
            { name: 'Cemento gris 50 kg', tax: 'IVA 16%', unit: '$182.00 c/u', qty: '340', amt: '$61,880.00' },
            { name: 'Varilla corrugada 3/8', tax: 'IVA 16%', unit: '$198.50 c/u', qty: '120', amt: '$23,820.00' },
        ],
        lines: [{ l: 'Subtotal', v: '$85,700.00' }, { l: 'IVA 16%', v: '$13,712.00' }],
        totalLabel: 'Total', total: 'MXN $99,412.00',
        payLabel: 'Método de pago',
        methods: [
            { kind: 'card', label: 'Tarjeta', sub: 'Crédito o débito' },
            { kind: 'bank', label: 'SPEI', sub: 'Transferencia' },
            { kind: 'wallet', label: 'Mercado Pago', sub: 'Pago externo' },
        ],
        sel: 1,
        detail: {
            kind: 'bank',
            rows: [['CLABE', '646 180 1572 0381 9264'], ['Referencia', 'COT-0151']],
            note: 'CLABE única para este cliente. El pago se concilia solo.',
        },
        pay: 'Pagar MXN $99,412.00', cfdi: 'Lista para CFDI 4.0',
        profile: { currency: 'MXN', tax: 'IVA', locale: 'es-MX', tz: 'America/Mexico_City' },
    },
    {
        id: 'us', code: 'US', tab: tx('Estados Unidos', 'United States'), lang: 'en-US',
        org: 'Lone Star Supply Co.', ini: 'LS', taxId: 'EIN', taxVal: '74-3920158',
        folio: 'Q-0211', client: 'Hill Country Builders', status: 'Sent',
        issuedLabel: 'Issued', issued: 'Oct 19, 2026', validLabel: 'Valid until', valid: 'Nov 2, 2026',
        th: ['Item', 'Qty', 'Amount'],
        items: [
            { name: 'Steel rebar #4, 20 ft', tax: 'TX 6.25%', unit: '$12.50 ea', qty: '200', amt: '$2,500.00' },
            { name: 'Ready-mix concrete, yd³', tax: 'TX 6.25%', unit: '$112.50 ea', qty: '40', amt: '$4,500.00' },
        ],
        lines: [{ l: 'Subtotal', v: '$7,000.00' }, { l: 'Sales tax TX 6.25%', v: '$437.50' }],
        totalLabel: 'Total', total: 'USD $7,437.50',
        payLabel: 'Payment method',
        methods: [{ kind: 'card', label: 'Card', sub: 'Credit or debit' }],
        sel: 0,
        detail: { kind: 'card', number: '4242 4242 4242 4242', exp: '08 / 29', cvc: '•••', numberPh: 'Card number', expPh: 'Expiration' },
        pay: 'Pay USD $7,437.50',
        profile: { currency: 'USD', tax: 'Sales tax TX', locale: 'en-US', tz: 'America/Chicago' },
    },
    {
        id: 'es', code: 'ES', tab: tx('España', 'Spain'), lang: 'es-ES',
        org: 'Lucía Ferrer Estudio', ini: 'LF', taxId: 'NIF', taxVal: '12345678Z',
        folio: 'COT-0087', client: 'Café Lumbre S.L.', status: 'Enviada',
        issuedLabel: 'Emitida', issued: '19 oct 2026', validLabel: 'Válida hasta', valid: '2 nov 2026',
        th: ['Concepto', 'Cant.', 'Importe'],
        items: [
            { name: 'Diseño de identidad', tax: 'IVA 21%', unit: '4.800,00 € ud.', qty: '1', amt: '4.800,00 €' },
            { name: 'Sesión de fotografía', tax: 'IVA 21%', unit: '800,00 € ud.', qty: '2', amt: '1.600,00 €' },
        ],
        lines: [
            { l: 'Base imponible', v: '6.400,00 €' },
            { l: 'IVA 21%', v: '1.344,00 €' },
            { l: 'Retención IRPF 15%', v: '−960,00 €', neg: true },
        ],
        totalLabel: 'Total', total: '6.784,00 €',
        payLabel: 'Método de pago',
        methods: [{ kind: 'card', label: 'Tarjeta', sub: 'Crédito o débito' }],
        sel: 0,
        detail: { kind: 'card', number: '4242 4242 4242 4242', exp: '08 / 29', cvc: '•••', numberPh: 'Número de tarjeta', expPh: 'Caducidad' },
        pay: 'Pagar 6.784,00 €',
        profile: { currency: 'EUR', tax: 'IVA · IRPF', locale: 'es-ES', tz: 'Europe/Madrid' },
    },
    {
        id: 'co', code: 'CO', tab: 'Colombia', lang: 'es-CO',
        org: 'Ferretería Andina S.A.S.', ini: 'FA', taxId: 'NIT', taxVal: '901.482.367-3',
        folio: 'COT-0342', client: 'Constructora Altos del Río', status: 'Enviada',
        issuedLabel: 'Emitida', issued: '19/10/2026', validLabel: 'Válida hasta', valid: '2/11/2026',
        th: ['Concepto', 'Cant.', 'Importe'],
        items: [
            { name: 'Cemento gris 50 kg', tax: 'IVA 19%', unit: '$ 34.500,00 c/u', qty: '200', amt: '$ 6.900.000,00' },
            { name: 'Bloque de concreto N.º 5', tax: 'IVA 19%', unit: '$ 2.800,00 c/u', qty: '1.500', amt: '$ 4.200.000,00' },
        ],
        lines: [
            { l: 'Subtotal', v: '$ 11.100.000,00' },
            { l: 'IVA 19%', v: '$ 2.109.000,00' },
            { l: 'ReteFuente 2,5%', v: '−$ 277.500,00', neg: true },
        ],
        totalLabel: 'Total', total: 'COP $ 12.931.500,00',
        payLabel: 'Método de pago',
        methods: [{ kind: 'wallet', label: 'Mercado Pago', sub: 'Pago externo' }],
        sel: 0,
        detail: { kind: 'wallet', note: 'Continúas en Mercado Pago para completar el pago y vuelves a esta cotización con el comprobante.' },
        pay: 'Pagar con Mercado Pago',
        profile: { currency: 'COP', tax: 'IVA · ReteFuente', locale: 'es-CO', tz: 'America/Bogota' },
    },
];

const ADAPTS = [
    tx('Divisa y formato de cada monto', 'Currency and amount format'),
    tx('Impuesto por línea con su nombre local', 'Per-line tax with its local name'),
    tx('Retenciones donde aplican: IRPF, ReteFuente', 'Withholdings where they apply: IRPF, ReteFuente'),
    tx('Identificación fiscal: RFC, EIN, NIF, NIT', 'Tax ID: RFC, EIN, NIF, NIT'),
    tx('Fechas en la zona horaria de tu cuenta', "Dates in your account's timezone"),
    tx('Rieles de cobro del país: tarjeta, SPEI, Mercado Pago', "The country's payment rails: card, SPEI, Mercado Pago"),
    tx('Español o inglés, según tu cuenta', 'Spanish or English, per your account'),
    tx('CFDI 4.0 al facturar en México', 'CFDI 4.0 when invoicing in Mexico'),
];
---

<section class="ecx" data-ecx>
    <div class="ecx-text">
        <h2 class="ecx-h2 masked-title">{tx('Se adapta al país de tu negocio.', "It adapts to your business's country.")}</h2>
        <p class="ecx-copy reveal">{tx('El mismo embed muestra la divisa, los impuestos, la identificación fiscal y los rieles de cobro que corresponden a tu cuenta, en cualquiera de los 12 países donde opera Cord. Tú no programas nada por país.', 'The same embed shows the currency, taxes, tax ID and payment rails that match your account, in any of the 12 countries where Cord operates. You write nothing per country.')}</p>
        <ul class="ecx-list">
            {ADAPTS.map((a) => (
                <li class="reveal">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.6" /><path d="M6.4 10.3l2.5 2.5 4.8-5.2" /></svg>
                    <span>{a}</span>
                </li>
            ))}
        </ul>
    </div>

    <div class="ecx-demo reveal-mockup">
        <div class="ecx-tabs" role="tablist" aria-label={tx('País de la cuenta', 'Account country')}>
            <span class="ecx-ind" aria-hidden="true"><span class="ecx-prog"></span></span>
            {COUNTRIES.map((c, i) => (
                <button
                    type="button"
                    role="tab"
                    id={`${uid}-tab-${c.id}`}
                    aria-controls={`${uid}-panel-${c.id}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    aria-label={c.tab}
                    class:list={['ecx-tab', { on: i === 0 }]}
                >
                    <span class="ecx-code" aria-hidden="true">{c.code}</span>
                    <span class="ecx-tab-n">{c.tab}</span>
                </button>
            ))}
        </div>

        <div class="ecx-stage">
            <div class="ecx-sheet">
                {COUNTRIES.map((c, i) => (
                    <div
                        class:list={['ecx-face', { on: i === 0 }]}
                        role="tabpanel"
                        id={`${uid}-panel-${c.id}`}
                        aria-labelledby={`${uid}-tab-${c.id}`}
                        lang={c.lang}
                        data-face
                    >
                        <div class="ecx-bar" data-r>
                            <div class="ecx-bar-l">
                                <b>{c.folio}</b>
                                <span>{c.client}</span>
                            </div>
                            <div class="ecx-bar-r">
                                <span class="ecx-pill"><i></i>{c.status}</span>
                            </div>
                        </div>

                        <div class="ecx-body">
                            <div class="ecx-org" data-r>
                                <span class="ecx-logo">{c.ini}</span>
                                <div class="ecx-org-id">
                                    <b>{c.org}</b>
                                    <small><em>{c.taxId}</em> {c.taxVal}</small>
                                </div>
                                <div class="ecx-date">
                                    <small>{c.issuedLabel}</small>
                                    <span class="ecx-roll"><span>{c.issued}</span></span>
                                </div>
                            </div>

                            <div class="ecx-th" data-r><span>{c.th[0]}</span><span>{c.th[1]}</span><span>{c.th[2]}</span></div>
                            {c.items.map((it) => (
                                <div class="ecx-tr" data-r>
                                    <div class="ecx-item">
                                        <span class="ecx-item-n">{it.name}</span>
                                        <span class="ecx-item-m"><span class="ecx-tag">{it.tax}</span><span class="ecx-item-q">× {it.qty}</span><span class="ecx-unit">{it.unit}</span></span>
                                    </div>
                                    <span class="ecx-num ecx-qty">{it.qty}</span>
                                    <b class="ecx-num ecx-roll"><span>{it.amt}</span></b>
                                </div>
                            ))}

                            <div class="ecx-sum">
                                {c.lines.map((ln) => (
                                    <div class:list={['ecx-sl', { neg: ln.neg }]} data-r>
                                        <span>{ln.l}</span>
                                        <b class="ecx-num ecx-roll"><span>{ln.v}</span></b>
                                    </div>
                                ))}
                                <div class="ecx-sl ecx-total" data-r>
                                    <span>{c.totalLabel}</span>
                                    <b class="ecx-num ecx-roll"><span>{c.total}</span></b>
                                </div>
                            </div>

                            <div class="ecx-paybox">
                                <div class="ecx-paylabel" data-r>{c.payLabel}</div>
                                <div class="ecx-methods" style={`--n:${c.methods.length}`} data-r>
                                    {c.methods.map((m, k) => (
                                        <span class:list={['ecx-m', { on: k === c.sel }]}>
                                            <span class="ecx-m-ico" aria-hidden="true">
                                                {m.kind === 'card' && (
                                                    <svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2.6" class="f" /><path d="M2.5 9.6h19M6.5 15h3.5" /></svg>
                                                )}
                                                {m.kind === 'bank' && (
                                                    <svg viewBox="0 0 24 24"><path d="M3.5 9.2L12 4.5l8.5 4.7z" class="f" /><path d="M3.5 9.2L12 4.5l8.5 4.7M5.5 10.5v6M10 10.5v6M14 10.5v6M18.5 10.5v6M3.5 19.5h17" /></svg>
                                                )}
                                                {m.kind === 'wallet' && (
                                                    <svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 016.5 5H18v3" /><rect x="4" y="7.5" width="16.5" height="12" rx="2.4" class="f" /><path d="M20.5 11.5h-3.6a1.9 1.9 0 000 3.8h3.6" /></svg>
                                                )}
                                            </span>
                                            <span class="ecx-m-t"><b>{m.label}</b><small>{m.sub}</small></span>
                                            <span class="ecx-radio" aria-hidden="true"></span>
                                        </span>
                                    ))}
                                </div>

                                {c.detail.kind === 'card' && (
                                    <div class="ecx-fields" data-r>
                                        <div class="ecx-field ecx-field-full">
                                            <small>{c.detail.numberPh}</small>
                                            <span class="ecx-num">{c.detail.number}</span>
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2.2" class="f" /><path d="M8.5 10.5V8a3.5 3.5 0 017 0v2.5" /></svg>
                                        </div>
                                        <div class="ecx-field"><small>{c.detail.expPh}</small><span class="ecx-num">{c.detail.exp}</span></div>
                                        <div class="ecx-field"><small>CVC</small><span class="ecx-num">{c.detail.cvc}</span></div>
                                    </div>
                                )}
                                {c.detail.kind === 'bank' && (
                                    <div class="ecx-bank" data-r>
                                        {c.detail.rows.map((r) => (
                                            <div class="ecx-kv"><span>{r[0]}</span><b class="ecx-num">{r[1]}</b></div>
                                        ))}
                                        <p>{c.detail.note}</p>
                                    </div>
                                )}
                                {c.detail.kind === 'wallet' && (
                                    <div class="ecx-wallet" data-r>
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 4.5h6v6" /><path d="M19.5 4.5L11 13" /><path d="M17.5 13.5v4a2 2 0 01-2 2h-9a2 2 0 01-2-2v-9a2 2 0 012-2h4" class="f" /></svg>
                                        <p>{c.detail.note}</p>
                                    </div>
                                )}

                                <span class="ecx-pay" data-r>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2.2" class="f" /><path d="M8.5 10.5V8a3.5 3.5 0 017 0v2.5" /></svg>
                                    <span class="ecx-roll"><span>{c.pay}</span></span>
                                </span>
                            </div>
                        </div>

                        <div class="ecx-foot" data-r>
                            <span>{c.validLabel} <b class="ecx-num">{c.valid}</b></span>
                            {c.cfdi && (
                                <span class="ecx-cfdi">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h7.5l4.5 4.5v12.5h-12z" class="f" /><path d="M14 3.5V8h4.5M9.2 14.2l2 2 3.8-4" /></svg>
                                    {c.cfdi}
                                </span>
                            )}
                        </div>
                    </div>
                ))}
            </div>

            <div class="ecx-profile" aria-live="polite">
                <span class="ecx-profile-k">{tx('Perfil de la cuenta', 'Account profile')}</span>
                <span class="ecx-profile-v">
                    {COUNTRIES.map((c, i) => (
                        <span class:list={['ecx-pv', { on: i === 0 }]} data-pv>
                            <span><small>{tx('Divisa', 'Currency')}</small>{c.profile.currency}</span>
                            <span><small>{tx('Impuesto', 'Tax')}</small>{c.profile.tax}</span>
                            <span><small>Locale</small>{c.profile.locale}</span>
                            <span><small>{tx('Zona', 'Timezone')}</small>{c.profile.tz}</span>
                        </span>
                    ))}
                </span>
            </div>
        </div>
    </div>
</section>

<style>
    .ecx { max-width: 1240px; margin: 0 auto; padding: 4rem 5% 6rem; display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 4.5rem; align-items: center; }
    .ecx > * { min-width: 0; }

    /* ── Texto ── */
    .ecx-h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.035em; color: #050505; margin: 0 0 1.2rem; max-width: 520px; text-wrap: balance; }
    .ecx-copy { font-size: 1.02rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; max-width: 520px; }
    .ecx-list { list-style: none; margin: 2.2rem 0 0; padding: 1.6rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem 1.6rem; border-top: 1px solid rgba(10,25,47,0.08); }
    .ecx-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.9rem; line-height: 1.45; color: var(--color-text); }
    .ecx-list svg { flex-shrink: 0; width: 18px; height: 18px; margin-top: 1px; fill: none; stroke: #0a192f; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
    .ecx-list svg circle { fill: rgba(10,25,47,0.12); stroke: rgba(10,25,47,0.35); }

    /* ── Pestañas ── */
    .ecx-demo { min-width: 0; }
    .ecx-tabs { position: relative; display: flex; flex-wrap: nowrap; width: max-content; max-width: 100%; gap: 2px; padding: 4px; margin-bottom: 1.2rem; border-radius: 999px; background: rgba(10,25,47,0.045); overflow-x: auto; scrollbar-width: none; }
    .ecx-tabs::-webkit-scrollbar { display: none; }
    .ecx-tab { position: relative; z-index: 1; flex-shrink: 0; display: inline-flex; align-items: center; gap: 8px; border: 0; cursor: pointer; padding: 7px 15px 7px 8px; white-space: nowrap; border-radius: 999px; background: transparent; font: 600 0.9rem var(--font-sans); color: #5b6575; transition: color 0.35s, background 0.3s; -webkit-tap-highlight-color: transparent; }
    .ecx-tab:hover { color: #0a192f; background: rgba(255,255,255,0.7); }
    .ecx-tab.on { background: #0a192f; color: #fff; }
    .ecx-tab:focus-visible { outline: 2px solid #2f6df0; outline-offset: 2px; }
    .ecx-code { display: inline-grid; place-items: center; min-width: 26px; height: 20px; padding: 0 5px; border-radius: 6px; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.04em; background: rgba(10,25,47,0.06); color: #3b4658; transition: background 0.35s, color 0.35s; }
    .ecx-tab.on .ecx-code { background: rgba(255,255,255,0.14); color: #fff; }
    .ecx-ind { position: absolute; left: 0; top: 0; width: 0; height: 0; border-radius: 999px; background: #0a192f; box-shadow: 0 10px 22px -12px rgba(10,25,47,0.6); opacity: 0; overflow: hidden; pointer-events: none; }
    .ecx-prog { position: absolute; left: 18px; right: 18px; bottom: 4px; height: 2px; border-radius: 2px; background: rgba(255,255,255,0.38); transform: scaleX(0); transform-origin: left center; }
    /* Con JS el indicador deslizante sustituye el fondo de la pestaña activa */
    .ecx.is-js .ecx-ind { opacity: 1; }
    .ecx.is-js .ecx-tab.on { background: transparent; }
    .ecx.is-js .ecx-tab.on:hover { background: transparent; }

    /* ── Escenario ── */
    .ecx-stage { position: relative; perspective: 1600px; }
    .ecx-stage::before { content: ''; position: absolute; inset: 8% -6% -4% 6%; z-index: 0; border-radius: 40px; background: radial-gradient(ellipse at 60% 45%, rgba(10,25,47,0.10) 0%, transparent 65%); filter: blur(24px); pointer-events: none; }
    .ecx-sheet { position: relative; z-index: 1; display: grid; border-radius: 24px; background: #fff; border: 1px solid rgba(10,25,47,0.06); box-shadow: 0 1px 2px rgba(10,25,47,0.04), 0 2px 4px rgba(10,25,47,0.04), 0 30px 64px -18px rgba(10,25,47,0.18); overflow: hidden; transform-style: preserve-3d; will-change: transform; }
    .ecx-face { grid-area: 1 / 1; display: flex; flex-direction: column; min-width: 0; visibility: hidden; opacity: 0; }
    .ecx-face.on { visibility: visible; opacity: 1; }

    .ecx-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 22px; background: #fcfdfe; border-bottom: 1px solid #eef0f3; }
