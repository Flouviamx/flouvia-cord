    .ecx-paybox { margin-top: auto; padding-top: 18px; display: flex; flex-direction: column; gap: 10px; }
    .ecx-paylabel { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #6b7280; }
    .ecx-methods { display: grid; grid-template-columns: repeat(var(--n, 1), minmax(0, 1fr)); gap: 8px; }
    .ecx-m { position: relative; display: flex; align-items: center; gap: 9px; padding: 10px 12px; border-radius: 12px; box-shadow: inset 0 0 0 1px #e5e7eb; color: #5b6575; min-width: 0; }
    .ecx-m.on { color: #0a192f; box-shadow: inset 0 0 0 1.5px #0a192f, 0 6px 14px -10px rgba(10,25,47,0.45); }
    .ecx-m-ico { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: #f5f5f7; flex-shrink: 0; }
    .ecx-m.on .ecx-m-ico { background: rgba(10,25,47,0.07); }
    .ecx-m-ico svg { width: 17px; height: 17px; }
    .ecx-m-t { min-width: 0; }
    .ecx-m-t b { display: block; font-size: 0.8rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ecx-m-t small { display: block; font-size: 0.66rem; color: #6b7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ecx-radio { margin-left: auto; width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px #cfd4dc; flex-shrink: 0; }
    .ecx-m.on .ecx-radio { box-shadow: inset 0 0 0 4.5px #0a192f; }

    .ecx svg { fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
    .ecx svg .f { fill: currentColor; fill-opacity: 0.14; }

    .ecx-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .ecx-field { position: relative; padding: 8px 12px; border-radius: 10px; background: #f5f5f7; min-width: 0; }
    .ecx-field-full { grid-column: 1 / -1; }
    .ecx-field small { display: block; font-size: 0.64rem; color: #6b7280; }
    .ecx-field span { display: block; margin-top: 1px; font-size: 0.84rem; font-weight: 500; color: #0a192f; white-space: nowrap; }
    .ecx-field svg { position: absolute; right: 12px; top: 50%; width: 16px; height: 16px; margin-top: -8px; color: #6b7280; }

    .ecx-bank { border-radius: 10px; background: #f5f5f7; padding: 4px 12px 10px; }
    .ecx-kv { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid rgba(10,25,47,0.06); font-size: 0.78rem; color: #6b7280; }
    .ecx-kv b { font-weight: 600; color: #0a192f; white-space: nowrap; }
    .ecx-bank p, .ecx-wallet p { margin: 8px 0 0; font-size: 0.72rem; line-height: 1.45; color: #5b6575; }
    .ecx-wallet { display: flex; gap: 10px; align-items: flex-start; border-radius: 10px; background: #f5f5f7; padding: 11px 12px; }
    .ecx-wallet svg { width: 17px; height: 17px; color: #3b4658; flex-shrink: 0; margin-top: 1px; }
    .ecx-wallet p { margin: 0; }

    .ecx-pay { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 0; border-radius: 12px; background: #0d1b33; color: #fff; font-size: 0.88rem; font-weight: 600; box-shadow: 0 1px 2px rgba(10,25,47,0.2), 0 10px 22px -12px rgba(10,25,47,0.6); }
    .ecx-pay svg { width: 15px; height: 15px; opacity: 0.85; }

    .ecx-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 12px 22px; border-top: 1px solid #eef0f3; background: #fcfdfe; font-size: 0.74rem; color: #6b7280; min-height: 46px; }
    .ecx-foot b { font-weight: 600; color: #3b4658; }
    .ecx-cfdi { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 7px; border-radius: 999px; background: rgba(16,185,129,0.12); color: #047857; font-size: 0.72rem; font-weight: 600; }
    .ecx-cfdi svg { width: 14px; height: 14px; }

    /* Rodillo para números y textos que cambian */
    .ecx-roll { display: inline-flex; overflow: hidden; vertical-align: bottom; padding-bottom: 1px; }
    .ecx-roll > span { display: block; white-space: nowrap; }

    /* ── Perfil de la cuenta (debajo de la hoja) ── */
    .ecx-profile { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; margin-top: 16px; padding: 0 6px; font-size: 0.74rem; color: #6b7280; min-width: 0; }
    .ecx-profile-k { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #6b7280; white-space: nowrap; }
    .ecx-profile-v { display: grid; min-width: 0; }
    .ecx-pv { grid-area: 1 / 1; display: flex; flex-wrap: wrap; gap: 4px 16px; visibility: hidden; opacity: 0; }
    .ecx-pv.on { visibility: visible; opacity: 1; }
    .ecx-pv > span { color: #3b4658; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ecx-pv small { font-size: inherit; font-weight: 400; color: #6b7280; margin-right: 5px; }

    @media (max-width: 1080px) {
        .ecx { grid-template-columns: 1fr; gap: 2.8rem; }
        .ecx-text { max-width: 640px; }
        .ecx-demo { max-width: 640px; width: 100%; justify-self: center; }
    }
    @media (max-width: 560px) {
        .ecx { padding: 3rem 5% 4.5rem; }
        .ecx-list { grid-template-columns: 1fr; }
        .ecx-tab { padding: 7px 12px 7px 7px; font-size: 0.84rem; }
        .ecx-bar { padding: 12px 16px; }
        .ecx-bar-l span { display: none; }
        .ecx-body { padding: 16px 16px; }
        .ecx-foot { padding: 11px 16px; }
        .ecx-th, .ecx-tr { grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
        .ecx-th span:nth-child(2), .ecx-qty { display: none; }
        .ecx-item-q { display: inline; }
        .ecx-unit { display: none; }
        .ecx-tr { font-size: 0.8rem; }
        .ecx-sum { grid-template-columns: auto minmax(108px, auto); column-gap: 14px; }
        .ecx-sl { font-size: 0.78rem; }
        .ecx-tab:not(.on) .ecx-tab-n { display: none; }
        .ecx-tab:not(.on) { padding-right: 8px; }
        .ecx-total b { font-size: 1rem; }
        .ecx-m-t small { display: none; }
        .ecx-m { padding: 9px 10px; gap: 7px; }
        .ecx-profile { flex-direction: column; align-items: flex-start; gap: 6px; }
        .ecx-date small { display: none; }
    }
    @media (max-width: 400px) {
        .ecx-m-ico, .ecx-radio { display: none; }
        .ecx-m { justify-content: center; text-align: center; }
        .ecx-org-id small { white-space: normal; }
    }
</style>

<script>
    import { gsap } from 'gsap';

    const DWELL = 4.2; // segundos por país en la rotación automática

    document.querySelectorAll<HTMLElement>('[data-ecx]').forEach((root) => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const tablist = root.querySelector<HTMLElement>('[role="tablist"]');
        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        const faces = Array.from(root.querySelectorAll<HTMLElement>('[data-face]'));
        const pvs = Array.from(root.querySelectorAll<HTMLElement>('[data-pv]'));
        const ind = root.querySelector<HTMLElement>('.ecx-ind');
        const prog = root.querySelector<HTMLElement>('.ecx-prog');
        const sheet = root.querySelector<HTMLElement>('.ecx-sheet');
        if (!tablist || !tabs.length || faces.length !== tabs.length || !ind || !prog || !sheet) return;

        let cur = 0;
        let auto = !reduced;
        let onScreen = false;
        let timer: gsap.core.Tween | null = null;

        root.classList.add('is-js');

        const place = (k: number, animate: boolean) => {
            const t = tabs[k];
            const props = { x: t.offsetLeft, y: t.offsetTop, width: t.offsetWidth, height: t.offsetHeight };
            if (animate && !reduced) gsap.to(ind, { ...props, duration: 0.55, ease: 'power3.inOut', overwrite: true });
            else gsap.set(ind, props);
        };
        place(0, false);
        if (document.fonts?.ready) document.fonts.ready.then(() => place(cur, false));
        let rz = 0;
        window.addEventListener('resize', () => {
            cancelAnimationFrame(rz);
            rz = requestAnimationFrame(() => place(cur, false));
        });

        const show = (k: number) => {
            if (k === cur) return;
            const from = faces[cur];
            const to = faces[k];
            const dir = k > cur ? 1 : -1;

            tabs.forEach((t, j) => {
                const on = j === k;
                t.classList.toggle('on', on);
                t.setAttribute('aria-selected', String(on));
                t.tabIndex = on ? 0 : -1;
            });
            place(k, true);

            if (reduced) {
                faces.forEach((f, j) => f.classList.toggle('on', j === k));
                pvs.forEach((p, j) => p.classList.toggle('on', j === k));
                cur = k;
                return;
            }

            gsap.killTweensOf([...faces, ...pvs, sheet]);
            faces.forEach((f) => gsap.killTweensOf(f.querySelectorAll('[data-r], .ecx-roll > span')));
            faces.forEach((f, j) => {
                if (j !== cur && j !== k) { f.classList.remove('on'); gsap.set(f, { clearProps: 'opacity,visibility' }); }
            });

            // Sale: las filas suben y se desvanecen en cascada
            gsap.to(from.querySelectorAll('[data-r]'), { opacity: 0, y: -8, duration: 0.22, stagger: 0.012, ease: 'power2.in' });
            gsap.to(from, {
                autoAlpha: 0, duration: 0.3, delay: 0.12,
                onComplete: () => {
                    from.classList.remove('on');
                    gsap.set(from, { clearProps: 'opacity,visibility' });
                    gsap.set(from.querySelectorAll('[data-r]'), { clearProps: 'opacity,transform' });
                },
            });

            // Entra: filas en cascada y los montos ruedan desde abajo
            to.classList.add('on');
            gsap.fromTo(to, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.3, delay: 0.16 });
            gsap.fromTo(to.querySelectorAll('[data-r]'), { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.035, delay: 0.2, ease: 'power3.out' });
            gsap.fromTo(to.querySelectorAll('.ecx-roll > span'), { yPercent: 105 }, { yPercent: 0, duration: 0.6, stagger: 0.03, delay: 0.3, ease: 'power3.out' });

            // Inclinación sutil de la hoja, como si se girara hacia el siguiente país
            gsap.timeline()
                .to(sheet, { rotationY: -3.5 * dir, rotationX: 1.6, y: -4, transformPerspective: 1600, duration: 0.32, ease: 'power2.out' })
                .to(sheet, { rotationY: 0, rotationX: 0, y: 0, duration: 0.8, ease: 'power3.out' });

            // Perfil de la cuenta
            const pFrom = pvs[cur];
            const pTo = pvs[k];
            if (pFrom && pTo) {
                gsap.to(pFrom, { autoAlpha: 0, y: -6, duration: 0.25, onComplete: () => { pFrom.classList.remove('on'); gsap.set(pFrom, { clearProps: 'all' }); } });
                pTo.classList.add('on');
                gsap.fromTo(pTo, { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, duration: 0.45, delay: 0.2, ease: 'power3.out' });
            }

            cur = k;
        };

        // ── Rotación automática con barra de progreso en la pestaña activa ──
        const schedule = () => {
            timer?.kill();
            if (!auto) return;
            timer = gsap.fromTo(prog, { scaleX: 0 }, {
                scaleX: 1, duration: DWELL, ease: 'none', paused: !onScreen || document.hidden,
                onComplete: () => { show((cur + 1) % tabs.length); schedule(); },
            });
        };
        const stopAuto = () => {
            auto = false;
            timer?.kill();
            timer = null;
            gsap.to(prog, { scaleX: 0, opacity: 0, duration: 0.25 });
        };
        const sync = () => {
            if (!timer) return;
            if (onScreen && !document.hidden) timer.resume();
            else timer.pause();
        };

        tabs.forEach((t, k) => {
            t.addEventListener('click', () => { stopAuto(); show(k); });
        });
        tablist.addEventListener('keydown', (e) => {
            const keys: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
            let k = -1;
            if (e.key in keys) k = (cur + keys[e.key] + tabs.length) % tabs.length;
            else if (e.key === 'Home') k = 0;
            else if (e.key === 'End') k = tabs.length - 1;
            if (k < 0) return;
            e.preventDefault();
            stopAuto();
            show(k);
            tabs[k].focus();
        });

        if (auto) {
            const io = new IntersectionObserver((entries) => {
                onScreen = entries.some((en) => en.isIntersecting);
                sync();
            }, { threshold: 0.25 });
            io.observe(root);
            document.addEventListener('visibilitychange', sync);
            schedule();
        } else {
            prog.style.display = 'none';
        }
    });
</script>
