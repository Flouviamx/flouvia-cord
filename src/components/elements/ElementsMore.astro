---
// "Conoce más de Elements." — carrusel de tarjetas grandes (patrón del
// carrusel homónimo de stripe.com/payments/elements). Cada tarjeta es una
// calca de una pantalla real hecha CON el SDK 2.0, y cada nombre que aparece
// existe en packages/ (verifícalo ahí antes de editar):
//   CordBuilder + AiDrop/aiSuggested (react.tsx, context.ts), <cord-invoice> y su
//   evento paid (element.ts, src/pages/embed/i/[token].astro), <cord-fiscal-form>
//   (fiscal-element.ts, fiscal/sat.ts, fiscal/messages.ts), Cord.webhooks.
//   constructEvent (packages/node) y cord listen (packages/cli), la barra de
//   depuración (debug.ts), FramerCordCotizador (framer.tsx), data-cord-token
//   (loader.ts), useCordCatalog, CordError y sus códigos (api.ts), <cord-quote>
//   y el evento approved con signed_by (types.ts).
// El HTML es el ESTADO FINAL (o el estado completo) de cada micro-historia: con
// reduced-motion o sin JS se ve correcto. GSAP solo anima encima y pausa fuera de vista.
interface Props {
    /** Copy en inglés. Por defecto, español. */
    isEn?: boolean;
    /** id opcional de la sección (ancla). */
    id?: string;
}

const { isEn = false, id } = Astro.props;
const uid = id ? `${id}-emo` : "emo";
const tx = (es: string, en: string) => (isEn ? en : es);
const money = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// ── 1. CordBuilder: estado final (cemento en 360) ──
const B_ROWS = [
    { k: 'qty', n: tx('Cemento gris 50 kg', 'Gray cement 50 kg'), sku: 'CEM-50', p: 182, q: 360, ai: false },
    { k: '', n: tx('Varilla corrugada 3/8"', 'Rebar 3/8"'), sku: 'VAR-38', p: 198.5, q: 120, ai: true },
    { k: '', n: tx('Block hueco 15x20x40', 'Hollow block 15x20x40'), sku: 'BLK-15', p: 14.2, q: 600, ai: true },
];
const bSub = B_ROWS.reduce((s, r) => s + r.p * r.q, 0);
const bIva = Math.round(bSub * 0.16 * 100) / 100;
const bTot = bSub + bIva;
// El resto del subtotal (todo menos la partida que se anima), para el script.
const bRest = B_ROWS.slice(1).reduce((s, r) => s + r.p * r.q, 0);

// ── 2. Webhooks: entregas ──
const HOOKS = [
    { t: '10:42:07', s: 200, e: 'quote.viewed', id: 'evt_9fK2mQ', ms: '38 ms' },
    { t: '10:44:51', s: 200, e: 'quote.approved', id: 'evt_9fK7xR', ms: '41 ms' },
    { t: '10:45:03', s: 200, e: 'payment.partial', id: 'evt_9fL1cW', ms: '44 ms' },
    { t: '10:47:30', s: 400, e: 'quote.approved', id: 'timestamp_out_of_tolerance', ms: '3 ms' },
    { t: '10:51:18', s: 200, e: 'quote.paid', id: 'evt_9fM4dT', ms: '36 ms' },
];
const HOOK_CODE = [
    `<i class="k">import</i> { Cord } <i class="k">from</i> <i class="s">'@flouviahq/node'</i>;`,
    ``,
    `<i class="k">const</i> cord = <i class="k">new</i> <i class="f">Cord</i>(process.env.CORD_SECRET_KEY!);`,
    `<i class="k">const</i> secret = process.env.CORD_WEBHOOK_SECRET!;`,
    ``,
    `<i class="k">export async function</i> <i class="f">POST</i>(req: Request) {`,
    `  <i class="k">const</i> body = <i class="k">await</i> req.<i class="f">text</i>();`,
    `  <i class="k">const</i> event = <i class="k">await</i> cord.webhooks.<i class="f">constructEvent</i>(body, req.headers, secret);`,
    `  <i class="c">${tx('// firma V1 + timestamp: si no cuadra, lanza', '// V1 signature + timestamp: throws if it does not match')}</i>`,
];

// ── 4. Catálogo ──
const PRODUCTS = [
    { n: tx('Cemento gris 50 kg', 'Gray cement 50 kg'), sku: 'CEM-50', p: 182, u: tx('bulto', 'bag'), ic: 'bag' },
    { n: tx('Varilla corrugada 3/8"', 'Rebar 3/8"'), sku: 'VAR-38', p: 198.5, u: tx('pieza', 'piece'), ic: 'rod' },
    { n: tx('Block hueco 15x20x40', 'Hollow block 15x20x40'), sku: 'BLK-15', p: 14.2, u: tx('pieza', 'piece'), ic: 'block' },
    { n: tx('Malla electrosoldada 6x6', 'Welded wire mesh 6x6'), sku: 'MAL-66', p: 312, u: tx('rollo', 'roll'), ic: 'mesh' },
    { n: tx('Mortero 50 kg', 'Mortar 50 kg'), sku: 'MOR-50', p: 139, u: tx('bulto', 'bag'), ic: 'bag' },
    { n: tx('Arena de río', 'River sand'), sku: 'ARE-M3', p: 410, u: 'm³', ic: 'sand' },
];

// ── 5. CordError: el caso activo por defecto es rate_limited ──
const ERR_CASES = [
    { c: 'origin_allowlist_required', h: tx('avisarSoporte(err)', 'notifySupport(err)'), st: 403, m: tx('Falta autorizar este dominio en Cord.', 'This domain is not allowed in Cord yet.'), r: 'req_4Hn8sQ2v' },
    { c: 'unauthorized_origin', h: tx('avisarSoporte(err)', 'notifySupport(err)'), st: 403, m: tx('Este sitio todavía no está autorizado para cotizar.', 'This site is not authorized to quote yet.'), r: 'req_7Lp2xR9c' },
    { c: 'rate_limited', h: tx('reintentarEn(5)', 'retryIn(5)'), st: 429, m: tx('Demasiadas solicitudes. Reintentamos en 5 s.', 'Too many requests. Retrying in 5 s.'), r: 'req_9xK2mP4t' },
    { c: 'clients_require_proxy', h: tx('usarProxy()', 'useProxy()'), st: 403, m: tx('Tus clientes se cargan desde tu servidor.', 'Your clients load from your server.'), r: 'req_2Wd6tY8b' },
];
const ERR_ON = 2;

// ── Tarjetas ──
const CARDS = [
    {
        id: 'builder',
        t: tx('Cotizaciones desde tu propio sitio', 'Quotes from your own site'),
        d: tx('<CordBuilder> trae el formulario completo dentro de tu portal. Las divisas y el impuesto de cada línea salen de tu cuenta, y la IA llena las partidas desde un pedido escrito o una foto. onQuoteCreated te entrega el folio y el link.', '<CordBuilder> ships the full form inside your portal. Currencies and the tax of each line come from your account, and AI fills the line items from a written order or a photo. onQuoteCreated hands you the folio and the link.'),
    },
    {
        id: 'invoice',
        t: tx('La factura, también embebida', 'The invoice, embedded too'),
        d: tx('<cord-invoice> muestra el saldo, el estado, las partidas y el PDF. El pago se abre en una ventana de Cord, nunca dentro del iframe, y tu página recibe paid cuando el saldo llega a cero.', '<cord-invoice> shows the balance, status, line items and PDF. Payment opens in a Cord window, never inside the iframe, and your page receives paid when the balance reaches zero.'),
    },
    {
        id: 'fiscal',
        t: tx('Datos fiscales que sí se pueden timbrar', 'Tax details that will actually stamp'),
        d: tx('<cord-fiscal-form> valida el RFC con su dígito verificador y filtra régimen y uso de CFDI según el tipo de persona. Es un campo nativo de tu <form>: bloquea el envío mientras haya errores. También NIF, NIE o CIF en España y EIN en Estados Unidos.', '<cord-fiscal-form> checks the RFC against its SAT check digit and filters tax regime and CFDI use by taxpayer type. It is a native field of your <form>: it blocks submission while there are errors. Also NIF, NIE or CIF in Spain and EIN in the United States.'),
    },
    {
        id: 'webhooks',
        t: tx('Webhooks verificados en tu backend', 'Verified webhooks on your backend'),
        d: tx('@flouviahq/node valida la firma X-Cord-Signature-V1 y su timestamp antes de que proceses nada, así que un reenvío viejo se rechaza. En local, cord listen reenvía cada evento a tu servidor y cord trigger los dispara a pedido.', '@flouviahq/node checks the X-Cord-Signature-V1 signature and its timestamp before you process anything, so a stale replay is refused. Locally, cord listen forwards every event to your server and cord trigger fires them on demand.'),
    },
    {
        id: 'framer',
        t: tx('Framer y Webflow, sin código', 'Framer and Webflow, no code'),
        d: tx('En Framer es un Code Component: pegas el token en el panel de propiedades. En Webflow basta el atributo data-cord-token en cualquier Div Block.', 'In Framer it is a Code Component: paste the token in the properties panel. In Webflow, the data-cord-token attribute on any Div Block is enough.'),
    },
    {
        id: 'debug',
        t: tx('Depura sin abrir la consola', 'Debug without opening the console'),
        d: tx('Con debug y una llave pk_test_, una barra en tu página muestra cada evento del iframe, cada petición con su request id y los avisos de configuración. Con una llave en vivo no se dibuja.', 'With debug and a pk_test_ key, a bar on your page shows every iframe event, every request with its request id and configuration warnings. With a live key it never renders.'),
    },
    {
        id: 'catalog',
        t: tx('Tu catálogo, sin exponer márgenes', 'Your catalog, without exposing margins'),
        d: tx('useCordCatalog() trae tus productos para la tienda que tú diseñas. Con una llave pública, el servidor oculta el costo y el margen de cada uno.', 'useCordCatalog() loads your products into the storefront you design. With a publishable key, the server hides the cost and margin of each one.'),
    },
    {
        id: 'errors',
        t: tx('Errores que puedes programar', 'Errors you can program against'),
        d: tx('Todo falla como CordError con status, un código estable y el request id para soporte. Tu interfaz responde con un mensaje propio, sin depender de leer el texto del error.', 'Everything fails as a CordError with a status, a stable code and the request id for support. Your interface answers with its own message, never by parsing error text.'),
    },
    {
        id: 'phone',
        t: tx('Cualquier stack, cualquier pantalla', 'Any stack, any screen'),
        d: tx('<cord-quote> es un Web Component en Shadow DOM: HTML, PHP, Laravel o Rails, y tus estilos no lo rompen. En el teléfono de tu cliente aprueba y firma, y tu página recibe approved con quién firmó.', '<cord-quote> is a Web Component in Shadow DOM: HTML, PHP, Laravel or Rails, and your styles cannot break it. On your client\'s phone it approves and signs, and your page receives approved with who signed.'),
    },
];

// ── Factura embebida: mismos rótulos que src/pages/embed/i/[token].astro ──
const INV_LINES = [
    { n: tx('Cemento gris 50 kg', 'Gray cement 50 kg'), q: '480', t: 87360 },
    { n: tx('Varilla corrugada 3/8"', 'Rebar 3/8"'), q: '220', t: 43670 },
    { n: tx('Block hueco 15x20x40', 'Hollow block 15x20x40'), q: '2,400', t: 34080 },
];
const invSub = INV_LINES.reduce((a, l) => a + l.t, 0);
const invTax = Math.round(invSub * 0.16 * 100) / 100;
const invTot = invSub + invTax;
const invPaid = Math.round(invTot * 50) / 100;
const invDue = Math.round((invTot - invPaid) * 100) / 100;

// ── Formulario fiscal: regímenes de persona moral (regimenesPara('moral')) ──
const REG_MORAL = [
    { c: '601', n: 'General de Ley Personas Morales' },
    { c: '603', n: 'Personas Morales con Fines no Lucrativos' },
    { c: '620', n: 'Sociedades Cooperativas de Producción' },
    { c: '626', n: 'Régimen Simplificado de Confianza (RESICO)' },
];

const fav = (d: string) => `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${d}&size=128`;
---

<section class="emo" data-emo data-rest={bRest} data-sent={tx('Enviada', 'Sent')} data-choose={tx('Elige…', 'Choose…')} id={id} aria-labelledby={`${uid}-title`}>
    <div class="emo-head">
        <h2 class="emo-h2 masked-title" id={`${uid}-title`}>{tx('Conoce más de Elements.', 'More from Elements.')}</h2>
        <div class="emo-nav">
            <button type="button" class="emo-arrow" data-emo-dir="-1" aria-label={tx('Anterior', 'Previous')} aria-controls={`${uid}-track`} disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="11 6 5 12 11 18"/></svg>
            </button>
            <button type="button" class="emo-arrow" data-emo-dir="1" aria-label={tx('Siguiente', 'Next')} aria-controls={`${uid}-track`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
            </button>
        </div>
    </div>

    <ul class="emo-track" id={`${uid}-track`} data-emo-track tabindex="0" aria-label={tx('Más de Elements, desplázate horizontalmente', 'More from Elements, scroll horizontally')}>
        {CARDS.map((c) => (
            <li class="emo-card" data-emo-card={c.id}>
                <div class={`emo-vis emo-v-${c.id}`} aria-hidden="true">
                    <div class="emo-stage">

                        {c.id === 'builder' && (
                            <>
                                <div class="bd-win">
                                    <div class="bd-nav">
                                        <span class="bd-logo">MV</span>
                                        <b>Materiales del Valle</b>
                                        <span class="bd-links"><span>{tx('Pedidos', 'Orders')}</span><span class="on">{tx('Cotizaciones', 'Quotes')}</span></span>
                                        <span class="bd-av">LG</span>
                                    </div>
                                    <div class="bd-body">
                                        <div class="bd-head">
                                            <h4>{tx('Nueva cotización', 'New quote')}</h4>
                                            <span class="bd-cur">MXN<svg viewBox="0 0 24 24"><polyline points="7 10 12 15 17 10"/></svg></span>
                                        </div>
                                        <div class="bd-field">
                                            <span class="bd-lbl">{tx('Cliente', 'Client')}</span>
                                            <div class="bd-sel">
                                                <i class="bd-ini">DZ</i>
                                                <span><b>Distribuidora El Zarco</b><small>Raúl Mendoza</small></span>
                                                <svg viewBox="0 0 24 24"><polyline points="7 10 12 15 17 10"/></svg>
                                            </div>
                                        </div>
                                        <div class="bd-ai">
                                            <svg viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2.5"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9.5 3.5V6M14.5 3.5V6M9.5 18v2.5M14.5 18v2.5M3.5 9.5H6M3.5 14.5H6M18 9.5h2.5M18 14.5h2.5"/></svg>
                                            <span>{tx('2 partidas agregadas. Revísalas antes de crear la cotización.', '2 lines added. Review them before creating the quote.')}</span>
                                        </div>
                                        <div class="bd-th"><span>{tx('Partidas', 'Line items')}</span><span>{tx('Cant.', 'Qty.')}</span><span>{tx('Importe', 'Amount')}</span></div>
                                        {B_ROWS.map((r) => (
                                            <div class="bd-row">
                                                <span class="bd-pn"><span class="bd-pnn">{r.n}</span><small>{r.ai && <em class="bd-sug">{tx('Sugerida', 'Suggested')}</em>}{r.sku} · {money(r.p)} · IVA 16%</small></span>
                                                <span class="bd-step">
                                                    <i>−</i>
                                                    <b class="emo-num" data-k={r.k === 'qty' ? 'qty' : undefined}>{r.q.toLocaleString('en-US')}</b>
                                                    <i data-k={r.k === 'qty' ? 'plus' : undefined}>+</i>
                                                </span>
                                                <b class="emo-num" data-k={r.k === 'qty' ? 'amt' : undefined}>{money(r.p * r.q)}</b>
                                            </div>
                                        ))}
                                        <div class="bd-sum">
                                            <p><span>Subtotal</span><b class="emo-num" data-k="sub">{money(bSub)}</b></p>
                                            <p><span>IVA 16%</span><b class="emo-num" data-k="iva">{money(bIva)}</b></p>
                                            <p class="bd-tot"><span>Total <em>MXN</em></span><b class="emo-num" data-k="tot">{money(bTot)}</b></p>
                                        </div>
                                        <div class="bd-act">
                                            <span class="bd-ghost">{tx('Agregar partida', 'Add item')}</span>
                                            <span class="bd-btn" data-k="btn">{tx('Crear cotización', 'Create quote')}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="bd-toast" data-k="toast">
                                    <span class="bd-ok"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 12.4l2.7 2.7L16.2 9.5"/></svg></span>
                                    <span class="bd-tt"><b>{tx('COT-0053 creada · link listo', 'COT-0053 created · link ready')}</b><small>cordhq.app/q/r8Vn3kTz</small></span>
                                    <span class="bd-copy"><svg viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>{tx('Copiar', 'Copy')}</span>
                                </div>
                            </>
                        )}

                        {c.id === 'invoice' && (
                            <>
                                <div class="iv-win">
                                    <div class="bd-nav">
                                        <span class="bd-logo">MV</span>
                                        <b>Materiales del Valle</b>
                                        <span class="bd-links"><span>{tx('Pedidos', 'Orders')}</span><span class="on">{tx('Facturas', 'Invoices')}</span></span>
                                        <span class="bd-av iv-av">RM</span>
                                    </div>
                                    <div class="iv-body" data-k="inv">
                                        <div class="iv-head">
                                            <span class="iv-brand"><b>Materiales del Valle</b><small>RFC MVA190312KT1</small></span>
                                            <span class="iv-folio"><small>{tx('Factura', 'Invoice')}</small><b>FAC-0412</b></span>
                                        </div>
                                        <div class="iv-hero">
                                            <span class="iv-lbl">{tx('Saldo pendiente', 'Balance due')}</span>
                                            <b class="iv-amt emo-num" data-k="due">{money(invDue)}</b>
                                            <span class="iv-meta">
                                                <em class="iv-chip" data-k="chip" data-paid={tx('Pagada', 'Paid')}>{tx('Pendiente de pago', 'Payment due')}</em>
                                                <span>{tx('Emitida 2 oct 2026', 'Issued Oct 2, 2026')}</span>
                                                <span>{tx('Vence el 1 nov 2026', 'Due Nov 1, 2026')}</span>
                                            </span>
                                        </div>
                                        <div class="iv-th"><span>{tx('Concepto', 'Item')}</span><span>{tx('Cant.', 'Qty')}</span><span>{tx('Importe', 'Amount')}</span></div>
                                        {INV_LINES.map((l) => (
                                            <div class="iv-tr"><span>{l.n}</span><span class="emo-num">{l.q}</span><b class="emo-num">{money(l.t)}</b></div>
                                        ))}
                                        <dl class="iv-tot">
                                            <div><dt>Subtotal</dt><dd class="emo-num">{money(invSub)}</dd></div>
                                            <div><dt>{tx('Impuestos', 'Taxes')}</dt><dd class="emo-num">{money(invTax)}</dd></div>
                                            <div class="st"><dt>Total</dt><dd class="emo-num">{money(invTot)}</dd></div>
                                            <div><dt>{tx('Pagado', 'Paid')}</dt><dd class="emo-num" data-k="paid" data-full={'−' + money(invTot)}>−{money(invPaid)}</dd></div>
                                            <div class="st"><dt>{tx('Saldo', 'Balance')}</dt><dd class="emo-num" data-k="bal">{money(invDue)}</dd></div>
                                        </dl>
                                        <div class="iv-pay" data-k="pay">
                                            <span class="iv-btn">
                                                {tx('Pagar', 'Pay')} {money(invDue)}
                                                <svg viewBox="0 0 24 24"><path d="M14 4.5h5.5V10" /><path d="M19.5 4.5 11 13" /><path d="M17.5 13.5v4a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2h4" /></svg>
                                            </span>
                                            <small>{tx('El pago se abre en una ventana segura de Cord.', 'Payment opens in a secure Cord window.')}</small>
                                        </div>
                                        <div class="iv-links"><span>{tx('Descargar PDF', 'Download PDF')}</span><span>{tx('Ver factura completa', 'View full invoice')}</span></div>
                                    </div>
                                </div>
                                <div class="bd-toast iv-toast" data-k="toast">
                                    <span class="bd-ok"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 12.4l2.7 2.7L16.2 9.5"/></svg></span>
                                    <span class="bd-tt"><b><i class="iv-evn">paid</i> FAC-0412 · {tx('saldo', 'balance')} $0.00</b><small>invoice.addEventListener('paid', …)</small></span>
                                </div>
                            </>
                        )}

                        {c.id === 'fiscal' && (
                            <>
                                <div class="fx-win">
                                    <div class="bd-nav">
                                        <span class="bd-logo">MV</span>
                                        <b>Materiales del Valle</b>
                                        <span class="fx-steps"><span>{tx('Carrito', 'Cart')}</span><i></i><span class="on">{tx('Facturación', 'Billing')}</span><i></i><span>{tx('Pago', 'Payment')}</span></span>
                                    </div>
                                    <div class="fx-body">
                                        <div class="fx-head"><h4>{tx('Datos de facturación', 'Billing details')}</h4><code>&lt;cord-fiscal-form&gt;</code></div>
                                        <div class="fx-f">
                                            <span class="fx-l">{tx('RFC', 'RFC (Mexican tax ID)')}</span>
                                            <span class="fx-in fx-mono"><span data-k="rfc">DEZ170315KT7</span><i class="fx-caret" data-k="caret"></i></span>
                                        </div>
                                        <div class="fx-f">
                                            <span class="fx-l">{tx('Nombre o razón social', 'Legal name')}</span>
                                            <span class="fx-in">DISTRIBUIDORA EL ZARCO S.A. DE C.V.</span>
                                            <span class="fx-warn">{tx('Escríbelo como en la Constancia de Situación Fiscal, sin "S.A. de C.V." ni similares.', 'Write it as on the tax certificate, without "S.A. de C.V." or similar.')}</span>
                                        </div>
                                        <div class="fx-f fx-f-sel">
                                            <span class="fx-l">{tx('Régimen fiscal', 'Tax regime')}</span>
                                            <span class="fx-in fx-sel fx-focus" data-k="reg"><span data-k="regv">601 — General de Ley Personas Morales</span><svg viewBox="0 0 24 24"><polyline points="7 10 12 15 17 10"/></svg></span>
                                            <div class="fx-menu" data-k="menu">
                                                {REG_MORAL.map((r, i) => (
                                                    <span class:list={['fx-opt', { on: i === 0 }]}><b>{r.c}</b> — {r.n}{i === 0 && <svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9"/></svg>}</span>
                                                ))}
                                            </div>
                                        </div>
                                        <div class="fx-f">
                                            <span class="fx-l">{tx('Uso del CFDI', 'CFDI use')}</span>
                                            <span class="fx-in fx-sel">G01 — Adquisición de mercancías<svg viewBox="0 0 24 24"><polyline points="7 10 12 15 17 10"/></svg></span>
                                        </div>
                                        <div class="fx-f">
                                            <span class="fx-l">{tx('Código postal fiscal', 'Tax postal code')}</span>
                                            <span class="fx-in fx-mono">76120</span>
                                        </div>
                                        <span class="fx-btn" data-k="btn">{tx('Continuar al pago', 'Continue to payment')}</span>
                                    </div>
                                </div>
