<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const money = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    const initCarousel = (root: HTMLElement) => {
        const track = root.querySelector<HTMLElement>('[data-emo-track]');
        if (!track) return;
        const prev = root.querySelector<HTMLButtonElement>('[data-emo-dir="-1"]');
        const next = root.querySelector<HTMLButtonElement>('[data-emo-dir="1"]');
        const step = () => {
            const card = track.querySelector<HTMLElement>('.emo-card');
            const gap = parseFloat(getComputedStyle(track).columnGap) || 24;
            return (card?.offsetWidth ?? 420) + gap;
        };
        const sync = () => {
            const max = track.scrollWidth - track.clientWidth;
            if (prev) prev.disabled = track.scrollLeft < 8;
            if (next) next.disabled = track.scrollLeft > max - 8;
        };
        const go = (dir: number) => track.scrollBy({ left: dir * step(), behavior: 'smooth' });
        prev?.addEventListener('click', () => go(-1));
        next?.addEventListener('click', () => go(1));
        track.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync, { passive: true });
        track.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
            else if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
        });
        sync();

        // Arrastre con mouse (escritorio). En touch manda el scroll nativo.
        let down = false, moved = false, startX = 0, startL = 0;
        track.addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse' || e.button !== 0) return;
            down = true; moved = false; startX = e.clientX; startL = track.scrollLeft;
        });
        window.addEventListener('pointermove', (e) => {
            if (!down) return;
            const dx = e.clientX - startX;
            if (!moved && Math.abs(dx) > 5) { moved = true; track.classList.add('is-drag'); }
            if (moved) track.scrollLeft = startL - dx;
        });
        const end = () => {
            if (!down) return;
            down = false;
            if (!moved) return;
            // Al soltar, cae a la tarjeta más cercana en vez de quedarse a medias.
            const s = step();
            const target = Math.round(track.scrollLeft / s) * s;
            track.classList.remove('is-drag');
            track.scrollTo({ left: target, behavior: 'smooth' });
        };
        window.addEventListener('pointerup', end);
        window.addEventListener('pointercancel', end);
        track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
        track.addEventListener('dragstart', (e) => e.preventDefault());
    };

    // ── Micro-historias por tarjeta. Cada una devuelve un timeline pausado. ──
    const q = <T extends Element = HTMLElement>(el: Element, k: string) => el.querySelector<T & HTMLElement>(`[data-k="${k}"]`);
    const qa = (el: Element, k: string) => Array.from(el.querySelectorAll<HTMLElement>(`[data-k="${k}"]`));

    const builder = (v: Element, root: HTMLElement) => {
        const rest = Number(root.dataset.rest) || 0;
        const qty = q(v, 'qty'), amt = q(v, 'amt'), sub = q(v, 'sub'), iva = q(v, 'iva'), tot = q(v, 'tot');
        const plus = q(v, 'plus'), btn = q(v, 'btn'), toast = q(v, 'toast');
        if (!qty || !amt || !sub || !iva || !tot || !toast) return null;
        const st = { n: 340 };
        const render = () => {
            const n = Math.round(st.n);
            const a = n * 182;
            const s = a + rest;
            const i = Math.round(s * 16) / 100;
            qty.textContent = String(n);
            amt.textContent = money(a);
            sub.textContent = money(s);
            iva.textContent = money(i);
            tot.textContent = money(s + i);
        };
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.4, paused: true });
        tl.set(toast, { autoAlpha: 0, y: 16 }, 0)
            .call(() => { st.n = 340; render(); }, undefined, 0)
            .to(plus, { scale: 0.82, backgroundColor: 'rgba(10,25,47,0.14)', duration: 0.14 }, 0.9)
            .to(st, { n: 360, duration: 1.1, ease: 'power1.inOut', onUpdate: render }, 1.0)
            .to(plus, { scale: 1, backgroundColor: 'rgba(10,25,47,0.05)', duration: 0.2 }, 2.1)
            .to(btn, { scale: 0.95, duration: 0.12, yoyo: true, repeat: 1 }, 2.9)
            .to(toast, { autoAlpha: 1, y: 0, duration: 0.55, ease: 'power3.out' }, 3.2)
            .to(toast, { autoAlpha: 0, y: 10, duration: 0.4, ease: 'power2.in' }, 7.4);
        return tl;
    };

    const webhooks = (v: Element) => {
        const rows = qa(v, 'row');
        const hl = q(v, 'hl');
        if (!rows.length) return null;
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.3, paused: true });
        tl.set(rows, { autoAlpha: 0, y: 8 }, 0);
        rows.forEach((r, i) => {
            const at = 0.6 + i * 0.95;
            tl.to(r, { autoAlpha: 1, y: 0, duration: 0.45, ease: 'power3.out' }, at);
            if (hl) tl.fromTo(hl, { backgroundColor: r.classList.contains('bad') ? 'rgba(220,38,38,0.16)' : 'rgba(47,109,240,0.18)' }, { backgroundColor: 'rgba(47,109,240,0.07)', duration: 0.8 }, at - 0.15);
        });
        tl.to(rows, { autoAlpha: 0, duration: 0.4, stagger: 0.04 }, 0.6 + rows.length * 0.95 + 3.2);
        return tl;
    };

    const framer = (v: Element) => {
        const tok = q(v, 'tok'), caret = q(v, 'caret'), ph = q(v, 'ph'), quote = q(v, 'quote');
        if (!tok || !ph || !quote) return null;
        const full = tok.textContent ?? '';
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.3, paused: true });
        tl.call(() => { tok.textContent = ''; }, undefined, 0)
            .set(caret, { autoAlpha: 1 }, 0)
            .set(ph, { autoAlpha: 1 }, 0)
            .set(quote, { autoAlpha: 0, y: 8 }, 0);
        for (let i = 1; i <= full.length; i++) tl.call(() => { tok.textContent = full.slice(0, i); }, undefined, 0.9 + i * 0.075);
        const done = 0.9 + full.length * 0.075 + 0.35;
        tl.to(caret, { autoAlpha: 0, duration: 0.2 }, done)
            .to(ph, { autoAlpha: 0, duration: 0.3 }, done)
            .to(quote, { autoAlpha: 1, y: 0, duration: 0.55, ease: 'power3.out' }, done + 0.15)
            .to({}, { duration: 3.6 });
        return tl;
    };

    const isLoadingText = 'isLoading…';
    const catalog = (v: Element) => {
        const tiles = qa(v, 'tile');
        const sks = tiles.map((t) => t.querySelector<HTMLElement>('.ct-sk')).filter(Boolean) as HTMLElement[];
        const stat = q(v, 'st'), badge = q(v, 'badge');
        if (!tiles.length || !stat) return null;
        const loaded = stat.textContent ?? '';
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.2, paused: true });
        tl.set(sks, { autoAlpha: 1 }, 0)
            .call(() => { stat.textContent = isLoadingText; stat.classList.add('wait'); }, undefined, 0)
            .call(() => { stat.textContent = loaded; stat.classList.remove('wait'); }, undefined, 1.3)
            .to(sks, { autoAlpha: 0, duration: 0.4, stagger: 0.09, ease: 'power2.out' }, 1.35)
            .fromTo(badge, { backgroundColor: 'rgba(5,150,105,0.26)' }, { backgroundColor: 'rgba(5,150,105,0.12)', duration: 1.1 }, 2.2)
            .to({}, { duration: 4.2 });
        return tl;
    };

    const errors = (v: Element) => {
        const cases = qa(v, 'case'), toast = q(v, 'toast'), tt = q(v, 'tt'), tm = q(v, 'tm');
        if (!cases.length || !toast || !tt || !tm) return null;
        const tl = gsap.timeline({ repeat: -1, paused: true });
        cases.forEach((c, i) => {
            const at = i * 2.6;
            tl.to(toast, { autoAlpha: 0, y: -6, duration: 0.22 }, at)
                .call(() => {
                    cases.forEach((x) => x.classList.toggle('on', x === c));
                    tt.textContent = c.dataset.msg ?? '';
                    tm.textContent = c.dataset.meta ?? '';
                }, undefined, at + 0.24)
                .fromTo(toast, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.45, ease: 'power3.out' }, at + 0.5);
        });
        tl.to({}, { duration: 0.1 }, cases.length * 2.6 - 0.1);
        return tl;
    };

    const phone = (v: Element, root: HTMLElement) => {
        const btn = q(v, 'appr'), ev = q(v, 'ev'), pill = q(v, 'pill');
        if (!btn || !ev || !pill) return null;
        const sent = root.dataset.sent ?? '';
        const ok = pill.textContent ?? '';
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.3, paused: true });
        tl.call(() => { btn.classList.remove('done'); pill.textContent = sent; pill.classList.remove('ok'); }, undefined, 0)
            .set(ev, { autoAlpha: 0, x: -6 }, 0)
            .to(btn, { scale: 0.95, duration: 0.14, yoyo: true, repeat: 1 }, 1.7)
            .call(() => { btn.classList.add('done'); pill.textContent = ok; pill.classList.add('ok'); }, undefined, 1.95)
            .to(ev, { autoAlpha: 1, x: 0, duration: 0.45, ease: 'power3.out' }, 2.3)
            .to({}, { duration: 3.6 });
        return tl;
    };

    const invoice = (v: Element) => {
        const due = q(v, 'due'), bal = q(v, 'bal'), paid = q(v, 'paid'), chip = q(v, 'chip'), pay = q(v, 'pay'), toast = q(v, 'toast');
        if (!due || !bal || !paid || !chip || !pay || !toast) return null;
        const start = Number((due.textContent ?? '').replace(/[^0-9.]/g, '')) || 0;
        const paid0 = paid.textContent ?? '', paidFull = paid.dataset.full ?? '';
        const open = chip.textContent ?? '', done = chip.dataset.paid ?? '';
        const btn = pay.querySelector<HTMLElement>('.iv-btn');
        const st = { n: start };
        const render = () => { const t = money(st.n); due.textContent = t; bal.textContent = t; };
        const reset = () => {
            st.n = start; render(); paid.textContent = paid0;
            chip.textContent = open; chip.classList.remove('ok'); pay.classList.remove('done');
        };
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.4, paused: true });
        tl.set(toast, { autoAlpha: 0, y: 16 }, 0)
            .call(reset, undefined, 0)
            .to(btn, { scale: 0.95, duration: 0.13, yoyo: true, repeat: 1 }, 1.4)
            .to(st, { n: 0, duration: 1, ease: 'power2.inOut', onUpdate: render }, 2.2)
            .call(() => { paid.textContent = paidFull; chip.textContent = done; chip.classList.add('ok'); pay.classList.add('done'); }, undefined, 3.2)
            .to(toast, { autoAlpha: 1, y: 0, duration: 0.55, ease: 'power3.out' }, 3.4)
            .to(toast, { autoAlpha: 0, y: 10, duration: 0.4, ease: 'power2.in' }, 7.6);
        return tl;
    };

    const fiscal = (v: Element, root: HTMLElement) => {
        const rfc = q(v, 'rfc'), caret = q(v, 'caret'), menu = q(v, 'menu'), reg = q(v, 'reg'), regv = q(v, 'regv'), btn = q(v, 'btn');
        if (!rfc || !menu || !reg || !regv || !btn) return null;
        const full = rfc.textContent ?? '';
        const regFull = regv.textContent ?? '';
        const choose = root.dataset.choose ?? '';
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.4, paused: true });
        tl.call(() => { rfc.textContent = ''; regv.textContent = choose; btn.classList.add('off'); reg.classList.remove('fx-focus'); }, undefined, 0)
            .set(caret, { autoAlpha: 1 }, 0)
            .set(menu, { autoAlpha: 0, y: -4 }, 0);
        for (let i = 1; i <= full.length; i++) tl.call(() => { rfc.textContent = full.slice(0, i); }, undefined, 0.8 + i * 0.09);
        const typed = 0.8 + full.length * 0.09 + 0.3;
        tl.set(caret, { autoAlpha: 0 }, typed)
            .call(() => reg.classList.add('fx-focus'), undefined, typed + 0.4)
            .to(menu, { autoAlpha: 1, y: 0, duration: 0.35, ease: 'power3.out' }, typed + 0.5)
            .call(() => { regv.textContent = regFull; }, undefined, typed + 1.6)
            .call(() => btn.classList.remove('off'), undefined, typed + 1.9)
            .to({}, { duration: 3.8 });
        return tl;
    };

    const debug = (v: Element) => {
        const rows = qa(v, 'drow');
        if (!rows.length) return null;
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.3, paused: true });
        tl.set(rows, { autoAlpha: 0, height: 0, paddingTop: 0, paddingBottom: 0 }, 0);
        rows.slice().reverse().forEach((r, i) => {
            tl.to(r, { autoAlpha: 1, height: 'auto', paddingTop: 5, paddingBottom: 5, duration: 0.45, ease: 'power3.out' }, 0.5 + i * 0.85);
        });
        tl.to({}, { duration: 3.6 });
        return tl;
    };

    const STORIES: Partial<Record<string, (v: Element, root: HTMLElement) => gsap.core.Timeline | null>> = { builder, invoice, fiscal, webhooks, framer, debug, catalog, errors, phone };

    const init = () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll<HTMLElement>('[data-emo]').forEach((root) => {
            if (root.dataset.emoReady) return;
            root.dataset.emoReady = '1';
            initCarousel(root);
            if (reduced) return;

            const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-emo-card]'));
            gsap.set(cards, { autoAlpha: 0, y: 28 });
            ScrollTrigger.create({
                trigger: root, start: 'top 82%', once: true,
                onEnter: () => gsap.to(cards, { autoAlpha: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, clearProps: 'transform,opacity,visibility' }),
            });

            cards.forEach((card) => {
                const make = STORIES[card.dataset.emoCard ?? ''];
                const vis = card.querySelector('.emo-vis');
                const tl = make && vis ? make(vis, root) : null;
                if (!tl) return;
                // Corre solo con la tarjeta visible (también horizontalmente
                // dentro del carril) y con la pestaña al frente.
                let on = false;
                const apply = () => { if (on && !document.hidden) tl.play(); else tl.pause(); };
                new IntersectionObserver(([e]) => { on = e.isIntersecting; apply(); }, { threshold: 0.35 }).observe(card);
                document.addEventListener('visibilitychange', apply);
            });
        });
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
</script>

