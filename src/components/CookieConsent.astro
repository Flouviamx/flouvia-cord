---
// Aviso de consentimiento de cookies — estilo "Apple" (tarjeta flotante squircle,
// sombras compuestas, píldoras). Se monta UNA vez en Layout.astro (landing/legal/
// link público) y en AppLayout.astro (app). Gatea la captura de PostHog: el script
// de analítica de cada layout inicializa con `opt_out_capturing_by_default: true`,
// y este componente es el único que llama opt_in_capturing()/opt_out_capturing()
// según la decisión guardada en localStorage (compartido entre / y /app — mismo
// origen). Vercel Analytics NO se gatea aquí: no usa cookies ni identifica a nadie
// (ver src/pages/privacidad.astro §05), así que corre siempre.

interface Props {
  lang?: string; // 'es' | 'en' — cualquier valor distinto de 'en' cae a español
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const privacyHref = isEn ? '/en/privacidad#cookies' : '/privacidad#cookies';
---

<div id="cc-banner" class="cc-banner" hidden role="dialog" aria-live="polite" aria-labelledby="cc-title" aria-describedby="cc-body">
  <div class="cc-card">
    <div class="cc-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.34-.02-.68-.05-1.02a2.5 2.5 0 0 1-3.45-2.6A2.5 2.5 0 0 1 14.9 4.2 8.96 8.96 0 0 0 12 3Z" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.12" stroke-linejoin="round"/>
        <circle cx="8.6" cy="10.2" r="1.1" fill="currentColor"/>
        <circle cx="12.4" cy="15.1" r="1.1" fill="currentColor"/>
        <circle cx="9.2" cy="15.6" r="0.7" fill="currentColor"/>
      </svg>
    </div>

    <div class="cc-copy">
      <p id="cc-title" class="cc-title">{isEn ? 'Your privacy' : 'Tu privacidad'}</p>
      <p id="cc-body" class="cc-body">
        {isEn
          ? <Fragment>We use essential cookies to run Cord, and analytics cookies (PostHog) to understand how the product is used. Vercel Analytics is cookieless and never gated. <a href={privacyHref}>Cookie policy</a></Fragment>
          : <Fragment>Usamos cookies esenciales para que Cord funcione, y cookies de analítica (PostHog) para entender cómo se usa el producto. Vercel Analytics no usa cookies y nunca se bloquea. <a href={privacyHref}>Política de cookies</a></Fragment>
        }
      </p>
    </div>

    <div class="cc-actions">
      <button type="button" id="cc-reject" class="cc-btn cc-btn-ghost">{isEn ? 'Necessary only' : 'Solo necesarias'}</button>
      <button type="button" id="cc-accept" class="cc-btn cc-btn-primary">{isEn ? 'Accept all' : 'Aceptar todas'}</button>
    </div>
  </div>
</div>

<script>
  const KEY = 'cord_cookie_consent';

  function applyConsent(value) {
    try {
      if (typeof window.posthog === 'undefined') return;
      if (value === 'accepted') window.posthog.opt_in_capturing();
      else window.posthog.opt_out_capturing();
    } catch (e) {}
  }

  function hideBanner(el) {
    el.classList.remove('cc-show');
    el.classList.add('cc-hide');
    window.setTimeout(() => { el.hidden = true; el.classList.remove('cc-hide'); }, 320);
  }

  function showBanner(el) {
    el.hidden = false;
    // Doble rAF para asegurar que el navegador pinte el estado inicial (hidden->flex)
    // antes de agregar la clase que dispara la transición de entrada.
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('cc-show')));
  }

  function init() {
    const el = document.getElementById('cc-banner');
    if (!el) return;

    const stored = (() => { try { return localStorage.getItem(KEY); } catch (e) { return null; } })();
    if (stored === 'accepted' || stored === 'rejected') {
      applyConsent(stored);
    } else {
      showBanner(el);
    }

    const accept = document.getElementById('cc-accept');
    const reject = document.getElementById('cc-reject');
    accept?.addEventListener('click', () => {
      try { localStorage.setItem(KEY, 'accepted'); } catch (e) {}
      applyConsent('accepted');
      hideBanner(el);
    });
    reject?.addEventListener('click', () => {
      try { localStorage.setItem(KEY, 'rejected'); } catch (e) {}
      applyConsent('rejected');
      hideBanner(el);
    });

    // Expuesto para el link "Administrar preferencias de cookies" de /privacidad.
    window.cordOpenCookiePrefs = () => showBanner(el);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .cc-banner {
    position: fixed;
    z-index: 999990;
    left: 20px;
    bottom: 20px;
    width: min(400px, calc(100vw - 40px));
    display: flex;
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    pointer-events: none;
  }
  .cc-banner.cc-show {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    transition: opacity 0.5s var(--ease-spring, cubic-bezier(0.22, 1, 0.36, 1)),
                transform 0.5s var(--ease-spring, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .cc-banner.cc-hide {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition: opacity 0.28s ease, transform 0.28s ease;
  }

  .cc-card {
    width: 100%;
    background: #ffffff;
    border-radius: 26px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow:
      0 1px 2px rgba(10, 25, 47, 0.04),
      0 12px 24px -8px rgba(10, 25, 47, 0.12),
      0 32px 64px -24px rgba(10, 25, 47, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .cc-icon {
    width: 34px;
    height: 34px;
    border-radius: 11px;
    background: #f5f5f7;
    color: #0a192f;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cc-copy { display: flex; flex-direction: column; gap: 4px; }

  .cc-title {
    margin: 0;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #050505;
  }

  .cc-body {
    margin: 0;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #55555a;
  }
  .cc-body a {
    color: #0a192f;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cc-body a:hover { opacity: 0.72; }

  .cc-actions {
    display: flex;
    gap: 8px;
    margin-top: 2px;
  }

  .cc-btn {
    all: unset;
    box-sizing: border-box;
    flex: 1;
    text-align: center;
    padding: 10px 16px;
    border-radius: 999px;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.18s var(--ease-ios, ease), background-color 0.18s ease, opacity 0.18s ease;
  }
  .cc-btn:active { transform: scale(0.96); }
  .cc-btn:focus-visible { outline: 2px solid rgba(10, 25, 47, 0.4); outline-offset: 2px; }

  .cc-btn-ghost {
    background: #f5f5f7;
    color: #0a192f;
  }
  .cc-btn-ghost:hover { background: #ececee; }

  .cc-btn-primary {
    background: #0a192f;
    color: #ffffff;
  }
  .cc-btn-primary:hover { background: #0d2038; }

  /* Modo oscuro (solo aplica dentro de la app, vía html[data-theme="dark"];
     en la landing ese atributo nunca se setea, así que esta regla es un no-op ahí). */
  :global(html[data-theme='dark']) .cc-card {
    background: var(--surface, #12181f);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 12px 24px -8px rgba(0, 0, 0, 0.4),
      0 32px 64px -24px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  :global(html[data-theme='dark']) .cc-title { color: #f4f5f7; }
  :global(html[data-theme='dark']) .cc-body { color: #a8adb6; }
  :global(html[data-theme='dark']) .cc-body a { color: #cbd5e1; }
  :global(html[data-theme='dark']) .cc-icon { background: rgba(255, 255, 255, 0.08); color: #cbd5e1; }
  :global(html[data-theme='dark']) .cc-btn-ghost { background: rgba(255, 255, 255, 0.08); color: #f4f5f7; }
  :global(html[data-theme='dark']) .cc-btn-ghost:hover { background: rgba(255, 255, 255, 0.14); }
  :global(html[data-theme='dark']) .cc-btn-primary { background: #ffffff; color: #0a192f; }
  :global(html[data-theme='dark']) .cc-btn-primary:hover { background: #e5e7eb; }

  /* Mobile — bottom sheet a todo lo ancho, con espacio para el home-indicator */
  @media (max-width: 640px) {
    .cc-banner {
      left: 0;
      bottom: 0;
      width: 100%;
    }
    .cc-banner.cc-show { transform: translateY(0); }
    .cc-banner:not(.cc-show) { transform: translateY(100%); }
    .cc-card {
      border-radius: 24px 24px 0 0;
      padding: 20px 20px calc(16px + env(safe-area-inset-bottom));
      box-shadow:
        0 -1px 2px rgba(10, 25, 47, 0.04),
        0 -12px 32px -8px rgba(10, 25, 47, 0.16);
    }
    .cc-actions { flex-direction: column-reverse; gap: 8px; }
    .cc-btn { padding: 13px 16px; font-size: 0.875rem; }
    .cc-banner.cc-hide { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-banner, .cc-banner.cc-show, .cc-banner.cc-hide {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
