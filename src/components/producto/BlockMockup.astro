  {slug === 'link-publico' && index === 1 && (
    <div class="bm-stage" data-bmx="lp1">
      <div class="bm-app bm-w">
        <div class="bm-w-bar">
          <span class="bm-w-crumbs"><span class="bk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>{tx('Configuración', 'Settings')}</span><span class="bm-w-sep">/</span><strong>{tx('Portal del cliente', 'Client portal')}</strong></span>
        </div>
        <div class="bm-set-tabs"><span>Branding</span><span class="on">{tx('Portal del cliente', 'Client portal')}</span><span>{tx('Dominio propio', 'Custom domain')}</span></div>
        <div class="bm-pt">
          <div class="bm-pt-form">
            <div class="bm-pt-b bm-pt-msg">
              <span class="h">{tx('Mensajes', 'Messages')}</span>
              <span class="lb">{tx('Banner superior', 'Top banner')}</span>
              <span class="bm-field">{tx('Precios válidos al 31 de octubre · Flete sin costo a obra', 'Prices valid through October 31 · Free delivery to site')}</span>
            </div>
            <div class="bm-pt-b">
              <span class="h">{tx('Color de marca', 'Brand color')}</span>
              <span class="lb">{tx('Acento del portal', 'Portal accent')}</span>
              <span class="bm-pt-color"><span class="sw" data-sw></span><span class="bm-field hex"><span data-hex>#B45309</span></span></span>
              <span class="hint">{tx('Botones, montos y detalles del portal usan este color.', 'Buttons, amounts, and portal details use this color.')}</span>
            </div>
            <div class="bm-pt-b bm-pt-int">
              <span class="h">{tx('Interacción', 'Interaction')}</span>
              <span class="bm-pt-tg"><span class="bm-tog on"></span><span>{tx('Permitir comentarios y contraofertas del cliente', 'Allow client comments and counteroffers')}</span></span>
              <span class="bm-pt-tg"><span class="bm-tog" data-ptog></span><span>{tx('Mostrar "enviado vía Cord"', 'Show "sent via Cord"')}</span></span>
