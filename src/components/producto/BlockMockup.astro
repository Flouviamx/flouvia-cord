          <div class="bm-ed-head"><span>{tx('Producto', 'Product')}</span><span>{tx('Cant.', 'Qty.')}</span><span>{tx('Lista', 'List')}</span><span>{tx('Negociado', 'Negotiated')}</span><span class="r">{tx('Importe', 'Amount')}</span></div>
          <div class="bm-ed-row"><span class="bm-ed-name">{tx('Varilla corrugada 3/8" × 12 m', 'Rebar 3/8" × 12 m')}<small>{tx('pieza', 'piece')}</small></span><span class="bm-in bm-ed-q">340</span><span class="bm-ed-list">{mx(191.48)}</span><span class="bm-in bm-ed-nego is-deal">168.50</span><span class="editorial bm-ed-amt">{mx(57290)}</span></div>
          <div class="bm-ed-row"><span class="bm-ed-name">{tx('Cemento gris 50 kg', 'Gray cement 50 kg')}<small>{tx('saco', 'bag')}</small></span><span class="bm-in bm-ed-q">120</span><span class="bm-ed-list">{mx(182)}</span><span class="bm-in bm-ed-nego">182.00</span><span class="editorial bm-ed-amt">{mx(21840)}</span></div>
          <div class="bm-ed-row"><span class="bm-ed-name">{tx('Block hueco 15×20×40', 'Hollow block 15×20×40')}<small>{tx('pieza', 'piece')}</small></span><span class="bm-in bm-ed-q is-focus" data-qty><span data-v>2400</span><span class="bm-caret"></span></span><span class="bm-ed-list">{mx(14.2)}</span><span class="bm-in bm-ed-nego">14.20</span><span class="editorial bm-ed-amt" data-amt>{mx(34080)}</span></div>
          <div class="bm-ed-row"><span class="bm-ed-name">{tx('Malla electrosoldada 6×6', 'Welded wire mesh 6×6')}<small>{tx('hoja', 'sheet')}</small></span><span class="bm-in bm-ed-q">180</span><span class="bm-ed-list">{mx(312)}</span><span class="bm-in bm-ed-nego">312.00</span><span class="editorial bm-ed-amt">{mx(56160)}</span></div>
        </div>
        <div class="bm-ed-add">
          <span class="bm-field bm-ed-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" fill="currentColor" fill-opacity="0.12"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg><span>{tx('Busca un producto de tu catálogo…', 'Search a product in your catalog…')}</span></span>
          <span class="bm-ed-free">{tx('+ Línea libre', '+ Free line')}</span>
        </div>
        <div class="bm-ed-notes"><span class="h">{tx('Notas para el cliente', 'Notes for the client')} <em>{tx('(opcional)', '(optional)')}</em></span><span class="bm-field">{tx('Precio especial por volumen — entrega en obra incluida.', 'Special bulk price — on-site delivery included.')}</span></div>
      </div>
      <div class="bm-sum" data-lines={tx('líneas', 'lines')} data-pcs={tx('piezas', 'pieces')}>
        <div class="bm-sum-h">{tx('Revisa y envía', 'Review and send')}</div>
        <div class="bm-sum-count" data-count>4 {tx('líneas', 'lines')} · 3,040 {tx('piezas', 'pieces')}</div>
        <div class="bm-sum-l"><span>Subtotal</span><span class="editorial" data-sub>{mx(169370)}</span></div>
        <div class="bm-sum-l save"><span>{tx('Le descontaste', 'You discounted them')}</span><span class="editorial">−{mx(7813.2)}</span></div>
        <div class="bm-sum-tg"><span>{tx('Precios ya incluyen IVA', 'Prices already include tax')}</span><span class="bm-tog"></span></div>
        <div class="bm-sum-l tax"><span>{'IVA 16%'}</span><span class="editorial" data-iva>{mx(27099.2)}</span></div>
        <div class="bm-sum-div"></div>
        <div class="bm-sum-l total"><span>Total</span><span class="editorial" data-tot>{mx(196469.2)}</span></div>
        <div class="bm-sum-f"><span class="lb">{tx('Vigencia', 'Valid for')}</span><span class="bm-field">30 {tx('días', 'days')}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span></div>
        <div class="bm-sum-f"><span class="lb">{tx('¿En qué moneda le cotizas?', 'What currency are you quoting in?')}</span><span class="bm-field">MXN — {tx('peso mexicano', 'Mexican peso')}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span></div>
        <span class="bm-sum-send">{tx('Crear y enviar', 'Create and send')}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
    </div>
  )}

  {/* ────────────────── LINK PÚBLICO ────────────────── */}
  {slug === 'link-publico' && index === 0 && (
    <div class="bm-stage" data-bmx="lp0">
      <div class="bm-app bm-x-free">
        <div class="bm-phone">
          <div class="bm-phone-scr">
            <div class="bm-ios">
              <span class="t">9:41</span><span class="isl"></span>
              <span class="ic">
                <svg viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="7" width="3" height="5" rx="0.7"/><rect x="5" y="5" width="3" height="7" rx="0.7"/><rect x="10" y="2.5" width="3" height="9.5" rx="0.7"/><rect x="15" y="0" width="3" height="12" rx="0.7"/></svg>
                <svg viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1.5 5.2a12.5 12.5 0 0 1 17 0M4.6 8.4a8 8 0 0 1 10.8 0M7.8 11.5a3.2 3.2 0 0 1 4.4 0"/></svg>
                <svg viewBox="0 0 27 13" fill="none"><rect x="0.6" y="0.6" width="22.8" height="11.8" rx="3.4" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.2"/><rect x="2.4" y="2.4" width="17" height="8.2" rx="2" fill="currentColor"/><path d="M25 4.4v4.2c.8-.3 1.4-1.1 1.4-2.1s-.6-1.8-1.4-2.1z" fill="currentColor" fill-opacity="0.45"/></svg>
              </span>
            </div>
            <div class="bm-qp">
              <div class="bm-qc">
                <div class="bm-qc-head">
                  <span class="bm-qc-brand"><span class="bm-qc-mark">M</span><span class="bm-qc-bt"><span class="n">Materiales del Valle</span><span class="r">RFC MVA240611AB3</span></span></span>
                  <span class="bm-qc-folio"><span class="e">{tx('COTIZACIÓN', 'QUOTE')}</span><span class="f">COT-0148</span></span>
                </div>
                <div class="bm-qc-rule"></div>
                <div class="bm-qc-sign" data-form>
                  <div class="bm-qc-sh"><span class="bk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></span><span>{tx('Firma digital', 'Digital signature')}</span></div>
                  <div class="bm-qc-pill">{tx('Aprobando', 'Approving')} <strong>COT-0148</strong> {tx('por', 'for')} <strong class="acc">{mx(196469.2)} MXN</strong></div>
                  <div class="bm-qc-f"><span class="lb">{tx('Nombre completo del firmante', "Signer's full name")}</span><span class="in"><span data-name>Raúl Mendoza</span><span class="bm-caret"></span><span class="ph" data-nph>{tx('Ej. María García López', 'E.g. Jane Smith')}</span></span></div>
                  <div class="bm-qc-ck"><span class="bx" data-check set:html={chk}></span><span>{tx('He revisado esta cotización y acepto los términos y condiciones indicados', 'I have reviewed this quote and accept the stated terms and conditions')}</span></div>
                  <span class="bm-qc-cta" data-cta>{tx('Confirmar y firmar', 'Confirm and sign')}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
                </div>
                <div class="bm-qc-done" data-done aria-hidden="true">
                  <span class="ring"><svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="23" fill="none" stroke="currentColor" stroke-width="2"/><polyline points="14,27 22,35 38,18" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span class="tt">{tx('Cotización aprobada', 'Quote approved')}</span>
                  <span class="st">{tx('Materiales del Valle recibió tu confirmación y se pondrá en contacto contigo en breve.', 'Materiales del Valle received your confirmation and will be in touch shortly.')}</span>
