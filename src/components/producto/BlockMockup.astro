  .bm-toast-success { background: rgba(6, 78, 59, 0.95); border-color: rgba(16, 185, 129, 0.25); }
  .bm-toast-sm { padding: 6px 10px; font-size: 0.62rem; }
  .bm-toast-text { display: flex; flex-direction: column; line-height: 1.25; }
  .bm-toast-hide { opacity: 0; }

  .bm-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .bm-dot-blue { background: #60a5fa; box-shadow: 0 0 6px rgba(96,165,250,0.6); }
  .bm-dot-green { background: #34d399; box-shadow: 0 0 6px rgba(52,211,153,0.6); }
  .bm-dot-orange { background: #fbbf24; box-shadow: 0 0 6px rgba(251,191,36,0.6); }

  .bm-avatar { width: 22px; height: 22px; border-radius: 6px; background: linear-gradient(135deg, #3b82f6, #2563eb); display: flex; align-items: center; justify-content: center; font-size: 0.55rem; font-weight: 800; color: #fff; box-shadow: 0 2px 8px rgba(37,99,235,0.25); }
  .bm-avatar-sm { width: 16px; height: 16px; border-radius: 4px; background: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 0.5rem; font-weight: 800; color: #fff; }
  .bm-icon-check { width: 18px; height: 18px; border-radius: 50%; background: #10b981; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; font-style: normal; font-weight: 800; box-shadow: 0 2px 8px rgba(16,185,129,0.3); }

  /* ── Chip & Tag states ── */
  .bm-stamp-hide { opacity: 0; }
  .bm-msg-hide { display: none; }

  .bm-tag { font-size: 0.52rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.3px; }
  .bm-tag-warn { background: rgba(245,158,11,0.15); color: #fbbf24; border: 1px solid rgba(245,158,11,0.2); }
  .bm-tag-blue { background: rgba(59,130,246,0.15); color: #93c5fd; border: 1px solid rgba(59,130,246,0.25); }
  .bm-tag-mxn { background: rgba(16,185,129,0.15); color: #34d399; border: 1px solid rgba(16,185,129,0.25); }
  .bm-intl-us { opacity: 0.55; }

  /* ── Specific Mockup Styles ── */

  /* Margin bar */
  .bm-margin-bar-bg { flex: 1; height: 5px; background: rgba(255,255,255,0.08); border-radius: 100px; margin: 0 10px; overflow: hidden; }
  .bm-margin-bar-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #3b82f6, #34d399); border-radius: 100px; }
  .bm-margin-text { font-size: 0.65rem; font-weight: 600; }
  
  /* Chat */
  .bm-chat { display: flex; flex-direction: column; gap: 8px; }
  .bm-msg { padding: 8px 12px; border-radius: 12px; max-width: 85%; line-height: 1.35; font-size: 0.68rem; }
  .bm-msg-in { background: rgba(255,255,255,0.07); align-self: flex-start; border-bottom-left-radius: 4px; }
  .bm-msg-out { background: #2563eb; align-self: flex-end; border-bottom-right-radius: 4px; color: #fff; }
  .bm-msg-typing { background: rgba(255,255,255,0.04); align-self: flex-end; opacity: 0; }
  
  /* Branding card */
  .bm-brand-card { display: flex; flex-direction: column; gap: 0.9rem; }
  .bm-brand-head { display: flex; align-items: center; gap: 10px; }
  .bm-brand-head b { font-size: 0.8rem; display: block; }
  .bm-brand-head i { display: block; font-size: 0.6rem; color: rgba(255,255,255,0.4); margin-top: 2px; }
  .bm-brand-logo { width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.04)); border: 1px solid rgba(255,255,255,0.1); flex-shrink: 0; }
  .bm-brand-color { display: flex; flex-direction: column; gap: 4px; }
  .bm-brand-color > span { font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.8px; color: rgba(255,255,255,0.4); font-weight: 700; }
  .bm-logo-pill { font-size: 0.6rem; }
  
  .bm-color-swatch-wrap { display: flex; gap: 6px; margin-top: 4px; }
  .bm-color-swatch { width: 22px; height: 22px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.15); transition: border-color 0.2s, transform 0.3s var(--ease-spring, ease); }
  .bm-color-swatch:hover { border-color: rgba(255,255,255,0.5); transform: scale(1.15); }
  .bm-swatch-1 { background: #3b82f6; }
  .bm-swatch-2 { background: #10b981; }
  .bm-swatch-3 { background: #f43f5e; }

  /* Push notification */
  .bm-push-notif {
     border-radius: 16px; padding: 12px 14px; display: flex; gap: 12px;
     box-shadow: 0 16px 32px -8px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.08);
     max-width: 300px;
     opacity: 0; transform: translateY(-20px);
  }
  .bm-push-icon img { width: 26px; height: 26px; border-radius: 7px; }
  .bm-push-body { display: flex; flex-direction: column; gap: 3px; }
  .bm-push-body b { font-size: 0.72rem; }
  .bm-push-body span { font-size: 0.64rem; color: rgba(255,255,255,0.65); line-height: 1.35; }

  /* Timeline */
  .bm-timeline-card { padding: 1.1rem; }
  .bm-tl-line { position: absolute; left: 24px; top: 1.5rem; bottom: 1.5rem; width: 2px; background: rgba(255,255,255,0.08); border-radius: 1px; }
  .bm-tl-fill { width: 100%; height: 0%; background: linear-gradient(180deg, #3b82f6, #2563eb); box-shadow: 0 0 8px rgba(59,130,246,0.4); border-radius: 1px; }
  .bm-tl-nodes { display: flex; flex-direction: column; gap: 1.1rem; position: relative; }
  .bm-tl-node { display: flex; align-items: center; gap: 12px; }
  .bm-tl-node span { font-size: 0.68rem; font-weight: 500; color: rgba(255,255,255,0.7); }
  .bm-tl-node i { width: 20px; height: 20px; border-radius: 50%; background: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: #fff; z-index: 2; box-shadow: 0 0 0 4px #0a192f, 0 2px 8px rgba(37,99,235,0.3); }
  .bm-node-pending { opacity: 0.4; }
  .bm-node-pending i { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 0 0 4px #0a192f; }

  /* Kanban */
  .bm-kanban { display: flex; gap: 8px; width: 100%; }
  .bm-board-col { padding: 10px; border-radius: 10px; }
  .bm-col-head { font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.6px; color: rgba(255,255,255,0.4); font-weight: 700; margin-bottom: 10px; }
  .bm-board-card { background: rgba(255,255,255,0.04); padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; gap: 6px; }
  .bm-badge { font-size: 0.5rem; font-weight: 700; padding: 2px 7px; border-radius: 5px; align-self: flex-start; }
  .bm-badge-orange { background: rgba(245,158,11,0.15); color: #fbbf24; border: 1px solid rgba(245,158,11,0.2); }
  .bm-badge-gray { background: rgba(255,255,255,0.08); color: #94a3b8; }
  .bm-card-foot { display: flex; justify-content: space-between; align-items: center; }
  .bm-kanban-drop { height: 50px; border: 1px dashed rgba(255,255,255,0.15); border-radius: 10px; margin-top: 8px; opacity: 0; }

  /* Search */
  .bm-search { padding: 1.1rem; }
  .bm-search-bar { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.04); padding: 9px 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.07); margin-bottom: 10px; }
  .bm-search-bar svg { width: 14px; height: 14px; opacity: 0.4; }
  .bm-search-type { color: rgba(255,255,255,0.5); font-family: var(--font-mono, monospace); }
  .bm-search-res { display: flex; flex-direction: column; gap: 4px; }
  .bm-search-res > div { padding: 9px 10px; border-radius: 8px; background: rgba(255,255,255,0.025); display: flex; flex-direction: column; gap: 3px; opacity: 0; border: 1px solid transparent; transition: border-color 0.2s; }
  .bm-search-res > div:hover { border-color: rgba(255,255,255,0.06); }
  
  /* CFDI */
  .bm-cfdi-card { overflow: hidden; position: relative; }
  .bm-fake-xml { position: absolute; inset: 0; padding: 1rem; font-family: monospace; font-size: 0.5rem; color: rgba(255,255,255,0.04); z-index: 0; word-break: break-all; opacity: 0.5; user-select: none; }
  .bm-matrix-text { transition: opacity 0.5s; }
  .bm-cfdi-card .bm-row { position: relative; z-index: 1; background: rgba(10,25,47,0.7); }
  
  /* Terminal */
  .bm-terminal { font-family: ui-monospace, 'SF Mono', Menlo, monospace; }
  .bm-term-head { display: flex; align-items: center; gap: 6px; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.06); margin-bottom: 10px; }
  .bm-term-head i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.15); }
  .bm-term-head span { font-size: 0.6rem; color: rgba(255,255,255,0.4); margin-left: auto; }
  .bm-term-body { display: flex; flex-direction: column; gap: 4px; }
  .bm-term-line { opacity: 0; font-size: 0.62rem; line-height: 1.5; }
  .bm-term-ok { color: #34d399; }
  .bm-term-cursor { display: inline-block; width: 6px; height: 13px; background: rgba(255,255,255,0.8); animation: bm-blink 1s step-end infinite; }
  @keyframes bm-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* Barcode */
  .bm-barcode { background: #fff; padding: 12px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; gap: 6px; position: relative; overflow: hidden; }
  .bm-bars { width: 100%; height: 40px; background-image: repeating-linear-gradient(90deg, #1a1a2e 0, #1a1a2e 2px, transparent 2px, transparent 4px, #1a1a2e 4px, #1a1a2e 7px, transparent 7px, transparent 9px); }
  .bm-barcode span { color: #1a1a2e; font-size: 0.58rem; font-family: ui-monospace, monospace; letter-spacing: 1px; }
  .bm-laser { position: absolute; top: 0; left: 0; right: 0; height: 2px; background: #ef4444; box-shadow: 0 0 8px rgba(239,68,68,0.6); opacity: 0; }
  .bm-btn { text-align: center; padding: 8px; border-radius: 8px; font-size: 0.68rem; font-weight: 600; cursor: default; }
  .bm-btn-outline { border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.7); }

  /* Credit */
  .bm-credit-bar { height: 6px; background: rgba(255,255,255,0.08); border-radius: 100px; margin: 10px 0; overflow: hidden; }
  .bm-credit-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #3b82f6, #60a5fa); border-radius: 100px; transition: background 0.3s; }

  /* Chart */
  .bm-chart { display: flex; align-items: flex-end; justify-content: space-between; height: 80px; margin: 10px 0; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.06); gap: 6px; }
  .bm-chart-col { flex: 1; height: 100%; display: flex; align-items: flex-end; }
  .bm-chart-col-fill { width: 100%; background: rgba(255,255,255,0.08); border-radius: 4px 4px 0 0; height: 0%; transition: height 0.3s; }
  .bm-chart-active .bm-chart-col-fill { background: linear-gradient(180deg, #3b82f6, #2563eb); }
  /* Móvil: la ventana del bento conserva su tamaño de letra */
  @media (max-width: 700px) {
    .bm-app { font-size: 0.8rem; }
    .bm-app-bar { padding: 11px 12px; gap: 8px; }
    .bm-app-title { font-size: 0.76rem; }
    .bm-app-badge { font-size: 0.56rem; padding: 4px 8px; }
    .bm-app-body { padding: 4px 4px 6px; }
    .bm-g { gap: 8px; padding: 9px 8px; font-size: 0.76rem; }
    .bm-g-head { font-size: 0.55rem; }
    .bm-app-search { margin: 9px 6px 2px; padding: 8px 10px; font-size: 0.76rem; }
    .bm-app-foot { padding: 11px 12px; gap: 10px; font-size: 0.7rem; }
    .bm-kv { padding: 10px; font-size: 0.78rem; }
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .bm-wrap { min-height: 220px; padding: 1.5rem 1rem; }
    .bm-stage { max-width: 300px; }
    .bm-floating { filter: drop-shadow(0 6px 12px rgba(0,0,0,0.2)); }
    .bm-float-top-right, .bm-float-bottom-right { right: 0; transform: translate(5%, -35%); }
    .bm-float-top-left, .bm-float-bottom-left { left: 0; transform: translate(-5%, -35%); }
    .bm-float-bottom-right, .bm-float-bottom-left { transform: translate(5%, 35%); }
  }


  /* ═══ Calcas de la app: editor, link público, seguimiento, aprobaciones ═══ */
  .bm-wrap.bm-x { padding: 26px 26px 0 !important; align-items: flex-start !important; justify-content: center !important; min-height: 0 !important; --c-list: 54px; --c-amt: 72px; --c-price: 96px; }
  .bm-wrap.bm-x[data-loc="en-US"] { --c-list: 66px; --c-amt: 86px; --c-price: 96px; }
  .bm-x .bm-stage { width: 100% !important; max-width: none !important; transform: none !important; display: block; z-index: 2; }
  .bm-x .editorial { font-family: var(--font-sans) !important; font-weight: 600 !important; letter-spacing: -0.02em !important; font-variant-numeric: tabular-nums; color: inherit !important; }
  .bm-x strong { font-weight: 600; color: inherit; }
  .bm-x em { font-style: normal; }
  .bm-x .bm-w { position: relative; border-radius: 14px; border: 1px solid rgba(10,25,47,0.07); font-size: 0.74rem; line-height: 1.35; color: #0f1729; background: #ffffff; box-shadow: 0 1px 2px rgba(10,25,47,0.04), 0 16px 36px -16px rgba(10,25,47,0.16), 0 44px 84px -40px rgba(10,25,47,0.24); }

  .bm-w-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 44px; padding: 9px 14px; border-bottom: 1px solid rgba(10,25,47,0.07); background: #fcfdfe; }
  .bm-w-crumbs { display: inline-flex; align-items: center; gap: 6px; min-width: 0; font-size: 0.74rem; font-weight: 600; color: #5b6472; white-space: nowrap; overflow: hidden; }
  .bm-w-crumbs strong { color: #0f1729; overflow: hidden; text-overflow: ellipsis; }
  .bm-w-crumbs .bk { display: inline-flex; align-items: center; gap: 3px; }
  .bm-w-crumbs .bk svg { width: 12px; height: 12px; }
  .bm-w-sep { color: #c9ced6; }
  .bm-w-h { font-size: 0.82rem; font-weight: 700; color: #0f1729; letter-spacing: -0.01em; }
  .bm-w-draft { flex-shrink: 0; font-size: 0.66rem; font-weight: 600; color: #5b6472; background: #fafbfc; border: 1px solid rgba(10,25,47,0.08); padding: 3px 8px; border-radius: 6px; }

  .bm-sp { flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.2px; padding: 3px 9px; border-radius: 100px; white-space: nowrap; }
  .bm-sp::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .bm-sp-draft { color: #64748b; background: rgba(100,116,139,0.1); }
  .bm-sp-sent { color: #2563eb; background: rgba(37,99,235,0.09); }
  .bm-sp-viewed { color: #7c3aed; background: rgba(124,58,237,0.09); }
  .bm-sp-approved { color: #059669; background: rgba(16,185,129,0.1); }
  .bm-sp-paid { color: #059669; background: rgba(16,185,129,0.14); }

  .bm-field { display: inline-flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; background: #f5f5f7; border: 1.5px solid transparent; border-radius: 9px; padding: 6px 10px; font-size: 0.72rem; font-weight: 500; color: #0f1729; }
  .bm-field svg { width: 13px; height: 13px; color: #99a2af; flex-shrink: 0; }
  .bm-field > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bm-in { display: inline-flex; align-items: center; justify-self: start; background: #f5f5f7; border: 1.5px solid transparent; border-radius: 7px; padding: 4px 7px; font-size: 0.72rem; font-weight: 500; color: #0f1729; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .bm-x .is-focus { background: #ffffff; border-color: #0a192f; box-shadow: 0 0 0 3px rgba(10,25,47,0.08); }
  .bm-caret { display: none; width: 1.5px; height: 1.05em; margin-left: 1px; background: #0a192f; animation: bm-caret 1.05s step-end infinite; }
  .is-focus > .bm-caret { display: inline-block; }
  @keyframes bm-caret { 50% { opacity: 0; } }
  .bm-chips { display: inline-flex; gap: 4px; flex-shrink: 0; }
  .bm-chips > span { font-size: 0.66rem; font-weight: 600; color: #5b6472; background: #f5f5f7; border-radius: 999px; padding: 5px 11px; white-space: nowrap; }
  .bm-chips > span.on { background: #0a192f; color: #ffffff; box-shadow: 0 2px 8px -2px rgba(10,25,47,0.3); }
  .bm-tog { position: relative; flex-shrink: 0; width: 28px; height: 16px; border-radius: 100px; background: rgba(10,25,47,0.14); transition: background 0.3s; }
  .bm-tog::after { content: ''; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: #ffffff; box-shadow: 0 1px 3px rgba(10,25,47,0.25); transition: transform 0.3s cubic-bezier(0.22,1,0.36,1); }
  .bm-tog.on { background: #0a192f; }
  .bm-tog.on::after { transform: translateX(12px); }
  .bm-sec-h { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 12px 14px 0; padding-bottom: 8px; border-bottom: 1px solid rgba(10,25,47,0.08); }
  .bm-sec-h strong { font-size: 0.8rem; color: #0f1729; letter-spacing: -0.01em; }
  .bm-sec-h span { font-size: 0.68rem; font-weight: 600; color: #5b6472; }
  .bm-filters { display: flex; gap: 5px; padding: 10px 14px 4px; overflow: hidden; white-space: nowrap; }
  .bm-filters > span { display: inline-flex; align-items: center; font-size: 0.66rem; font-weight: 600; color: #5b6472; background: #ffffff; border: 1px solid rgba(10,25,47,0.08); border-radius: 100px; padding: 4px 9px; }
  .bm-filters em { display: inline-flex; align-items: center; justify-content: center; min-width: 15px; height: 15px; padding: 0 4px; margin-left: 5px; border-radius: 100px; font-size: 0.56rem; font-weight: 700; background: #fafbfc; color: #5b6472; }
  .bm-filters > span.on { background: #0a192f; border-color: #0a192f; color: #ffffff; box-shadow: 0 4px 14px -6px rgba(10,25,47,0.45); }
  .bm-filters > span.on em { background: rgba(255,255,255,0.22); color: #ffffff; }
  .bm-btn-soft { flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px; font-size: 0.66rem; font-weight: 600; color: #0f1729; background: #fafbfc; border: 1px solid rgba(10,25,47,0.08); border-radius: 9px; padding: 5px 9px; white-space: nowrap; }
  .bm-btn-soft svg { width: 12px; height: 12px; }
  .bm-btn-navy { flex-shrink: 0; font-size: 0.66rem; font-weight: 600; color: #ffffff; background: #0a192f; border-radius: 9px; padding: 6px 11px; white-space: nowrap; box-shadow: 0 4px 12px -6px rgba(10,25,47,0.5); }

  /* editor · líneas */
  .bm-ed-client { display: flex; align-items: center; gap: 8px; padding: 12px 14px 8px; }
  .bm-ed-select { flex: 1; }
  .bm-ed-lines { padding: 0 14px; }
  .bm-ed-head, .bm-ed-row { display: grid; grid-template-columns: minmax(0,1fr) 44px var(--c-list) 60px var(--c-amt) 36px; gap: 8px; align-items: center; }
  .bm-ed-head { font-size: 0.64rem; font-weight: 500; color: #5b6472; padding: 6px 0 7px; border-bottom: 1px solid rgba(10,25,47,0.08); }
  .bm-ed-head .r, .bm-ed-amt { text-align: right; justify-self: end; }
  .bm-ed-head .c { text-align: center; }
  .bm-ed-row { padding: 8px 0; border-bottom: 1px solid rgba(10,25,47,0.07); }
  .bm-ed-name { display: flex; flex-direction: column; min-width: 0; font-size: 0.73rem; font-weight: 500; color: #0f1729; line-height: 1.3; }
  .bm-ed-name small { font-size: 0.6rem; font-weight: 500; color: #5b6472; }
  .bm-ed-list { font-size: 0.68rem; color: #5b6472; text-decoration: line-through; white-space: nowrap; }
  .bm-ed-nego.is-deal { color: #059669; font-weight: 600; }
  .bm-ed-amt { font-size: 0.74rem; white-space: nowrap; }
  .bm-mg { justify-self: center; font-size: 0.62rem; font-weight: 600; color: #059669; background: rgba(16,185,129,0.1); border-radius: 4px; padding: 2px 5px; }
  .bm-mg.low { color: #dc2626; background: rgba(220,38,38,0.1); }
  .bm-ed-add { display: flex; gap: 8px; padding: 12px 14px 16px; }
  .bm-ed-search { flex: 1; justify-content: flex-start; color: #99a2af; }
  .bm-ed-free { flex-shrink: 0; font-size: 0.68rem; font-weight: 600; color: #5b6472; background: #f5f5f7; border-radius: 9px; padding: 7px 11px; white-space: nowrap; }

  /* editor · catálogo */
  .bm-tabs { display: inline-flex; gap: 2px; padding: 2px; border-radius: 10px; background: rgba(10,25,47,0.065); }
  .bm-tabs > span { font-size: 0.68rem; font-weight: 600; color: #5b6472; padding: 4px 10px; border-radius: 8px; }
