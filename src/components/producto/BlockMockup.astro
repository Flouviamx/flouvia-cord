---
import { getLangFromUrl } from '../../i18n/utils';
const { slug, index } = Astro.props;
const en = getLangFromUrl(Astro.url) === 'en';
const slackLogo = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://slack.com&size=64';
const hubspotLogo = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://hubspot.com&size=64';
const teamsLogo = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://teams.microsoft.com&size=64';
const PF = ['pagos', 'cobranza-ia', 'divisas', 'clientes-credito', 'finanzas'].includes(slug);
const CALCA = ['editor', 'link-publico', 'seguimiento', 'aprobaciones'].includes(slug) || PF;
const LOC = en ? 'en-US' : 'es-MX';
const mx = (n: number, d = 2) => new Intl.NumberFormat(LOC, { style: 'currency', currency: 'MXN', minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
const tx = (es: string, e: string) => (en ? e : es);
const nf = (n: number, d = 2) => new Intl.NumberFormat(LOC, { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
const cur = (c: string, n: number, d = 2) => `${c === 'USD' ? 'US$' : c} ${nf(n, d)}`;
const mxs = en ? 'MX$' : '$';
const mpLogo = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://mercadopago.com.mx&size=64';
const wrapClass = `bm-wrap bm-${slug}-${index}${CALCA ? ` bm-x${index === 2 ? ' bm-x-full' : ''}` : ''}${PF ? ' bm-pf' : ''}`;
const chk = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
---
<div class={wrapClass} data-loc={CALCA ? LOC : undefined}>
  <div class="bm-mesh" aria-hidden="true"></div>
  <div class="bm-glow" aria-hidden="true"></div>

  {/* ────────────────── EDITOR ────────────────── */}
  {slug === 'editor' && index === 0 && (
    <div class="bm-stage" data-bmx="ed0">
      <div class="bm-app bm-w">
        <div class="bm-w-bar">
          <span class="bm-w-crumbs"><span>{tx('Cotizaciones', 'Quotes')}</span><span class="bm-w-sep">/</span><strong>{tx('Nueva cotización', 'New quote')}</strong></span>
          <span class="bm-w-draft">{tx('Borrador', 'Draft')}</span>
        </div>
        <div class="bm-ed-client">
          <span class="bm-field bm-ed-select"><span>Distribuidora El Zarco — Raúl Mendoza</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
          <span class="bm-chips"><span>{tx('Contado', 'Cash')}</span><span class="on">Net 30</span><span>Net 60</span></span>
        </div>
        <div class="bm-ed-lines">
          <div class="bm-ed-head"><span>{tx('Producto', 'Product')}</span><span>{tx('Cant.', 'Qty.')}</span><span>{tx('Lista', 'List')}</span><span>{tx('Negociado', 'Negotiated')}</span><span class="r">{tx('Importe', 'Amount')}</span><span class="c">{tx('Margen', 'Margin')}</span></div>
          <div class="bm-ed-row">
            <span class="bm-ed-name">{tx('Varilla corrugada 3/8" × 12 m', 'Rebar 3/8" × 12 m')}<small>{tx('pieza', 'piece')}</small></span>
            <span class="bm-in bm-ed-q">340</span>
            <span class="bm-ed-list">{mx(191.48)}</span>
            <span class="bm-in bm-ed-nego is-deal is-focus" data-nego><span data-v>168.50</span><span class="bm-caret"></span></span>
            <span class="editorial bm-ed-amt" data-amt>{mx(57290)}</span>
            <span class="bm-mg" data-mg>18%</span>
          </div>
          <div class="bm-ed-row">
            <span class="bm-ed-name">{tx('Cemento gris 50 kg', 'Gray cement 50 kg')}<small>{tx('saco', 'bag')}</small></span>
            <span class="bm-in bm-ed-q">120</span>
            <span class="bm-ed-list">{mx(182)}</span>
            <span class="bm-in bm-ed-nego">182.00</span>
            <span class="editorial bm-ed-amt">{mx(21840)}</span>
            <span class="bm-mg">22%</span>
          </div>
          <div class="bm-ed-row">
            <span class="bm-ed-name">{tx('Block hueco 15×20×40', 'Hollow block 15×20×40')}<small>{tx('pieza', 'piece')}</small></span>
            <span class="bm-in bm-ed-q">2400</span>
            <span class="bm-ed-list">{mx(14.2)}</span>
            <span class="bm-in bm-ed-nego">14.20</span>
            <span class="editorial bm-ed-amt">{mx(34080)}</span>
            <span class="bm-mg">31%</span>
          </div>
          <div class="bm-ed-row">
            <span class="bm-ed-name">{tx('Malla electrosoldada 6×6', 'Welded wire mesh 6×6')}<small>{tx('hoja', 'sheet')}</small></span>
            <span class="bm-in bm-ed-q">180</span>
            <span class="bm-ed-list">{mx(312)}</span>
            <span class="bm-in bm-ed-nego">312.00</span>
            <span class="editorial bm-ed-amt">{mx(56160)}</span>
            <span class="bm-mg">24%</span>
          </div>
        </div>
        <div class="bm-ed-add">
          <span class="bm-field bm-ed-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" fill="currentColor" fill-opacity="0.12"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg><span>{tx('Busca un producto de tu catálogo… (nombre o SKU)', 'Search a product in your catalog… (name or SKU)')}</span></span>
          <span class="bm-ed-free">{tx('+ Línea libre', '+ Free line')}</span>
        </div>
      </div>
    </div>
  )}

  {slug === 'editor' && index === 1 && (
    <div class="bm-stage" data-bmx="ed1" data-total="248" data-label={tx('productos', 'products')} data-of={tx('de', 'of')}>
      <div class="bm-app bm-w">
        <div class="bm-w-bar">
          <span class="bm-tabs"><span class="on">{tx('Catálogo', 'Catalog')}</span><span>Kits</span></span>
          <span class="bm-cat-act">
            <span class="bm-cat-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" fill="currentColor" fill-opacity="0.12"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span class="bm-cat-q" data-q></span><span class="bm-caret"></span><span class="bm-cat-ph" data-ph>{tx('Buscar productos…', 'Search products…')}</span></span>
            <span class="bm-btn-soft"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>{tx('Importar CSV', 'Import CSV')}</span>
            <span class="bm-btn-navy">{tx('+ Nuevo producto', '+ New product')}</span>
          </span>
        </div>
        <div class="bm-sec-h"><strong>{tx('Catálogo', 'Catalog')}</strong><span data-count>248 {tx('productos', 'products')}</span></div>
        <div class="bm-filters">
          <span class="on">{tx('Todos', 'All')}<em>248</em></span><span>{tx('Activos', 'Active')}<em>236</em></span><span>{tx('Inactivos', 'Inactive')}<em>12</em></span><span>{tx('Con precio por volumen', 'With volume pricing')}<em>31</em></span><span>{tx('Sin costo', 'No cost set')}<em>4</em></span>
        </div>
        <div class="bm-cat">
          <div class="bm-cat-head"><span>SKU</span><span>{tx('Producto', 'Product')}</span><span>{tx('Unidad', 'Unit')}</span><span class="r">{tx('Precio de lista', 'List price')}</span><span>{tx('Estado', 'Status')}</span></div>
          {[
            ['ALM-018', tx('Alambre recocido cal. 18', 'Annealed wire gauge 18'), 'kg', 38.5, true],
            ['ARE-001', tx('Arena de río', 'River sand'), 'm³', 540, true],
            ['BLK-154', tx('Block hueco 15×20×40', 'Hollow block 15×20×40'), tx('pieza', 'piece'), 14.2, true],
            ['CEM-050', tx('Cemento gris 50 kg', 'Gray cement 50 kg'), tx('saco', 'bag'), 182, true],
            ['GRA-034', tx('Grava 3/4"', 'Gravel 3/4"'), 'm³', 410, false],
            ['MAL-066', tx('Malla electrosoldada 6×6', 'Welded wire mesh 6×6'), tx('hoja', 'sheet'), 312, true],
            ['VAR-012', tx('Varilla corrugada 1/2" × 12 m', 'Rebar 1/2" × 12 m'), tx('pieza', 'piece'), 338.9, true],
            ['VAR-038', tx('Varilla corrugada 3/8" × 12 m', 'Rebar 3/8" × 12 m'), tx('pieza', 'piece'), 191.48, true],
            ['VAR-058', tx('Varilla corrugada 5/8" × 12 m', 'Rebar 5/8" × 12 m'), tx('pieza', 'piece'), 512.4, true],
          ].map(([sku, name, unit, price, on]) => (
            <div class="bm-cat-row" data-sku={sku as string}>
              <span class="bm-cat-sku" data-m={tx('SKU', 'SKU')}>{sku}</span>
              <span class="bm-cat-name">{name}</span>
              <span class="bm-cat-unit" data-m={tx('Unidad', 'Unit')}>{unit}</span>
              <span class="editorial bm-cat-price">{mx(price as number)}</span>
              <span class={`bm-cat-st ${on ? 'on' : 'off'}`}>{on ? tx('● Activo', '● Active') : tx('○ Inactivo', '○ Inactive')}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  {slug === 'editor' && index === 2 && (
    <div class="bm-stage" data-bmx="ed2">
      <div class="bm-app bm-w bm-ed2-back">
        <div class="bm-w-bar">
          <span class="bm-w-crumbs"><span>{tx('Cotizaciones', 'Quotes')}</span><span class="bm-w-sep">/</span><strong>{tx('Nueva cotización', 'New quote')}</strong></span>
          <span class="bm-w-draft">{tx('Borrador', 'Draft')}</span>
        </div>
        <div class="bm-step-h"><span class="n">2</span><span class="t">{tx('¿Qué le vas a cotizar?', 'What are you quoting them?')}</span></div>
