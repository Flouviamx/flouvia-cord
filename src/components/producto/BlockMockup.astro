<script>
  import { gsap } from 'gsap';

  type Build = (root: HTMLElement, loc: string) => gsap.core.Timeline;
  const $ = <T extends HTMLElement = HTMLElement>(r: ParentNode, s: string) => r.querySelector<T>(s)!;
  const money = (loc: string, n: number, d = 2) => new Intl.NumberFormat(loc, { style: 'currency', currency: 'MXN', minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
  const num = (loc: string, n: number) => new Intl.NumberFormat(loc).format(n);
  const dwell = (s: number) => (s < 60 ? `${s}s` : `${Math.floor(s / 60)}m${s % 60 ? ` ${s % 60}s` : ''}`);

  const typeText = (tl: gsap.core.Timeline, el: HTMLElement, text: string, at: number, step = 0.1) => {
    for (let i = 1; i <= text.length; i++) tl.call(() => { el.textContent = text.slice(0, i); }, [], at + (i - 1) * step);
    return at + text.length * step;
  };
  const collapse = (els: Element[] | Element) => gsap.to(els, { height: 0, paddingTop: 0, paddingBottom: 0, marginTop: 0, borderBottomWidth: 0, opacity: 0, overflow: 'hidden', duration: 0.42, ease: 'power2.inOut', stagger: 0.02 });
  const expand = (els: Element[] | Element) => {
    gsap.set(els, { clearProps: 'all' });
    gsap.from(els, { height: 0, paddingTop: 0, paddingBottom: 0, marginTop: 0, opacity: 0, overflow: 'hidden', duration: 0.5, ease: 'power2.out', stagger: 0.02, clearProps: 'all' });
  };
  const countTo = (tl: gsap.core.Timeline, el: HTMLElement, from: number, to: number, at: number, f: (n: number) => string, dur = 0.8) => {
    const o = { n: from };
    tl.fromTo(o, { n: from }, { n: to, duration: dur, ease: 'power2.out', onUpdate: () => { el.textContent = f(o.n); } }, at);
  };
  const swapPill = (el: HTMLElement, cls: string, text: string) => {
    el.className = el.className.replace(/bm-sp-\w+/, cls);
    el.textContent = text;
  };

  const BUILD: Record<string, Build> = {
    ed0(root, loc) {
      const nego = $(root, '[data-nego]'), v = $(nego, '[data-v]'), amt = $(root, '[data-amt]'), mg = $(root, '[data-mg]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.to([v, amt, mg], { opacity: 0, duration: 0.25 }, 1.4)
        .call(() => { nego.classList.remove('is-focus', 'is-deal'); v.textContent = '191.48'; amt.textContent = money(loc, 65103.2); mg.textContent = '28%'; }, [], 1.66)
        .to([v, amt, mg], { opacity: 1, duration: 0.25 }, 1.7)
        .call(() => nego.classList.add('is-focus'), [], 2.5)
        .call(() => { v.textContent = ''; }, [], 3);
      const end = typeText(tl, v, '168.50', 3.15, 0.12);
      tl.call(() => nego.classList.add('is-deal'), [], end);
      countTo(tl, amt, 65103.2, 57290, end + 0.05, (n) => money(loc, n), 0.7);
      tl.call(() => { mg.textContent = '18%'; }, [], end + 0.35)
        .fromTo([amt, mg], { backgroundColor: 'rgba(16,185,129,0.18)' }, { backgroundColor: 'rgba(16,185,129,0)', duration: 1.1, clearProps: 'backgroundColor' }, end + 0.1)
        .to({}, { duration: 3.4 }, end + 0.4);
      return tl;
    },

    ed1(root, loc) {
      const box = $(root, '.bm-cat-search'), q = $(root, '[data-q]'), ph = $(root, '[data-ph]'), count = $(root, '[data-count]');
      const rows = Array.from(root.querySelectorAll<HTMLElement>('.bm-cat-row'));
      const miss = rows.filter((r) => !(r.dataset.sku || '').startsWith('VAR'));
      const total = root.dataset.total || '248', label = root.dataset.label || '', of = root.dataset.of || '';
      const tl = gsap.timeline({ repeat: -1 });
      tl.call(() => box.classList.add('is-focus'), [], 1.2)
        .call(() => { ph.style.display = 'none'; }, [], 1.6);
      let at = typeText(tl, q, 'VAR', 1.6, 0.16);
      tl.call(() => { collapse(miss); count.textContent = `3 ${of} ${total} ${label}`; }, [], at + 0.1);
      at += 3.4;
      tl.call(() => { q.textContent = 'VA'; }, [], at)
        .call(() => { q.textContent = 'V'; }, [], at + 0.1)
        .call(() => { q.textContent = ''; ph.style.display = ''; expand(miss); count.textContent = `${total} ${label}`; }, [], at + 0.2)
        .call(() => box.classList.remove('is-focus'), [], at + 0.9)
        .to({}, { duration: 2.2 }, at + 1);
      return tl;
    },

    ed2(root, loc) {
      const qty = $(root, '[data-qty]'), v = $(qty, '[data-v]'), amt = $(root, '[data-amt]');
      const sum = $(root, '.bm-sum'), cnt = $(sum, '[data-count]'), sub = $(sum, '[data-sub]'), iva = $(sum, '[data-iva]'), tot = $(sum, '[data-tot]');
      const lines = sum.dataset.lines || '', pcs = sum.dataset.pcs || '';
      const fx = [v, amt, cnt, sub, iva, tot];
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(fx, { opacity: 0, duration: 0.25 }, 1.4)
        .call(() => {
          v.textContent = '2000'; amt.textContent = money(loc, 28400);
          cnt.textContent = `4 ${lines} · ${num(loc, 2640)} ${pcs}`;
          sub.textContent = money(loc, 163690); iva.textContent = money(loc, 26190.4); tot.textContent = money(loc, 189880.4);
        }, [], 1.66)
        .to(fx, { opacity: 1, duration: 0.25 }, 1.7)
        .call(() => { v.textContent = ''; }, [], 2.8);
      const end = typeText(tl, v, '2400', 2.95, 0.14);
      countTo(tl, amt, 28400, 34080, end, (n) => money(loc, n));
      countTo(tl, sub, 163690, 169370, end + 0.05, (n) => money(loc, n));
      countTo(tl, iva, 26190.4, 27099.2, end + 0.05, (n) => money(loc, n));
      countTo(tl, tot, 189880.4, 196469.2, end + 0.05, (n) => money(loc, n), 0.95);
      tl.call(() => { cnt.textContent = `4 ${lines} · ${num(loc, 3040)} ${pcs}`; }, [], end + 0.05)
        .fromTo([sub, iva, tot], { backgroundColor: 'rgba(16,185,129,0.14)' }, { backgroundColor: 'rgba(16,185,129,0)', duration: 1.2, clearProps: 'backgroundColor' }, end + 0.1)
        .to({}, { duration: 3.6 }, end + 0.4);
      return tl;
    },

    lp0(root) {
      const name = $(root, '[data-name]'), box = name.parentElement!, check = $(root, '[data-check]'), cta = $(root, '[data-cta]');
      const done = $(root, '[data-done]'), ring = done.querySelector('.ring svg') as SVGElement;
      const full = name.textContent || '';
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(name, { opacity: 0, duration: 0.2 }, 1.2)
        .call(() => { name.textContent = ''; box.classList.add('is-empty'); check.classList.add('off'); cta.classList.add('is-off'); }, [], 1.42)
        .set(name, { opacity: 1 }, 1.45)
        .call(() => box.classList.remove('is-empty'), [], 2.2);
      const end = typeText(tl, name, full, 2.2, 0.075);
      tl.call(() => check.classList.remove('off'), [], end + 0.45)
        .call(() => cta.classList.remove('is-off'), [], end + 0.6)
        .to(cta, { scale: 0.96, duration: 0.12, yoyo: true, repeat: 1, ease: 'power1.inOut' }, end + 1.4)
        .fromTo(done, { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, duration: 0.45, ease: 'power2.out' }, end + 1.75)
        .fromTo(ring, { scale: 0.6, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: 'back.out(1.8)', transformOrigin: '50% 50%' }, end + 1.85)
        .to(done, { autoAlpha: 0, duration: 0.4 }, end + 4.6)
        .to({}, { duration: 0.8 }, end + 5);
      return tl;
    },

    lp1(root) {
      const pt = $(root, '.bm-pt'), hex = $(root, '[data-hex]'), field = hex.parentElement!, tog = $(root, '[data-ptog]'), pw = $(root, '[data-powered]');
      const tl = gsap.timeline({ repeat: -1 });
      const step = (at: number, code: string, color: string, powered: boolean) => {
        tl.call(() => field.classList.add('is-focus'), [], at)
          .call(() => { hex.textContent = '#'; }, [], at + 0.3);
        const end = typeText(tl, hex, code, at + 0.4, 0.08);
        tl.to(pt, { '--acc': color, duration: 0.6, ease: 'power2.out' }, end)
          .call(() => field.classList.remove('is-focus'), [], end + 0.5)
          .call(() => {
            tog.classList.toggle('on', powered);
            if (powered) { pw.hidden = false; gsap.from(pw, { height: 0, marginTop: 0, opacity: 0, duration: 0.4, clearProps: 'all' }); }
            else gsap.to(pw, { height: 0, marginTop: 0, opacity: 0, duration: 0.4, onComplete: () => { pw.hidden = true; gsap.set(pw, { clearProps: 'all' }); } });
          }, [], end + 0.9);
        return end + 2.4;
      };
      let at = step(1.6, '#047857', '#047857', false);
      at = step(at, '#0A192F', '#0a192f', true);
      at = step(at, '#B45309', '#b45309', false);
      tl.to({}, { duration: 0.6 }, at);
      return tl;
    },

    lp2(root) {
      const pill = $(root, '[data-pill]'), s3 = $(root, '[data-s3]'), s4 = $(root, '[data-s4]'), row = $(root, '[data-new]'), notif = $(root, '[data-notif]');
      const fin = pill.textContent || '', was = pill.dataset.was || '';
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(notif, { autoAlpha: 0, y: -8, duration: 0.35 }, 2.2)
        .call(() => { collapse(row); swapPill(pill, 'bm-sp-viewed', was); s3.classList.replace('done', 'cur'); s4.classList.remove('cur'); }, [], 2.3)
        .call(() => { expand(row); swapPill(pill, 'bm-sp-approved', fin); s3.classList.replace('cur', 'done'); s4.classList.add('cur'); }, [], 4.4)
        .fromTo(notif, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, 4.55)
        .to({}, { duration: 3 }, 5.1);
      return tl;
    },

    tr0(root, loc) {
      const lv = $(root, '[data-lv]'), aps = $(root, '[data-aps]'), last = $(root, '[data-last]'), total = $(root, '[data-total]');
      const word = root.dataset.ap || '';
      const bars = Array.from(root.querySelectorAll<HTMLElement>('.bm-at-r'));
      const secs = bars.map((b) => Number(b.dataset.s || 0));
      const hot = secs.indexOf(Math.max(...secs));
      const now = last.textContent || '', before = last.dataset.was || '';
      const paint = (partidas: number, dur: number) => {
        const s = secs.slice(); s[hot] = partidas;
        const max = Math.max(...s);
        bars.forEach((b, i) => {
          gsap.to($(b, '.fl'), { width: `${Math.round((s[i] / max) * 100)}%`, duration: dur, ease: 'power2.out' });
          $(b, '.v').textContent = dwell(s[i]);
        });
        total.textContent = dwell(s.reduce((a, c) => a + c, 0));
      };
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(lv, { autoAlpha: 0, scale: 0.92, duration: 0.3 }, 1.6)
        .call(() => { aps.textContent = `2 ${word}`; last.textContent = before; paint(secs[hot] - 30, 0.4); }, [], 1.8)
        .fromTo(lv, { autoAlpha: 0, scale: 0.92 }, { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'back.out(2)' }, 3.4)
        .call(() => { aps.textContent = `3 ${word}`; last.textContent = now; }, [], 3.45)
        .fromTo([aps, last], { backgroundColor: 'rgba(16,185,129,0.16)' }, { backgroundColor: 'rgba(16,185,129,0)', duration: 1.2, clearProps: 'backgroundColor' }, 3.45)
        .call(() => paint(secs[hot] - 20, 0.5), [], 4.8)
        .call(() => paint(secs[hot] - 10, 0.5), [], 6)
        .call(() => paint(secs[hot], 0.5), [], 7.2)
        .to({}, { duration: 2 }, 7.4);
      return tl;
    },

    tr1(root) {
      const pill = $(root, '[data-pill]'), s3 = $(root, '[data-s3]'), s4 = $(root, '[data-s4]'), row = $(root, '[data-new]');
      const fin = pill.textContent || '', was = pill.dataset.was || '';
      const tl = gsap.timeline({ repeat: -1 });
      tl.call(() => { collapse(row); swapPill(pill, 'bm-sp-approved', was); s3.classList.replace('done', 'cur'); s4.classList.remove('cur'); }, [], 2.4)
        .call(() => { expand(row); swapPill(pill, 'bm-sp-paid', fin); s3.classList.replace('cur', 'done'); s4.classList.add('cur'); }, [], 4.6)
        .fromTo(row, { backgroundColor: 'rgba(16,185,129,0.12)' }, { backgroundColor: 'rgba(16,185,129,0)', duration: 1.4, clearProps: 'backgroundColor' }, 4.7)
        .to({}, { duration: 2.6 }, 5.2);
      return tl;
    },

    tr2(root, loc) {
      const bd = $(root, '[data-bd]'), from = $(root, '.is-from'), to = $(root, '.is-to');
      const vCol = $(root, '.bm-bd-viewed'), aCol = $(root, '.bm-bd-approved');
      const vN = $(vCol, '[data-n]'), vT = $(vCol, '[data-t]'), aN = $(aCol, '[data-n]'), aT = $(aCol, '[data-t]');
      const pipe = $(root, '[data-pipe]'), open = $(root, '[data-open]'), appr = $(root, '[data-appr]');
      const after = { pipe: pipe.textContent || '', open: open.textContent || '', appr: appr.textContent || '' };
      const m0 = (n: number) => money(loc, n, 0);
      let ghost: HTMLElement | null = null;
      const tl = gsap.timeline({ repeat: -1 });
      tl.call(() => {
        collapse(to);
        from.classList.add('is-live'); expand(from);
        vN.textContent = '3'; vT.textContent = m0(892340); aN.textContent = '2'; aT.textContent = m0(401380);
        pipe.textContent = pipe.dataset.was || ''; open.textContent = open.dataset.was || ''; appr.textContent = appr.dataset.was || '';
      }, [], 1.8)
        .call(() => {
          const b = bd.getBoundingClientRect(), f = from.getBoundingClientRect();
