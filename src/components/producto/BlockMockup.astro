  .bm-ed-head .c { text-align: center; }
  .bm-ed-row { padding: 8px 0; border-bottom: 1px solid rgba(10,25,47,0.07); }
  .bm-ed-name { display: flex; flex-direction: column; min-width: 0; font-size: 0.73rem; font-weight: 500; color: #0f1729; line-height: 1.3; }
  .bm-ed-name small { font-size: 0.6rem; font-weight: 500; color: #5b6472; }
  .bm-ed-list { font-size: 0.68rem; color: #5b6472; text-decoration: line-through; white-space: nowrap; }
