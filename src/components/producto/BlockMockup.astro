  const init = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-bmx]').forEach((root) => {
      const build = BUILD[root.dataset.bmx || ''];
      if (!build) return;
      const loc = root.closest<HTMLElement>('[data-loc]')?.dataset.loc || 'es-MX';
      let tl: gsap.core.Timeline | null = null;
      new IntersectionObserver(([e]) => {
