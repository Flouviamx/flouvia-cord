  .bm-cat-q { color: #0f1729; font-weight: 500; }
  .bm-cat-q:empty { display: none; }
  .bm-cat-ph { color: #b5b9c0; }
  .bm-cat { padding: 0 14px 14px; }
  .bm-cat-head, .bm-cat-row { display: grid; grid-template-columns: 60px minmax(0,1fr) 44px var(--c-price) 64px; gap: 10px; align-items: center; }
  .bm-cat-head > span { white-space: nowrap; }
  .bm-cat-head { font-size: 0.56rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: #5b6472; padding: 10px 4px 7px; border-bottom: 1px solid rgba(10,25,47,0.08); }
  .bm-cat-head .r, .bm-cat-price { text-align: right; }
  .bm-cat-row { padding: 8px 4px; border-bottom: 1px solid rgba(10,25,47,0.07); overflow: hidden; }
  .bm-cat-sku { font-size: 0.62rem; font-weight: 700; color: #5b6472; letter-spacing: 0.4px; }
  .bm-cat-name { font-size: 0.73rem; font-weight: 600; color: #0f1729; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bm-cat-unit { font-size: 0.68rem; color: #5b6472; }
  .bm-cat-price { font-size: 0.78rem; color: #0a192f; white-space: nowrap; }
  .bm-cat-st { font-size: 0.62rem; font-weight: 700; white-space: nowrap; }
  .bm-cat-st.on { color: #059669; }
  .bm-cat-st.off { color: #99a2af; }

  /* editor · resumen (capa sobre la ventana) */
  .bm-step-h { display: flex; align-items: center; gap: 8px; padding: 12px 14px 4px; }
  .bm-step-h .n { width: 20px; height: 20px; border-radius: 6px; background: #0a192f; color: #ffffff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.64rem; font-weight: 700; }
  .bm-step-h .t { font-size: 0.78rem; font-weight: 600; color: #0f1729; }
  .bm-ed-lines-b .bm-ed-head, .bm-ed-lines-b .bm-ed-row { grid-template-columns: minmax(0,1fr) 50px var(--c-list) 60px var(--c-amt); }
  .bm-ed-notes { margin: 14px 14px 18px; }
