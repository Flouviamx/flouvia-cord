  .bm-pt-b .h { font-size: 0.74rem; font-weight: 600; color: #0f1729; margin-bottom: 2px; }
  .bm-pt-b .lb { font-size: 0.64rem; font-weight: 500; color: #5b6472; }
  .bm-pt-b .hint { font-size: 0.6rem; color: #99a2af; line-height: 1.4; }
  .bm-pt-color { display: flex; align-items: center; gap: 7px; }
  .bm-pt-color .sw { width: 30px; height: 30px; flex-shrink: 0; border-radius: 8px; background: var(--acc); box-shadow: inset 0 0 0 1px rgba(10,25,47,0.12); }
  .bm-pt-color .hex { width: 96px; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .bm-pt-tg { display: flex; align-items: center; gap: 8px; font-size: 0.66rem; color: #0f1729; padding: 3px 0; }
  .bm-pt-pane { display: flex; flex-direction: column; gap: 7px; padding-top: 12px; }
  .bm-pt-ph { font-size: 0.54rem; font-weight: 800; letter-spacing: 1.1px; text-transform: uppercase; color: #99a2af; }
  .bm-pt-frame { background: #fafbfc; border: 1px solid rgba(10,25,47,0.08); border-radius: 14px; padding: 10px; }
  .bm-pt-banner { background: var(--acc); color: #ffffff; font-size: 0.58rem; font-weight: 600; text-align: center; line-height: 1.4; padding: 6px 8px; border-radius: 8px; margin-bottom: 8px; }
  .bm-pt-card { background: #ffffff; border: 1px solid rgba(10,25,47,0.08); border-radius: 11px; padding: 11px; box-shadow: 0 14px 40px -28px rgba(10,25,47,0.4); }
  .bm-pt-top { display: flex; align-items: center; gap: 8px; margin-bottom: 9px; }
  .bm-pt-top strong { display: block; font-size: 0.68rem; font-weight: 700; line-height: 1.15; }
  .bm-pt-top em { display: block; font-size: 0.56rem; color: #99a2af; }
  .bm-pt-mark { width: 26px; height: 26px; flex-shrink: 0; border-radius: 7px; background: var(--acc); color: #ffffff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.62rem; font-weight: 800; }
  .bm-pt-r { display: flex; justify-content: space-between; gap: 10px; font-size: 0.6rem; color: #0f1729; margin-bottom: 4px; }
  .bm-pt-tot { display: flex; justify-content: space-between; align-items: baseline; margin: 7px 0 9px; padding-top: 6px; border-top: 1.5px solid var(--acc); font-size: 0.6rem; color: #5b6472; }
  .bm-pt-tot .editorial { font-size: 0.84rem; color: var(--acc) !important; }
  .bm-pt-cta { display: block; text-align: center; font-size: 0.64rem; font-weight: 600; color: #ffffff; background: var(--acc); border-radius: 8px; padding: 7px; }
  .bm-pt-chat { display: block; margin-top: 7px; font-size: 0.58rem; color: #99a2af; background: #fafbfc; border: 1px solid rgba(10,25,47,0.08); border-radius: 7px; padding: 6px 8px; }
  .bm-pt-pw { text-align: center; font-size: 0.56rem; color: #99a2af; margin-top: 8px; overflow: hidden; }
  .bm-pt-pw strong { color: #5b6472; }
  .bm-pt-pw[hidden] { display: none; }

  /* detalle de cotización */
  .bm-dt { padding: 12px 16px 16px; }
