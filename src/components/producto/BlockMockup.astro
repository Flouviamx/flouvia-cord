---
import { getLangFromUrl } from '../../i18n/utils';
import { WORKFLOW_TRIGGERS, TRIGGER_CATEGORIES, WORKFLOW_ACTIONS, ACTION_GROUPS } from '../../lib/workflows/catalog';
import { WORKFLOW_ICONS as WFI, BRAND_LOGOS, BRAND_TILES } from '../../lib/workflows/icons';
const { slug, index } = Astro.props;
const en = getLangFromUrl(Astro.url) === 'en';
const slackLogo = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://slack.com&size=64';
const hubspotLogo = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://hubspot.com&size=64';
const teamsLogo = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://teams.microsoft.com&size=64';
const PF = ['pagos', 'cobranza-ia', 'divisas', 'clientes-credito', 'finanzas'].includes(slug);
const FO = ['facturacion', 'workflows', 'equipo'].includes(slug);
const CALCA = ['editor', 'link-publico', 'seguimiento', 'aprobaciones'].includes(slug) || PF || FO;
const LOC = en ? 'en-US' : 'es-MX';
const mx = (n: number, d = 2) => new Intl.NumberFormat(LOC, { style: 'currency', currency: 'MXN', minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
const tx = (es: string, e: string) => (en ? e : es);
const nf = (n: number, d = 2) => new Intl.NumberFormat(LOC, { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
const cur = (c: string, n: number, d = 2) => `${c === 'USD' ? 'US$' : c} ${nf(n, d)}`;
const mxs = en ? 'MX$' : '$';
const mpLogo = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://mercadopago.com.mx&size=64';
const wrapClass = `bm-wrap bm-${slug}-${index}${CALCA ? ` bm-x${index === 2 ? ' bm-x-full' : ''}` : ''}${PF || FO ? ' bm-pf' : ''}${FO ? ' bm-fo' : ''}`;
const LG = en ? 'en' : 'es';
const trigCat = (k: string) => TRIGGER_CATEGORIES.find((c) => c.key === k)!.label[LG];
const WF_LISTS = [
  { key: 'all', items: WORKFLOW_TRIGGERS.slice(0, 9) },
  { key: 'payments', items: WORKFLOW_TRIGGERS.filter((t) => t.category === 'payments') },
  { key: 'q', items: WORKFLOW_TRIGGERS.filter((t) => t.label[LG].toLowerCase().includes(en ? 'due' : 'venc')) },
];
const WF_STEPS = WORKFLOW_ACTIONS.map((a) => ({ ...a, groupLabel: ACTION_GROUPS.find((g) => g.key === a.group)!.label[LG] }));
const wfIcon = (key: string, brand?: string) => (brand && brand !== 'cord' && BRAND_LOGOS[brand]
  ? `<img class="${BRAND_TILES.has(brand as any) ? 'tile' : ''}" src="${BRAND_LOGOS[brand]}" alt="" width="20" height="20" loading="lazy" />`
  : WFI[key] ?? WFI.action);
const round2 = (n: number) => Math.round(n * 100) / 100;
const FA_DOCS = [
  { cc: 'US', loc: 'en-US', cur: 'USD', from: 'Materiales del Valle USA LLC', fromId: 'EIN / Tax ID: 88-4172093', fromAddr: 'Laredo, TX 78041', to: 'Ridgeline Builders LLC', toId: 'EIN / Tax ID: 47-2918305', toAddr: 'San Antonio, TX 78205', num: 'INV-000214', terms: 'Net 30', tax: 'Sales tax', rate: 6.25,
    lines: [['Portland cement, 94 lb bag', 120, 16.4], ['Rebar #3, 20 ft', 340, 9.85], ['Concrete block 8×8×16', 2400, 2.35]] },
  { cc: 'GB', loc: 'en-GB', cur: 'GBP', from: 'Harlow Building Supplies Ltd', fromId: 'UTR / VAT number: GB 284 1937 06', fromAddr: 'Leeds LS11 5QT', to: 'Kestrel Construction Ltd', toId: 'UTR / VAT number: GB 519 2046 83', toAddr: 'Manchester M4 6WX', num: 'INV-000087', terms: 'Net 30', tax: 'VAT', rate: 20,
    lines: [['Portland cement 25 kg', 200, 7.95], ['Rebar 10 mm × 6 m', 150, 11.2], ['Concrete block 440×215×100', 1500, 1.62]] },
  { cc: 'FR', loc: 'fr-FR', cur: 'EUR', from: 'Matériaux Rhône SAS', fromId: 'SIREN / VAT ID: FR 41 832594017', fromAddr: '69007 Lyon', to: 'Bâtiments Vercors SARL', toId: 'SIREN / VAT ID: FR 73 519204318', toAddr: '38000 Grenoble', num: 'INV-000132', terms: 'Net 30', tax: 'TVA', rate: 20,
    lines: [['Ciment gris 35 kg', 180, 9.4], ['Fer à béton HA10, 6 m', 220, 12.8], ['Parpaing creux 20×20×50', 1200, 1.95]] },
  { cc: 'PE', loc: 'es-PE', cur: 'PEN', from: 'Ferretera Andina S.A.C.', fromId: 'RUC: 20548712396', fromAddr: 'Lima 15074', to: 'Constructora Pachacámac S.A.', toId: 'RUC: 20601938475', toAddr: 'Arequipa 04001', num: 'INV-000051', terms: '30 días', tax: 'IGV', rate: 18,
    lines: [['Cemento Portland tipo I, 42.5 kg', 300, 31.5], ['Fierro corrugado 1/2" × 9 m', 250, 47.9], ['Ladrillo King Kong 18 huecos', 4000, 1.25]] },
].map((d) => {
  const es = d.loc.startsWith('es');
  const n = new Intl.NumberFormat(d.loc, { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: 'always' as any });
  const q = new Intl.NumberFormat(d.loc, { maximumFractionDigits: 3, useGrouping: 'always' as any });
  const sub = round2(d.lines.reduce((s, l) => s + (l[1] as number) * (l[2] as number), 0));
  const taxAmt = round2((sub * d.rate) / 100);
  const date = new Intl.DateTimeFormat(d.loc, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(Date.UTC(2026, 8, 18));
  const due = new Intl.DateTimeFormat(d.loc, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(Date.UTC(2026, 9, 18));
  const t = (a: string, b: string) => (es ? a : b);
  return {
    ...d, date, due, t, rateTxt: `${d.rate}%`,
    rows: d.lines.map((l) => ({ d: l[0] as string, q: q.format(l[1] as number), p: n.format(l[2] as number), a: n.format(round2((l[1] as number) * (l[2] as number))) })),
    sub: n.format(sub), base: n.format(sub), taxAmt: n.format(taxAmt), total: n.format(round2(sub + taxAmt)),
    foot: t('Documento comercial emitido por Cord. No representa por sí solo una transmisión, autorización o timbrado ante la autoridad fiscal local.',
      'Commercial document issued by Cord. It does not by itself represent submission, clearance, or stamping by the local tax authority.'),
  };
});
const chev = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>';
const qr = (() => {
  const N = 25; let seed = 48271; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const inF = (x: number, y: number) => (x < 8 && y < 8) || (x > N - 9 && y < 8) || (x < 8 && y > N - 9);
  let o = '';
  for (const [fx, fy] of [[0, 0], [N - 7, 0], [0, N - 7]]) o += `<path d="M${fx} ${fy}h7v7h-7zM${fx + 1} ${fy + 1}v5h5v-5z" fill-rule="evenodd"/><rect x="${fx + 2}" y="${fy + 2}" width="3" height="3"/>`;
  for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) if (!inF(x, y) && rnd() > 0.52) o += `<rect x="${x}" y="${y}" width="1" height="1"/>`;
  return `<svg viewBox="0 0 ${N} ${N}" shape-rendering="crispEdges" fill="currentColor">${o}</svg>`;
})();
const chk = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
import { iconInner } from '../../lib/icons';
