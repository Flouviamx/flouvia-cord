  .bm-qc-ck { display: flex; gap: 7px; align-items: flex-start; font-size: 0.56rem; line-height: 1.45; color: #6b7280; }
  .bm-qc-ck .bx { flex-shrink: 0; width: 13px; height: 13px; margin-top: 1px; border-radius: 4px; background: #0a192f; color: #ffffff; display: inline-flex; align-items: center; justify-content: center; }
  .bm-qc-ck .bx svg { width: 9px; height: 9px; }
  .bm-qc-ck .bx.off { background: #ffffff; color: transparent; box-shadow: inset 0 0 0 1.5px rgba(10,25,47,0.25); }
  .bm-qc-cta { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 0.74rem; font-weight: 600; color: #ffffff; background: #b45309; border-radius: 11px; padding: 10px 12px; box-shadow: 0 10px 22px -10px rgba(180,83,9,0.55); transition: opacity 0.3s, box-shadow 0.3s; }
  .bm-qc-cta svg { width: 12px; height: 12px; }
  .bm-qc-cta.is-off { opacity: 0.45; box-shadow: none; }
  .bm-qc-done { position: absolute; left: 0; right: 0; top: 60px; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 6px; padding: 26px 16px 18px; text-align: center; background: #ffffff; border-radius: 0 0 20px 20px; opacity: 0; visibility: hidden; }
  .bm-qc-done .ring { width: 46px; height: 46px; color: #b45309; }
  .bm-qc-done .ring svg { width: 100%; height: 100%; }
  .bm-qc-done .tt { font-size: 0.84rem; font-weight: 700; color: #111111; }
  .bm-qc-done .st { font-size: 0.58rem; line-height: 1.5; color: #6b7280; }

  /* link público · portal */
  .bm-set-tabs { display: flex; margin: 10px 14px 0; }
  .bm-set-tabs, .bm-tabs { width: max-content; max-width: calc(100% - 28px); overflow: hidden; }
  .bm-set-tabs { gap: 2px; padding: 2px; border-radius: 10px; background: rgba(10,25,47,0.065); }
  .bm-set-tabs > span { font-size: 0.66rem; font-weight: 600; color: #5b6472; padding: 4px 9px; border-radius: 8px; white-space: nowrap; }
  .bm-set-tabs > span.on { color: #0f1729; background: #ffffff; box-shadow: 0 1px 2px rgba(10,25,47,0.13); }
  .bm-pt { --acc: #b45309; display: grid; grid-template-columns: minmax(0,1fr) 250px; gap: 18px; padding: 4px 14px 18px; }
  .bm-pt-form { display: flex; flex-direction: column; min-width: 0; }
  .bm-pt-b { display: flex; flex-direction: column; gap: 5px; padding: 12px 0; border-bottom: 1px solid rgba(10,25,47,0.07); }
