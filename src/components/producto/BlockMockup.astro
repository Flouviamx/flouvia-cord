  .bm-ed-notes .h em { font-weight: 400; color: #5b6472; font-size: 0.66rem; }
  .bm-ed-notes .bm-field { display: block; white-space: normal; line-height: 1.45; padding: 8px 10px 18px; color: #0f1729; }
  .bm-sum { background: #ffffff; border-radius: 18px; border: 1px solid rgba(10,25,47,0.08); padding: 17px 17px 20px; display: flex; flex-direction: column; gap: 8px; color: #0f1729; font-size: 0.74rem; box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 28px 56px -18px rgba(10,25,47,0.22), 0 70px 120px -50px rgba(10,25,47,0.28); }
  .bm-sum-h { font-size: 0.86rem; font-weight: 700; letter-spacing: -0.02em; }
  .bm-sum-count { font-size: 0.68rem; color: #5b6472; margin: -3px 0 3px; }
  .bm-sum-l { display: flex; justify-content: space-between; gap: 10px; font-size: 0.74rem; color: #5b6472; }
  .bm-sum-l .editorial { color: #0f1729 !important; font-size: 0.82rem; border-radius: 5px; padding: 0 4px; margin-right: -4px; }
  .bm-sum-l.save, .bm-sum-l.save .editorial { color: #059669 !important; }
  .bm-sum-l.tax { font-size: 0.7rem; padding-left: 8px; }
  .bm-sum-l.tax .editorial { font-size: 0.76rem; }
  .bm-sum-tg { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 0.72rem; color: #0f1729; margin-top: 3px; }
  .bm-sum-div { height: 1px; background: rgba(10,25,47,0.08); margin: 4px 0; }
  .bm-sum-l.total { font-weight: 700; color: #0f1729; align-items: baseline; }
  .bm-sum-l.total .editorial { font-size: 1.36rem; letter-spacing: -0.03em !important; }
  .bm-sum-f { display: flex; flex-direction: column; gap: 5px; margin-top: 4px; }
  .bm-sum-f .lb { font-size: 0.64rem; font-weight: 500; color: #5b6472; }
  .bm-sum-f .bm-field { padding: 7px 10px; }
  .bm-sum-send { margin-top: 6px; display: flex; align-items: center; justify-content: center; gap: 7px; font-size: 0.76rem; font-weight: 600; color: #ffffff; background: #0a192f; border-radius: 999px; padding: 10px 16px; box-shadow: 0 4px 14px -4px rgba(10,25,47,0.4); }
  .bm-sum-send svg { width: 14px; height: 14px; }
  .bm-flash { animation: bm-flash 0.9s ease; }
  @keyframes bm-flash { 0% { background: rgba(16,185,129,0.16); } 100% { background: transparent; } }

  /* composición de tarjeta ancha */
  .bm-wrap.bm-x-full { padding: 0 !important; }
  .bm-x-full .bm-stage { position: absolute !important; inset: 0; }
  .bm-x-full [data-bmx="ed2"] .bm-ed2-back { position: absolute; left: 30px; top: 40px; width: 440px; }
  .bm-x-full [data-bmx="ed2"] .bm-sum { position: absolute; right: 30px; top: 22px; width: 276px; z-index: 3; }
  .bm-x-full .bm-x-main { position: absolute; left: 34px; top: 36px; right: -40px; width: auto; }
  .bm-x-full [data-bmx="lp2"] .bm-x-main { right: 110px; }
  .bm-x-full [data-bmx="ap2"] .bm-x-main { right: 34px; }

  /* link público · teléfono */
  .bm-x .bm-x-free.bm-app { background: none !important; border: 0 !important; box-shadow: none !important; overflow: visible !important; border-radius: 0 !important; display: flex; justify-content: center; }
  .bm-phone { position: relative; width: 262px; padding: 9px; border-radius: 48px; background: #1b1d21; box-shadow: inset 0 0 0 1.5px #3b3e44, inset 0 0 0 3px #111214, 0 2px 4px rgba(10,25,47,0.12), 0 30px 60px -22px rgba(10,25,47,0.38), 0 70px 110px -50px rgba(10,25,47,0.34); }
  .bm-phone::before { content: ''; position: absolute; right: -2px; top: 118px; width: 3px; height: 62px; border-radius: 0 3px 3px 0; background: #2a2d32; }
  .bm-phone::after { content: ''; position: absolute; left: -2px; top: 96px; width: 3px; height: 34px; border-radius: 3px 0 0 3px; background: #2a2d32; box-shadow: 0 46px 0 #2a2d32; }
  .bm-phone-scr { position: relative; min-height: 480px; border-radius: 39px; overflow: hidden; background: #f3f2ef; }
  .bm-ios { position: relative; display: flex; align-items: center; justify-content: space-between; height: 40px; padding: 4px 22px 0 26px; color: #0f1729; }
  .bm-ios .t { font-size: 0.7rem; font-weight: 700; letter-spacing: -0.01em; }
  .bm-ios .isl { position: absolute; top: 9px; left: 50%; transform: translateX(-50%); width: 78px; height: 22px; border-radius: 100px; background: #000000; }
  .bm-ios .ic { display: inline-flex; align-items: center; gap: 4px; }
  .bm-ios .ic svg { height: 10px; width: auto; }
  .bm-qp { padding: 2px 8px 24px; }
  .bm-qc { position: relative; display: flex; flex-direction: column; gap: 12px; background: #ffffff; border-radius: 20px; padding: 15px 14px 16px; box-shadow: 0 0 0 1px rgba(10,25,47,0.06), 0 4px 6px rgba(10,25,47,0.03), 0 20px 60px -20px rgba(10,25,47,0.12); }
  .bm-qc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .bm-qc-brand { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .bm-qc-mark { width: 30px; height: 30px; flex-shrink: 0; border-radius: 9px; background: #b45309; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 800; }
  .bm-qc-bt .n { display: block; font-size: 0.7rem; font-weight: 700; color: #111111; letter-spacing: -0.2px; white-space: nowrap; }
  .bm-qc-bt .r { display: block; font-size: 0.5rem; font-weight: 500; color: #9ca3af; }
  .bm-qc-folio { text-align: right; flex-shrink: 0; }
  .bm-qc-folio .e { display: block; font-size: 0.4rem; font-weight: 800; letter-spacing: 1.6px; color: #c9cdd3; }
  .bm-qc-folio .f { display: block; font-size: 0.64rem; font-weight: 800; color: #111111; }
  .bm-qc-rule { height: 1px; margin: -3px 0; background: linear-gradient(to right, transparent, rgba(10,25,47,0.08) 15%, rgba(10,25,47,0.08) 85%, transparent); }
  .bm-qc-sign { display: flex; flex-direction: column; gap: 9px; }
  .bm-qc-sh { display: flex; align-items: center; gap: 7px; font-size: 0.72rem; font-weight: 700; color: #111111; }
  .bm-qc-sh .bk { width: 20px; height: 20px; border-radius: 50%; border: 1px solid rgba(10,25,47,0.1); display: inline-flex; align-items: center; justify-content: center; color: #9ca3af; }
  .bm-qc-sh .bk svg { width: 11px; height: 11px; }
  .bm-qc-pill { background: #fafafa; border: 1px solid rgba(10,25,47,0.055); border-radius: 10px; padding: 8px 10px; font-size: 0.6rem; line-height: 1.5; color: #6b7280; }
  .bm-qc-pill strong { color: #111111; font-weight: 700; }
  .bm-qc-pill strong.acc { color: #b45309; }
  .bm-qc-f { display: flex; flex-direction: column; gap: 4px; }
  .bm-qc-f .lb { font-size: 0.56rem; font-weight: 600; color: #6b7280; }
  .bm-qc-f .in { display: flex; align-items: center; min-height: 30px; padding: 6px 9px; font-size: 0.7rem; color: #111111; background: #ffffff; border: 1.5px solid rgba(10,25,47,0.35); border-radius: 9px; box-shadow: 0 0 0 3px rgba(10,25,47,0.05); }
  .bm-qc-f .in .bm-caret { display: inline-block; }
  .bm-qc-f .in .ph { display: none; color: #b0b5bd; }
