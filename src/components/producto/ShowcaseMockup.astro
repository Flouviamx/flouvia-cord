---
// ShowcaseMockup — el mockup GRANDE (hero de la sección) que vive dentro de cada
// .shw-panel de FeatureShowcase.astro. 36 escenas (12 features × 3 tabs).
// Contrato: recibe { slug, index } y llena por completo su contenedor (inset:0).
// Solo markup + CSS estático; el crossfade/autoplay lo maneja el padre.
import { getLangFromUrl } from '../../i18n/utils';
const { slug, index } = Astro.props as { slug: string; index: number };
const en = getLangFromUrl(Astro.url) === 'en';
const CALCA = ['editor', 'link-publico', 'seguimiento', 'aprobaciones', 'pagos', 'cobranza-ia', 'divisas', 'clientes-credito', 'finanzas'].includes(slug);
const LOC = en ? 'en-US' : 'es-MX';
const mx = (n: number, d = 2) => new Intl.NumberFormat(LOC, { style: 'currency', currency: 'MXN', minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
const tx = (es: string, e: string) => (en ? e : es);
const nf = (n: number, d = 2) => new Intl.NumberFormat(LOC, { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
const cm = (n: number, c = 'MXN', d = 2) => `${c === 'USD' ? 'US$' : c} ${nf(n, d)}`;
const BRW_NAV = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>';
const BRW_LOCK = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2" fill="currentColor" fill-opacity="0.14"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>';
const BRW_SHARE = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><polyline points="8 7 12 3 16 7"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg>';
const IOS_IC = '<svg width="13.5" height="9" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="7" width="3" height="5" rx="0.7"/><rect x="5" y="5" width="3" height="7" rx="0.7"/><rect x="10" y="2.5" width="3" height="9.5" rx="0.7"/><rect x="15" y="0" width="3" height="12" rx="0.7"/></svg><svg width="12.9" height="9" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1.5 5.2a12.5 12.5 0 0 1 17 0M4.6 8.4a8 8 0 0 1 10.8 0M7.8 11.5a3.2 3.2 0 0 1 4.4 0"/></svg><svg width="18.7" height="9" viewBox="0 0 27 13" fill="none"><rect x="0.6" y="0.6" width="22.8" height="11.8" rx="3.4" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.2"/><rect x="2.4" y="2.4" width="14" height="8.2" rx="2" fill="currentColor"/><path d="M25 4.4v4.2c.8-.3 1.4-1.1 1.4-2.1s-.6-1.8-1.4-2.1z" fill="currentColor" fill-opacity="0.45"/></svg>';
const WA_PATH = 'M17.5 14.4c-.3-.15-1.7-.85-2-.95-.26-.1-.46-.15-.65.15-.2.3-.74.94-.9 1.13-.17.2-.34.22-.63.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.46.13-.6.13-.14.3-.34.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.65-1.57-.9-2.15-.24-.56-.48-.48-.65-.49h-.56c-.2 0-.5.07-.77.37-.26.3-1 .98-1 2.4 0 1.4 1.03 2.76 1.17 2.96.14.2 2.02 3.08 4.9 4.32.68.3 1.22.47 1.64.6.69.22 1.31.19 1.8.12.55-.08 1.7-.7 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.2-.56-.34zM12 2a10 10 0 0 0-8.6 15.06L2 22l5.06-1.33A10 10 0 1 0 12 2z';
const SNAP = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="3" fill="currentColor" fill-opacity="0.12"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>';
const HOY = tx('Al día de hoy · 24 de septiembre de 2026', 'As of today · September 24, 2026');
const chk = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const ICON: Record<string, string> = {
  dashboard: '<rect x="3" y="3" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="14" y="14" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  cotizaciones: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8" stroke-opacity="0.5"/><line x1="16" y1="13" x2="8" y2="13" stroke-opacity="0.5"/><line x1="16" y1="17" x2="8" y2="17" stroke-opacity="0.5"/><polyline points="10 9 9 9 8 9" stroke-opacity="0.5"/>',
  clientes: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4" fill="currentColor" fill-opacity="0.25" stroke="none"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87" stroke-opacity="0.5"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke-opacity="0.5"/>',
  productos: '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m7.5 4.27 9 5.15" stroke-opacity="0.5"/><path d="m3.3 7 8.7 5 8.7-5" stroke-opacity="0.5"/><path d="M12 22V12" stroke-opacity="0.5"/>',
  facturas: '<path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><polyline points="15 2 15 7 20 7" stroke-opacity="0.5"/><path d="M9 13h6" stroke-opacity="0.55"/><path d="M9 17h4" stroke-opacity="0.55"/>',
  cobros: '<circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.1" stroke="none"/><path d="M12 2v20" stroke-opacity="0.5"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  cobranza: '<rect width="20" height="14" x="2" y="5" rx="2" fill="currentColor" fill-opacity="0.15" stroke="none"/><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10" stroke-opacity="0.5"/>',
  informes: '<rect x="3" y="3" width="18" height="18" rx="4" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M7 16l3-3 2.5 2.5L17 10"/><path d="M15 10h2v2" stroke-opacity="0.55"/><path d="M7 7h5" stroke-opacity="0.45"/>',
  desempeno: '<circle cx="9" cy="8" r="3.4" fill="currentColor" fill-opacity="0.15"/><path d="M2.8 20.2a6.2 6.2 0 0 1 12.4 0" stroke-opacity="0.8"/><circle cx="17.2" cy="9.4" r="2.4" fill="currentColor" fill-opacity="0.15" stroke-opacity="0.75"/><path d="M16 14.1a5 5 0 0 1 5.2 4.8" stroke-opacity="0.55"/>',
  workflows: '<rect x="8.25" y="2.5" width="7.5" height="6" rx="2.2" fill="currentColor" fill-opacity="0.15"/><path d="M12 8.5v3.2M5.4 15.5v-1.6a2.2 2.2 0 0 1 2.2-2.2h8.8a2.2 2.2 0 0 1 2.2 2.2v1.6" stroke-opacity="0.7"/><rect x="2.5" y="15.5" width="5.8" height="6" rx="2" fill="currentColor" fill-opacity="0.15" stroke-opacity="0.8"/><rect x="15.7" y="15.5" width="5.8" height="6" rx="2" fill="currentColor" fill-opacity="0.15" stroke-opacity="0.8"/>',
};
const NAV = [
  { k: 'dashboard', l: tx('Inicio', 'Home') },
  { k: 'cotizaciones', l: tx('Cotizaciones', 'Quotes'), b: '3' },
  { k: 'clientes', l: tx('Clientes', 'Clients') },
  { k: 'productos', l: tx('Productos', 'Products') },
  { g: tx('Mi dinero', 'My money') },
  { k: 'facturas', l: tx('Facturas', 'Invoices') },
  { k: 'cobros', l: tx('Cobros', 'Payments') },
  { k: 'cobranza', l: tx('Cobranza', 'Collections') },
  { g: tx('Inteligencia', 'Intelligence') },
  { k: 'informes', l: tx('Informes', 'Reports') },
  { k: 'desempeno', l: tx('Equipo', 'Team') },
  { k: 'workflows', l: 'Workflows' },
];
---
<div class={`shwm-wrap shwm-${slug}-${index}${CALCA ? ' shwm-x' : ''}`} data-loc={CALCA ? LOC : undefined}>

  {/* ═══════════════════════════════ EDITOR ═══════════════════════════════ */}
  {slug === 'editor' && index === 0 && (
    <div class="shwm-frame shwm-scene" data-shx="ed0">
      <div class="shwm-sheet" aria-hidden="true">
        <div class="shwm-sheet-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2.5" fill="currentColor" fill-opacity="0.14"/><path d="M3 9h18M9 3v18M3 15h18"/></svg>
          <span>cotizacion_final_v7_REVISADA.xlsx</span>
          <em>{tx('Editado hace 47 min', 'Edited 47 min ago')}</em>
        </div>
        <div class="shwm-sheet-fx"><span class="ref">D9</span><span class="fx">fx</span><span class="f">{tx('=SUMA(D2:D7)*1.16', '=SUM(D2:D7)*1.16')}</span></div>
        <div class="shwm-sheet-grid">
          <div class="r h"><span></span><span>A</span><span>B</span><span>C</span><span>D</span></div>
          <div class="r"><span class="n">1</span><span class="b">{tx('Concepto', 'Item')}</span><span class="b">{tx('Cant', 'Qty')}</span><span class="b">{tx('Precio', 'Price')}</span><span class="b">{tx('Importe', 'Amount')}</span></div>
          <div class="r"><span class="n">2</span><span>{tx('Cemento gris', 'Gray cement')}</span><span class="num">120</span><span class="num">182</span><span class="num">21840</span></div>
          <div class="r"><span class="n">3</span><span>{tx('Varilla 3/8', 'Rebar 3/8')}</span><span class="num">340</span><span class="num hl">191.48</span><span class="num">65103.2</span></div>
          <div class="r"><span class="n">4</span><span>{tx('Block hueco', 'Hollow block')}</span><span class="num">2400</span><span class="num err">{tx('#¡VALOR!', '#VALUE!')}</span><span class="num err">{tx('#¡VALOR!', '#VALUE!')}</span></div>
          <div class="r"><span class="n">5</span><span>{tx('Malla 6x6', 'Mesh 6x6')}</span><span class="num">180</span><span class="num">312</span><span class="num">56160</span></div>
          <div class="r"><span class="n">6</span><span>{tx('Arena río', 'River sand')}</span><span class="num">60</span><span class="num">540</span><span class="num err">{tx('#¡REF!', '#REF!')}</span></div>
          <div class="r"><span class="n">7</span><span></span><span></span><span></span><span></span></div>
          <div class="r"><span class="n">8</span><span class="b">Subtotal</span><span></span><span></span><span class="num err">{tx('#¡REF!', '#REF!')}</span></div>
          <div class="r sel"><span class="n">9</span><span class="b">{'IVA 16%'}</span><span></span><span></span><span class="num err cur">{tx('#¡REF!', '#REF!')}</span></div>
          <div class="r"><span class="n">10</span><span class="b">TOTAL</span><span></span><span></span><span class="num err">{tx('#¡REF!', '#REF!')}</span></div>
          <div class="r"><span class="n">11</span><span></span><span></span><span></span><span></span></div>
        </div>
        <div class="shwm-sheet-tabs"><span>cotiz_v6</span><span>cotiz_v7</span><span class="on">cotiz_v7_final</span></div>
      </div>
      <div class="shwm-cw shwm-ed0-win">
        <div class="shwm-cw-bar">
          <span class="shwm-cw-crumbs"><span>{tx('Cotizaciones', 'Quotes')}</span><span class="sep">/</span><strong>{tx('Nueva cotización', 'New quote')}</strong></span>
          <span class="shwm-cw-draft">{tx('Borrador', 'Draft')}</span>
        </div>
        <div class="shwm-edg">
          <div class="shwm-edg-main">
            <div class="shwm-ai">
              <span class="t">{tx('Arma la cotización con IA', 'Build the quote with AI')}</span>
              <span class="s">{tx('Pega el pedido del cliente o adjunta la foto/PDF de su orden de compra.', "Paste the client's order or attach a photo/PDF of their purchase order.")}</span>
              <span class="ta">{tx('Buen día, me cotizas 120 sacos de cemento gris, 340 varillas de 3/8, 2,400 block de 15 y 180 hojas de malla 6x6. Entrega en obra.', 'Morning, can you quote 120 bags of gray cement, 340 rebars 3/8, 2,400 15 cm blocks and 180 sheets of 6x6 mesh? Delivery to site.')}</span>
              <span class="ac"><span class="btn" data-aibtn data-busy={tx('Armando…', 'Building…')}>{tx('Armar cotización con IA', 'Build quote with AI')}</span><span class="st" data-aist><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{tx('4 líneas armadas. Revisa cantidades y precios.', '4 lines built. Check quantities and prices.')}</span></span>
            </div>
            <div class="shwm-lines shwm-lines-5">
              <div class="shwm-lh"><span>{tx('Producto', 'Product')}</span><span>{tx('Cant.', 'Qty.')}</span><span>{tx('Lista', 'List')}</span><span>{tx('Negociado', 'Negotiated')}</span><span class="r">{tx('Importe', 'Amount')}</span></div>
              <div class="shwm-lr" data-line><span class="nm">{tx('Cemento gris 50 kg', 'Gray cement 50 kg')}<small>{tx('saco', 'bag')}</small></span><span class="shwm-inp">120</span><span class="ls">{mx(182)}</span><span class="shwm-inp">182.00</span><span class="editorial am">{mx(21840)}</span></div>
              <div class="shwm-lr" data-line><span class="nm">{tx('Varilla corrugada 3/8" × 12 m', 'Rebar 3/8" × 12 m')}<small>{tx('pieza', 'piece')}</small></span><span class="shwm-inp">340</span><span class="ls">{mx(191.48)}</span><span class="shwm-inp">191.48</span><span class="editorial am">{mx(65103.2)}</span></div>
              <div class="shwm-lr" data-line><span class="nm">{tx('Block hueco 15×20×40', 'Hollow block 15×20×40')}<small>{tx('pieza', 'piece')}</small></span><span class="shwm-inp">2400</span><span class="ls">{mx(14.2)}</span><span class="shwm-inp">14.20</span><span class="editorial am">{mx(34080)}</span></div>
              <div class="shwm-lr" data-line><span class="nm">{tx('Malla electrosoldada 6×6', 'Welded wire mesh 6×6')}<small>{tx('hoja', 'sheet')}</small></span><span class="shwm-inp">180</span><span class="ls">{mx(312)}</span><span class="shwm-inp">312.00</span><span class="editorial am">{mx(56160)}</span></div>
            </div>
          </div>
          <div class="shwm-sum shwm-sum-flat" data-empty={tx('Agrega productos para ver el total', 'Add products to see the total')}>
            <span class="h">{tx('Revisa y envía', 'Review and send')}</span>
            <span class="c" data-count data-full={`4 ${tx('líneas', 'lines')} · 3,040 ${tx('piezas', 'pieces')}`}>4 {tx('líneas', 'lines')} · 3,040 {tx('piezas', 'pieces')}</span>
            <span class="l"><span>Subtotal</span><span class="editorial" data-v="177183.2">{mx(177183.2)}</span></span>
            <span class="l tax"><span>{'IVA 16%'}</span><span class="editorial" data-v="28349.31">{mx(28349.31)}</span></span>
            <span class="dv"></span>
            <span class="l total"><span>Total</span><span class="editorial" data-v="205532.51">{mx(205532.51)}</span></span>
            <span class="f"><span class="lb">{tx('Vigencia', 'Valid for')}</span><span class="shwm-fd">30 {tx('días', 'days')}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span></span>
            <span class="send">{tx('Crear y enviar', 'Create and send')}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </div>
        </div>
      </div>
    </div>
  )}

  {slug === 'editor' && index === 1 && (
    <div class="shwm-frame shwm-scene" data-shx="ed1" data-lines={tx('líneas', 'lines')} data-pcs={tx('piezas', 'pieces')}>
      <div class="shwm-brw">
        <div class="shwm-brw-top">
          <span class="nav"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
          <span class="url"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2" fill="currentColor" fill-opacity="0.14"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>cordhq.app/app/cotizaciones/nueva</span>
          <span class="act"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><polyline points="8 7 12 3 16 7"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg></span>
        </div>
        <div class="shwm-as">
          <aside class="shwm-as-side">
            <div class="shwm-as-org"><span class="av">M</span><strong>Materiales del Valle</strong><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"/><polyline points="7 9 12 4 17 9"/></svg></div>
            <nav class="shwm-as-nav">
              {NAV.map((n) => n.g ? <span class="shwm-as-g">{n.g}</span> : <span class={`shwm-as-i${n.k === 'cotizaciones' ? ' on' : ''}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICON[n.k as string]}></svg>{n.l}{n.b && <em>{n.b}</em>}</span>)}
            </nav>
          </aside>
          <div class="shwm-as-main">
            <div class="shwm-as-head">
              <span class="tt"><span class="cr">{tx('Cotizaciones', 'Quotes')} <span class="sep">/</span></span><strong>{tx('Nueva cotización', 'New quote')}</strong></span>
              <span class="shwm-cw-draft">{tx('Borrador', 'Draft')}</span>
            </div>
            <div class="shwm-edg shwm-edg-wide">
              <div class="shwm-edg-main">
                <div class="shwm-steph"><span class="n">1</span><span class="t">{tx('¿A quién le cotizas?', 'Who are you quoting?')}</span></div>
                <div class="shwm-client"><span class="shwm-fd grow"><span>Distribuidora El Zarco — Raúl Mendoza</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span><span class="shwm-chips"><span>{tx('Contado', 'Cash')}</span><span class="on">Net 30</span><span>Net 60</span></span></div>
                <div class="shwm-steph"><span class="n">2</span><span class="t">{tx('¿Qué le vas a cotizar?', 'What are you quoting them?')}</span></div>
                <div class="shwm-lines shwm-lines-6">
                  <div class="shwm-lh"><span>{tx('Producto', 'Product')}</span><span>{tx('Cant.', 'Qty.')}</span><span>{tx('Lista', 'List')}</span><span>{tx('Negociado', 'Negotiated')}</span><span class="r">{tx('Importe', 'Amount')}</span><span class="c">{tx('Margen', 'Margin')}</span></div>
