  /* ── App window (blanca, sombra en capas — el "screenshot" real) ── */
  .shwm-app {
    width: 100%;
    max-width: 720px;
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid rgba(10,25,47,0.07);
    box-shadow:
      0 2px 4px rgba(10,25,47,0.04),
      0 30px 60px -18px rgba(10,25,47,0.16),
      0 60px 110px -40px rgba(10,25,47,0.18),
      inset 0 1px 0 rgba(255,255,255,0.7);
    overflow: hidden;
    color: #0f172a;
  }
  .shwm-app-narrow { max-width: 520px; }

  /* ── Toolbar real (título izq · badge der) — NUNCA 3 puntos macOS ── */
  .shwm-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 15px 20px;
    border-bottom: 1px solid rgba(10,25,47,0.06);
    background: #fcfdfe;
  }
  .shwm-bar-t { font-size: 0.9rem; font-weight: 600; color: #0f172a; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .shwm-badge {
    flex-shrink: 0; font-size: 0.64rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase;
    padding: 5px 11px; border-radius: 100px;
    color: #64748b; background: rgba(10,25,47,0.05); border: 1px solid rgba(10,25,47,0.09);
    white-space: nowrap;
  }
  .shwm-badge-blue { color: #2563eb; background: rgba(37,99,235,0.09); border-color: rgba(37,99,235,0.2); }
  .shwm-badge-green { color: #059669; background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.22); }
  .shwm-badge-amber { color: #d97706; background: rgba(245,158,11,0.11); border-color: rgba(245,158,11,0.25); }
  
  .shwm-badge-gray { color: #64748b; background: rgba(10,25,47,0.05); border-color: rgba(10,25,47,0.1); }

  /* ── Body & footer ── */
  .shwm-body { padding: 10px 12px 12px; }
  
  .shwm-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 15px 20px; border-top: 1px solid rgba(10,25,47,0.06);
    background: #fcfdfe; font-size: 0.8rem; color: #94a3b8;
  }
  .shwm-foot b { color: #0f172a; font-weight: 700; }

  @keyframes shwm-caret-blink { 50% { opacity: 0; } }

  /* ── Grid rows (tablas densas) ── */
  .shwm-g { display: grid; align-items: center; gap: 14px; padding: 12px 14px; font-size: 0.85rem; color: #475569; border-bottom: 1px solid rgba(10,25,47,0.045); }
  .shwm-g:last-child { border-bottom: none; }
  .shwm-g-head { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: #a3adba; border-bottom: 1px solid rgba(10,25,47,0.07); }
  .shwm-g b { color: #0f172a; font-weight: 600; }
  .shwm-r { text-align: right; justify-self: end; }
  .shwm-mut { color: #94a3b8; font-weight: 400; }
  .shwm-g { grid-template-columns: 2fr 0.7fr 1fr 1.1fr; }

  .shwm-g-cli { grid-template-columns: 2fr 1.4fr 1fr; }
  .shwm-g-audit { grid-template-columns: 2.2fr 1.4fr 0.9fr; }
  .shwm-g-line { grid-template-columns: 2.3fr 1fr 1.1fr; }

  .shwm-g { }

  .shwm-g-value { }

  .shwm-g { }

  /* colored line states (negociación) */
  .shwm-line-ok { }
  .shwm-line-nego { background: rgba(245,158,11,0.055); border-radius: 8px; }
  .shwm-line-was { display: block; font-style: normal; font-size: 0.66rem; color: #cbd5e1; text-decoration: line-through; margin-top: 2px; }
  .shwm-amber-t { color: #d97706 !important; }
  
  .shwm-g .shwm-g, .shwm-g { }

  /* ── Avatars ── */
  .shwm-avat { width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; color: #fff; background: #334155; }
  .shwm-avat.a1 { background: #b45309; } .shwm-avat.a2 { background: #047857; } .shwm-avat.a3 { background: #6d28d9; } .shwm-avat.a4 { background: #1d4ed8; }
  .shwm-avat.a-gray { background: #94a3b8; }
  .shwm-avat-lg { width: 46px; height: 46px; border-radius: 12px; font-size: 0.9rem; }

  /* ── Checkmarks / dots ── */
  .shwm-ck { width: 20px; height: 20px; border-radius: 50%; background: #10b981; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; position: relative; }
  .shwm-ck::after { content: ''; width: 6px; height: 10px; border: solid #fff; border-width: 0 2.2px 2.2px 0; transform: rotate(45deg) translate(-1px,-1px); }
  .shwm-ck-sm { width: 15px; height: 15px; border-radius: 50%; background: #10b981; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; position: relative; }
  .shwm-ck-sm::after { content: ''; width: 4px; height: 7px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg) translate(-0.5px,-1px); }

  .shwm-g { }

  /* ── Tag mono (SKU / RFC) ── */
  .shwm-tag-mono { font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.74rem; color: #64748b; }

  /* ── KPIs strip ── */
  .shwm-kpis { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; padding: 16px 16px 8px; }
  .shwm-kpis-4 { grid-template-columns: repeat(4,1fr); }
  .shwm-kpis-3 { grid-template-columns: repeat(3,1fr); padding: 4px 0 12px; }
  .shwm-kpi { background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); border-radius: 12px; padding: 13px 14px; }
  .shwm-kpi span { display: block; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #a3adba; }
  .shwm-kpi b { display: block; font-size: 1.28rem; color: #0f172a; margin-top: 5px; letter-spacing: -0.02em; }
  .shwm-g { color: #475569; }
  .shwm-kpi b.shwm-g, b.shwm-g { color: #059669; }
  .shwm-amber-t { color: #d97706; }
  .shwm-kpi b.shwm-amber-t { color: #d97706; }

  .shwm-center-label { font-size: 0.82rem; font-weight: 600; color: #64748b; }

  .shwm-pl { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 2px; font-size: 0.82rem; color: #475569; border-bottom: 1px solid rgba(10,25,47,0.04); }
  .shwm-pl:last-child { border-bottom: none; }
  .shwm-pl b { color: #0f172a; font-weight: 600; }

  /* ══════════════════ CFDI ══════════════════ */
  .shwm-flow { display: grid; grid-template-columns: 1fr 60px 1fr; align-items: stretch; gap: 0; padding: 18px 20px; }
  .shwm-flow-col { display: flex; flex-direction: column; gap: 8px; }
  .shwm-flow-cap { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #a3adba; margin-bottom: 2px; }
  .shwm-flow-node { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.06); border-radius: 9px; padding: 10px 12px; font-size: 0.76rem; color: #94a3b8; }
  .shwm-flow-node b { color: #0f172a; font-weight: 600; font-size: 0.78rem; }
  .shwm-flow-filled { background: rgba(16,185,129,0.05); border-color: rgba(16,185,129,0.18); }
  .shwm-flow-wires { display: flex; align-items: center; justify-content: center; color: rgba(16,185,129,0.4); }
  .shwm-flow-wires svg { width: 100%; height: 90%; }
  .shwm-flow-out { }

  .shwm-thread { display: flex; flex-direction: column; padding: 14px 20px 6px; position: relative; }
  .shwm-thread-node { display: flex; align-items: center; gap: 14px; padding: 12px 0; position: relative; }
  .shwm-thread-node:not(:last-child)::after { content: ''; position: absolute; left: 15px; top: 42px; bottom: -8px; width: 2px; background: rgba(16,185,129,0.3); }
  .shwm-tn-ico { width: 32px; height: 32px; border-radius: 50%; background: #10b981; color: #fff; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 1; box-shadow: 0 0 0 4px #fff; }
  .shwm-tn-ico svg { width: 16px; height: 16px; }
  .shwm-tn-tx { flex: 1; }
  .shwm-tn-tx b { display: block; font-size: 0.88rem; color: #0f172a; font-weight: 600; }
  .shwm-tn-tx span { display: block; font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }
  .shwm-thread-node > b { flex-shrink: 0; color: #0f172a; font-weight: 600; }
  .shwm-brand-mini { border-radius: 5px; flex-shrink: 0; }
  .shwm-uuid-strip { margin: 4px 20px 0; padding: 11px 14px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); border-radius: 9px; font-family: var(--font-mono, monospace); font-size: 0.68rem; color: #94a3b8; word-break: break-all; }
  .shwm-uuid-strip b { color: #2563eb; font-weight: 600; }

  /* CSD upload */
  .shwm-drop-zone { padding: 20px 20px 8px; display: flex; flex-direction: column; gap: 10px; }
  .shwm-file { display: flex; align-items: center; gap: 13px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.06); border-radius: 12px; padding: 13px 15px; }
  .shwm-file-ico { width: 38px; height: 38px; border-radius: 10px; background: rgba(16,185,129,0.09); color: #059669; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .shwm-file-ico svg { width: 19px; height: 19px; }
  .shwm-file > div { flex: 1; }
  .shwm-file b { display: block; font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-file em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 2px; }
  .shwm-connected { display: flex; align-items: center; gap: 13px; margin: 12px 20px 6px; padding: 14px 15px; background: rgba(16,185,129,0.05); border: 1px solid rgba(16,185,129,0.18); border-radius: 12px; }
  .shwm-conn-ring { width: 34px; height: 34px; border-radius: 50%; background: #10b981; color: #fff; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .shwm-conn-ring svg { width: 17px; height: 17px; }
  .shwm-connected > div { flex: 1; }
  .shwm-connected b { display: block; font-size: 0.86rem; color: #0f172a; font-weight: 600; }
  .shwm-connected em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 2px; }

  /* ══════════════════ CLIENTES & CRÉDITO ══════════════════ */
  .shwm-credit { display: flex; flex-direction: column; padding: 10px 16px; }
  .shwm-credit-r { display: grid; grid-template-columns: 1.5fr 1.3fr 1fr; align-items: center; gap: 16px; padding: 13px 8px; border-bottom: 1px solid rgba(10,25,47,0.05); border-radius: 8px; }
  .shwm-credit-r:last-child { border-bottom: none; }
  .shwm-credit-hot { background: rgba(245,158,11,0.045); }
  .shwm-credit-who { display: flex; align-items: center; gap: 11px; }
  .shwm-credit-who b { display: block; font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-credit-who em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 1px; }
  .shwm-gauge { height: 10px; border-radius: 100px; background: #eef2f7; overflow: hidden; }
  .shwm-gauge > i { display: block; height: 100%; border-radius: 100px; background: #2563eb; }
  .shwm-gauge > i.warn { background: linear-gradient(90deg,#f59e0b,#dc2626); }
  .shwm-gauge-off { opacity: 0.5; }
  .shwm-credit-r > b { text-align: right; font-weight: 600; color: #0f172a; }
  .shwm-credit-r > .shwm-badge { justify-self: end; }

  .shwm-cli-who { display: flex; align-items: center; gap: 11px; }
  .shwm-cli-who .shwm-avat { width: 30px; height: 30px; font-size: 0.66rem; }

  .shwm-profile { padding: 18px 18px 6px; }
  .shwm-profile-head { display: flex; align-items: center; gap: 14px; padding-bottom: 16px; border-bottom: 1px solid rgba(10,25,47,0.06); margin-bottom: 14px; }
  .shwm-profile-head b { display: block; font-size: 1.02rem; color: #0f172a; font-weight: 700; }
  .shwm-profile-head em { display: block; font-style: normal; font-size: 0.74rem; color: #94a3b8; margin-top: 3px; }
  .shwm-plist { display: flex; flex-direction: column; }

  /* ══════════════════ COBRANZA IA ══════════════════ */
  .shwm-log { display: flex; flex-direction: column; padding: 8px 18px; }
  .shwm-log-r { display: flex; align-items: center; gap: 14px; padding: 12px 0; border-bottom: 1px solid rgba(10,25,47,0.05); }
  .shwm-log-r:last-child { border-bottom: none; }
  .shwm-log-time { flex-shrink: 0; width: 92px; font-size: 0.72rem; font-weight: 700; color: #b45309; font-family: var(--font-mono, monospace); }
  .shwm-log-ico { width: 32px; height: 32px; border-radius: 9px; background: rgba(10,25,47,0.04); color: #64748b; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .shwm-log-ico svg { width: 16px; height: 16px; }
  .shwm-log-tx { flex: 1; }
  .shwm-log-tx b { display: block; font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-log-tx span { display: block; font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }

  .shwm-chat { display: flex; flex-direction: column; gap: 10px; padding: 18px 20px 10px; }
  .shwm-msg { max-width: 76%; font-size: 0.84rem; line-height: 1.45; padding: 11px 14px; box-shadow: 0 4px 14px -8px rgba(10,25,47,0.14); }
  .shwm-msg-ai { align-self: flex-start; background: #f4f6f9; color: #334155; border: 1px solid rgba(10,25,47,0.05); border-radius: 15px 15px 15px 4px; }
  .shwm-msg-cl { align-self: flex-end; background: #0a192f; color: #fff; border-radius: 15px 15px 4px 15px; }
  .shwm-msg-tag { display: block; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.4px; text-transform: uppercase; color: #2563eb; margin-bottom: 4px; }
  .shwm-plan-card { margin: 8px 20px 0; padding: 14px 16px; background: rgba(16,185,129,0.04); border: 1px solid rgba(16,185,129,0.18); border-radius: 12px; }
  .shwm-plan-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 10px; margin-bottom: 6px; border-bottom: 1px solid rgba(16,185,129,0.14); }
  .shwm-plan-head b { font-size: 0.84rem; color: #0f172a; font-weight: 700; }
  .shwm-plan-row { display: flex; align-items: center; justify-content: space-between; padding: 6px 0; font-size: 0.8rem; color: #475569; }
  .shwm-plan-row b { color: #0f172a; font-weight: 600; }

  .shwm-audit-what { display: flex; align-items: center; gap: 9px; color: #0f172a; font-weight: 500; }
  .shwm-ad-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .shwm-ad-dot.blue { background: #2563eb; }
  .shwm-ad-dot.amber { background: #f59e0b; }
  .shwm-ad-dot.green { background: #10b981; }
  .shwm-audit-actor { font-size: 0.78rem; color: #64748b; }

  /* ══════════════════ DIVISAS / FX ══════════════════ */
  .shwm-fxchart { padding: 16px 20px 4px; }
  .shwm-fxchart-plot { position: relative; height: 130px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); border-radius: 12px; overflow: hidden; }
  .shwm-fxchart-plot svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .shwm-fx-lockbadge { position: absolute; top: 14px; right: 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 0.64rem; font-weight: 700; color: #0a192f; background: rgba(255,255,255,0.9); border: 1px solid rgba(10,25,47,0.1); border-radius: 100px; padding: 4px 10px; }
  .shwm-fx-lockbadge svg { width: 13px; height: 13px; }
  .shwm-fx-legend { display: flex; gap: 20px; padding: 10px 2px 0; }
  .shwm-fx-legend span { display: inline-flex; align-items: center; gap: 7px; font-size: 0.72rem; color: #64748b; }
  .shwm-lg-line { width: 16px; height: 3px; border-radius: 2px; }
  .shwm-lg-line.gray { background: #cbd5e1; }
  .shwm-lg-line.navy { background: #0a192f; }

  .shwm-ticker { padding: 18px 20px 8px; display: flex; flex-direction: column; gap: 12px; }
  .shwm-tick-r { display: grid; grid-template-columns: 1.2fr 1fr 1.2fr; align-items: center; gap: 14px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); border-radius: 12px; padding: 14px 16px; }
  .shwm-tick-cur { font-size: 0.78rem; font-weight: 700; color: #475569; }
  .shwm-tick-big { font-size: 1.5rem; color: #0f172a; letter-spacing: -0.03em; text-align: center; }
  .shwm-tick-live { display: inline-flex; align-items: center; gap: 7px; justify-self: end; font-size: 0.7rem; color: #94a3b8; }
  .shwm-pulse { width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,0.18); }

  .shwm-dual { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0; padding: 20px 20px 12px; }
  .shwm-dual-col { background: #f8fafc; border: 1px solid rgba(10,25,47,0.06); border-radius: 14px; padding: 18px 18px; }
  .shwm-dual-fiscal { background: rgba(16,185,129,0.04); border-color: rgba(16,185,129,0.18); }
  .shwm-dual-cap { display: block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #a3adba; }
  .shwm-dual-flag { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 0.74rem; font-weight: 600; color: #64748b; }
  .shwm-dual-amt { display: block; font-size: 1.7rem; color: #0f172a; letter-spacing: -0.03em; margin-top: 8px; }
  .shwm-dual-col em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 6px; }
  .shwm-dual-eq { font-size: 1.4rem; font-weight: 300; color: #cbd5e1; padding: 0 16px; }
  .shwm-flag { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 17px; padding: 0 4px; border-radius: 3px; background: #1d4ed8; color: #fff; font-size: 0.56rem; font-weight: 800; letter-spacing: 0.3px; }
  .shwm-flag.mx { background: #047857; }
  .shwm-dual-rate { margin: 6px 20px 0; padding: 11px 14px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); border-radius: 10px; font-size: 0.76rem; color: #64748b; text-align: center; }
  .shwm-dual-rate b { color: #0f172a; font-weight: 600; }

  /* ══════════════════ INTERNACIONAL ══════════════════ */
  .shwm-border { display: grid; grid-template-columns: 1fr 1.1fr 1fr; align-items: center; gap: 0; padding: 24px 20px; }
  .shwm-border-node { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 7px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.06); border-radius: 16px; padding: 20px 16px; }
  .shwm-border-node b { font-size: 0.92rem; color: #0f172a; font-weight: 700; }
  .shwm-border-node em { font-style: normal; font-size: 0.72rem; color: #94a3b8; }
  .shwm-flag-lg { min-width: 40px; height: 28px; border-radius: 6px; font-size: 0.82rem; margin-bottom: 4px; }
  .shwm-border-link { display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; }
  .shwm-border-link::before, .shwm-border-link::after { content: ''; position: absolute; top: 50%; width: 22%; height: 2px; background: repeating-linear-gradient(90deg,#cbd5e1 0,#cbd5e1 4px,transparent 4px,transparent 8px); }
  .shwm-border-link::before { left: 4px; }
  .shwm-border-link::after { right: 4px; }
  .shwm-border-doc { width: 48px; height: 48px; border-radius: 13px; background: #fff; border: 1px solid rgba(10,25,47,0.08); box-shadow: 0 8px 20px -10px rgba(10,25,47,0.2); display: flex; align-items: center; justify-content: center; color: #0a192f; z-index: 1; }
  .shwm-border-doc svg { width: 24px; height: 24px; }
  .shwm-border-cap { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: #a3adba; }

  .shwm-buffer { padding: 20px 20px 8px; display: flex; flex-direction: column; gap: 14px; }
  .shwm-buffer-row { display: flex; align-items: center; justify-content: space-between; font-size: 0.86rem; color: #64748b; }
  .shwm-buffer-row b { color: #0f172a; font-weight: 600; font-size: 1rem; }
  .shwm-buffer-out { padding-top: 14px; border-top: 1px solid rgba(10,25,47,0.07); }
  .shwm-buffer-out b { font-size: 1.28rem; letter-spacing: -0.02em; }
  .shwm-buffer-ctrl { background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); border-radius: 12px; padding: 14px 16px; }
  .shwm-buffer-label { display: flex; align-items: center; justify-content: space-between; font-size: 0.76rem; font-weight: 600; color: #64748b; margin-bottom: 12px; }
  .shwm-buffer-track { position: relative; height: 6px; border-radius: 100px; background: #e2e8f0; }
  .shwm-buffer-fill { position: absolute; left: 0; top: 0; height: 100%; border-radius: 100px; background: #059669; }
  .shwm-buffer-knob { position: absolute; top: 50%; width: 18px; height: 18px; border-radius: 50%; background: #fff; border: 2px solid #059669; box-shadow: 0 2px 8px rgba(10,25,47,0.18); transform: translate(-50%,-50%); }
  .shwm-buffer-scale { display: flex; justify-content: space-between; margin-top: 10px; font-size: 0.64rem; font-weight: 600; color: #a3adba; }
  .shwm-lock-strip { display: flex; align-items: center; gap: 13px; margin: 8px 20px 6px; padding: 14px 15px; background: rgba(16,185,129,0.05); border: 1px solid rgba(16,185,129,0.18); border-radius: 12px; }
  .shwm-lock-ico { width: 34px; height: 34px; border-radius: 10px; background: rgba(16,185,129,0.12); color: #059669; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .shwm-lock-ico svg { width: 17px; height: 17px; }
  .shwm-lock-strip b { display: block; font-size: 0.86rem; color: #0f172a; font-weight: 600; }
  .shwm-lock-strip em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 2px; }

  .shwm-stamp { padding: 20px 20px 8px; }
  .shwm-stamp-doc { display: flex; align-items: center; gap: 14px; padding-bottom: 16px; border-bottom: 1px solid rgba(10,25,47,0.06); margin-bottom: 14px; }
  .shwm-stamp-seal { width: 52px; height: 52px; border-radius: 14px; background: rgba(16,185,129,0.08); color: #059669; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid rgba(16,185,129,0.2); }
  .shwm-stamp-seal svg { width: 28px; height: 28px; }
  .shwm-stamp-tx b { display: block; font-size: 0.96rem; color: #0f172a; font-weight: 700; }
  .shwm-stamp-tx em { display: block; font-style: normal; font-size: 0.74rem; color: #94a3b8; margin-top: 3px; }
  .shwm-uuid { color: #2563eb !important; font-size: 0.76rem; }
  .shwm-stamp-cta { display: flex; gap: 10px; margin-top: 16px; }
  .shwm-stamp-btn { flex: 1; text-align: center; font-size: 0.8rem; font-weight: 600; color: #475569; padding: 11px; border-radius: 10px; border: 1px solid rgba(10,25,47,0.12); }

  /* ══════════════════ FINANZAS ══════════════════ */
  .shwm-dso { display: flex; flex-direction: column; padding: 10px 16px; }
  .shwm-dso-r { display: grid; grid-template-columns: 1.4fr 2fr 0.7fr; align-items: center; gap: 16px; padding: 15px 8px; border-bottom: 1px solid rgba(10,25,47,0.05); }
  .shwm-dso-r:last-child { border-bottom: none; }
  .shwm-dso-who { display: flex; align-items: center; gap: 11px; }
  .shwm-dso-who b { font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-dso-cmp { display: flex; align-items: center; gap: 10px; font-size: 0.78rem; }
  .shwm-dso-strike { color: #b6bcc6; text-decoration: line-through; }
  .shwm-dso-arrow { color: #cbd5e1; font-weight: 700; }
  .shwm-dso-real { color: #0f172a; font-weight: 700; }
  .shwm-dso-r > .shwm-badge { justify-self: end; }

  .shwm-conc { display: grid; grid-template-columns: 150px 1fr; align-items: center; gap: 24px; padding: 18px 22px 10px; }
  .shwm-donut { position: relative; width: 130px; height: 130px; }
  .shwm-donut-ring { width: 100%; height: 100%; border-radius: 50%; background: conic-gradient(#0a192f 0% 40%, #64748b 40% 64%, #94a3b8 64% 82%, #cbd5e1 82% 100%); }
  .shwm-donut-hole { position: absolute; inset: 22px; border-radius: 50%; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: inset 0 1px 0 rgba(255,255,255,0.7); }
  .shwm-donut-hole b { font-size: 1.5rem; color: #0f172a; letter-spacing: -0.03em; }
  .shwm-donut-hole span { font-size: 0.62rem; color: #94a3b8; margin-top: 2px; }
  .shwm-conc-legend { display: flex; flex-direction: column; gap: 4px; }
  .shwm-conc-r { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 11px; padding: 8px 0; font-size: 0.82rem; color: #475569; border-bottom: 1px solid rgba(10,25,47,0.04); }
  .shwm-conc-r:last-child { border-bottom: none; }
  .shwm-conc-r b { color: #0f172a; font-weight: 600; }
  .shwm-conc-hot span { color: #0f172a; font-weight: 600; }
  .shwm-lg-sw { width: 12px; height: 12px; border-radius: 4px; }
  .shwm-lg-sw.navy { background: #0a192f; } .shwm-lg-sw.g1 { background: #64748b; } .shwm-lg-sw.g2 { background: #94a3b8; } .shwm-lg-sw.g3 { background: #cbd5e1; }
  .shwm-alert-strip { display: flex; align-items: center; gap: 12px; margin: 6px 20px 6px; padding: 13px 15px; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.2); border-radius: 12px; font-size: 0.8rem; color: #78530a; }
  .shwm-alert-strip b { color: #92400e; font-weight: 700; }
  .shwm-alert-ico { width: 30px; height: 30px; color: #d97706; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; }
  .shwm-alert-ico svg { width: 22px; height: 22px; }

  .shwm-exec-chart { margin: 8px 18px 4px; padding: 14px 16px 10px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); border-radius: 12px; }
  .shwm-exec-cap { display: block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #a3adba; margin-bottom: 12px; }
  .shwm-bars { display: grid; grid-template-columns: repeat(5,1fr); gap: 14px; align-items: end; height: 110px; }
  .shwm-bar-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; gap: 8px; }
  .shwm-bar-col > i { display: block; width: 100%; max-width: 42px; border-radius: 6px 6px 3px 3px; background: #e2e8f0; }
  .shwm-bar-col > i.hot { background: linear-gradient(180deg,#1e3a5f,#0a192f); }
  .shwm-bar-col > span { font-size: 0.62rem; font-weight: 600; color: #a3adba; }
  .shwm-exec-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 15px 20px; border-top: 1px solid rgba(10,25,47,0.06); background: #fcfdfe; font-size: 0.8rem; color: #94a3b8; }
  .shwm-exec-btn { display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; font-weight: 700; color: #fff; background: #0a192f; padding: 9px 16px; border-radius: 100px; }
  .shwm-exec-btn svg { width: 15px; height: 15px; }

  /* ══════════════════ EQUIPO ══════════════════ */
  .shwm-matrix { padding: 16px 18px 8px; }
  .shwm-mx-head { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; align-items: center; gap: 10px; padding: 0 8px 12px; border-bottom: 1px solid rgba(10,25,47,0.07); }
  .shwm-mx-head span { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #a3adba; text-align: center; }
  .shwm-mx-corner { text-align: left !important; }
  .shwm-mx-r { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; align-items: center; gap: 10px; padding: 13px 8px; border-bottom: 1px solid rgba(10,25,47,0.045); }
  .shwm-mx-r:last-child { border-bottom: none; }
  .shwm-mx-perm { font-size: 0.84rem; color: #334155; font-weight: 500; }
  .shwm-mx-yes, .shwm-mx-no { justify-self: center; }
  .shwm-mx-yes { width: 20px; height: 20px; border-radius: 50%; background: #10b981; position: relative; }
  .shwm-mx-yes::after { content: ''; position: absolute; left: 50%; top: 47%; width: 5px; height: 9px; border: solid #fff; border-width: 0 2px 2px 0; transform: translate(-50%,-50%) rotate(45deg); }
  .shwm-mx-no { width: 20px; height: 20px; border-radius: 50%; background: #eef2f7; border: 1px solid rgba(10,25,47,0.06); position: relative; }
  .shwm-mx-no::after { content: ''; position: absolute; left: 50%; top: 50%; width: 8px; height: 1.5px; background: #cbd5e1; transform: translate(-50%,-50%); }

  .shwm-switch-current { display: flex; align-items: center; gap: 13px; margin: 18px 20px 4px; padding: 14px 16px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.08); border-radius: 13px; }
  .shwm-switch-current b { display: block; font-size: 0.92rem; color: #0f172a; font-weight: 700; }
  .shwm-switch-current em { display: block; font-style: normal; font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }
  .shwm-switch-current > div { flex: 1; }
  .shwm-switch-chev { width: 20px; height: 20px; color: #94a3b8; flex-shrink: 0; }
  .shwm-switch-drop { margin: 6px 20px 6px; background: #fff; border: 1px solid rgba(10,25,47,0.08); border-radius: 13px; box-shadow: 0 18px 40px -18px rgba(10,25,47,0.2); overflow: hidden; }
  .shwm-switch-r { display: flex; align-items: center; gap: 12px; padding: 13px 16px; border-bottom: 1px solid rgba(10,25,47,0.05); }
  .shwm-switch-r:last-child { border-bottom: none; }
  .shwm-switch-active { background: rgba(16,185,129,0.05); }
  .shwm-switch-r b { display: block; font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-switch-r em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 1px; }
  .shwm-switch-r > div { flex: 1; }

  .shwm-sec { padding: 16px 20px 6px; }
  .shwm-sec-sso { display: flex; flex-direction: column; gap: 9px; margin-bottom: 16px; }
  .shwm-sec-sso-r { display: flex; align-items: center; gap: 13px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.06); border-radius: 12px; padding: 12px 15px; }
  .shwm-sec-logo { width: 34px; height: 34px; border-radius: 9px; background: #fff; border: 1px solid rgba(10,25,47,0.08); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .shwm-sec-logo img { border-radius: 4px; }
  .shwm-sec-sso-r > div { flex: 1; }
  .shwm-sec-sso-r b { display: block; font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-sec-sso-r em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 2px; }
  .shwm-sec-cap { display: block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #a3adba; margin-bottom: 10px; }
  .shwm-sec-sessions { display: flex; flex-direction: column; gap: 9px; }
  .shwm-sess-r { display: flex; align-items: center; gap: 13px; padding: 11px 4px; border-bottom: 1px solid rgba(10,25,47,0.05); }
  .shwm-sess-r:last-child { border-bottom: none; }
  .shwm-sess-ico { width: 34px; height: 34px; border-radius: 9px; background: rgba(10,25,47,0.04); color: #64748b; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .shwm-sess-ico svg { width: 18px; height: 18px; }
  .shwm-sess-r > div { flex: 1; }
  .shwm-sess-r b { display: block; font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-sess-r em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 2px; }
  .shwm-sess-revoke { font-size: 0.76rem; font-weight: 700; color: #dc2626; }

  /* ══════════════════ NEGOCIACIÓN ══════════════════ */
  .shwm-ver { display: flex; flex-direction: column; padding: 12px 20px 6px; position: relative; }
  .shwm-ver-r { display: flex; align-items: flex-start; gap: 14px; padding: 13px 0; border-bottom: 1px solid rgba(10,25,47,0.05); position: relative; }
  .shwm-ver-r:last-child { border-bottom: none; }
  .shwm-ver-tag { flex-shrink: 0; width: 34px; height: 26px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.68rem; font-weight: 800; color: #64748b; background: rgba(10,25,47,0.05); border: 1px solid rgba(10,25,47,0.09); }
  .shwm-ver-tag.amber { color: #d97706; background: rgba(245,158,11,0.1); border-color: rgba(245,158,11,0.22); }
  .shwm-ver-tag.green { color: #059669; background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.22); }
  .shwm-ver-tx { flex: 1; }
  .shwm-ver-tx b { display: block; font-size: 0.86rem; color: #0f172a; font-weight: 600; }
  .shwm-ver-tx em { display: block; font-style: normal; font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }
  .shwm-ver-r > b { flex-shrink: 0; font-weight: 600; color: #0f172a; }
  .shwm-ver-open { background: rgba(16,185,129,0.03); border-radius: 10px; margin: 0 -8px; padding: 13px 8px; }
  .shwm-ver-diff { margin-top: 9px; display: flex; flex-direction: column; gap: 4px; font-family: var(--font-mono, monospace); font-size: 0.72rem; }
  .shwm-diff-del { color: #dc2626; background: rgba(220,38,38,0.05); padding: 4px 8px; border-radius: 5px; }
  .shwm-diff-add { color: #059669; background: rgba(16,185,129,0.06); padding: 4px 8px; border-radius: 5px; }

  .shwm-sign { width: 100%; max-width: 480px; background: #fff; border: 1px solid rgba(10,25,47,0.07); border-radius: 20px; box-shadow: 0 30px 60px -22px rgba(10,25,47,0.2); padding: 30px 30px; text-align: center; }
  .shwm-sign-seal { width: 62px; height: 62px; border-radius: 16px; margin: 0 auto 16px; background: rgba(16,185,129,0.08); color: #059669; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(16,185,129,0.2); }
  .shwm-sign-seal svg { width: 32px; height: 32px; }
  .shwm-sign-title { display: block; font-size: 1.1rem; color: #0f172a; font-weight: 700; letter-spacing: -0.02em; }
  .shwm-sign-sub { display: block; font-style: normal; font-size: 0.76rem; color: #94a3b8; margin-top: 8px; }
  .shwm-sign-hash { margin: 20px 0 14px; padding: 14px 16px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.06); border-radius: 12px; text-align: left; }
  .shwm-sign-hash-lbl { display: block; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; color: #a3adba; margin-bottom: 6px; }
  .shwm-sign-hash code { display: block; font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.74rem; color: #2563eb; word-break: break-all; line-height: 1.5; }
  .shwm-sign-verify { display: inline-flex; align-items: center; gap: 8px; font-size: 0.76rem; color: #059669; font-weight: 600; }

  /* ══════════════════════════════════════════════════════════════════
     MÓVIL (<=760px) — el lienzo mide ~350px, no 1100.
     Las escenas partidas (antes vs. ahora) se apilan, el marco pierde
     su padding de escritorio y el teléfono cabe. La altura del stage la
     ajusta FeatureShowcase.astro con JS a la escena más alta.
  ══════════════════════════════════════════════════════════════════ */
  @media (max-width: 760px) {
    .shwm-wrap { height: auto; min-height: 100%; font-size: 0.82rem; }
    .shwm-frame { height: auto; min-height: 100%; padding: 1.15rem 1.1rem; }
    .shwm-frame.shwm-center { gap: 1rem; }

    .shwm-app { border-radius: 14px; }
    .shwm-bar { padding: 12px 14px; gap: 10px; }
    .shwm-bar-t { font-size: 0.82rem; }
    .shwm-badge { font-size: 0.58rem; padding: 4px 9px; }
    .shwm-body { padding: 8px 10px 10px; }
    .shwm-foot { padding: 12px 14px; gap: 10px; font-size: 0.74rem; }

    .shwm-g { gap: 9px; padding: 10px; font-size: 0.79rem; }
    .shwm-g-head { font-size: 0.58rem; }
    .shwm-kv { padding: 10px 11px; }
    .shwm-sign { padding: 22px 18px; border-radius: 16px; }
    .shwm-sign-seal { width: 52px; height: 52px; margin-bottom: 12px; }
    .shwm-sign-hash { margin: 16px 0 12px; padding: 12px 13px; }

    /* KPIs: tres o cuatro columnas no caben en 350px */
    .shwm-kpis { grid-template-columns: repeat(2, 1fr); gap: 9px; padding: 12px 12px 6px; }
    .shwm-kpis-3, .shwm-kpis-4 { grid-template-columns: repeat(2, 1fr); }
    .shwm-kpi { padding: 11px 12px; }
    .shwm-kpi span { font-size: 0.56rem; }
    .shwm-kpi b { font-size: 1.08rem; }

    /* DSO: el nombre arriba, la comparación abajo y el badge a la derecha */
    .shwm-dso { padding: 8px 12px; }
    .shwm-dso-r { grid-template-columns: 1fr auto; gap: 8px 10px; padding: 13px 6px; }
    .shwm-dso-who { grid-column: 1; }
    .shwm-dso-r > .shwm-badge { grid-column: 2; grid-row: 1; }
    .shwm-dso-cmp { grid-column: 1 / -1; grid-row: 2; flex-wrap: wrap; gap: 8px; font-size: 0.76rem; }
    .shwm-dso-who b { font-size: 0.82rem; }

    /* Divisas: las dos columnas se apilan con el "=" girado en medio */
    .shwm-dual { grid-template-columns: 1fr; gap: 8px; padding: 14px 14px 10px; }
    .shwm-dual-col { padding: 14px; }
    .shwm-dual-amt { font-size: 1.4rem; }
    .shwm-dual-eq { padding: 0; text-align: center; }
    .shwm-dual-rate { margin: 6px 14px 0; padding: 10px 12px; font-size: 0.74rem; }

    /* Frontera: tres nodos en fila tampoco caben */
    .shwm-border { grid-template-columns: 1fr; gap: 10px; padding: 16px 14px; }
  }

  /* ═══ Calcas de la app: editor, link público, seguimiento, aprobaciones ═══ */
  .shwm-x .editorial { font-family: var(--font-sans); font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .shwm-x strong { font-weight: 600; }
  .shwm-x em, .shwm-x i { font-style: normal; }
  .shwm-frame.shwm-scene { display: block; padding: 0; }

  /* dispositivo */
  .shwm-dv { position: absolute; z-index: 2; width: 244px; height: 522px; padding: 8px; border-radius: 46px; background: #1b1d21; box-shadow: inset 0 0 0 1.5px #3b3e44, inset 0 0 0 3px #111214, 0 2px 4px rgba(10,25,47,0.12), 0 30px 60px -22px rgba(10,25,47,0.4), 0 70px 110px -50px rgba(10,25,47,0.34); }
  .shwm-dv::before { content: ''; position: absolute; right: -2px; top: 132px; width: 3px; height: 64px; border-radius: 0 3px 3px 0; background: #2a2d32; }
  .shwm-dv::after { content: ''; position: absolute; left: -2px; top: 104px; width: 3px; height: 34px; border-radius: 3px 0 0 3px; background: #2a2d32; box-shadow: 0 48px 0 #2a2d32; }
  .shwm-dv-scr { position: relative; height: 100%; border-radius: 38px; overflow: hidden; background: #f3f2ef; color: #0f1729; }
  .shwm-dv-ios { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; height: 38px; padding: 4px 20px 0 24px; color: #0f1729; }
  .shwm-dv-ios.dark { color: #ffffff; }
  .shwm-dv-ios .t { font-size: 0.66rem; font-weight: 700; }
  .shwm-dv-ios .isl { position: absolute; top: 9px; left: 50%; transform: translateX(-50%); width: 72px; height: 21px; border-radius: 100px; background: #000000; }
  .shwm-dv-ios .ic { display: inline-flex; align-items: center; gap: 4px; }
  .shwm-dv-ios .ic svg { height: 9px; width: auto; }
  .shwm-dv-home { position: absolute; z-index: 6; left: 50%; bottom: 7px; transform: translateX(-50%); width: 92px; height: 4px; border-radius: 100px; background: rgba(10,25,47,0.28); }
  .shwm-dv-home.light { background: rgba(255,255,255,0.7); }

  /* navegador */
  .shwm-brw { position: absolute; z-index: 1; left: 50%; top: 34px; transform: translateX(-50%); width: min(1060px, calc(100% - 96px)); height: 620px; border-radius: 14px; overflow: hidden; background: #ffffff; border: 1px solid rgba(10,25,47,0.08); box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 30px 60px -18px rgba(10,25,47,0.18), 0 60px 110px -40px rgba(10,25,47,0.2); color: #0f1729; }
  .shwm-brw-top { position: relative; display: flex; align-items: center; justify-content: space-between; height: 40px; padding: 0 14px; background: #f6f6f8; border-bottom: 1px solid rgba(10,25,47,0.07); }
  .shwm-brw-top .nav { display: inline-flex; gap: 10px; color: #a3a8b2; }
  .shwm-brw-top .nav svg, .shwm-brw-top .act svg { width: 15px; height: 15px; }
  .shwm-brw-top .act { color: #8a909c; }
  .shwm-brw-top .url { position: absolute; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 6px; max-width: 60%; padding: 5px 16px; border-radius: 8px; background: #ececef; font-size: 0.68rem; color: #4b5260; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .shwm-brw-top .url svg { width: 11px; height: 11px; color: #6b7280; flex-shrink: 0; }

  /* shell de la app */
  .shwm-as { display: grid; grid-template-columns: 196px minmax(0,1fr); height: calc(100% - 40px); }
  .shwm-as.is-col { grid-template-columns: 58px minmax(0,1fr); }
