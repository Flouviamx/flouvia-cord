  .shwm-sec-sso-r { display: flex; align-items: center; gap: 13px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.06); border-radius: 12px; padding: 12px 15px; }
  .shwm-sec-logo { width: 34px; height: 34px; border-radius: 9px; background: #fff; border: 1px solid rgba(10,25,47,0.08); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .shwm-sec-logo img { border-radius: 4px; }
  .shwm-sec-sso-r > div { flex: 1; }
  .shwm-sec-sso-r b { display: block; font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-sec-sso-r em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 2px; }
  .shwm-sec-cap { display: block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #a3adba; margin-bottom: 10px; }
  .shwm-sec-sessions { display: flex; flex-direction: column; gap: 9px; }
  .shwm-sess-r { display: flex; align-items: center; gap: 13px; padding: 11px 4px; border-bottom: 1px solid rgba(10,25,47,0.05); }
  .shwm-sess-r:last-child { border-bottom: none; }
  .shwm-sess-ico { width: 34px; height: 34px; border-radius: 9px; background: rgba(10,25,47,0.04); color: #64748b; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .shwm-sess-ico svg { width: 18px; height: 18px; }
  .shwm-sess-r > div { flex: 1; }
  .shwm-sess-r b { display: block; font-size: 0.84rem; color: #0f172a; font-weight: 600; }
  .shwm-sess-r em { display: block; font-style: normal; font-size: 0.7rem; color: #94a3b8; margin-top: 2px; }
  .shwm-sess-revoke { font-size: 0.76rem; font-weight: 700; color: #dc2626; }

  /* ══════════════════ NEGOCIACIÓN ══════════════════ */
  .shwm-ver { display: flex; flex-direction: column; padding: 12px 20px 6px; position: relative; }
  .shwm-ver-r { display: flex; align-items: flex-start; gap: 14px; padding: 13px 0; border-bottom: 1px solid rgba(10,25,47,0.05); position: relative; }
  .shwm-ver-r:last-child { border-bottom: none; }
  .shwm-ver-tag { flex-shrink: 0; width: 34px; height: 26px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.68rem; font-weight: 800; color: #64748b; background: rgba(10,25,47,0.05); border: 1px solid rgba(10,25,47,0.09); }
  .shwm-ver-tag.amber { color: #d97706; background: rgba(245,158,11,0.1); border-color: rgba(245,158,11,0.22); }
  .shwm-ver-tag.green { color: #059669; background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.22); }
  .shwm-ver-tx { flex: 1; }
  .shwm-ver-tx b { display: block; font-size: 0.86rem; color: #0f172a; font-weight: 600; }
  .shwm-ver-tx em { display: block; font-style: normal; font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }
  .shwm-ver-r > b { flex-shrink: 0; font-weight: 600; color: #0f172a; }
  .shwm-ver-open { background: rgba(16,185,129,0.03); border-radius: 10px; margin: 0 -8px; padding: 13px 8px; }
  .shwm-ver-diff { margin-top: 9px; display: flex; flex-direction: column; gap: 4px; font-family: var(--font-mono, monospace); font-size: 0.72rem; }
  .shwm-diff-del { color: #dc2626; background: rgba(220,38,38,0.05); padding: 4px 8px; border-radius: 5px; }
  .shwm-diff-add { color: #059669; background: rgba(16,185,129,0.06); padding: 4px 8px; border-radius: 5px; }

  .shwm-sign { width: 100%; max-width: 480px; background: #fff; border: 1px solid rgba(10,25,47,0.07); border-radius: 20px; box-shadow: 0 30px 60px -22px rgba(10,25,47,0.2); padding: 30px 30px; text-align: center; }
  .shwm-sign-seal { width: 62px; height: 62px; border-radius: 16px; margin: 0 auto 16px; background: rgba(16,185,129,0.08); color: #059669; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(16,185,129,0.2); }
  .shwm-sign-seal svg { width: 32px; height: 32px; }
  .shwm-sign-title { display: block; font-size: 1.1rem; color: #0f172a; font-weight: 700; letter-spacing: -0.02em; }
  .shwm-sign-sub { display: block; font-style: normal; font-size: 0.76rem; color: #94a3b8; margin-top: 8px; }
  .shwm-sign-hash { margin: 20px 0 14px; padding: 14px 16px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.06); border-radius: 12px; text-align: left; }
  .shwm-sign-hash-lbl { display: block; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; color: #a3adba; margin-bottom: 6px; }
  .shwm-sign-hash code { display: block; font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.74rem; color: #2563eb; word-break: break-all; line-height: 1.5; }
  .shwm-sign-verify { display: inline-flex; align-items: center; gap: 8px; font-size: 0.76rem; color: #059669; font-weight: 600; }

  /* ══════════════════════════════════════════════════════════════════
     MÓVIL (<=760px) — el lienzo mide ~350px, no 1100.
     Las escenas partidas (antes vs. ahora) se apilan, el marco pierde
     su padding de escritorio y el teléfono cabe. La altura del stage la
     ajusta FeatureShowcase.astro con JS a la escena más alta.
  ══════════════════════════════════════════════════════════════════ */
  @media (max-width: 760px) {
    .shwm-wrap { height: auto; min-height: 100%; font-size: 0.82rem; }
    .shwm-frame { height: auto; min-height: 100%; padding: 1.15rem 1.1rem; }
    .shwm-frame.shwm-center { gap: 1rem; }

    .shwm-app { border-radius: 14px; }
    .shwm-bar { padding: 12px 14px; gap: 10px; }
    .shwm-bar-t { font-size: 0.82rem; }
    .shwm-badge { font-size: 0.58rem; padding: 4px 9px; }
    .shwm-body { padding: 8px 10px 10px; }
    .shwm-foot { padding: 12px 14px; gap: 10px; font-size: 0.74rem; }

    .shwm-g { gap: 9px; padding: 10px; font-size: 0.79rem; }
    .shwm-g-head { font-size: 0.58rem; }
    .shwm-kv { padding: 10px 11px; }
    .shwm-sign { padding: 22px 18px; border-radius: 16px; }
    .shwm-sign-seal { width: 52px; height: 52px; margin-bottom: 12px; }
    .shwm-sign-hash { margin: 16px 0 12px; padding: 12px 13px; }

    /* Frontera: tres nodos en fila tampoco caben */
    .shwm-border { grid-template-columns: 1fr; gap: 10px; padding: 16px 14px; }
  }

  /* ═══ Calcas de la app: editor, link público, seguimiento, aprobaciones ═══ */
  .shwm-x .editorial { font-family: var(--font-sans); font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .shwm-x strong { font-weight: 600; }
  .shwm-x em, .shwm-x i { font-style: normal; }
  .shwm-frame.shwm-scene { display: block; padding: 0; }

  /* dispositivo */
  .shwm-dv { position: absolute; z-index: 2; width: 244px; height: 522px; padding: 8px; border-radius: 46px; background: #1b1d21; box-shadow: inset 0 0 0 1.5px #3b3e44, inset 0 0 0 3px #111214, 0 2px 4px rgba(10,25,47,0.12), 0 30px 60px -22px rgba(10,25,47,0.4), 0 70px 110px -50px rgba(10,25,47,0.34); }
  .shwm-dv::before { content: ''; position: absolute; right: -2px; top: 132px; width: 3px; height: 64px; border-radius: 0 3px 3px 0; background: #2a2d32; }
  .shwm-dv::after { content: ''; position: absolute; left: -2px; top: 104px; width: 3px; height: 34px; border-radius: 3px 0 0 3px; background: #2a2d32; box-shadow: 0 48px 0 #2a2d32; }
  .shwm-dv-scr { position: relative; height: 100%; border-radius: 38px; overflow: hidden; background: #f3f2ef; color: #0f1729; }
  .shwm-dv-ios { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; height: 38px; padding: 4px 20px 0 24px; color: #0f1729; }
  .shwm-dv-ios.dark { color: #ffffff; }
  .shwm-dv-ios .t { font-size: 0.66rem; font-weight: 700; }
  .shwm-dv-ios .isl { position: absolute; top: 9px; left: 50%; transform: translateX(-50%); width: 72px; height: 21px; border-radius: 100px; background: #000000; }
  .shwm-dv-ios .ic { display: inline-flex; align-items: center; gap: 4px; }
  .shwm-dv-ios .ic svg { height: 9px; width: auto; }
  .shwm-dv-home { position: absolute; z-index: 6; left: 50%; bottom: 7px; transform: translateX(-50%); width: 92px; height: 4px; border-radius: 100px; background: rgba(10,25,47,0.28); }
  .shwm-dv-home.light { background: rgba(255,255,255,0.7); }

  /* navegador */
  .shwm-brw { position: absolute; z-index: 1; left: 50%; top: 34px; transform: translateX(-50%); width: min(1060px, calc(100% - 96px)); height: 620px; border-radius: 14px; overflow: hidden; background: #ffffff; border: 1px solid rgba(10,25,47,0.08); box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 30px 60px -18px rgba(10,25,47,0.18), 0 60px 110px -40px rgba(10,25,47,0.2); color: #0f1729; }
  .shwm-brw-top { position: relative; display: flex; align-items: center; justify-content: space-between; height: 40px; padding: 0 14px; background: #f6f6f8; border-bottom: 1px solid rgba(10,25,47,0.07); }
  .shwm-brw-top .nav { display: inline-flex; gap: 10px; color: #a3a8b2; }
  .shwm-brw-top .nav svg, .shwm-brw-top .act svg { width: 15px; height: 15px; }
  .shwm-brw-top .act { color: #8a909c; }
  .shwm-brw-top .url { position: absolute; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 6px; max-width: 60%; padding: 5px 16px; border-radius: 8px; background: #ececef; font-size: 0.68rem; color: #4b5260; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .shwm-brw-top .url svg { width: 11px; height: 11px; color: #6b7280; flex-shrink: 0; }

  /* shell de la app */
  .shwm-as { display: grid; grid-template-columns: 196px minmax(0,1fr); height: calc(100% - 40px); }
  .shwm-as.is-col { grid-template-columns: 58px minmax(0,1fr); }
  .shwm-as-side { display: flex; flex-direction: column; gap: 6px; padding: 12px 10px; background: #fbfbfc; border-right: 1px solid rgba(10,25,47,0.07); min-width: 0; }
  .shwm-as-org { display: flex; align-items: center; gap: 8px; padding: 4px 4px 10px; margin-bottom: 4px; border-bottom: 1px solid rgba(10,25,47,0.07); font-size: 0.7rem; color: #0f1729; min-width: 0; }
  .shwm-as-org .av { width: 26px; height: 26px; flex-shrink: 0; border-radius: 8px; background: #b45309; color: #ffffff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.62rem; font-weight: 800; }
  .shwm-as-org strong { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 650; }
  .shwm-as-org svg { width: 12px; height: 12px; color: #99a2af; flex-shrink: 0; }
  .shwm-as-nav { display: flex; flex-direction: column; gap: 1px; }
  .shwm-as-g { font-size: 0.62rem; font-weight: 600; color: #99a2af; padding: 10px 8px 4px; }
  .shwm-as-i { display: flex; align-items: center; gap: 9px; padding: 6px 8px; border-radius: 8px; font-size: 0.7rem; font-weight: 500; color: #5b6472; white-space: nowrap; }
  .shwm-as-i svg { width: 14px; height: 14px; flex-shrink: 0; opacity: 0.62; }
  .shwm-as-i.on { background: rgba(10,25,47,0.07); color: #0a192f; font-weight: 600; }
  .shwm-as-i.on svg { opacity: 1; }
  .shwm-as-i em { margin-left: auto; font-size: 0.56rem; font-weight: 700; color: #5b6472; background: rgba(10,25,47,0.07); border-radius: 100px; padding: 1px 6px; }
  .shwm-as.is-col .shwm-as-side { align-items: center; padding: 12px 6px; }
  .shwm-as.is-col .shwm-as-org { border: 0; padding: 4px 0 8px; }
  .shwm-as.is-col .shwm-as-i { justify-content: center; width: 36px; height: 32px; padding: 0; }
  .shwm-as.is-col .shwm-as-i svg { width: 16px; height: 16px; }
  .shwm-as-main { position: relative; min-width: 0; padding: 0 22px; overflow: hidden; }
  .shwm-as-main.shwm-canvas { padding: 0 20px 20px; }
  .shwm-as-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 0 12px; }
  .shwm-as-head .tt { display: inline-flex; align-items: baseline; gap: 6px; font-size: 0.72rem; color: #5b6472; font-weight: 600; }
  .shwm-as-head .tt strong { font-size: 1rem; color: #0f1729; font-weight: 700; letter-spacing: -0.02em; }
  .shwm-as-head .sep { color: #c9ced6; }
  .shwm-canvas { background: #fafbfc; }

  /* ventana suelta */
  .shwm-cw { position: absolute; z-index: 1; background: #ffffff; border-radius: 14px; border: 1px solid rgba(10,25,47,0.08); overflow: hidden; color: #0f1729; box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 30px 60px -18px rgba(10,25,47,0.18), 0 60px 110px -40px rgba(10,25,47,0.2); }
  .shwm-cw-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 46px; padding: 9px 16px; border-bottom: 1px solid rgba(10,25,47,0.07); background: #fcfdfe; }
  .shwm-cw-crumbs { display: inline-flex; align-items: center; gap: 6px; font-size: 0.74rem; font-weight: 600; color: #5b6472; white-space: nowrap; }
  .shwm-cw-crumbs strong { color: #0f1729; }
  .shwm-cw-crumbs .sep { color: #c9ced6; }
  .shwm-cw-h { font-size: 0.86rem; font-weight: 700; letter-spacing: -0.01em; }
  .shwm-cw-draft { flex-shrink: 0; font-size: 0.64rem; font-weight: 600; color: #5b6472; background: #fafbfc; border: 1px solid rgba(10,25,47,0.08); padding: 3px 8px; border-radius: 6px; }
  .shwm-cw-me { display: inline-flex; align-items: center; gap: 7px; font-size: 0.68rem; font-weight: 600; color: #5b6472; }
  .shwm-cw-me .av { width: 22px; height: 22px; border-radius: 50%; background: #334155; color: #ffffff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.5rem; font-weight: 800; }
  .shwm-rng { display: inline-flex; align-items: center; gap: 6px; font-size: 0.66rem; font-weight: 600; color: #0f1729; background: #ffffff; border: 1px solid rgba(10,25,47,0.1); border-radius: 9px; padding: 5px 10px; }
  .shwm-rng svg { width: 12px; height: 12px; color: #5b6472; }

  /* piezas comunes */
  .shwm-fd { display: inline-flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; background: #f5f5f7; border: 1.5px solid transparent; border-radius: 9px; padding: 7px 10px; font-size: 0.7rem; color: #0f1729; }
  .shwm-fd.grow { flex: 1; }
  .shwm-fd > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .shwm-fd svg { width: 12px; height: 12px; color: #99a2af; flex-shrink: 0; }
  .shwm-inp { display: inline-flex; align-items: center; justify-self: start; background: #f5f5f7; border: 1.5px solid transparent; border-radius: 7px; padding: 4px 7px; font-size: 0.7rem; font-weight: 500; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .shwm-inp.deal { color: #059669; font-weight: 600; }
  .shwm-x .is-focus { background: #ffffff; border-color: #0a192f; box-shadow: 0 0 0 3px rgba(10,25,47,0.08); }
  .shwm-crt { display: none; width: 1.5px; height: 1.05em; margin-left: 1px; background: #0a192f; animation: shwm-caret-blink 1.05s step-end infinite; }
  .is-focus > .shwm-crt { display: inline-block; }
  .shwm-chips { display: inline-flex; gap: 4px; flex-shrink: 0; }
  .shwm-chips > span { font-size: 0.64rem; font-weight: 600; color: #5b6472; background: #f5f5f7; border-radius: 999px; padding: 5px 11px; }
  .shwm-chips > span.on { background: #0a192f; color: #ffffff; }
  .shwm-tog { position: relative; flex-shrink: 0; width: 28px; height: 16px; border-radius: 100px; background: rgba(10,25,47,0.14); transition: background 0.3s; }
  .shwm-tog::after { content: ''; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: #ffffff; box-shadow: 0 1px 3px rgba(10,25,47,0.25); transition: transform 0.3s cubic-bezier(0.22,1,0.36,1); }
  .shwm-tog.on { background: #0a192f; }
  .shwm-tog.on::after { transform: translateX(12px); }
  .shwm-sts { display: inline-flex; align-items: center; gap: 5px; font-size: 0.62rem; font-weight: 700; padding: 3px 9px; border-radius: 100px; white-space: nowrap; }
  .shwm-sts::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .shwm-sts.draft { color: #64748b; background: rgba(100,116,139,0.1); }
  .shwm-sts.sent { color: #2563eb; background: rgba(37,99,235,0.09); }
  .shwm-sts.viewed { color: #7c3aed; background: rgba(124,58,237,0.09); }
  .shwm-sts.approved { color: #059669; background: rgba(16,185,129,0.1); }
  .shwm-mg { justify-self: center; font-size: 0.6rem; font-weight: 600; color: #059669; background: rgba(16,185,129,0.1); border-radius: 4px; padding: 2px 5px; }
  .shwm-mg.low { color: #dc2626; background: rgba(220,38,38,0.1); }
  .shwm-steph { display: flex; align-items: center; gap: 8px; margin: 4px 0 8px; }
  .shwm-steph .n { width: 20px; height: 20px; border-radius: 6px; background: #0a192f; color: #ffffff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.62rem; font-weight: 700; }
  .shwm-steph .t { font-size: 0.78rem; font-weight: 600; }
  .shwm-client { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .shwm-sech { display: flex; align-items: baseline; justify-content: space-between; margin: 0 0 8px; padding-bottom: 7px; border-bottom: 1px solid rgba(10,25,47,0.08); }
  .shwm-sech strong { font-size: 0.78rem; }

  /* editor */
  .shwm-edg { display: grid; grid-template-columns: minmax(0,1fr) 236px; gap: 22px; padding: 16px 18px 20px; }
  .shwm-edg-wide { padding: 2px 0 20px; gap: 26px; grid-template-columns: minmax(0,1fr) 252px; }
  .shwm-edg-main { min-width: 0; }
  .shwm-lines { margin-bottom: 12px; }
  .shwm-lh, .shwm-lr { display: grid; gap: 9px; align-items: center; }
  .shwm-lines-5 .shwm-lh, .shwm-lines-5 .shwm-lr { grid-template-columns: minmax(0,1fr) 44px 64px 62px 84px; }
  .shwm-lines-6 .shwm-lh, .shwm-lines-6 .shwm-lr { grid-template-columns: minmax(0,1fr) 46px 66px 66px 86px 40px; }
  .shwm-x[data-loc="en-US"] .shwm-lines-5 .shwm-lh, .shwm-x[data-loc="en-US"] .shwm-lines-5 .shwm-lr { grid-template-columns: minmax(0,1fr) 44px 74px 62px 96px; }
  .shwm-x[data-loc="en-US"] .shwm-lines-6 .shwm-lh, .shwm-x[data-loc="en-US"] .shwm-lines-6 .shwm-lr { grid-template-columns: minmax(0,1fr) 46px 76px 66px 98px 40px; }
  .shwm-lh { font-size: 0.62rem; font-weight: 500; color: #5b6472; padding: 4px 0 7px; border-bottom: 1px solid rgba(10,25,47,0.08); }
  .shwm-lh .r, .shwm-lr .am { text-align: right; justify-self: end; }
  .shwm-lh .c { text-align: center; }
  .shwm-lh .i { display: inline-flex; width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgba(10,25,47,0.12); align-items: center; justify-content: center; font-size: 0.5rem; font-weight: 700; }
  .shwm-lr { padding: 7px 0; border-bottom: 1px solid rgba(10,25,47,0.07); }
  .shwm-lr .nm { display: flex; flex-direction: column; min-width: 0; font-size: 0.72rem; font-weight: 500; line-height: 1.3; }
  .shwm-lr .nm small { font-size: 0.58rem; color: #5b6472; }
  .shwm-lr .ls { font-size: 0.66rem; color: #5b6472; text-decoration: line-through; white-space: nowrap; }
  .shwm-lr .am { font-size: 0.72rem; white-space: nowrap; }
  .shwm-add { position: relative; display: flex; gap: 8px; }
  .shwm-srch { position: relative; flex: 1; display: flex; min-width: 0; }
  .shwm-srch .shwm-fd { justify-content: flex-start; }
  .shwm-srch .q { color: #0f1729; font-weight: 500; }
  .shwm-srch .q:empty { display: none; }
  .shwm-srch .ph { color: #99a2af; }
  .shwm-free { flex-shrink: 0; font-size: 0.66rem; font-weight: 600; color: #5b6472; background: #f5f5f7; border-radius: 9px; padding: 8px 11px; white-space: nowrap; }
