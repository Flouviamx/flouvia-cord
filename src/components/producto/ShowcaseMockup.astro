<script>
  import { gsap } from 'gsap';

  type Build = (root: HTMLElement, loc: string) => gsap.core.Timeline;
  const $ = <T extends Element = HTMLElement>(r: ParentNode, s: string) => r.querySelector<T>(s)!;
  const $$ = (r: ParentNode, s: string) => Array.from(r.querySelectorAll<HTMLElement>(s));
  const money = (loc: string, n: number, d = 2) => new Intl.NumberFormat(loc, { style: 'currency', currency: 'MXN', minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
  const num = (loc: string, n: number) => new Intl.NumberFormat(loc).format(n);
  const dwell = (s: number) => (s < 60 ? `${s}s` : `${Math.floor(s / 60)}m${s % 60 ? ` ${s % 60}s` : ''}`);
  const type = (tl: gsap.core.Timeline, el: HTMLElement, text: string, at: number, step = 0.1) => {
    for (let i = 1; i <= text.length; i++) tl.call(() => { el.textContent = text.slice(0, i); }, [], at + (i - 1) * step);
    return at + text.length * step;
  };
  const count = (tl: gsap.core.Timeline, el: HTMLElement, from: number, to: number, at: number, f: (n: number) => string, dur = 0.8) => {
    const o = { n: from };
    tl.fromTo(o, { n: from }, { n: to, duration: dur, ease: 'power2.out', onUpdate: () => { el.textContent = f(o.n); } }, at);
  };
  const flash = (tl: gsap.core.Timeline, els: Element[], at: number) =>
    tl.fromTo(els, { backgroundColor: 'rgba(16,185,129,0.16)' }, { backgroundColor: 'rgba(16,185,129,0)', duration: 1.2, clearProps: 'backgroundColor' }, at);
  const collapse = (els: Element | Element[]) => gsap.to(els, { height: 0, paddingTop: 0, paddingBottom: 0, marginTop: 0, marginBottom: 0, borderBottomWidth: 0, opacity: 0, overflow: 'hidden', duration: 0.42, ease: 'power2.inOut' });
  const expand = (els: Element | Element[]) => {
    gsap.set(els, { clearProps: 'all' });
    gsap.from(els, { height: 0, paddingTop: 0, paddingBottom: 0, marginTop: 0, marginBottom: 0, opacity: 0, overflow: 'hidden', duration: 0.5, ease: 'power2.out', clearProps: 'all' });
  };
  const hold = (tl: gsap.core.Timeline, at: number, d: number) => tl.to({}, { duration: d }, at);
  const pill = (el: HTMLElement, cls: string, text: string) => { el.className = el.className.replace(/\b(draft|sent|viewed|approved)\b/, cls); el.textContent = text; };

  const BUILD: Record<string, Build> = {
    ed0(root, loc) {
      const btn = $(root, '[data-aibtn]'), st = $(root, '[data-aist]'), lines = $$(root, '[data-line]');
      const sum = $(root, '.shwm-sum'), cnt = $(sum, '[data-count]'), vals = $$(sum, '[data-v]');
      const idle = btn.textContent || '';
      const tl = gsap.timeline({ repeat: -1 });
      tl.to([st, ...lines, ...vals], { opacity: 0, duration: 0.3 }, 0.6)
        .call(() => { cnt.textContent = sum.dataset.empty || ''; vals.forEach((v) => { v.textContent = money(loc, 0); }); }, [], 0.92)
        .set(vals, { opacity: 1 }, 0.95)
        .to(btn, { scale: 0.95, duration: 0.12, yoyo: true, repeat: 1 }, 1.8)
        .call(() => { btn.textContent = btn.dataset.busy || idle; }, [], 1.95)
        .call(() => { btn.textContent = idle; }, [], 3.4)
        .to(st, { opacity: 1, duration: 0.3 }, 3.4)
        .fromTo(lines, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.45, stagger: 0.12, ease: 'power2.out', clearProps: 'transform' }, 3.45)
        .call(() => { cnt.textContent = cnt.dataset.full || ''; }, [], 3.9);
      vals.forEach((v) => count(tl, v, 0, Number(v.dataset.v), 3.9, (n) => money(loc, n), 1));
      hold(tl, 5, 3.4);
      return tl;
    },

    ed1(root, loc) {
      const srch = $(root, '[data-search]'), q = $(root, '[data-q]'), ph = $(root, '[data-ph]'), drop = $(root, '[data-drop]');
      const row = $(root, '[data-newline]'), qty = $(row, '[data-qty]'), qv = $(qty, '[data-v]'), nego = $(row, '[data-nego]'), nv = $(nego, '[data-v]');
      const amt = $(row, '[data-amt]'), mg = $(row, '[data-mg]'), save = $(root, '[data-saveline]');
      const cnt = $(root, '[data-count]'), sub = $(root, '[data-sub]'), iva = $(root, '[data-iva]'), tot = $(root, '[data-tot]');
      const L = root.dataset.lines || '', P = root.dataset.pcs || '';
      const setSum = (lines: number, pcs: number, s: number) => {
        cnt.textContent = `${lines} ${L} · ${num(loc, pcs)} ${P}`;
        sub.textContent = money(loc, s); iva.textContent = money(loc, s * 0.16); tot.textContent = money(loc, s * 1.16);
      };
      const tl = gsap.timeline({ repeat: -1 });
      tl.call(() => { collapse([row, save]); setSum(2, 2520, 55920); }, [], 0.6)
        .call(() => srch.classList.add('is-focus'), [], 1)
        .call(() => { ph.style.display = 'none'; }, [], 1.2);
      let at = type(tl, q, 'var', 1.2, 0.12);
      tl.to(drop, { autoAlpha: 1, y: 0, duration: 0.2, startAt: { y: -4 } }, at + 0.05);
      at += 1.1;
      tl.to(drop, { autoAlpha: 0, duration: 0.15 }, at)
        .call(() => {
          q.textContent = ''; ph.style.display = ''; srch.classList.remove('is-focus');
          qv.textContent = '1'; nv.textContent = '191.48'; nego.classList.remove('deal'); amt.textContent = money(loc, 191.48); mg.textContent = '28%';
          expand(row); setSum(3, 2521, 56111.48);
        }, [], at + 0.05);
      flash(tl, [row], at + 0.1);
      tl.call(() => { qty.classList.add('is-focus'); qv.textContent = ''; }, [], at + 0.5);
      let t2 = type(tl, qv, '340', at + 0.6, 0.12);
      tl.call(() => { qty.classList.remove('is-focus'); amt.textContent = money(loc, 65103.2); setSum(3, 2860, 121023.2); }, [], t2 + 0.05)
        .call(() => { nego.classList.add('is-focus'); nv.textContent = ''; }, [], t2 + 0.3);
      t2 = type(tl, nv, '168.50', t2 + 0.4, 0.1);
      tl.call(() => { nego.classList.remove('is-focus'); nego.classList.add('deal'); mg.textContent = '18%'; expand(save); }, [], t2 + 0.05);
      count(tl, amt, 65103.2, 57290, t2 + 0.05, (n) => money(loc, n));
      count(tl, sub, 121023.2, 113210, t2 + 0.05, (n) => money(loc, n));
      count(tl, iva, 19363.71, 18113.6, t2 + 0.05, (n) => money(loc, n));
      count(tl, tot, 140386.91, 131323.6, t2 + 0.05, (n) => money(loc, n));
      flash(tl, [sub, iva, tot], t2 + 0.1);
      hold(tl, t2 + 1, 3.2);
      return tl;
    },

    ed2(root, loc) {
      const rows = $$(root, '.shwm-pdf-t .tr, .shwm-pdf-tot > span');
      const sumTot = $(root, '[data-tot]'), pdfTot = $(root, '.shwm-pdf-tot .g .editorial');
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(rows, { opacity: 0, duration: 0.3 }, 0.8)
        .call(() => { sumTot.textContent = money(loc, 0); pdfTot.textContent = money(loc, 0); }, [], 1.1)
        .fromTo(rows, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.45, stagger: 0.1, ease: 'power2.out', clearProps: 'transform' }, 1.3);
      count(tl, sumTot, 0, 196469.2, 1.4, (n) => money(loc, n), 1.1);
      count(tl, pdfTot, 0, 196469.2, 1.9, (n) => money(loc, n), 1.1);
      flash(tl, [sumTot, pdfTot], 3.1);
      hold(tl, 3.4, 4);
      return tl;
    },

    lp0(root) {
      const reply = $(root, '[data-reply]'), status = $(root, '[data-wastatus]'), done = $(root, '[data-done]'), cta = $(root, '[data-cta]'), tap = $(root, '[data-tap]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.to([reply, done], { autoAlpha: 0, duration: 0.3 }, 0.6)
        .set(reply, { display: 'none' }, 0.92)
        .set(tap, { scale: 0.4, autoAlpha: 0 }, 0.92)
        .to(tap, { autoAlpha: 1, scale: 1, duration: 0.25 }, 1.7)
        .to(cta, { scale: 0.95, duration: 0.12, yoyo: true, repeat: 1 }, 1.8)
        .to(tap, { autoAlpha: 0, scale: 1.6, duration: 0.4 }, 2)
        .fromTo(done, { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, duration: 0.45, ease: 'power2.out' }, 2.2)
        .fromTo(done.querySelector('.ring'), { scale: 0.6 }, { scale: 1, duration: 0.5, ease: 'back.out(1.8)' }, 2.3)
        .call(() => { status.textContent = status.dataset.typing || ''; }, [], 3)
        .call(() => { status.textContent = status.dataset.idle || ''; }, [], 4)
        .set(reply, { display: '' }, 4)
        .fromTo(reply, { autoAlpha: 0, y: 8, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.4, ease: 'back.out(1.6)', transformOrigin: '100% 100%' }, 4)
        .to(done, { autoAlpha: 0, duration: 0.4 }, 7.2);
      hold(tl, 7.6, 1.2);
      return tl;
    },

    lp1(root) {
      const card = $(root, '.shwm-qc-lg');
      const parts = $$(card, ':scope > *');
      const tl = gsap.timeline({ repeat: -1 });
      tl.fromTo(parts, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.55, stagger: 0.09, ease: 'power2.out', clearProps: 'transform' }, 0.4);
      hold(tl, 1.5, 6.5);
      return tl;
    },

    lp2(root) {
      const ring = $(root, '.shwm-qc-ok .ring'), pay = $(root, '[data-pay]'), cta = $(pay, '[data-cta]'), mail = $(root, '[data-mail]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.to([pay, mail], { autoAlpha: 0, duration: 0.3 }, 0.5)
        .fromTo(ring, { scale: 0.5, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.55, ease: 'back.out(1.8)' }, 1.2)
        .fromTo(pay, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, 1.8)
        .fromTo(mail, { autoAlpha: 0, x: 24 }, { autoAlpha: 1, x: 0, duration: 0.6, ease: 'power3.out' }, 2.4)
        .to(cta, { boxShadow: '0 10px 22px -10px rgba(180,83,9,0.55), 0 0 0 6px rgba(180,83,9,0.14)', duration: 0.7, yoyo: true, repeat: 3, ease: 'sine.inOut' }, 3.3);
      hold(tl, 6, 2);
      return tl;
    },

    tr0(root) {
      const nt = $(root, '[data-nt]'), row = $(root, '[data-new]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(nt, { autoAlpha: 0, y: -14, duration: 0.3 }, 0.6)
        .call(() => collapse(row), [], 0.7)
        .fromTo(nt, { autoAlpha: 0, y: -18, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.55, ease: 'back.out(1.5)' }, 2.2)
        .call(() => expand(row), [], 2.5);
      flash(tl, [row], 2.6);
      hold(tl, 3.2, 4.4);
      return tl;
    },

    tr1(root) {
      const lv = $(root, '[data-lv]'), aps = $(root, '[data-aps]'), last = $(root, '[data-last]'), total = $(root, '[data-total]');
      const word = root.dataset.ap || '';
      const bars = $$(root, '.shwm-at2-b .r');
      const secs = bars.map((b) => Number(b.dataset.s || 0));
      const hot = secs.indexOf(Math.max(...secs));
      const now = last.textContent || '', before = last.dataset.was || '';
      const paint = (p: number, d: number) => {
        const s = secs.slice(); s[hot] = p;
        const max = Math.max(...s);
        bars.forEach((b, i) => { gsap.to($(b, '.fl'), { width: `${Math.round((s[i] / max) * 100)}%`, duration: d, ease: 'power2.out' }); $(b, '.v').textContent = dwell(s[i]); });
        total.textContent = dwell(s.reduce((a, c) => a + c, 0));
      };
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(lv, { autoAlpha: 0, scale: 0.92, duration: 0.3 }, 0.6)
        .call(() => { aps.textContent = `2 ${word}`; last.textContent = before; paint(secs[hot] - 30, 0.4); }, [], 0.8)
        .fromTo(lv, { autoAlpha: 0, scale: 0.92 }, { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'back.out(2)' }, 2.2)
        .call(() => { aps.textContent = `3 ${word}`; last.textContent = now; }, [], 2.25);
      flash(tl, [aps, last], 2.25);
      tl.call(() => paint(secs[hot] - 20, 0.5), [], 3.6)
        .call(() => paint(secs[hot] - 10, 0.5), [], 4.8)
        .call(() => paint(secs[hot], 0.5), [], 6);
      hold(tl, 6.2, 2);
      return tl;
    },

    tr2(root, loc) {
      const line = $<SVGPathElement>(root, '[data-line]'), area = $(root, '[data-area]'), hero = $(root, '[data-hero]'), gauge = $(root, '[data-gauge]');
      const len = line.getTotalLength ? line.getTotalLength() : 700;
      const tl = gsap.timeline({ repeat: -1 });
      tl.set(line, { strokeDasharray: len, strokeDashoffset: len }, 0.4)
        .set(area, { opacity: 0 }, 0.4)
        .set(gauge, { attr: { 'stroke-dashoffset': 163.4 } }, 0.4)
        .to(line, { strokeDashoffset: 0, duration: 1.6, ease: 'power2.inOut' }, 0.6)
        .to(area, { opacity: 1, duration: 0.8 }, 1.4)
        .to(gauge, { attr: { 'stroke-dashoffset': 96.4 }, duration: 1, ease: 'power2.out' }, 1);
      count(tl, hero, 0, 920400, 0.6, (n) => money(loc, n), 1.6);
      hold(tl, 2.4, 5.2);
      return tl;
    },

    ap0(root, loc) {
      const nego = $(root, '[data-nego]'), v = $(nego, '[data-v]'), amt = $(root, '[data-amt]'), mg = $(root, '[data-mg]');
      const sub = $(root, '[data-sub]'), save = $(root, '[data-save]'), iva = $(root, '[data-iva]'), tot = $(root, '[data-tot]');
      const send = $(root, '[data-send]'), toast = $(root, '[data-toast]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(toast, { autoAlpha: 0, y: 10, duration: 0.3 }, 0.5)
        .call(() => {
          nego.classList.remove('is-focus'); v.textContent = '176.00'; amt.textContent = money(loc, 140800);
          mg.textContent = '22%'; mg.classList.remove('low');
          sub.textContent = money(loc, 229360); save.textContent = `−${money(loc, 19704)}`; iva.textContent = money(loc, 36697.6); tot.textContent = money(loc, 266057.6);
        }, [], 0.85)
        .call(() => { nego.classList.add('is-focus'); v.textContent = ''; }, [], 1.8);
      const end = type(tl, v, '149.00', 1.95, 0.12);
      tl.call(() => { mg.textContent = '7%'; mg.classList.add('low'); save.textContent = `−${money(loc, 37464)}`; }, [], end + 0.05)
        .fromTo(mg, { scale: 1.25 }, { scale: 1, duration: 0.35, ease: 'back.out(2)' }, end + 0.05);
      count(tl, amt, 140800, 119200, end + 0.05, (n) => money(loc, n));
      count(tl, sub, 229360, 207760, end + 0.05, (n) => money(loc, n));
      count(tl, iva, 36697.6, 33241.6, end + 0.05, (n) => money(loc, n));
      count(tl, tot, 266057.6, 241001.6, end + 0.05, (n) => money(loc, n));
      tl.to(send, { scale: 0.96, duration: 0.12, yoyo: true, repeat: 1 }, end + 1.5)
        .fromTo(toast, { autoAlpha: 0, y: 12, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.45, ease: 'back.out(1.6)' }, end + 1.8);
      hold(tl, end + 2.3, 3);
      return tl;
    },

    ap1(root) {
      const nt = $(root, '[data-nt]'), banner = $(root, '[data-banner]'), ok = $(root, '[data-ok]');
      const pp = $(root, '[data-pill]'), rp = $(root, '[data-rpill]'), row = $(root, '[data-row]'), n = $(root, '[data-appn]');
      const draft = pp.textContent || '', sent = pp.dataset.to || '';
      const tl = gsap.timeline({ repeat: -1 });
      tl.call(() => { if (banner.style.height) expand(banner); pill(pp, 'draft', draft); pill(rp, 'draft', draft); n.textContent = '1'; }, [], 0.5)
        .fromTo(nt, { autoAlpha: 0, y: -16 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'back.out(1.5)' }, 1)
        .to(nt, { autoAlpha: 0, y: -16, duration: 0.35 }, 3)
        .to(ok, { scale: 0.95, duration: 0.12, yoyo: true, repeat: 1 }, 3.4)
        .call(() => { collapse(banner); pill(pp, 'sent', sent); }, [], 3.7)
        .call(() => { pill(rp, 'sent', sent); n.textContent = '0'; }, [], 4.3);
      flash(tl, [row], 4.3);
      hold(tl, 5, 2.6);
      return tl;
    },

    ap2(root) {
      const rows = $$(root, '[data-arow]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(rows, { opacity: 0, duration: 0.3 }, 0.6)
        .fromTo(rows.slice().reverse(), { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.45, stagger: 0.35, ease: 'power2.out', clearProps: 'transform' }, 1.2);
      flash(tl, [rows[0]], 2.1);
      hold(tl, 2.8, 4.4);
      return tl;
    },
    // pf:start
    pg0(root) {
      const front = $(root, '[data-idc="front"]'), back = $(root, '[data-idc="back"]'), done = $(root, '[data-idc="done"]');
      const dotsBox = $(root, '[data-dots]'), dots = $$(dotsBox, 'i'), cta = $(root, '[data-cta]'), cta2 = $(root, '[data-cta2]');
      const badge = $(root, '[data-badge]'), verify = $(root, '[data-verify]'), card = $(root, '[data-cur]');
      const idle = badge.textContent || '', to = badge.dataset.to || '';
      const setDots = (k: number) => dots.forEach((d, i) => { d.className = i < k ? 'done' : i === k ? 'on' : ''; });
      const tl = gsap.timeline({ repeat: -1 });
      tl.call(() => { setDots(0); badge.textContent = idle; badge.className = 'bd'; }, [], 0)
        .set([back, done], { autoAlpha: 0, x: 0, scale: 1 }, 0)
        .set(front, { autoAlpha: 1, x: 0 }, 0)
        .set(dotsBox, { autoAlpha: 1 }, 0)
        .to(verify, { scale: 0.94, duration: 0.12, yoyo: true, repeat: 1 }, 0.9)
        .to(cta, { scale: 0.96, duration: 0.12, yoyo: true, repeat: 1 }, 2.1)
        .to(front, { autoAlpha: 0, x: -14, duration: 0.3 }, 2.45)
        .fromTo(back, { autoAlpha: 0, x: 14 }, { autoAlpha: 1, x: 0, duration: 0.4, ease: 'power2.out' }, 2.6)
        .call(() => setDots(1), [], 2.6)
        .to(cta2, { scale: 0.96, duration: 0.12, yoyo: true, repeat: 1 }, 3.9)
        .to([back, dotsBox], { autoAlpha: 0, duration: 0.3 }, 4.25)
        .fromTo(done, { autoAlpha: 0, scale: 0.94 }, { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'back.out(1.6)' }, 4.4)
        .call(() => { badge.textContent = to; badge.className = 'bd wait'; }, [], 5.2);
      flash(tl, [card], 5.2);
      tl.to(done, { autoAlpha: 0, duration: 0.35 }, 8.2)
        .to([front, dotsBox], { autoAlpha: 1, duration: 0.35 }, 8.4);
      hold(tl, 8.75, 0.4);
      return tl;
    },

    pg1(root) {
      const fills = $$(root, '[data-fill]'), pdf = $(root, '[data-pdf]'), send = $(root, '[data-send]'), hls = $$(pdf, '.hl');
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(fills, { color: 'rgba(15,23,41,0)', duration: 0.3 }, 0.5)
        .to(pdf, { autoAlpha: 0, x: 28, duration: 0.35 }, 0.5)
        .to(fills, { color: '#0f1729', duration: 0.35, stagger: 0.16 }, 1.3)
        .fromTo(fills, { backgroundColor: 'rgba(16,185,129,0.16)' }, { backgroundColor: 'rgba(250,251,252,1)', duration: 1, stagger: 0.16, clearProps: 'backgroundColor' }, 1.3)
        .fromTo(pdf, { autoAlpha: 0, x: 28 }, { autoAlpha: 1, x: 0, duration: 0.6, ease: 'power3.out' }, 2.5)
        .fromTo(hls, { backgroundColor: 'rgba(16,185,129,0.2)' }, { backgroundColor: 'rgba(10,25,47,0.05)', duration: 1.2, stagger: 0.12 }, 3.1)
        .to(send, { scale: 0.96, duration: 0.12, yoyo: true, repeat: 1 }, 4.4);
      hold(tl, 4.7, 3.2);
      return tl;
    },

    pg2(root) {
      const pill = $(root, '[data-pill]'), s4 = $(root, '[data-s4]'), s5 = $(root, '[data-s5]'), reg = $(root, '[data-reg]');
      const paid = $(root, '[data-ev="paid"]'), dup = $(root, '[data-ev="dup"]');
      const s4d = $(s4, '.d'), chkHtml = s4d.innerHTML, was = pill.dataset.was || '', now = pill.textContent || '';
      const tl = gsap.timeline({ repeat: -1 });
      tl.call(() => {
        collapse([paid, dup]); reg.classList.remove('is-gone'); expand(reg);
        pill.className = 'shwm-sts approved'; pill.textContent = was;
        s4.className = 's cur'; s4d.innerHTML = '4'; s5.className = 's';
      }, [], 0.5)
        .call(() => {
          expand(paid); collapse(reg);
          pill.className = 'shwm-sts paid'; pill.textContent = now;
          s4.className = 's done'; s4d.innerHTML = chkHtml; s5.className = 's cur';
        }, [], 2.4);
      flash(tl, [paid, pill], 2.5);
      tl.call(() => expand(dup), [], 4.4)
        .fromTo(dup, { backgroundColor: 'rgba(245,158,11,0.18)' }, { backgroundColor: 'rgba(245,158,11,0)', duration: 1.4, clearProps: 'backgroundColor' }, 4.5);
      hold(tl, 5.2, 3);
      return tl;
    },

    // pf:end
  };

  const init = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-shx]').forEach((root) => {
      const build = BUILD[root.dataset.shx || ''];
      const panel = root.closest<HTMLElement>('.shw-panel');
      if (!build || !panel) return;
      const loc = root.closest<HTMLElement>('[data-loc]')?.dataset.loc || 'es-MX';
      let tl: gsap.core.Timeline | null = null;
      let seen = false;
      let wasActive = false;
      const sync = () => {
        const active = seen && panel.classList.contains('shw-panel-active');
        if (active && !wasActive) { tl ??= build(root, loc); tl.restart(); }
        else if (!active && wasActive) tl?.pause();
        wasActive = active;
      };
      new MutationObserver(sync).observe(panel, { attributes: true, attributeFilter: ['class'] });
      new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }, { threshold: 0.25 }).observe(panel.parentElement || panel);
    });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>
