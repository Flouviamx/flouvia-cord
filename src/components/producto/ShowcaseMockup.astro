        .fromTo(sil, { backgroundColor: 'rgba(245,158,11,0.34)' }, { backgroundColor: 'rgba(245,158,11,0.12)', duration: 1.2, clearProps: 'backgroundColor' }, 2.5)
        .to(wa, { scale: 0.95, duration: 0.12, yoyo: true, repeat: 1 }, 3.4);
      hold(tl, 3.7, 3.8);
      return tl;
    },

    cc1(root) {
      const hb = $(root, '[data-hb]'), fills = $$(hb, '.t i'), tip = $(root, '[data-tip]');
      const widths = fills.map((f) => f.style.width);
      const tl = gsap.timeline({ repeat: -1 });
      tl.call(() => hb.classList.remove('is-dim'), [], 0.4)
        .set(tip, { autoAlpha: 0 }, 0.4)
        .set(fills, { width: '0%' }, 0.45);
      fills.forEach((f, i) => tl.to(f, { width: widths[i], duration: 0.8, ease: 'power2.out' }, 0.6 + i * 0.08));
      tl.call(() => hb.classList.add('is-dim'), [], 2.3)
        .fromTo(tip, { autoAlpha: 0, y: 4 }, { autoAlpha: 1, y: 0, duration: 0.3 }, 2.35);
      hold(tl, 2.7, 4.6);
      return tl;
    },

    cc2(root, loc) {
      const ask = $(root, '[data-ask]'), st = $(root, '[data-wast]'), nego = $(root, '[data-nego]'), ced = $(root, '[data-ced]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.set(ask, { autoAlpha: 0, display: 'none' }, 0.4)
        .call(() => { st.textContent = st.dataset.typing || ''; }, [], 1)
        .call(() => { st.textContent = st.dataset.idle || ''; }, [], 2.2)
        .set(ask, { display: '' }, 2.2)
        .fromTo(ask, { autoAlpha: 0, y: 8, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.4, ease: 'back.out(1.6)', transformOrigin: '0% 100%' }, 2.2);
      count(tl, ced, 0, 84300, 3, (v) => `MXN ${num(loc, Math.round(v))}`, 1);
      tl.fromTo(nego, { backgroundColor: 'rgba(245,158,11,0.14)' }, { backgroundColor: 'rgba(245,158,11,0)', duration: 1.6, clearProps: 'backgroundColor' }, 3);
      hold(tl, 4.6, 3);
      return tl;
    },

    fn0(root) {
      const bars = $$(root, '[data-vb] i'), late = $(root, '[data-late]'), p44 = $(root, '[data-p44]'), rul = $(root, '[data-rul]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.fromTo(bars, { scaleY: 0 }, { scaleY: 1, duration: 0.7, stagger: 0.1, ease: 'power2.out' }, 0.4)
        .fromTo(rul, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.55, ease: 'power3.out' }, 1.2)
        .set(p44, { autoAlpha: 0 }, 1.2)
        .fromTo(late, { scaleX: 0 }, { scaleX: 1, duration: 0.9, ease: 'power2.inOut' }, 2)
        .to(p44, { autoAlpha: 1, duration: 0.35 }, 2.8);
      hold(tl, 3.2, 4.2);
      return tl;
    },

    fn1(root) {
      const rings = $$(root, '[data-ring]'), conc = $(root, '[data-conc]'), fills = $$(conc, '.t i');
      const widths = fills.map((f) => f.style.width);
      const tl = gsap.timeline({ repeat: -1 });
      tl.set(rings, { attr: { 'stroke-dashoffset': 175.93 } }, 0.4);
      rings.forEach((r, i) => tl.to(r, { attr: { 'stroke-dashoffset': Number(r.dataset.ring) }, duration: 0.9, ease: 'power2.out' }, 0.55 + i * 0.12));
      tl.fromTo(conc, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.55, ease: 'power3.out' }, 1.8)
        .set(fills, { width: '0%' }, 1.8);
      fills.forEach((f, i) => tl.to(f, { width: widths[i], duration: 0.7, ease: 'power2.out' }, 2 + i * 0.08));
      hold(tl, 3, 4.4);
      return tl;
    },

    fn2(root) {
      const rows = $$(root, '[data-fw] .w'), out = $(root, '[data-out]'), sum = $(root, '[data-sum]'), total = $(root, '[data-total]');
      const tl = gsap.timeline({ repeat: -1 });
      tl.fromTo(rows, { opacity: 0, x: -6 }, { opacity: 1, x: 0, duration: 0.3, stagger: 0.06, ease: 'power2.out', clearProps: 'transform' }, 0.4)
        .fromTo(out, { boxShadow: '0 0 0 1.5px rgba(10,25,47,0.5), 0 14px 32px -22px rgba(10,25,47,0.22)' }, { boxShadow: '0 0 0 1.5px rgba(10,25,47,0.14), 0 14px 32px -22px rgba(10,25,47,0.22)', duration: 1.4, clearProps: 'boxShadow' }, 1.4)
        .fromTo(sum, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.55, ease: 'power3.out' }, 2);
      flash(tl, [total], 2.7);
      hold(tl, 3.2, 4.2);
      return tl;
    },

    // pf:end
  };

  const init = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-shx]').forEach((root) => {
      const build = BUILD[root.dataset.shx || ''];
      const panel = root.closest<HTMLElement>('.shw-panel');
      if (!build || !panel) return;
      const loc = root.closest<HTMLElement>('[data-loc]')?.dataset.loc || 'es-MX';
      let tl: gsap.core.Timeline | null = null;
      let seen = false;
      let wasActive = false;
      const sync = () => {
        const active = seen && panel.classList.contains('shw-panel-active');
        if (active && !wasActive) { tl ??= build(root, loc); tl.restart(); }
        else if (!active && wasActive) tl?.pause();
        wasActive = active;
      };
      new MutationObserver(sync).observe(panel, { attributes: true, attributeFilter: ['class'] });
      new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }, { threshold: 0.25 }).observe(panel.parentElement || panel);
    });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>
