---
// "Cobra en los 12 países" — /producto/facturacion (ES y EN).
//
// Una pestaña por país con la calca de la página pública de la factura
// (src/pages/i/[token].astro) tal como la ve un cliente en el teléfono: dos
// recortes de la MISMA página, arriba (negocio, folio, saldo) y abajo (el
// cobro, después de pulsar Pagar). Las clases `icp-iv-*` espejan una a una las
// `.iv-*` de esa página, con sus valores en la variante ≤640 px; los textos
// salen de las mismas claves de src/i18n/app.ts o, donde la página los escribe
// en línea, de IV_LITERAL. Qué botones aparecen lo deciden las funciones reales
// de la página (`publicInvoicePayability`, `publicInvoiceGuidance`).
//
// Todo dato se deriva en src/lib/producto-facturacion-paises.ts.
import { t } from '../../i18n/app';
import { flagSrc } from '../../lib/flags';
import { iconInner } from '../../lib/icons';
import { MP_MARK } from '../../lib/brand-marks';
import { paisesCobro, resumenMetodos, COBRO_COPY, IV_LITERAL } from '../../lib/producto-facturacion-paises';

interface Props { isEn?: boolean }
const { isEn = false } = Astro.props;
const L = isEn ? 'en' : 'es';
const C = COBRO_COPY[L];
const T = (k: Parameters<typeof t>[1]) => t(L, k);
const paises = paisesCobro(L, T);
const resumen = resumenMetodos(L);
const lit = (k: keyof typeof IV_LITERAL) => IV_LITERAL[k][L];
// Diferencia intencional con /i: ahí el saldo mide 2.65rem fijo a 390 px y un
// importe largo con código de divisa (COP 33,343,800.00, unido por un espacio
// no separable) desborda el recuadro. En la calca se reduce solo cuando no cabe.
const ajuste = (s: string) => {
    const n = [...s].length;
    return n > 13 ? `font-size:${(2.65 * 13 / n).toFixed(2)}rem;` : '';
};

const FAV = (domain: string) => `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${domain}&size=64`;
const MP_LOGO = FAV('mercadopago.com');
const CARD_BRANDS: [string, string][] = [['visa.com', 'Visa'], ['mastercard.com', 'Mastercard'], ['americanexpress.com', 'American Express']];
// Ilustración del campo de código de seguridad (reverso de tarjeta), no un icono de la app.
const CVC_ART = '<rect x="1" y="3" width="22" height="16" rx="2.5" fill="#e6e6e6"/><rect x="1" y="6.5" width="22" height="3" fill="#a3acb9"/><rect x="13" y="12" width="7" height="4" rx="1" fill="#fff"/>';
---

<section class="icp" aria-labelledby="icp-title" data-icp>
    <div class="icp-intro">
        <div class="icp-intro-copy">
            <h2 id="icp-title" class="icp-h2 masked-title">{C.title}</h2>
            <p class="icp-sub reveal">{C.sub}</p>
        </div>
        <div class="icp-check reveal">
            <ul>
                {resumen.disponibles.map((r) => (
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('check-circle')} />
                        <span><b>{r.label}</b><small>{r.detalle}</small></span>
                    </li>
                ))}
            </ul>
            {resumen.proximos.length > 0 && (
                <p class="icp-soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('clock')} />
                    <span><b>{C.soon}</b>{resumen.proximos.map((x) => <span class="icp-soon-i">{x.label} <small>({x.paises})</small></span>)}</span>
                </p>
            )}
        </div>
    </div>

    <div class="icp-body reveal">
        <div class="icp-tabs" role="tablist" aria-label={C.tablist} aria-orientation="vertical">
            {paises.map((p, i) => (
                <button type="button" role="tab" class="icp-tab" id={`icp-tab-${p.code}`} aria-controls={`icp-panel-${p.code}`}
                        aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                    <img class="icp-flag" src={flagSrc(p.flagCode)} alt="" width="24" height="24" loading="lazy" decoding="async" />
                    <span class="icp-tab-id">
                        <b>{p.name}</b>
                        <small>{[p.currency, ...p.metodos.filter((m) => m.estado === 'live').map((m) => m.label)].join(' · ')}</small>
                    </span>
                </button>
            ))}
        </div>

        <div class="icp-panels">
            {paises.map((p, i) => {
                const iv = p.iv;
                const fm = iv.formulario;
                return (
                    <div class="icp-panel" role="tabpanel" id={`icp-panel-${p.code}`} aria-labelledby={`icp-tab-${p.code}`} tabindex="0" hidden={i !== 0}>
                        <div class="icp-stage" aria-hidden="true">
                            <div class="icp-orb icp-orb-top"></div>
                            <div class="icp-orb icp-orb-bottom" style={`background: radial-gradient(circle, ${iv.color}14 0%, transparent 70%)`}></div>

                            {/* Recorte 1: el principio de la página. */}
                            <div class="icp-shot icp-shot-top">
                                <div class="icp-iv-main">
                                    <article class="icp-iv-card">
                                        {iv.proforma && <div class="icp-iv-note">{lit('proformaNota')}</div>}
                                        <header class="icp-iv-head">
                                            <div class="icp-iv-brand">
                                                <span class="icp-iv-brand-mark" style={`background:${iv.color}`}>{iv.org.slice(0, 1).toUpperCase()}</span>
                                                <span class="icp-iv-brand-copy"><strong>{iv.org}</strong><small>{iv.taxIdLabel} {iv.taxId}</small></span>
                                            </div>
                                            <div class="icp-iv-folio-tag"><span>{iv.titulo}</span><strong>{iv.numero}</strong></div>
                                        </header>
                                        <div class="icp-iv-rule"></div>
                                        <section class="icp-iv-total-hero">
                                            <span class="icp-iv-total-label">{lit('saldoPendiente')}</span>
                                            <span class="icp-iv-amount editorial" style={`color:${iv.color};${ajuste(iv.saldo)}`}>{iv.saldo}</span>
                                            <div class="icp-iv-headmeta"><span class="icp-iv-chip icp-iv-chip-wait">{T('fact.p_estado_open')}</span></div>
                                            <p class="icp-iv-sub"><span>{T('fact.p_emitida')} {iv.emitida}</span><span>{T('fact.p_vence_el')} {iv.vence}</span></p>
                                        </section>
                                        <section class="icp-iv-next">
                                            <p>{iv.guidance}</p>
                                            <div class="icp-iv-next-actions">
                                                <span>{lit('refrescar')}</span>
                                                {iv.mailto && <span>{lit('escribir')}</span>}
                                                {iv.tel && <span>{lit('llamar')}</span>}
                                            </div>
                                        </section>
                                        <section class="icp-iv-parties">
                                            <div>
                                                <span class="icp-iv-label">{T('fact.p_de')}</span>
                                                <p class="icp-iv-party">{iv.legal}</p>
                                                <p class="icp-iv-party-sub">{iv.email}</p>
                                            </div>
                                            <div>
                                                <span class="icp-iv-label">{T('fact.p_para')}</span>
                                                <p class="icp-iv-party">{iv.cliente}</p>
                                                <p class="icp-iv-party-sub">{iv.taxIdLabel} {iv.clienteTaxId}</p>
                                            </div>
                                        </section>
                                        <p class="icp-iv-lines-hint">{lit('desliza')}</p>
                                        <section class="icp-iv-lines">
                                            <table>
                                                <thead><tr><th>{T('fact.p_concepto')}</th><th class="icp-iv-num">{T('fact.p_cant')}</th><th class="icp-iv-num">{T('fact.p_precio')}</th><th class="icp-iv-num">{T('fact.p_importe')}</th></tr></thead>
                                                <tbody>
                                                    {iv.lineas.map((l) => (
                                                        <tr><td>{l.d}</td><td class="icp-iv-num">{l.q}</td><td class="icp-iv-num editorial">{l.p}</td><td class="icp-iv-num editorial">{l.a}</td></tr>
                                                    ))}
                                                </tbody>
                                            </table>
                                        </section>
                                    </article>
                                </div>
                            </div>

                            {/* Recorte 2: el final de la página, ya con el formulario de pago abierto. */}
                            <div class="icp-shot icp-shot-bottom">
                                <div class="icp-iv-main">
                                    <article class="icp-iv-card icp-iv-card-cut">
                                        <section class="icp-iv-parties">
                                            <div>
                                                <span class="icp-iv-label">{T('fact.p_de')}</span>
                                                <p class="icp-iv-party">{iv.legal}</p>
                                                <p class="icp-iv-party-sub">{iv.email}</p>
                                            </div>
                                            <div>
                                                <span class="icp-iv-label">{T('fact.p_para')}</span>
                                                <p class="icp-iv-party">{iv.cliente}</p>
                                                <p class="icp-iv-party-sub">{iv.taxIdLabel} {iv.clienteTaxId}</p>
                                            </div>
                                        </section>
                                        <p class="icp-iv-lines-hint">{lit('desliza')}</p>
                                        <section class="icp-iv-lines">
                                            <table>
                                                <thead><tr><th>{T('fact.p_concepto')}</th><th class="icp-iv-num">{T('fact.p_cant')}</th><th class="icp-iv-num">{T('fact.p_precio')}</th><th class="icp-iv-num">{T('fact.p_importe')}</th></tr></thead>
                                                <tbody>
                                                    {iv.lineas.map((l) => (
                                                        <tr><td>{l.d}</td><td class="icp-iv-num">{l.q}</td><td class="icp-iv-num editorial">{l.p}</td><td class="icp-iv-num editorial">{l.a}</td></tr>
                                                    ))}
                                                </tbody>
                                            </table>
                                        </section>
                                        <section class="icp-iv-totals">
                                            {iv.totales.map((r) => (
                                                <div class:list={['icp-iv-row', { 'icp-iv-row-total': r.cls === 'total', 'icp-iv-row-due': r.cls === 'due' }]}><span>{r.k}</span><span class="editorial">{r.v}</span></div>
                                            ))}
                                        </section>
                                        {iv.pagos.length > 0 && (
                                            <section class="icp-iv-pagos">
                                                <span class="icp-iv-label">{T('fact.p_pagos')}</span>
                                                <ul>{iv.pagos.map((pg) => <li><span>{pg.cuando}</span><span class="editorial">{pg.monto}</span></li>)}</ul>
                                            </section>
                                        )}
                                        <footer class="icp-iv-foot">
                                            {iv.selector && (
                                                <div class="icp-iv-metodos">
                                                    <span class="icp-iv-metodos-legend">{T('pay.metodo_pago')}</span>
                                                    <div class="icp-iv-metodos-grid">
                                                        <span class="icp-iv-metodo on">{T('pay.tarjeta')}</span>
                                                        <span class="icp-iv-metodo">{T('fact.p_spei')}</span>
                                                    </div>
                                                </div>
                                            )}
                                            {(iv.puedePagar || iv.puedePagarMp) && <span class="icp-iv-pay-partial">{T('fact.p_pagar_otro')}</span>}
                                            {iv.puedePagarMp && (
                                                <Fragment>
                                                    {iv.puedePagar && <div class="icp-iv-or"><span>{T('pay.mp_o')}</span></div>}
                                                    <span class="icp-iv-mp">
                                                        <svg class="icp-iv-mp-logo" viewBox="0 0 24 24"><path fill="currentColor" d={MP_MARK} /></svg>
                                                        <span>{T('pay.mp_pagar')}</span>
                                                        <svg class="icp-iv-mp-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('arrow-up-right')} />
                                                    </span>
                                                </Fragment>
                                            )}
                                            <div class="icp-iv-dl">{iv.descargas.map((d) => <span>{d}</span>)}</div>
                                            {iv.fiscalId && <p class="icp-iv-uuid">{T('fact.p_folio_fiscal')} {iv.fiscalId}</p>}
                                            <p class="icp-iv-powered">{iv.org} · {T('fact.p_enviado_con')}</p>
                                        </footer>
                                    </article>
                                    <p class="icp-iv-aviso">{T('fact.p_aviso')}</p>
                                    {fm && (
                                        <div class="icp-iv-paywrap">
                                            <div class="icp-iv-payinner">
                                                <div class="icp-pe" lang={fm.text.locale}>
                                                    {fm.tabs.length > 1 && (
                                                        <div class="icp-pe-tabs">{fm.tabs.map((tab, ti) => <span class:list={['icp-pe-tab', { on: ti === 0 }]}>{tab}</span>)}</div>
                                                    )}
                                                    <div class="icp-pe-field">
                                                        <span class="icp-pe-label">{fm.text.number}</span>
                                                        <span class="icp-pe-input"><span class="icp-pe-ph">1234 1234 1234 1234</span><span class="icp-pe-brands">{CARD_BRANDS.map(([dom]) => <img src={FAV(dom)} alt="" width="16" height="16" loading="lazy" />)}</span></span>
                                                    </div>
                                                    <div class="icp-pe-row">
                                                        <div class="icp-pe-field">
                                                            <span class="icp-pe-label">{fm.text.expiry}</span>
                                                            <span class="icp-pe-input"><span class="icp-pe-ph">{fm.text.expiryPh}</span></span>
                                                        </div>
                                                        <div class="icp-pe-field">
                                                            <span class="icp-pe-label">{fm.text.cvc}</span>
                                                            <span class="icp-pe-input"><span class="icp-pe-ph">CVC</span><svg class="icp-pe-cvc" viewBox="0 0 24 22" set:html={CVC_ART} /></span>
                                                        </div>
                                                    </div>
                                                    <div class:list={['icp-pe-row', { 'icp-pe-row-1': !fm.text.postal }]}>
                                                        <div class="icp-pe-field">
                                                            <span class="icp-pe-label">{fm.text.country}</span>
                                                            <span class="icp-pe-input"><span>{fm.countryLabel}</span><svg class="icp-pe-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('chevron-down')} /></span>
                                                        </div>
                                                        {fm.text.postal && (
                                                            <div class="icp-pe-field">
                                                                <span class="icp-pe-label">{fm.text.postal}</span>
                                                                <span class="icp-pe-input"><span class="icp-pe-ph">{fm.text.postalPh}</span></span>
                                                            </div>
                                                        )}
                                                    </div>
                                                </div>
                                                <span class="icp-iv-pay" style={`background:${iv.color}`}>{T('fact.p_confirmar')}</span>
                                            </div>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>

                        <dl class="icp-facts">
                            <div>
                                <dt>{C.paga}</dt>
                                <dd class="icp-chips">
                                    {[...p.metodos].sort((a, b) => Number(a.estado !== 'live') - Number(b.estado !== 'live')).map((m) => (
                                        <span class:list={['icp-chip', { 'is-soon': m.estado !== 'live' }]}>
                                            {m.key === 'mercadopago'
                                                ? <img src={MP_LOGO} alt="" width="14" height="14" loading="lazy" />
                                                : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner(m.key === 'card' ? 'card' : 'bank')} />}
                                            {m.label}
                                            {m.estado !== 'live' && <em>{C.soon}</em>}
                                        </span>
                                    ))}
                                </dd>
                            </div>
                            <div>
                                <dt>{C.divisa}</dt>
                                <dd><b>{p.currency}</b><small>{C.divisaNota}</small></dd>
                            </div>
                            <div>
                                <dt>{C.recibes}</dt>
                                <dd>{p.payout.map((x, xi) => <span class:list={[{ 'icp-alt': xi > 0 }]}>{x}</span>)}</dd>
                            </div>
                            <div>
                                <dt>{C.idioma}</dt>
                                <dd>
                                    <span>{C.idiomaPagina}</span>
                                    <span>{C.idiomaPdf}: {p.pdfLang}</span>
                                    {iv.formulario && <span class="icp-alt">{C.idiomaTarjeta}</span>}
                                </dd>
                            </div>
                        </dl>
                        <a class="icp-guide" href={p.docsUrl}>
                            <span>{C.guia}: {p.name}</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')} />
                        </a>
                    </div>
                );
            })}
            <p class="icp-caption">{C.caption}</p>
        </div>
    </div>
</section>

<script>
    // Pestañas accesibles (patrón WAI-ARIA tablist): selección automática con
    // flechas, Inicio y Fin; tabindex móvil; aria-orientation sigue al layout.
    document.querySelectorAll<HTMLElement>('[data-icp]').forEach((root) => {
        const list = root.querySelector<HTMLElement>('[role="tablist"]');
        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        if (!list || !tabs.length) return;
        const vertical = window.matchMedia('(min-width: 1101px)');
        const orient = () => list.setAttribute('aria-orientation', vertical.matches ? 'vertical' : 'horizontal');
        orient();
        vertical.addEventListener('change', orient);

        const select = (i: number, focus: boolean) => {
            tabs.forEach((tab, j) => {
                const on = j === i;
                tab.setAttribute('aria-selected', on ? 'true' : 'false');
                tab.tabIndex = on ? 0 : -1;
                const panel = document.getElementById(tab.getAttribute('aria-controls') || '');
                if (panel) panel.hidden = !on;
            });
            const tab = tabs[i];
            if (focus) tab.focus({ preventScroll: true });
            // En móvil la lista es una fila con scroll: lleva la pestaña a la vista
            // sin mover la página.
            if (!vertical.matches) {
                const left = tab.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2;
                list.scrollTo({ left, behavior: 'smooth' });
            }
        };

        tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => select(i, false));
            tab.addEventListener('keydown', (e) => {
                const last = tabs.length - 1;
                let next = -1;
                if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
                else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
                else if (e.key === 'Home') next = 0;
                else if (e.key === 'End') next = last;
                if (next < 0) return;
                e.preventDefault();
                select(next, true);
            });
        });
    });
</script>

<style>
    .icp {
        max-width: 1360px;
        margin: 0 auto;
        padding: 6.5rem 5% 0;
    }
    .icp-intro {
        display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 3.5rem; align-items: start;
        margin: 0 0 3rem;
    }
    .icp-h2 {
        font-size: clamp(1.85rem, 2.9vw, 2.6rem);
        font-weight: 800; letter-spacing: -0.035em; line-height: 1.1;
        color: #050505; margin: 0; text-wrap: balance;
    }
    .icp-sub {
        font-size: 1.05rem; line-height: 1.6; color: var(--color-text-muted);
        margin: 1.1rem 0 0; text-wrap: pretty; max-width: 560px;
    }
    .icp-check { padding-top: 0.4rem; }
    .icp-check ul {
        list-style: none; margin: 0; padding: 0;
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem;
    }
    .icp-check li, .icp-soon {
        display: flex; align-items: flex-start; gap: 0.7rem;
        padding: 0.85rem 0; border-top: 1px solid rgba(10,25,47,0.08);
    }
    .icp-check svg { width: 20px; height: 20px; flex-shrink: 0; margin-top: 1px; color: #059669; }
    .icp-check li > span { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .icp-check b { font-size: 0.9rem; font-weight: 650; color: #0a192f; letter-spacing: -0.01em; }
    .icp-check small { font-size: 0.78rem; color: #8a94a3; }
    .icp-soon { margin: 0; border-bottom: 1px solid rgba(10,25,47,0.08); }
    .icp-soon svg { color: #b45309; }
    .icp-soon > span { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; font-size: 0.86rem; color: #334155; }
    .icp-soon b { margin-right: 0.15rem; }
    .icp-soon-i small { font-size: 0.76rem; }

    /* ── Cuerpo: pestañas + escenario ── */
    .icp-body {
        display: grid; grid-template-columns: 236px minmax(0, 1fr);
        gap: 2rem; align-items: start;
    }
    .icp-tabs { display: flex; flex-direction: column; gap: 2px; }
    .icp-tab {
        display: flex; align-items: center; gap: 0.75rem;
        width: 100%; min-height: 52px; padding: 0.45rem 0.8rem 0.45rem 0.6rem;
        border: 0; border-radius: 14px; background: transparent;
        font: inherit; text-align: left; color: #0a192f; cursor: pointer;
        transition: background 0.25s ease, box-shadow 0.25s ease;
    }
    .icp-tab:hover { background: rgba(10,25,47,0.035); }
    .icp-tab[aria-selected="true"] {
        background: #fff;
        box-shadow: 0 0 0 1px rgba(10,25,47,0.06), 0 2px 4px rgba(10,25,47,0.04), 0 12px 26px -14px rgba(10,25,47,0.18);
    }
    .icp-tab:focus-visible { outline: 2px solid rgba(10,25,47,0.4); outline-offset: 2px; }
    .icp-flag {
        width: 24px; height: 24px; flex-shrink: 0; border-radius: 50%;
        box-shadow: 0 0 0 1px rgba(10,25,47,0.08);
    }
    .icp-tab-id { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .icp-tab-id b { font-size: 0.88rem; font-weight: 650; letter-spacing: -0.01em; white-space: nowrap; }
    .icp-tab-id small { font-size: 0.7rem; color: #8a94a3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .icp-tab[aria-selected="false"] .icp-tab-id b { color: #475569; font-weight: 600; }

    .icp-panel[hidden] { display: none; }
    .icp-panel:focus-visible { outline: 2px solid rgba(10,25,47,0.3); outline-offset: 6px; border-radius: 28px; }

    /* El escenario es el fondo REAL de /i (.iv-bg, .iv-orb): #f3f2ef con dos orbes. */
