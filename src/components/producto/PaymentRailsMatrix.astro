---
import { SUPPORTED_COUNTRIES, countryName, supportsMercadoPago, supportsOnlinePayments } from '../../lib/countries';
import { payoutSpecFor, type PayoutFormat } from '../../lib/payout-fields';
import { flagSrc } from '../../lib/flags';

interface Props { isEn?: boolean }
const { isEn = false } = Astro.props;
const L = isEn ? 'en' : 'es';

const PAYOUT_SHORT: Partial<Record<PayoutFormat, [string, string]>> = {
    clabe: ['CLABE', 'CLABE'],
    iban: ['IBAN', 'IBAN'],
    us_aba: ['Routing + cuenta', 'Routing + account'],
    gb_sort: ['Sort code + cuenta', 'Sort code + account'],
    ca_transit: ['Transit + institución + cuenta', 'Transit + institution + account'],
    br_bank: ['Banco + agência + conta', 'Bank + branch + account'],
};

const rows = SUPPORTED_COUNTRIES.map((code) => {
    const cp = supportsOnlinePayments(code);
    const mp = supportsMercadoPago(code);
    const payout = PAYOUT_SHORT[payoutSpecFor(code).format];
    return {
        code,
        name: countryName(code, L),
        cp,
        mp,
        spei: cp && code === 'MX',
        payout: cp && payout ? payout[isEn ? 1 : 0] : null,
    };
});

const GROUPS = [
    { key: 'both', label: isEn ? 'Cord Payments and Mercado Pago' : 'Cord Payments y Mercado Pago', rows: rows.filter((r) => r.cp && r.mp) },
    { key: 'cp', label: 'Cord Payments', rows: rows.filter((r) => r.cp && !r.mp) },
    { key: 'mp', label: 'Mercado Pago', rows: rows.filter((r) => !r.cp && r.mp) },
].filter((g) => g.rows.length);

const total = rows.filter((r) => r.cp || r.mp).length;

const C = isEn ? {
    title: `Collect online in all ${total} countries where Cord operates.`,
    sub: 'Cord Payments charges cards straight to your bank account. Where it isn’t available, you collect through your own Mercado Pago account. In Mexico and Brazil you can have both.',
    caption: 'Online payment rails by country',
    th: ['Country', 'Online payments', 'Your client pays with', 'Monthly retainers', 'You receive it in'],
    primary: 'default',
    card: 'Card',
    mpAccount: 'Your Mercado Pago account',
    yes: 'Yes',
    no: 'No',
    notes: [
        'Both rails charge the same things from the link: the full amount, the deposit and the balance, or each installment.',
        'SPEI appears only on quotes in Mexican pesos. Where both rails exist, Cord Payments is offered first and Mercado Pago as the alternative.',
        `In all ${total} countries your account quotes, invoices and tracks collections the same way; this table only changes how you get paid online.`,
    ],
} : {
    title: `Cobra en línea en los ${total} países donde opera Cord.`,
    sub: 'Cord Payments cobra con tarjeta directo a tu cuenta bancaria. Donde no está disponible, cobras con tu propia cuenta de Mercado Pago. En México y Brasil puedes tener los dos.',
    caption: 'Rieles de cobro en línea por país',
    th: ['País', 'Cobro en línea', 'Tu cliente paga con', 'Igualas mensuales', 'Lo recibes en'],
    primary: 'principal',
    card: 'Tarjeta',
    mpAccount: 'Tu cuenta de Mercado Pago',
    yes: 'Sí',
    no: 'No',
    notes: [
        'Con los dos rieles el link cobra lo mismo: el total, el anticipo y el saldo, o cada cuota.',
        'SPEI aparece solo en cotizaciones en pesos mexicanos. Donde conviven los dos rieles, Cord Payments se ofrece primero y Mercado Pago como alternativa.',
        `En los ${total} países tu cuenta cotiza, factura y lleva la cobranza igual; la tabla solo cambia cómo te pagan en línea.`,
    ],
};

const MP_LOGO = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://mercadopago.com&size=128';
---

<section class="prm" aria-labelledby="prm-title">
    <div class="prm-intro">
        <h2 id="prm-title" class="prm-h2 masked-title">{C.title}</h2>
        <p class="prm-sub reveal">{C.sub}</p>
    </div>

    <div class="prm-card reveal">
        <table class="prm-table">
            <caption class="prm-sr">{C.caption}</caption>
            <thead>
                <tr>{C.th.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            {GROUPS.map((g) => (
                <tbody class={`prm-group prm-group-${g.key}`}>
                    <tr class="prm-group-row"><th scope="rowgroup" colspan="5">{g.label}</th></tr>
                    {g.rows.map((r) => (
                        <tr class="prm-row">
                            <th scope="row" data-label={C.th[0]}>
                                <span class="prm-country">
                                    <img class="prm-flag" src={flagSrc(r.code)} alt="" width="24" height="24" loading="lazy" decoding="async" />
                                    <span class="prm-name">{r.name}</span>
                                </span>
                            </th>
                            <td data-label={C.th[1]}>
                                <span class="prm-rails">
                                    {r.cp && (
                                        <span class="prm-rail prm-rail-cp">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="currentColor" fill-opacity="0.12" /><path d="M2.5 10h19" /><path d="M6.5 15h4" /></svg>
                                            Cord Payments
                                            {r.mp && <em>{C.primary}</em>}
                                        </span>
                                    )}
                                    {r.mp && (
                                        <span class="prm-rail prm-rail-mp">
                                            <img src={MP_LOGO} alt="" width="16" height="16" loading="lazy" />
                                            Mercado Pago
                                        </span>
                                    )}
                                </span>
                            </td>
                            <td data-label={C.th[2]}>
                                <span class="prm-methods">
                                    {r.cp && <span class="prm-chip">{C.card}</span>}
                                    {r.spei && <span class="prm-chip">SPEI <small>MXN</small></span>}
                                    {r.mp && <span class="prm-chip">Mercado Pago</span>}
                                </span>
                            </td>
                            <td data-label={C.th[3]} class="prm-yn">
                                {r.cp ? (
                                    <span class="prm-yes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.12" /><polyline points="8 12.5 11 15.5 16.5 9.5" stroke-width="2" /></svg><span class="prm-sr">{C.yes}</span></span>
                                ) : (
                                    <span class="prm-no" aria-hidden="true">—</span><span class="prm-sr">{C.no}</span>
                                )}
                            </td>
                            <td data-label={C.th[4]} class="prm-payout">
                                <span class="prm-payout-v">
                                    {r.payout && <span>{r.payout}</span>}
                                    {r.mp && <span class={r.payout ? 'prm-alt' : ''}>{C.mpAccount}</span>}
                                </span>
                            </td>
                        </tr>
                    ))}
                </tbody>
            ))}
        </table>
    </div>

    <ul class="prm-notes">
        {C.notes.map((n) => <li class="reveal">{n}</li>)}
    </ul>
</section>

<style>
    .prm {
        max-width: 1360px;
        margin: 0 auto;
        padding: 6.5rem 5% 0;
    }
    .prm-sr {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .prm-intro {
        display: grid; grid-template-columns: 1.25fr 1fr;
        gap: 3.5rem; align-items: start;
        margin: 0 0 3rem;
    }
    .prm-h2 {
        font-size: clamp(1.85rem, 2.9vw, 2.6rem);
        font-weight: 800; letter-spacing: -0.035em; line-height: 1.1;
        color: #050505; margin: 0; text-wrap: balance;
    }
    .prm-sub {
        font-size: 1.05rem; line-height: 1.6; color: var(--color-text-muted);
        margin: 0; padding-top: 0.4rem; text-wrap: pretty;
    }

    .prm-card {
        background: #fff;
        border-radius: 28px;
        padding: 0.6rem 2.2rem 1.2rem;
        box-shadow:
            0 2px 4px rgba(10,25,47,0.04),
            0 28px 56px -16px rgba(10,25,47,0.14),
            inset 0 1px 0 rgba(255,255,255,0.6);
    }
    .prm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        color: #0a192f;
    }
    .prm-table thead th {
        text-align: left;
        font-size: 0.62rem; font-weight: 800; letter-spacing: 1.6px;
        text-transform: uppercase; color: #99a2af;
        padding: 1.3rem 1rem 1rem;
        border-bottom: 1px solid rgba(10,25,47,0.08);
        white-space: nowrap;
    }
    .prm-table thead th:first-child { padding-left: 0; }
    .prm-group-row th {
        text-align: left;
        font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2px;
        color: #64748b;
        padding: 1.6rem 0 0.55rem;
    }
    .prm-group:first-of-type .prm-group-row th { padding-top: 1.1rem; }
    .prm-row > * {
        text-align: left;
        padding: 0.95rem 1rem;
        border-top: 1px solid rgba(10,25,47,0.06);
        vertical-align: middle;
    }
    .prm-row > :first-child { padding-left: 0; }
    .prm-country { display: flex; align-items: center; gap: 0.75rem; font-weight: 600; }
    .prm-row > th { width: 14rem; }
    .prm-flag {
        width: 24px; height: 24px; flex-shrink: 0; border-radius: 50%;
        box-shadow: 0 0 0 1px rgba(10,25,47,0.08), 0 2px 6px -2px rgba(10,25,47,0.18);
    }
    .prm-name { white-space: nowrap; }

    .prm-rails { display: flex; flex-wrap: wrap; gap: 6px; }
    .prm-rail {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 0.8rem; font-weight: 600;
        padding: 6px 11px 6px 9px; border-radius: 999px;
        white-space: nowrap;
    }
    .prm-rail svg { width: 16px; height: 16px; }
    .prm-rail img { width: 16px; height: 16px; border-radius: 4px; }
    .prm-rail-cp { color: #0a192f; background: rgba(10,25,47,0.06); }
    .prm-rail-mp { color: #0a192f; background: rgba(0,158,227,0.09); }
    .prm-rail em {
        font-style: normal; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.8px;
        text-transform: uppercase; color: #059669;
        background: rgba(16,185,129,0.12); border-radius: 999px; padding: 3px 7px;
    }

    .prm-methods { display: flex; flex-wrap: wrap; gap: 6px; }
    .prm-chip {
        font-size: 0.78rem; font-weight: 500; color: #334155;
        border: 1px solid rgba(10,25,47,0.1); border-radius: 8px;
        padding: 4px 9px; white-space: nowrap;
    }
    .prm-chip small { font-size: 0.62rem; font-weight: 700; color: #94a3b8; margin-left: 2px; }

    .prm-yes { display: inline-flex; color: #059669; }
    .prm-yes svg { width: 20px; height: 20px; }
    .prm-no { color: #cbd5e1; font-weight: 600; }

    .prm-payout span { display: block; font-size: 0.84rem; color: #334155; white-space: nowrap; }
    .prm-payout .prm-alt { font-size: 0.76rem; color: #94a3b8; margin-top: 3px; }

    .prm-notes {
        list-style: none; padding: 0; margin: 1.8rem 0 0;
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem 2.4rem;
    }
    .prm-notes li {
        font-size: 0.86rem; line-height: 1.6; color: var(--color-text-muted);
        padding-top: 1rem; border-top: 1px solid rgba(10,25,47,0.08);
    }

    @media (max-width: 1100px) {
        .prm-card { padding: 0.4rem 1.4rem 1rem; }
        .prm-row > *, .prm-table thead th { padding-left: 0.7rem; padding-right: 0.7rem; }
    }

    @media (max-width: 880px) {
        .prm { padding-top: 4.5rem; }
        .prm-intro { grid-template-columns: 1fr; gap: 1.1rem; margin-bottom: 2.2rem; }
        .prm-sub { padding-top: 0; }
        .prm-card { padding: 0.6rem 1.1rem 0.9rem; border-radius: 22px; }
        .prm-table, .prm-table tbody, .prm-table tr, .prm-table th, .prm-table td { display: block; }
        .prm-table thead { display: none; }
        .prm-group-row th { padding: 1.3rem 0 0.4rem; }
        .prm-row { padding: 0.95rem 0; border-top: 1px solid rgba(10,25,47,0.07); }
        .prm-row > * { border-top: none; padding: 0; }
        .prm-row > th { width: auto; }
        .prm-country { margin-bottom: 0.7rem; }
        .prm-row > td {
            display: grid; grid-template-columns: 1fr; gap: 0.4rem;
            padding: 0.45rem 0;
        }
        .prm-row > td::before {
            content: attr(data-label);
            font-size: 0.62rem; font-weight: 800; letter-spacing: 1.2px;
            text-transform: uppercase; color: #99a2af;
        }
        .prm-payout span, .prm-name { white-space: normal; }
        .prm-row > td.prm-yn, .prm-row > td.prm-payout { grid-template-columns: 8.5rem 1fr; align-items: center; gap: 0.8rem; }
        .prm-payout-v { display: flex; flex-direction: column; gap: 0.15rem; }
        .prm-payout .prm-alt { margin-top: 0; }
        .prm-notes { grid-template-columns: 1fr; gap: 1rem; }
    }
</style>
