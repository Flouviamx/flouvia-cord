---
import { SUPPORTED_COUNTRIES, countryName, supportsMercadoPago, supportsOnlinePayments } from '../../lib/countries';
import { payoutSpecFor, type PayoutFormat } from '../../lib/payout-fields';
import { flagSrc } from '../../lib/flags';

interface Props { isEn?: boolean }
const { isEn = false } = Astro.props;
const L = isEn ? 'en' : 'es';

const PAYOUT_SHORT: Partial<Record<PayoutFormat, [string, string]>> = {
    clabe: ['Cuenta CLABE', 'CLABE account'],
    iban: ['Cuenta IBAN', 'IBAN account'],
    us_aba: ['Routing + cuenta', 'Routing + account'],
    gb_sort: ['Sort code + cuenta', 'Sort code + account'],
    ca_transit: ['Transit + institución + cuenta', 'Transit + institution + account'],
    br_bank: ['Banco + agência + conta', 'Bank + branch + account'],
};

const C = isEn ? {
    title: 'Collect online in all 12 countries where Cord operates.',
    sub: 'Cord Payments charges cards straight to your bank account. Where it isn’t available, you collect through your own Mercado Pago account. In Mexico and Brazil you can have both.',
    both: 'Cord Payments and Mercado Pago',
    rail: 'Online payments',
    methods: 'Your client pays with',
    retainers: 'Monthly retainers',
    payout: 'You receive it in',
    primary: 'default',
    card: 'Card',
    mpAccount: 'Your Mercado Pago account',
    yes: 'Available',
    no: 'Not with Mercado Pago',
    notes: [
        'Both rails charge the same things from the link: the full amount, the deposit and the balance, or each installment.',
        'SPEI appears only on quotes in Mexican pesos. Where both rails exist, Cord Payments is offered first and Mercado Pago as the alternative.',
        'In all 12 countries your account quotes, invoices and tracks collections the same way; this only changes how you get paid online.',
    ],
} : {
    title: 'Cobra en línea en los 12 países donde opera Cord.',
    sub: 'Cord Payments cobra con tarjeta directo a tu cuenta bancaria. Donde no está disponible, cobras con tu propia cuenta de Mercado Pago. En México y Brasil puedes tener los dos.',
    both: 'Cord Payments y Mercado Pago',
    rail: 'Cobro en línea',
    methods: 'Tu cliente paga con',
    retainers: 'Igualas mensuales',
    payout: 'Lo recibes en',
    primary: 'principal',
    card: 'Tarjeta',
    mpAccount: 'Tu cuenta de Mercado Pago',
    yes: 'Disponibles',
    no: 'No con Mercado Pago',
    notes: [
        'Con los dos rieles el link cobra lo mismo: el total, el anticipo y el saldo, o cada cuota.',
        'SPEI aparece solo en cotizaciones en pesos mexicanos. Donde conviven los dos rieles, Cord Payments se ofrece primero y Mercado Pago como alternativa.',
        'En los 12 países tu cuenta cotiza, factura y lleva la cobranza igual; esto solo cambia cómo te pagan en línea.',
    ],
};

const rows = SUPPORTED_COUNTRIES.map((code) => {
    const cp = supportsOnlinePayments(code);
    const mp = supportsMercadoPago(code);
    const payout = PAYOUT_SHORT[payoutSpecFor(code).format];
    const methods = [cp && C.card, cp && code === 'MX' && 'SPEI', mp && 'Mercado Pago'].filter(Boolean) as string[];
    return {
        code,
        name: countryName(code, L),
        cp,
        mp,
        methods,
        payout: cp && payout ? payout[isEn ? 1 : 0] : null,
    };
}).filter((r) => r.cp || r.mp);

const GROUPS = [
    { key: 'both', label: C.both, rows: rows.filter((r) => r.cp && r.mp) },
    { key: 'cp', label: 'Cord Payments', rows: rows.filter((r) => r.cp && !r.mp) },
    { key: 'mp', label: 'Mercado Pago', rows: rows.filter((r) => !r.cp && r.mp) },
].filter((g) => g.rows.length);

const MP_LOGO = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://mercadopago.com&size=128';
const CARD_ICON = '<rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="currentColor" fill-opacity="0.12" /><path d="M2.5 10h19" /><path d="M6.5 15h4" />';
---

<section class="prm" aria-labelledby="prm-title">
    <div class="prm-intro">
        <h2 id="prm-title" class="prm-h2 masked-title">{C.title}</h2>
        <p class="prm-sub reveal">{C.sub}</p>
    </div>

    <div class="prm-cols">
        {GROUPS.map((g) => (
            <div class={`prm-col prm-col-${g.key} reveal`}>
                <p class="prm-col-h">
                    <span>{g.label}</span>
                    <em>{g.rows.length}</em>
                </p>
                <div class="prm-pills">
                    {g.rows.map((r) => (
                        <details class="prm-pill" name="prm-country" open={r.code === 'MX'}>
                            <summary class="prm-sum">
                                <img class="prm-flag" src={flagSrc(r.code)} alt="" width="30" height="30" loading="lazy" decoding="async" />
                                <span class="prm-id">
                                    <b>{r.name}</b>
                                    <small>{r.methods.join(' · ')}</small>
                                </span>
                                <span class="prm-marks" aria-hidden="true">
                                    {r.cp && <i class="prm-mark prm-mark-cp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={CARD_ICON} /></i>}
                                    {r.mp && <i class="prm-mark prm-mark-mp"><img src={MP_LOGO} alt="" width="14" height="14" loading="lazy" /></i>}
                                </span>
                                <svg class="prm-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
                            </summary>
                            <dl class="prm-detail">
                                <div>
                                    <dt>{C.rail}</dt>
                                    <dd class="prm-rails">
                                        {r.cp && (
                                            <span class="prm-rail">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={CARD_ICON} />
                                                Cord Payments
                                                {r.mp && <em>{C.primary}</em>}
                                            </span>
                                        )}
                                        {r.mp && (
                                            <span class="prm-rail prm-rail-mp">
                                                <img src={MP_LOGO} alt="" width="16" height="16" loading="lazy" />
                                                Mercado Pago
                                            </span>
                                        )}
                                    </dd>
                                </div>
                                <div>
                                    <dt>{C.methods}</dt>
                                    <dd class="prm-chips">
                                        {r.methods.map((m) => <span class="prm-chip">{m}{m === 'SPEI' && <small>MXN</small>}</span>)}
                                    </dd>
                                </div>
                                <div>
                                    <dt>{C.retainers}</dt>
                                    <dd>
                                        {r.cp ? (
                                            <span class="prm-yes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.12" /><polyline points="8 12.5 11 15.5 16.5 9.5" stroke-width="2" /></svg>{C.yes}</span>
                                        ) : (
                                            <span class="prm-no">{C.no}</span>
                                        )}
                                    </dd>
                                </div>
                                <div>
                                    <dt>{C.payout}</dt>
                                    <dd class="prm-payout">
                                        {r.payout && <span>{r.payout}</span>}
                                        {r.mp && <span class={r.payout ? 'prm-alt' : ''}>{C.mpAccount}</span>}
                                    </dd>
                                </div>
                            </dl>
                        </details>
                    ))}
                </div>
            </div>
        ))}
    </div>

    <ul class="prm-notes">
        {C.notes.map((n) => <li class="reveal">{n}</li>)}
    </ul>
</section>

<style>
    .prm {
        max-width: 1360px;
        margin: 0 auto;
        padding: 6.5rem 5% 0;
        interpolate-size: allow-keywords;
    }
    .prm-intro {
        display: grid; grid-template-columns: 1.25fr 1fr;
        gap: 3.5rem; align-items: start;
        margin: 0 0 3rem;
    }
    .prm-h2 {
        font-size: clamp(1.85rem, 2.9vw, 2.6rem);
        font-weight: 800; letter-spacing: -0.035em; line-height: 1.1;
        color: #050505; margin: 0; text-wrap: balance;
    }
    .prm-sub {
        font-size: 1.05rem; line-height: 1.6; color: var(--color-text-muted);
        margin: 0; padding-top: 0.4rem; text-wrap: pretty;
    }

    .prm-cols {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.4rem;
        align-items: start;
    }
    .prm-col-h {
        display: flex; align-items: center; gap: 8px;
        font-size: 0.62rem; font-weight: 800; letter-spacing: 1.6px;
        text-transform: uppercase; color: #99a2af;
        margin: 0 0 0.9rem; padding-left: 0.4rem;
    }
    .prm-col-h em {
        font-style: normal; font-size: 0.62rem; letter-spacing: 0;
        color: #64748b; background: rgba(10,25,47,0.06);
        border-radius: 999px; padding: 2px 7px;
    }
    .prm-pills { display: flex; flex-direction: column; gap: 0.6rem; }

    .prm-pill {
        background: #fff;
        border-radius: 34px;
        box-shadow:
            0 0 0 1px rgba(10,25,47,0.05),
            0 2px 4px rgba(10,25,47,0.04),
            0 14px 30px -14px rgba(10,25,47,0.16);
        transition: border-radius 0.35s ease, box-shadow 0.35s ease;
    }
    .prm-pill[open] {
        border-radius: 26px;
        box-shadow:
            0 0 0 1px rgba(10,25,47,0.06),
            0 2px 4px rgba(10,25,47,0.05),
            0 28px 56px -18px rgba(10,25,47,0.2);
    }
    .prm-pill::details-content {
        block-size: 0;
        overflow: clip;
        transition: block-size 0.4s cubic-bezier(0.22, 1, 0.36, 1), content-visibility 0.4s allow-discrete;
    }
    .prm-pill[open]::details-content { block-size: auto; }

    .prm-sum {
        display: flex; align-items: center; gap: 0.85rem;
        min-height: 64px;
        padding: 0.7rem 1.1rem 0.7rem 0.8rem;
        cursor: pointer;
        list-style: none;
        border-radius: inherit;
    }
    .prm-sum::-webkit-details-marker { display: none; }
    .prm-sum:focus-visible { outline: 2px solid rgba(10,25,47,0.35); outline-offset: 2px; }
    .prm-flag {
        width: 30px; height: 30px; flex-shrink: 0; border-radius: 50%;
        box-shadow: 0 0 0 1px rgba(10,25,47,0.08), 0 2px 6px -2px rgba(10,25,47,0.2);
    }
    .prm-id { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .prm-id b { font-size: 0.95rem; font-weight: 700; color: #0a192f; letter-spacing: -0.01em; }
    .prm-id small {
        font-size: 0.74rem; color: #8a94a3;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .prm-marks { display: flex; gap: 4px; flex-shrink: 0; }
    .prm-mark {
        width: 26px; height: 26px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
    }
    .prm-mark svg { width: 14px; height: 14px; }
    .prm-mark img { width: 14px; height: 14px; border-radius: 3px; }
    .prm-mark-cp { color: #0a192f; background: rgba(10,25,47,0.06); }
    .prm-mark-mp { background: rgba(0,158,227,0.1); }
    .prm-chev {
        width: 16px; height: 16px; flex-shrink: 0; color: #94a3b8;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .prm-pill[open] .prm-chev { transform: rotate(180deg); }

    .prm-detail {
        margin: 0;
        padding: 0.2rem 1.3rem 1.2rem;
        display: flex; flex-direction: column;
    }
    .prm-detail > div {
        display: grid; gap: 0.45rem;
        padding: 0.75rem 0;
        border-top: 1px solid rgba(10,25,47,0.06);
    }
    .prm-detail dt {
        font-size: 0.6rem; font-weight: 800; letter-spacing: 1.1px;
        text-transform: uppercase; color: #99a2af; white-space: nowrap;
    }
    .prm-detail dd { margin: 0; font-size: 0.84rem; color: #334155; }

    .prm-rails, .prm-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .prm-rail {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 0.78rem; font-weight: 600; color: #0a192f;
        background: rgba(10,25,47,0.06);
        padding: 5px 10px 5px 8px; border-radius: 999px;
        white-space: nowrap;
    }
    .prm-rail svg { width: 15px; height: 15px; }
    .prm-rail img { width: 15px; height: 15px; border-radius: 3px; }
    .prm-rail-mp { background: rgba(0,158,227,0.09); }
    .prm-rail em {
        font-style: normal; font-size: 0.56rem; font-weight: 800; letter-spacing: 0.8px;
        text-transform: uppercase; color: #059669;
        background: rgba(16,185,129,0.12); border-radius: 999px; padding: 2px 6px;
    }
    .prm-chip {
        font-size: 0.76rem; font-weight: 500; color: #334155;
        border: 1px solid rgba(10,25,47,0.1); border-radius: 8px;
        padding: 3px 8px; white-space: nowrap;
    }
    .prm-chip small { font-size: 0.6rem; font-weight: 700; color: #94a3b8; margin-left: 4px; }
    .prm-yes { display: inline-flex; align-items: center; gap: 6px; color: #059669; font-weight: 600; }
    .prm-yes svg { width: 18px; height: 18px; }
    .prm-no { color: #94a3b8; }
    .prm-payout { display: flex; flex-direction: column; gap: 2px; }
    .prm-payout .prm-alt { font-size: 0.76rem; color: #94a3b8; }

    .prm-notes {
        list-style: none; padding: 0; margin: 2.4rem 0 0;
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem 2.4rem;
    }
    .prm-notes li {
        font-size: 0.86rem; line-height: 1.6; color: var(--color-text-muted);
        padding-top: 1rem; border-top: 1px solid rgba(10,25,47,0.08);
    }

    @media (hover: hover) {
        .prm-pill:not([open]):hover { box-shadow: 0 0 0 1px rgba(10,25,47,0.08), 0 2px 4px rgba(10,25,47,0.05), 0 20px 40px -16px rgba(10,25,47,0.22); }
    }
    @media (prefers-reduced-motion: reduce) {
        .prm-pill, .prm-pill::details-content, .prm-chev { transition: none; }
    }

    @media (max-width: 1100px) {
        .prm-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .prm-col-mp { grid-column: 2; }
    }
    @media (max-width: 880px) {
        .prm { padding-top: 4.5rem; }
        .prm-intro { grid-template-columns: 1fr; gap: 1.1rem; margin-bottom: 2.2rem; }
        .prm-sub { padding-top: 0; }
        .prm-cols { grid-template-columns: 1fr; gap: 1.8rem; }
        .prm-col-mp { grid-column: auto; }
        .prm-notes { grid-template-columns: 1fr; gap: 1rem; }
    }
    @media (max-width: 420px) {
        .prm-detail { padding: 0.1rem 1rem 1rem; }
    }
</style>
