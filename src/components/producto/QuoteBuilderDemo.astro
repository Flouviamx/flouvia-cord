    .qbd-chip span {
        display: inline-flex; align-items: center; height: 30px; padding: 0 12px;
        border-radius: 999px; background: rgba(255,255,255,0.06);
        font-size: 0.73rem; font-weight: 600; color: rgba(226,232,240,0.78);
        transition: background 0.25s, color 0.25s, box-shadow 0.25s;
    }
    .qbd-chip:hover span { background: rgba(255,255,255,0.1); color: #fff; }
    .qbd-chip input:checked + span, .qbd-seg-opt input:checked + span {
        background: #fff; color: #0a192f;
        box-shadow: 0 1px 2px rgba(0,0,0,0.25), 0 6px 14px -8px rgba(0,0,0,0.5);
    }
    .qbd-chip input:focus-visible + span, .qbd-seg-opt input:focus-visible + span {
        outline: 2px solid rgba(255,255,255,0.8); outline-offset: 2px;
    }

    .qbd-seg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3px; padding: 3px; border-radius: 12px; background: rgba(255,255,255,0.06); }
    .qbd-seg-opt { display: flex; }
    .qbd-seg-opt span {
        flex: 1; display: flex; align-items: center; justify-content: center;
        min-height: 34px; padding: 6px 6px; border-radius: 9px; text-align: center;
