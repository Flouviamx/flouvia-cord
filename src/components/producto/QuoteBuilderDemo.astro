    .qbd-qi-pick-box::after { content: ''; position: absolute; left: 4.5px; top: 1.5px; width: 5px; height: 9px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }

    .qbd-q-flash { animation: qbdFlash 1.2s ease-out both; }
