    .qbd-orb { position: absolute; z-index: 0; border-radius: 50%; pointer-events: none; }
    .qbd-orb-top { width: 70%; aspect-ratio: 1; top: -30%; left: -15%; background: radial-gradient(circle, rgba(10,25,47,0.05) 0%, transparent 70%); }
    .qbd-orb-bot { width: 55%; aspect-ratio: 1; bottom: -20%; right: -10%; opacity: 0.7; background: radial-gradient(circle, rgba(10,25,47,0.08) 0%, transparent 70%); }
    .qbd-view {
        position: relative; z-index: 1; flex: 1; min-height: 0;
        overflow-x: hidden; overflow-y: auto; overscroll-behavior: auto;
        scrollbar-width: none;
    }
    .qbd-view::-webkit-scrollbar { display: none; }
    .qbd-view:focus-visible { outline: 2px solid rgba(10,25,47,0.35); outline-offset: -4px; }

    /* ════════ Calca de /q/[token] (QuoteCard.astro), prefijada ════════ */
    .qbd-qp-main {
