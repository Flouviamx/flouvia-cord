                                        <span class="qbd-q-compose-ta">{tq('q.escribe_mensaje')}</span>
                                        <span class="qbd-q-compose-send" style={`background:${COLOR}`}>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                        </span>
                                    </div>
                                    <div class="qbd-q-compose-extras">
                                        <span class="qbd-q-compose-price" data-f="prop-ph">{M.propPh}</span>
                                        <span class="qbd-q-counter-pill" style={`color:${COLOR}; border-color:${COLOR}`}>
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                                            {tq('q.contraoferta')}
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="qbd-q-contact">
                                <span class="qbd-q-contact-label">{fill(tq('q.dudas_contacta'), { org: ORG.nombre })}</span>
                                <div class="qbd-q-contact-links" aria-hidden="true">
                                    <span class="qbd-q-contact-link">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.7-.85-2-.95-.26-.1-.46-.15-.65.15-.2.3-.74.94-.9 1.13-.17.2-.34.22-.63.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.46.13-.6.13-.14.3-.34.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.65-1.57-.9-2.15-.24-.56-.48-.48-.65-.49h-.56c-.2 0-.5.07-.77.37-.26.3-1 .98-1 2.4 0 1.4 1.03 2.76 1.17 2.96.14.2 2.02 3.08 4.9 4.32.68.3 1.22.47 1.64.6.69.22 1.31.19 1.8.12.55-.08 1.7-.7 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.2-.56-.34zM12 2a10 10 0 0 0-8.6 15.06L2 22l5.06-1.33A10 10 0 1 0 12 2z"/></svg>
                                        {tq('q.whatsapp')}
                                    </span>
                                    <span class="qbd-q-contact-link">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                                        {tq('q.correo')}
                                    </span>
                                </div>
                            </div>

                            <div class="qbd-q-cord-badge">
                                <span class="qbd-q-cord-badge-trust">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.4 9-8 11-4.6-2-8-6-8-11V5z" fill="currentColor" fill-opacity="0.14"/><polyline points="8.5 12 11 14.5 15.5 9"/></svg>
                                    {tq('q.firma_validez_legal')}
                                </span>
                                <span class="qbd-q-cord-badge-cta">
                                    {tq('q.verificado_por')} <img src="/imgs/logo-cord-navy.png" alt="Cord" width="46" height="11" loading="lazy" /> {tq('q.crea_las_tuyas')}
                                </span>
                            </div>
                        </div>
                        <p class="qbd-qp-aviso">{tq('q.aviso_actividad')}</p>
                    </div>
                </div>

                <div class="qbd-q-sticky" aria-hidden="true" data-qbd-sticky>
                    <div class="qbd-q-sticky-inner">
                        <div class="qbd-q-sticky-info">
                            <span class="qbd-q-sticky-label">{tq('q.total_a_pagar')}</span>
                            <span class="editorial qbd-q-sticky-total" style={`color:${COLOR}`} data-f="sticky-total">{M.totalText}</span>
                        </div>
                        <button type="button" class="qbd-q-sticky-cta" style={`background:${COLOR}`} tabindex="-1" data-qbd-approve>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                            {tq('q.aprobar')}
                        </button>
                    </div>
                </div>
            </div>
            <p class="qbd-sr" aria-live="polite" data-qbd-live></p>
        </div>
    </div>
</section>

<script>
    import { calculateDocumentTotals } from '../../../packages/elements/src/engine';
    import { currencyDecimals } from '../../lib/currency';

    type Cobro = 'unico' | 'anticipo' | 'iguala';
    interface Line { sku: string; qty: number }
    interface State { client: string; terms: string; lines: Line[]; currency: string; vig: number; cobro: Cobro; pay: boolean; chat: boolean }
    interface Product { sku: string; code: string; name: string; unit: string; step: number; qty: number; price: Record<string, number> }
    interface Client { id: string; name: string; contacto: string; desc: number; terms: string }
    interface Cfg {
        intl: string; taxRate: number; taxLabel: string; org: string; folio: string; anticipoPct: number;
        termDays: Record<string, number>; termLabels: Record<string, string>;
        catalog: Product[]; clients: Client[]; defaults: State; s: Record<string, string>;
    }
    type Kind = 'init' | 'reset' | 'client' | 'terms' | 'qty' | 'add' | 'remove' | 'currency' | 'vig' | 'cobro' | 'pay' | 'chat';

    const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fill = (tpl: string, vars: Record<string, string>) =>
        Object.entries(vars).reduce((s, [k, v]) => s.split(`{${k}}`).join(v), tpl);

    function initDemo(root: HTMLElement) {
        const cfgEl = root.querySelector('[data-qbd-config]');
        if (!cfgEl) return;
        let cfg: Cfg;
        try { cfg = JSON.parse(cfgEl.textContent || ''); } catch { return; }
        const S = cfg.s;
        const q = <T extends Element = HTMLElement>(sel: string, el: ParentNode = root) => el.querySelector<T>(sel);
        const qa = <T extends Element = HTMLElement>(sel: string, el: ParentNode = root) => Array.from(el.querySelectorAll<T>(sel));
        const CAT = new Map(cfg.catalog.map((p) => [p.sku, p]));
        const CLI = new Map(cfg.clients.map((c) => [c.id, c]));
        const clone = (s: State): State => ({ ...s, lines: s.lines.map((l) => ({ ...l })) });
        let state = clone(cfg.defaults);
        let tab: 'review' | 'approved' = 'review';

        const card = q('[data-qbd-card]')!;
        const view = q('[data-qbd-view]')!;
        const sticky = q('[data-qbd-sticky]')!;
        const tabsEl = q('[data-qbd-tabs]')!;
        const ind = q('[data-qbd-ind]')!;
        const tabBtns = qa<HTMLButtonElement>('[data-qbd-tab]');
        const linesEl = q('[data-qbd-lines]')!;
        const subtotals = q('[data-qbd-subtotals]')!;
        const addBtn = q<HTMLButtonElement>('[data-qbd-add]')!;
        const listbox = q('[data-qbd-catalog]')!;
        const liveEl = q('[data-qbd-live]')!;

        const fmtCache = new Map<string, Intl.NumberFormat>();
        const money = (n: number, cur: string) => {
            let f = fmtCache.get(cur);
            if (!f) {
                const d = currencyDecimals(cur);
                f = new Intl.NumberFormat(cfg.intl, { style: 'currency', currency: cur, minimumFractionDigits: d, maximumFractionDigits: d });
                fmtCache.set(cur, f);
            }
            return f.format(Number(n) || 0);
        };
        const fmtDate = (d: Date) => new Intl.DateTimeFormat(cfg.intl, { day: 'numeric', month: 'short', year: 'numeric' }).format(d).replace('.', '');
        const plusDays = (n: number) => { const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() + n); return d; };

        // Misma aritmética que el frontmatter: motor único y splitAnticipo() de lib/cobros.ts.
        function model() {
            const cur = state.currency;
            const m = (n: number) => money(n, cur);
            const scale = 10 ** currencyDecimals(cur);
            const client = CLI.get(state.client)!;
            const days = cfg.termDays[state.terms] ?? 0;
            const lines = state.lines.map((l) => {
                const p = CAT.get(l.sku)!;
                const lista = p.price[cur];
                const nego = client.desc > 0 ? Math.round(lista * (1 - client.desc / 100) * scale) / scale : null;
                const precio = nego ?? lista;
                return { sku: l.sku, p, qty: l.qty, lista, nego, precio, importe: precio * l.qty };
            });
            const totals = calculateDocumentTotals(
                lines.map((l) => ({ descripcion: l.p.name, cantidad: l.qty, precio_unitario: l.lista, precio_negociado: l.nego, tax_rate: cfg.taxRate })),
                { ivaIncluido: false, retenciones: [] },
            );
            const total = totals.total;
            const totalUnits = Math.round(total * scale);
            const antUnits = Math.round((totalUnits * cfg.anticipoPct) / 100);
            const ant = antUnits / scale;
            const sal = (totalUnits - antUnits) / scale;
            const saldoVence = days > 0 ? fmtDate(plusDays(days)) : '';
            const deAnticipo = fill(S.splitDeAnticipo, { pct: String(cfg.anticipoPct), saldo: m(sal) });
            const splitReview = state.cobro === 'anticipo'
                ? `${S.splitAlAprobar} ${m(ant)}${deAnticipo}${saldoVence ? fill(S.splitVenceSaldo, { fecha: saldoVence }) : ''}`
                : state.cobro === 'iguala' ? fill(S.igualaSplit, { monto: m(total) }) : '';
            const splitApproved = state.cobro === 'anticipo'
                ? `${S.splitHoyPagas} ${m(ant)}${deAnticipo}${fill(S.splitVenceSaldo, { fecha: saldoVence || fmtDate(plusDays(0)) })}`
                : splitReview;
            const tax = totals.porTasa.filter((r) => r.impuesto > 0)[0];
            const [igPre, igPost] = S.igualaDesc.split('{monto}');
            const pagoDisponible = state.cobro === 'anticipo' || days === 0;
            const termLabel = cfg.termLabels[state.terms];
            return {
                cur, client, lines, total,
                totalText: m(total),
                termLabel,
                vigDate: fmtDate(plusDays(state.vig)),
                vigChip: fill(S.vigEnDias, { n: String(state.vig), s: state.vig === 1 ? '' : 's' }),
                totalNote: `${cur} · ${S.totalNote}`,
                splitReview, splitApproved,
                rows: lines.map((l) => ({
                    sku: l.sku,
                    qtyText: `${l.qty.toLocaleString(cfg.intl)} ${l.p.unit}`,
                    showList: l.nego != null && l.nego < l.lista,
                    listText: m(l.lista),
                    priceText: m(l.precio),
                    amountText: m(l.importe),
                    importe: l.importe,
                })),
                subtotal: m(totals.subtotal),
                taxLabel: tax ? `${cfg.taxLabel} ${Math.round(tax.tasa * 10000) / 100}%` : '',
                taxText: tax ? m(tax.impuesto) : '',
                credit: state.cobro === 'unico' && days > 0
                    ? {
                        title: fill(S.pedidoCredito, { terminos: termLabel }),
                        text: fill(S.pagoVence, { total: `${m(total)} ${cur}`, fecha: saldoVence }) + (state.pay ? S.pagoVenceOnline : S.pagoVenceManual),
                    }
                    : null,
                cobros: state.cobro === 'anticipo' ? { ant: m(ant), sal: m(sal), salStatus: days > 0 ? fill(S.venceEl, { fecha: saldoVence }) : S.porPagar } : null,
                iguala: state.cobro === 'iguala' && state.pay ? { pre: igPre ?? '', monto: m(total), post: igPost ?? '' } : null,
                pay: state.pay && pagoDisponible && state.cobro !== 'iguala'
                    ? {
                        label: state.cobro === 'anticipo' ? `${S.aPagarAhora} · ${S.tipoAnticipo.toUpperCase()}` : S.aPagarAhora,
                        amount: m(state.cobro === 'anticipo' ? ant : total),
                        secure: cur === 'MXN' ? S.tarjetaOSpei : S.pagoProtegido,
                    }
                    : null,
                propPh: S.propPh.replace('MXN', cur),
            };
        }

        const setF = (key: string, text: string, scope: ParentNode = root) => {
            qa(`[data-f="${key}"]`, scope).forEach((el) => { if (el.textContent !== text) el.textContent = text; });
        };
        const showBlk = (key: string, on: boolean) => { const el = q(`[data-blk="${key}"]`); if (el) el.hidden = !on; };

        // ── Animaciones del link real: count-up del total y flash de la línea que cambió ──
        let countRaf = 0;
        let shownTotal = 0;
        const countUp = (el: HTMLElement, from: number, to: number, cur: string) => {
            cancelAnimationFrame(countRaf);
            if (reduced() || Math.abs(from - to) < 0.005) { el.textContent = money(to, cur); shownTotal = to; return; }
            const dur = 1000; let t0 = 0;
            const tick = (t: number) => {
                if (!t0) t0 = t;
                const p = Math.min((t - t0) / dur, 1);
                shownTotal = from + (to - from) * (1 - Math.pow(1 - p, 3));
                el.textContent = money(shownTotal, cur);
                if (p < 1) countRaf = requestAnimationFrame(tick);
            };
            countRaf = requestAnimationFrame(tick);
        };
        const restartClass = (el: Element | null, cls: string) => {
            if (!el) return;
            el.classList.remove(cls);
            void (el as HTMLElement).offsetWidth;
            el.classList.add(cls);
            el.addEventListener('animationend', () => el.classList.remove(cls), { once: true });
        };
        const wasTimers = new Map<string, number>();
        const showWas = (row: HTMLElement, sku: string, before: number, cur: string) => {
            const was = q('[data-f="was"]', row);
            if (!was) return;
            was.textContent = fill(S.cambioEra, { monto: money(before, cur) });
            was.hidden = false;
            restartClass(was, 'is-on');
            clearTimeout(wasTimers.get(sku));
            wasTimers.set(sku, window.setTimeout(() => { was.hidden = true; }, 8000));
        };

        // ── Cámara: el navegador de la vista previa se desplaza a lo que cambió ──
        const stickyH = () => (sticky.classList.contains('is-show') ? sticky.getBoundingClientRect().height + 8 : 0);
        const scrollViewTo = (top: number) => view.scrollTo({ top: Math.max(0, top), behavior: reduced() ? 'auto' : 'smooth' });
        const ensureVisible = (el: Element | null, align: 'auto' | 'top' = 'auto') => {
            if (!el || (el as HTMLElement).offsetParent === null) return;
            const vr = view.getBoundingClientRect();
            const er = el.getBoundingClientRect();
            const pad = 20;
            if (align === 'top') { scrollViewTo(view.scrollTop + (er.top - vr.top) - pad); return; }
            const bottomLimit = vr.bottom - stickyH() - pad;
            if (er.top >= vr.top + pad && er.bottom <= bottomLimit) return;
            const room = vr.height - stickyH();
            const offset = er.height < room - pad * 2 ? Math.min((room - er.height) * 0.3, 90) : pad;
            scrollViewTo(view.scrollTop + (er.top - vr.top) - offset);
        };

        // ── Barra fija del link real: aparece cuando el botón de aprobar sale de la vista ──
        let ctaVisible = false;
        const updateSticky = () => sticky.classList.toggle('is-show', tab === 'review' && !ctaVisible);
        const cta = q('[data-qbd-cta]');
        if ('IntersectionObserver' in window && cta) {
            new IntersectionObserver((entries) => {
                ctaVisible = entries[0]?.isIntersecting ?? false;
                updateSticky();
            }, { root: view, threshold: 0.4 }).observe(cta);
        }

        // ── Sello: SHA-256 real del contenido firmado, como el modo demo de /q ──
        let hashTimer = 0;
        const scheduleHash = (m: ReturnType<typeof model>) => {
            clearTimeout(hashTimer);
            hashTimer = window.setTimeout(async () => {
                if (!globalThis.crypto?.subtle) return;
                const contenido = JSON.stringify({
                    folio: cfg.folio,
                    status: 'approved',
                    signed_by: m.client.contacto,
                    signed_at: new Date().toISOString(),
                    items: m.lines.map((l) => ({ id: l.sku, descripcion: l.p.name, cantidad: l.qty, unidad: l.p.unit, precio: l.precio, taxRate: cfg.taxRate })),
                });
                try {
                    const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(contenido));
                    setF('hash', Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, '0')).join(''));
                    setF('signed-at', new Date().toLocaleString(cfg.intl, { dateStyle: 'long', timeStyle: 'short' }));
                } catch { /* sin crypto.subtle el sello del render inicial se queda */ }
            }, 220);
        };

        let liveTimer = 0;
        const announce = (m: ReturnType<typeof model>) => {
            clearTimeout(liveTimer);
            liveTimer = window.setTimeout(() => {
                liveEl.textContent = fill(S.live, { total: m.totalText, cur: m.cur, n: String(m.lines.length) });
            }, 700);
        };

        let prevCur = state.currency;
        const prevImporte = new Map<string, number>();

        function renderSplit(m: ReturnType<typeof model>, animate: boolean) {
            const el = q('[data-f="split"]');
            if (!el) return;
            const text = tab === 'approved' ? m.splitApproved : m.splitReview;
            const was = el.textContent;
            el.hidden = !text;
            if (text && was !== text) {
                el.textContent = text;
                if (animate) restartClass(el, 'qbd-qi-reveal');
            }
        }

        function render(kind: Kind = 'init', sku?: string) {
            const m = model();
            const animate = !['init', 'reset', 'currency'].includes(kind) && !reduced();

            // Panel
            const clientSel = q<HTMLSelectElement>('[data-qbd-client]');
            if (clientSel) clientSel.value = state.client;
            qa<HTMLInputElement>('input[name="qbd-terms"]').forEach((r) => { r.checked = r.value === state.terms; });
            const desc = q('[data-qbd-desc-text]');
            if (desc) desc.textContent = m.client.desc > 0 ? fill(S.descOn, { d: String(m.client.desc) }) : S.descOff;

            const used = new Set(state.lines.map((l) => l.sku));
            if (kind === 'init' || kind === 'reset') {
                state.lines.forEach((l) => { const li = q(`[data-qbd-line="${l.sku}"]`); if (li) linesEl.appendChild(li); });
            }
            if (kind === 'add' && sku) { const li = q(`[data-qbd-line="${sku}"]`); if (li) linesEl.appendChild(li); }
            qa('[data-qbd-line]').forEach((li) => { li.hidden = !used.has(li.dataset.qbdLine || ''); });
            m.lines.forEach((l) => {
                const li = q(`[data-qbd-line="${l.sku}"]`);
                if (!li) return;
                const list = q('[data-f="lm-list"]', li);
                if (list) { list.hidden = !(l.nego != null && l.nego < l.lista); list.textContent = money(l.lista, m.cur); }
                setF('lm-price', money(l.precio, m.cur), li);
                const inp = q<HTMLInputElement>('[data-qbd-qty]', li);
                if (inp && document.activeElement !== inp) inp.value = l.qty.toLocaleString(cfg.intl);
                const dec = q<HTMLButtonElement>('[data-qbd-dec]', li);
                if (dec) dec.disabled = l.qty <= 1;
                const rm = q<HTMLButtonElement>('[data-qbd-remove]', li);
                if (rm) rm.disabled = state.lines.length <= 1;
            });
            qa('[role="option"]', listbox).forEach((opt) => {
                const s = opt.dataset.sku || '';
                opt.setAttribute('aria-disabled', used.has(s) ? 'true' : 'false');
                const p = CAT.get(s);
                if (p) setF('opt-price', money(p.price[m.cur], m.cur), opt);
            });
            const allIn = used.size >= cfg.catalog.length;
            addBtn.disabled = allIn;
            const addText = q('[data-qbd-add-text]');
            if (addText) addText.textContent = allIn ? S.allAdded : S.add;

            const curSel = q<HTMLSelectElement>('[data-qbd-currency]');
            if (curSel) curSel.value = state.currency;
            const vigSel = q<HTMLSelectElement>('[data-qbd-vig]');
            if (vigSel) vigSel.value = String(state.vig);
            qa<HTMLInputElement>('input[name="qbd-cobro"]').forEach((r) => { r.checked = r.value === state.cobro; });
            const cobroNote = q('[data-qbd-cobro-note]');
            if (cobroNote) {
                cobroNote.textContent = state.cobro === 'anticipo' ? S.noteAnticipo
                    : state.cobro === 'iguala' ? S.noteIguala
                    : (cfg.termDays[state.terms] ?? 0) > 0 ? fill(S.noteUnicoCredito, { terms: m.termLabel }) : S.noteUnicoContado;
            }
            const payCb = q<HTMLInputElement>('[data-qbd-pay]');
            if (payCb) payCb.checked = state.pay;
            const chatCb = q<HTMLInputElement>('[data-qbd-chat]');
            if (chatCb) chatCb.checked = state.chat;
            const payDesc = q('[data-qbd-pay-desc]');
            if (payDesc) payDesc.textContent = m.cur === 'MXN' ? S.payDescMx : S.payDesc;

            // Vista previa
            setF('client', m.client.name);
            setF('vig-date', m.vigDate);
            setF('vig-chip', m.vigChip);
            setF('terms', m.termLabel);
            const totalEl = q('[data-f="total"]');
            if (totalEl) {
                if (animate && prevCur === m.cur) countUp(totalEl, shownTotal, m.total, m.cur);
                else { cancelAnimationFrame(countRaf); totalEl.textContent = m.totalText; shownTotal = m.total; }
            }
            setF('total-note', m.totalNote);
            renderSplit(m, animate);

            if (kind === 'init' || kind === 'reset') {
                state.lines.forEach((l) => { const r = q(`[data-qbd-row="${l.sku}"]`); if (r) subtotals.before(r); });
            }
            if (kind === 'add' && sku) { const r = q(`[data-qbd-row="${sku}"]`); if (r) subtotals.before(r); }
            qa('[data-qbd-row]').forEach((r) => { r.hidden = !used.has(r.dataset.qbdRow || ''); });
            m.rows.forEach((row) => {
                const el = q(`[data-qbd-row="${row.sku}"]`);
                if (!el) return;
                const before = prevImporte.get(row.sku);
                setF('qty', row.qtyText, el);
                const list = q('[data-f="list"]', el);
                if (list) { list.hidden = !row.showList; list.textContent = row.listText; }
                setF('price', row.priceText, el);
                setF('amount', row.amountText, el);
                if (animate && kind === 'add' && row.sku === sku) restartClass(el, 'qbd-qi-reveal');
                else if (animate && before !== undefined && Math.abs(before - row.importe) > 0.005) {
                    restartClass(el, 'qbd-q-flash');
                    if (kind === 'qty' && row.sku === sku) showWas(el, row.sku, before, m.cur);
                }
            });
            prevImporte.clear();
            m.rows.forEach((r) => prevImporte.set(r.sku, r.importe));
            if (kind === 'currency' || kind === 'reset') qa('[data-f="was"]').forEach((w) => { w.hidden = true; });

            setF('subtotal', m.subtotal);
            const taxRow = q('[data-f-row="tax"]');
            if (taxRow) taxRow.hidden = !m.taxText;
            setF('tax-label', m.taxLabel);
            setF('tax', m.taxText);
            setF('grand', m.totalText);
            setF('sticky-total', m.totalText);
            setF('prop-ph', m.propPh);
            qa('[data-chat]').forEach((el) => { el.hidden = !state.chat; });
            showBlk('chat', state.chat);

            showBlk('credit', !!m.credit);
            if (m.credit) { setF('credit-title', m.credit.title); setF('credit-text', m.credit.text); }
            showBlk('cobros', !!m.cobros);
            if (m.cobros) { setF('ant', m.cobros.ant); setF('sal', m.cobros.sal); setF('sal-status', m.cobros.salStatus); }
            showBlk('iguala', !!m.iguala);
            if (m.iguala) { setF('ig-pre', m.iguala.pre); setF('ig-monto', m.iguala.monto); setF('ig-post', m.iguala.post); }
            showBlk('pay', !!m.pay);
            if (m.pay) { setF('pay-label', m.pay.label); setF('pay-total', m.pay.amount); setF('pay-secure', m.pay.secure); }
            setF('cur', m.cur);
            setF('signer', m.client.contacto);
            if (kind !== 'init') scheduleHash(m);
            if (kind === 'currency' && !reduced()) restartClass(card, 'qbd-q-fade');

            prevCur = m.cur;
            if (kind !== 'init') announce(m);
            return m;
        }

        // ── Pestañas ──
        const moveIndicator = (instant = false) => {
            const sel = tabBtns.find((b) => b.dataset.qbdTab === tab);
            if (!sel) return;
            if (instant) ind.style.transition = 'none';
            ind.style.width = `${sel.offsetWidth}px`;
            ind.style.transform = `translateX(${sel.offsetLeft}px)`;
            if (instant) { void ind.offsetWidth; ind.style.transition = ''; }
        };
        const restartCheck = () => {
            const ring = q('[data-qbd-ring]');
            if (!ring || reduced()) return;
            ring.classList.remove('is-drawing');
            void (ring as HTMLElement).offsetWidth;
            ring.classList.add('is-drawing');
        };
        let swapTimer = 0;
        function setTab(next: 'review' | 'approved', opts: { focus?: boolean; after?: () => void } = {}) {
            if (next === tab) { opts.after?.(); return; }
            tab = next;
            tabBtns.forEach((b) => {
                const on = b.dataset.qbdTab === tab;
                b.setAttribute('aria-selected', String(on));
                b.tabIndex = on ? 0 : -1;
                if (on && opts.focus) b.focus({ preventScroll: true });
            });
            view.setAttribute('aria-labelledby', `qbd-tab-${tab}`);
            moveIndicator();
            const apply = () => {
                card.dataset.state = tab;
                renderSplit(model(), false);
                updateSticky();
                if (tab === 'approved') restartCheck();
                requestAnimationFrame(() => {
                    if (opts.after) opts.after();
                    else if (tab === 'approved') ensureVisible(q('[data-fx="success"]'), 'top');
                    else scrollViewTo(0);
                });
            };
            clearTimeout(swapTimer);
            if (reduced()) { apply(); return; }
            card.classList.add('is-swapping');
            swapTimer = window.setTimeout(() => {
                apply();
                requestAnimationFrame(() => card.classList.remove('is-swapping'));
            }, 150);
        }
        tabBtns.forEach((b) => b.addEventListener('click', () => setTab(b.dataset.qbdTab === 'approved' ? 'approved' : 'review')));
        tabsEl.addEventListener('keydown', (e) => {
            const i = tabBtns.findIndex((b) => b.dataset.qbdTab === tab);
            let n = -1;
            if (e.key === 'ArrowRight') n = (i + 1) % tabBtns.length;
            else if (e.key === 'ArrowLeft') n = (i - 1 + tabBtns.length) % tabBtns.length;
            else if (e.key === 'Home') n = 0;
            else if (e.key === 'End') n = tabBtns.length - 1;
            if (n < 0) return;
            e.preventDefault();
            setTab(tabBtns[n].dataset.qbdTab === 'approved' ? 'approved' : 'review', { focus: true });
        });
        qa('[data-qbd-approve]').forEach((b) => b.addEventListener('click', () => setTab('approved', { focus: true })));

        // ── Cambios desde el panel ──
        const region = (key: string) => q(`[data-fx="${key}"]`);
        function change(kind: Kind, sku?: string) {
            if (kind === 'pay' && tab === 'review') {
                render(kind, sku);
                setTab('approved', { after: () => ensureVisible(region('done')) });
                return;
            }
            if (kind === 'chat' && tab === 'approved') {
                render(kind, sku);
                setTab('review', { after: () => ensureVisible(state.chat ? q('[data-blk="chat"]') : region('items')) });
                return;
            }
            render(kind, sku);
            const target = (() => {
                switch (kind) {
                    case 'client': case 'vig': return region('meta');
                    case 'terms': case 'cobro': return tab === 'approved' ? region('done') : kind === 'terms' ? region('meta') : region('total');
                    case 'pay': return region('done');
                    case 'qty': case 'add': return sku ? q(`[data-qbd-row="${sku}"]`) : null;
                    case 'remove': return region('items');
                    case 'chat': return state.chat ? q('[data-blk="chat"]') : region('items');
                    default: return null;
                }
            })();
            if (target) requestAnimationFrame(() => ensureVisible(target));
        }

        q('[data-qbd-client]')?.addEventListener('change', (e) => {
            const c = CLI.get((e.target as HTMLSelectElement).value);
            if (!c) return;
            state.client = c.id;
            state.terms = c.terms;
            if (state.cobro === 'iguala' && state.terms !== 'contado') state.cobro = 'unico';
            change('client');
        });
        qa<HTMLInputElement>('input[name="qbd-terms"]').forEach((r) => r.addEventListener('change', () => {
            if (!r.checked) return;
            state.terms = r.value;
            if (state.cobro === 'iguala' && state.terms !== 'contado') state.cobro = 'unico';
            change('terms');
        }));
        q('[data-qbd-currency]')?.addEventListener('change', (e) => { state.currency = (e.target as HTMLSelectElement).value; change('currency'); });
        q('[data-qbd-vig]')?.addEventListener('change', (e) => { state.vig = Number((e.target as HTMLSelectElement).value) || 15; change('vig'); });
        qa<HTMLInputElement>('input[name="qbd-cobro"]').forEach((r) => r.addEventListener('change', () => {
            if (!r.checked) return;
            state.cobro = r.value as Cobro;
            if (state.cobro === 'iguala') state.terms = 'contado';
            change('cobro');
        }));
        q('[data-qbd-pay]')?.addEventListener('change', (e) => { state.pay = (e.target as HTMLInputElement).checked; change('pay'); });
        q('[data-qbd-chat]')?.addEventListener('change', (e) => { state.chat = (e.target as HTMLInputElement).checked; change('chat'); });

        const setQty = (sku: string, qty: number) => {
            const line = state.lines.find((l) => l.sku === sku);
            if (!line) return;
            const next = Math.min(99999, Math.max(1, Math.round(qty)));
            if (next === line.qty) return;
            line.qty = next;
            change('qty', sku);
        };
        linesEl.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest('button');
            const li = btn?.closest<HTMLElement>('[data-qbd-line]');
            if (!btn || !li) return;
            const sku = li.dataset.qbdLine || '';
            const p = CAT.get(sku);
            const line = state.lines.find((l) => l.sku === sku);
            if (!p || !line) return;
            if (btn.hasAttribute('data-qbd-dec')) setQty(sku, line.qty - p.step);
            else if (btn.hasAttribute('data-qbd-inc')) setQty(sku, line.qty + p.step);
            else if (btn.hasAttribute('data-qbd-remove')) {
                if (state.lines.length <= 1) return;
                const visible = qa('[data-qbd-line]:not([hidden])');
                const idx = visible.indexOf(li);
                state.lines = state.lines.filter((l) => l.sku !== sku);
                change('remove');
                const nextLi = visible[idx + 1] ?? visible[idx - 1];
                (nextLi ? q<HTMLButtonElement>('[data-qbd-remove]', nextLi) : addBtn)?.focus();
            }
        });
        const qtyTimers = new Map<string, number>();
        qa<HTMLInputElement>('[data-qbd-qty]').forEach((inp) => {
            const sku = inp.closest<HTMLElement>('[data-qbd-line]')?.dataset.qbdLine || '';
            inp.addEventListener('input', () => {
                const digits = inp.value.replace(/\D/g, '');
                clearTimeout(qtyTimers.get(sku));
                if (!digits) return;
                qtyTimers.set(sku, window.setTimeout(() => setQty(sku, parseInt(digits, 10)), 380));
            });
            inp.addEventListener('blur', () => {
                const line = state.lines.find((l) => l.sku === sku);
                const digits = inp.value.replace(/\D/g, '');
                if (line && digits && parseInt(digits, 10) !== line.qty) { clearTimeout(qtyTimers.get(sku)); setQty(sku, parseInt(digits, 10)); return; }
                if (line) inp.value = line.qty.toLocaleString(cfg.intl);
            });
            inp.addEventListener('keydown', (e) => {
                const line = state.lines.find((l) => l.sku === sku);
                const p = CAT.get(sku);
                if (!line || !p) return;
                if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
                    e.preventDefault();
                    setQty(sku, line.qty + (e.key === 'ArrowUp' ? p.step : -p.step));
                    inp.value = (state.lines.find((l) => l.sku === sku)?.qty ?? line.qty).toLocaleString(cfg.intl);
                } else if (e.key === 'Enter') inp.blur();
            });
        });

        // ── Catálogo (listbox con miniaturas) ──
        const options = qa('[role="option"]', listbox);
        let active = -1;
        const enabledIdx = () => options.map((o, i) => (o.getAttribute('aria-disabled') === 'true' ? -1 : i)).filter((i) => i >= 0);
        const setActive = (i: number) => {
            active = i;
            options.forEach((o, j) => o.classList.toggle('is-active', j === i));
            if (i >= 0) { listbox.setAttribute('aria-activedescendant', options[i].id); options[i].scrollIntoView({ block: 'nearest' }); }
            else listbox.removeAttribute('aria-activedescendant');
        };
        const openList = () => {
            if (addBtn.disabled) return;
            listbox.hidden = false;
            addBtn.setAttribute('aria-expanded', 'true');
            setActive(enabledIdx()[0] ?? -1);
            listbox.focus({ preventScroll: true });
        };
        const closeList = (refocus: boolean) => {
            if (listbox.hidden) return;
            listbox.hidden = true;
            addBtn.setAttribute('aria-expanded', 'false');
            setActive(-1);
            if (refocus) addBtn.focus();
        };
        const choose = (i: number) => {
            const opt = options[i];
            if (!opt || opt.getAttribute('aria-disabled') === 'true') return;
            const sku = opt.dataset.sku || '';
            const p = CAT.get(sku);
            if (!p) return;
            state.lines.push({ sku, qty: p.qty });
            closeList(true);
            change('add', sku);
        };
        addBtn.addEventListener('click', () => (listbox.hidden ? openList() : closeList(true)));
        addBtn.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); openList(); }
        });
        listbox.addEventListener('keydown', (e) => {
            const en = enabledIdx();
            const pos = en.indexOf(active);
            if (e.key === 'ArrowDown') { e.preventDefault(); setActive(en[Math.min(en.length - 1, pos + 1)] ?? active); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(en[Math.max(0, pos - 1)] ?? active); }
            else if (e.key === 'Home') { e.preventDefault(); setActive(en[0] ?? -1); }
            else if (e.key === 'End') { e.preventDefault(); setActive(en[en.length - 1] ?? -1); }
            else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(active); }
            else if (e.key === 'Escape') { e.preventDefault(); closeList(true); }
            else if (e.key === 'Tab') closeList(false);
        });
        options.forEach((o, i) => {
            o.addEventListener('click', () => choose(i));
            o.addEventListener('pointermove', () => { if (o.getAttribute('aria-disabled') !== 'true' && active !== i) setActive(i); });
        });
        document.addEventListener('pointerdown', (e) => {
            if (listbox.hidden) return;
            const tgt = e.target as Node;
            if (!listbox.contains(tgt) && !addBtn.contains(tgt)) closeList(false);
        });

        q('[data-qbd-reset]')?.addEventListener('click', () => {
            closeList(false);
            state = clone(cfg.defaults);
            render('reset');
            setTab('review');
            scrollViewTo(0);
        });

        // Arranque: fechas de hoy, orden de líneas y totales con el motor del cliente.
        const m0 = render('init');
        shownTotal = m0.total;
        m0.rows.forEach((r) => prevImporte.set(r.sku, r.importe));
        scheduleHash(m0);
        tabsEl.classList.add('is-ready');
        moveIndicator(true);
        if ('ResizeObserver' in window) new ResizeObserver(() => moveIndicator(true)).observe(tabsEl);
        document.fonts?.ready.then(() => moveIndicator(true));
        updateSticky();
    }

    document.querySelectorAll<HTMLElement>('[data-quote-demo]').forEach(initDemo);
</script>

<style>
