    .qbd-ql-check-ring.is-drawing .qbd-ql-check-mark { animation: qbdCheckIn 0.4s cubic-bezier(0.22,1,0.36,1) 0.5s both; }
    @keyframes qbdCircleIn { from { stroke-dashoffset: 145; } to { stroke-dashoffset: 0; } }
    @keyframes qbdCheckIn { from { stroke-dashoffset: 36; } to { stroke-dashoffset: 0; } }
    .qbd-ql-done-title { font-size: 1.12rem; font-weight: 700; color: #111; }
    .qbd-ql-done-sub { font-size: 0.84rem; color: #9ca3af; max-width: 360px; line-height: 1.55; }
    .qbd-ql-done-actions { display: flex; flex-direction: column; gap: 0.55rem; width: 100%; margin-top: 0.5rem; }

    .qbd-ql-credit-note { display: flex; align-items: flex-start; gap: 12px; padding: 1.1rem 1.2rem; background: #f5f5f7; border-radius: 16px; text-align: left; }
