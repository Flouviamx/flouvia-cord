    .qbd-ql-credit-text span { font-size: 0.8rem; color: #6b7686; line-height: 1.55; }
    .qbd-ql-cobros { display: flex; flex-direction: column; padding: 0.4rem 1.2rem 0.6rem; background: #fff; border: 1px solid rgba(10,25,47,0.07); border-radius: 16px; text-align: left; }
