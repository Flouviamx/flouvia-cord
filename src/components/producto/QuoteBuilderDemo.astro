    .qbd-select:hover { background-color: rgba(255,255,255,0.1); }
    .qbd-select:focus-visible { outline: none; border-color: rgba(255,255,255,0.55); box-shadow: 0 0 0 3px rgba(255,255,255,0.14); }
    .qbd-select option { color: #0a192f; background: #fff; }

    .qbd-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .qbd-chip, .qbd-seg-opt { position: relative; display: inline-flex; }
