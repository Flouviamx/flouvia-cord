    button.qbd-ql-cta:focus-visible { outline: 2px solid #0a192f; outline-offset: 3px; }
    .qbd-ql-secondary-row { display: flex; gap: 0.7rem; }
    .qbd-ql-ghost {
        flex: 1; font-family: var(--font-sans); font-size: 0.855rem; font-weight: 600;
        color: #6b7280; border: 1px solid rgba(10,25,47,0.1); border-radius: 12px;
        padding: 11px 16px; display: flex; align-items: center; justify-content: center; gap: 6px;
    }
    .qbd-ql-reject-link { flex: none; padding-inline: 18px; border-color: transparent; color: #9ca3af; }
    .qbd-ql-ghost-receipt { margin-top: 1rem; }

    .qbd-ql-success { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 0.3rem 0; text-align: center; }
    .qbd-ql-check-ring { width: 68px; height: 68px; margin-bottom: 0.4rem; }
