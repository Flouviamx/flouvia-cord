    .qbd-q-items { display: flex; flex-direction: column; }
    .qbd-qi-head { display: grid; grid-template-columns: 1.9fr 0.8fr 0.9fr 1fr; gap: 1rem; padding: 0 0 0.65rem; font-size: 0.5rem; font-weight: 800; letter-spacing: 1.5px; color: #d1d5db; border-bottom: 1px solid rgba(10,25,47,0.07); }
