    /* Líneas de la cotización */
    .qbd-lines { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
    .qbd-line {
        display: grid; grid-template-columns: 34px minmax(0, 1fr) auto 26px;
        grid-template-areas: "thumb text step rm";
        align-items: center; gap: 10px;
        padding: 6px 0;
    }
    .qbd-line:not([hidden]) ~ .qbd-line:not([hidden]) { border-top: 1px solid rgba(255,255,255,0.06); }
    .qbd-line > .qbd-thumb { grid-area: thumb; }
    .qbd-thumb {
        width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
        display: grid; place-items: center;
        color: #3b4556;
        background: linear-gradient(150deg, #ffffff 0%, var(--tile) 72%);
        box-shadow: inset 0 0 0 1px rgba(10,25,47,0.07), 0 1px 2px rgba(0,0,0,0.25);
    }
    .qbd-thumb-lg { width: 40px; height: 40px; border-radius: 10px; }
    .qbd-line-text { grid-area: text; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .qbd-line-name { font-size: 0.79rem; font-weight: 600; line-height: 1.25; color: #f8fafc; letter-spacing: -0.005em; }
    .qbd-line-meta { font-size: 0.68rem; color: rgba(226,232,240,0.55); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .qbd-line-meta s { margin-right: 4px; color: rgba(226,232,240,0.38); text-decoration-color: rgba(226,232,240,0.45); }

    .qbd-step {
        grid-area: step;
        display: inline-flex; align-items: center; height: 30px;
        border-radius: 9px; background: rgba(255,255,255,0.06);
    }
    .qbd-step button {
        width: 26px; height: 30px; border: 0; padding: 0; cursor: pointer;
        display: grid; place-items: center; border-radius: 9px;
        background: transparent; color: rgba(226,232,240,0.75);
        transition: color 0.2s, background 0.2s;
    }
    .qbd-step button:hover:not(:disabled) { color: #fff; background: rgba(255,255,255,0.07); }
    .qbd-step button:disabled { opacity: 0.3; cursor: not-allowed; }
    .qbd-step input {
        width: 50px; height: 30px; padding: 0; border: 0; border-radius: 6px;
        background: transparent; color: #fff; text-align: center;
        font: 600 0.77rem var(--font-sans); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
    }
    .qbd-step input:focus-visible, .qbd-step button:focus-visible { outline: none; box-shadow: inset 0 0 0 2px rgba(255,255,255,0.6); }
    .qbd-remove {
        grid-area: rm;
        width: 26px; height: 26px; border: 0; padding: 0; border-radius: 8px; cursor: pointer;
        display: grid; place-items: center;
        background: transparent; color: rgba(226,232,240,0.42);
        transition: color 0.2s, background 0.2s;
    }
    .qbd-remove:hover:not(:disabled) { color: #fff; background: rgba(255,255,255,0.07); }
    .qbd-remove:disabled { opacity: 0.25; cursor: not-allowed; }
    .qbd-remove:focus-visible { outline: 2px solid rgba(255,255,255,0.75); outline-offset: 1px; }

    .qbd-add-wrap { position: relative; margin-top: 6px; }
    .qbd-add {
        width: 100%; height: 36px; border-radius: 10px; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        border: 1px dashed rgba(255,255,255,0.18); background: transparent;
        color: rgba(226,232,240,0.85); font: 600 0.77rem var(--font-sans);
        transition: background 0.2s, border-color 0.2s, color 0.2s;
    }
    .qbd-add:hover:not(:disabled) { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.3); color: #fff; }
    .qbd-add:disabled { opacity: 0.45; cursor: default; }
    .qbd-add:focus-visible { outline: 2px solid rgba(255,255,255,0.75); outline-offset: 2px; }

    .qbd-catalog {
        position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 30;
        list-style: none; margin: 0; padding: 6px;
        max-height: 336px; overflow-y: auto; scrollbar-width: none;
        background: #fff; border-radius: 14px;
        box-shadow: 0 0 0 1px rgba(10,25,47,0.06), 0 2px 4px rgba(10,25,47,0.08), 0 28px 56px -14px rgba(0,0,0,0.55);
        animation: qbdPop 0.22s var(--ease-spring) both;
    }
    .qbd-catalog::-webkit-scrollbar { display: none; }
    .qbd-catalog:focus { outline: none; }
    .qbd-catalog:focus-visible { box-shadow: 0 0 0 2px rgba(255,255,255,0.8), 0 28px 56px -14px rgba(0,0,0,0.55); }
    @keyframes qbdPop { from { opacity: 0; transform: translateY(-4px) scale(0.985); } to { opacity: 1; transform: none; } }
    .qbd-opt {
        display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: 12px;
        padding: 8px 10px; border-radius: 10px; cursor: pointer;
    }
    .qbd-opt.is-active { background: #f3f4f6; box-shadow: inset 0 0 0 1px rgba(10,25,47,0.06); }
    .qbd-opt[aria-disabled="true"] { cursor: default; }
    .qbd-opt[aria-disabled="true"] .qbd-thumb, .qbd-opt[aria-disabled="true"] .qbd-opt-text { opacity: 0.45; }
    .qbd-opt-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .qbd-opt-name { font-size: 0.82rem; font-weight: 600; color: #0a192f; letter-spacing: -0.01em; }
    .qbd-opt-meta { font-size: 0.7rem; color: #6b7280; font-variant-numeric: tabular-nums; }
    .qbd-opt-tag {
        display: none; align-items: center; gap: 4px;
        font-size: 0.64rem; font-weight: 700; color: #047857;
        background: rgba(16,185,129,0.12); padding: 3px 8px; border-radius: 999px; white-space: nowrap;
    }
    .qbd-opt[aria-disabled="true"] .qbd-opt-tag { display: inline-flex; }

    .qbd-opt-row { display: flex; align-items: flex-start; gap: 11px; padding: 5px 0; cursor: pointer; }
    .qbd-check { position: relative; width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
    .qbd-check input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
    .qbd-check span {
        position: absolute; inset: 0; border-radius: 5px; pointer-events: none;
        border: 1.5px solid rgba(255,255,255,0.32); background: rgba(255,255,255,0.03);
        transition: background 0.2s, border-color 0.2s;
    }
    .qbd-check input:checked + span { background: #fff; border-color: #fff; }
    .qbd-check input:checked + span::after {
        content: ''; position: absolute; left: 5.5px; top: 2px; width: 4px; height: 8.5px;
        border: solid #0a192f; border-width: 0 2px 2px 0; transform: rotate(45deg);
    }
    .qbd-check input:focus-visible + span { outline: 2px solid rgba(255,255,255,0.8); outline-offset: 2px; }
    .qbd-opt-copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .qbd-opt-title { font-size: 0.8rem; font-weight: 600; color: #f8fafc; letter-spacing: -0.005em; }
    .qbd-opt-desc { font-size: 0.7rem; color: rgba(226,232,240,0.55); line-height: 1.4; }

    /* ════════ Vista previa: pestañas + navegador ════════ */
    .qbd-preview { position: relative; z-index: 1; display: flex; flex-direction: column; min-width: 0; }
    .qbd-tabs {
        position: relative; align-self: center;
        display: inline-flex; padding: 4px; margin: 0 0 16px;
        border-radius: 999px; background: rgba(255,255,255,0.07);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.07);
    }
    .qbd-tab {
        position: relative; z-index: 1;
        height: 34px; padding: 0 17px; border: 0; border-radius: 999px; cursor: pointer;
        background: transparent; color: rgba(226,232,240,0.72);
        font: 600 0.8rem var(--font-sans); letter-spacing: -0.005em; white-space: nowrap;
        transition: color 0.35s var(--ease-spring);
    }
    .qbd-tab:hover { color: #fff; }
    .qbd-tab[aria-selected="true"] { color: #0a192f; background: #fff; }
    .qbd-tab:focus-visible { outline: 2px solid rgba(255,255,255,0.8); outline-offset: 2px; }
    .qbd-tab-ind { display: none; }
    .qbd-tabs.is-ready .qbd-tab[aria-selected="true"] { background: transparent; }
    .qbd-tabs.is-ready .qbd-tab-ind {
        display: block; position: absolute; z-index: 0; top: 4px; bottom: 4px; left: 0; width: 0;
        border-radius: 999px; background: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.25), 0 8px 18px -10px rgba(0,0,0,0.6);
        transition: transform 0.45s var(--ease-spring), width 0.45s var(--ease-spring);
    }

    .qbd-browser {
        position: relative; flex: 1 1 0px; min-height: 560px;
        display: flex; flex-direction: column;
        background: #f3f2ef;
        border-radius: 16px 16px 0 0;
        overflow: hidden;
        container: qbdb / inline-size;
        box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 40px 90px -30px rgba(0,0,0,0.75);
    }
    .qbd-chrome {
        position: relative; z-index: 3; flex-shrink: 0;
        height: 44px; display: flex; align-items: center; justify-content: center; padding: 0 14px;
        background: #fbfbfa; border-bottom: 1px solid rgba(10,25,47,0.07);
    }
    .qbd-url {
        display: inline-flex; align-items: center; gap: 8px;
        max-width: min(470px, 100%); height: 28px; padding: 0 14px;
        border-radius: 999px; background: #f0f0ed;
        box-shadow: inset 0 0 0 1px rgba(10,25,47,0.05);
        color: #6b7280; font: 500 11.5px ui-monospace, 'SF Mono', Menlo, monospace;
