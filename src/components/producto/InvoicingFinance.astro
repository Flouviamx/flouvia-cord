</section>

<script>
    // Entrada en cascada de la cartera (una vez). El HTML ya es el estado final:
    // sin JS o con movimiento reducido, la pantalla se ve completa y quieta.
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);
    const app = document.querySelector<HTMLElement>('[data-ifn-app]');
    if (app && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const parts = app.querySelectorAll<HTMLElement>('.ifn-card, [data-ifn-row]');
        gsap.set(parts, { opacity: 0, y: 10 });
        ScrollTrigger.create({
            trigger: app, start: 'top 82%', once: true,
            onEnter: () => gsap.to(parts, { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out', stagger: 0.045, clearProps: 'transform' }),
        });
    }
</script>

