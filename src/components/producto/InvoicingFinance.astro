---
// /producto/facturacion — "Para equipos de finanzas" (A7).
//
// Dos calcas 1:1 de superficies reales:
//   - /app/cobranza (src/pages/app/cobranza/index.astro): mismo shell de
//     AppLayout (sidebar colapsada desde SIDEBAR_NAV, topbar, page-head con
//     tabs), mismos widgets, mismas claves de src/i18n/app.ts y la misma
//     aritmética de getCobranza() (src/lib/queries.ts) aplicada a datos demo.
//   - El correo de recordatorio de factura (notifyInvoiceReminder +
//     invoiceEmailHtml en src/lib/email.ts, brandEmailShell con el perfil de
//     marca por defecto).
// Los textos de UI salen del diccionario de la app con t(); los datos demo
// (clientes, folios, montos) viven aquí. Sin base de datos local: la calca se
// arma desde el markup y el CSS de la página, no desde una captura.
import { t } from '../../i18n/app';
import { iconInner, type IconName } from '../../lib/icons';
import { SIDEBAR_NAV } from '../../lib/sidebar-nav';
import { termLabel } from '../../lib/payment-terms';
import { facturacionFinanzas } from '../../lib/producto-facturacion-finanzas';
import { BRAND_LOGOS } from '../../lib/integraciones/catalogo';

interface Props { isEn?: boolean }
const { isEn = false } = Astro.props;
const L = isEn ? 'en' : 'es';
const C = facturacionFinanzas(L);
const LOC = isEn ? 'en-US' : 'es-MX';
const tpl = (s: string, vars: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '');

// ── Formato: el mismo que money(n, 0) y fmtCalendarDate() de fmt-server ──
const money0 = (n: number) => new Intl.NumberFormat(LOC, { style: 'currency', currency: 'MXN', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(n);
const money2 = (n: number) => new Intl.NumberFormat(LOC, { style: 'currency', currency: 'MXN', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const utc = (iso: string) => new Date(`${iso}T00:00:00Z`);
const calDate = (iso: string) => new Intl.DateTimeFormat(LOC, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(utc(iso)).replace('.', '');
const longDate = (iso: string) => new Intl.DateTimeFormat(LOC, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(utc(iso));
// Fecha del correo (invoiceEmailHtml): toLocaleDateString con mes corto.
const mailDate = (iso: string) => utc(iso).toLocaleDateString(LOC, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const initials = (nombre: string) => nombre.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '—';

// ── Cartera demo de Materiales del Valle, "hoy" = 15 oct 2026 ──
const HOY = '2026-10-15';
const RAW: { es: string; en: string; folio: string; origen: 'factura' | 'cotizacion'; terminos?: string; vence: string; total: number; promesa?: string }[] = [
    { es: 'Grupo Ferrex', en: 'Grupo Ferrex', folio: 'COT-0127', origen: 'cotizacion', terminos: 'net30', vence: '2026-08-08', total: 412300 },
    { es: 'Constructora GAMA', en: 'GAMA Construction', folio: 'A-001031', origen: 'factura', vence: '2026-09-01', total: 58904 },
    { es: 'Aceros del Norte', en: 'Norte Steel', folio: 'COT-0141', origen: 'cotizacion', terminos: 'net30', vence: '2026-10-06', total: 134850, promesa: '2026-10-15' },
    { es: 'Distribuidora El Zarco', en: 'El Zarco Distribution', folio: 'A-001048', origen: 'factura', vence: '2026-10-12', total: 96469.2 },
    { es: 'Constructora Apex', en: 'Apex Construction', folio: 'A-001052', origen: 'factura', vence: '2026-10-17', total: 73080 },
    { es: 'Distribuidora del Bajío', en: 'Bajío Distribution', folio: 'A-001055', origen: 'factura', vence: '2026-11-13', total: 218500 },
    { es: 'Inmobiliaria Cumbres', en: 'Cumbres Real Estate', folio: 'COT-0150', origen: 'cotizacion', terminos: 'net60', vence: '2026-12-02', total: 96120 },
];
const MS = 86400000;
// Misma derivación que getCobranzaUncached(): diff, overdue, bucket.
const items = RAW.map((r) => {
    const diff = Math.floor((utc(HOY).getTime() - utc(r.vence).getTime()) / MS);
    const overdue = diff > 0;
    const empresa = isEn ? r.en : r.es;
    return {
        ...r, empresa, inicial: initials(empresa),
        terminosLabel: r.origen === 'factura' ? '' : termLabel(r.terminos, L),
        overdue, diasVencido: overdue ? diff : 0, diasParaVencer: overdue ? 0 : -diff,
        bucket: !overdue ? 'vigente' : diff <= 30 ? 'd30' : diff <= 60 ? 'd60' : 'd60p',
    };
}).sort((a, b) => b.diasVencido - a.diasVencido || a.diasParaVencer - b.diasParaVencer);

const sum = (arr: typeof items) => arr.reduce((s, i) => s + i.total, 0);
const vencidas = items.filter((i) => i.overdue);
const venceSemana = items.filter((i) => !i.overdue && i.diasParaVencer <= 7);
const promesasHoy = items.filter((i) => i.promesa && i.promesa <= HOY);
const sinGestion = items.filter((i) => i.overdue && !i.promesa);
const prioridad = vencidas.slice().sort((a, b) => (b.total * Math.max(1, b.diasVencido)) - (a.total * Math.max(1, a.diasVencido))).slice(0, 4);
const AGING = [
    { key: 'vigente', label: t(L, 'cob.aging_vigente'), color: '#3b82f6' },
    { key: 'd30', label: t(L, 'cob.aging_d30'), color: '#f59e0b' },
    { key: 'd60', label: t(L, 'cob.aging_d60'), color: '#f97316' },
    { key: 'd60p', label: t(L, 'cob.aging_d60p'), color: '#ef4444' },
].map((a) => ({ ...a, monto: sum(items.filter((i) => i.bucket === a.key)) })).filter((a) => a.monto > 0);
const totalPorCobrar = sum(items);
// Cumplimiento histórico de promesas (demo): 8 cumplidas, 2 incumplidas.
const CUMPLIMIENTO = 80;

// ── Shell: la sidebar colapsada sale de la MISMA fuente que la real ──
const RAIL = SIDEBAR_NAV.map((g) => g.items);
const ico = (name: IconName) => iconInner(name);

// ── Correo de recordatorio (A-001048 de Distribuidora El Zarco) ──
const ORG = isEn ? 'Valle Materials' : 'Materiales del Valle';
const CLIENTE = isEn ? 'El Zarco Distribution' : 'Distribuidora El Zarco';
const MAIL = {
    vencida: {
        asunto: `${tpl(t(L, 'fact.e_asunto_vencida'), { numero: 'A-001048' })} — ${ORG}`,
        cuerpo: tpl(t(L, 'fact.e_vencida_cuerpo'), { numero: 'A-001048', org: ORG }),
        cuando: isEn ? 'Oct 15, 9:00 AM' : '15 oct, 9:00',
    },
    porvencer: {
        asunto: `${tpl(t(L, 'fact.e_asunto_porvencer'), { numero: 'A-001048' })} — ${ORG}`,
        cuerpo: tpl(t(L, 'fact.e_porvencer_cuerpo'), { numero: 'A-001048', org: ORG }),
        cuando: isEn ? 'Oct 5, 9:00 AM' : '5 oct, 9:00',
    },
};
const MAIL_LINK = 'https://cordhq.app/i/f7Qk2mZr9vXa';
const STATE_ICON: Record<string, IconName> = { auto: 'check-circle', click: 'bolt', soon: 'clock' };
// Logos: la misma fuente que /integraciones y la app (catalogo.ts). Favicon V2
// del dominio real donde la marca lo resuelve bien; el ícono de producto
// oficial donde el dominio solo devuelve la "G" genérica de Google (Gmail, Sheets).
---

<section class="ifn" aria-labelledby="ifn-title">
    <header class="ifn-intro">
        <div>
            <p class="ifn-eyebrow">{C.eyebrow}</p>
            <h2 id="ifn-title" class="ifn-h2 masked-title">{C.titulo}</h2>
        </div>
        <p class="ifn-sub reveal">{C.sub}</p>
    </header>

    <!-- 1 · Cartera por cobrar: calca de /app/cobranza -->
    <article class="ifn-ar">
        <div class="ifn-ar-head">
            <div class="ifn-text">
                <p class="ifn-k">{C.cartera.eyebrow}</p>
                <h3 class="ifn-h3">{C.cartera.titulo}</h3>
                <p class="ifn-copy reveal">{C.cartera.copy}</p>
                <p class="ifn-plan reveal">{C.cartera.plan}</p>
            </div>
            <ul class="ifn-list">
                {C.cartera.puntos.map((p) => (
                    <li class="reveal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico('check-circle')} /><span>{p}</span></li>
                ))}
            </ul>
        </div>

        <div class="ifn-stage ifn-stage-ar reveal" aria-hidden="true">
            <div class="ifn-app" data-ifn-app>
                <aside class="ifn-rail">
                    <span class="ifn-rail-org">M</span>
                    {RAIL.map((group, gi) => (
                        <Fragment>
                            {gi > 0 && <span class="ifn-rail-sep"></span>}
                            {group.map((it) => (
                                <span class:list={['ifn-rail-i', { on: it.id === 'cobranza' }]}>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico(it.icon)} />
                                    {it.badge === 'vencidas' && <i class="ifn-rail-dot"></i>}
                                </span>
                            ))}
                        </Fragment>
                    ))}
                    <span class="ifn-rail-i ifn-rail-foot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('sidebar')} /></span>
                </aside>

                <div class="ifn-main">
                    <header class="ifn-top">
                        <span class="ifn-burger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" set:html={ico('menu')} /></span>
                        <span class="ifn-search">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('search')} />
                            <span>{t(L, 'topbar.buscar')}</span><kbd>⌘K</kbd>
                        </span>
                        <span class="ifn-top-r">
                            <span class="ifn-create">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={ico('plus')} />
                                {t(L, 'layout.crear')}
                                <svg class="ifn-create-c" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={ico('chevron-down')} />
                            </span>
                            <span class="ifn-ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('bell')} /><b class="ifn-ti-count">3</b></span>
                            <span class="ifn-ti ifn-ti-x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('chat-help')} /></span>
                            <span class="ifn-ti ifn-ti-x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('sun')} /></span>
                            <span class="ifn-ti ifn-ti-x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('gear')} /></span>
                        </span>
                    </header>

                    <div class="ifn-ph">
                        <div class="ifn-ph-t">
                            <b>{t(L, 'cob.heading')}</b>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('pin')} />
                        </div>
                        <div class="ifn-ph-a">
                            <span class="ifn-chip-snap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('calendar')} />{tpl(t(L, 'cob.hoy'), { fecha: longDate(HOY) })}</span>
                            <span class="ifn-custom"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ico('sliders')} />{t(L, 'widgets.personalizar')}</span>
                        </div>
                    </div>
                    <div class="ifn-tabs"><span class="on">{t(L, 'cob.tab_cobranza')}</span><span>{t(L, 'cob.tab_ia')}</span></div>

                    <div class="ifn-grid">
                        <div class="ifn-card ifn-kpi">
                            <span class="ifn-kl">{t(L, 'cob.k_vencido')}</span>
                            <b class="editorial is-danger">{money0(sum(vencidas))}</b>
                            <small>{tpl(t(L, 'cob.k_vencido_sub'), { n: String(vencidas.length) })}</small>
                        </div>
                        <div class="ifn-card ifn-kpi ifn-m-hide">
                            <span class="ifn-kl">{t(L, 'cob.k_semana')}</span>
                            <b class="editorial">{money0(sum(venceSemana))}</b>
                            <small>{tpl(t(L, 'cob.k_semana_sub'), { n: String(venceSemana.length) })}</small>
                        </div>
                        <div class="ifn-card ifn-kpi ifn-m-hide">
                            <span class="ifn-kl">{t(L, 'cob.k_promesas')}</span>
                            <b class="editorial is-warn">{promesasHoy.length}</b>
                            <small>{tpl(t(L, 'cob.k_promesas_sub'), { n: String(promesasHoy.length) })}</small>
                            <small>{tpl(t(L, 'cob.k_promesas_ok'), { pct: String(CUMPLIMIENTO) })}</small>
                        </div>
                        <div class="ifn-card ifn-kpi ifn-m-hide">
                            <span class="ifn-kl">{t(L, 'cob.k_singestion')}</span>
                            <b class="editorial is-danger">{money0(sum(sinGestion))}</b>
                            <small>{tpl(t(L, 'cob.k_singestion_sub'), { n: String(sinGestion.length) })}</small>
                        </div>

                        <div class="ifn-card ifn-span2 ifn-m-hide">
                            <div class="ifn-sh">
                                <div><b>{t(L, 'cob.aging_titulo')}</b><span>{t(L, 'cob.aging_sub')}</span></div>
                                <strong class="editorial">{money0(totalPorCobrar)}</strong>
                            </div>
                            <div class="ifn-seg">
                                {AGING.map((a) => <i style={`flex:0 0 ${Math.max((a.monto / totalPorCobrar) * 100, 1.5).toFixed(2)}%;background:${a.color}`}></i>)}
                            </div>
                            <div class="ifn-seg-l">
                                {AGING.map((a) => (
                                    <div><i style={`background:${a.color}`}></i><span>{a.label}</span><b class="editorial">{money0(a.monto)}</b></div>
                                ))}
                            </div>
                        </div>
                        <div class="ifn-card ifn-span2 ifn-m-hide">
                            <div class="ifn-sh"><div><b>{t(L, 'cob.prioridad')}</b><span>{t(L, 'cob.prioridad_sub')}</span></div></div>
                            <div class="ifn-mini">
                                {prioridad.map((it) => (
                                    <div>
                                        <span><strong>{it.empresa}</strong><small>{it.folio} · {tpl(t(L, 'cob.vencida_dias'), { n: String(it.diasVencido) })}</small></span>
                                        <span class="ifn-mini-r">
                                            <b class="editorial">{money0(it.total)}</b>
                                            <i class="ifn-wa"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('chat')} /></i>
                                        </span>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div class="ifn-card ifn-span4 ifn-tcard">
                            <div class="ifn-sh ifn-sh-tbl">
                                <div><b>{t(L, 'cob.cuentas_por_cobrar')}</b></div>
                                <div class="ifn-chips">
                                    <span class="on">{t(L, 'cob.f_todas')}</span><span>{t(L, 'cob.f_vencidas')}</span><span>{t(L, 'cob.f_promesa')}</span><span>{t(L, 'cob.f_singestion')}</span>
                                </div>
                            </div>
                            <div class="ifn-th">
                                <span>{t(L, 'cob.th_cliente')}</span><span>{t(L, 'cob.th_folio')}</span><span>{t(L, 'cob.th_terminos')}</span><span>{t(L, 'cob.th_vence')}</span><span>{t(L, 'cob.th_estado')}</span><span class="r">{t(L, 'cob.th_saldo')}</span><span class="r">{t(L, 'cob.th_accion')}</span>
                            </div>
                            {items.map((it) => (
                                <div class="ifn-tr" data-ifn-row>
                                    <span class="ifn-cl"><i>{it.inicial}</i><span>{it.empresa}</span></span>
                                    <span class="ifn-fo">{it.folio}</span>
                                    <span class="ifn-mu ifn-terms">{it.terminosLabel}</span>
                                    <span class="ifn-mu ifn-due">{calDate(it.vence)}</span>
                                    <span class="ifn-est">
                                        {it.overdue
                                            ? <em class="over">{tpl(t(L, 'cob.vencida_dias'), { n: String(it.diasVencido) })}</em>
                                            : <em class="due">{it.diasParaVencer === 0 ? t(L, 'cob.vence_hoy') : tpl(t(L, 'cob.vence_en'), { n: String(it.diasParaVencer) })}</em>}
                                        {it.promesa && <em class="prom"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={ico('check')} />{tpl(t(L, 'cob.promete'), { fecha: calDate(it.promesa) })}</em>}
                                    </span>
                                    <span class="ifn-amt r editorial">{money0(it.total)}</span>
                                    <span class="ifn-acts r">
                                        {it.origen === 'cotizacion' && <i class:list={['ifn-prom', { has: !!it.promesa }]}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('calendar')} /></i>}
                                        <i class="ifn-wa"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ico('chat')} /></i>
                                        {it.origen === 'cotizacion'
                                            ? <span class="ifn-paid">{t(L, 'cob.cobrada')}</span>
                                            : <span class="ifn-paid inv">{t(L, 'cob.ver_factura')}</span>}
                                    </span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </article>

    <!-- 2 · Recupera más: el correo de recordatorio real -->
    <article class="ifn-row ifn-row-rec">
        <div class="ifn-stage ifn-stage-mail reveal" aria-hidden="true">
            {(['porvencer', 'vencida'] as const).map((k) => (
                <div class:list={['ifn-mail', `ifn-mail-${k}`]}>
                    <div class="ifn-mail-h">
                        <span class="ifn-mail-av">M</span>
                        <span class="ifn-mail-from"><b>{ORG}</b><small>{isEn ? 'to' : 'para'} raul@elzarco.mx</small></span>
                        <time>{MAIL[k].cuando}</time>
                    </div>
                    <p class="ifn-mail-subj">{MAIL[k].asunto}</p>
                    <div class="ifn-mail-bg">
                        <div class="ifn-mail-card">
                            <div class="ifn-mail-brand"><strong>{ORG}</strong></div>
                            <p class="ifn-mail-hi">{CLIENTE}</p>
                            <p class="ifn-mail-body" set:html={MAIL[k].cuerpo} />
                            <div class="ifn-mail-tbl">
                                <div><span>{t(L, 'fact.e_factura')}</span><span>A-001048</span></div>
                                <div><span>{t(L, 'fact.e_vence')}</span><span>{mailDate('2026-10-12')}</span></div>
                                <div class="s"><span>{t(L, 'fact.e_saldo')}</span><span>{money2(96469.2)}</span></div>
                            </div>
                            <span class="ifn-mail-btn">{t(L, 'fact.e_cta_pagar')}</span>
                            <p class="ifn-mail-copy">{t(L, 'email.copie_enlace')} <u>{MAIL_LINK}</u></p>
                            <p class="ifn-mail-foot">{ORG}{t(L, 'email.enviado_con_cord')}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
        <div class="ifn-text">
            <p class="ifn-k">{C.recupera.eyebrow}</p>
            <h3 class="ifn-h3">{C.recupera.titulo}</h3>
            <p class="ifn-copy reveal">{C.recupera.copy}</p>
            <ul class="ifn-list">
                {C.recupera.puntos.map((p) => (
                    <li class="reveal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico('check-circle')} /><span>{p}</span></li>
                ))}
            </ul>
            <p class="ifn-plan reveal">{C.recupera.plan}</p>
        </div>
    </article>

    <!-- 3 · Conciliación: manual frente a Cord, fila por fila -->
    <article class="ifn-conc">
        <div class="ifn-conc-head">
            <div>
                <p class="ifn-k">{C.conciliacion.eyebrow}</p>
                <h3 class="ifn-h3">{C.conciliacion.titulo}</h3>
            </div>
            <p class="ifn-copy reveal">{C.conciliacion.copy}</p>
        </div>
        <div class="ifn-ct" role="table" aria-label={C.conciliacion.titulo}>
            <div class="ifn-ct-h" role="row">
                <span role="columnheader">{C.conciliacion.colTarea}</span>
                <span role="columnheader">{C.conciliacion.colSin}</span>
                <span role="columnheader">{C.conciliacion.colCon}</span>
            </div>
            {C.conciliacion.filas.map((f) => (
                <div class="ifn-ct-r reveal" role="row">
                    <span role="cell" class="ifn-ct-task"><b>{f.tarea}</b><small>{f.detalle}</small></span>
                    <span role="cell" class="ifn-ct-sin"><em class="ifn-st ifn-st-manual">{C.conciliacion.manual}</em></span>
                    <span role="cell" class="ifn-ct-con">
                        <em class={`ifn-st ifn-st-${f.estado}`}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico(STATE_ICON[f.estado])} />
                            {C.conciliacion.estados[f.estado]}
                        </em>
                    </span>
                </div>
            ))}
