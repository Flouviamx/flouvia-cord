---
// DevBlockMockup — mockups de los bloques de /desarrolladores/[slug].
// Reescrito (jul 2026) al estándar de components/producto/BlockMockup.astro:
// ventanas COMPLETAS y densas (.dbm-app / .dbm-app-bar / .dbm-app-body /
// .dbm-app-foot) que llenan la tarjeta del bento — toolbar real de producto
// (título izq + badge der, SIN los 3 puntos macOS), tabla/lista/timeline con
// datos plausibles y footer. Para escenas de CÓDIGO/JSON se usa la variante
// .dbm-term — misma superficie LIGHT que .dbm-app (jul 2026: se eliminó la
// variante de terminal oscura, todos los mockups del sitio son claros).
// El prefijo dbm-* es autocontenido (Astro scopea <style> por componente).
// Cada escena expone hooks (ids/clases) que el <script> de [slug].astro anima
// como motion-graphic en loop. Copy/estructura vienen de desarrolladores.ts.
export interface Props {
    slug: string;
    index: number;
}
const { slug, index } = Astro.props;
---
<div class={`dbm-wrap dbm-${slug}-${index}`}>

  {/* ══════════════════════ API ══════════════════════ */}





  {/* ══════════════════════ MCP ══════════════════════ */}





  {/* ══════════════════════ ELEMENTS ══════════════════════ */}
  {slug === 'elements' && index === 0 && (
    <div class="dbm-term dbm-el-m0">
      <div class="dbm-term-bar">
        <span class="dbm-term-title">index.html</span>
        <span class="dbm-term-badge">Altura automática</span>
      </div>
      <div class="dbm-code dbm-el-code">
        <span class="dbm-jtag">&lt;script src=</span><span class="dbm-jstr">"…/embed.js"</span><span class="dbm-jtag">&gt;&lt;/script&gt;</span>
        <span class="dbm-jtag">&lt;div</span> data-cord-token=<span class="dbm-jstr">"…"</span><span class="dbm-jtag">&gt;</span><span class="dbm-cursor"></span>
      </div>
      <div class="dbm-el-preview">
        <div class="dbm-el-skel" id="elSkel"></div>
        <div class="dbm-el-mini" id="elMini"><span>Cotización lista</span><b class="editorial">$196,469.20</b></div>
      </div>
      <div class="dbm-term-foot"><span>Una línea de código</span><span class="dbm-term-total">iframe seguro</span></div>
    </div>
  )}

  {slug === 'elements' && index === 1 && (
    <div class="dbm-term dbm-el-m1">
      <div class="dbm-term-bar">
        <span class="dbm-term-title">@flouviahq/elements</span>
        <span class="dbm-term-badge">v1.0.0</span>
      </div>
      <div class="dbm-seg dbm-el-tabs">
        <span class="dbm-seg-on">HTML</span><span>React</span><span>Web Component</span>
      </div>
      <div class="dbm-code dbm-el-codebox" id="elCode">
        <span class="dbm-jtag">&lt;script src=</span><span class="dbm-jstr">"…/embed.js"</span><span class="dbm-jtag">&gt;</span>
      </div>
      <div class="dbm-term-foot"><span>npm i @flouviahq/elements</span><span class="dbm-term-total">React · Vue · Astro</span></div>
    </div>
  )}

  {slug === 'elements' && index === 2 && (
    <div class="dbm-app dbm-el-m2">
      <div class="dbm-app-bar">
        <span class="dbm-app-title">portal.tucliente.com</span>
        <span class="dbm-app-badge dbm-badge-blue">frame-ancestors</span>
      </div>
      <div class="dbm-el-embed">
        <div class="dbm-el-card">
          <div class="dbm-el-cardhead"><span class="dbm-avat a1" style="border-radius:7px;">MV</span><b>Tu cotización</b><span class="dbm-el-badge" id="elBadge">Revisar</span></div>
          <div class="dbm-kv"><span>Cemento gris 50kg × 120</span><b class="editorial">$21,840.00</b></div>
          <div class="dbm-kv"><span>Total con IVA</span><b class="editorial">$196,469.20</b></div>
          <div class="dbm-btn2 dbm-btn2-nav" id="elApprove">Aprobar cotización</div>
        </div>
        <div class="dbm-fake-cursor" id="elCursor">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 2l12 11.2-5.8.5 3.3 7.3-2.25 1-3.2-7.4-4.4 4.7z"/></svg>
        </div>
      </div>
      <div class="dbm-app-foot dbm-el2-event"><span><i class="dbm-evt-dot"></i>cord:approved · COT-0148</span><b>Evento nativo</b></div>
    </div>
  )}

  {slug === 'elements' && index === 3 && (
    <div class="dbm-app dbm-el-m3">
      <div class="dbm-app-bar">
        <span class="dbm-app-title">Eventos · cord-cotizador</span>
        <span class="dbm-app-badge dbm-badge-green">5 en vivo</span>
      </div>
      <div class="dbm-app-body">
        <div class="dbm-kv"><span>ready</span><b>iframe montado</b></div>
        <div class="dbm-kv"><span>approved</span><b>COT-0148</b></div>
        <div class="dbm-kv"><span>message</span><b>nuevo comentario</b></div>
        <div class="dbm-kv"><span>pay</span><b>checkout listo</b></div>
      </div>
      <div class="dbm-app-foot"><span>Mismos 5 en todos los SDKs</span><b>Un solo contrato</b></div>
    </div>
  )}

  {slug === 'elements' && index === 4 && (
    <div class="dbm-term dbm-el-m4">
      <div class="dbm-term-bar">
        <span class="dbm-term-title">types/index.d.ts</span>
        <span class="dbm-term-badge">Generado</span>
      </div>
      <pre class="dbm-code"><code><span class="dbm-jtag">export interface</span> CordCotizadorProps {`{`}
  token: <span class="dbm-jstr">string</span>;
  onApproved?: (d: QuoteEvent) =&gt; <span class="dbm-jstr">void</span>;
  onPay?: () =&gt; <span class="dbm-jstr">void</span>;
{`}`}</code></pre>
      <div class="dbm-term-foot"><span>Del build real, no a mano</span><span class="dbm-term-total">Nunca desincronizado</span></div>
    </div>
  )}

  {/* ══════════════════════ FX ══════════════════════ */}



  {/* ══════════════════════ FISCAL ══════════════════════ */}



  {/* ══════════════════════ INTEGRACIONES ══════════════════════ */}



</div>

<style>
  /* ════════════════════════════════════════════════════════════
     DEV BLOCK MOCKUP — ventanas completas (espejo de BlockMockup.astro)
     Prefijo dbm-* autocontenido. Superficie LIGHT para ambas variantes:
     ventanas de producto (.dbm-app) y escenas de código (.dbm-term).
  ════════════════════════════════════════════════════════════ */
  .dbm-wrap {
    position: relative; width: 100%; height: 100%;
    display: flex; align-items: flex-start; justify-content: center;
  }

  /* ── VENTANA LIGHT COMPLETA ── */
  .dbm-app {
    width: 100%;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid rgba(10,25,47,0.06);
    box-shadow: 0 1px 2px rgba(10,25,47,0.04), 0 18px 44px -14px rgba(10,25,47,0.16), 0 44px 90px -30px rgba(10,25,47,0.20);
    overflow: hidden; color: #0f172a; font-size: 0.76rem; text-align: left;
  }
  .dbm-app-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 16px; border-bottom: 1px solid rgba(10,25,47,0.06); background: #fcfdfe; }
  .dbm-app-title { font-size: 0.78rem; font-weight: 600; color: #0f172a; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dbm-app-badge { flex-shrink: 0; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; padding: 4px 10px; border-radius: 100px; color: #64748b; background: rgba(10,25,47,0.05); border: 1px solid rgba(10,25,47,0.09); }
  .dbm-badge-blue { color: #2563eb; background: rgba(37,99,235,0.09); border-color: rgba(37,99,235,0.2); }
  .dbm-badge-green { color: #059669; background: rgba(16,185,129,0.09); border-color: rgba(16,185,129,0.22); }
  .dbm-app-body { padding: 4px 6px 6px; }
  .dbm-app-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-top: 1px solid rgba(10,25,47,0.06); background: #fcfdfe; font-size: 0.72rem; color: #94a3b8; }
  .dbm-app-foot b { color: #0f172a; font-weight: 700; }

  /* key-value row */
  .dbm-kv { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border-bottom: 1px solid rgba(10,25,47,0.05); font-size: 0.77rem; color: #475569; }
  .dbm-kv:last-child { border-bottom: none; }
  .dbm-kv > b { color: #0f172a; font-weight: 600; }
  .dbm-uid { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .dbm-uid-tx { min-width: 0; }
  .dbm-uid-tx b { display: block; font-size: 0.78rem; color: #0f172a; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dbm-uid-tx span { display: block; font-size: 0.67rem; color: #94a3b8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dbm-avat { width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; font-size: 0.6rem; font-weight: 800; color: #fff; background: #334155; }
  .dbm-avat.a1 { background: #b45309; } .dbm-avat.a2 { background: #047857; } .dbm-avat.a3 { background: #6d28d9; } .dbm-avat.a4 { background: #1d4ed8; }
  .dbm-logo { width: 26px; height: 26px; border-radius: 7px; flex-shrink: 0; box-shadow: 0 1px 4px rgba(10,25,47,0.12); }
  .editorial { font-variant-numeric: tabular-nums; letter-spacing: -0.2px; }
  .dbm-kv .editorial { color: #0f172a; font-weight: 600; }
  .dbm-kv .editorial.g { color: #059669; }

  /* tags */
  .dbm-tg { flex-shrink: 0; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.4px; text-transform: uppercase; padding: 3px 9px; border-radius: 100px; }
  .dbm-tg-blue { color: #2563eb; background: rgba(37,99,235,0.09); border: 1px solid rgba(37,99,235,0.2); }
  .dbm-tg-green { color: #059669; background: rgba(16,185,129,0.09); border: 1px solid rgba(16,185,129,0.22); }
  .dbm-tg-amber { color: #d97706; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.25); }
  .dbm-tg-red { color: #dc2626; background: rgba(220,38,38,0.08); border: 1px solid rgba(220,38,38,0.2); }
  .dbm-tg-gray { color: #64748b; background: rgba(10,25,47,0.05); border: 1px solid rgba(10,25,47,0.1); }

  /* sync lane (api-0, mcp-1) */
  .dbm-sync-lane { display: flex; align-items: center; gap: 10px; padding: 14px 16px 10px; }
  .dbm-node { flex-shrink: 0; padding: 8px 12px; border-radius: 9px; font-size: 0.68rem; font-weight: 600; background: #f4f6f9; border: 1px solid rgba(10,25,47,0.07); color: #475569; }
  .dbm-node-soft { color: #475569; }
  .dbm-node-brand { background: #fff; border-color: rgba(37,99,235,0.22); box-shadow: 0 2px 10px rgba(37,99,235,0.1); display: inline-flex; align-items: center; padding: 9px 13px; }
  .dbm-node-brand img { height: 13px; width: auto; display: block; }
  .dbm-node-ext { color: #047857; border-color: rgba(16,185,129,0.28); background: rgba(16,185,129,0.05); }
  .dbm-rail { flex: 1; height: 2px; background: rgba(10,25,47,0.08); position: relative; border-radius: 2px; }
  .dbm-rail-dot { position: absolute; top: -3px; left: 0; width: 8px; height: 8px; border-radius: 50%; opacity: 0; }
  .dbm-rail-r { background: #2563eb; box-shadow: 0 0 10px rgba(37,99,235,0.6); }
  .dbm-rail-l { background: #059669; box-shadow: 0 0 10px rgba(16,185,129,0.6); }

  /* api-0 sync rows */
  .dbm-sync-row .dbm-ar, .dbm-sync-row .dbm-al { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 7px; font-weight: 800; flex-shrink: 0; }
  .dbm-sync-row .dbm-ar { color: #2563eb; background: rgba(37,99,235,0.1); }
  .dbm-sync-row .dbm-al { color: #059669; background: rgba(16,185,129,0.1); }

  /* api-1 auth */
  .dbm-keychip { display: flex; align-items: center; gap: 9px; padding: 10px 12px; margin: 8px 6px 4px; border-radius: 10px; background: #f4f6f9; border: 1px solid rgba(10,25,47,0.06); transition: opacity 0.3s; }
  .dbm-key-ico { width: 20px; height: 20px; flex-shrink: 0; color: #2563eb; }
  .dbm-key-ico svg { width: 100%; height: 100%; }
  .dbm-key-val { font-family: ui-monospace, monospace; font-size: 0.7rem; color: #0f172a; letter-spacing: 0.3px; flex: 1; }
  .dbm-keychip .dbm-tg { margin-left: auto; }
  .dbm-key-revoked { opacity: 0.55; }
  .dbm-key-revoked .dbm-key-val { text-decoration: line-through; color: #dc2626; }
  .dbm-scopes { display: flex; gap: 8px; padding: 8px 6px; }
  .dbm-scope { flex: 1; display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-radius: 9px; background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); font-size: 0.66rem; }
  .dbm-scope span { font-family: ui-monospace, monospace; color: #2563eb; font-weight: 600; }
  .dbm-scope b { color: #94a3b8; font-weight: 500; font-size: 0.6rem; margin-left: auto; }
  .dbm-scope-ck { width: 15px; height: 15px; border-radius: 50%; background: #10b981; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.52rem; font-style: normal; font-weight: 800; }
  .dbm-reqline { display: flex; justify-content: space-between; align-items: center; margin: 4px 6px 0; padding: 10px 12px; border-radius: 9px; background: #f8fafc; font-family: ui-monospace, monospace; font-size: 0.68rem; color: #64748b; }
  .dbm-status { font-weight: 700; color: #059669; }
  .dbm-status-fail { color: #dc2626; }
  .dbm-revoke-tag { cursor: default; transition: background 0.3s, color 0.3s; }

  /* segmented control */
  .dbm-seg { display: inline-flex; background: rgba(10,25,47,0.045); border-radius: 9px; padding: 3px; gap: 2px; margin: 8px 6px; flex-wrap: wrap; }
  .dbm-seg span { font-size: 0.62rem; font-weight: 700; color: #94a3b8; padding: 5px 10px; border-radius: 7px; white-space: nowrap; transition: color 0.25s, background 0.25s, box-shadow 0.25s; }
  .dbm-seg .dbm-seg-on { background: #ffffff; color: #0f172a; box-shadow: 0 1px 3px rgba(10,25,47,0.12); }

  /* mcp-0 tool list */
  .dbm-toollist { display: flex; flex-direction: column; gap: 3px; padding: 2px 6px 4px; }
  .dbm-toolrow { display: flex; align-items: center; gap: 9px; padding: 7px 10px; border-radius: 8px; background: #f8fafc; }
  .dbm-toolrow code { font-family: ui-monospace, monospace; font-size: 0.68rem; color: #334155; flex: 1; }
  .dbm-toolrow .dbm-tool-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; flex-shrink: 0; }
  .dbm-toolrow .dbm-tool-dot.dbm-w { background: #f59e0b; }

  /* mcp-1 log */
  .dbm-log { padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; font-family: ui-monospace, monospace; }
  .dbm-log > div { font-size: 0.68rem; color: #64748b; opacity: 0; display: flex; align-items: center; gap: 8px; }
  .dbm-log-t { color: #94a3b8; font-weight: 700; }
  .dbm-log-ok { color: #059669 !important; }
  .dbm-log-ok .dbm-log-t { color: #059669; }

  /* mcp-2 governance */
  .dbm-gov-target { background: rgba(37,99,235,0.045); }
  .dbm-gov-pill { flex-shrink: 0; font-size: 0.56rem; font-weight: 800; padding: 3px 9px; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.3px; }
  .dbm-gov-on { color: #059669; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.22); }
  .dbm-gov-off { color: #94a3b8; background: rgba(10,25,47,0.04); border: 1px solid rgba(10,25,47,0.08); }

  /* fx-0 */
  .dbm-fx-hero { display: flex; align-items: stretch; gap: 8px; padding: 10px 10px 12px; }
  .dbm-fx-side { flex: 1; background: #f8fafc; border: 1px solid rgba(10,25,47,0.05); border-radius: 10px; padding: 11px 12px; }
  .dbm-fx-side span { display: block; font-size: 0.56rem; font-weight: 800; letter-spacing: 0.4px; text-transform: uppercase; color: #a3adba; }
  .dbm-fx-side b { display: block; font-size: 1rem; color: #0f172a; margin-top: 4px; }
  .dbm-fx-side b.g { color: #059669; }
  .dbm-fx-arrow { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 0 2px; }
  .dbm-fx-arrow svg { width: 18px; height: 18px; color: #2563eb; }
  .dbm-fx-arrow em { font-style: normal; font-size: 0.52rem; font-family: ui-monospace, monospace; color: #94a3b8; white-space: nowrap; }
  .dbm-cbar { height: 8px; border-radius: 100px; background: #eef2f7; overflow: hidden; }
  .dbm-cbar > i { display: block; height: 100%; border-radius: 100px; }

  /* fiscal-0 inline code chip */
  .dbm-term-inline { margin: 6px 12px; padding: 9px 12px; border-radius: 9px; background: #f4f6f9; border: 1px solid rgba(10,25,47,0.06); font-family: ui-monospace, monospace; font-size: 0.64rem; color: #475569; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .dbm-term-inline code { color: #2563eb; }
  .dbm-term-inline b { color: #059669; font-weight: 700; }

  /* ── TERMINAL / CÓDIGO (light — espejo de .dbm-app) ── */
  .dbm-term {
    width: 100%;
    background: #ffffff;
    border-radius: 16px; border: 1px solid rgba(10,25,47,0.06); overflow: hidden;
    box-shadow: 0 1px 2px rgba(10,25,47,0.04), 0 18px 44px -14px rgba(10,25,47,0.16), 0 44px 90px -30px rgba(10,25,47,0.20);
    color: #334155; text-align: left;
  }
  .dbm-term-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 15px; border-bottom: 1px solid rgba(10,25,47,0.06); background: #fcfdfe; }
  .dbm-term-title { font-family: ui-monospace, monospace; font-size: 0.7rem; font-weight: 600; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dbm-term-method { font-weight: 800; color: #059669; margin-right: 4px; }
  .dbm-term-badge { flex-shrink: 0; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.4px; padding: 4px 10px; border-radius: 100px; color: #047857; background: rgba(16,185,129,0.10); border: 1px solid rgba(16,185,129,0.22); }
  .dbm-term-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 15px; border-top: 1px solid rgba(10,25,47,0.06); font-family: ui-monospace, monospace; font-size: 0.58rem; color: #94a3b8; }
  .dbm-term-total { color: #2563eb; }
  .dbm-code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; line-height: 1.7; font-size: 0.68rem; color: #334155; white-space: pre-wrap; padding: 12px 15px; margin: 0; }
  .dbm-api-json { padding: 12px 15px; }
  .dbm-api-json code { font-family: inherit; white-space: pre; }
  .dbm-hl-target { transition: color 0.3s; }
  .dbm-int-headers { padding: 10px 15px 4px; font-family: ui-monospace, monospace; font-size: 0.64rem; line-height: 1.9; }

  /* el-0/el-1 (dead) */
  .dbm-el-code { font-size: 0.6rem; }
  .dbm-el-codebox { min-height: 34px; transition: opacity 0.18s; }
  .dbm-cursor { display: inline-block; width: 6px; height: 12px; background: #0f172a; vertical-align: middle; margin-left: 2px; animation: dbm-blink 1s step-end infinite; }
  @keyframes dbm-blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
  .dbm-el-preview { position: relative; margin: 8px 15px 4px; height: 46px; border-radius: 9px; overflow: hidden; }
  .dbm-el-skel { position: absolute; inset: 0; border-radius: 9px; background: #eef1f5; background-image: linear-gradient(100deg, transparent 30%, rgba(10,25,47,0.07) 50%, transparent 70%); background-size: 200% 100%; }
  .dbm-el-mini { position: absolute; inset: 0; display: flex; align-items: center; justify-content: space-between; padding: 0 14px; border-radius: 9px; background: #fff; color: #0a192f; opacity: 0; }
  .dbm-el-mini span { font-size: 0.66rem; color: #64748b; font-weight: 600; }
  .dbm-el-mini b { font-size: 0.82rem; color: #0a192f; }

  /* el-2 embed (dead) */
  .dbm-el-embed { position: relative; padding: 14px; background: #f0ede8; }
  .dbm-el-card { background: #fff; border-radius: 12px; padding: 0.9rem; box-shadow: 0 10px 28px -8px rgba(10,25,47,0.18); border: 1px solid rgba(10,25,47,0.05); }
  .dbm-el-cardhead { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .dbm-el-cardhead b { font-size: 0.74rem; color: #0a192f; flex: 1; }
  .dbm-el-badge { font-size: 0.54rem; font-weight: 800; padding: 3px 8px; border-radius: 100px; color: #d97706; background: rgba(245,158,11,0.14); white-space: nowrap; transition: background 0.3s, color 0.3s; }
  .dbm-btn2 { text-align: center; font-size: 0.74rem; font-weight: 700; padding: 10px; border-radius: 9px; margin-top: 4px; }
