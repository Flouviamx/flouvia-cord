// Claves (getApiKeys). Las de OAuth no cuentan para el límite del plan.
type Key = { n: string; oauth?: boolean; mode?: 'live' | 'test'; type?: 'secret' | 'publishable'; masked?: string; scope: 'read' | 'write'; used: string; created: string; revoked?: boolean };
const hoy = (h: string) => T(`hoy, ${h}`, `today, ${h}`);
