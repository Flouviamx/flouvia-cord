// Mockups 1:1 de las páginas de /desarrolladores. Cada `id` calca una pantalla
// REAL de Cord (no una UI inventada):
//   wb-*, hero-workbench, oauth-apps, event-catalog
//           → Workbench de desarrolladores: chasis de
//             src/components/app/DevWorkbench.astro, pestañas de
//             src/pages/app/wb/[tab].astro, tokens de src/styles/workbench.css
//             + src/styles/developers.css. Los textos salen del MISMO diccionario
//             (`t()` de src/i18n/app.ts), así que si la app cambia un rótulo,
//             el mockup lo hereda.
//   mcp-*   → Ajustes › MCP (src/pages/app/ajustes/mcp.astro + SettingsShell).
//   app-*   → pantallas de la app en modo claro (Facturas).
//   code-*, hero-* de código → intercambios HTTP reales: rutas, headers y forma
//             de respuesta salen de src/pages/api/v1, src/lib/apiv1.ts,
//             src/lib/api-idempotency.ts, src/lib/webhooks.ts,
//             src/lib/webhook-delivery.ts y src/lib/mcp.ts. Si un contrato
//             cambia, cambia aquí.
//
// Escala: las pantallas del Workbench y de Ajustes se maquetan con los valores
// REALES de su CSS (rem, paddings, radios) y se reducen con `zoom` dentro de la
// ventana, como un screenshot escalado. Así la densidad y la proporción son las
// de la app, no una reinterpretación a ojo.
// El HTML es el estado final (prefers-reduced-motion lo ve completo).
import { t } from '../../i18n/app';

interface Props { id: string; isEn?: boolean }
const { id, isEn = false } = Astro.props;
const L: 'es' | 'en' = isEn ? 'en' : 'es';
const T = (es: string, en: string) => (isEn ? en : es);
const tx = (key: string) => t(L, key as any);
const tf = (key: string, vars: Record<string, string>) => {
    let s = tx(key);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};
const nf = (n: number) => new Intl.NumberFormat(isEn ? 'en-US' : 'es-MX').format(n);

// ── Resaltado de JSON (servidor). Una línea de entrada = una línea de salida:
// la animación del hero de la API parte el <code> por '\n'.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const hl = (src: string) => esc(src).replace(
    /("(?:[^"\\]|\\.)*")(\s*:)?|(-?\b\d+(?:\.\d+)?\b)|\b(true|false|null)\b/g,
    (_m, s, colon, n, kw) => s ? (colon ? `<span class="c-key">${s}</span>${colon}` : `<span class="c-str">${s}</span>`)
        : n ? `<span class="c-num">${n}</span>` : `<span class="c-num">${kw}</span>`,
);
const pretty = (o: unknown) => JSON.stringify(o, null, 2);

// ═══════════════════════ WORKBENCH ═══════════════════════
const WB_TABS = ['resumen', 'webhooks', 'eventos', 'api', 'registros', 'salud'];
const tabFor: Record<string, string> = {
    'hero-workbench': 'resumen', 'wb-logs': 'registros', 'wb-keys': 'api', 'wb-endpoints': 'api',
    'wb-webhooks': 'webhooks', 'wb-health': 'salud', 'oauth-apps': 'api', 'event-catalog': 'eventos',
};
const isWb = id in tabFor;

// Resumen: serie de 14 días (ok + error) como la arma getDevOverview().
const SERIE = [182, 241, 236, 254, 248, 262, 229, 271, 266, 258, 280, 274, 289, 214]
    .map((ok, i) => ({ ok, err: [4, 6, 3, 5, 9, 4, 3, 6, 2, 5, 4, 3, 5, 6][i] }));
const maxSerie = Math.max(...SERIE.map((s) => s.ok + s.err));
const pct = (n: number, max: number) => (n <= 0 || max <= 0 ? 0 : Math.max(3, Math.round((n / max) * 100)));
const SERIE_UI = SERIE.map((s) => ({ ...s, hCol: pct(s.ok + s.err, maxSerie), hErr: Math.round((s.err / (s.ok + s.err)) * 100) }));
const TOTAL_OK = SERIE.reduce((a, s) => a + s.ok, 0);
const TOTAL_ERR = SERIE.reduce((a, s) => a + s.err, 0);
const ERR_4XX = 52, ERR_5XX = TOTAL_ERR - 52;
const TOP_RUTAS: [string, number][] = [['/api/v1/cotizaciones', 31], ['/api/v1/clientes', 18], ['/api/v1/facturas', 9]];

// fmtTs() del controlador: es-MX quita el punto del mes ("30 sep, 16:43").
const when = (hhmm: string, day = 30) => (isEn ? `Sep ${day}, ${hhmm}` : `${day} sep, ${hhmm}`);
