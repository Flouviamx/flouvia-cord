{id === 'code-idempotency' && (
<div class="dm-win dm-code dm-dark">
    <div class="dm-code-bar"><code>{T('Reintento con la misma Idempotency-Key', 'Retry with the same Idempotency-Key')}</code><span class="dm-pill">/api/v1</span></div>
    <div class="dm-code-body">
<pre><code><span class="c-mut"># {T('1er intento: se crea la cotización', '1st attempt: the quote is created')}</span>
POST /api/v1/cotizaciones
<span class="c-key">Idempotency-Key</span>: pedido-7781
<span class="c-ok">← 200</span>  {`{`} <span class="c-key">"data"</span>: {`{`} <span class="c-key">"folio"</span>: <span class="c-str">"COT-0150"</span>, … {`}`} {`}`}

<span class="c-mut"># {T('2º intento (se cortó la red): misma llave, mismo cuerpo', '2nd attempt (network dropped): same key, same body')}</span>
POST /api/v1/cotizaciones
<span class="c-key">Idempotency-Key</span>: pedido-7781
<span class="c-ok">← 200</span>  <span class="c-key">Idempotent-Replayed</span>: true
      {`{`} <span class="c-key">"data"</span>: {`{`} <span class="c-key">"folio"</span>: <span class="c-str">"COT-0150"</span>, … {`}`} {`}`}
      <span class="c-mut"># {T('la misma respuesta, byte por byte', 'the same response, byte for byte')}</span>

<span class="c-mut"># {T('misma llave, otro cuerpo', 'same key, different body')}</span>
<span class="c-bad">← 422</span>  {`{`} <span class="c-key">"error"</span>: <span class="c-str">"Esta clave de idempotencia ya se usó con otra petición."</span>,
        <span class="c-key">"code"</span>: <span class="c-str">"idempotency_key_reused"</span> {`}`}

<span class="c-mut"># {T('la primera petición sigue en proceso', 'the first request is still running')}</span>
<span class="c-bad">← 409</span>  {`{`} <span class="c-key">"code"</span>: <span class="c-str">"idempotency_in_progress"</span> {`}`}</code></pre>
    </div>
