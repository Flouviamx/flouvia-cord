    <div class="dm-code-bar"><code>verify-cord.js</code><span class="dm-pill">Node.js</span></div>
    <div class="dm-code-body">
<pre><code><span class="c-kw">import</span> crypto <span class="c-kw">from</span> <span class="c-str">'node:crypto'</span>;

<span class="c-mut">// header = req.headers['x-cord-signature-v1'], rawBody = {T('cuerpo sin parsear', 'unparsed body')}</span>
<span class="c-kw">export function</span> <span class="c-fn">verifyCord</span>(rawBody, header, secret) {`{`}
  <span class="c-kw">const</span> parts = header.split(<span class="c-str">','</span>);
  <span class="c-kw">const</span> t = parts.find((p) =&gt; p.startsWith(<span class="c-str">'t='</span>))?.slice(<span class="c-num">2</span>);
  <span class="c-kw">if</span> (!t || Math.abs(Date.now() / <span class="c-num">1000</span> - Number(t)) &gt; <span class="c-num">300</span>) <span class="c-kw">return</span> <span class="c-num">false</span>;
  <span class="c-kw">const</span> expected = crypto.createHmac(<span class="c-str">'sha256'</span>, secret)
    .update(<span class="c-str">`$&#123;t&#125;.$&#123;rawBody&#125;`</span>).digest();
  <span class="c-mut">// {T('durante una rotación llegan dos v1: basta con que uno cuadre', 'during a rotation two v1 values arrive: one match is enough')}</span>
  <span class="c-kw">return</span> parts.filter((p) =&gt; p.startsWith(<span class="c-str">'v1='</span>)).some((p) =&gt; {`{`}
    <span class="c-kw">const</span> got = Buffer.from(p.slice(<span class="c-num">3</span>), <span class="c-str">'hex'</span>);
    <span class="c-kw">return</span> got.length === expected.length &amp;&amp; crypto.timingSafeEqual(got, expected);
  {`}`});
{`}`}</code></pre>
    </div>
</div>
)}

