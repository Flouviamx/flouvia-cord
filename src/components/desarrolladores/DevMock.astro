---
// Mockups 1:1 de las páginas de /desarrolladores. Cada `id` calca una pantalla
// REAL de Cord (no una UI inventada):
//   wb-*    → Workbench de desarrolladores (src/components/app/DevWorkbench.astro
//             + src/pages/app/wb/[tab].astro, tokens de src/styles/workbench.css)
//   mcp-*   → Ajustes › MCP (src/pages/app/ajustes/mcp.astro)
//   app-*   → pantallas de la app en modo claro (Facturas)
//   code-*, hero-* de código → intercambios HTTP reales: rutas, headers y forma
//             de respuesta salen de src/pages/api/v1, src/lib/apiv1.ts y
//             src/lib/webhook-delivery.ts. Si un contrato cambia, cambia aquí.
// El HTML es el estado final (prefers-reduced-motion lo ve completo).
interface Props { id: string; isEn?: boolean }
const { id, isEn = false } = Astro.props;
const T = (es: string, en: string) => (isEn ? en : es);

const WB_TABS = [
    ['resumen', T('Resumen', 'Overview')],
    ['webhooks', 'Webhooks'],
    ['eventos', T('Eventos', 'Events')],
    ['api', 'API'],
    ['registros', T('Registros', 'Logs')],
    ['salud', T('Salud', 'Health')],
];
const tabFor: Record<string, string> = {
    'hero-workbench': 'resumen', 'wb-logs': 'registros', 'wb-keys': 'api', 'wb-endpoints': 'api',
    'wb-webhooks': 'webhooks', 'wb-health': 'salud', 'oauth-apps': 'api',
};
const isWb = id in tabFor;

// Serie de 14 días del Resumen (ok + error). Valores plausibles, error bajo.
const SERIE = [182, 241, 236, 254, 248, 262, 229, 271, 266, 258, 280, 274, 289, 214].map((ok, i) => ({ ok, err: [4, 6, 3, 5, 9, 4, 3, 6, 2, 5, 4, 3, 5, 6][i] }));
const maxSerie = Math.max(...SERIE.map((s) => s.ok + s.err));

const LOGS = [
    ['200', 'POST', '/api/v1/cotizaciones', T('30 sep, 16:43', 'Sep 30, 16:43')],
    ['200', 'GET', '/api/v1/clientes', T('30 sep, 16:26', 'Sep 30, 16:26')],
    ['200', 'GET', '/api/v1/productos', T('30 sep, 16:09', 'Sep 30, 16:09')],
    ['200', 'PATCH', '/api/v1/clientes/9b41c2e0', T('30 sep, 15:52', 'Sep 30, 15:52')],
    ['422', 'POST', '/api/v1/cotizaciones', T('30 sep, 15:47', 'Sep 30, 15:47')],
    ['200', 'GET', '/api/v1/events', T('30 sep, 15:35', 'Sep 30, 15:35')],
    ['200', 'POST', '/api/v1/facturas', T('30 sep, 15:18', 'Sep 30, 15:18')],
    ['401', 'GET', '/api/v1/cobranza', T('30 sep, 15:02', 'Sep 30, 15:02')],
    ['200', 'POST', '/api/v1/facturas/f3a8d1c4', T('30 sep, 14:44', 'Sep 30, 14:44')],
    ['200', 'GET', '/api/v1/cotizaciones', T('30 sep, 14:27', 'Sep 30, 14:27')],
];
const MCP_TOOLS = [
    [T('Listar cotizaciones', 'List quotes'), 'r', T('Lista las cotizaciones del negocio, de la más nueva a la más vieja. Filtra por estado. Paginado con next_cursor.', 'Lists the business quotes, newest first. Filter by status. Paginated with next_cursor.'), 'listar_cotizaciones'],
    [T('Cartera vencida', 'Overdue receivables'), 'r', T('Resumen de cuentas por cobrar con foco en lo vencido: cuánto se debe, aging por antigüedad y detalle por cliente.', 'Receivables summary focused on overdue: how much is owed, aging buckets and per-client detail.'), 'cartera_vencida'],
    [T('Resumen del negocio', 'Business summary'), 'r', T('Panorama: tasa de cierre, ticket promedio, días a cierre y pronóstico de pipeline.', 'Overview: win rate, average ticket, days to close and pipeline forecast.'), 'resumen_negocio'],
    [T('Crear cotización (borrador)', 'Create quote (draft)'), 'w', T('Crea una cotización en BORRADOR, no la envía. Acepta idempotency_key: un reintento devuelve la misma cotización.', 'Creates a DRAFT quote, does not send it. Accepts idempotency_key: a retry returns the same quote.'), 'crear_cotizacion_borrador'],
    [T('Listar facturas', 'List invoices'), 'r', T('Facturas con su saldo y estado. Filtra por vencidas para responder "¿quién me debe?".', 'Invoices with balance and status. Filter overdue to answer "who owes me?".'), 'listar_facturas'],
    [T('Registrar pago de una cotización', 'Record a quote payment'), 'w', T('Registra que una cotización aprobada se pagó por fuera de Cord. Confirma con el usuario antes de llamarla.', 'Records that an approved quote was paid outside Cord. Confirm with the user before calling it.'), 'registrar_pago_cotizacion'],
];
const EVENTS = [
    [T('Cotizaciones', 'Quotes'), ['quote.created', 'quote.sent', 'quote.viewed', 'quote.approved', 'quote.rejected', 'quote.updated', 'quote.expired', 'quote.deleted', 'quote.paid', 'quote.approval_requested', 'quote.approval_decided', 'quote.comment_added']],
    [T('Facturas', 'Invoices'), ['invoice.issued', 'invoice.stamped', 'invoice.finalized', 'invoice.sent', 'invoice.paid', 'invoice.payment_failed', 'invoice.voided', 'invoice.marked_uncollectible', 'invoice.overdue']],
    [T('Pagos y depósitos', 'Payments and payouts'), ['payment.partial', 'payment.failed', 'refund.succeeded', 'refund.failed', 'payout.paid', 'payout.failed', 'dispute.created', 'dispute.closed']],
    [T('Clientes, catálogo y cobranza', 'Clients, catalog and collections'), ['client.created', 'client.updated', 'client.deleted', 'product.created', 'product.updated', 'product.deleted', 'task.created', 'task.completed', 'promise.created', 'promise.kept', 'promise.broken', 'account.updated']],
] as const;
const fav = (d: string) => `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${d}&size=64`;
const statusClass = (s: string) => (s.startsWith('2') ? 'ok' : 'bad');
---

<div class:list={['dm-wrap', `dm-${id}`]}>

{/* ═════════════════════════ WORKBENCH (oscuro) ═════════════════════════ */}
{isWb && (
<div class="dm-win dm-wb">
    <div class="dm-wb-tabs">
        {WB_TABS.map(([k, label]) => <span class:list={[k === tabFor[id] && 'on']}>{label}</span>)}
        <span class="dm-wb-chrome" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="19" cy="12" r="1.3"/></svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"/></svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </span>
    </div>

    {id === 'hero-workbench' && (
    <div class="dm-wb-body dm-wb-ov">
        <div>
            <div class="dm-wb-head"><b>{T('Tu integración', 'Your integration')}</b><span class="dm-seg"><i>{T('24 horas', '24 hours')}</i><i>{T('7 días', '7 days')}</i><i class="on">{T('14 días', '14 days')}</i></span></div>
            <div class="dm-card">
                <span class="dm-lbl">{T('Peticiones de API', 'API requests')}</span>
                <strong class="dm-big" data-dm-count="3628">3,628</strong>
                <div class="dm-bars">
                    {SERIE.map((s) => <span style={`height:${Math.round(((s.ok + s.err) / maxSerie) * 100)}%`}><u style={`height:${Math.max(4, Math.round((s.err / (s.ok + s.err)) * 100))}%`}></u></span>)}
                </div>
                <div class="dm-axis"><span>17/9</span><span>30/9</span></div>
                <div class="dm-legend"><span><i class="b"></i>{T('Correctas', 'Successful')} <b>3,563</b></span><span><i class="r"></i>{T('Con error', 'Failed')} <b>65</b></span><span class="dm-push">{T('Latencia prom.', 'Avg latency')} <b>142ms</b></span></div>
            </div>
            <div class="dm-two">
                <div class="dm-card">
                    <span class="dm-lbl">{T('Distribución de errores', 'Error breakdown')}</span>
                    <div class="dm-meter"><span>4xx</span><i><u class="amber" style="width:78%"></u></i><b>52</b></div>
                    <div class="dm-meter"><span>5xx</span><i><u class="red" style="width:20%"></u></i><b>13</b></div>
                </div>
                <div class="dm-card">
                    <span class="dm-lbl">{T('Entregas de eventos', 'Event deliveries')}</span>
                    <div class="dm-meter"><span>{T('Entregadas', 'Delivered')}</span><i><u class="green" style="width:96%"></u></i><b>1,284</b></div>
                    <div class="dm-meter"><span>{T('Fallidas', 'Failed')}</span><i><u class="red" style="width:4%"></u></i><b>6</b></div>
                </div>
            </div>
        </div>
        <aside>
            <b class="dm-side-t">{T('Salud', 'Health')}</b>
            <div class="dm-card dm-ok-card">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.7 2.6L16 9.6"/></svg>
                <b>{T('Sin alertas activas', 'No active alerts')}</b>
                <span>{T('Tu integración funciona sin problemas.', 'Your integration is running smoothly.')}</span>
            </div>
            <div class="dm-kv"><span>{T('Endpoints activos', 'Active endpoints')}</span><b>3/3</b></div>
            <div class="dm-kv"><span>{T('Eventos en cola', 'Queued events')}</span><b>0</b></div>
            <b class="dm-side-t dm-mt">{T('Recursos para desarrolladores', 'Developer resources')}</b>
            <div class="dm-link">{T('Documentación', 'Documentation')}<i>↗</i></div>
            <div class="dm-link">{T('Especificación OpenAPI', 'OpenAPI spec')}<i>↗</i></div>
            <div class="dm-link">{T('llms.txt (docs para IA)', 'llms.txt (AI docs)')}<i>↗</i></div>
            <div class="dm-link">{T('Servidor MCP', 'MCP server')}<i>→</i></div>
        </aside>
    </div>
    )}

    {id === 'wb-logs' && (
    <div class="dm-wb-body">
        <div class="dm-filters">
            <span class="dm-search">{T('Buscar por ruta…', 'Search by route…')}</span>
            <span class="dm-seg"><i class="on">{T('Todos', 'All')}</i><i>GET</i><i>POST</i></span>
            <span class="dm-seg"><i class="on">{T('Todos', 'All')}</i><i>2xx</i><i>4xx</i><i>5xx</i></span>
        </div>
        <div class="dm-logs">
            <div class="dm-card dm-loglist">
                {LOGS.map(([st, m, path, at], i) => (
                    <div class:list={['dm-logrow', i === 4 && 'sel']}><code class:list={['dm-st', statusClass(st)]}>{st}</code><span class:list={['dm-m', m.toLowerCase()]}>{m}</span><code class="dm-path">{path}</code><time>{at}</time></div>
                ))}
            </div>
            <div class="dm-card dm-detail">
                <span class="dm-lbl">{T('Petición a la API', 'API request')}</span>
                <code class="dm-detail-t"><b>POST</b> /api/v1/cotizaciones</code>
                <div class="dm-kv"><span>{T('Estado', 'Status')}</span><b class="bad">422</b></div>
                <div class="dm-kv"><span>{T('Fecha', 'Date')}</span><b>{T('30 sep 2026, 15:47:12', 'Sep 30, 2026, 15:47:12')}</b></div>
                <div class="dm-kv"><span>{T('Latencia', 'Latency')}</span><b>88 ms</b></div>
                <div class="dm-kv"><span>{T('Dirección IP', 'IP address')}</span><b>189.203.14.21</b></div>
                <div class="dm-kv"><span>{T('Clave de API', 'API key')}</span><b>{T('ERP · Sincronización', 'ERP · Nightly sync')}</b></div>
                <div class="dm-kv"><span>{T('Modo', 'Mode')}</span><b>live</b></div>
                <p class="dm-note">{T('Cord no almacena el cuerpo de las peticiones ni de las respuestas del API, para no guardar datos de tus clientes.', 'Cord does not store API request or response bodies, so your clients\' data is not kept.')}</p>
            </div>
        </div>
    </div>
    )}

    {(id === 'wb-keys' || id === 'oauth-apps') && (
    <div class="dm-wb-body">
        <div class="dm-card dm-section">
            <div class="dm-sec-head">
                <div><b class="dm-h">{T('Claves de API', 'API keys')}</b><p>{T('Conectan tu propio sistema o n8n con Cord. Zapier y Make no las necesitan: aparecen aquí como conexiones autorizadas.', 'They connect your own system or n8n to Cord. Zapier and Make do not need them: they show up here as authorized connections.')}</p></div>
                <div class="dm-sec-act"><span class="dm-seg"><i>{T('Prueba', 'Test')}</i><i class="on">{T('Vivo', 'Live')}</i></span><span class="dm-plan">{T('Plan Profesional', 'Professional plan')}: <b>3/20</b></span><span class="dm-btn">+ {T('Generar clave', 'Generate key')}</span></div>
            </div>
            <div class="dm-keys">
                <div class="dm-keyrow dm-keyhead"><span>{T('Nombre', 'Name')}</span><span>Token</span><span>{T('Permisos', 'Scope')}</span><span>{T('Último uso', 'Last used')}</span><span></span></div>
                {id === 'oauth-apps' && (
                    <Fragment>
                        <div class="dm-keyrow"><span class="dm-kn"><img src={fav('zapier.com')} alt="" width="16" height="16" />Zapier <em class="tag sec">OAuth</em></span><span class="dm-mut">{T('Conexión autorizada', 'Authorized connection')}</span><em class="tag write">{T('Escritura', 'Write')}</em><span class="dm-mut">{T('hoy, 10:41', 'today, 10:41')}</span><span class="dm-btn ghost">{T('Revocar', 'Revoke')}</span></div>
                        <div class="dm-keyrow"><span class="dm-kn"><img src={fav('make.com')} alt="" width="16" height="16" />Make <em class="tag sec">OAuth</em></span><span class="dm-mut">{T('Conexión autorizada', 'Authorized connection')}</span><em class="tag write">{T('Escritura', 'Write')}</em><span class="dm-mut">{T('ayer, 18:02', 'yesterday, 18:02')}</span><span class="dm-btn ghost">{T('Revocar', 'Revoke')}</span></div>
                        <div class="dm-keyrow"><span class="dm-kn">n8n · {T('Automatizaciones', 'Automations')} <em class="tag live">{T('Vivo', 'Live')}</em><em class="tag sec">{T('Secreta', 'Secret')}</em></span><code class="dm-tok">sk_live_••••••••••••c71e</code><em class="tag write">{T('Escritura', 'Write')}</em><span class="dm-mut">{T('hoy, 09:15', 'today, 09:15')}</span><span class="dm-btn ghost">{T('Revocar', 'Revoke')}</span></div>
                    </Fragment>
                )}
                {id === 'wb-keys' && (
                    <Fragment>
                        <div class="dm-keyrow"><span class="dm-kn">{T('Pruebas locales', 'Local testing')} <em class="tag test">{T('Prueba', 'Test')}</em><em class="tag sec">{T('Secreta', 'Secret')}</em></span><code class="dm-tok">sk_test_••••••••••••d77e</code><em class="tag write">{T('Escritura', 'Write')}</em><span class="dm-mut">{T('ayer, 11:00', 'yesterday, 11:00')}</span><span class="dm-btn ghost">{T('Revocar', 'Revoke')}</span></div>
                        <div class="dm-keyrow"><span class="dm-kn">{T('Portal de clientes', 'Client portal')} <em class="tag live">{T('Vivo', 'Live')}</em><em class="tag pub">{T('Pública', 'Publishable')}</em></span><code class="dm-tok">pk_live_••••••••••••41c9</code><em class="tag read">{T('Lectura', 'Read')}</em><span class="dm-mut">{T('hoy, 09:00', 'today, 09:00')}</span><span class="dm-btn ghost">{T('Revocar', 'Revoke')}</span></div>
                        <div class="dm-keyrow"><span class="dm-kn">{T('ERP · Sincronización', 'ERP · Nightly sync')} <em class="tag live">{T('Vivo', 'Live')}</em><em class="tag sec">{T('Secreta', 'Secret')}</em></span><code class="dm-tok">sk_live_••••••••••••8f2a</code><em class="tag write">{T('Escritura', 'Write')}</em><span class="dm-mut">{T('hoy, 10:57', 'today, 10:57')}</span><span class="dm-btn ghost" id="dmRevoke">{T('Revocar', 'Revoke')}</span></div>
                        <div class="dm-keyrow revoked"><span class="dm-kn">{T('Script de reportes', 'Reports script')} <em class="tag live">{T('Vivo', 'Live')}</em><em class="tag sec">{T('Secreta', 'Secret')}</em></span><code class="dm-tok">sk_live_••••••••••••b0e3</code><em class="tag read">{T('Lectura', 'Read')}</em><span class="dm-mut">{T('10 sep, 11:00', 'Sep 10, 11:00')}</span><em class="tag revoked">{T('Revocada', 'Revoked')}</em></div>
                    </Fragment>
                )}
            </div>
        </div>
    </div>
    )}

    {id === 'wb-endpoints' && (
    <div class="dm-wb-body">
        <div class="dm-card dm-section">
            <div class="dm-sec-head"><div><b class="dm-h">{T('Endpoints disponibles', 'Available endpoints')}</b><p>Base: <code>https://cordhq.app/api/v1</code> · {T('autentícate con', 'authenticate with')} <code>Authorization: Bearer &lt;{T('tu_clave', 'your_key')}&gt;</code></p></div><div class="dm-sec-act"><span class="dm-ln">Spec OpenAPI ↗</span><span class="dm-ln">llms.txt ↗</span></div></div>
            {[
                ['GET', '/me', T('A qué negocio pertenece la clave', 'Which business the key belongs to')],
                ['POST', '/cotizaciones', T('Crea una cotización (requiere escritura)', 'Creates a quote (write)')],
                ['POST', '/cotizaciones/:id', T('send · approve · reject · mark_paid', 'send · approve · reject · mark_paid')],
                ['POST', '/cotizaciones/ia', T('Propone líneas a partir del texto de un pedido', 'Proposes lines from an order text')],
                ['POST', '/facturas', T('Crea una factura en borrador', 'Creates a draft invoice')],
                ['POST', '/facturas/:id', T('finalize · send · payment · void · credit_note', 'finalize · send · payment · void · credit_note')],
                ['GET', '/events', T('Historial de eventos con cursor', 'Cursor-paged event history')],
                ['GET', '/cobranza', T('Cartera, vencidos y aging', 'Receivables, overdue and aging')],
            ].map(([m, p, d]) => <div class="dm-eprow"><span class:list={['dm-m', m.toLowerCase()]}>{m}</span><code>{p}</code><span>{d}</span></div>)}
        </div>
    </div>
    )}

    {id === 'wb-webhooks' && (
    <div class="dm-wb-body">
        <div class="dm-card dm-section">
            <div class="dm-sec-head"><div><b class="dm-h">{T('Endpoints de webhook', 'Webhook endpoints')}</b><p>{T('Cada aviso va firmado con', 'Every notice is signed with')} <code>X-Cord-Signature-V1</code>; {T('verifícalo con el secreto del endpoint.', 'verify it with the endpoint secret.')}</p></div><div class="dm-sec-act"><span class="dm-plan">{T('Plan Profesional', 'Professional plan')}: <b>3/16</b></span><span class="dm-btn">+ {T('Agregar endpoint', 'Add endpoint')}</span></div></div>
            {[
                ['https://erp.materialesdelvalle.mx/webhooks/cord', T('3 eventos', '3 events'), T('última 30 sep, 16:52 (200)', 'last Sep 30, 16:52 (200)'), true],
                ['https://hooks.zapier.com/hooks/catch/1834/b7x2', T('2 eventos', '2 events'), T('última 30 sep, 16:00 (200)', 'last Sep 30, 16:00 (200)'), false],
                ['https://api.crm-interno.mx/cord/events', T('2 eventos', '2 events'), T('última 30 sep, 16:40 (503)', 'last Sep 30, 16:40 (503)'), false],
            ].map(([url, ev, last, open]) => (
                <div class="dm-whrow">
                    <div class="dm-whmain">
                        <span class:list={['dm-chev', open && 'open']}>›</span>
                        <div><b>{url}</b><span class="dm-whmeta"><code>s••••••••••••</code><u>{T('Rotar secreto', 'Rotate secret')}</u> · {ev} · <em class:list={[String(last).includes('503') ? 'bad' : 'ok']}>{last}</em></span></div>
                        <span class="dm-whact"><span class="dm-btn ghost" id={open ? 'dmProbar' : undefined}>{T('Probar', 'Test')}</span><span class="dm-btn ghost">{T('Editar', 'Edit')}</span><span class="dm-toggle"></span></span>
                    </div>
                    {open && (
                        <div class="dm-deliv">
                            {[['quote.paid', '200', '1', '142 ms', '16:52'], ['quote.approved', '200', '1', '118 ms', '16:31'], ['invoice.finalized', '200', '2', '204 ms', '15:58']].map(([e, s, a, d, t]) => (
                                <div class="dm-delrow"><code>{e}</code><code class="dm-st ok">{s}</code><span>{T('intento', 'attempt')} {a}</span><span>{d}</span><time>{t}</time></div>
                            ))}
                        </div>
                    )}
                </div>
            ))}
        </div>
    </div>
    )}

    {id === 'wb-health' && (
    <div class="dm-wb-body">
        <div class="dm-card dm-alert-strip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5M12 16h.01"/></svg><b>{T('1 endpoint con fallos seguidos', '1 endpoint with consecutive failures')}</b><span>{T('Cord reintentará cada entrega hasta 11 veces.', 'Cord will retry each delivery up to 11 times.')}</span></div>
        <div class="dm-three">
            <div class="dm-card"><span class="dm-lbl">Endpoints</span>
                <div class="dm-kv"><span class="dm-ell">erp.materialesdelvalle.mx</span><b>{T('Activo', 'Active')}</b></div>
                <div class="dm-kv"><span class="dm-ell">hooks.zapier.com</span><b>{T('Activo', 'Active')}</b></div>
                <div class="dm-kv"><span class="dm-ell">api.crm-interno.mx</span><b class="amber">{T('3 fallos seguidos', '3 failures in a row')}</b></div>
            </div>
            <div class="dm-card"><span class="dm-lbl">{T('Cola de eventos', 'Event queue')}</span>
                <div class="dm-kv"><span>{T('Eventos en cola', 'Queued')}</span><b>2</b></div>
                <div class="dm-kv"><span>{T('Reintentos vencidos', 'Overdue retries')}</span><b>0</b></div>
                <div class="dm-kv"><span>{T('Eventos agotados', 'Exhausted')}</span><b>0</b></div>
                <div class="dm-kv"><span>{T('Entregadas', 'Delivered')}</span><b>1,284</b></div>
                <div class="dm-kv"><span>{T('Fallidas', 'Failed')}</span><b class="bad">6</b></div>
            </div>
            <div class="dm-card"><span class="dm-lbl">{T('Distribución de errores', 'Error breakdown')}</span>
                <div class="dm-meter"><span>4xx</span><i><u class="amber" style="width:78%"></u></i><b>52</b></div>
                <div class="dm-meter"><span>5xx</span><i><u class="red" style="width:20%"></u></i><b>13</b></div>
