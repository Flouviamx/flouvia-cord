---
// Cross-links al final de /desarrolladores/* y /elements — misma pieza que
// "Explora el resto del producto" de /producto/[slug]: lista hairline con las
// demás páginas para desarrolladores y una fila final a la documentación.
import { getLangFromUrl, publicPath } from '../../i18n/utils';
import { DEV_PAGES } from '../../lib/desarrolladores';
import { DEV_PAGES_EN } from '../../lib/desarrolladores.en';

export interface Props { current: string }
const { current } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const l = (p: string) => publicPath(p, lang);
const otros = (isEn ? DEV_PAGES_EN : DEV_PAGES).filter((p) => p.slug !== current);
const href = (slug: string) => l(slug === 'elements' ? '/elements' : `/desarrolladores/${slug}`);
const docsUrl = isEn ? 'https://docs.cordhq.app/en/docs' : 'https://docs.cordhq.app';
---

<section class="pp-more">
    <div class="pp-more-head">
        <h2 class="pp-h2 masked-title">{isEn ? 'Explore the rest of the developer platform.' : 'Explora el resto de la plataforma para desarrolladores.'}</h2>
    </div>
    <div class="pp-more-list">
        {otros.map((f) => (
            <a href={href(f.slug)} class="pp-more-row reveal">
                <div class="pp-more-info">
                    <b>{f.nav}</b>
                    <span>{f.sub.split('. ')[0].replace(/\.$/, '')}.</span>
                </div>
                <i class="pp-more-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </i>
            </a>
        ))}
        <a href={docsUrl} class="pp-more-row pp-docs-row reveal">
            <span class="pp-docs-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h11a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z" fill="currentColor" fill-opacity="0.12"/><path d="M4 4h11a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z"/><path d="M8 8.5h7M8 12h7" stroke-opacity="0.5"/></svg>
            </span>
            <div class="pp-more-info">
                <b>{isEn ? 'Documentation' : 'Documentación'}</b>
                <span>{isEn ? 'Guides, API reference and examples for every endpoint.' : 'Guías, referencia de la API y ejemplos de cada endpoint.'}</span>
            </div>
            <i class="pp-more-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </i>
        </a>
    </div>
</section>

<style>
    .pp-more { max-width: 1080px; margin: 0 auto; padding: 6rem 5% 8rem; }
    .pp-more-head { text-align: center; margin-bottom: 3.2rem; }
    .pp-more-list { display: flex; flex-direction: column; }
    .pp-more-row {
        display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
        padding: 1.6rem 0.4rem; border-bottom: 1px solid var(--color-border);
        text-decoration: none;
        transition: padding-left 0.4s var(--ease-spring), background 0.3s;
    }
    .pp-more-row:first-child { border-top: 1px solid var(--color-border); }
    .pp-more-row:hover { padding-left: 1.2rem; }
    .pp-docs-row { gap: 1rem; }
    .pp-docs-ico {
        flex-shrink: 0; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px;
        background: var(--color-bg-soft); color: var(--color-blue-deep);
        box-shadow: inset 0 0 0 1px rgba(10, 25, 47, 0.06);
        transition: background 0.4s var(--ease-spring), transform 0.4s var(--ease-spring);
    }
    .pp-docs-ico svg { width: 19px; height: 19px; }
    .pp-docs-row:hover .pp-docs-ico { background: #fff; transform: scale(1.04); }
    .pp-more-info { display: flex; flex-direction: column; gap: 0.3rem; flex: 1; }
    .pp-more-info b { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.3px; color: var(--color-text); }
    .pp-more-info span { font-size: 0.88rem; line-height: 1.5; color: var(--color-text-muted); }
    .pp-more-arrow {
        flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
        background: rgba(10,25,47,0.05); color: var(--color-blue-deep);
        display: flex; align-items: center; justify-content: center;
        transition: background 0.35s, color 0.35s, transform 0.5s var(--ease-spring);
    }
    .pp-more-arrow svg { width: 14px; height: 14px; }
    .pp-more-row:hover .pp-more-arrow { background: var(--color-blue-deep); color: #fff; transform: translateX(3px); }
</style>
