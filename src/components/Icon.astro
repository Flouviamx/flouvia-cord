---
import { iconInner, type IconName } from '../lib/icons';

interface Props {
    name: IconName;
    size?: number | string;
    [attr: string]: unknown;
}

const { name, size, ...rest } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width={size} height={size} aria-hidden="true" {...rest} set:html={iconInner(name)}></svg>
