<script>
    // Escalador ÚNICO del mockup del hero (antes había un segundo en index.astro
    // que competía por el mismo `transform` con un umbral fijo de 1080px).
    document.addEventListener('DOMContentLoaded', () => {
        const scaler = document.querySelector('.hero .mk-scaler') as HTMLElement;
        const space = document.querySelector('.hero .mk-space') as HTMLElement;
        if (!scaler || !space) return;

        // Bajo 760px el mockup tiene layout propio (ver el bloque @media del
        // <style>): re-compone en vez de encogerse, así que NO se escala.
        const MOBILE_MAX = 760;
        const GUTTER = 40;

        function scaleMockup() {
            // offsetWidth/offsetHeight ignoran el transform: miden el tamaño natural.
            const base = scaler.offsetWidth;
            const avail = window.innerWidth - GUTTER;
            if (window.innerWidth <= MOBILE_MAX || !base || avail >= base) {
                scaler.style.transform = 'none';
                space.style.height = 'auto';
                return;
            }
            const scale = avail / base;
            scaler.style.transform = `scale(${scale})`;
            space.style.height = `${scaler.offsetHeight * scale}px`;
        }

        window.addEventListener('resize', scaleMockup);
        scaleMockup();
        setTimeout(scaleMockup, 200);
        setTimeout(scaleMockup, 1000);
    });
</script>
