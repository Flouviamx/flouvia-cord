---
import { getLangFromUrl, publicPath, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (p: string) => publicPath(p, lang);
// Hero — estilo Stripe/Linear: gradient mesh sutil, mucho aire, tipografía grande,
// mockup grande con glow. Manteniendo navy/Inter/serif-italic de Flouvia.
// El mockup es una CALCA de la app real de hoy (light mode): sidebar clara con
// grupos (Principal / Mi dinero / Inteligencia), breadcrumbs + page header,
// stepper de estado del detalle y panel de actividad. Sin dots macOS.
---

<section class="hero">
    <!-- Fondo de Aurora Orgánica (Sobrio, Lujoso, Lento) -->
    <div class="hero-bg" aria-hidden="true">
        <div class="hero-aurora"></div>
    </div>

    <div class="hero-inner">
        <!-- Badge superior ultra-clean estilo Linear/Vercel -->
        <a href="#como" class="hero-badge reveal" aria-label="Ver novedades">
            <span class="badge-tag">{t("hero.badge.tag")}</span>
            <span class="badge-text">{t("hero.badge.text")}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>

        <!-- Título a la izquierda, descripción a la derecha (estilo ElevenLabs) -->
        <div class="hero-top">
            <h1 class="hero-title masked-title" set:html={t("hero.title")} />
            <p class="hero-desc reveal">
                {t("hero.desc")}
            </p>
        </div>

        <div class="hero-actions reveal">
            <a href={l("/registro")} class="btn-luxe">
                <span>{t("hero.btn.start")}</span>
                <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                <div class="btn-shimmer"></div>
            </a>
        </div>
    </div>

    <!-- ── MOCKUP (demo interactivo · calca de la app real) ──
         Calca 1:1 del detalle de cotización de /app en modo claro, a ~0.8 de escala:
         sidebar = src/components/app/Sidebar.astro (org switcher arriba, grupo plano +
         "Mi dinero" + "Inteligencia", logo y toggle al pie); topbar y page-head =
         AppLayout.astro (buscador ⌘K, Crear, iconos; migas + título + status pill);
         cuerpo = src/pages/app/cotizaciones/[id].astro (stepper de 5 pasos, d-head con
         total, tabla con unidad y precio de lista tachado, totales, Acciones + Actividad).
         El lienzo es #f5f5f7 como la app: el detalle no vive en una card. -->
    <div class="mk-space">
        <div class="mk-scaler">
            <div class="mockup-wrap reveal-mockup" id="heroDemo">
        <!-- Control de pasos: el visitante recorre el flujo de una cotización -->
        <div class="demo-steps" id="demoSteps" role="tablist" aria-label="Recorre el flujo de una cotización">
            <button class="demo-step is-active" data-step="0" role="tab" aria-selected="true"><span class="ds-n">1</span><span class="ds-label">{t("demo.step.1")}</span><span class="ds-fill" aria-hidden="true"></span></button>
            <button class="demo-step" data-step="1" role="tab" aria-selected="false"><span class="ds-n">2</span><span class="ds-label">{t("demo.step.2")}</span><span class="ds-fill" aria-hidden="true"></span></button>
            <button class="demo-step" data-step="2" role="tab" aria-selected="false"><span class="ds-n">3</span><span class="ds-label">{t("demo.step.3")}</span><span class="ds-fill" aria-hidden="true"></span></button>
            <button class="demo-step" data-step="3" role="tab" aria-selected="false"><span class="ds-n">4</span><span class="ds-label">{t("demo.step.4")}</span><span class="ds-fill" aria-hidden="true"></span></button>
            <button class="demo-step" data-step="4" role="tab" aria-selected="false"><span class="ds-n">5</span><span class="ds-label">{t("demo.step.5")}</span><span class="ds-fill" aria-hidden="true"></span></button>
        </div>

        <div class="mockup-glow" aria-hidden="true"></div>
        <div class="mockup" aria-hidden="true">
            <div class="mk-body">
                <!-- ── SIDEBAR (pill blanca flotante, igual que la app) ── -->
                <aside class="mk-side">
                    <div class="mk-acct">
                        <span class="mk-org-av">M</span>
                        <span class="mk-org-txt">
                            <span class="mk-org-eyebrow">{t("mk.org.eyebrow")}</span>
                            <span class="mk-org-name">Materiales del Valle</span>
                        </span>
                        <svg class="mk-org-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>

                    <nav class="mk-nav">
                        <div class="mk-grp">
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="14" y="14" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.1")}</span>
                            </span>
                            <span class="mk-navitem active">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8" stroke-opacity="0.5"/><line x1="16" y1="13" x2="8" y2="13" stroke-opacity="0.5"/><line x1="16" y1="17" x2="8" y2="17" stroke-opacity="0.5"/><polyline points="10 9 9 9 8 9" stroke-opacity="0.5"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.2")}</span>
                                <span class="mk-nav-badge">3</span>
                            </span>
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4" fill="currentColor" fill-opacity="0.25" stroke="none"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87" stroke-opacity="0.5"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke-opacity="0.5"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.3")}</span>
                            </span>
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m7.5 4.27 9 5.15" stroke-opacity="0.5"/><path d="m3.3 7 8.7 5 8.7-5" stroke-opacity="0.5"/><path d="M12 22V12" stroke-opacity="0.5"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.4")}</span>
                            </span>
                        </div>

                        <div class="mk-grp">
                            <span class="mk-grp-label">{t("mk.grp.1")}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><polyline points="15 2 15 7 20 7" stroke-opacity="0.5"/><path d="M9 13h6" stroke-opacity="0.55"/><path d="M9 17h4" stroke-opacity="0.55"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.5")}</span>
                            </span>
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.1" stroke="none"/><path d="M12 2v20" stroke-opacity="0.5"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.6")}</span>
                            </span>
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2" fill="currentColor" fill-opacity="0.15" stroke="none"/><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10" stroke-opacity="0.5"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.7")}</span>
                                <span class="mk-nav-badge danger">2</span>
                            </span>
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" fill-opacity="0.15" stroke="none"/><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M6 9H4M6 15H4M18 9h2M18 15h2M9 6V4M15 6V4M9 18v2M15 18v2" stroke-opacity="0.6"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.8")}</span>
                            </span>
                        </div>

                        <div class="mk-grp">
                            <span class="mk-grp-label">{t("mk.grp.2")}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M7 16l3-3 2.5 2.5L17 10"/><path d="M15 10h2v2" stroke-opacity="0.55"/><path d="M7 7h5" stroke-opacity="0.45"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.9")}</span>
                            </span>
                            <span class="mk-navitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="14" width="5" height="7" rx="1" fill="currentColor" fill-opacity="0.15" stroke="none"/><rect x="9.5" y="9" width="5" height="12" rx="1" fill="currentColor" fill-opacity="0.3" stroke="none"/><rect x="16" y="12" width="5" height="9" rx="1" fill="currentColor" fill-opacity="0.15" stroke="none"/><rect x="3" y="14" width="5" height="7" rx="1"/><rect x="9.5" y="9" width="5" height="12" rx="1"/><rect x="16" y="12" width="5" height="9" rx="1"/><circle cx="12" cy="5" r="1.6" fill="currentColor" fill-opacity="0.3"/></svg>
                                <span class="mk-nav-l">{t("mk.nav.10")}</span>
                            </span>
                        </div>
                    </nav>

                    <div class="mk-sb-foot">
                        <img src="/imgs/logo-cord-navy.png" alt="" class="mk-sb-logo" />
                        <span class="mk-sb-toggle">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2.5"/><rect x="3.5" y="8" width="5.5" height="8" rx="1.5" fill="currentColor" stroke="none"/></svg>
                        </span>
                    </div>
                </aside>

                <div class="mk-app">
                    <!-- ── TOPBAR (pill blanca, AppLayout) ── -->
                    <div class="mk-topbar">
                        <span class="mk-burger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg></span>
                        <span class="mk-search">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" fill="currentColor" fill-opacity="0.12"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <span class="mk-search-l">{t("mk.search")}</span>
                            <kbd>⌘K</kbd>
                        </span>
                        <span class="mk-tb-right">
                            <span class="mk-create">
                                <svg class="mk-create-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                <span class="mk-create-l">{t("mk.create")}</span>
                                <svg class="mk-create-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </span>
                            <span class="mk-tb-ico">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" fill="currentColor" fill-opacity="0.12"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                <i class="mk-notif-dot"></i>
                            </span>
                            <span class="mk-tb-ico mk-tb-desk">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z" fill="currentColor" fill-opacity="0.12"/><path d="M9.1 9a2.9 2.9 0 0 1 5.6 1c0 2-2.9 2.9-2.9 2.9"/><line x1="12" y1="17" x2="12" y2="17"/></svg>
                            </span>
                            <span class="mk-tb-ico mk-tb-desk">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor" fill-opacity="0.12"/></svg>
                            </span>
                            <span class="mk-tb-ico mk-tb-desk">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" fill="currentColor" fill-opacity="0.15"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                            </span>
                        </span>
                    </div>

                    <!-- ── PAGE HEAD (migas + título + status pill en ph-actions) ── -->
                    <div class="mk-ph">
                        <div class="mk-ph-titles">
                            <div class="mk-crumbs"><span>{t("mk.nav.2")}</span><b>COT-0148</b></div>
                            <div class="mk-ph-row">
                                <span class="mk-ph-title">COT-0148</span>
                                <span class="mk-pin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.68V6a3 3 0 1 0-6 0v4.68a2 2 0 0 1-1.11 1.86l-1.78.89A2 2 0 0 0 5 15.24Z" fill="currentColor" fill-opacity="0.12"/></svg></span>
                            </div>
                        </div>
                        <span class="mk-badge mk-badge-invoiced" id="mkStatus" data-s0={t("mk.stp.1")} data-s1={t("mk.stp.2")} data-s2={t("mk.stp.3")} data-s3={t("mk.stp.4")} data-s4={t("mk.stp.5")}>{t("mk.stp.5")}</span>
                    </div>

                    <main class="mk-main">
                        <!-- Stepper de 5 pasos (q-stepper): hecho = check verde, actual = navy -->
                        <div class="mk-stepper">
                            <div class="mk-stp" data-story="created"><span class="mk-stp-dot"><span class="mk-stp-n">1</span><svg class="mk-stp-ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span><span class="mk-stp-label">{t("mk.stp.1")}</span></div>
                            <div class="mk-stp" data-story="sent"><span class="mk-stp-dot"><span class="mk-stp-n">2</span><svg class="mk-stp-ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span><span class="mk-stp-label">{t("mk.stp.2")}</span></div>
                            <div class="mk-stp" data-story="viewed"><span class="mk-stp-dot"><span class="mk-stp-n">3</span><svg class="mk-stp-ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span><span class="mk-stp-label">{t("mk.stp.3")}</span></div>
                            <div class="mk-stp" data-story="approved"><span class="mk-stp-dot"><span class="mk-stp-n">4</span><svg class="mk-stp-ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span><span class="mk-stp-label">{t("mk.stp.4")}</span></div>
                            <div class="mk-stp is-current" data-story="invoiced"><span class="mk-stp-dot"><span class="mk-stp-n">5</span><svg class="mk-stp-ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span><span class="mk-stp-label">{t("mk.stp.5")}</span></div>
                        </div>

                        <div class="mk-grid">
                            <div class="mk-dmain">
                                <div class="mk-dhead">
                                    <div class="mk-dh-client">
                                        <span class="mk-dh-av">EZ</span>
                                        <div class="mk-dh-id">
                                            <div class="mk-dh-name">Distribuidora El Zarco</div>
                                            <div class="mk-dh-meta">{t("mk.meta")}</div>
                                        </div>
                                    </div>
                                    <div class="mk-dh-total">
                                        <span class="mk-dh-total-l">{t("mk.tot.3")}</span>
                                        <span class="editorial mk-dh-total-v" data-countup="196469.20" data-decimals="2">$196,469.20</span>
                                    </div>
                                </div>

                                <div class="mk-sec">{t("mk.sec.detail")}</div>
                                <div class="mk-table">
                                    <div class="mk-row mk-row-head"><span>{t("mk.row.head.1")}</span><span>{t("mk.row.head.2")}</span><span>{t("mk.row.head.3")}</span><span class="mk-r">{t("mk.row.head.4")}</span></div>
                                    <div class="mk-row">
                                        <span class="mk-prod">{t("mk.prod.1")}<small>{t("mk.unit.1")}</small></span>
                                        <span class="mk-qty">120</span>
                                        <span class="mk-price"><s>$198.00</s><span class="editorial">$182.00</span></span>
                                        <span class="editorial mk-amt">$21,840.00</span>
                                    </div>
                                    <div class="mk-row">
                                        <span class="mk-prod">{t("mk.prod.2")}<small>{t("mk.unit.2")}</small></span>
                                        <span class="mk-qty">340</span>
                                        <span class="mk-price"><s>$189.00</s><span class="editorial">$168.50</span></span>
                                        <span class="editorial mk-amt">$57,290.00</span>
                                    </div>
                                    <div class="mk-row">
                                        <span class="mk-prod">{t("mk.prod.3")}<small>{t("mk.unit.2")}</small></span>
                                        <span class="mk-qty">2,400</span>
                                        <span class="mk-price"><s>$16.50</s><span class="editorial">$14.20</span></span>
