---
// Dupla de tarjetas Startups / Elements del home, debajo del carrusel de
// integraciones. Cada una con una gama que no repite la de los pasos
// (azul, turquesa, violeta): coral para Startups y ámbar —la de las páginas
// para desarrolladores— para Elements.
import { getLangFromUrl, publicPath, useTranslations } from '../../i18n/utils';
import CordDynamicBg from '../CordDynamicBg.jsx';

const CTA_PALS = [
    { base: '#2A0F1A', color1: '#9F1239', color2: '#F43F5E', color3: '#FDA4AF' },
    { base: '#2A1405', color1: '#9A3412', color2: '#F59E0B', color3: '#FDE68A' },
];
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (p: string) => publicPath(p, lang);
---

<section class="cta-duo">
        <div class="cta-duo-grid">
            <a href={l('/soluciones/startups')} class="cta-card reveal">
                <div class="cta-card-text">
                    <h3 class="cta-card-h">{t('duo.1.h')}</h3>
                    <p class="cta-card-p">{t('duo.1.p')}</p>
                    <span class="cta-card-link">
                        {t('duo.1.link')}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </span>
                </div>
                <div class="cta-card-visual">
                    <CordDynamicBg client:only="react" colors={CTA_PALS[0]} grain={false} />
                </div>
            </a>

            <a href={l('/elements')} class="cta-card reveal">
                <div class="cta-card-text">
                    <h3 class="cta-card-h">{t('duo.2.h')}</h3>
                    <p class="cta-card-p">{t('duo.2.p')}</p>
                    <span class="cta-card-link">
                        {t('duo.2.link')}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </span>
                </div>
                <div class="cta-card-visual">
                    <CordDynamicBg client:only="react" colors={CTA_PALS[1]} grain={false} />
                </div>
            </a>
        </div>
</section>

<style>
    .cta-duo { background: var(--color-bg-soft); padding: 0 5% 7rem; margin-top: -3.5rem; position: relative; }
    /* Mismo fondo que el carrusel de integraciones, pegada a él: sin costura. */
    .cta-duo-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        max-width: 1180px;
        margin: 0 auto;
    }

    .cta-card {
        position: relative;
        display: flex;
        align-items: center;
        overflow: hidden;
        border-radius: 28px;
        min-height: 200px;
        padding: 2.2rem 2.4rem;
        background: #fff;
        text-decoration: none;
        box-shadow:
            0 2px 4px rgba(10,25,47,0.04),
            0 16px 32px 0 rgba(10,25,47,0.08),
            inset 0 1px 0 rgba(255,255,255,0.6);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    @media (hover: hover) {
        .cta-card:hover {
            transform: translateY(-6px);
            box-shadow:
                0 2px 4px rgba(10,25,47,0.05),
                0 24px 48px 0 rgba(10,25,47,0.12),
                inset 0 1px 0 rgba(255,255,255,0.6);
        }
    }

    .cta-card-text { position: relative; z-index: 2; max-width: 54%; }
    .cta-card-h {
        font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em;
        color: #0a192f; margin: 0 0 0.5rem;
    }
    .cta-card-p {
        font-size: 0.92rem; line-height: 1.55;
        color: var(--color-text-muted); margin: 0 0 1.1rem;
    }
    .cta-card-link {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 0.94rem; font-weight: 600; color: var(--color-blue-deep);
    }
    .cta-card-link svg { width: 16px; height: 16px; transition: transform 0.35s var(--ease-spring); }
    .cta-card:hover .cta-card-link svg { transform: translateX(4px); }

    /* El shader vive del lado derecho pero se DIFUMINA hacia el blanco de la
       tarjeta (mask-image, no un corte duro tipo clip-path). */
    .cta-card-visual {
        position: absolute;
        inset: 0;
        z-index: 1;
        -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 50%, rgba(0,0,0,0.35) 66%, #000 90%);
        mask-image: linear-gradient(100deg, transparent 0%, transparent 50%, rgba(0,0,0,0.35) 66%, #000 90%);
    }

    @media (max-width: 860px) {
        .cta-duo { padding-bottom: 4.5rem; margin-top: -2rem; }
        
        .cta-duo-grid { grid-template-columns: 1fr; gap: 1.2rem; }
        .cta-card {
            padding: 1.8rem 1.8rem;
            min-height: 150px;
        }
        .cta-card-text { max-width: 70%; }
        .cta-card-h { font-size: 1.25rem; margin-bottom: 0.35rem; }
        .cta-card-p { font-size: 0.88rem; margin-bottom: 0.9rem; }
        .cta-card-visual {
            -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 45%, rgba(0,0,0,0.3) 65%, #000 90%);
            mask-image: linear-gradient(100deg, transparent 0%, transparent 45%, rgba(0,0,0,0.3) 65%, #000 90%);
        }
    }
</style>
