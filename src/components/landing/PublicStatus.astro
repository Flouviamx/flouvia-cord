<script is:inline define:vars={{ i18n: {
    none: isEn ? 'No sample' : 'Sin muestra',
    passed: isEn ? 'passed' : 'correctas',
    samples: isEn ? 'samples' : 'muestras',
    sample: isEn ? 'sample' : 'muestra',
    locale,
    justNow: isEn ? 'just now' : 'hace un momento',
} }}>
    window.__stI18n = i18n;
</script>

<script>
    type I18n = { none: string; passed: string; samples: string; sample: string; locale: string; justNow: string };
    const i18n = (window as unknown as { __stI18n: I18n }).__stI18n;

    // ── Filas expandibles ──
    document.querySelectorAll<HTMLButtonElement>('.st-row-head').forEach((btn) => {
        btn.addEventListener('click', () => {
            const row = btn.closest<HTMLElement>('[data-row]');
            const detail = document.getElementById(btn.getAttribute('aria-controls') || '');
            if (!row || !detail) return;
            const open = btn.getAttribute('aria-expanded') !== 'true';
            btn.setAttribute('aria-expanded', String(open));
            row.classList.toggle('is-open', open);
            detail.hidden = !open;
        });
    });

    // ── Tooltip de barras: cursor, toque y teclado ──
    const tip = document.getElementById('st-tip');
    const tipDate = tip?.querySelector<HTMLElement>('.st-tip-date');
    const tipText = tip?.querySelector<HTMLElement>('.st-tip-text');
    const tipDot = tip?.querySelector<HTMLElement>('.st-tip-line i');
    let activeBars: HTMLElement | null = null;
    let activeBar: HTMLElement | null = null;
    let pinned = false;

    const visibleBars = (bars: HTMLElement) =>
        Array.from(bars.querySelectorAll<HTMLElement>('.st-bar')).filter((b) => b.offsetWidth > 0);

    const hide = () => {
        if (!tip) return;
        tip.hidden = true;
        activeBar?.classList.remove('is-on');
        activeBars?.classList.remove('is-active');
        activeBar = null;
        activeBars = null;
        pinned = false;
    };

    const show = (bars: HTMLElement, bar: HTMLElement) => {
        if (!tip || !tipDate || !tipText || !tipDot) return;
        if (activeBars && activeBars !== bars) activeBars.classList.remove('is-active');
        activeBar?.classList.remove('is-on');
        activeBars = bars;
        activeBar = bar;
        bars.classList.add('is-active');
        bar.classList.add('is-on');
        const { d = '', t = 'none', p = '', n = '', k = '' } = bar.dataset;
        tipDate.textContent = `${d} · UTC`;
        tipDot.className = t;
        if (t === 'none') {
            tipText.textContent = i18n.none;
        } else {
            const count = Number(n);
            const nf = new Intl.NumberFormat(i18n.locale);
            tipText.textContent = t === 'ok'
                ? `${p} · ${nf.format(count)} ${count === 1 ? i18n.sample : i18n.samples}`
                : `${p} · ${nf.format(Number(k))}/${nf.format(count)} ${i18n.passed}`;
        }
        tip.hidden = false;
        const r = bar.getBoundingClientRect();
        const tw = tip.offsetWidth;
        const th = tip.offsetHeight;
        const margin = 12;
        let left = r.left + r.width / 2 - tw / 2;
        left = Math.max(margin, Math.min(left, document.documentElement.clientWidth - tw - margin));
        tip.style.left = `${left + window.scrollX}px`;
        tip.style.top = `${r.top + window.scrollY - th - 10}px`;
    };

    const nearest = (bars: HTMLElement, clientX: number) => {
        let best: HTMLElement | null = null;
        let bestDist = Infinity;
        for (const b of visibleBars(bars)) {
            const r = b.getBoundingClientRect();
            const dist = Math.abs(r.left + r.width / 2 - clientX);
            if (dist < bestDist) { bestDist = dist; best = b; }
        }
        return best;
    };

    document.querySelectorAll<HTMLElement>('[data-bars]').forEach((bars) => {
        bars.addEventListener('pointermove', (e) => {
            if (e.pointerType !== 'mouse' || pinned) return;
            const bar = nearest(bars, e.clientX);
            if (bar && bar !== activeBar) show(bars, bar);
        });
        bars.addEventListener('pointerleave', (e) => {
            if (e.pointerType === 'mouse' && !pinned) hide();
        });
        bars.addEventListener('pointerdown', (e) => {
            const bar = nearest(bars, e.clientX);
            if (!bar) return;
            if (e.pointerType !== 'mouse') {
                pinned = true;
                show(bars, bar);
            } else if (pinned && bar === activeBar) {
                hide();
            } else {
                pinned = true;
                show(bars, bar);
            }
        });
        bars.addEventListener('focus', () => {
            const all = visibleBars(bars);
            const last = all[all.length - 1];
            if (last && activeBars !== bars) show(bars, last);
        });
        bars.addEventListener('blur', () => { if (activeBars === bars) hide(); });
        bars.addEventListener('keydown', (e) => {
            const all = visibleBars(bars);
            if (!all.length) return;
            const idx = activeBar && activeBars === bars ? all.indexOf(activeBar) : all.length - 1;
            let next = idx;
            if (e.key === 'ArrowLeft') next = Math.max(0, idx - 1);
            else if (e.key === 'ArrowRight') next = Math.min(all.length - 1, idx + 1);
            else if (e.key === 'Home') next = 0;
            else if (e.key === 'End') next = all.length - 1;
            else if (e.key === 'Escape') { hide(); return; }
            else return;
            e.preventDefault();
            show(bars, all[next]!);
        });
    });

    document.addEventListener('pointerdown', (e) => {
        if (pinned && !(e.target as HTMLElement).closest('[data-bars]')) hide();
    });
    window.addEventListener('resize', () => { if (activeBars) hide(); });

    // ── "Hace X min" vivo: la página no se cachea, pero puede quedarse abierta ──
    const rtf = new Intl.RelativeTimeFormat(i18n.locale, { numeric: 'auto', style: 'short' });
    const refresh = () => {
        document.querySelectorAll<HTMLTimeElement>('time[data-relative]').forEach((el) => {
            const ts = new Date(el.dataset.relative || '').getTime();
            if (!Number.isFinite(ts)) return;
            const mins = Math.round((ts - Date.now()) / 60_000);
            if (Math.abs(mins) < 1) el.textContent = i18n.justNow;
            else if (Math.abs(mins) < 60) el.textContent = rtf.format(mins, 'minute');
            else if (Math.abs(mins) < 2880) el.textContent = rtf.format(Math.round(mins / 60), 'hour');
            else el.textContent = rtf.format(Math.round(mins / 1440), 'day');
        });
    };
    setInterval(refresh, 60_000);
</script>

