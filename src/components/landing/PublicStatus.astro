---
import Layout from '../../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import PageAnims from './PageAnims.astro';
import { getLangFromUrl } from '../../i18n/utils';
import {
    getPublicStatusSnapshot,
    HEALTH_SERVICES,
    type HealthService,
    type PublicStatusSnapshot,
} from '../../lib/platform-health';

const isEn = getLangFromUrl(Astro.url) === 'en';
const SITE = 'https://cordhq.app';
const base = isEn ? `${SITE}/en` : SITE;
let loadFailed = false;
let snapshot: PublicStatusSnapshot;
try {
    snapshot = await getPublicStatusSnapshot();
} catch {
    loadFailed = true;
    snapshot = { state: 'unknown', services: [], history: [], incidents: [], windowStart: null, windowEnd: null };
}

const serviceCopy: Record<HealthService, { es: string; en: string; descEs: string; descEn: string }> = {
    database: {
        es: 'Núcleo de datos', en: 'Data core',
        descEs: 'Consulta sintética a Neon.', descEn: 'Synthetic query to Neon.',
    },
    stripe: {
        es: 'Conectividad con Stripe', en: 'Stripe connectivity',
        descEs: 'Lectura autenticada de la API de plataforma.', descEn: 'Authenticated read from the platform API.',
    },
    public_link: {
        es: 'Link público', en: 'Public link',
        descEs: 'Render completo de una cotización de demostración.', descEn: 'Full render of a demonstration quote.',
    },
};
const stateCopy = {
    operational: { es: 'Última comprobación sin fallos', en: 'Latest check passed' },
    degraded: { es: 'La última comprobación detectó degradación', en: 'Latest check detected degradation' },
    outage: { es: 'La última comprobación detectó una interrupción', en: 'Latest check detected an outage' },
    unknown: { es: 'Monitoreo en preparación', en: 'Monitoring in preparation' },
};
const incidentState = {
    investigating: { es: 'Investigando', en: 'Investigating' },
    identified: { es: 'Identificado', en: 'Identified' },
    monitoring: { es: 'Monitoreando', en: 'Monitoring' },
    resolved: { es: 'Resuelto', en: 'Resolved' },
};
const dateTime = (value: string) => new Intl.DateTimeFormat(isEn ? 'en-US' : 'es-MX', {
    dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC',
}).format(new Date(value));
const dayLabel = (value: string) => new Intl.DateTimeFormat(isEn ? 'en-US' : 'es-MX', {
    month: 'short', day: 'numeric', timeZone: 'UTC',
}).format(new Date(`${value}T00:00:00Z`));
const pct = (value: number) => value === 100 ? '100%' : `${value.toFixed(2)}%`;
const emptyBars = Array.from({ length: 30 });
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: isEn ? 'System status' : 'Estado del sistema', item: `${base}/desarrolladores/status` },
    ],
};
---

<Layout
    title={isEn ? 'System status - Cord' : 'Estado del sistema - Cord'}
    description={isEn
        ? 'Current and historical results from Cord synthetic platform checks.'
        : 'Resultados actuales e históricos de las comprobaciones sintéticas de la plataforma Cord.'}
>
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <Nav />
    <main class:list={['status-page', `is-${snapshot.state}`]}>
        <header class="st-hero">
            <div class="st-hero-inner reveal">
                <div class="st-badge">
                    <span class="st-dot" aria-hidden="true"></span>
                    {isEn ? stateCopy[snapshot.state].en : stateCopy[snapshot.state].es}
                </div>
                <h1 class="st-title masked-title">{isEn ? 'System status' : 'Estado del sistema'}</h1>
                <p class="st-sub">{isEn
                    ? 'Verified checks and measured history for Cord system performance.'
                    : 'Comprobaciones verificadas e historial medido del rendimiento del sistema.'}</p>
                <a class="st-support-btn" href={isEn ? '/en/soporte' : '/soporte'}>
                    {isEn ? 'Contact support' : 'Contactar soporte'}
                </a>
            </div>
        </header>

        <section class="st-container" aria-label={isEn ? 'Measured service status' : 'Estado de los servicios medidos'}>
            <div class="st-sticky-nav reveal">
                <div class="st-filters-glass" id="status-filters" role="tablist" aria-label={isEn ? 'Services' : 'Servicios'}>
                    {HEALTH_SERVICES.map((id, index) => (
                        <button
                            class:list={['filter-btn', { active: index === 0 }]}
                            id={`tab-${id}`}
                            type="button"
                            role="tab"
                            aria-controls={`panel-${id}`}
                            aria-selected={index === 0 ? 'true' : 'false'}
                            tabindex={index === 0 ? 0 : -1}
                            data-target={id}
                        >
                            {isEn ? serviceCopy[id].en : serviceCopy[id].es}
                        </button>
                    ))}
                </div>
            </div>

            <div class="st-chart-wrapper reveal" id="chart-wrapper">
                {HEALTH_SERVICES.map((id, index) => {
                    const service = snapshot.services.find((item) => item.service === id);
                    const history = snapshot.history.filter((day) => day.service === id);
                    const firstDay = history.at(0)?.day;
                    const currentState = !service || service.stale ? 'unknown' : service.ok ? 'ok' : 'failed';
                    const stateLabel = currentState === 'ok' ? (isEn ? 'Latest sample passed' : 'Última muestra correcta')
                        : currentState === 'failed' ? (isEn ? 'Latest sample failed' : 'Última muestra fallida')
                        : (isEn ? 'Awaiting recent samples' : 'Esperando muestras recientes');
                    return (
                        <article
                            class:list={['st-service-panel', { active: index === 0 }]}
                            id={`panel-${id}`}
                            role="tabpanel"
                            aria-labelledby={`tab-${id}`}
                            hidden={index !== 0}
                        >
                            <div class="st-panel-header">
                                <div class="st-panel-copy">
                                    <div class:list={['st-service-state', `state-${currentState}`]}>
                                        <span aria-hidden="true"></span>{stateLabel}
                                    </div>
                                    <h2 class="st-panel-title">{isEn ? serviceCopy[id].en : serviceCopy[id].es}</h2>
                                    <p class="st-panel-meta">{service
                                        ? `${isEn ? serviceCopy[id].descEn : serviceCopy[id].descEs} ${isEn ? 'Last sample' : 'Última muestra'}: ${dateTime(service.checkedAt)} UTC.`
                                        : loadFailed
                                            ? (isEn ? 'The measurement store is unavailable. No availability claim is shown.' : 'El almacén de mediciones no está disponible. No se afirma disponibilidad.')
                                            : (isEn ? 'Awaiting the first verified samples.' : 'Esperando las primeras muestras verificadas.')}</p>
                                </div>
                                <div class="st-panel-stats" aria-label={isEn ? 'Service metrics' : 'Métricas del servicio'}>
                                    <div class="st-stat">
                                        <span class="st-stat-label">{isEn ? 'Measured success' : 'Éxito medido'}</span>
                                        <strong class="st-stat-val editorial">{service ? pct(service.successPct) : '-'}</strong>
                                    </div>
                                    <div class="st-stat">
                                        <span class="st-stat-label">{isEn ? 'Latest latency' : 'Latencia reciente'}</span>
                                        <strong class="st-stat-val editorial">{service ? `${service.latencyMs} ms` : '-'}</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="st-bars-container">
                                {history.length > 0 ? (
                                    <div class="st-bars" role="img" aria-label={isEn ? 'Daily successful check history' : 'Historial diario de comprobaciones correctas'}>
                                        {history.map((day) => (
                                            <span
                                                class:list={['st-bar', day.successPct === 100 ? 'ok' : day.successPct >= 99 ? 'warn' : 'danger']}
                                                data-tooltip={`${dayLabel(day.day)} - ${pct(day.successPct)} - ${day.checks} ${isEn ? 'checks' : 'comprobaciones'}`}
                                            ><span class="sr-only">{dayLabel(day.day)}: {pct(day.successPct)}</span></span>
                                        ))}
                                    </div>
                                ) : (
                                    <div class="st-bars st-bars-empty" aria-hidden="true">
                                        {emptyBars.map(() => <span class="st-bar unknown"></span>)}
                                    </div>
                                )}
                                <div class="st-bars-legend">
                                    <span>{firstDay ? dayLabel(firstDay) : (isEn ? 'Measurement start' : 'Inicio de medición')}</span>
                                    <span class="st-legend-line" aria-hidden="true"></span>
                                    <span>{isEn ? 'Today' : 'Hoy'}</span>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>

            <p class="st-method-note">{isEn
                ? 'Percentages represent successful synthetic samples, not a contractual SLA or every user, route, region, or dependency. Missing or stale samples remain unknown.'
                : 'Los porcentajes representan muestras sintéticas correctas, no un SLA contractual ni a cada usuario, ruta, región o dependencia. Las muestras ausentes u obsoletas permanecen como desconocidas.'}</p>

            <div class="st-global-legend reveal" aria-label={isEn ? 'Chart legend' : 'Leyenda de la gráfica'}>
                <span><i class="ok" aria-hidden="true"></i>{isEn ? 'All checks passed' : 'Todas correctas'}</span>
                <span><i class="warn" aria-hidden="true"></i>{isEn ? 'Some checks failed' : 'Alguna falló'}</span>
                <span><i class="danger" aria-hidden="true"></i>{isEn ? 'Significant failure' : 'Fallo significativo'}</span>
                <span><i class="unknown" aria-hidden="true"></i>{isEn ? 'No sample' : 'Sin muestra'}</span>
            </div>

            <div class="st-incidents reveal" aria-labelledby="incidents-title">
                <h2 id="incidents-title">{isEn ? 'Past incidents' : 'Incidentes pasados'}</h2>
                {snapshot.incidents.length > 0 ? (
                    <div class="st-timeline">
                        {snapshot.incidents.map((incident) => (
                            <article class="st-incident">
                                <time class="st-incident-date" datetime={incident.startedAt}>{dateTime(incident.startedAt)} UTC</time>
                                <div class="st-incident-card">
                                    <div class="st-incident-heading">
                                        <h3>{isEn ? incident.titleEn : incident.titleEs}</h3>
                                        <span class:list={['st-incident-state', `severity-${incident.severity}`]}>{isEn ? incidentState[incident.status].en : incidentState[incident.status].es}</span>
                                    </div>
                                    <p>{isEn ? incident.summaryEn : incident.summaryEs}</p>
                                    <small>{isEn ? 'Last updated' : 'Última actualización'}: {dateTime(incident.updatedAt)} UTC</small>
                                </div>
                            </article>
                        ))}
                    </div>
                ) : (
                    <div class="st-empty-card">
                        <strong>{isEn ? 'No published incidents' : 'Sin incidentes publicados'}</strong>
                        <p>{isEn ? 'No operator incident has been published for the measured window.' : 'No se ha publicado ningún incidente de Operaciones para la ventana medida.'}</p>
                    </div>
                )}
            </div>
        </section>
    </main>
    <Footer />
    <PageAnims />
</Layout>

<script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('#status-filters .filter-btn'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.st-service-panel'));

    const selectService = (button: HTMLButtonElement) => {
        const targetId = button.dataset.target;
        filters.forEach((filter) => {
            const active = filter === button;
            filter.classList.toggle('active', active);
            filter.setAttribute('aria-selected', String(active));
            filter.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
            const active = panel.id === `panel-${targetId}`;
            panel.classList.toggle('active', active);
            panel.hidden = !active;
        });
    };

    filters.forEach((button, index) => {
        button.addEventListener('click', () => selectService(button));
        button.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            const direction = event.key === 'ArrowRight' ? 1 : -1;
            const next = filters[(index + direction + filters.length) % filters.length];
            if (!next) return;
            selectService(next);
            next.focus();
        });
    });
</script>

<style>
    .status-page { min-height:100dvh; padding:80px 0 8rem; color:#0a192f; background:#fdfdfd; }
    .st-hero { display:flex; justify-content:center; padding:clamp(4.5rem,8vw,7rem) 5% clamp(3rem,6vw,4.75rem); background:linear-gradient(180deg,var(--color-bg,#f8f9fb) 0%,#fdfdfd 100%); }
    .st-hero-inner { width:100%; max-width:800px; margin:0 auto; text-align:center; }
    .st-badge { display:inline-flex; align-items:center; gap:8px; margin:0 auto 1.5rem; padding:8px 16px; border-radius:999px; background:#f1f3f5; color:#626c78; box-shadow:inset 0 0 0 .5px rgba(10,25,47,.1); font-size:.78rem; font-weight:680; }
    .st-dot,.st-service-state span { flex:none; width:8px; height:8px; border-radius:50%; background:#9aa3ad; }
    .is-operational .st-badge { color:#176846; background:#e9f5ef; }
    .is-operational .st-badge .st-dot { background:#248a61; }
    .is-degraded .st-badge { color:#8a5c17; background:#f7f0e4; }
    .is-degraded .st-badge .st-dot { background:#b7791f; }
    .is-outage .st-badge { color:#9d3434; background:#faecec; }
    .is-outage .st-badge .st-dot { background:#c44747; }
    .st-title { max-width:800px; margin:0 auto; font-size:clamp(3rem,7vw,5.8rem); line-height:.98; letter-spacing:-.065em; font-weight:560; }
    .st-sub { max-width:620px; margin:1.5rem auto 0; color:#687381; font-size:clamp(1rem,2vw,1.15rem); line-height:1.7; }
    .st-support-btn { display:inline-flex; justify-content:center; margin-top:1.8rem; padding:11px 20px; border-radius:999px; background:#0a192f; color:#f8fafc; box-shadow:0 8px 22px rgba(10,25,47,.14); text-decoration:none; font-size:.86rem; font-weight:680; transition:transform .25s cubic-bezier(.16,1,.3,1),box-shadow .25s cubic-bezier(.16,1,.3,1); }
    .st-support-btn:hover { transform:translateY(-2px); box-shadow:0 12px 28px rgba(10,25,47,.2); }
    .st-support-btn:focus-visible,.filter-btn:focus-visible { outline:3px solid rgba(10,37,218,.28); outline-offset:3px; }
    .st-container { width:min(900px,calc(100% - 40px)); margin:0 auto; }
    .st-sticky-nav { display:flex; justify-content:center; margin:0 0 3.5rem; }
    .st-filters-glass { display:inline-flex; max-width:100%; gap:.35rem; padding:6px; overflow-x:auto; border-radius:999px; background:rgba(250,251,252,.78); backdrop-filter:blur(22px) saturate(145%); -webkit-backdrop-filter:blur(22px) saturate(145%); box-shadow:inset 0 0 0 .5px rgba(10,25,47,.11),0 12px 35px rgba(10,25,47,.075); scrollbar-width:none; }
    .st-filters-glass::-webkit-scrollbar { display:none; }
    .filter-btn { flex:none; border:0; border-radius:999px; padding:9px 18px; background:transparent; color:#5f6874; cursor:pointer; font:inherit; font-size:.82rem; font-weight:650; white-space:nowrap; transition:color .22s ease,background-color .22s ease,transform .22s ease; }
    .filter-btn:hover { color:#0a192f; background:rgba(10,25,47,.045); }
    .filter-btn.active { background:#111b2b; color:#f8fafc; box-shadow:0 5px 14px rgba(10,25,47,.16); }
    .st-chart-wrapper { min-height:270px; }
    .st-service-panel { display:none; }
    .st-service-panel.active { display:block; }
    .st-panel-header { display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; padding-bottom:1.25rem; border-bottom:1px solid rgba(10,25,47,.085); }
    .st-panel-copy { max-width:560px; }
    .st-service-state { display:flex; align-items:center; gap:7px; margin-bottom:.65rem; color:#687381; font-size:.7rem; font-weight:680; }
    .st-service-state.state-ok { color:#176846; }
    .st-service-state.state-ok span { background:#248a61; }
    .st-service-state.state-failed { color:#9d3434; }
    .st-service-state.state-failed span { background:#c44747; }
    .st-panel-title { margin:0; font-size:clamp(1.5rem,3vw,2rem); letter-spacing:-.04em; font-weight:650; }
    .st-panel-meta { max-width:560px; margin:.55rem 0 0; color:#747e8a; font-size:.8rem; line-height:1.55; }
    .st-panel-stats { display:flex; flex:none; gap:2.25rem; }
    .st-stat { display:flex; flex-direction:column; align-items:flex-end; }
    .st-stat-label { margin-bottom:.25rem; color:#8b949f; font-size:.63rem; font-weight:720; letter-spacing:.07em; text-transform:uppercase; }
    .st-stat-val { color:#0a192f; font-size:1.42rem; font-weight:540; }
    .st-bars-container { display:flex; flex-direction:column; gap:8px; margin-top:2rem; }
    .st-bars { display:flex; align-items:stretch; width:100%; height:38px; gap:3px; }
    .st-bar { position:relative; flex:1 1 6px; min-width:3px; border-radius:3px; background:#248a61; transition:opacity .2s ease,transform .2s ease; }
    .st-bar.warn { background:#c28b36; }
    .st-bar.danger { background:#c44747; }
    .st-bar.unknown { background:#e4e7eb; }
    .st-bars:not(.st-bars-empty) .st-bar { cursor:help; }
    .st-bars:not(.st-bars-empty) .st-bar:hover { opacity:.78; transform:scaleY(1.1); }
    .st-bar::after { content:attr(data-tooltip); position:absolute; bottom:calc(100% + 9px); left:50%; z-index:2; padding:7px 10px; border-radius:7px; background:#111b2b; color:#f8fafc; box-shadow:0 10px 25px rgba(10,25,47,.2); font-size:.68rem; font-weight:580; white-space:nowrap; opacity:0; pointer-events:none; transform:translateX(-50%) translateY(4px); transition:opacity .18s ease,transform .18s ease; }
    .st-bar:hover::after { opacity:1; transform:translateX(-50%) translateY(0); }
    .st-bar:first-child::after { left:0; transform:translateY(4px); }
    .st-bar:first-child:hover::after { transform:translateY(0); }
    .st-bar:last-child::after { right:0; left:auto; transform:translateY(4px); }
    .st-bar:last-child:hover::after { transform:translateY(0); }
    .st-bar:not([data-tooltip])::after { display:none; }
    .st-bars-legend { display:flex; align-items:center; gap:1rem; color:#929aa4; font-size:.7rem; font-weight:560; }
    .st-legend-line { flex:1; height:1px; background:rgba(10,25,47,.075); }
    .st-method-note { max-width:780px; margin:1.35rem 0 0; color:#818a95; font-size:.69rem; line-height:1.6; }
    .st-global-legend { display:flex; justify-content:center; flex-wrap:wrap; gap:1rem 2rem; margin:2.2rem 0 clamp(4rem,8vw,6.5rem); color:#687381; font-size:.76rem; font-weight:620; }
    .st-global-legend span { display:flex; align-items:center; gap:7px; }
    .st-global-legend i { width:9px; height:9px; border-radius:50%; background:#248a61; }
    .st-global-legend i.warn { background:#c28b36; }
    .st-global-legend i.danger { background:#c44747; }
    .st-global-legend i.unknown { background:#d9dde2; }
    .st-incidents > h2 { margin:0 0 1.5rem; color:#0a192f; font-size:clamp(1.45rem,3vw,1.85rem); letter-spacing:-.04em; font-weight:650; }
    .st-timeline { display:flex; flex-direction:column; gap:2rem; }
    .st-incident { display:flex; flex-direction:column; gap:.7rem; }
    .st-incident-date { padding-bottom:.55rem; border-bottom:1px solid rgba(10,25,47,.075); color:#4f5a68; font-size:.82rem; font-weight:650; }
    .st-incident-card,.st-empty-card { padding:1.5rem 1.75rem; border-radius:16px; background:#fbfbfa; box-shadow:inset 0 0 0 .5px rgba(10,25,47,.11),0 20px 45px -30px rgba(10,25,47,.2); }
    .st-incident-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
    .st-incident-heading h3 { margin:0; color:#0a192f; font-size:1rem; letter-spacing:-.015em; }
    .st-incident-state { flex:none; padding:5px 9px; border-radius:999px; background:#eef1f4; color:#626c78; font-size:.64rem; font-weight:700; }
    .st-incident-state.severity-major { color:#8a5c17; background:#f7f0e4; }
    .st-incident-state.severity-critical { color:#9d3434; background:#faecec; }
    .st-incident-card p,.st-empty-card p { margin:.8rem 0 0; color:#5f6b7a; font-size:.82rem; line-height:1.65; }
    .st-incident-card small { display:block; margin-top:1rem; color:#8a939e; font-size:.66rem; }
    .st-empty-card strong { color:#344153; font-size:.9rem; }
    .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    @media (prefers-reduced-motion:no-preference) {
        .is-operational .st-dot { animation:st-pulse 2.2s infinite; }
        .st-service-panel.active { animation:st-panel-in .32s cubic-bezier(.16,1,.3,1); }
    }
    @keyframes st-pulse { 0% { box-shadow:0 0 0 0 rgba(36,138,97,.35); } 70%,100% { box-shadow:0 0 0 7px rgba(36,138,97,0); } }
    @keyframes st-panel-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    @media (max-width:700px) {
        .status-page { padding-bottom:5rem; }
        .st-hero { padding-top:4rem; }
        .st-container { width:min(100% - 28px,900px); }
        .st-sticky-nav { justify-content:flex-start; margin-bottom:2.75rem; }
        .st-panel-header { align-items:flex-start; flex-direction:column; gap:1.5rem; }
        .st-panel-stats { width:100%; justify-content:space-between; gap:1rem; }
        .st-stat { align-items:flex-start; }
        .st-bars { gap:2px; }
        .st-global-legend { justify-content:flex-start; }
        .st-incident-heading { align-items:flex-start; flex-direction:column; }
    }
</style>
