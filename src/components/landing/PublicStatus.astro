---
import Layout from '../../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import PageAnims from './PageAnims.astro';
import { getLangFromUrl } from '../../i18n/utils';
import {
    getPublicStatusSnapshot,
    HEALTH_SERVICES,
    HEALTH_WINDOW_DAYS,
    type HealthService,
    type HealthServiceSnapshot,
    type PublicStatusSnapshot,
    type StatusIncident,
} from '../../lib/platform-health';

const isEn = getLangFromUrl(Astro.url) === 'en';
const t = (es: string, en: string) => (isEn ? en : es);
const locale = isEn ? 'en-US' : 'es-MX';
const SITE = 'https://cordhq.app';
const base = isEn ? `${SITE}/en` : SITE;

let loadFailed = false;
let snapshot: PublicStatusSnapshot;
try {
    snapshot = await getPublicStatusSnapshot();
} catch {
    loadFailed = true;
    snapshot = { state: 'unknown', services: [], history: [], incidents: [], windowStart: null, windowEnd: null };
}

const now = new Date();
const MOBILE_DAYS = 30;

// ── Copy de producto: qué es cada componente y qué mide exactamente su sonda ──
const serviceCopy: Record<HealthService, { name: [string, string]; measure: [string, string] }> = {
    app: {
        name: ['App', 'App'],
        measure: [
            'Se solicita la pantalla de inicio de sesión de Cord y se verifica que el documento se renderice completo desde el servidor.',
            'The Cord sign-in screen is requested and the document must render completely from the server.',
        ],
    },
    api: {
        name: ['API pública', 'Public API'],
        measure: [
            'Una petición sin llave a /api/v1 debe responder el 401 tipado de la propia API (missing_key), no un 404, un 500 ni una página HTML.',
            'A keyless request to /api/v1 must return the API’s own typed 401 (missing_key), not a 404, a 500 or an HTML page.',
        ],
    },
    database: {
        name: ['Núcleo de datos', 'Data core'],
        measure: [
            'Consulta sintética de solo lectura contra la base de datos PostgreSQL (Neon) que sostiene a todas las organizaciones.',
            'Read-only synthetic query against the PostgreSQL database (Neon) that serves every organization.',
        ],
    },
    public_link: {
        name: ['Link público de cotizaciones', 'Public quote link'],
        measure: [
            'Render completo de la cotización de demostración: la página debe incluir el documento y su folio, tal como la recibe un cliente.',
            'Full render of the demonstration quote: the page must include the document and its number, exactly as a client receives it.',
        ],
    },
    stripe: {
        name: ['Conexión con el procesador de pagos', 'Payment processor connection'],
        measure: [
            'Lectura autenticada del saldo de la plataforma en la API de Stripe.',
            'Authenticated read of the platform balance from the Stripe API.',
        ],
    },
    payments_webhook: {
        name: ['Confirmación de pagos', 'Payment confirmation'],
        measure: [
            'Solo falla si hay cobros esperando confirmación y los webhooks firmados de Stripe llevan más de 26 h sin llegar. Sin cobros pendientes, el silencio no cuenta como caída.',
            'Fails only when payments are awaiting confirmation and signed Stripe webhooks have not arrived for more than 26 h. With nothing pending, silence is not an outage.',
        ],
    },
    fiscal: {
        name: ['Timbrado fiscal CFDI', 'CFDI tax stamping'],
        measure: [
            'Lectura autenticada de la cuenta del proveedor de timbrado (Facturapi). Capacidad exclusiva de México.',
            'Authenticated read of the stamping provider account (Facturapi). Mexico-only capability.',
        ],
    },
    email: {
        name: ['Correo transaccional', 'Transactional email'],
        measure: [
            'Comprobación de la API de Resend con la llave de envío, sin mandar ningún correo.',
            'Check against the Resend API with the sending key, without sending any email.',
        ],
    },
    ai: {
        name: ['IA de Cord', 'Cord AI'],
        measure: [
            'Listado de modelos en la API de Anthropic. No consume tokens.',
            'Model listing on the Anthropic API. Consumes no tokens.',
        ],
    },
};
const OPTIONAL_PROBES = new Set<HealthService>(['fiscal', 'email', 'ai']);

const groups: { id: string; label: [string, string]; services: HealthService[] }[] = [
    { id: 'platform', label: ['Plataforma', 'Platform'], services: ['app', 'api', 'database'] },
    { id: 'client', label: ['Experiencia del cliente', 'Client experience'], services: ['public_link'] },
    { id: 'money', label: ['Dinero', 'Money'], services: ['stripe', 'payments_webhook'] },
    { id: 'integrations', label: ['Servicios integrados', 'Integrated services'], services: ['fiscal', 'email', 'ai'] },
];
// Si algún día se agrega una sonda al backend sin grupo, no desaparece de la página.
const grouped = new Set(groups.flatMap((g) => g.services));
const orphans = HEALTH_SERVICES.filter((s) => !grouped.has(s));
if (orphans.length) groups.push({ id: 'other', label: ['Otros', 'Other'], services: orphans });

// ── Formato ──
const fmtDay = (day: string, withYear = false) => new Intl.DateTimeFormat(locale, {
    month: 'short', day: 'numeric', ...(withYear ? { year: 'numeric' } : {}), timeZone: 'UTC',
}).format(new Date(`${day}T00:00:00Z`));
const fmtDateTime = (value: string) => new Intl.DateTimeFormat(locale, {
    dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC',
}).format(new Date(value));
const fmtPct = (value: number) => `${new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value)}${isEn ? '%' : ' %'}`;
const fmtInt = (value: number) => new Intl.NumberFormat(locale).format(value);
const rtf = new Intl.RelativeTimeFormat(locale, { numeric: 'auto', style: 'short' });
const relative = (value: string) => {
    const diffMin = Math.round((new Date(value).getTime() - now.getTime()) / 60_000);
    if (Math.abs(diffMin) < 1) return t('hace un momento', 'just now');
    if (Math.abs(diffMin) < 60) return rtf.format(diffMin, 'minute');
    const diffH = Math.round(diffMin / 60);
    if (Math.abs(diffH) < 48) return rtf.format(diffH, 'hour');
    return rtf.format(Math.round(diffH / 24), 'day');
};
const fmtDuration = (fromIso: string, toIso: string) => {
    const mins = Math.max(1, Math.round((new Date(toIso).getTime() - new Date(fromIso).getTime()) / 60_000));
    if (mins < 60) return `${mins} min`;
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    if (h < 48) return m ? `${h} h ${m} min` : `${h} h`;
    return `${Math.round(h / 24)} ${t('días', 'days')}`;
};

// ── Ventana de 90 días en UTC, contando desde hoy hacia atrás ──
const utcDay = (offset: number) => {
    const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() - offset));
    return d.toISOString().slice(0, 10);
};
const windowDays = Array.from({ length: HEALTH_WINDOW_DAYS }, (_, i) => utcDay(HEALTH_WINDOW_DAYS - 1 - i));
const windowStartDay = windowDays[0]!;
const mobileStartDay = windowDays[HEALTH_WINDOW_DAYS - MOBILE_DAYS]!;

type DayTone = 'ok' | 'warn' | 'danger' | 'none';
const dayTone = (checks: number, pct: number): DayTone => {
    if (checks <= 0) return 'none';
    if (pct >= 100) return 'ok';
    if (pct >= 95) return 'warn';
    return 'danger';
};

type CurrentState = 'ok' | 'failed' | 'nosignal';
const stateLabel: Record<CurrentState, [string, string]> = {
    ok: ['Operativo', 'Operational'],
    failed: ['Con fallas', 'Failing'],
    nosignal: ['Sin señal reciente', 'No recent signal'],
};

const rows = new Map(HEALTH_SERVICES.map((id) => {
    const service: HealthServiceSnapshot | undefined = snapshot.services.find((s) => s.service === id);
    const byDay = new Map(snapshot.history.filter((h) => h.service === id).map((h) => [h.day, h]));
    const days = windowDays.map((day) => {
        const h = byDay.get(day);
        const checks = h?.checks ?? 0;
        const ok = h?.successfulChecks ?? 0;
        const pct = h?.successPct ?? 0;
        return { day, checks, ok, pct, tone: dayTone(checks, pct) };
    });
    const sampled = days.filter((d) => d.checks > 0);
    const firstDay = sampled[0]?.day ?? null;
    const current: CurrentState = !service || service.stale || service.checks === 0 ? 'nosignal' : service.ok ? 'ok' : 'failed';
    const hasData = !!service && service.checks > 0;
    const warnDays = days.filter((d) => d.tone === 'warn').length;
    const dangerDays = days.filter((d) => d.tone === 'danger').length;
    const emptyDays = days.length - sampled.length;
    const name = t(...serviceCopy[id].name);
    const aria = hasData
        ? t(
            `${name}: ${fmtPct(service!.successPct)} de muestras correctas en la ventana. ${sampled.length} días medidos, ${warnDays + dangerDays} con fallas, ${emptyDays} sin muestra.`,
            `${name}: ${fmtPct(service!.successPct)} of samples passed in the window. ${sampled.length} days measured, ${warnDays + dangerDays} with failures, ${emptyDays} without samples.`,
        )
        : t(`${name}: sin muestras en los últimos ${HEALTH_WINDOW_DAYS} días.`, `${name}: no samples in the last ${HEALTH_WINDOW_DAYS} days.`);
    return [id, { id, service, days, firstDay, current, hasData, aria, name }];
}));

const counts = { ok: 0, failed: 0, nosignal: 0 };
for (const r of rows.values()) counts[r.current] += 1;

const latestCheck = snapshot.services.reduce<string | null>((acc, s) => (!acc || s.checkedAt > acc ? s.checkedAt : acc), null);

const bannerCopy: Record<PublicStatusSnapshot['state'], { title: [string, string]; body: [string, string] }> = {
    operational: {
        title: ['Todos los sistemas medidos operan con normalidad', 'All measured systems are operational'],
        body: ['La última ronda de sondas pasó en todos los componentes con señal.', 'The latest probe round passed on every component with signal.'],
    },
    degraded: {
        title: ['Algunos sistemas presentan fallas', 'Some systems are failing'],
        body: ['La última ronda detectó fallas en parte de los componentes. El resto opera con normalidad.', 'The latest round detected failures on some components. The rest are operating normally.'],
    },
    outage: {
        title: ['Interrupción en los sistemas medidos', 'Outage across measured systems'],
        body: ['La última ronda de sondas falló en todos los componentes medidos.', 'The latest probe round failed on every measured component.'],
    },
    unknown: {
        title: ['Sin señal suficiente para afirmar el estado', 'Not enough signal to confirm status'],
        body: loadFailed
            ? ['El almacén de mediciones no respondió. No se afirma disponibilidad.', 'The measurement store did not respond. No availability is claimed.']
            : ['Faltan muestras recientes de algún componente esencial, así que no se afirma que todo opere con normalidad.', 'Recent samples are missing for an essential component, so no all-clear is claimed.'],
    },
};

const incidentStatus: Record<StatusIncident['status'], [string, string]> = {
    investigating: ['Investigando', 'Investigating'],
    identified: ['Identificado', 'Identified'],
    monitoring: ['Monitoreando', 'Monitoring'],
    resolved: ['Resuelto', 'Resolved'],
};
const severityLabel: Record<StatusIncident['severity'], [string, string]> = {
    minor: ['Impacto menor', 'Minor impact'],
    major: ['Impacto mayor', 'Major impact'],
    critical: ['Impacto crítico', 'Critical impact'],
};
const openIncidents = snapshot.incidents.filter((i) => i.status !== 'resolved');
const pastIncidents = snapshot.incidents.filter((i) => i.status === 'resolved');

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: isEn ? 'System status' : 'Estado del sistema', item: `${base}/desarrolladores/status` },
    ],
};
---

<Layout
    title={isEn ? 'System status - Cord' : 'Estado del sistema - Cord'}
    description={isEn
        ? 'Current and historical results from Cord synthetic platform checks.'
        : 'Resultados actuales e históricos de las comprobaciones sintéticas de la plataforma Cord.'}
>
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <Nav />
    <main class:list={['status-page', `is-${snapshot.state}`]}>
        <header class="pp-hero st-hero">
            <div class="st-hero-inner">
                <p class="st-eyebrow reveal">{t('Estado del sistema', 'System status')}</p>
                <h1 class="st-title masked-title">{t('El estado de Cord, medido de verdad.', 'Cord’s status, actually measured.')}</h1>
                <p class="st-lead reveal">{t(
                    'Sondas sintéticas comprueban la app, la API, el link público, los pagos y los servicios integrados. Lo que todavía no se ha medido se muestra como tal.',
                    'Synthetic probes check the app, the API, the public link, payments and integrated services. Anything not yet measured is shown as such.',
                )}</p>
            </div>

            <div class="st-banner reveal" role="status">
                <div class="st-banner-main">
                    <span class="st-pulse" aria-hidden="true"><i></i></span>
                    <div class="st-banner-copy">
                        <h2>{t(...bannerCopy[snapshot.state].title)}</h2>
                        <p>
                            {t(...bannerCopy[snapshot.state].body)}
                            {' '}
                            {latestCheck ? (
                                <span class="st-banner-when">
                                    {t('Última comprobación', 'Last checked')}{' '}
                                    <time datetime={latestCheck} data-relative={latestCheck} title={`${fmtDateTime(latestCheck)} UTC`}>{relative(latestCheck)}</time>.
                                </span>
                            ) : (
                                <span class="st-banner-when">{t('Aún no hay comprobaciones registradas.', 'No checks recorded yet.')}</span>
                            )}
                        </p>
                        {openIncidents.length > 0 && (
                            <a class="st-banner-link" href="#incidentes">
                                {openIncidents.length === 1
                                    ? t('Hay 1 incidente en curso', '1 incident in progress')
                                    : t(`Hay ${openIncidents.length} incidentes en curso`, `${openIncidents.length} incidents in progress`)}
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
                            </a>
                        )}
                    </div>
                </div>
                <dl class="st-banner-counts">
                    <div class:list={[{ 'is-zero': counts.ok === 0 }]}><dt><i class="ok" aria-hidden="true"></i>{t('Operativos', 'Operational')}</dt><dd class="editorial">{counts.ok}</dd></div>
                    <div class:list={[{ 'is-zero': counts.failed === 0 }]}><dt><i class="danger" aria-hidden="true"></i>{t('Con fallas', 'Failing')}</dt><dd class="editorial">{counts.failed}</dd></div>
                    <div class:list={[{ 'is-zero': counts.nosignal === 0 }]}><dt><i class="none" aria-hidden="true"></i>{t('Sin señal', 'No signal')}</dt><dd class="editorial">{counts.nosignal}</dd></div>
                </dl>
            </div>
        </header>

        <section class="st-container" aria-labelledby="components-title">
            <div class="st-section-head reveal">
                <h2 id="components-title">{t('Componentes', 'Components')}</h2>
                <span>{t(`Últimos ${HEALTH_WINDOW_DAYS} días · UTC`, `Last ${HEALTH_WINDOW_DAYS} days · UTC`)}</span>
            </div>

            <div class="st-card reveal">
                {groups.map((group) => {
                    const groupRows = group.services.map((id) => rows.get(id)!);
                    const okCount = groupRows.filter((r) => r.current === 'ok').length;
                    return (
                        <section class="st-group" aria-labelledby={`group-${group.id}`}>
                            <div class="st-group-head">
                                <h3 id={`group-${group.id}`}>{t(...group.label)}</h3>
                                <span class="editorial">{t(`${okCount} de ${groupRows.length} ${groupRows.length === 1 ? 'operativo' : 'operativos'}`, `${okCount} of ${groupRows.length} operational`)}</span>
                            </div>
                            {groupRows.map((row) => {
                                const s = row.service;
                                const measuredSince = row.firstDay && row.firstDay > windowStartDay;
                                const measuredSinceMobile = row.firstDay && row.firstDay > mobileStartDay;
                                const sinceLabel = row.firstDay ? t(`Medido desde ${fmtDay(row.firstDay)}`, `Measured since ${fmtDay(row.firstDay)}`) : '';
                                return (
                                    <article class:list={['st-row', `is-${row.current}`]} data-row>
                                        <button
                                            class="st-row-head"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls={`detail-${row.id}`}
                                        >
                                            <span class="st-row-name">
                                                {row.name}
                                                <svg class="st-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                                            </span>
                                            <span class="st-row-state">
                                                <i aria-hidden="true"></i>{t(...stateLabel[row.current])}
                                            </span>
                                        </button>

                                        <div
                                            class="st-bars"
                                            role="img"
                                            tabindex="0"
                                            aria-label={row.aria}
                                            data-bars
                                        >
                                            {row.days.map((d, i) => (
                                                <span
                                                    class:list={['st-bar', d.tone, { 'is-older': i < HEALTH_WINDOW_DAYS - MOBILE_DAYS }]}
                                                    data-d={fmtDay(d.day, true)}
                                                    data-t={d.tone}
                                                    data-p={d.checks ? fmtPct(d.pct) : ''}
                                                    data-n={d.checks ? String(d.checks) : ''}
                                                    data-k={d.checks ? String(d.ok) : ''}
                                                ></span>
                                            ))}
                                        </div>

                                        <div class="st-axis" aria-hidden="true">
                                            <span class="st-axis-lg">{measuredSince ? sinceLabel : t(`${HEALTH_WINDOW_DAYS} días atrás`, `${HEALTH_WINDOW_DAYS} days ago`)}</span>
                                            <span class="st-axis-sm">{measuredSinceMobile ? sinceLabel : t(`${MOBILE_DAYS} días atrás`, `${MOBILE_DAYS} days ago`)}</span>
                                            <i></i>
                                            <span class="st-axis-uptime">
                                                {row.hasData
                                                    ? <><b class="editorial">{fmtPct(s!.successPct)}</b> {t('disponibilidad', 'uptime')}</>
                                                    : <><b class="editorial">—</b> {t('Sin datos todavía', 'No data yet')}</>}
                                            </span>
                                            <i></i>
                                            <span>{t('Hoy', 'Today')}</span>
                                        </div>

                                        <div class="st-detail" id={`detail-${row.id}`} hidden>
                                            <div class="st-detail-inner">
                                                <div class="st-detail-what">
                                                    <span class="st-k">{t('Qué se mide', 'What is measured')}</span>
                                                    <p>{t(...serviceCopy[row.id].measure)}</p>
                                                    {!row.hasData && OPTIONAL_PROBES.has(row.id) && (
                                                        <p class="st-detail-note">{t(
                                                            'Esta sonda solo corre donde la credencial del servicio está configurada. Mientras no haya muestras, no se afirma su estado.',
                                                            'This probe only runs where the service credential is configured. Until samples exist, no status is claimed.',
                                                        )}</p>
                                                    )}
                                                </div>
                                                <dl class="st-detail-kv">
                                                    <div>
                                                        <dt>{t('Última muestra', 'Latest sample')}</dt>
                                                        <dd>{s ? <><span class="editorial">{relative(s.checkedAt)}</span><small>{fmtDateTime(s.checkedAt)} UTC</small></> : '—'}</dd>
                                                    </div>
                                                    <div>
                                                        <dt>{t('Latencia', 'Latency')}</dt>
                                                        <dd>{s ? <span class="editorial">{fmtInt(s.latencyMs)} ms</span> : '—'}</dd>
                                                    </div>
                                                    <div>
                                                        <dt>{t('Muestras correctas', 'Passed samples')}</dt>
                                                        <dd>{s && s.checks > 0 ? <span class="editorial">{fmtInt(s.successfulChecks)} / {fmtInt(s.checks)}</span> : '—'}</dd>
                                                    </div>
                                                </dl>
                                            </div>
                                        </div>
                                    </article>
                                );
                            })}
                        </section>
                    );
                })}
            </div>

            <div class="st-foot reveal">
                <div class="st-legend" aria-label={t('Leyenda', 'Legend')}>
                    <span><i class="ok" aria-hidden="true"></i>{t('Todas correctas', 'All passed')}</span>
                    <span><i class="warn" aria-hidden="true"></i>{t('Alguna falló (≥ 95 %)', 'Some failed (≥ 95%)')}</span>
                    <span><i class="danger" aria-hidden="true"></i>{t('Menos de 95 %', 'Below 95%')}</span>
                    <span><i class="none" aria-hidden="true"></i>{t('Sin muestra', 'No sample')}</span>
                </div>
                <p class="st-method-note">{t(
                    'Los porcentajes representan muestras sintéticas correctas, no un SLA contractual ni a cada usuario, ruta, región o dependencia. Las muestras ausentes u obsoletas permanecen como desconocidas.',
                    'Percentages represent successful synthetic samples, not a contractual SLA or every user, route, region, or dependency. Missing or stale samples remain unknown.',
                )}</p>
            </div>

            <section class="st-incidents" id="incidentes" aria-labelledby="incidents-title">
                <div class="st-section-head reveal">
                    <h2 id="incidents-title">{t('Historial de incidentes', 'Incident history')}</h2>
                    <a href={isEn ? '/en/soporte' : '/soporte'}>{t('Contactar soporte', 'Contact support')}</a>
                </div>

                {openIncidents.map((incident) => (
                    <article class:list={['st-open', `sev-${incident.severity}`, 'reveal']}>
                        <div class="st-open-top">
                            <span class="st-open-status"><span class="st-pulse sm" aria-hidden="true"><i></i></span>{t('En curso', 'In progress')} · {t(...incidentStatus[incident.status])}</span>
                            <span class="st-sev">{t(...severityLabel[incident.severity])}</span>
                        </div>
                        <h3>{t(incident.titleEs, incident.titleEn)}</h3>
                        <p>{t(incident.summaryEs, incident.summaryEn)}</p>
                        <div class="st-meta">
                            <span>{t('Inició', 'Started')} <time datetime={incident.startedAt}>{fmtDateTime(incident.startedAt)} UTC</time></span>
                            <span>{t('Actualizado', 'Updated')} <time datetime={incident.updatedAt} data-relative={incident.updatedAt}>{relative(incident.updatedAt)}</time></span>
                        </div>
                    </article>
                ))}

                {pastIncidents.length > 0 ? (
                    <div class="st-past reveal">
                        {pastIncidents.map((incident) => (
                            <article class="st-past-row">
                                <time class="st-past-date" datetime={incident.startedAt}>
                                    <b class="editorial">{new Intl.DateTimeFormat(locale, { day: 'numeric', timeZone: 'UTC' }).format(new Date(incident.startedAt))}</b>
                                    <span>{new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' }).format(new Date(incident.startedAt))}</span>
                                </time>
                                <div class="st-past-body">
                                    <div class="st-past-title">
                                        <h3>{t(incident.titleEs, incident.titleEn)}</h3>
                                        <span class="st-resolved">{t('Resuelto', 'Resolved')}</span>
                                    </div>
                                    <p>{t(incident.summaryEs, incident.summaryEn)}</p>
                                    <div class="st-meta">
                                        <span>{fmtDateTime(incident.startedAt)} UTC</span>
                                        {incident.resolvedAt && <span>{t('Duración', 'Duration')} <b class="editorial">{fmtDuration(incident.startedAt, incident.resolvedAt)}</b></span>}
                                        <span>{t(...severityLabel[incident.severity])}</span>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                ) : openIncidents.length === 0 && (
                    <div class="st-empty reveal">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3 5 6v5.2c0 4.3 2.9 8.2 7 9.8 4.1-1.6 7-5.5 7-9.8V6l-7-3Z" fill="currentColor" fill-opacity="0.14"/>
