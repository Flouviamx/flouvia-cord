---
import { getLangFromUrl, publicPath, useTranslations } from '../../i18n/utils';
import { INTEGRATION_PAGES } from '../../lib/integraciones-landing';
import IntegrationCard from '../integraciones/IntegrationCard.astro';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (p: string) => publicPath(p, lang);
const en = lang === 'en';
---

<section class="cnx" id="integraciones">
    <div class="cnx-inner">
        <p class="cnx-eyebrow reveal">{t("cnx.eyebrow")}</p>
        <div class="cnx-head-row">
            <h2 class="cnx-title reveal">{t("cnx.title")}</h2>
            <div class="cnx-aside">
                <p class="cnx-sub reveal">{t("cnx.sub")}</p>
                <div class="cnx-ctas reveal">
                    <a href={l("/producto/workflows")} class="cnx-cta cnx-cta-primary">
                        {t("cnx.cta.wf")}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                    </a>
                    <a href={l("/integraciones")} class="cnx-cta">
                        {t("cnx.cta.all")}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                    </a>
                </div>
            </div>
        </div>
        <div class="cnx-nav reveal">
            <button type="button" class="cnx-arrow" data-cnx-dir="-1" aria-label={en ? 'Previous integrations' : 'Integraciones anteriores'} disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="11 6 5 12 11 18"/></svg>
            </button>
            <button type="button" class="cnx-arrow" data-cnx-dir="1" aria-label={en ? 'Next integrations' : 'Siguientes integraciones'}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
            </button>
        </div>
    </div>

    <ul class="cnx-track" data-cnx-track>
        {INTEGRATION_PAGES.map((p) => (
            <li class="cnx-slide reveal">
                <IntegrationCard page={p} href={l(`/integraciones/${p.slug}`)} en={en} />
            </li>
        ))}
    </ul>
</section>

<script>
    document.querySelectorAll<HTMLElement>('.cnx').forEach((section) => {
        const track = section.querySelector<HTMLElement>('[data-cnx-track]');
        const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-cnx-dir]'));
        if (!track) return;
        const step = () => {
            const slide = track.querySelector<HTMLElement>('.cnx-slide');
            const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
            return slide ? slide.offsetWidth + gap : track.clientWidth * 0.8;
        };
        const sync = () => {
            const max = track.scrollWidth - track.clientWidth - 2;
            buttons.forEach((b) => {
                b.disabled = Number(b.dataset.cnxDir) < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
            });
        };
        buttons.forEach((b) => b.addEventListener('click', () => {
            track.scrollBy({ left: Number(b.dataset.cnxDir) * step(), behavior: 'smooth' });
        }));
        track.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        sync();
    });
</script>

<style>
    .cnx { --cnx-pad: max(5%, calc((100% - 1180px) / 2)); padding: 8rem 0 7.5rem; background: var(--color-bg-soft); overflow: hidden; }
    .cnx-inner { max-width: 1180px; margin: 0 auto; padding: 0 5%; box-sizing: content-box; }
    .cnx-eyebrow { font-size: 0.65rem; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: var(--color-blue-deep); opacity: 0.6; margin: 0 0 1.2rem; }
    .cnx-head-row { display: grid; grid-template-columns: 1.25fr 1fr; gap: 3.5rem; align-items: start; }
    .cnx-title { font-size: clamp(2.1rem, 3.4vw, 3.6rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.035em; color: #0a192f; margin: 0; text-wrap: balance; }
    .cnx-aside { display: flex; flex-direction: column; gap: 1.4rem; align-items: flex-start; padding-top: 0.4rem; }
    .cnx-sub { font-size: 1.02rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }
    .cnx-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.4rem; }
    .cnx-cta { display: inline-flex; align-items: center; gap: 6px; font-size: 0.95rem; font-weight: 600; color: var(--color-blue-deep); text-decoration: none; min-height: 44px; }
    .cnx-cta svg { width: 15px; height: 15px; transition: transform 0.35s var(--ease-spring); }
    .cnx-cta:hover svg { transform: translateX(3px); }
    .cnx-cta-primary { background: var(--color-blue-deep); color: #fff; padding: 0 22px; border-radius: 999px; transition: transform 0.4s var(--ease-spring), box-shadow 0.4s var(--ease-spring); box-shadow: 0 14px 30px -14px rgba(10,25,47,0.5); }
    .cnx-cta-primary:hover { transform: translateY(-2px); }
    .cnx-cta-primary:active { transform: scale(0.98); }
    .cnx-cta:focus-visible, .cnx-arrow:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 3px; }

    .cnx-nav { display: flex; justify-content: flex-end; gap: 0.6rem; margin: 3rem 0 1.4rem; }
    .cnx-arrow {
        width: 48px; height: 48px; border-radius: 14px; border: 1px solid rgba(10,25,47,0.1); background: #fff; color: var(--color-blue-deep);
        display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
        transition: background 0.25s ease, border-color 0.25s ease, transform 0.35s var(--ease-spring), opacity 0.25s ease;
    }
    .cnx-arrow svg { width: 18px; height: 18px; }
    .cnx-arrow:hover:not(:disabled) { background: #f0f2f7; border-color: rgba(10,25,47,0.16); }
    .cnx-arrow:active:not(:disabled) { transform: scale(0.95); }
    .cnx-arrow:disabled { opacity: 0.4; cursor: default; }

    .cnx-track {
        list-style: none; margin: 0; padding: 0.5rem var(--cnx-pad) 1.5rem; display: flex; gap: 1.1rem;
        overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--cnx-pad); scrollbar-width: none; overscroll-behavior-x: contain;
    }
    .cnx-track::-webkit-scrollbar { display: none; }
    .cnx-slide { flex: 0 0 clamp(250px, 23vw, 282px); scroll-snap-align: start; }

    @media (max-width: 880px) {
        .cnx { padding: 5rem 0 4.5rem; }
        .cnx-head-row { grid-template-columns: 1fr; gap: 1.4rem; }
        .cnx-aside { padding-top: 0; }
        .cnx-nav { margin: 2.2rem 0 1rem; }
        .cnx-slide { flex-basis: min(72vw, 270px); }
    }
</style>
