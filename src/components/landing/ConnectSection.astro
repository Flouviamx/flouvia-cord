---
import { getLangFromUrl, publicPath, useTranslations } from '../../i18n/utils';
import { INTEGRATION_PAGES } from '../../lib/integraciones-landing';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (p: string) => publicPath(p, lang);
const en = lang === 'en';
---

<section class="cnx" id="integraciones">
    <div class="cnx-inner">
        <p class="cnx-eyebrow reveal">{t("cnx.eyebrow")}</p>
        <div class="cnx-head-row">
            <h2 class="cnx-title reveal">{t("cnx.title")}</h2>
            <div class="cnx-aside">
                <p class="cnx-sub reveal">{t("cnx.sub")}</p>
                <div class="cnx-ctas reveal">
                    <a href={l("/producto/workflows")} class="cnx-cta">
                        {t("cnx.cta.wf")}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                    <a href={l("/integraciones")} class="cnx-cta">
                        {t("cnx.cta.all")}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                </div>
            </div>
        </div>

        <ul class="cnx-grid">
            {INTEGRATION_PAGES.map((p) => (
                <li class="reveal">
                    <a href={l(`/integraciones/${p.slug}`)} class="cnx-card">
                        <span class="cnx-logo"><img src={p.logo} alt="" width="30" height="30" loading="lazy" /></span>
                        <span class="cnx-card-tx">
                            <b>{p.nombre}</b>
                            <i>{(en ? p.en : p.es).resumen}</i>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .cnx { padding: 8rem 5% 7.5rem; background: var(--color-bg); }
    .cnx-inner { max-width: 1180px; margin: 0 auto; }
    .cnx-eyebrow { font-size: 0.65rem; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: var(--color-blue-deep); opacity: 0.6; margin: 0 0 1.2rem; }
    .cnx-head-row { display: grid; grid-template-columns: 1.25fr 1fr; gap: 3.5rem; align-items: start; margin-bottom: 3.5rem; }
    .cnx-title { font-size: clamp(2.1rem, 3.4vw, 3.6rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.035em; color: #0a192f; margin: 0; text-wrap: balance; }
    .cnx-aside { display: flex; flex-direction: column; gap: 1.4rem; align-items: flex-start; padding-top: 0.4rem; }
    .cnx-sub { font-size: 1.02rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }
    .cnx-ctas { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; }
    .cnx-cta { display: inline-flex; align-items: center; gap: 8px; font-size: 0.96rem; font-weight: 600; color: var(--color-blue-deep); text-decoration: none; min-height: 44px; }
    .cnx-cta svg { width: 16px; height: 16px; transition: transform 0.35s var(--ease-spring); }
    .cnx-cta:hover svg { transform: translateX(4px); }
    .cnx-cta:focus-visible, .cnx-card:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 3px; }

    .cnx-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.9rem; }
    .cnx-card {
        display: flex; flex-direction: column; gap: 1.1rem; height: 100%; padding: 1.4rem 1.3rem 1.3rem; border-radius: 26px;
        background: #f5f5f7; text-decoration: none;
        transition: background 0.3s ease, transform 0.45s var(--ease-spring), box-shadow 0.45s var(--ease-spring);
    }
    .cnx-card:hover { background: #fff; transform: translateY(-3px); box-shadow: 0 1px 2px rgba(10,25,47,0.04), 0 18px 40px -20px rgba(10,25,47,0.25); }
    .cnx-card:active { transform: scale(0.99); }
    .cnx-logo { width: 50px; height: 50px; border-radius: 15px; background: #fff; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1px rgba(10,25,47,0.05); }
    .cnx-logo img { width: 30px; height: 30px; border-radius: 8px; object-fit: contain; }
    .cnx-card-tx b { display: block; font-size: 1rem; color: #0f172a; letter-spacing: -0.02em; margin-bottom: 4px; }
    .cnx-card-tx i { display: block; font-style: normal; font-size: 0.84rem; line-height: 1.45; color: var(--color-text-muted); }

    @media (max-width: 1024px) {
        .cnx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 880px) {
        .cnx { padding: 5rem 5% 4.5rem; }
        .cnx-head-row { grid-template-columns: 1fr; gap: 1.4rem; margin-bottom: 2.2rem; }
        .cnx-aside { padding-top: 0; }
    }
    @media (max-width: 520px) {
        .cnx-grid { gap: 0.6rem; }
        .cnx-card { padding: 1.1rem 1rem; gap: 0.8rem; border-radius: 22px; }
        .cnx-logo { width: 44px; height: 44px; border-radius: 13px; }
        .cnx-logo img { width: 26px; height: 26px; }
        .cnx-card-tx b { font-size: 0.94rem; }
        .cnx-card-tx i { font-size: 0.78rem; }
    }
</style>
