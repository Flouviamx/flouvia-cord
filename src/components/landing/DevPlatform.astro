---
// DevPlatform — sección oscura "para desarrolladores" (home y /elements), en la
// línea de la de stripe.com pero con datos de Cord:
//   1. Plataforma abierta + CTAs a la documentación y al SDK.
//   2. Diagrama vivo: tus sistemas -> API/webhooks -> Cord -> MCP, integraciones
//      y rieles de cobro, con pulsos que viajan por las líneas y casillas que
//      cambian solas.
//   3. Cinta de líneas (canvas) con tres cifras verificadas en código
//      (apikey.ts: 600/min; domain-events.ts: 41 eventos; mcp.ts: 26 tools).
//   4. Tres rutas de integración (sin código, plataformas, código propio), cada
//      una con su visual animado y su página.
// Las integraciones del diagrama son solo las que el catálogo marca
// `disponible: true` sin depender de credenciales (catalogo.ts).
import { getLangFromUrl, publicPath } from '../../i18n/utils';


const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const tx = (es: string, en: string) => (isEn ? en : es);
const l = (p: string) => publicPath(p, lang);
const fav = (d: string) => `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${d}&size=128`;

const docsUrl = isEn ? 'https://docs.cordhq.app/en/docs' : 'https://docs.cordhq.app';

// Casillas de la barra superior: cada una rota entre sus etiquetas; '' = vacía.
const SLOTS = [
    ['ERP', '', tx('Inventario', 'Inventory')],
    ['', 'CRM', tx('Tu backend', 'Your backend')],
    [tx('Tienda en línea', 'Online store'), ''],
    [tx('Contabilidad', 'Accounting'), 'Backoffice', ''],
    ['', tx('Sistema propio', 'In-house system'), 'CRM'],
];
const APPS = [
    { n: 'HubSpot', src: fav('hubspot.com') },
    { n: 'Slack', src: '/imgs/integrations/slack.png' },
    { n: 'Microsoft Teams', src: fav('teams.microsoft.com') },
    { n: 'WhatsApp', src: '/imgs/integrations/whatsapp.svg' },
    { n: 'Make', src: fav('make.com') },
    { n: 'n8n', src: '/imgs/integrations/n8n.svg' },
];
const AGENTS = [
    { n: 'Claude', src: fav('claude.ai') },
    { n: 'Cursor', src: fav('cursor.com') },
];
const RAILS = [tx('Tarjeta', 'Card'), 'SPEI', 'Mercado Pago'];

// Geometría del diagrama en un lienzo de 1000 x 560 (las cajas se colocan en %).
const P = (x: number, y: number) => `left:${x / 10}%;top:${(y / 560) * 100}%`;
const PATHS = [
    { id: 'a', d: 'M355 92 V158', dur: 2.2, delay: 0 },
    { id: 'b', d: 'M645 92 V158', dur: 2.2, delay: 1.1 },
    { id: 'c', d: 'M355 192 V214 H468 V240', dur: 2.4, delay: 0.4 },
    { id: 'd', d: 'M645 192 V214 H532 V240', dur: 2.4, delay: 1.6 },
    { id: 'e', d: 'M217 290 H235', dur: 1.2, delay: 0.2 },
    { id: 'f', d: 'M365 290 H450', dur: 2, delay: 0.9 },
    { id: 'g', d: 'M550 290 H665', dur: 2, delay: 0.3 },
    { id: 'h', d: 'M755 290 H867', dur: 2.2, delay: 1.3 },
    { id: 'i', d: 'M500 340 V392', dur: 1.6, delay: 0.6 },
    { id: 'j', d: 'M500 428 V452 H360 V484', dur: 2.2, delay: 1 },
    { id: 'k', d: 'M500 428 V484', dur: 1.8, delay: 1.7 },
    { id: 'l', d: 'M500 428 V452 H650 V484', dur: 2.2, delay: 0.1 },
];

const STATS = [
    { v: '600', u: '/min', l: tx('peticiones por minuto por llave secreta', 'requests per minute per secret key') },
    { v: '41', u: '', l: tx('tipos de evento de webhook, firmados con HMAC-SHA256', 'webhook event types, signed with HMAC-SHA256') },
    { v: '26', u: '', l: tx('herramientas MCP para Claude, Cursor y cualquier agente', 'MCP tools for Claude, Cursor and any agent') },
];

// Logos de la tarjeta 2: integraciones disponibles sin credenciales extra y
// plataformas donde Elements se monta con su script.
const LOGO_ROWS = [
    [['HubSpot', fav('hubspot.com')], ['WordPress', fav('wordpress.org')], ['Slack', '/imgs/integrations/slack.png'], ['Webflow', fav('webflow.com')], ['Make', fav('make.com')]],
    [['Microsoft Teams', fav('teams.microsoft.com')], ['Framer', fav('framer.com')], ['WhatsApp', '/imgs/integrations/whatsapp.svg'], ['Shopify', '/imgs/integrations/shopify.svg'], ['n8n', '/imgs/integrations/n8n.svg']],
    [['React', fav('react.dev')], ['Vue', fav('vuejs.org')], ['Next.js', fav('nextjs.org')], ['Astro', fav('astro.build')], ['Claude', fav('claude.ai')]],
];
const ROUTES = [
    {
        t: tx('¿No programas?', 'Not a developer?'),
        d: tx('Crea la cotización en la app y comparte su link por WhatsApp o correo: tu cliente la revisa, la aprueba y la paga sin que escribas una línea de código.', 'Create the quote in the app and share its link by WhatsApp or email: your client reviews, approves and pays it without you writing a line of code.'),
        href: l('/producto/link-publico'), cta: tx('Explora el link público', 'Explore the public link'),
    },
    {
        t: tx('Usa lo que ya tienes', 'Use what you already have'),
        d: tx('HubSpot, Slack, Teams, WhatsApp, Make y n8n se conectan desde Ajustes, y Elements se monta en WordPress, Webflow, Framer o Shopify.', 'HubSpot, Slack, Teams, WhatsApp, Make and n8n connect from Settings, and Elements mounts on WordPress, Webflow, Framer or Shopify.'),
        href: l('/integraciones'), cta: tx('Consulta las integraciones', 'Browse the integrations'),
    },
    {
        t: tx('Crea tu propia integración', 'Build your own integration'),
        d: tx('Usa la API REST, el SDK, el servidor MCP y el Workbench para construir, probar y depurar tu integración con Cord.', 'Use the REST API, the SDK, the MCP server and the Workbench to build, test and debug your Cord integration.'),
        href: l('/desarrolladores/api'), cta: tx('Primeros pasos', 'Get started'),
    },
];
import { iconInner } from '../../lib/icons';
---

<section class="dps" aria-labelledby="dps-t1">
    <div class="dps-frame">
        <!-- 1 · Plataforma -->
        <div class="dps-block">
            <div class="dps-head">
                <h2 id="dps-t1" class="dps-title masked-title">{tx('Una plataforma abierta para cada stack.', 'An open platform for every stack.')}</h2>
                <div class="dps-aside">
                    <p class="dps-sub reveal">{tx('API REST, SDK, webhooks y MCP sobre los mismos datos que tu equipo usa en la app, con llaves de prueba aisladas de tu cuenta real.', 'REST API, SDK, webhooks and MCP on the same data your team uses in the app, with test keys isolated from your live account.')}</p>
                    <div class="dps-ctas reveal">
                        <a class="dps-btn dps-btn-primary" href={docsUrl}><span>{tx('Ver la documentación', 'Read the docs')}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                        <a class="dps-btn" href="https://www.npmjs.com/package/@flouviahq/elements" target="_blank" rel="noopener"><span>{tx('Ver el SDK en npm', 'See the SDK on npm')}</span></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2 · Diagrama -->
        <div class="dps-block">
            <div class="dps-head">
                <h2 class="dps-title masked-title">{tx('Conecta con lo que ya usas.', 'Connect what you already use.')}</h2>
                <p class="dps-sub reveal">{tx('Tu ERP, tu CRM o tu tienda hablan con Cord por la API y webhooks firmados; HubSpot, Slack, Teams, WhatsApp, Make y n8n se conectan sin código, y tus agentes de IA entran por MCP.', 'Your ERP, CRM or store talk to Cord through the API and signed webhooks; HubSpot, Slack, Teams, WhatsApp, Make and n8n connect with no code, and your AI agents come in through MCP.')}</p>
            </div>
            <div class="dps-scroll">
                <div class="dps-dia" data-dps-dia aria-hidden="true">
                    <svg class="dps-lines" viewBox="0 0 1000 560">
                        <defs>
                            <radialGradient id="dpsPulse"><stop offset="0" stop-color="#fde68a"/><stop offset="0.45" stop-color="#f59e0b" stop-opacity="0.9"/><stop offset="1" stop-color="#f59e0b" stop-opacity="0"/></radialGradient>
                        </defs>
                        {PATHS.map((p) => <path id={`dps-p-${p.id}`} d={p.d} class="dps-path" />)}
                        {PATHS.map((p) => (
                            <circle r="4" fill="url(#dpsPulse)" class="dps-pulse">
                                <animateMotion dur={`${p.dur}s`} begin={`${p.delay}s`} repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
                                    <mpath href={`#dps-p-${p.id}`} />
                                </animateMotion>
                            </circle>
                        ))}
                    </svg>

                    <div class="dps-bar" style={P(500, 66)}>
                        {SLOTS.map((labels) => (
                            <span class:list={['dps-slot', { empty: !labels[0] }]} data-slot={JSON.stringify(labels)} data-i="0">{labels[0]}</span>
                        ))}
                    </div>

                    <span class="dps-node" style={P(355, 175) + ";width:12cqw"}>{tx('API y SDK', 'API & SDK')}</span>
                    <span class="dps-node" style={P(645, 175) + ";width:12cqw"}>{tx('Webhooks', 'Webhooks')}</span>
                    <span class="dps-node" style={P(300, 290) + ";width:13cqw"}>{tx('Integraciones', 'Integrations')}</span>
                    <span class="dps-node" style={P(710, 290) + ";width:9cqw"}>MCP</span>
                    <span class="dps-node" style={P(500, 410) + ";width:10cqw"}>{tx('Cobros', 'Payments')}</span>

                    <span class="dps-core" style={P(500, 290)}><img src="/imgs/logo-cord-white.png" alt="" width="72" height="16" /></span>

                    <div class="dps-apps" style={P(135, 290)}>
                        {APPS.map((a) => <span class="dps-app" data-app><img src={a.src} alt="" width="22" height="22" loading="lazy" /></span>)}
                    </div>

                    <span class="dps-agent" style={P(890, 290)} data-agent>
                        {AGENTS.map((a, i) => <img src={a.src} alt="" width="26" height="26" loading="lazy" class:list={{ on: i === 0 }} />)}
                    </span>

                    {RAILS.map((r, i) => <span class="dps-rail" style={P([360, 500, 650][i], 502)}>{r}</span>)}
                </div>
            </div>
        </div>

        <!-- 3 · Cinta + cifras -->
        <div class="dps-block dps-wave-block">
            <div class="dps-head">
                <h2 class="dps-title masked-title">{tx('Crece sin cambiar de integración.', 'Grow without rewriting your integration.')}</h2>
                <p class="dps-sub reveal">{tx('El mismo contrato en test y en live, llaves con su propio límite y eventos que se reintentan durante casi cuatro días si tu servidor se cae.', 'The same contract in test and live, keys with their own limits and events retried for almost four days if your server goes down.')}</p>
            </div>
            <canvas class="dps-wave" data-dps-wave aria-hidden="true"></canvas>
            <div class="dps-stats">
                {STATS.map((s) => (
                    <div class="dps-stat reveal"><strong class="editorial">{s.v}<span>{s.u}</span></strong><p>{s.l}</p></div>
                ))}
            </div>
        </div>

        <!-- 4 · Rutas -->
        <div class="dps-block">
            <div class="dps-head">
                <h2 class="dps-title masked-title">{tx('Elige cómo integrarte.', 'Choose how to integrate.')}</h2>
                <p class="dps-sub reveal">{tx('Con documentación, llaves de prueba y un Workbench para depurar cada petición, empiezas por la ruta que mejor le quede a tu negocio.', 'With docs, test keys and a Workbench to debug every request, you start with the route that fits your business best.')}</p>
            </div>
            <div class="dps-routes">
                <!-- Sin código: el link viaja por chat y abre la cotización -->
                <article class="dps-route reveal">
                    <div class="dps-vis dps-vis-chat" data-dps-chat aria-hidden="true">
                        <div class="dps-chat">
                            <p class="dps-msg in" data-m>{tx('Hola, ¿me mandas la cotización del cemento y la varilla?', 'Hi, can you send me the quote for the cement and rebar?')}</p>
                            <p class="dps-msg out" data-m>{tx('Claro. Desde el link la apruebas y la pagas.', 'Sure. You can approve and pay it from the link.')}</p>
                            <p class="dps-msg out link" data-m>cordhq.app/q/k7Qp…</p>
                        </div>
                        <div class="dps-qcard" data-m>
                            <span class="dps-q-org"><i>MD</i>Materiales del Valle</span>
                            <small>COT-0052</small>
                            <strong>MXN 138,944.80</strong>
                            <span class="dps-q-btn">{tx('Aprobar y pagar', 'Approve and pay')}</span>
                        </div>
                    </div>
                    <h3 class="dps-route-h">{ROUTES[0].t}</h3>
                    <p class="dps-route-t">{ROUTES[0].d}</p>
                    <a class="dps-route-cta" href={ROUTES[0].href}>{ROUTES[0].cta}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                </article>

                <!-- Plataformas: filas de logos que se deslizan -->
                <article class="dps-route reveal">
                    <div class="dps-vis dps-vis-logos" aria-hidden="true">
                        {LOGO_ROWS.map((row, r) => (
                            <div class:list={['dps-lrow', { rev: r === 1 }]} style={`--d:${26 + r * 6}s`}>
                                {[...row, ...row].map(([n, src]) => <span class="dps-logo" title={n}><img src={src} alt="" width="34" height="34" loading="lazy" /></span>)}
                            </div>
                        ))}
                    </div>
                    <h3 class="dps-route-h">{ROUTES[1].t}</h3>
                    <p class="dps-route-t">{ROUTES[1].d}</p>
                    <a class="dps-route-cta" href={ROUTES[1].href}>{ROUTES[1].cta}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                </article>

                <!-- Código propio: editor con autocompletado y terminal -->
                <article class="dps-route reveal">
                    <div class="dps-vis dps-vis-code" data-dps-code aria-hidden="true">
                        <div class="dps-ed">
                            <div><i>1</i><span><em class="k">import</em> {'{'} Cord {'}'} <em class="k">from</em> <em class="s">'@flouviahq/node'</em>;</span></div>
                            <div><i>2</i><span><em class="k">const</em> cord = <em class="k">new</em> <em class="f">Cord</em>(</span></div>
                            <div><i>3</i><span>  <em class="s">'sk_test_4f9c…'</em></span></div>
                            <div><i>4</i><span>);</span></div>
                            <div><i>5</i><span><em class="k">await</em> cord.<b data-typed></b><u class="caret"></u></span></div>
                            <div><i>6</i><span></span></div>
                            <ul class="dps-ac" data-ac>
                                <li>clients</li><li>invoices</li><li class="on">quotes</li><li>webhookEndpoints</li>
                            </ul>
                        </div>
                        <div class="dps-status"><span>NORMAL</span><em>server.js</em><small>100% · ln 5</small></div>
                        <div class="dps-term">
                            <p>$ node server.js</p>
                            <p data-term>&gt; {tx('Esperando peticiones…', 'Waiting for requests…')}</p>
                        </div>
                    </div>
                    <h3 class="dps-route-h">{ROUTES[2].t}</h3>
                    <p class="dps-route-t">{ROUTES[2].d}</p>
                    <a class="dps-route-cta" href={ROUTES[2].href}>{ROUTES[2].cta}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('arrow-right')}></svg></a>
                </article>
            </div>
        </div>
    </div>
</section>

<script>
    // Casillas que cambian, integraciones que entran y salen, y la cinta de
    // líneas en canvas. Todo se pausa fuera de pantalla; con reduced-motion
    // queda un cuadro fijo (los pulsos SVG se ocultan por CSS).
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initDiagram() {
        const dia = document.querySelector<HTMLElement>('[data-dps-dia]');
        if (!dia) return;
        // En móvil el diagrama se recorre de lado: arranca centrado en Cord.
        const sc = dia.parentElement;
        if (sc && sc.scrollWidth > sc.clientWidth) sc.scrollLeft = (sc.scrollWidth - sc.clientWidth) / 2;
        if (reduced) return;
        let visible = false;
        new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.1 }).observe(dia);

        const slots = Array.from(dia.querySelectorAll<HTMLElement>('[data-slot]'));
        const apps = Array.from(dia.querySelectorAll<HTMLElement>('[data-app]'));
        const agentImgs = Array.from(dia.querySelectorAll<HTMLImageElement>('[data-agent] img'));
        let tick = 0;

        const swapSlot = (el: HTMLElement) => {
            const labels: string[] = JSON.parse(el.dataset.slot || '[]');
            const next = (Number(el.dataset.i || 0) + 1) % labels.length;
            el.dataset.i = String(next);
            el.classList.add('swap');
            setTimeout(() => {
                el.textContent = labels[next];
                el.classList.toggle('empty', !labels[next]);
                el.classList.remove('swap');
            }, 260);
        };

        setInterval(() => {
            if (!visible || document.hidden) return;
            tick++;
            swapSlot(slots[(tick * 3) % slots.length]);
            if (tick % 2 === 0) {
                const a = apps[(tick * 5) % apps.length];
                a.classList.add('off');
                setTimeout(() => a.classList.remove('off'), 1500);
            }
            if (tick % 3 === 0 && agentImgs.length > 1) {
                const cur = agentImgs.findIndex((x) => x.classList.contains('on'));
                agentImgs.forEach((x, j) => x.classList.toggle('on', j === (cur + 1) % agentImgs.length));
            }
        }, 1400);
    }

    // Cinta 3D: N hilos sobre una superficie que se tuerce a lo largo del
    // ancho, con perspectiva oblicua para que en la torsión los hilos se crucen
    // en diagonal en vez de colapsar en un punto. Tres capas por cuadro:
    //   1. Resplandor: la cinta a 1/4 de resolución, desenfocada y sumada.
    //   2. Hilos: un trazo por hilo; el brillo por orientación se hornea en un
    //      degradado por cuadro (es igual para todos los hilos en cada x).
    //   3. Bordes: los hilos de las orillas, más brillantes, como el filo de
    //      una cinta de seda al doblarse.
    // En móvil el diagrama se recorre de lado: arranca centrado en Cord, no recortado a la izquierda.
    function initDiaScroll() {
        const box = document.querySelector<HTMLElement>('.dps-scroll');
        if (!box || box.scrollWidth <= box.clientWidth) return;
        box.scrollLeft = (box.scrollWidth - box.clientWidth) / 2;
    }

    function initWave() {
        const cv = document.querySelector<HTMLCanvasElement>('[data-dps-wave]');
        if (!cv) return;
        const ctx = cv.getContext('2d');
        if (!ctx) return;
        const off = document.createElement('canvas');
        const octx = off.getContext('2d');
        // Safari viejo ignora ctx.filter: sin él, el resplandor se omite.
        ctx.filter = 'blur(2px)';
        const canBlur = ctx.filter === 'blur(2px)';
        ctx.filter = 'none';
        let w = 0, h = 0, visible = false, raf = 0;
        // La cinta mide lo mismo en hilos por píxel en cualquier alto: con 120 hilos
        // fijos, en un celular quedaban a menos de 1 px y se volvían una mancha.
        let N = 120, thread = 1, glow = 22;
        const PAL: [number, number, number, number][] = [
            [0, 245, 158, 11], [0.28, 251, 146, 60], [0.48, 236, 107, 166], [0.66, 139, 124, 246], [0.84, 47, 109, 240], [1, 56, 189, 248],
        ];

        const resize = () => {
            w = cv.clientWidth; h = cv.clientHeight;
            const dpr = Math.min(window.devicePixelRatio || 1, w < 760 ? 3 : 2);
            N = Math.round(Math.min(120, Math.max(56, h * 0.29)));
            thread = h < 360 ? 0.7 : 1;
            glow = Math.round(Math.min(22, Math.max(12, h * 0.052)));
            cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            off.width = Math.max(1, Math.round(w / 4)); off.height = Math.max(1, Math.round(h / 4));
            octx?.setTransform(0.25, 0, 0, 0.25, 0, 0);
        };
        const smooth = (e0: number, e1: number, x: number) => { const k = Math.min(1, Math.max(0, (x - e0) / (e1 - e0))); return k * k * (3 - 2 * k); };
        const color = (p: number) => {
            let i = 0;
            while (i < PAL.length - 2 && p > PAL[i + 1][0]) i++;
            const [p0, r0, g0, b0] = PAL[i]; const [p1, r1, g1, b1] = PAL[i + 1];
            const k = Math.min(1, Math.max(0, (p - p0) / (p1 - p0)));
            return [r0 + (r1 - r0) * k, g0 + (g1 - g0) * k, b0 + (b1 - b0) * k].map(Math.round);
        };
        const X0 = () => -0.14 * w;
        const XW = () => 1.28 * w;
        const theta = (p: number, t: number) => p * Math.PI * 1.45 - 0.55 + t * 0.00016;

        const point = (p: number, v: number, t: number) => {
            const x = X0() + p * XW();
            const spine = h * 0.54
                + h * 0.14 * Math.sin(p * Math.PI * 1.2 + t * 0.0002)
                + h * 0.05 * Math.sin(p * Math.PI * 3 - t * 0.00028)
                - h * 0.1 * p;
            const width = h * (0.22 + 0.3 * smooth(0, 1, p));
            const th = theta(p, t);
            const z = v * width * Math.sin(th);
            const persp = 1 + z / (h * 2.2);
            // Ondulación de seda: cada hilo se desfasa un poco del vecino.
            const silk = h * 0.008 * Math.sin(p * Math.PI * 7 + v * 9 - t * 0.0011);
            return { x: x + z * 0.55, y: spine + v * width * Math.cos(th) * persp + z * 0.12 + silk };
        };

        const gradient = (c: CanvasRenderingContext2D, t: number, gain: number) => {
            const g = c.createLinearGradient(X0(), 0, X0() + XW(), 0);
            for (let k = 0; k <= 24; k++) {
                const p = k / 24;
                const [r, gg, b] = color(p);
                const a = smooth(0, 0.2, p) * (0.3 + 0.7 * Math.abs(Math.cos(theta(p, t)))) * gain;
                g.addColorStop(p, `rgba(${r},${gg},${b},${Math.min(1, a).toFixed(3)})`);
            }
            return g;
        };

        const strand = (c: CanvasRenderingContext2D, v: number, t: number, steps: number) => {
            c.beginPath();
            for (let s = 0; s <= steps; s++) {
                const q = point(s / steps, v, t);
                if (s === 0) c.moveTo(q.x, q.y); else c.lineTo(q.x, q.y);
            }
            c.stroke();
        };

        const draw = (t: number) => {
            ctx.clearRect(0, 0, w, h);
            const steps = Math.max(80, Math.round(w / 8));

            // 1 · Resplandor
            if (canBlur && octx) {
                octx.clearRect(0, 0, w, h);
                octx.strokeStyle = gradient(octx, t, 1);
                octx.lineWidth = 14;
                for (let i = 0; i < 9; i++) strand(octx, i / 8 - 0.5, t, 60);
                ctx.save();
                ctx.globalCompositeOperation = 'lighter';
                ctx.filter = `blur(${glow}px)`;
                ctx.globalAlpha = 0.5;
                ctx.drawImage(off, 0, 0, w, h);
                ctx.restore();
            }

            // 2 · Hilos
            ctx.globalCompositeOperation = 'lighter';
            ctx.strokeStyle = gradient(ctx, t, 0.5);
            ctx.lineWidth = thread;
            for (let i = 0; i < N; i++) {
                const v = i / (N - 1) - 0.5;
                ctx.globalAlpha = 0.6 + 0.4 * (1 - Math.abs(v) * 2) ** 1.5;
                strand(ctx, v, t, steps);
            }

            // 3 · Bordes
            ctx.strokeStyle = gradient(ctx, t, 0.75);
            ctx.lineWidth = thread * 1.2;
            ctx.globalAlpha = 0.8;
            strand(ctx, -0.495, t, steps);
            strand(ctx, 0.495, t, steps);

            ctx.globalAlpha = 1;
            ctx.globalCompositeOperation = 'source-over';
        };

        const loop = (t: number) => { draw(t); raf = visible && !document.hidden ? requestAnimationFrame(loop) : 0; };
        resize();
        draw(4000);
        window.addEventListener('resize', () => { resize(); draw(performance.now()); });
        if (reduced) return;
        new IntersectionObserver(([e]) => {
            visible = e.isIntersecting;
            if (visible && !raf) raf = requestAnimationFrame(loop);
        }, { threshold: 0.05 }).observe(cv);
        document.addEventListener('visibilitychange', () => { if (!document.hidden && visible && !raf) raf = requestAnimationFrame(loop); });
    }

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const watch = (el: Element) => {
        const st = { on: false };
        new IntersectionObserver(([e]) => { st.on = e.isIntersecting; }, { threshold: 0.2 }).observe(el);
        return st;
    };

    // Sin código: el mensaje del cliente, la respuesta, el link y la cotización.
    function initChat() {
        const box = document.querySelector<HTMLElement>('[data-dps-chat]');
        if (!box || reduced) return;
        const parts = Array.from(box.querySelectorAll<HTMLElement>('[data-m]'));
        const vis = watch(box);
        (async () => {
            for (;;) {
                if (!vis.on || document.hidden) { await sleep(400); continue; }
                parts.forEach((p) => p.classList.add('hide'));
                await sleep(500);
                for (const p of parts) { p.classList.remove('hide'); await sleep(750); }
                await sleep(3600);
            }
        })();
    }

    // Código propio: escribe la llamada, el autocompletado elige y la terminal responde.
    function initCode() {
        const box = document.querySelector<HTMLElement>('[data-dps-code]');
        const typed = box?.querySelector<HTMLElement>('[data-typed]');
        const ac = box?.querySelector<HTMLElement>('[data-ac]');
        const term = box?.querySelector<HTMLElement>('[data-term]');
        if (!box || !typed || !ac || !term) return;
        const items = Array.from(ac.querySelectorAll<HTMLElement>('li'));
        const isEn = document.documentElement.lang === 'en';
        const waiting = isEn ? '> Waiting for requests…' : '> Esperando peticiones…';
        const done = isEn ? '> COT-0053 created · link ready' : '> COT-0053 creada · link listo';
        if (reduced) { typed.textContent = 'quotes.create({ … })'; ac.classList.add('hide'); term.textContent = done; term.classList.add('ok'); return; }
        const vis = watch(box);
        const select = (k: number) => items.forEach((li, j) => li.classList.toggle('on', j === k));
        (async () => {
            for (;;) {
                if (!vis.on || document.hidden) { await sleep(400); continue; }
                typed.textContent = ''; ac.classList.remove('hide'); select(0);
                term.textContent = waiting; term.classList.remove('ok');
                await sleep(900);
                for (const k of [1, 2]) { select(k); await sleep(420); }
                ac.classList.add('hide');
                for (const ch of 'quotes.create({ … })') { typed.textContent += ch; await sleep(55); }
                await sleep(700);
                term.textContent = done; term.classList.add('ok');
                await sleep(3200);
            }
        })();
    }

    function init() { initDiagram(); initDiaScroll(); initWave(); initChat(); initCode(); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
</script>

