---
import { getLangFromUrl, publicPath, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const isEn = lang === "en";
const t = useTranslations(lang);
const l = (p: string) => publicPath(p, lang);

// CTA final + footer — dark navy, coherente con el footer de flouvia.com.
// Las subpáginas (/producto/*, /soluciones) pueden personalizar el CTA via props.
interface Props {
    ctaTitle?: string; // admite <br />
    ctaSub?: string;
}
const {
    ctaTitle = lang === "en"
        ? "Your next client starts with a proposal."
        : "Tu próximo cliente empieza con una propuesta.",
    ctaSub = lang === "en"
        ? "Create a quote with your brand, share the link and follow the conversation through to payment. Start with 5 free sends every month."
        : "Crea una cotización con tu marca, comparte el link y sigue la conversación hasta el pago. Empieza con 5 envíos gratis cada mes.",
} = Astro.props;
import { iconInner } from '../../lib/icons';
---

<section class="final-cta">
    <div class="fc-inner reveal">
        <div class="fc-grid">
            <div class="fc-main">
                <h2 class="fc-title masked-title" set:html={ctaTitle} />
                <p class="fc-sub">{ctaSub}</p>
                <div class="fc-actions">
                    <a href={l("/registro")} class="fc-btn">
                        <span>{t("footer.cta.btn")}</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('arrow-right')}></svg>
                    </a>
                    <a href={l("/contacto/ventas")} class="fc-btn fc-btn-secondary">
                        <span>{isEn ? "Contact Sales" : "Ventas"}</span>
                    </a>
                </div>
            </div>
            
            <div class="fc-features">
                <div class="fc-feature">
                    <div class="fc-feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('tag')}></svg>
                    </div>
                    <h3 class="fc-feature-title">{isEn ? "See what you'll pay" : "Ve lo que pagarás"}</h3>
                    <p class="fc-feature-text">{isEn ? "Integrated per-transaction pricing with no hidden fees." : "Precios transparentes desde el primer día sin comisiones ocultas."}</p>
                    <a href={l("/precios")} class="fc-feature-link">{isEn ? "Pricing info" : "Información sobre precios"} <span>&rarr;</span></a>
                </div>
                
                <div class="fc-feature">
                    <div class="fc-feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('code')}></svg>
                    </div>
                    <h3 class="fc-feature-title">{isEn ? "Start building" : "Empieza a construir"}</h3>
                    <p class="fc-feature-text">{isEn ? "Start operating and sending quotes in just 10 minutes." : "Empieza a operar y enviar cotizaciones en tan solo 10 minutos."}</p>
                    <a href={l("/desarrolladores/api")} class="fc-feature-link">{isEn ? "Integration options" : "Opciones de integración"} <span>&rarr;</span></a>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="footer">
    <div class="footer-inner">
        <div class="footer-top">
            <div class="footer-brand">
                <img
                    src="/imgs/logo-cord-white.png"
                    alt="Cord"
                    class="footer-logo-img"
                />
                <p class="footer-tagline">{t("footer.tagline")}</p>
                <a
                    href="https://flouvia.com"
                    target="_blank"
                    rel="noopener"
                    class="footer-byflouvia"
                >
                    {t("footer.by")}
                    <b>Flouvia</b> →
                </a>
            </div>

            <div class="footer-cols">
                <div class="footer-col">
                    <span class="footer-col-title">{t("nav.producto")}</span>
                    <a href={l("/producto/editor")}
                        >{t("nav.mega.prod.1.title")}</a
                    >
                    <a href={l("/producto/link-publico")}
                        >{t("nav.mega.prod.2.title")}</a
                    >
                    <a href={l("/producto/seguimiento")}
                        >{t("nav.mega.prod.3.title")}</a
                    >
                    <a href={l("/producto/aprobaciones")}
                        >{t("nav.mega.prod.10.title")}</a
                    >

                    <span
                        style="height: 1px; background: rgba(255,255,255,0.1); width: 100%; margin: 0.4rem 0;"
                    ></span>
                    <span
                        style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: #5a5f6b; font-weight: 700;"
                        >{
                            isEn ? "Payments & Finance" : "Pagos y Finanzas"
                        }</span
                    >
                    <a href={l("/producto/pagos")}
                        >{t("nav.mega.prod.12.title")}</a
                    >
                    <a href={l("/producto/cobranza-ia")}
                        >{t("nav.mega.prod.6.title")}</a
                    >
                    <a href={l("/producto/divisas")}
                        >{t("nav.mega.prod.7.title")}</a
                    >
                    <a href={l("/producto/clientes-credito")}
                        >{t("nav.mega.prod.5.title")}</a
                    >
                    <a href={l("/producto/finanzas")}
                        >{t("nav.mega.prod.9.title")}</a
                    >


                    <span
                        style="height: 1px; background: rgba(255,255,255,0.1); width: 100%; margin: 0.4rem 0;"
                    ></span>
                    <span
                        style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: #5a5f6b; font-weight: 700;"
                        >{
                            isEn ? "Invoicing & Ops" : "Facturación y Operación"
                        }</span
                    >
                    <a href={l("/producto/facturacion")}
                        >{t("nav.mega.prod.8.title")}</a
                    >
                    <a href={l("/producto/workflows")}
                        >{t("nav.mega.prod.13.title")}</a
                    >
                    <a href={l("/integraciones")}
                        >{t("nav.mega.prod.14.title")}</a
                    >
                    <a href={l("/producto/equipo")}
                        >{t("nav.mega.prod.11.title")}</a
                    >
                </div>
                <div class="footer-col">
                    <span class="footer-col-title">{t("nav.soluciones")}</span>
                    <a href={l("/soluciones/empresas")}
                        >{isEn ? "Enterprise" : "Empresas"}</a
                    >
                    <a href={l("/soluciones/startups")}
                        >{isEn ? "Startups" : "Startups"}</a
                    >

                    <span
                        style="height: 1px; background: rgba(255,255,255,0.1); width: 100%; margin: 0.2rem 0;"
                    ></span>
                    <span
                        style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: #5a5f6b; font-weight: 700;"
                        >{isEn ? "By Use Case" : "Por Caso de Uso"}</span
                    >
                    <a href={l("/casos-de-uso/agencias")}
                        >{isEn ? "Agencies" : "Agencias"}</a
                    >
                    <a href={l("/casos-de-uso/saas")}
                        >{isEn ? "SaaS" : "SaaS"}</a
                    >
                    <a href={l("/casos-de-uso/comercializadoras")}
                        >{isEn ? "Wholesalers" : "Comercializadoras"}</a
                    >
                    <a href={l("/casos-de-uso/software-factory")}
                        >{isEn ? "Dev Teams" : "Dev Teams"}</a
                    >
                </div>
                <div class="footer-col">
                    <span class="footer-col-title"
                        >{t("nav.desarrolladores")}</span
                    >
                    <a href={l("/desarrolladores/api")}
                        >{t("nav.mega.dev.1.title")}</a
                    >
                    <a href={l("/desarrolladores/mcp")}
                        >{t("nav.mega.dev.2.title")}</a
                    >
                    <a href={l("/desarrolladores/workbench")}
                        >{t("nav.mega.dev.5.title")}</a
                    >

                    <span
                        style="height: 1px; background: rgba(255,255,255,0.1); width: 100%; margin: 0.2rem 0;"
                    ></span>
                    <span
                        style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: #5a5f6b; font-weight: 700;"
                        >{
                            isEn
                                ? "Tools & Platform"
                                : "Herramientas y Plataforma"
                        }</span
                    >
                    <a href={l("/elements")}>{t("nav.mega.dev.3.title")}</a>
                    <a href={l("/desarrolladores/integraciones")}
                        >{
                            isEn
                                ? "Integrations & webhooks"
                                : "Integraciones y webhooks"
                        }</a
                    >
                    <a href={lang === 'en' ? "https://status.cordhq.app/en" : "https://status.cordhq.app"}
                        >{t("nav.mega.dev.4.title")}</a
                    >
                    <a href={l("/elements")}>{t("footer.link.docs")}</a>
                    <a href={l("/registro")}>{t("footer.link.api")}</a>
                </div>
                <div class="footer-col">
                    <span class="footer-col-title">{t("nav.recursos")}</span>
                    <a href={l("/blog")}>{t("nav.mega.rec.1.title")}</a>
                    <a href="https://dev.cordhq.app" target="_blank"
                        >{
                            isEn ? "Developer Blog" : "Blog de desarrolladores"
                        }</a
                    >
                    <a href={l("/roadmap")}>{t("nav.mega.rec.4.title")}</a>
                    <a href={l("/precios")}>{t("footer.link.precios")}</a>

                    <span
                        style="height: 1px; background: rgba(255,255,255,0.1); width: 100%; margin: 0.2rem 0;"
                    ></span>
                    <span
                        style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: #5a5f6b; font-weight: 700;"
                        >{isEn ? "Help & Contact" : "Ayuda y Contacto"}</span
                    >
                    <a
                        href={isEn
                            ? "https://docs.cordhq.app/en/docs"
                            : "https://docs.cordhq.app"}
                        >{isEn ? "Documentation" : "Documentación"}</a
                    >
                    <a href={lang === "en" ? "/en/support" : "/soporte"}
                        >{t("footer.link.soporte")}</a
                    >
                    <a href={l("/q/demo")}>{t("nav.mega.rec.2.title")}</a>
                    <a href={l("/contacto/ventas")}
                        >{isEn ? "Contact Sales" : "Ventas"}</a
                    >
                </div>
                <div class="footer-col">
                    <span class="footer-col-title"
                        >{t("footer.col.empresa")}</span
                    >
                    <a href={l("/registro")}>{t("footer.link.crear")}</a>
                    <a href={l("/sign-in")}>{t("footer.link.entrar")}</a>
                    <a href="https://flouvia.com" target="_blank" rel="noopener"
                        >flouvia.com</a
                    >
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>
                &copy; <span class="editorial">2026</span>
                <span class="editorial">Cord</span> · by Flouvia.
            </p>
            <div class="footer-bottom-right">
                <div class="footer-social">
                    <a
                        href="https://instagram.com/cord.hq"
                        target="_blank"
                        rel="noopener"
                        aria-label="Instagram"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            width="18"
                            height="18"
                            fill="currentColor"
                        >
                            <path
                                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm3.98-10.181a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href="https://tiktok.com/@cord.hq"
                        target="_blank"
                        rel="noopener"
                        aria-label="TikTok"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            width="18"
                            height="18"
                            fill="currentColor"
                        >
                            <path
                                d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href="https://x.com/usecordapp"
                        target="_blank"
                        rel="noopener"
                        aria-label="X (Twitter)"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            width="18"
                            height="18"
                            fill="currentColor"
                        >
                            <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                            ></path>
                        </svg>
                    </a>
                </div>
                <div class="footer-legal">
                    <a href={l("/privacidad")}>{t("footer.legal.priv")}</a>
                    <span>·</span>
                    <a href={l("/terminos")}>{t("footer.legal.term")}</a>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
    .final-cta {
        position: relative;
        background: #050b14;
        color: #fff;
        padding: 5rem 5% 4rem;
        overflow: clip;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    @media (max-width: 900px) {
        .final-cta { padding: 4rem 5%; }
    }
    .fc-inner {
        position: relative;
        z-index: 2;
        max-width: 1120px;
        margin: 0 auto;
    }
    .fc-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }
    @media (max-width: 900px) {
        .fc-grid {
            grid-template-columns: 1fr;
            gap: 3.5rem;
        }
    }
    .fc-main {
        max-width: 500px;
        text-align: left;
    }
    .fc-title {
        font-size: clamp(1.6rem, 2.5vw, 2.2rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -1.2px;
        margin: 0 0 1.2rem;
        color: #fff;
    }
    .fc-sub {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #8892b0;
        margin: 0 0 2.2rem;
    }
    .fc-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }
    .fc-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        color: var(--color-blue-deep, #0a192f);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 14px 28px;
        border-radius: 12px;
        box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.4);
        transition:
            transform 0.5s var(--ease-spring),
            box-shadow 0.5s var(--ease-spring);
    }
    .fc-btn svg {
        width: 16px;
        height: 16px;
        transition: transform 0.5s var(--ease-spring);
    }
    .fc-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.5);
    }
    .fc-btn:hover svg {
        transform: translateX(4px);
    }
    .fc-btn-secondary {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: none;
    }
    .fc-btn-secondary:hover {
        background: rgba(255, 255, 255, 0.09);
        box-shadow: none;
        color: #fff;
    }
    .fc-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        text-align: left;
    }
    @media (max-width: 600px) {
        .fc-features {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }
    }
    .fc-feature {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        height: 100%;
        align-items: flex-start;
    }
    .fc-feature-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ededed;
        margin-bottom: 0.4rem;
    }
    .fc-feature-icon svg {
        width: 20px;
        height: 20px;
    }
    .fc-feature-title {
        font-size: 1rem;
        font-weight: 600;
        color: #ededed;
        margin: 0;
    }
    .fc-feature-text {
        font-size: 0.95rem;
        line-height: 1.5;
        color: #8a8f98;
        margin: 0 0 0.5rem;
        flex-grow: 1;
    }
    .fc-feature-link {
        font-size: 0.95rem;
        color: #fff;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: color 0.2s;
    }
    .fc-feature-link:hover {
        color: #ededed;
    }
    .fc-feature-link span {
        transition: transform 0.3s var(--ease-spring, ease);
    }
    .fc-feature-link:hover span {
        transform: translateX(3px);
    }

    /* Footer */
    .footer {
        position: relative;
        background: #050b14;
        color: #fff;
        padding: 4.5rem 5% 2.5rem;
        overflow: clip;
    }
    .footer-inner {
        position: relative;
        z-index: 2;
        max-width: 1120px;
        margin: 0 auto;
    }
    .footer-top {
        display: grid;
        grid-template-columns: 2fr 6fr;
        gap: 4rem;
        padding-bottom: 3.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .footer-logo-img {
        height: 22px;
        width: auto;
        display: block;
        opacity: 0.9;
    }
    .footer-tagline {
        font-size: 0.85rem;
        line-height: 1.6;
        color: #8a8f98;
        margin: 1.2rem 0;
        max-width: 260px;
        font-weight: 400;
    }
    .footer-byflouvia {
        font-size: 0.85rem;
        color: #8a8f98;
        text-decoration: none;
        transition: color 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .footer-byflouvia b {
        color: #fff;
        font-weight: 500;
    }
    .footer-byflouvia:hover {
        color: #ededed;
    }

    .footer-cols {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 2rem;
    }
    .footer-col {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .footer-col-title {
        font-size: 0.875rem;
        font-weight: 500;
        color: #ededed;
        margin-bottom: 0.5rem;
    }
    .footer-col a {
        font-size: 0.875rem;
        color: #8a8f98;
        text-decoration: none;
        transition: color 0.2s ease;
        width: fit-content;
        display: inline-block;
    }
    .footer-col a:hover {
        color: #ededed;
    }

    .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 2rem;
        gap: 1.5rem;
        flex-wrap: wrap;
        font-size: 0.85rem;
        color: #8a8f98;
    }
    .footer-bottom p {
        margin: 0;
    }
    .footer-bottom .editorial {
        color: #8a8f98;
    }
    .footer-bottom-right {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        flex-wrap: wrap;
    }
    .footer-social {
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }
    .footer-social a {
        color: #8a8f98;
        transition:
            color 0.2s ease,
            transform 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .footer-social a:hover {
        color: #ededed;
        transform: translateY(-2px);
    }
    .footer-legal {
        display: flex;
        gap: 1rem;
        align-items: center;
    }
    .footer-legal a {
        color: #8a8f98;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .footer-legal a:hover {
        color: #ededed;
    }

    @media (max-width: 1020px) {
        .footer-top {
            grid-template-columns: 1fr;
            gap: 2.8rem;
        }
        .footer-cols {
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem 1.5rem;
        }
    }
    @media (max-width: 620px) {
        .footer-cols {
            grid-template-columns: 1fr 1fr;
        }
        .footer-bottom {
            flex-direction: column;
            align-items: flex-start;
            gap: 2rem;
        }
        .footer-bottom-right {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
        }
    }
