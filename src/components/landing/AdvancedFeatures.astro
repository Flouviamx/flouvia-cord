---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import CordDynamicBg from '../CordDynamicBg.jsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === 'en';

// Funciones avanzadas — tabs verticales a la izquierda y un panel grande a la
// derecha con la pieza de la app calcada de cada feature:
//   1 · /app/cotizaciones/nueva — bloque "Arma la cotización con IA" + filas del editor
//   2 · /app/cobranza/agente — KPIs + borrador de la bandeja de aprobación
//   3 · FlujoReport (informes) — "Próximos 90 días" + flujo semanal apilado
//   4 · /app/cotizaciones/nueva — sidebar "Revisa y envía" con la cobertura FX
// Cada mockup vive en un marco de 28em × 35em; el panel fija 1em por su alto
// (apaisado en escritorio) y en móvil por su ancho (tarjeta 4:5 apilada).
// Formatos = los reales de cada pantalla: el editor usa 2 decimales; KPIs y
// bandeja, 0.

const PAL_AGENTE = { base: '#120E2A', color1: '#33236B', color2: '#6B48C2', color3: '#B9A2EE' };
const PAL_DIVISA = { base: '#071F1C', color1: '#0F5446', color2: '#228C6E', color3: '#9ADBBF' };

// money() de la app: es-MX '$44,200.00' · en-US 'MX$44,200.00' (divisa MXN).
const CUR = en ? 'MX$' : '$';
const n2 = (n: number) => new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const n0 = (n: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(n);

// ── 1 · Pedido pegado → partidas emparejadas con el catálogo ──
const PEDIDO = en
    ? 'Hi, I need 200 bags of gray cement, 50 3/8" rebars, and 2 m³ of sand. Can you send me a price?'
    : 'Hola, necesito 200 sacos de cemento gris, 50 varillas de 3/8 y 2 m³ de arena. ¿Me pasas precio?';
const LINEAS = [
    { nombre: 'Cemento gris 50kg', unidad: 'saco', vol: 100, cant: 200, precio: 221, costo: 181 },
    { nombre: 'Varilla 3/8" × 12m', unidad: 'pieza', vol: 0, cant: 50, precio: 189.5, costo: 162 },
    { nombre: 'Arena de río m³', unidad: 'm³', vol: 0, cant: 2, precio: 465, costo: 318 },
].map((l) => ({ ...l, importe: l.cant * l.precio, margen: Math.round(((l.precio - l.costo) / l.precio) * 100) }));

// ── 2 · Borrador del agente (plan de cuotas: suma exacta del saldo, 1ª vence hoy) ──
const SALDO = 97440;
const CUOTAS = 3;
const CUOTA = SALDO / CUOTAS;
const CORREO = en
    ? `Hi Laura, thanks for getting back to me. As we discussed, we split the COT-0139 balance into ${CUOTAS} monthly instalments of ${CUR}${n0(CUOTA)}. The first one is due today and you can pay it with the button below.\n\nAny questions, just reply.\nMateriales del Valle`
    : `Hola Laura, gracias por responder. Como lo platicamos, dejamos el saldo de COT-0139 en ${CUOTAS} cuotas mensuales de ${CUR}${n0(CUOTA)}. La primera vence hoy y puedes pagarla con el botón de abajo.\n\nQuedo al pendiente.\nMateriales del Valle`;

// ── 3 · Flujo semanal: 13 semanas desde mañana (weekLabel de queries.ts, hoy = 12 sep) ──
const WK_ES = ['13 sep – 19 sep', '20 sep – 26 sep', '27 sep – 3 oct', '4 oct – 10 oct', '11 oct – 17 oct', '18 oct – 24 oct', '25 oct – 31 oct', '1 nov – 7 nov', '8 nov – 14 nov', '15 nov – 21 nov', '22 nov – 28 nov', '29 nov – 5 dic', '6 dic – 11 dic'];
const WK_EN = ['Sep 13 – Sep 19', 'Sep 20 – Sep 26', 'Sep 27 – Oct 3', 'Oct 4 – Oct 10', 'Oct 11 – Oct 17', 'Oct 18 – Oct 24', 'Oct 25 – Oct 31', 'Nov 1 – Nov 7', 'Nov 8 – Nov 14', 'Nov 15 – Nov 21', 'Nov 22 – Nov 28', 'Nov 29 – Dec 5', 'Dec 6 – Dec 11'];
// [cartera, pipeline ponderado, igualas]: la cartera cierta pesa al principio,
// el pipeline crece a media ventana y las igualas caen al inicio de cada mes.
const SEMANAS_RAW: [number, number, number][] = [
    [96420, 18300, 0], [142860, 24150, 0], [61300, 31800, 38500], [88940, 42600, 0],
    [37200, 55900, 0], [52480, 47300, 0], [21900, 63200, 0], [18600, 39700, 38500],
    [12300, 58400, 0], [9800, 44900, 0], [0, 51600, 0], [6200, 28300, 38500], [0, 22100, 0],
];
const SEMANAS = SEMANAS_RAW.map(([c, p, r], i) => ({ label: (en ? WK_EN : WK_ES)[i], c, p, r, total: c + p + r }));
const MAX_SEM = Math.max(...SEMANAS.map((s) => s.total));
const TOTAL_90 = SEMANAS.reduce((sum, s) => sum + s.total, 0);
const pct = (v: number) => `${((v / MAX_SEM) * 100).toFixed(2)}%`;

// ── 4 · Cobertura FX: applied = spot × (1 + buffer/100) (FXService) ──
const SPOT = 18.42;
const TOTAL_USD = 10480;
const BUFS = [
    { buf: 1, label: en ? 'Slightly' : 'Poco' },
    { buf: 2, label: 'Normal' },
    { buf: 5, label: en ? 'Cautious' : 'Cauto' },
];
const APPLIED = SPOT * 1.02;

// Copy de las tabs (claves adv.step.N.*) e iconos Glass Duotone por feature.
const STEPS = [
    { h: t('adv.step.1.h'), p: t('adv.step.1.p') },
    { h: t('adv.step.2.h'), p: t('adv.step.2.p') },
    { h: t('adv.step.3.h'), p: t('adv.step.3.p') },
    { h: t('adv.step.4.h'), p: t('adv.step.4.p') },
];
const ICONS = [
    // 1 · IA: procesador
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" fill-opacity="0.15"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M6 9H4M6 15H4M18 9h2M18 15h2M9 6V4M15 6V4M9 18v2M15 18v2"/></svg>',
    // 2 · Agente: el correo que redacta
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="currentColor" fill-opacity="0.14"/><path d="m3.8 7.2 8.2 5.8 8.2-5.8"/></svg>',
    // 3 · Flujo: barras
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><rect x="5" y="12" width="3.5" height="8" rx="1" fill="currentColor" fill-opacity="0.15"/><rect x="10.25" y="6" width="3.5" height="14" rx="1" fill="currentColor" fill-opacity="0.15"/><rect x="15.5" y="9.5" width="3.5" height="10.5" rx="1" fill="currentColor" fill-opacity="0.15"/></svg>',
    // 4 · Divisas: globo
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.14"/><path d="M12 3a14 14 0 0 1 3.6 9A14 14 0 0 1 12 21a14 14 0 0 1-3.6-9A14 14 0 0 1 12 3z"/><path d="M3 12h18"/></svg>',
];
---

<section class="cav" id="avanzado">
    <div class="cav-wrap">
        <!-- ── Izquierda: cabecera + tabs verticales ── -->
        <div class="cav-left">
            <div class="cav-head">
                <h2 class="cav-title reveal" id="cav-title">{t("adv.title")}</h2>
                <p class="cav-sub reveal">{t("adv.sub")}</p>
            </div>

            <div class="cav-tabs reveal" role="tablist" aria-orientation="vertical" aria-labelledby="cav-title">
                {STEPS.map((s, i) => (
                    <button
                        type="button"
                        class:list={['cav-tab', { 'is-active': i === 0 }]}
                        role="tab"
                        id={`cav-tab-${i + 1}`}
                        aria-controls={`cav-pane-${i + 1}`}
                        aria-selected={i === 0 ? 'true' : 'false'}
                        tabindex={i === 0 ? 0 : -1}
                    >
                        <span class="cav-tab-ico" set:html={ICONS[i]} />
                        <span class="cav-tab-tx">
                            <span class="cav-tab-h">{s.h}</span>
                            <span class="cav-tab-p"><span>{s.p}</span></span>
                        </span>
                        <span class="cav-tab-bar" aria-hidden="true"><i></i></span>
                    </button>
                ))}
            </div>
        </div>

        <!-- ── Derecha: panel con un pane por tab (en móvil, lista apilada) ── -->
        <div class="cav-panel reveal">
            <!-- 1 · Armar con IA: bloque navy real + filas del editor -->
            <div class="cav-pane is-active" id="cav-pane-1" role="tabpanel" aria-labelledby="cav-tab-1" data-cav="ia">
                <div class="cav-pane-head">
                    <span class="cav-pane-ico" set:html={ICONS[0]} />
                    <div><h3>{STEPS[0].h}</h3><p>{STEPS[0].p}</p></div>
                </div>
                <div class="cav-vis cav-vis-light">
                    <div class="cav-stage" aria-hidden="true">
                        <div class="cav-frame">
                            <div class="cav-ed">
                                <div class="cav-ai">
                                    <b class="cav-ai-t">{en ? 'Build the quote with AI' : 'Arma la cotización con IA'}</b>
                                    <span class="cav-ai-s">{en
                                        ? "Paste the client's order or attach a photo/PDF of their purchase order."
                                        : 'Pega el pedido del cliente o adjunta la foto/PDF de su orden de compra.'}</span>
                                    <div class="cav-ai-ta">
                                        <span class="cav-ai-txt" data-type>{PEDIDO}</span>
                                        <span class="cav-ai-clip">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                                        </span>
                                    </div>
                                    <div class="cav-ai-chip">
                                        <span class="cav-ai-chip-in">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="currentColor" fill-opacity="0.14"/><path d="M14 2v6h6"/></svg>
                                            <span>orden-compra-4471.jpg</span>
                                            <svg class="cav-ai-chip-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        </span>
                                    </div>
                                    <div class="cav-ai-act">
                                        <span class="cav-ai-btn"><span class="cav-ai-btn-l" data-busy={en ? 'Reading document…' : 'Leyendo documento…'}>{en ? 'Build quote with AI' : 'Armar cotización con IA'}</span></span>
                                        <span class="cav-ai-status">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.16" stroke="none"/><path d="m8 12.5 2.6 2.6L16 9.6"/></svg>
                                            {en ? '3 lines built. Check quantities and prices.' : '3 líneas armadas. Revisa cantidades y precios.'}
                                        </span>
                                    </div>
                                </div>
                                <div class="cav-ln">
                                    <div class="cav-ln-head">
                                        <span class="cav-ln-num">2</span>
                                        <b>{en ? 'What are you quoting them?' : '¿Qué le vas a cotizar?'}</b>
                                    </div>
                                    <div class="cav-ln-cols">
                                        <span>{en ? 'Product' : 'Producto'}</span>
                                        <span>{en ? 'Qty.' : 'Cant.'}</span>
                                        <span class="r">{en ? 'Amount' : 'Importe'}</span>
                                        <span class="c">{en ? 'Margin' : 'Margen'}</span>
                                    </div>
                                    {LINEAS.map((l) => (
                                        <div class="cav-ln-row">
                                            <span class="cav-ln-name">
                                                <span class="cav-ln-n">{l.nombre}</span>
                                                <small>{l.unidad}{l.vol > 0 && <> · <b>{en ? `bulk pricing (${l.vol}+)` : `precio x volumen (${l.vol}+)`}</b></>}</small>
                                            </span>
                                            <span class="cav-ln-qty">{l.cant}</span>
                                            <span class="cav-ln-amt editorial">{CUR}{n2(l.importe)}</span>
                                            <span class="cav-ln-mg">{l.margen}%</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2 · Agente de cobranza: KPIs + borrador en la bandeja -->
            <div class="cav-pane" id="cav-pane-2" role="tabpanel" aria-labelledby="cav-tab-2" data-cav="agente">
                <div class="cav-pane-head">
                    <span class="cav-pane-ico" set:html={ICONS[1]} />
                    <div><h3>{STEPS[1].h}</h3><p>{STEPS[1].p}</p></div>
                </div>
                <div class="cav-vis cav-vis-dark" style={`--cav-base:${PAL_AGENTE.base}`}>
                    <div class="cav-shader"><CordDynamicBg client:only="react" colors={PAL_AGENTE} grain={false} /></div>
                    <div class="cav-stage" aria-hidden="true">
                        <div class="cav-frame">
                            <div class="cav-ag">
                                <div class="cav-ag-top">
                                    <b>{en ? 'Collections agent' : 'Agente de cobranza'}</b>
                                    <span class="cav-ag-state"><i></i>{en ? 'Needs approval' : 'Requiere aprobación'}</span>
                                </div>
                                <div class="cav-ag-kpis">
                                    <div>
                                        <span class="cav-kl">{en ? 'Recovered by the agent' : 'Recuperado por el agente'}</span>
                                        <strong class="editorial is-ok">{CUR}186,300</strong>
                                    </div>
                                    <div>
                                        <span class="cav-kl">{en ? 'Awaiting your approval' : 'Esperan tu aprobación'}</span>
                                        <strong class="editorial is-warn" data-n>4</strong>
                                    </div>
                                    <div>
                                        <span class="cav-kl">{en ? 'Active payment plans' : 'Planes de pago activos'}</span>
                                        <strong class="editorial">3</strong>
                                    </div>
                                </div>
                                <div class="cav-ag-sec">
                                    <b>{en ? 'Approval inbox' : 'Bandeja de aprobación'}</b>
                                    <span>{en
                                        ? 'Nothing goes out until you approve it. You can edit the email before sending.'
                                        : 'Nada sale hasta que lo apruebes. Puedes editar el correo antes de enviarlo.'}</span>
                                </div>
                            </div>
                            <div class="cav-dr">
                                <div class="cav-dr-head">
                                    <span class="cav-dr-av"><span>C</span></span>
                                    <span class="cav-dr-who">
                                        <strong>Constructora Apex</strong>
                                        <small><code>COT-0139</code> · {en ? '18 days overdue' : 'vencida hace 18 días'}</small>
                                    </span>
                                    <span class="cav-dr-amt editorial">{CUR}{n0(SALDO)}</span>
                                </div>
                                <div class="cav-dr-plan">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3" fill="currentColor" fill-opacity="0.12"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                                    <span>{en ? `Proposes ${CUOTAS} instalments of ${CUR}${n0(CUOTA)}` : `Propone ${CUOTAS} cuotas de ${CUR}${n0(CUOTA)}`}</span>
                                </div>
                                <div class="cav-dr-text"><p>{CORREO}</p></div>
                                <div class="cav-dr-acts">
                                    <span class="is-primary">{en ? 'Approve and send' : 'Aprobar y enviar'}</span>
                                    <span>{en ? 'Regenerate' : 'Regenerar'}</span>
                                    <span class="is-ghost">{en ? 'Discard' : 'Descartar'}</span>
                                    <span class="is-ghost">{en ? "Don't email them" : 'No escribirle'}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3 · Flujo a 90 días (FlujoReport) -->
            <div class="cav-pane" id="cav-pane-3" role="tabpanel" aria-labelledby="cav-tab-3" data-cav="flujo">
                <div class="cav-pane-head">
                    <span class="cav-pane-ico" set:html={ICONS[2]} />
                    <div><h3>{STEPS[2].h}</h3><p>{STEPS[2].p}</p></div>
                </div>
                <div class="cav-vis cav-vis-light">
                    <div class="cav-stage" aria-hidden="true">
                        <div class="cav-frame">
                            <div class="cav-fl">
                                <div class="cav-fl-kpi">
                                    <div class="cav-fl-main">
                                        <span class="cav-kl">{en ? 'Next 90 days' : 'Próximos 90 días'}</span>
                                        <strong class="editorial" data-count={TOTAL_90} data-prefix={CUR}>{CUR}{n0(TOTAL_90)}</strong>
                                        <small>{en ? 'receivables + pipeline + retainers' : 'cartera + pipeline + igualas'}</small>
                                    </div>
                                    <div class="cav-fl-conc">
                                        <span>{en ? 'Concentration risk · 30 days' : 'Riesgo de concentración · 30 días'}</span>
                                        <strong class="editorial">34%</strong>
                                        <small>Constructora Apex</small>
                                    </div>
                                </div>
                                <div class="cav-fl-chart">
                                    <div class="cav-fl-sh">
                                        <b>{en ? 'Weekly flow · 90 days' : 'Flujo semanal · 90 días'}</b>
                                        <span class="cav-fl-leg">
                                            <span class="is-cartera">{en ? 'Receivables' : 'Cartera'}</span>
                                            <span class="is-pipeline">Pipeline</span>
                                            <span class="is-mrr">MRR</span>
                                        </span>
                                    </div>
                                    <p class="cav-fl-p">{en
                                        ? 'Three separate sources to distinguish certainty from probability.'
                                        : 'Tres fuentes separadas para no confundir certeza con probabilidad.'}</p>
                                    <div class="cav-fl-weeks">
                                        {SEMANAS.map((s) => (
                                            <div class="cav-fl-w">
                                                <span class="cav-fl-wl">{s.label}</span>
                                                <span class="cav-fl-track">
                                                    <i class="is-cartera" style={`width:${pct(s.c)}`} data-w={pct(s.c)}></i>
                                                    <i class="is-pipeline" style={`width:${pct(s.p)}`} data-w={pct(s.p)}></i>
                                                    <i class="is-mrr" style={`width:${pct(s.r)}`} data-w={pct(s.r)}></i>
                                                </span>
                                                <strong class="editorial">{CUR}{n0(s.total)}</strong>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4 · Multi-divisa: "Revisa y envía" con la cobertura FX -->
            <div class="cav-pane" id="cav-pane-4" role="tabpanel" aria-labelledby="cav-tab-4" data-cav="divisa" data-spot={SPOT} data-amount={TOTAL_USD}>
                <div class="cav-pane-head">
                    <span class="cav-pane-ico" set:html={ICONS[3]} />
                    <div><h3>{STEPS[3].h}</h3><p>{STEPS[3].p}</p></div>
                </div>
                <div class="cav-vis cav-vis-dark" style={`--cav-base:${PAL_DIVISA.base}`}>
                    <div class="cav-shader"><CordDynamicBg client:only="react" colors={PAL_DIVISA} grain={false} /></div>
                    <div class="cav-stage" aria-hidden="true">
                        <div class="cav-frame">
                            <div class="cav-fx">
                                <b class="cav-fx-h">{en ? 'Review and send' : 'Revisa y envía'}</b>
                                <div class="cav-fx-total">
                                    <span>Total</span>
                                    <span class="editorial">{en ? `$${n2(TOTAL_USD)}` : `USD ${n2(TOTAL_USD)}`}</span>
                                </div>
                                <div class="cav-fx-field">
                                    <span class="cav-fx-lab">{en ? 'What currency are you quoting in?' : '¿En qué moneda le cotizas?'}</span>
                                    <span class="cav-fx-sel">
                                        <span class="cav-fx-flag"><img src="/flags/us.svg" alt="" width="20" height="20" loading="lazy" decoding="async" /></span>
                                        <span class="cav-fx-sel-l">{en ? 'USD — US Dollar' : 'USD — dólar estadounidense'}</span>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                                    </span>
                                </div>
                                <div class="cav-fx-cover">
                                    <p class="cav-fx-exp">{en
                                        ? <>You quote and charge in <b>USD</b>, but your books are in Mexican Peso. We lock today's exchange rate: the invoice declares it and your margin stays protected.</>
                                        : <>Capturas y cobras en <b>USD</b>, pero tu contabilidad va en peso mexicano. Congelamos el tipo de cambio de hoy: la factura lo declara y tu margen queda protegido.</>}</p>
                                    <div class="cav-fx-stepper">
                                        <div class="cav-fx-step">
                                            <span class="cav-fx-sl">{en ? "Today's exchange rate" : 'Tipo de cambio hoy'}</span>
                                            <span class="cav-fx-sv editorial">${n2(SPOT)}</span>
                                        </div>
                                        <span class="cav-fx-arrow">&rarr;</span>
                                        <div class="cav-fx-step is-on">
                                            <span class="cav-fx-sl">{en ? 'Your locked-in rate' : 'Tu tasa protegida'} <span data-buf-lbl>+2%</span></span>
                                            <span class="cav-fx-sv editorial" data-applied>${n2(APPLIED)}</span>
                                        </div>
                                    </div>
                                    <span class="cav-fx-lab">{en ? 'How cautious do you want to be?' : '¿Qué tan cauto quieres ser?'}</span>
                                    <div class="cav-fx-chips">
                                        {BUFS.map((b) => (
                                            <span class:list={['cav-fx-chip', { 'is-on': b.buf === 2 }]} data-buf={b.buf}><b>{b.label}</b><small>+{b.buf}%</small></span>
                                        ))}
                                    </div>
                                    <p class="cav-fx-sees">{en ? 'Your client pays' : 'Tu cliente paga'} <b>${n2(TOTAL_USD)}</b> · {en ? 'in your books ≈' : 'en tus libros ≈'} <b><span data-books>${n2(TOTAL_USD * APPLIED)}</span> MXN</b></p>
                                    <div class="cav-fx-lock">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" fill="currentColor" fill-opacity="0.14"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                        {en ? 'Rate locked for 30 days' : 'Tasa congelada 30 días'}
                                    </div>
                                </div>
                                <span class="cav-fx-send">
                                    {en ? 'Create and send' : 'Crear y enviar'}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Cada pane tiene una micro-historia con tres verbos:
    //   run()    — la reinicia desde su estado inicial y la reproduce;
    //   reset()  — deja el estado inicial (antes de que el pane sea visible);
    //   settle() — la corta y deja el estado FINAL, que es el HTML de servidor.
    // Escritorio: corre al abrir su tab (o al entrar en viewport el pane
    // inicial). Móvil: cada pane apilado corre al entrar en viewport.
    // Con reduced-motion no se anima nada, pero las tabs siguen funcionando.
    type Story = { run: () => void; reset: () => void; settle: () => void };

    const root = document.getElementById('avanzado');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const f2 = (n: number) => new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
    const f0 = (n: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(n);

    const story = (reset: () => void, build: () => gsap.core.Timeline, final: () => void): Story => {
        let tl: gsap.core.Timeline | null = null;
        return {
            reset: () => { tl?.kill(); tl = null; reset(); },
            run: () => { tl?.kill(); reset(); tl = build(); },
            settle: () => { tl?.kill(); tl = null; final(); },
        };
    };

    // 1 · se escribe el pedido, se adjunta la foto, "Leyendo documento…" y
    //     aparecen las partidas (el chip se limpia al terminar, como en la app).
    function storyIa(p: HTMLElement): Story | null {
        const txt = p.querySelector<HTMLElement>('[data-type]');
        const chip = p.querySelector<HTMLElement>('.cav-ai-chip');
        const btn = p.querySelector<HTMLElement>('.cav-ai-btn');
        const lbl = p.querySelector<HTMLElement>('.cav-ai-btn-l');
        const status = p.querySelector<HTMLElement>('.cav-ai-status');
        const rows = Array.from(p.querySelectorAll<HTMLElement>('.cav-ln-row'));
        if (!txt || !chip || !btn || !lbl || !status || !rows.length) return null;
        const full = txt.textContent || '';
        const idle = lbl.textContent || '';
        const busy = lbl.dataset.busy || idle;
        const clean = () => {
            lbl.textContent = idle;
            btn.classList.remove('is-busy');
            rows.forEach((r) => r.classList.remove('is-added'));
        };
        return story(
            () => {
                clean();
                txt.textContent = '';
                gsap.set(chip, { height: 0, opacity: 0 });
                gsap.set(status, { opacity: 0 });
                gsap.set(rows, { opacity: 0, y: 6 });
            },
            () => {
                const o = { n: 0 };
                const tl = gsap.timeline({ delay: 0.35 })
                    .to(o, { n: full.length, duration: 1.6, ease: 'none', onUpdate: () => { txt.textContent = full.slice(0, Math.round(o.n)); } })
                    .to(chip, { height: 'auto', opacity: 1, duration: 0.4, ease: 'power2.out' }, '+=0.2')
                    .add(() => { lbl.textContent = busy; btn.classList.add('is-busy'); }, '+=0.35')
                    .to(chip, { height: 0, opacity: 0, duration: 0.35, ease: 'power2.in' }, '+=1.2')
                    .add(() => { lbl.textContent = idle; btn.classList.remove('is-busy'); })
                    .addLabel('lineas')
                    .to(status, { opacity: 1, duration: 0.4 }, 'lineas');
                rows.forEach((row, i) => {
                    tl.to(row, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', onStart: () => row.classList.add('is-added') }, `lineas+=${i * 0.14}`);
                });
                return tl;
            },
            () => {
                clean();
                txt.textContent = full;
                gsap.set([chip, status, ...rows], { clearProps: 'height,opacity,transform' });
            },
        );
    }

    // 2 · el borrador del agente llega a la bandeja y el contador sube.
    function storyAgente(p: HTMLElement): Story | null {
        const dr = p.querySelector<HTMLElement>('.cav-dr');
        const plan = p.querySelector<HTMLElement>('.cav-dr-plan');
        const cnt = p.querySelector<HTMLElement>('[data-n]');
        if (!dr || !plan || !cnt) return null;
        const final = cnt.textContent || '';
        return story(
            () => {
                cnt.textContent = String(Math.max(0, Number(final) - 1));
                gsap.set([cnt, plan], { clearProps: 'transform,backgroundColor' });
                gsap.set(dr, { opacity: 0, yPercent: 9 });
            },
            () => gsap.timeline({ delay: 0.35 })
                .to(dr, { opacity: 1, yPercent: 0, duration: 0.85, ease: 'power3.out' })
                .add(() => {
                    cnt.textContent = final;
                    gsap.fromTo(cnt, { scale: 0.82 }, { scale: 1, duration: 0.45, ease: 'back.out(2.2)', clearProps: 'transform' });
                }, '-=0.4')
                .fromTo(plan, { backgroundColor: 'rgba(10,25,47,0.13)' }, { backgroundColor: 'rgba(10,25,47,0.05)', duration: 1.1 }, '-=0.15'),
            () => {
                cnt.textContent = final;
                gsap.set([dr, cnt, plan], { clearProps: 'transform,opacity,backgroundColor' });
            },
        );
    }

    // 3 · las barras apiladas crecen semana por semana y el total cuenta.
    function storyFlujo(p: HTMLElement): Story | null {
        const tracks = Array.from(p.querySelectorAll<HTMLElement>('.cav-fl-track'));
        const segs = Array.from(p.querySelectorAll<HTMLElement>('.cav-fl-track i'));
        const total = p.querySelector<HTMLElement>('[data-count]');
        if (!tracks.length || !total) return null;
        const target = Number(total.dataset.count || 0);
        const prefix = total.dataset.prefix || '$';
        const widthOf = (_: number, el: HTMLElement) => el.dataset.w || '0%';
        return story(
            () => {
                gsap.set(segs, { width: 0 });
                total.textContent = prefix + f0(target * 0.6);
            },
            () => {
                const tl = gsap.timeline();
                tracks.forEach((tr, i) => {
                    tl.to(tr.querySelectorAll('i'), { width: widthOf, duration: 0.9, ease: 'power3.out' }, 0.3 + i * 0.055);
                });
                const o = { v: target * 0.6 };
                tl.to(o, { v: target, duration: 1.4, ease: 'power2.out', onUpdate: () => { total.textContent = prefix + f0(o.v); } }, 0.3);
                return tl;
            },
            () => {
                gsap.set(segs, { width: widthOf });
                total.textContent = prefix + f0(target);
            },
        );
    }

    // 4 · el vendedor pasa de "Poco" a "Normal" y la tasa protegida se recalcula.
    function storyDivisa(p: HTMLElement): Story | null {
        const chips = Array.from(p.querySelectorAll<HTMLElement>('.cav-fx-chip'));
        const bufLbl = p.querySelector<HTMLElement>('[data-buf-lbl]');
        const applied = p.querySelector<HTMLElement>('[data-applied]');
        const books = p.querySelector<HTMLElement>('[data-books]');
        const stepOn = p.querySelector<HTMLElement>('.cav-fx-step.is-on');
        const normal = chips.find((c) => c.dataset.buf === '2');
        if (!chips.length || !bufLbl || !applied || !books || !stepOn || !normal) return null;
        const spot = Number(p.dataset.spot || 0);
        const amount = Number(p.dataset.amount || 0);
        const paint = (b: number) => {
            applied.textContent = '$' + f2(spot * (1 + b / 100));
            books.textContent = '$' + f2(amount * spot * (1 + b / 100));
        };
        const select = (b: number) => {
            chips.forEach((c) => c.classList.toggle('is-on', c.dataset.buf === String(b)));
            bufLbl.textContent = '+' + b + '%';
        };
        return story(
            () => {
                select(1);
                paint(1);
                gsap.set([normal, stepOn], { clearProps: 'transform,backgroundColor' });
            },
            () => {
                const o = { b: 1 };
                return gsap.timeline({ delay: 0.9 })
                    .to(normal, { scale: 0.93, duration: 0.12, ease: 'power1.out' })
                    .add(() => select(2))
                    .to(normal, { scale: 1, duration: 0.4, ease: 'back.out(2)' })
                    .to(o, { b: 2, duration: 0.8, ease: 'power2.out', onUpdate: () => paint(o.b) }, '<')
                    .fromTo(stepOn, { backgroundColor: 'rgba(16,185,129,0.2)' }, { backgroundColor: 'rgba(16,185,129,0.07)', duration: 1 }, '<');
            },
            () => {
                select(2);
                paint(2);
                gsap.set([normal, stepOn], { clearProps: 'transform,backgroundColor' });
            },
        );
    }

    if (root) {
        const tablist = root.querySelector<HTMLElement>('.cav-tabs');
        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.cav-tab'));
        const panes = Array.from(root.querySelectorAll<HTMLElement>('.cav-pane'));
        const panel = root.querySelector<HTMLElement>('.cav-panel');
        const bars = tabs.map((tab) => tab.querySelector<HTMLElement>('.cav-tab-bar i'));
        const builders: Record<string, (p: HTMLElement) => Story | null> = {
            ia: storyIa, agente: storyAgente, flujo: storyFlujo, divisa: storyDivisa,
        };
        const stories: (Story | null)[] = reduced
            ? panes.map(() => null)
            : panes.map((p) => builders[p.dataset.cav || '']?.(p) ?? null);
        const settleAll = () => stories.forEach((s) => s?.settle());

        const DWELL = 9;
        const mm = gsap.matchMedia();

        // ── Escritorio y tablet: tabs + panel, auto-rotación hasta que el usuario elige ──
        mm.add('(min-width: 881px)', () => {
            if (!tablist || !panel || tabs.length !== panes.length) return;
            let active = Math.max(0, tabs.findIndex((tab) => tab.classList.contains('is-active')));
            let auto = !reduced;
            let started = false;
            let inView = false;
            let hovering = false;
            let progress: gsap.core.Tween | null = null;

            const setActive = (i: number) => {
                if (i !== active) stories[active]?.settle();
                tabs.forEach((tab, k) => {
                    const on = k === i;
                    tab.classList.toggle('is-active', on);
                    tab.setAttribute('aria-selected', on ? 'true' : 'false');
                    tab.tabIndex = on ? 0 : -1;
                });
                panes.forEach((p, k) => p.classList.toggle('is-active', k === i));
                active = i;
                stories[i]?.run();
            };
            const clearBars = () => bars.forEach((b) => b && gsap.set(b, { clearProps: 'transform' }));
            const startProgress = () => {
                progress?.kill();
                clearBars();
                const bar = bars[active];
                if (!auto || !bar) return;
                tablist.classList.add('is-auto');
                progress = gsap.fromTo(bar, { scaleX: 0 }, {
                    scaleX: 1, duration: DWELL, ease: 'none',
                    onComplete: () => { if (auto) { setActive((active + 1) % tabs.length); startProgress(); } },
                });
                if (!inView || hovering) progress.pause();
            };
            const stopAuto = () => {
                auto = false;
                progress?.kill();
                progress = null;
                clearBars();
                tablist.classList.remove('is-auto');
            };
            const choose = (i: number) => {
                started = true;
                stopAuto();
                if (i !== active) setActive(i);
            };

            const onClick = (e: Event) => {
                const i = tabs.indexOf(e.currentTarget as HTMLButtonElement);
                if (i >= 0) choose(i);
            };
            const onKey = (e: KeyboardEvent) => {
                const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
                let next = -1;
                if (e.key in keys) next = (active + keys[e.key] + tabs.length) % tabs.length;
                else if (e.key === 'Home') next = 0;
                else if (e.key === 'End') next = tabs.length - 1;
                if (next < 0) return;
                e.preventDefault();
                choose(next);
                tabs[next].focus();
            };
            const onEnter = () => { hovering = true; progress?.pause(); };
            const onLeave = () => { hovering = false; if (inView) progress?.play(); };

            tabs.forEach((tab) => tab.addEventListener('click', onClick));
            tablist.addEventListener('keydown', onKey);
            [tablist, panel].forEach((el) => { el.addEventListener('mouseenter', onEnter); el.addEventListener('mouseleave', onLeave); });

            // El pane inicial arranca en su estado inicial y corre al entrar en viewport.
            stories.forEach((s, k) => { if (k !== active) s?.settle(); });
            stories[active]?.reset();
            ScrollTrigger.create({
                trigger: panel, start: 'top 75%', end: 'bottom 20%',
                onToggle: (self) => {
                    inView = self.isActive;
                    if (inView && !started) {
                        started = true;
                        stories[active]?.run();
                        startProgress();
                    } else if (progress) {
                        if (inView && !hovering) progress.play(); else progress.pause();
                    }
                },
            });

            return () => {
                tabs.forEach((tab) => tab.removeEventListener('click', onClick));
                tablist.removeEventListener('keydown', onKey);
                [tablist, panel].forEach((el) => { el.removeEventListener('mouseenter', onEnter); el.removeEventListener('mouseleave', onLeave); });
                progress?.kill();
                clearBars();
                tablist.classList.remove('is-auto');
                settleAll();
            };
        });

        // ── Móvil: sin tabs; cada pane apilado corre su historia al entrar en viewport ──
        mm.add('(max-width: 880px)', () => {
            panes.forEach((p, i) => {
                p.removeAttribute('role');
                p.removeAttribute('aria-labelledby');
                const s = stories[i];
                const vis = p.querySelector<HTMLElement>('.cav-vis');
                if (!s || !vis) return;
                s.reset();
                ScrollTrigger.create({ trigger: vis, start: 'top 82%', once: true, onEnter: () => s.run() });
            });
            return () => {
                settleAll();
                panes.forEach((p, i) => {
                    p.setAttribute('role', 'tabpanel');
                    p.setAttribute('aria-labelledby', `cav-tab-${i + 1}`);
                });
            };
        });
    }
</script>

<style>
    /* Canvas = el mismo `--color-bg-soft` de todo el index; el carácter vive
       dentro del panel. La sección encuadra un viewport: el bloque (cabecera +
       tabs + panel) se centra y su alto se acota a la pantalla, descontando la
       navbar flotante de arriba. */
    .cav {
        --cav-h: min(640px, calc(100svh - 170px));
        min-height: 100svh;
        display: flex; align-items: center;
        padding: clamp(5rem, 11svh, 6.5rem) 5% clamp(3rem, 7svh, 4.5rem);
        background: var(--color-bg-soft);
        box-sizing: border-box;
    }
    .cav-wrap {
        width: 100%; max-width: 1180px; margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
        gap: 3.25rem;
        align-items: stretch;
    }

    /* ── Izquierda: cabecera arriba, tabs al pie (mismo alto que el panel) ── */
    .cav-left { display: flex; flex-direction: column; justify-content: space-between; gap: 1.6rem; min-width: 0; }
    .cav-title {
        font-size: clamp(1.9rem, 2.5vw, 2.45rem);
        font-weight: 700; line-height: 1.1; letter-spacing: -0.035em;
        color: #0a192f; margin: 0 0 0.85rem;
        text-wrap: balance;
    }
    .cav-sub {
        font-size: 0.95rem; line-height: 1.55;
        color: var(--color-text-muted); margin: 0;
        max-width: 44ch;
    }

    .cav-tabs { display: flex; flex-direction: column; gap: 4px; margin: 0 -12px; }
    .cav-tab {
        position: relative;
        display: flex; align-items: flex-start; gap: 12px;
        width: 100%; padding: 9px 12px;
        background: transparent; border: 0; border-radius: 16px;
        font-family: inherit; color: inherit; text-align: left; cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: background 0.35s ease, box-shadow 0.35s ease;
    }
    .cav-tab:focus { outline: none; }
    .cav-tab:focus-visible { outline: 2px solid rgba(10,25,47,0.35); outline-offset: 2px; }
    /* Activa: superficie blanca, hairline y sombra difusa (sin bordes duros). */
    .cav-tab.is-active {
        padding: 12px 12px 14px;
        background: #fff;
        box-shadow:
            inset 0 0 0 1px rgba(10,25,47,0.06),
            0 1px 2px rgba(10,25,47,0.04),
            0 14px 32px -20px rgba(10,25,47,0.28);
    }
    .cav-tab-ico {
        flex-shrink: 0; width: 32px; height: 32px; border-radius: 9px;
        display: grid; place-items: center;
        background: rgba(10,25,47,0.05); color: #8a94a3;
        transition: background 0.35s ease, color 0.35s ease;
    }
    .cav-tab-ico :global(svg) { width: 17px; height: 17px; }
    .cav-tab.is-active .cav-tab-ico { background: #0a192f; color: #fff; }
    .cav-tab-tx { display: flex; flex-direction: column; min-width: 0; flex: 1; padding-top: 5px; }
    .cav-tab-h {
        font-size: 0.98rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.4;
        color: #8a94a3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        transition: color 0.3s ease;
    }
    .cav-tab:hover .cav-tab-h { color: #4a5567; }
    .cav-tab.is-active .cav-tab-h { color: #0a192f; white-space: normal; }
    .cav-tab-p {
        display: grid; grid-template-rows: 0fr; opacity: 0;
        transition: grid-template-rows 0.45s var(--ease-spring), opacity 0.35s ease;
    }
    .cav-tab-p > span {
        overflow: hidden; min-height: 0;
        font-size: 0.875rem; line-height: 1.5; color: var(--color-text-muted);
    }
    .cav-tab-p > span::before { content: ''; display: block; height: 0.3rem; }
    .cav-tab.is-active .cav-tab-p { grid-template-rows: 1fr; opacity: 1; }
    /* Progreso de la auto-rotación: una línea tenue dentro de la tab activa.
       Sin auto-rotación (el usuario ya eligió) no se dibuja. */
    .cav-tab-bar {
        position: absolute; left: 56px; right: 16px; bottom: 7px; height: 2px;
        border-radius: 2px; overflow: hidden; opacity: 0;
        background: rgba(10,25,47,0.06);
        transition: opacity 0.3s ease;
    }
    .cav-tab-bar i { display: block; height: 100%; background: rgba(10,25,47,0.38); transform: scaleX(0); transform-origin: left center; }
    .cav-tabs.is-auto .cav-tab.is-active .cav-tab-bar { opacity: 1; }

    /* ── Derecha: panel del mismo alto que la columna, acotado al viewport ── */
    .cav-panel {
        position: relative;
        min-height: max(470px, var(--cav-h));
        border-radius: 28px;
        overflow: hidden;
        isolation: isolate;
        background: #eceef2;
        box-shadow:
            0 1px 2px rgba(10,25,47,0.05),
            0 30px 60px -32px rgba(10,25,47,0.34);
    }
    .cav-pane {
        position: absolute; inset: 0;
        opacity: 0; visibility: hidden;
        transition: opacity 0.45s ease, visibility 0s linear 0.45s;
    }
    .cav-pane.is-active { opacity: 1; visibility: visible; transition: opacity 0.45s ease, visibility 0s linear 0s; }
    .cav-pane-head { display: none; }

    .cav-vis {
        position: absolute; inset: 0;
        overflow: hidden; isolation: isolate;
        container-type: size;
        background: var(--cav-base, #eceef2);
    }
    .cav-vis-light {
        background:
            radial-gradient(120% 70% at 50% 0%, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0) 62%),
            linear-gradient(180deg, #eceef2 0%, #f1f2f5 100%);
    }
    .cav-shader { position: absolute; inset: 0; z-index: 0; }

    /* La pieza de UI vive en un marco de 28em × 35em (la composición aprobada)
       centrado en el panel. 1em = lo que quepa: alto en el panel apaisado,
       ancho en la tarjeta 4:5 de móvil. */
    .cav-stage {
        position: absolute; inset: 0; z-index: 2;
        font-size: 16px;
        font-size: min(100cqh / 34, 100cqw / 28);
        font-family: var(--font-sans);
        color: #0f1729;
        line-height: 1.3;
        pointer-events: none;
        user-select: none;
    }
    .cav-stage b, .cav-stage strong { font-weight: 600; }
    .cav-frame { position: absolute; top: -2.3em; left: 50%; width: 28em; height: 35em; margin-left: -14em; }

    /* Etiqueta de KPI (`.kpi-label` de AppLayout) */
    .cav-kl {
        display: block;
        font-size: 0.45em; font-weight: 800; letter-spacing: 0.12em; line-height: 1.35;
        text-transform: uppercase; color: rgba(91,100,114,0.82);
    }

    /* ═══════════ 1 · Editor: "Arma la cotización con IA" + filas ═══════════ */
    .cav-ed {
        position: absolute; left: 1.4em; right: 1.4em; top: 5.3em; bottom: -3em;
        display: flex; flex-direction: column;
    }
    .cav-ai {
        position: relative; z-index: 2;
        padding: 1.2em 1.25em 1.1em;
        border-radius: 1.35em;
        background: #0a192f; color: #fff;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.06),
            0 0.15em 0.4em rgba(10,25,47,0.16),
            0 1.8em 3.4em -1.3em rgba(10,25,47,0.62);
    }
    .cav-ai-t { display: block; font-size: 0.9em; font-weight: 650; letter-spacing: -0.01em; line-height: 1.25; }
    .cav-ai-s { display: block; margin: 0.3em 0 0.85em; font-size: 0.6em; line-height: 1.4; color: rgba(255,255,255,0.66); }
    .cav-ai-ta {
        position: relative;
        min-height: 4.4em;
        padding: 0.7em 2.5em 0.75em 0.8em;
        border-radius: 0.8em;
        background: rgba(255,255,255,0.06);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14);
    }
    .cav-ai-txt { display: block; font-size: 0.64em; line-height: 1.5; white-space: pre-wrap; color: #fff; }
    .cav-ai-clip {
        position: absolute; top: 0.45em; right: 0.45em;
        width: 1.8em; height: 1.8em; border-radius: 0.5em;
        display: grid; place-items: center; color: rgba(255,255,255,0.5);
    }
    .cav-ai-clip svg { width: 1em; height: 1em; }
    .cav-ai-chip { height: 0; opacity: 0; overflow: hidden; }
    .cav-ai-chip-in {
        display: flex; align-items: center; gap: 0.5em;
        margin-top: 0.55em; padding: 0.42em 0.6em; border-radius: 0.55em;
        background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.85);
