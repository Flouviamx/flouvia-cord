---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import StepShaderBg from './StepShaderBg.jsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (p: string) => lang === 'es' ? p : `/en${p === '/' ? '' : p}`;
// Cómo funciona — 3 pasos como tarjetas premium (fondo claro, igual al resto
// de la landing) con un shader azul reactivo (mismo motor que BlogCover) como
// visual de cada tarjeta.
---

<section class="steps" id="como">
    <div class="steps-inner">
        <div class="steps-head">
            <h2 class="steps-title reveal" set:html={t("st.title")} />
            <p class="steps-sub reveal">
                {t("st.sub")}
            </p>
        </div>

        <div class="steps-grid">
            <article class="step reveal">
                <div class="step-shader">
                    <StepShaderBg client:only="react" />
                </div>
                <div class="step-scrim"></div>
                <div class="step-content">
                    <span class="step-num editorial">01</span>
                    <h3 class="step-h">{t("st.1.h")}</h3>
                    <p class="step-p">
                        {t("st.1.p")}
                    </p>
                </div>
            </article>

            <article class="step reveal">
                <div class="step-shader">
                    <StepShaderBg client:only="react" />
                </div>
                <div class="step-scrim"></div>
                <div class="step-content">
                    <span class="step-num editorial">02</span>
                    <h3 class="step-h">{t("st.2.h")}</h3>
                    <p class="step-p">
                        {t("st.2.p")}
                    </p>
                </div>
            </article>

            <article class="step reveal">
                <div class="step-shader">
                    <StepShaderBg client:only="react" />
                </div>
                <div class="step-scrim"></div>
                <div class="step-content">
                    <span class="step-num editorial">03</span>
                    <h3 class="step-h">{t("st.3.h")}</h3>
                    <p class="step-p">
                        {t("st.3.p")}
                    </p>
                </div>
            </article>
        </div>

        <div class="cta-duo-grid">
            <a href={l('/soluciones/startups')} class="cta-card reveal">
                <div class="cta-card-text">
                    <h3 class="cta-card-h">{t('duo.1.h')}</h3>
                    <p class="cta-card-p">{t('duo.1.p')}</p>
                    <span class="cta-card-link">
                        {t('duo.1.link')}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </span>
                </div>
                <div class="cta-card-visual">
                    <StepShaderBg client:only="react" />
                </div>
            </a>

            <a href={l('/elements')} class="cta-card reveal">
                <div class="cta-card-text">
                    <h3 class="cta-card-h">{t('duo.2.h')}</h3>
                    <p class="cta-card-p">{t('duo.2.p')}</p>
                    <span class="cta-card-link">
                        {t('duo.2.link')}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </span>
                </div>
                <div class="cta-card-visual">
                    <StepShaderBg client:only="react" />
                </div>
            </a>
        </div>
    </div>
</section>

<style>
    .steps {
        position: relative;
        background: var(--color-bg-soft);
        padding: 7rem 5% 6rem;
    }
    .steps-inner { position: relative; z-index: 2; max-width: 1180px; margin: 0 auto; }

    /* Título a la izquierda, texto a la derecha (mismo patrón de Features/Hero) */
    .steps-head {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 3.5rem;
        align-items: start;
        margin-bottom: 4rem;
    }
    .steps-title {
        font-size: clamp(2.1rem, 3.4vw, 3.6rem);
        font-weight: 700; line-height: 1.1; letter-spacing: -0.035em;
        margin: 0; color: #0a192f;
    }
    .steps-sub {
        font-size: 1.02rem; line-height: 1.65;
        color: var(--color-text-muted); margin: 0;
        padding-top: 0.4rem;
    }
    @media (max-width: 800px) {
        .steps-head { grid-template-columns: 1fr; gap: 1.3rem; }
        .steps-sub { padding-top: 0; }
    }

    .steps-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.9rem;
    }
    .step {
        position: relative;
        border-radius: 32px;
        overflow: hidden;
        min-height: 320px;
        display: flex;
        align-items: flex-end;
        box-shadow:
            0 2px 4px rgba(10,25,47,0.06),
            0 18px 40px 0 rgba(6,16,45,0.25),
            inset 0 1px 0 rgba(255,255,255,0.12);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    @media (hover: hover) {
        .step:hover {
            transform: translateY(-6px);
            box-shadow:
                0 2px 4px rgba(10,25,47,0.08),
                0 26px 54px 0 rgba(6,16,45,0.3),
                inset 0 1px 0 rgba(255,255,255,0.14);
        }
    }

    .step-shader { position: absolute; inset: 0; z-index: 0; }
    .step-scrim {
        position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background: linear-gradient(to top, rgba(2,6,20,0.72) 0%, rgba(2,6,20,0.28) 48%, rgba(2,6,20,0.02) 75%);
    }

    .step-content {
        position: relative; z-index: 2;
        padding: 2rem 2.1rem 2.3rem;
        display: flex; flex-direction: column; gap: 0.55rem;
    }
    .step-num {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(255,255,255,0.65);
    }
    .step-h { font-size: 1.28rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; color: #fff; text-shadow: 0 2px 14px rgba(0,0,0,0.25); }
    .step-p { font-size: 0.94rem; line-height: 1.6; color: rgba(255,255,255,0.82); margin: 0; }

    @media (max-width: 900px) {
        .steps { padding: 4rem 0 3.5rem; }
        .steps-head { padding: 0 5%; }
        .cta-duo-grid { padding: 0 5%; }
    }
    /* ── CTA duo — fusionada en la misma sección que los 3 pasos (mismo fondo,
       sin borde de sección entre ambas) para que no se note ninguna costura. ── */
    .cta-duo-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-top: 1.9rem;
    }

    .cta-card {
        position: relative;
        display: flex;
        align-items: center;
        overflow: hidden;
        border-radius: 28px;
        min-height: 200px;
        padding: 2.2rem 2.4rem;
        background: #fff;
        text-decoration: none;
        box-shadow:
            0 2px 4px rgba(10,25,47,0.04),
            0 16px 32px 0 rgba(10,25,47,0.08),
            inset 0 1px 0 rgba(255,255,255,0.6);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    @media (hover: hover) {
        .cta-card:hover {
            transform: translateY(-6px);
            box-shadow:
                0 2px 4px rgba(10,25,47,0.05),
                0 24px 48px 0 rgba(10,25,47,0.12),
                inset 0 1px 0 rgba(255,255,255,0.6);
        }
    }

    .cta-card-text { position: relative; z-index: 2; max-width: 54%; }
    .cta-card-h {
        font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em;
        color: #0a192f; margin: 0 0 0.5rem;
    }
    .cta-card-p {
        font-size: 0.92rem; line-height: 1.55;
        color: var(--color-text-muted); margin: 0 0 1.1rem;
    }
    .cta-card-link {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 0.94rem; font-weight: 600; color: var(--color-blue-deep);
    }
    .cta-card-link svg { width: 16px; height: 16px; transition: transform 0.35s var(--ease-spring); }
    .cta-card:hover .cta-card-link svg { transform: translateX(4px); }

    /* El shader vive del lado derecho pero se DIFUMINA hacia el blanco de la
       tarjeta (mask-image, no un corte duro tipo clip-path). */
    .cta-card-visual {
        position: absolute;
        inset: 0;
        z-index: 1;
        -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 50%, rgba(0,0,0,0.35) 66%, #000 90%);
        mask-image: linear-gradient(100deg, transparent 0%, transparent 50%, rgba(0,0,0,0.35) 66%, #000 90%);
    }

    @media (max-width: 860px) {
        .steps-grid { 
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scroll-padding-left: 5%;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch; /* Momentum scrolling nativo de iOS */
            -ms-overflow-style: none;
            scrollbar-width: none;
            padding: 1rem 5% 3.5rem;
            gap: 1.2rem;
        }
        .steps-grid::-webkit-scrollbar { display: none; }
        .step { 
            flex: 0 0 88vw;
            max-width: none;
            scroll-snap-align: start; /* Alineación perfecta a la izquierda como App Store */
            scroll-snap-stop: always; /* Obliga a frenar en cada tarjeta si el swipe es rápido */
        }
        
        .cta-duo-grid { grid-template-columns: 1fr; gap: 1.2rem; }
        .cta-card {
            padding: 1.8rem 1.8rem;
            min-height: 150px;
        }
        .cta-card-text { max-width: 70%; }
        .cta-card-h { font-size: 1.25rem; margin-bottom: 0.35rem; }
        .cta-card-p { font-size: 0.88rem; margin-bottom: 0.9rem; }
        .cta-card-visual {
            -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 45%, rgba(0,0,0,0.3) 65%, #000 90%);
            mask-image: linear-gradient(100deg, transparent 0%, transparent 45%, rgba(0,0,0,0.3) 65%, #000 90%);
        }
    }
</style>
