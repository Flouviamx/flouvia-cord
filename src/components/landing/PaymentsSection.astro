---
import { getLangFromUrl, publicPath, useTranslations } from '../../i18n/utils';
import CordDynamicBg from '../CordDynamicBg.jsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (p: string) => publicPath(p, lang);
const en = lang === 'en';

// Cord Payments — el PROCESO en cuatro pasos numerados, no un segundo bento
// (Invoicing ya es bento). Cada tarjeta es un visual 4:5 con una pieza de la
// app encima, calcada de la pantalla real:
//   1 · ConnectCustomOnboarding.tsx, paso "Verificación" (captura con teléfono)
//   2 · /q/[token]/pay.astro + PaymentIsland.tsx (selector Tarjeta/SPEI)
//   3 · campana de notificaciones (AppLayout) + "Cobros recientes" de /app/cobros
//   4 · zona "Tu dinero hoy" de /app/cobros (saldo, próximo depósito, estado)
// Los mockups se dimensionan en `em` sobre una base de 100cqw/28: la tarjeta
// escala como una imagen y la composición es idéntica en 4 columnas, 2×2 y
// carrusel móvil. Formatos de monto y fecha = los reales de cada pantalla
// (la tabla y el saldo usan money() sin decimales; el link de pago, con ellos).

// Shader oficial dentro de las tarjetas 1 y 3 (familia de Steps, no clones).
const PAL_ALTA = { base: '#091A36', color1: '#15397A', color2: '#2B5FD9', color3: '#5AB8F0' };
const PAL_CONCILIA = { base: '#071A2E', color1: '#0C5A56', color2: '#1D6FBF', color3: '#34D399' };

// QR real (versión 2) de https://cordhq.app — escanearlo no lleva a un token muerto.
const QR_PATH = 'M0 0.5h7m1 0h2m4 0h1m1 0h1m1 0h7M0 1.5h1m5 0h1m7 0h1m3 0h1m5 0h1M0 2.5h1m1 0h3m1 0h1m1 0h1m2 0h3m2 0h1m1 0h1m1 0h3m1 0h1M0 3.5h1m1 0h3m1 0h1m1 0h2m1 0h1m3 0h2m1 0h1m1 0h3m1 0h1M0 4.5h1m1 0h3m1 0h1m1 0h4m1 0h4m1 0h1m1 0h3m1 0h1M0 5.5h1m5 0h1m2 0h1m2 0h1m1 0h1m3 0h1m5 0h1M0 6.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M9 7.5h1m1 0h1m1 0h2M0 8.5h4m2 0h1m1 0h1m4 0h2m1 0h2m2 0h3m1 0h1M2 9.5h4m1 0h1m1 0h1m6 0h1m2 0h1m3 0h1M2 10.5h2m1 0h3m6 0h1m3 0h2M1 11.5h1m1 0h1m7 0h5m1 0h3m1 0h2M0 12.5h1m2 0h1m1 0h2m2 0h1m1 0h1m5 0h2m1 0h1m1 0h3M2 13.5h2m1 0h1m1 0h1m2 0h2m1 0h1m1 0h1m2 0h3m3 0h1M1 14.5h1m2 0h1m1 0h2m2 0h1m1 0h1m1 0h1m5 0h1m1 0h2M0 15.5h1m1 0h2m1 0h1m1 0h1m1 0h1m2 0h2m1 0h1m3 0h2m3 0h1M5 16.5h5m1 0h1m4 0h9M8 17.5h1m1 0h1m1 0h2m1 0h2m3 0h1m1 0h1m1 0h1M0 18.5h7m3 0h3m3 0h1m1 0h1m1 0h1m1 0h3M0 19.5h1m5 0h1m2 0h2m1 0h1m2 0h2m3 0h1m2 0h2M0 20.5h1m1 0h3m1 0h1m3 0h4m2 0h6M0 21.5h1m1 0h3m1 0h1m1 0h2m2 0h4m1 0h2m1 0h5M0 22.5h1m1 0h3m1 0h1m1 0h1m1 0h4m2 0h3m1 0h1m1 0h2M0 23.5h1m5 0h1m1 0h1m1 0h1m6 0h1m2 0h1m1 0h1M0 24.5h7m1 0h2m2 0h1m1 0h1m3 0h7';

// es-MX: '$196,469.20' · en-US: 'MX$196,469.20' (Intl con currency MXN, igual que pay.astro).
const CUR = en ? 'MX$' : '$';

const COBROS = [
    { folio: 'COT-0148', cliente: 'Distribuidora El Zarco', metodo: 'tarjeta', fecha: en ? 'Sep 12, 2026' : '12 sept 2026', monto: '196,469', nuevo: true },
    { folio: 'COT-0146', cliente: 'Constructora Apex', metodo: 'spei', fecha: en ? 'Sep 11, 2026' : '11 sept 2026', monto: '84,120' },
    { folio: 'COT-0143', cliente: 'Grupo Ferretero del Bajío', metodo: 'tarjeta', fecha: en ? 'Sep 9, 2026' : '9 sept 2026', monto: '38,560' },
    { folio: 'COT-0141', cliente: 'Aceros del Norte', metodo: 'spei', fecha: en ? 'Sep 6, 2026' : '6 sept 2026', monto: '121,900' },
];
// Colores y etiquetas de método: METODO_COLOR y cbr.metodo_* de /app/cobros.
const METODO = {
    tarjeta: { color: '#6366f1', label: en ? 'Credit/debit card' : 'Tarjeta de crédito/débito' },
    spei: { color: '#10b981', label: en ? 'SPEI transfer' : 'Transferencia SPEI' },
} as const;
---

<section class="cps" id="cord-payments">
    <div class="cps-inner">
        <div class="cps-head">
            <p class="cps-eyebrow reveal">{t("pay.eyebrow")}</p>
            <div class="cps-head-row">
                <h2 class="cps-title reveal">{t("pay.title")}</h2>
                <div class="cps-head-aside">
                    <p class="cps-sub reveal">{t("pay.sub")}</p>
                    <a href={l("/producto/pagos")} class="cps-cta reveal">
                        {t("pay.cta")}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                </div>
            </div>
        </div>

        <ol class="cps-grid">
            <!-- ─────────── 1 · Alta: paso "Verificación" del asistente real ─────────── -->
            <li class="cps-step reveal">
                <div class="cps-vis cps-vis-dark" style={`--cps-base:${PAL_ALTA.base}`} data-cps="alta">
                    <div class="cps-shader"><CordDynamicBg client:only="react" colors={PAL_ALTA} grain={false} /></div>
                    <span class="cps-num editorial" aria-hidden="true">1</span>
                    <div class="cps-stage" aria-hidden="true">
                        <div class="cps-co">
                            <div class="cps-co-head">
                                <b>{en ? 'Verification' : 'Verificación'}</b>
                                <span>{en ? 'Step 6 of 8' : 'Paso 6 de 8'}</span>
                            </div>
                            <div class="cps-co-prog"><i></i></div>
                            <p class="cps-co-sub">{en
                                ? 'We need a clear photo of a valid government ID. If needed, we may ask for proof of address afterwards.'
                                : 'Necesitamos una foto clara de una identificación oficial vigente. Si hace falta, después te pediremos un comprobante de domicilio.'}</p>
                            <div class="cps-co-tabs">
                                <span class="cps-co-tab is-on">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2.5" fill="currentColor" fill-opacity="0.12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
                                    {en ? 'With your phone' : 'Con tu teléfono'}
                                    <em class="cps-co-tag">{en ? 'Recommended' : 'Recomendado'}</em>
                                </span>
                                <span class="cps-co-tab">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 8 5-5 5 5" fill="currentColor" fill-opacity="0.12"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
                                    {en ? 'Upload file' : 'Subir archivo'}
                                </span>
                            </div>
                            <div class="cps-co-cap">
                                <div class="cps-co-qr">
                                    <svg viewBox="0 0 25 25" shape-rendering="crispEdges"><path stroke="#0a192f" d={QR_PATH}/></svg>
                                </div>
                                <div class="cps-co-link">
                                    <span>https://cordhq.app/verificar-identidad/x7Kq2mVb9TzR4nWc8pLd</span>
                                    <b>{en ? 'Copy' : 'Copiar'}</b>
                                </div>
                                <ul class="cps-co-steps">
                                    <li class="done"><i></i>{en ? 'Front' : 'Frente'}</li>
                                    <li class="done"><i></i>{en ? 'Back' : 'Reverso'}</li>
                                    <li><i></i>{en ? 'Proof of address' : 'Comprobante'}</li>
                                </ul>
                                <span class="cps-co-wait"><i class="cps-spin"></i>{en ? 'Waiting for you to finish on your phone…' : 'Esperando a que termines desde tu teléfono…'}</span>
                            </div>
                        </div>
                    </div>
                </div>
                <h3 class="cps-h">{t("pay.step.1.h")}</h3>
                <p class="cps-p">{t("pay.step.1.p")}</p>
            </li>

            <!-- ─────────── 2 · El link de pago real, en el teléfono del cliente ─────────── -->
            <li class="cps-step reveal">
                <div class="cps-vis cps-vis-light" data-cps="link">
                    <span class="cps-num editorial" aria-hidden="true">2</span>
                    <div class="cps-stage" aria-hidden="true">
                        <div class="cps-phone">
                            <div class="cps-phone-island"></div>
                            <div class="cps-phone-screen">
                                <span class="cps-pp-back">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                                    {en ? 'Back to the quote' : 'Volver a la cotización'}
                                </span>
                                <div class="cps-pp-card">
                                    <div class="cps-pp-brand">
                                        <span class="cps-pp-avatar"><span>M</span></span>
                                        <span class="cps-pp-brand-tx">
                                            <span class="cps-pp-org">Materiales del Valle</span>
                                            <span class="cps-pp-folio">{en ? 'Quote' : 'Cotización'} COT-0148</span>
                                        </span>
                                    </div>
                                    <div class="cps-pp-amt">
                                        <span class="cps-pp-amt-l">{en ? 'Total due' : 'Total a pagar'}</span>
                                        <span class="cps-pp-amt-v editorial">{CUR}196,469.20 <small>MXN</small></span>
                                        <span class="cps-pp-amt-m">{en ? 'Card · SPEI transfer' : 'Tarjeta · Transferencia SPEI'}</span>
                                    </div>
                                    <span class="cps-pp-leg">{en ? 'Payment method' : 'Método de pago'}</span>
                                    <div class="cps-pp-meth">
                                        <span class="is-on">{en ? 'Card' : 'Tarjeta'}</span>
                                        <span>SPEI</span>
                                    </div>
                                    <div class="cps-pp-f">
                                        <span class="cps-pp-lab">{en ? 'Card number' : 'Número de tarjeta'}</span>
                                        <span class="cps-pp-in">
                                            <span>4152 3139 0482 7716</span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2" fill="currentColor" fill-opacity="0.12"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                                        </span>
                                    </div>
                                    <div class="cps-pp-row">
                                        <div class="cps-pp-f">
                                            <span class="cps-pp-lab">{en ? 'Expiration date' : 'Fecha de vencimiento'}</span>
                                            <span class="cps-pp-in"><span>09 / 28</span></span>
                                        </div>
                                        <div class="cps-pp-f">
                                            <span class="cps-pp-lab">{en ? 'Security code' : 'Código de seguridad'}</span>
                                            <span class="cps-pp-in"><span>731</span></span>
                                        </div>
                                    </div>
                                    <span class="cps-pp-pay">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" fill="currentColor" fill-opacity="0.12"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                        {en ? 'Pay' : 'Pagar'} {CUR}196,469.20
                                    </span>
                                </div>
                                <p class="cps-pp-foot">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    <span>{en
                                        ? 'Encrypted and processed by Cord Payments. Materiales del Valle never sees your card details.'
                                        : 'Pago cifrado y procesado por Cord Payments. Materiales del Valle nunca ve los datos de tu tarjeta.'}</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <h3 class="cps-h">{t("pay.step.2.h")}</h3>
                <p class="cps-p">{t("pay.step.2.p")}</p>
            </li>

            <!-- ─────────── 3 · Notificación real + "Cobros recientes" de /app/cobros ─────────── -->
            <li class="cps-step reveal">
                <div class="cps-vis cps-vis-dark" style={`--cps-base:${PAL_CONCILIA.base}`} data-cps="concilia">
                    <div class="cps-shader"><CordDynamicBg client:only="react" colors={PAL_CONCILIA} grain={false} /></div>
                    <span class="cps-num editorial" aria-hidden="true">3</span>
                    <div class="cps-stage" aria-hidden="true">
                        <div class="cps-cb">
                            <div class="cps-cb-head">{en ? 'Recent payments' : 'Cobros recientes'}</div>
                            {COBROS.map((r) => (
                                <div class={`cps-cb-row${r.nuevo ? ' is-new' : ''}`}>
                                    <span class="cps-cb-f">{r.folio}</span>
                                    <span class="cps-cb-a editorial">{CUR}{r.monto}</span>
                                    <span class="cps-cb-c">{r.cliente}</span>
                                    <span class="cps-cb-m"><i style={`background:${METODO[r.metodo as keyof typeof METODO].color}`}></i>{METODO[r.metodo as keyof typeof METODO].label}</span>
                                    <span class="cps-cb-d">{r.fecha}</span>
                                </div>
                            ))}
                        </div>
                        <div class="cps-nt">
                            <span class="cps-nt-ico">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2" fill="currentColor" fill-opacity="0.14"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                            </span>
                            <span class="cps-nt-body">
                                <span class="cps-nt-t">{en ? 'Payment received' : 'Pago recibido'}</span>
                                <span class="cps-nt-s">COT-0148 · Distribuidora El Zarco</span>
                                <span class="cps-nt-w">{en ? '1 min. ago' : 'hace 1 min'}</span>
                            </span>
                        </div>
                    </div>
                </div>
                <h3 class="cps-h">{t("pay.step.3.h")}</h3>
                <p class="cps-p">{t("pay.step.3.p")}</p>
            </li>

            <!-- ─────────── 4 · "Tu dinero hoy": saldo, próximo depósito y estado ─────────── -->
            <li class="cps-step reveal">
                <div class="cps-vis cps-vis-light" data-cps="depositos">
                    <span class="cps-num editorial" aria-hidden="true">4</span>
                    <div class="cps-stage" aria-hidden="true">
                        <div class="cps-bz">
                            <div class="cps-bz-cell cps-bz-saldo">
                                <span class="cps-bz-lab">{en ? 'Available balance' : 'Saldo disponible'}<span class="cps-bz-tag">{en ? 'live' : 'en vivo'}</span></span>
                                <strong class="cps-bz-val editorial" data-count="64820" data-prefix={CUR}>{CUR}64,820</strong>
                                <span class="cps-bz-sub">{CUR}188,261 {en ? 'on the way' : 'en camino'}</span>
                            </div>
                            <div class="cps-bz-cell">
                                <div class="cps-bz-sh">
                                    <div>
                                        <span class="cps-bz-st">{en ? 'Next payout' : 'Próximo depósito'}<span class="cps-bz-tag">{en ? 'live' : 'en vivo'}</span></span>
                                        <span class="cps-bz-sp">{en ? 'Cord Payments transfers to your bank account.' : 'Transferencias de Cord Payments a tu cuenta bancaria.'}</span>
                                    </div>
                                </div>
                                <div class="cps-bz-li">
                                    <i style="background:#3b82f6"></i>
                                    <span><strong>{en ? 'In transit' : 'En camino'}</strong><small>{en ? 'Arrival: Sep 15' : 'Llegada: 15 sept'}</small></span>
                                    <b class="editorial">{CUR}71,940</b>
                                </div>
                            </div>
                            <div class="cps-bz-cell">
                                <div class="cps-bz-sh">
                                    <div>
                                        <span class="cps-bz-st">{en ? 'Account status' : 'Estado de la cuenta'}</span>
                                        <span class="cps-bz-sp">{en ? 'What is still needed to keep charging and depositing.' : 'Lo que falta para seguir cobrando y recibiendo depósitos.'}</span>
                                    </div>
                                    <span class="cps-bz-man">{en ? 'Manage' : 'Administrar'} →</span>
                                </div>
                                <div class="cps-bz-chips">
                                    <span class="cps-bz-chip"><i></i><strong>{en ? 'Payments' : 'Cobros'}</strong><small>{en ? 'Active' : 'Activos'}</small></span>
                                    <span class="cps-bz-chip"><i></i><strong>{en ? 'Payouts' : 'Depósitos'}</strong><small>{en ? 'Active' : 'Activos'}</small></span>
                                    <span class="cps-bz-chip"><i></i><strong>{en ? 'Verification' : 'Verificación'}</strong><small>{en ? 'Complete' : 'Completa'}</small></span>
                                </div>
                                <span class="cps-bz-line">{en ? 'Payouts to BBVA ••••4821' : 'Depósitos a BBVA ••••4821'}</span>
                            </div>
                        </div>
                    </div>
                </div>
                <h3 class="cps-h">{t("pay.step.4.h")}</h3>
                <p class="cps-p">{t("pay.step.4.p")}</p>
            </li>
        </ol>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Micro-historias sutiles, una por tarjeta y una sola vez. El HTML ya es el
    // estado final: sin JS o con reduced-motion todo se ve completo.
    const root = document.getElementById('cord-payments');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (root && !reduced) {
        const once = (el: Element, onEnter: () => void) =>
            ScrollTrigger.create({ trigger: el, start: 'top 78%', once: true, onEnter });

        // 1 · la barra avanza del paso 5 al 6 y el teléfono va entregando las fotos.
        const alta = root.querySelector('[data-cps="alta"]');
        const fill = alta?.querySelector<HTMLElement>('.cps-co-prog i');
        const done = alta ? Array.from(alta.querySelectorAll<HTMLElement>('.cps-co-steps li.done')) : [];
        if (alta && fill) {
            gsap.set(fill, { width: '62.5%' });
            done.forEach((li) => li.classList.remove('done'));
            once(alta, () => {
                gsap.to(fill, { width: '75%', duration: 1.1, ease: 'power3.out', delay: 0.35 });
                done.forEach((li, i) => gsap.delayedCall(1.1 + i * 0.75, () => li.classList.add('done')));
            });
        }

        // 3 · entra la notificación y la fila nueva se ilumina.
        const concilia = root.querySelector('[data-cps="concilia"]');
        const nt = concilia?.querySelector<HTMLElement>('.cps-nt');
        const row = concilia?.querySelector<HTMLElement>('.cps-cb-row.is-new');
        if (concilia && nt && row) {
            gsap.set(nt, { opacity: 0, y: -14, scale: 0.97 });
            gsap.set(row, { backgroundColor: 'rgba(16,185,129,0)' });
            once(concilia, () => {
                gsap.timeline({ delay: 0.3 })
                    .to(nt, { opacity: 1, y: 0, scale: 1, duration: 0.75, ease: 'power3.out', clearProps: 'transform,opacity' })
                    .to(row, { backgroundColor: 'rgba(16,185,129,0.16)', duration: 0.35 }, 0.45)
                    .to(row, { backgroundColor: 'rgba(16,185,129,0.07)', duration: 0.8, clearProps: 'backgroundColor' });
            });
        }

        // 4 · el saldo disponible cuenta hacia su valor.
        const dep = root.querySelector('[data-cps="depositos"]');
        const val = dep?.querySelector<HTMLElement>('[data-count]');
        if (dep && val) {
            const target = Number(val.dataset.count || 0);
            const prefix = val.dataset.prefix || '$';
            const fmt = (n: number) => prefix + new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(n);
            once(dep, () => {
                const o = { v: target * 0.55 };
                gsap.to(o, { v: target, duration: 1.4, ease: 'power2.out', delay: 0.3, onUpdate: () => { val.textContent = fmt(o.v); } });
            });
        }
    }
</script>

<style>
    /* El canvas de la sección es el MISMO de todo el index (`--color-bg-soft`):
       el carácter vive dentro de cada tarjeta, nunca en una banda de color. */
    .cps {
        padding: 8rem 5% 7.5rem;
        background: var(--color-bg-soft);
    }
    .cps-inner { max-width: 1180px; margin: 0 auto; }

    /* ── Cabecera: eyebrow arriba, título izquierda, texto + CTA derecha ── */
    .cps-head { margin: 0 0 3.5rem; }
    .cps-eyebrow {
        font-size: 0.65rem; font-weight: 800; letter-spacing: 3px;
        text-transform: uppercase; color: var(--color-blue-deep); opacity: 0.6;
        margin: 0 0 1.2rem;
    }
    .cps-head-row {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 3.5rem;
        align-items: start;
    }
    .cps-title {
        font-size: clamp(2.1rem, 3.4vw, 3.6rem);
        font-weight: 700; line-height: 1.1; letter-spacing: -0.035em;
        color: #0a192f; margin: 0;
    }
    .cps-head-aside { display: flex; flex-direction: column; gap: 1.4rem; align-items: flex-start; padding-top: 0.4rem; }
    .cps-sub {
        font-size: 1.02rem; line-height: 1.65;
        color: var(--color-text-muted); margin: 0;
    }
    .cps-cta {
        display: inline-flex; align-items: center; gap: 8px;
        font-size: 0.96rem; font-weight: 600; color: var(--color-blue-deep);
        text-decoration: none;
    }
