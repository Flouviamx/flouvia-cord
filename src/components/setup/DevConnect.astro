---
// Panel para desarrolladores al terminar la configuración: tres comandos del CLI
// y cada paso se marca solo (lee /api/cli/status mientras el panel está abierto).
import { t } from '../../i18n/app';
import { currentLocale } from '../../lib/context';

const L = currentLocale();
const docsHref = `https://docs.cordhq.app${L === 'en' ? '/en' : ''}/docs/desarrolladores/herramientas/cli`;
const steps = [
    { key: 'login', title: t(L, 'setup.dev.s1'), hint: t(L, 'setup.dev.s1_hint'), cmd: 'npx @flouviahq/cli login' },
    { key: 'api', title: t(L, 'setup.dev.s2'), hint: t(L, 'setup.dev.s2_hint'), cmd: 'npx @flouviahq/cli init' },
    { key: 'listen', title: t(L, 'setup.dev.s3'), hint: t(L, 'setup.dev.s3_hint'), cmd: 'npx @flouviahq/cli listen --forward-to http://localhost:3000/api/webhooks/cord' },
];
---

<details class="dc" data-dev-connect data-copied={t(L, 'setup.dev.copied')} data-copy={t(L, 'setup.dev.copy')} data-done={t(L, 'setup.dev.done')}>
    <summary class="dc-sum">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="16" rx="3" fill="currentColor" fill-opacity="0.13"/><path d="m7 10 3 2.5L7 15M12.5 15H17"/></svg>
        <span class="dc-sum-text"><b>{t(L, 'setup.dev.title')}</b><small>{t(L, 'setup.dev.sub')}</small></span>
        <svg class="dc-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </summary>
    <ol class="dc-steps">
        {steps.map((s, i) => (
            <li class="dc-step" data-dc-step={s.key}>
                <span class="dc-dot" aria-hidden="true"><span class="dc-num">{i + 1}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 12.5 10 16.5 18 8"/></svg></span>
                <div class="dc-body">
                    <p class="dc-title">{s.title} <span class="dc-state" data-dc-state>{t(L, 'setup.dev.waiting')}</span></p>
                    <p class="dc-hint">{s.hint}</p>
                    <div class="dc-cmd">
                        <code>{s.cmd}</code>
                        <button type="button" class="dc-copy" data-dc-copy={s.cmd}>{t(L, 'setup.dev.copy')}</button>
                    </div>
                </div>
            </li>
        ))}
    </ol>
    <a class="dc-docs" href={docsHref} target="_blank" rel="noopener">{t(L, 'setup.dev.docs')}</a>
</details>

<style>
    .dc { margin: 1.8rem 0 0; border-radius: 18px; background: #f5f5f7; text-align: left; }
    .dc-sum { display: flex; align-items: center; gap: 14px; padding: 16px 18px; cursor: pointer; list-style: none; border-radius: 18px; }
    .dc-sum::-webkit-details-marker { display: none; }
    .dc-sum:focus-visible { outline: 2px solid #0a192f; outline-offset: 2px; }
    .dc-sum > svg:first-child { width: 26px; height: 26px; color: #0a192f; flex-shrink: 0; }
    .dc-sum-text { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .dc-sum-text b { font-size: 0.95rem; color: #050505; font-weight: 600; }
    .dc-sum-text small { font-size: 0.82rem; color: #6b7280; line-height: 1.45; }
    .dc-chev { width: 18px; height: 18px; color: #6b7280; transition: transform 0.2s; flex-shrink: 0; }
    .dc[open] .dc-chev { transform: rotate(180deg); }
    .dc-steps { list-style: none; margin: 0; padding: 4px 18px 6px; display: flex; flex-direction: column; gap: 18px; }
    .dc-step { display: grid; grid-template-columns: 28px 1fr; gap: 12px; }
    .dc-dot { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: #fff; box-shadow: 0 0 0 1px rgba(10,25,47,0.1); font-size: 0.78rem; font-weight: 700; color: #0a192f; }
    .dc-dot svg { display: none; width: 14px; height: 14px; }
    .dc-step.is-done .dc-dot { background: #047857; box-shadow: none; color: #fff; }
    .dc-step.is-done .dc-num { display: none; }
    .dc-step.is-done .dc-dot svg { display: block; }
    .dc-body { min-width: 0; }
    .dc-title { margin: 3px 0 2px; font-size: 0.92rem; font-weight: 600; color: #050505; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .dc-state { font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: rgba(10,25,47,0.06); color: #6b7280; }
    .dc-step.is-done .dc-state { background: rgba(4,120,87,0.1); color: #047857; }
    .dc-hint { margin: 0 0 8px; font-size: 0.84rem; color: #6b7280; line-height: 1.5; }
    .dc-cmd { display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 14px; border-radius: 12px; background: #0a192f; }
    .dc-cmd code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font: 500 0.8rem/1.6 ui-monospace, 'SF Mono', Menlo, monospace; color: #e5e7eb; scrollbar-width: none; }
    .dc-cmd code::-webkit-scrollbar { display: none; }
    .dc-copy { flex-shrink: 0; min-height: 34px; padding: 0 12px; border: 0; border-radius: 8px; background: rgba(255,255,255,0.1); color: #fff; font: inherit; font-size: 0.76rem; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .dc-copy:hover { background: rgba(255,255,255,0.18); }
    .dc-copy:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .dc-docs { display: inline-flex; align-items: center; min-height: 44px; margin: 4px 18px 8px 58px; font-size: 0.86rem; font-weight: 600; color: #0a192f; text-decoration: none; }
    .dc-docs:hover { text-decoration: underline; }
    @media (max-width: 520px) {
        .dc-steps { padding: 4px 14px 6px; }
        .dc-docs { margin-left: 54px; }
    }
</style>

<script>
    document.querySelectorAll<HTMLDetailsElement>('[data-dev-connect]').forEach((root) => {
        let timer: number | undefined;
        let busy = false;
        let finished = false;
        const apply = (state: Record<string, boolean>) => {
            let all = true;
            root.querySelectorAll<HTMLElement>('[data-dc-step]').forEach((li) => {
                const done = !!state[li.dataset.dcStep || ''];
                li.classList.toggle('is-done', done);
                if (!done) all = false;
                const label = li.querySelector<HTMLElement>('[data-dc-state]');
                if (label && done) label.textContent = root.dataset.done || '';
            });
            finished = all;
        };
        const poll = async () => {
            timer = undefined;
            if (busy || !root.open || document.hidden || finished) return;
            busy = true;
            try {
                const res = await fetch('/api/cli/status', { headers: { Accept: 'application/json' } });
                if (res.ok) apply(await res.json());
            } catch { /* siguiente intento */ }
            busy = false;
            if (!finished) timer = window.setTimeout(poll, 3000);
        };
        const kick = () => { if (timer === undefined) poll(); };
        root.addEventListener('toggle', kick);
        document.addEventListener('visibilitychange', () => { if (!document.hidden) kick(); });
        root.querySelectorAll<HTMLButtonElement>('[data-dc-copy]').forEach((btn) => btn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(btn.dataset.dcCopy || '');
                btn.textContent = root.dataset.copied || '';
                setTimeout(() => { btn.textContent = root.dataset.copy || ''; }, 1600);
            } catch { /* sin portapapeles */ }
        }));
    });
</script>
