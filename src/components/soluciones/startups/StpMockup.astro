---
// Calcas de pantallas reales de Cord para /soluciones/startups (org demo: Nodo Labs).
interface Props { scene: string; isEn?: boolean }
const { scene, isEn = false } = Astro.props;
const t = (es: string, en: string) => (isEn ? en : es);
const fav = (d: string) => `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${d}&size=128`;

const fit = scene.startsWith('p-') ? 'pillar' : scene.startsWith('b-') || scene.startsWith('g-') ? 'block' : scene.startsWith('r-') ? 'res' : 'tab';

const quotes = [
    { folio: 'COT-0088', ini: 'EB', cli: 'Estudio Brava', sub: t('Contado', 'Due on receipt'), amt: 'MXN 24,500.00', st: 'draft', hl: true },
    { folio: 'COT-0087', ini: 'FI', cli: 'Finmarket Inc.', sub: t('Contado', 'Due on receipt'), amt: 'USD 14,400.00', st: 'paid' },
    { folio: 'COT-0086', ini: 'RL', cli: 'Rutas Logísticas', sub: 'Net 30', amt: 'MXN 86,000.00', st: 'viewed' },
    { folio: 'COT-0085', ini: 'CA', cli: 'Clínica Aurora', sub: t('Contado', 'Due on receipt'), amt: 'USD 3,600.00', st: 'approved' },
    { folio: 'COT-0084', ini: 'EB', cli: 'Estudio Brava', sub: t('Contado', 'Due on receipt'), amt: 'MXN 24,500.00', st: 'sent' },
    { folio: 'COT-0083', ini: 'AS', cli: 'Altamar Seguros', sub: t('Contado', 'Due on receipt'), amt: 'MXN 58,000.00', st: 'invoiced' },
];
const ST: Record<string, [string, string]> = {
    draft: [t('Borrador', 'Draft'), 'gray'],
    sent: [t('Enviada', 'Sent'), 'blue'],
    viewed: [t('Vista', 'Viewed'), 'violet'],
    approved: [t('Aprobada', 'Approved'), 'green'],
    paid: [t('Pagada', 'Paid'), 'green2'],
    invoiced: [t('Facturada', 'Invoiced'), 'navy'],
};
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const lock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2.5" fill="currentColor" fill-opacity="0.15"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>';
const cardIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="currentColor" fill-opacity="0.14"/><line x1="2.5" y1="10" x2="21.5" y2="10"/><line x1="6" y1="15" x2="10" y2="15"/></svg>';
const cpuIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" fill-opacity="0.2"/><path d="M6 9H4M6 15H4M18 9h2M18 15h2M9 6V4M15 6V4M9 18v2M15 18v2"/></svg>';
const shieldIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="currentColor" fill-opacity="0.14"/><polyline points="8.5 12 11 14.5 15.5 9.5"/></svg>';
const taskIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="4" fill="currentColor" fill-opacity="0.14"/><polyline points="8 12 11 15 16 9"/></svg>';
const boltIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.14"/><path d="M12.5 6.5 9 13h3l-.5 4.5L15 11h-3z"/></svg>';
const filterIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16l-6 7.5V19l-4 1.5v-8z" fill="currentColor" fill-opacity="0.14"/></svg>';
const docIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="currentColor" fill-opacity="0.13"/><polyline points="15 2 15 7 20 7"/><path d="M9 13h6M9 17h4"/></svg>';
const linkIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a5 5 0 0 0 7.1 0l3-3a5 5 0 0 0-7.1-7.1l-1.5 1.5"/><path d="M14 10a5 5 0 0 0-7.1 0l-3 3a5 5 0 0 0 7.1 7.1l1.5-1.5"/></svg>';
const copyIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2.5" fill="currentColor" fill-opacity="0.13"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>';
const dupIc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="13" height="13" rx="2.5" fill="currentColor" fill-opacity="0.18"/><path d="M4 16V5a1 1 0 0 1 1-1h11"/><path d="M14.5 11.5v6M11.5 14.5h6"/></svg>';
---

<div class={`stp-root stp-canvas stp-fit-${fit} stp-s-${scene}`} aria-hidden="true">

{scene === 'editor' && (
    <div class="stp-win">
        <div class="stp-bar">
            <div class="stp-bar-l"><span class="stp-crumb">{t('Nueva cotización', 'New quote')} /</span><b>Finmarket Inc.</b></div>
            <span class="stp-pill stp-navy">USD</span>
        </div>
        <div class="stp-ai stp-in">
            <span class="stp-ai-ic" set:html={cpuIc}></span>
            <div class="stp-ai-copy">
                <div class="stp-ai-q">{t('“Plan Growth anual para 12 personas, más el arranque.”', '“Annual Growth plan for 12 people, plus onboarding.”')}</div>
                <div class="stp-ai-st"><span set:html={check}></span>{t('2 líneas armadas. Revisa cantidades y precios.', '2 lines built. Check quantities and prices.')}</div>
            </div>
        </div>
        <div class="stp-th stp-g-ed"><span>{t('Producto', 'Product')}</span><span class="stp-r">{t('Cant.', 'Qty.')}</span><span class="stp-r">{t('Negociado', 'Negotiated')}</span><span class="stp-r">{t('Importe', 'Amount')}</span></div>
        <div class="stp-tr stp-g-ed stp-in">
            <span class="stp-2l"><b>{t('Plan Growth · anual', 'Growth plan · annual')}</b><small>GRW-ANU · {t('Exento', 'Exempt')}</small></span>
            <span class="stp-r stp-num">12</span><span class="stp-r stp-num">1,000.00</span><span class="stp-r stp-num stp-strong">12,000.00</span>
        </div>
        <div class="stp-tr stp-g-ed stp-in">
            <span class="stp-2l"><b>{'Onboarding'}</b><small>ONB-01 · {t('Exento', 'Exempt')}</small></span>
            <span class="stp-r stp-num">1</span><span class="stp-r stp-num">2,400.00</span><span class="stp-r stp-num stp-strong">2,400.00</span>
        </div>
        <div class="stp-sum stp-in">
            <div><span>Subtotal</span><span class="stp-num">USD 14,400.00</span></div>
            <div class="stp-sum-t"><span>Total</span><span class="stp-num">USD 14,400.00</span></div>
        </div>
    </div>
)}

{scene === 'paylink' && (
    <Fragment>
        <div class="stp-phone">
            <div class="stp-phone-scr">
                <div class="stp-ph-url"><span set:html={lock}></span>cordhq.app/q/7Kx2…</div>
                <div class="stp-ph-brand"><span class="stp-logo">N</span><b>Nodo Labs</b></div>
                <div class="stp-eyebrow">{t('COTIZACIÓN', 'QUOTE')} · COT-0085</div>
                <div class="stp-ph-for">{t('Para', 'For')} <b>Clínica Aurora</b></div>
                <div class="stp-eyebrow stp-mt">{t('TOTAL A PAGAR', 'TOTAL DUE')}</div>
                <div class="stp-ph-total stp-num">USD 3,600.00</div>
                <div class="stp-ph-line"><span>{t('Plan Growth · anual × 3', 'Growth plan · annual × 3')}</span><span class="stp-num">3,000.00</span></div>
                <div class="stp-ph-line"><span>Onboarding</span><span class="stp-num">600.00</span></div>
                <div class="stp-sheet stp-in">
                    <div class="stp-sheet-grab"></div>
                    <b class="stp-sheet-t">{t('Firma digital', 'Digital signature')}</b>
                    <label>{t('Nombre completo del firmante', "Signer's full name")}</label>
                    <div class="stp-input">Dra. Paula Lozano<i></i></div>
                    <div class="stp-chk"><span set:html={check}></span>{t('He revisado esta cotización y acepto los términos', 'I have reviewed this quote and accept the terms')}</div>
                    <div class="stp-btn">{t('Confirmar y firmar', 'Confirm and sign')}</div>
                </div>
            </div>
        </div>
        <div class="stp-float stp-paynext stp-in">
            <div class="stp-eyebrow">{t('A PAGAR AHORA', 'PAY NOW')}</div>
            <div class="stp-pn-amt stp-num">USD 3,600.00</div>
            <div class="stp-pn-card"><span set:html={cardIc}></span>•••• 4242</div>
            <div class="stp-btn stp-btn-sm"><span set:html={lock}></span>{t('Pagar de forma segura', 'Pay securely')}</div>
            <div class="stp-pn-foot">Cord Payments</div>
        </div>
    </Fragment>
)}

{scene === 'zapier' && (
    <div class="stp-win">
        <div class="stp-bar">
            <div class="stp-bar-l"><img src={fav('zapier.com')} alt="" width="16" height="16" loading="lazy" /><b>{t('Cobro → hoja y Slack', 'Payment → sheet and Slack')}</b></div>
            <span class="stp-pill stp-green"><i class="stp-dot"></i>{t('Activo', 'On')}</span>
        </div>
        <div class="stp-flow">
            <div class="stp-step stp-in">
                <span class="stp-step-ic stp-step-cord">C</span>
                <div class="stp-2l"><small>{t('1 · Disparador · Cord', '1 · Trigger · Cord')}</small><b>{t('Cotización pagada', 'Quote paid')}</b></div>
                <code class="stp-code-chip">quote.paid</code>
            </div>
            <div class="stp-step-data stp-in">
                <span>COT-0087</span><span>Finmarket Inc.</span><span>14400</span><span>USD</span>
            </div>
            <div class="stp-step stp-in">
                <img class="stp-step-ic" src={fav('sheets.google.com')} alt="" width="22" height="22" loading="lazy" />
                <div class="stp-2l"><small>{t('2 · Acción · Google Sheets', '2 · Action · Google Sheets')}</small><b>{t('Agregar fila en “Ventas 2026”', 'Add row to “Sales 2026”')}</b></div>
            </div>
            <div class="stp-step stp-in">
                <img class="stp-step-ic" src={fav('slack.com')} alt="" width="22" height="22" loading="lazy" />
                <div class="stp-2l"><small>{t('3 · Acción · Slack', '3 · Action · Slack')}</small><b>{t('Mensaje en #ventas', 'Message in #sales')}</b></div>
            </div>
            <div class="stp-alts stp-in">
                <span>{t('También con', 'Also with')}</span>
                <img src={fav('make.com')} alt="Make" width="16" height="16" loading="lazy" />
                <img src={fav('n8n.io')} alt="n8n" width="16" height="16" loading="lazy" />
            </div>
        </div>
    </div>
)}

{scene === 'webhooks' && (
    <div class="stp-win">
        <div class="stp-bar">
            <div class="stp-bar-l"><b>{t('Endpoints de webhook', 'Webhook endpoints')}</b></div>
            <span class="stp-pill stp-green"><i class="stp-dot"></i>{t('Activo', 'Active')}</span>
        </div>
        <div class="stp-ep stp-in">
            <code class="stp-ep-url"><b>POST</b> https://api.nodolabs.io/webhooks/cord</code>
            <div class="stp-ep-sub">{t('4 eventos · firma HMAC-SHA256 en X-Cord-Signature', '4 events · HMAC-SHA256 signature in X-Cord-Signature')}</div>
        </div>
        <div class="stp-th stp-g-wh"><span>{t('Evento', 'Event')}</span><span>{t('Respuesta', 'Response')}</span><span class="stp-r">{t('Hora', 'Time')}</span></div>
        {[
            ['quote.paid', 'COT-0087', '200', '', '11:42'],
            ['quote.approved', 'COT-0085', '200', t('intento 2', 'attempt 2'), '10:16'],
            ['quote.approved', 'COT-0085', '503', t('intento 1', 'attempt 1'), '10:15'],
            ['quote.viewed', 'COT-0086', '200', '', '09:58'],
            ['client.created', 'Halden Logistik', '200', '', '09:31'],
        ].map(([ev, ref, code, att, h]) => (
            <div class="stp-tr stp-g-wh stp-in">
                <span class="stp-2l"><code class="stp-ev">{ev}</code><small>{ref}</small></span>
                <span class="stp-resp"><span class={`stp-code ${code === '200' ? 'ok' : 'err'}`}>{code}</span>{att && <small>{att}</small>}</span>
                <span class="stp-r stp-muted stp-num">{h}</span>
            </div>
        ))}
    </div>
)}

{scene === 'api' && (
    <div class="stp-win stp-dark">
        <div class="stp-bar stp-bar-dark">
            <div class="stp-bar-l"><code>POST /api/v1/cotizaciones</code></div>
            <span class="stp-pill stp-test">sk_test</span>
        </div>
        <pre class="stp-term stp-in"><span class="c-mu">$</span> curl https://cordhq.app/api/v1/cotizaciones \
  -H <span class="c-gr">"Authorization: Bearer sk_test_51c9…"</span> \
  -d <span class="c-ye">'&#123; "cliente_id": "7c1e…",
        "base_currency": "USD", "send": true,
        "items": [&#123; "descripcion": "{t('Plan Growth anual', 'Growth plan, annual')}",
          "cantidad": 4, "precio_unitario": 1000 &#125;] &#125;'</span>

<span class="c-mu">HTTP/2</span> <span class="c-gr">200</span>
&#123; <span class="c-bl">"data"</span>: &#123;
    <span class="c-bl">"folio"</span>: <span class="c-gr">"COT-0092"</span>,
    <span class="c-bl">"link_publico"</span>: <span class="c-gr">"https://cordhq.app/q/k3Pz…"</span>,
    <span class="c-bl">"needs_approval"</span>: <span class="c-ye">false</span>,
    <span class="c-bl">"email"</span>: &#123; <span class="c-bl">"sent"</span>: <span class="c-ye">true</span> &#125; &#125; &#125;</pre>
    </div>
)}

{scene === 'elements' && (
    <Fragment>
        <div class="stp-win stp-host">
            <div class="stp-url"><span set:html={lock}></span>{t('app.nodolabs.io/cuenta/plan', 'app.nodolabs.io/account/plan')}</div>
            <div class="stp-host-body">
                <div class="stp-host-side"><span class="stp-logo stp-logo-sm">N</span><i></i><i></i><i class="on"></i><i></i></div>
                <div class="stp-host-main">
                    <div class="stp-host-h">{t('Tu plan', 'Your plan')}</div>
                    <div class="stp-host-s">{t('Menta Pagos · 5 de 5 asientos en uso', 'Menta Pagos · 5 of 5 seats in use')}</div>
                    <div class="stp-embed stp-in">
                        <div class="stp-embed-top"><span class="stp-eyebrow">{t('COTIZACIÓN', 'QUOTE')} · COT-0090</span><span class="stp-pill stp-blue">{t('Enviada', 'Sent')}</span></div>
                        <div class="stp-embed-l"><span>{t('Plan Growth · anual × 8', 'Growth plan · annual × 8')}</span><span class="stp-num">USD 8,000.00</span></div>
                        <div class="stp-embed-tot"><span>Total</span><span class="stp-num">USD 8,000.00</span></div>
                        <div class="stp-btn">{t('Aprobar cotización', 'Approve quote')}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="stp-float stp-snippet stp-in"><span class="c-mu">&lt;</span><span class="c-bl">cord-cotizador</span> <span class="c-ye">token</span>=<span class="c-gr">"Rm4t…"</span><span class="c-mu">&gt;&lt;/</span><span class="c-bl">cord-cotizador</span><span class="c-mu">&gt;</span></div>
    </Fragment>
)}

{scene === 'p-pay' && (
    <div class="stp-win stp-pay">
        <div class="stp-pay-top"><span class="stp-eyebrow">{t('A PAGAR AHORA', 'PAY NOW')}</span><span class="stp-muted">COT-0087</span></div>
        <div class="stp-pay-amt stp-num">USD 14,400.00</div>
        <div class="stp-pay-sub">Finmarket Inc. · {t('Plan Growth anual', 'Annual Growth plan')}</div>
        <div class="stp-pay-field stp-in"><span set:html={cardIc}></span><span class="stp-num">4242 4242 4242 4242</span><span class="stp-muted stp-num">12/28</span></div>
        <div class="stp-btn stp-in"><span set:html={lock}></span>{t('Pagar de forma segura', 'Pay securely')}</div>
        <div class="stp-pay-foot">{t('Pago protegido por Cord Payments', 'Payment protected by Cord Payments')}</div>
    </div>
)}

{scene === 'p-track' && (
    <div class="stp-win">
        <div class="stp-bar">
            <div class="stp-bar-l"><b>{t('Atención del cliente', 'Client attention')}</b></div>
            <span class="stp-pill stp-green"><i class="stp-dot stp-live"></i>{t('Viendo ahora', 'Viewing now')}</span>
        </div>
        <div class="stp-att">
            <div class="stp-att-who">COT-0086 · Rutas Logísticas</div>
            <div class="stp-att-stats"><b class="stp-num">{t('3 aperturas', '3 opens')}</b><span>{t('Primera: ayer 18:24', 'First: yesterday 6:24 pm')}</span><span>{t('Última: hace 4 min', 'Last: 4 min ago')}</span></div>
            {[
                [t('Partidas', 'Line items'), 92, '3m 10s'],
                [t('Resumen', 'Summary'), 44, '1m 05s'],
                [t('Aprobación y pago', 'Approval and payment'), 28, '40s'],
                [t('Notas y términos', 'Notes and terms'), 16, '22s'],
            ].map(([k, w, v], i) => (
                <div class="stp-att-row stp-in"><span>{k}</span><i><em class={i === 0 ? 'on' : ''} style={`width:${w}%`}></em></i><span class="stp-num">{v}</span></div>
            ))}
        </div>
    </div>
)}

{scene === 'p-usage' && (
    <div class="stp-win">
        <div class="stp-bar">
            <div class="stp-bar-l"><b>{t('Uso del plan este periodo', 'Plan usage this period')}</b></div>
            <span class="stp-pill stp-navy">Starter</span>
        </div>
        <div class="stp-use">
            <div class="stp-use-row stp-in">
                <div class="stp-use-h"><span>{t('Facturas fiscales', 'Fiscal invoices')} <small>CFDI 4.0 · {t('México', 'Mexico')}</small></span><b class="stp-num">4 / 30</b></div>
                <i class="stp-meter"><em style="width:13.3%"></em></i>
            </div>
            <div class="stp-use-row stp-in">
                <div class="stp-use-h"><span>{t('Documentos comerciales', 'Commercial documents')}</span><b class="stp-num">12</b></div>
                <div class="stp-use-inf">{t('∞ Ilimitado en tu plan', '∞ Unlimited on your plan')}</div>
            </div>
            <div class="stp-use-last stp-in">
                <span class="stp-ic-sm" set:html={docIc}></span>
                <span class="stp-2l"><b>FAC-0044 · Tlali Foods</b><small>CFDI 4.0 · {t('hoy 10:12', 'today 10:12')}</small></span>
                <span class="stp-num stp-strong">MXN 31,320.00</span>
            </div>
        </div>
    </div>
)}

{scene === 'b-list' && (
    <Fragment>
        <div class="stp-win">
            <div class="stp-bar">
                <div class="stp-bar-l"><b>{t('Cotizaciones', 'Quotes')}</b></div>
                <span class="stp-mini-btn">+ {t('Nueva', 'New')}</span>
            </div>
            <div class="stp-kpis stp-in">
                <div><b class="stp-num">MXN 110,500</b><span>{t('en pipeline · 2 abiertas', 'in pipeline · 2 open')}</span></div>
                <div><b class="stp-num">USD 3,600</b><span>{t('aprobado, por cobrar', 'approved, to be collected')}</span></div>
            </div>
            <div class="stp-filters stp-in">
                <span class="on">{t('Todas', 'All')}<em>6</em></span><span>{t('Abiertas', 'Open')}<em>2</em></span><span>{t('Aprobadas', 'Approved')}<em>2</em></span><span>{t('Pagadas', 'Paid')}<em>1</em></span>
            </div>
            {quotes.map((q) => (
                <div class={`stp-qrow stp-in ${q.hl ? 'stp-qrow-hl' : ''}`}>
                    <span class="stp-av">{q.ini}</span>
                    <span class="stp-2l"><b>{q.cli}</b><small><span class="stp-folio">{q.folio}</span> · {q.sub}</small></span>
                    <span class="stp-qrow-r"><span class="stp-num stp-strong">{q.amt}</span><span class={`stp-pill stp-${ST[q.st][1]}`}>{ST[q.st][0]}</span></span>
                </div>
            ))}
        </div>
        <div class="stp-float stp-actions stp-in">
            <div class="stp-act-h">COT-0084 · {t('Acciones', 'Actions')}</div>
            <div class="stp-act"><span set:html={linkIc}></span>{t('Abrir link', 'Open link')}</div>
            <div class="stp-act"><span set:html={copyIc}></span>{t('Copiar link', 'Copy link')}</div>
            <div class="stp-act on"><span set:html={dupIc}></span>{t('Duplicar cotización', 'Duplicate quote')}</div>
        </div>
    </Fragment>
)}

{scene === 'b-link' && (
    <div class="stp-win">
