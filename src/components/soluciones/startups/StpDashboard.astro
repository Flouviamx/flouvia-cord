---
// Calca de /app (Inicio) para Nodo Labs: sidebar real, KPIs reales y actividad por cotización.
interface Props { isEn?: boolean }
const { isEn = false } = Astro.props;
const t = (es: string, en: string) => (isEn ? en : es);

const nav = [
    { g: null, items: [
        { l: t('Inicio', 'Home'), on: true, ic: '<rect x="3" y="3" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="14" y="14" width="7" height="7" rx="1" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>' },
        { l: t('Cotizaciones', 'Quotes'), ic: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8" stroke-opacity="0.5"/><line x1="16" y1="13" x2="8" y2="13" stroke-opacity="0.5"/><line x1="16" y1="17" x2="8" y2="17" stroke-opacity="0.5"/>' },
        { l: t('Clientes', 'Clients'), ic: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4" fill="currentColor" fill-opacity="0.25" stroke="none"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87" stroke-opacity="0.5"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke-opacity="0.5"/>' },
        { l: t('Productos', 'Products'), ic: '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5" stroke-opacity="0.5"/><path d="M12 22V12" stroke-opacity="0.5"/>' },
    ] },
    { g: t('Mi dinero', 'My money'), items: [
        { l: t('Facturas', 'Invoices'), ic: '<path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="currentColor" fill-opacity="0.12" stroke="none"/><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><polyline points="15 2 15 7 20 7" stroke-opacity="0.5"/><path d="M9 13h6" stroke-opacity="0.55"/><path d="M9 17h4" stroke-opacity="0.55"/>' },
        { l: t('Cobros', 'Payments'), ic: '<circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.1" stroke="none"/><path d="M12 2v20" stroke-opacity="0.5"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>' },
    ] },
    { g: t('Inteligencia', 'Intelligence'), items: [
        { l: t('Informes', 'Reports'), ic: '<rect x="3" y="3" width="18" height="18" rx="4" fill="currentColor" fill-opacity="0.12" stroke="none"/><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M7 16l3-3 2.5 2.5L17 10"/>' },
        { l: 'Workflows', ic: '<rect x="8.25" y="2.5" width="7.5" height="6" rx="2.2" fill="currentColor" fill-opacity="0.15"/><path d="M12 8.5v3.2M5.4 15.5v-1.6a2.2 2.2 0 0 1 2.2-2.2h8.8a2.2 2.2 0 0 1 2.2 2.2v1.6" stroke-opacity="0.7"/><rect x="2.5" y="15.5" width="5.8" height="6" rx="2" fill="currentColor" fill-opacity="0.15" stroke-opacity="0.8"/><rect x="15.7" y="15.5" width="5.8" height="6" rx="2" fill="currentColor" fill-opacity="0.15" stroke-opacity="0.8"/>' },
    ] },
];

const recent = [
    { f: 'COT-0088', c: 'Estudio Brava', a: 'MXN 24,500.00', s: [t('Borrador', 'Draft'), 'gray'], d: t('Hoy, 12:10', 'Today, 12:10') },
    { f: 'COT-0087', c: 'Finmarket Inc.', a: 'USD 14,400.00', s: [t('Pagada', 'Paid'), 'green2'], d: t('Hoy, 11:42', 'Today, 11:42') },
    { f: 'COT-0086', c: 'Rutas Logísticas', a: 'MXN 86,000.00', s: [t('Vista', 'Viewed'), 'violet'], d: t('Hoy, 11:14', 'Today, 11:14') },
    { f: 'COT-0085', c: 'Clínica Aurora', a: 'USD 3,600.00', s: [t('Aprobada', 'Approved'), 'green'], d: t('Ayer, 17:05', 'Yesterday, 17:05') },
    { f: 'COT-0084', c: 'Estudio Brava', a: 'MXN 24,500.00', s: [t('Enviada', 'Sent'), 'blue'], d: t('Ayer, 12:30', 'Yesterday, 12:30') },
    { f: 'COT-0083', c: 'Altamar Seguros', a: 'MXN 58,000.00', s: [t('Facturada', 'Invoiced'), 'navy'], d: t('15 sep', 'Sep 15') },
];
const feed = [
    { k: 'paid', tx: t('Pago recibido; cotización saldada', 'Payment received; quote settled'), r: 'COT-0087 · Finmarket Inc.', w: t('hace 12 min', '12 min ago') },
    { k: 'viewed', tx: t('Abierta por el cliente desde el link', 'Opened by the client from the link'), r: 'COT-0086 · Rutas Logísticas', w: t('hace 40 min', '40 min ago') },
    { k: 'approved', tx: t('Firmado digitalmente por “Dra. Paula Lozano”', 'Digitally signed by “Dr. Paula Lozano”'), r: 'COT-0085 · Clínica Aurora', w: t('ayer 17:05', 'yesterday 17:05') },
    { k: 'sent', tx: t('Cotización enviada — link generado', 'Quote sent — link created'), r: 'COT-0084 · Estudio Brava', w: t('ayer 12:30', 'yesterday 12:30') },
    { k: 'invoiced', tx: t('Factura FAC-0043 emitida', 'Invoice FAC-0043 issued'), r: 'COT-0083 · Altamar Seguros', w: t('15 sep', 'Sep 15') },
];
const bars = [38, 46, 41, 58, 64, 88];
const months = isEn ? ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep'] : ['abr', 'may', 'jun', 'jul', 'ago', 'sep'];
---

<div class="sd stp-root" aria-hidden="true">
    <aside class="sd-side">
        <div class="sd-org">
            <span class="sd-org-av">N</span>
            <span class="sd-2l"><b>Nodo Labs</b><small>{t('Plan Starter', 'Starter plan')}</small></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg>
        </div>
        {nav.map((grp) => (
            <div class="sd-grp">
                {grp.g && <div class="sd-grp-l">{grp.g}</div>}
                {grp.items.map((it) => (
                    <div class:list={['sd-item', { on: it.on }]}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={it.ic}></svg>
                        <span>{it.l}</span>
                    </div>
                ))}
            </div>
        ))}
        <div class="sd-user">
            <span class="sd-av">MS</span>
            <span class="sd-2l"><b>Mariana Soto</b><small>mariana@nodolabs.io</small></span>
        </div>
    </aside>

    <div class="sd-main">
        <header class="sd-top">
            <h3>{t('Inicio', 'Home')}</h3>
            <div class="sd-top-r">
                <span class="sd-range">{t('Este mes', 'This month')}</span>
                <span class="sd-new">+ {t('Nueva cotización', 'New quote')}</span>
            </div>
        </header>

        <div class="sd-body">
            <div class="sd-row1">
                <section class="sd-card sd-hero stp-in">
                    <div class="sd-hero-top">
                        <div>
                            <div class="sd-lbl">{t('Cerrado este mes', 'Closed this month')}</div>
                            <div class="sd-big">MXN 312,840</div>
                            <div class="sd-delta"><b>+18%</b> {t('vs. periodo anterior', 'vs. previous period')}</div>
                        </div>
                        <div class="sd-bars">
                            {bars.map((h, i) => (
                                <div class="sd-bar-c"><i class:list={[{ on: i === bars.length - 1 }]} style={`height:${h}%`}></i><span>{months[i]}</span></div>
                            ))}
                        </div>
                    </div>
                    <div class="sd-metrics">
                        <div><span>{t('Cerrado', 'Closed')}</span><b>MXN 312,840</b></div>
                        <div><span>{t('Cobrado', 'Collected')}</span><b>MXN 268,400</b></div>
                        <div><span>{t('Cotizado', 'Quoted')}</span><b>MXN 486,900</b></div>
                    </div>
                </section>
                <div class="sd-kpis">
                    <section class="sd-card sd-kpi stp-in"><div class="sd-eb">{t('POR CERRAR', 'IN PROGRESS')}</div><b>MXN 110,500</b><small>{t('2 cotizaciones activas', '2 active quotes')}</small></section>
                    <section class="sd-card sd-kpi stp-in"><div class="sd-eb">{t('TASA DE CIERRE', 'CLOSE RATE')}</div><b>64%</b><small>{t('últimos 90 días', 'last 90 days')}</small></section>
                    <section class="sd-card sd-kpi stp-in"><div class="sd-eb">{t('POR DAR SEGUIMIENTO', 'NEEDS FOLLOW-UP')}</div><b>1</b><small>{t('cotización vista, sin responder', 'quote viewed, no reply')}</small></section>
                </div>
            </div>

            <div class="sd-row2">
                <section class="sd-card sd-recent stp-in">
                    <div class="sd-card-h"><b>{t('Recientes', 'Recent')}</b><span>{t('Ver todas →', 'View all →')}</span></div>
                    {recent.map((q) => (
                        <div class="sd-tr">
                            <span class="sd-folio">{q.f}</span>
                            <span class="sd-cli">{q.c}</span>
                            <span class="sd-amt">{q.a}</span>
                            <span><span class={`sd-pill sd-${q.s[1]}`}>{q.s[0]}</span></span>
                            <span class="sd-date">{q.d}</span>
                        </div>
                    ))}
                </section>
                <section class="sd-card sd-feed stp-in">
                    <div class="sd-card-h"><b>{t('Actividad', 'Activity')}</b></div>
                    {feed.map((e) => (
                        <div class="sd-ev">
                            <i class={`sd-ev-dot sd-d-${e.k}`}></i>
                            <span class="sd-2l"><b>{e.tx}</b><small>{e.r}</small></span>
                            <span class="sd-when">{e.w}</span>
                        </div>
                    ))}
                </section>
            </div>
        </div>
    </div>
</div>

<style>
    .sd { --ink: #0a192f; --mut: #64748b; --faint: #94a3b8; --line: #eef1f5; display: flex; background: #f5f5f7; border-radius: 20px; overflow: hidden; text-align: left; color: var(--ink); font-family: var(--font-sans, 'Inter', system-ui, sans-serif); font-size: 13px; line-height: 1.35;
        border: 1px solid rgba(10,25,47,0.07); box-shadow: 0 2px 4px rgba(10,25,47,0.04), 0 40px 90px -36px rgba(10,25,47,0.3); -webkit-font-smoothing: antialiased; }
    .sd * { box-sizing: border-box; }
    .sd-2l { display: flex; flex-direction: column; min-width: 0; }
    .sd-2l b { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sd-2l small { font-size: 11px; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .sd-side { width: 220px; flex-shrink: 0; padding: 14px 10px; display: flex; flex-direction: column; gap: 4px; background: rgba(255,255,255,0.72); border-right: 1px solid rgba(10,25,47,0.06); }
    .sd-org { display: flex; align-items: center; gap: 9px; padding: 6px 8px 12px; }
    .sd-org > svg { width: 14px; height: 14px; color: var(--faint); margin-left: auto; flex-shrink: 0; }
    .sd-org-av { width: 30px; height: 30px; border-radius: 9px; background: #0a192f; color: #fff; font-weight: 800; font-size: 13px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .sd-org b { font-size: 13px; }
    .sd-grp { display: flex; flex-direction: column; gap: 1px; }
    .sd-grp-l { font-size: 11px; font-weight: 600; color: var(--faint); padding: 12px 11px 5px; }
    .sd-item { display: flex; align-items: center; gap: 10px; padding: 8px 11px; border-radius: 10px; font-size: 13px; font-weight: 500; color: #334155; }
    .sd-item svg { width: 17px; height: 17px; flex-shrink: 0; color: #475569; }
    .sd-item.on { background: rgba(10,25,47,0.07); color: var(--ink); font-weight: 600; }
    .sd-item.on svg { color: var(--ink); }
    .sd-user { margin-top: auto; display: flex; align-items: center; gap: 9px; padding: 10px 8px 2px; border-top: 1px solid rgba(10,25,47,0.06); }
    .sd-av { width: 28px; height: 28px; border-radius: 50%; background: #334155; color: #fff; font-size: 10.5px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .sd-user b { font-size: 12.5px; }

    .sd-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .sd-top { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px 4px; }
    .sd-top h3 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.03em; }
    .sd-top-r { display: flex; gap: 8px; align-items: center; }
    .sd-range { font-size: 12px; font-weight: 600; color: #334155; background: #fff; padding: 6px 12px; border-radius: 99px; box-shadow: 0 0 0 1px rgba(10,25,47,0.08); }
    .sd-new { font-size: 12px; font-weight: 600; color: #fff; background: #0a192f; padding: 7px 14px; border-radius: 99px; }
    .sd-body { padding: 14px 24px 24px; display: flex; flex-direction: column; gap: 14px; }
    .sd-card { background: #fff; border-radius: 16px; box-shadow: 0 0 0 1px rgba(10,25,47,0.05), 0 6px 18px -12px rgba(10,25,47,0.18); }
    .sd-row1 { display: grid; grid-template-columns: 1.55fr 1fr; gap: 14px; }
    .sd-hero { padding: 18px 20px; display: flex; flex-direction: column; justify-content: space-between; gap: 16px; }
    .sd-hero-top { display: flex; justify-content: space-between; gap: 20px; }
    .sd-lbl { font-size: 12.5px; font-weight: 600; color: var(--mut); }
    .sd-big { white-space: nowrap; font-size: 32px; font-weight: 650; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; margin: 4px 0 2px; }
    .sd-delta { font-size: 12px; color: var(--mut); }
    .sd-delta b { color: #047857; font-weight: 650; }
    .sd-bars { display: flex; align-items: flex-end; gap: 8px; height: 96px; flex: 0 1 220px; min-width: 0; }
    .sd-bar-c { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 5px; }
    .sd-bar-c i { width: 100%; background: #e2e8f0; border-radius: 5px 5px 2px 2px; display: block; }
    .sd-bar-c i.on { background: #0a192f; }
    .sd-bar-c span { font-size: 10px; color: var(--faint); }
    .sd-metrics { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); padding-top: 12px; }
    .sd-metrics div { display: flex; flex-direction: column; gap: 2px; }
    .sd-metrics div + div { padding-left: 14px; border-left: 1px solid var(--line); }
    .sd-metrics span { font-size: 11.5px; color: var(--mut); }
    .sd-metrics b { font-size: 14px; font-weight: 650; font-variant-numeric: tabular-nums; }
    .sd-kpis { display: grid; grid-template-rows: repeat(3, 1fr); gap: 10px; }
    .sd-kpi { padding: 11px 16px; display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto auto; column-gap: 12px; align-items: center; }
    .sd-eb { font-size: 10px; font-weight: 700; letter-spacing: 0.07em; color: var(--faint); }
    .sd-kpi b { grid-row: span 2; font-size: 19px; font-weight: 650; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; text-align: right; grid-column: 2; grid-row-start: 1; }
    .sd-kpi small { font-size: 11.5px; color: var(--mut); grid-column: 1; }

    .sd-row2 { display: grid; grid-template-columns: 1.55fr 1fr; gap: 14px; }
    .sd-card-h { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px 8px; }
    .sd-card-h b { font-size: 14px; font-weight: 650; }
    .sd-card-h span { font-size: 12px; color: #2563eb; font-weight: 600; }
    .sd-tr { display: grid; grid-template-columns: 74px 1fr 118px 84px 88px; align-items: center; gap: 10px; padding: 9px 18px; border-top: 1px solid #f3f5f8; font-size: 12.5px; }
    .sd-folio { font-weight: 650; color: #334155; font-variant-numeric: tabular-nums; font-size: 12px; }
    .sd-cli { font-weight: 550; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sd-amt { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
    .sd-date { text-align: right; color: var(--faint); font-size: 11.5px; white-space: nowrap; }
    .sd-pill { display: inline-flex; font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 99px; white-space: nowrap; }
    .sd-gray { color: #64748b; background: rgba(100,116,139,0.1); }
    .sd-blue { color: #2563eb; background: rgba(37,99,235,0.09); }
    .sd-violet { color: #7c3aed; background: rgba(124,58,237,0.09); }
    .sd-green { color: #047857; background: rgba(16,185,129,0.11); }
    .sd-green2 { color: #047857; background: rgba(16,185,129,0.16); }
    .sd-navy { color: #0a192f; background: rgba(10,25,47,0.08); }
    .sd-ev { display: flex; align-items: flex-start; gap: 10px; padding: 9px 18px; border-top: 1px solid #f3f5f8; }
    .sd-ev .sd-2l { flex: 1; }
    .sd-ev .sd-2l b { font-size: 12.5px; font-weight: 550; }
    .sd-ev-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
    .sd-d-paid, .sd-d-approved { background: #059669; }
    .sd-d-viewed { background: #7c3aed; }
    .sd-d-sent { background: #2563eb; }
    .sd-d-invoiced { background: #0a192f; }
    .sd-when { font-size: 11px; color: var(--faint); white-space: nowrap; }

    @media (max-width: 992px) {
        .sd-side { display: none; }
        .sd-row1, .sd-row2 { grid-template-columns: minmax(0, 1fr); }
        .sd-card { min-width: 0; }
    }
    @media (max-width: 600px) {
        .sd-top { padding: 14px 16px 2px; }
        .sd-top-r .sd-new { display: none; }
        .sd-body { padding: 12px 14px 16px; gap: 12px; }
        .sd-hero-top { flex-direction: column; gap: 12px; }
        .sd-bars { flex-basis: auto; height: 72px; }
        .sd-big { font-size: 27px; }
        .sd-metrics b { font-size: 11.5px; white-space: nowrap; }
        .sd-ev .sd-2l b { white-space: normal; }
        .sd-metrics div + div { padding-left: 10px; }
        .sd-tr { grid-template-columns: 1fr auto; row-gap: 3px; padding: 10px 16px; }
        .sd-tr .sd-folio { grid-column: 1; }
        .sd-tr .sd-cli { grid-column: 1; }
        .sd-tr .sd-amt { grid-column: 2; grid-row: 1; }
        .sd-tr > span:nth-child(4) { grid-column: 2; grid-row: 2; text-align: right; }
        .sd-tr .sd-date { display: none; }
        .sd-ev { padding: 9px 16px; }
    }
</style>
