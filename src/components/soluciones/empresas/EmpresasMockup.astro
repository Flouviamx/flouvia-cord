---
// Calcas de pantallas reales de Cord para /soluciones/empresas (org demo: Distribuidora Centauro).
interface Props {
    scene: 'aprobaciones' | 'integraciones' | 'equipo' | 'cotizacion' | 'webhooks' | 'sso' | 'cobranza' | 'desempeno' | 'divisas' | 'evidencia' | 'headers';
    variant?: 'pillar' | 'block' | 'split' | 'dark';
    isEn?: boolean;
}
const { scene, variant = 'block', isEn = false } = Astro.props;
const T = (es: string, en: string) => (isEn ? en : es);
const loc = isEn ? 'en-US' : 'es-MX';
const cur = (n: number, c = 'MXN', d = 2) =>
    new Intl.NumberFormat(loc, { style: 'currency', currency: c, minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
const mxn = (n: number, d = 2) => cur(n, 'MXN', d);
const mxnT = (n: number, d = 2) => (isEn ? mxn(n, d) : `${mxn(n, d)} MXN`);
const num = (n: number) => new Intl.NumberFormat(loc).format(n);
const fav = (d: string) => `https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=http://${d}&size=128`;

const LINES = [
    { d: T('Varilla corrugada 3/8 in', 'Rebar 3/8 in'), u: T('ton', 'ton'), q: 42, list: 21400, neg: 17548 },
    { d: T('Cemento gris 50 kg', 'Grey cement 50 kg'), u: T('saco', 'bag'), q: 1200, list: 238, neg: 219 },
    { d: T('Malla electrosoldada 6x6', 'Welded wire mesh 6x6'), u: T('rollo', 'roll'), q: 30, list: 2150, neg: 1978 },
    { d: T('Flete a obra', 'Freight to site'), u: T('servicio', 'service'), q: 1, list: 9809.52, neg: null as number | null },
];
const SUB = LINES.reduce((s, l) => s + l.q * (l.neg ?? l.list), 0);
const IVA = Math.round(SUB * 0.16 * 100) / 100;
const TOTAL = SUB + IVA;

const MEMBERS = [
    { i: 'LM', n: 'Laura Méndez', e: 'laura.mendez@centauro.mx', r: T('Administrador', 'Admin'), k: 'admin', a: T('Última sesión hoy', 'Last seen today') },
    { i: 'DR', n: 'Diego Ruiz', e: 'diego.ruiz@centauro.mx', r: T('Vendedor', 'Rep'), k: 'vendedor', a: T('Última sesión hace 1 h', 'Last seen 1h ago') },
    { i: 'SG', n: 'Sofía Garza', e: 'sofia.garza@centauro.mx', r: T('Solo lectura', 'Read only'), k: 'lectura', a: T('Última sesión ayer', 'Last seen yesterday') },
];
const PERMS = [
    { l: T('Cotizaciones', 'Quotes'), on: true },
    { l: T('Clientes', 'Clients'), on: true },
    { l: T('Productos', 'Products'), on: true },
    { l: T('Informes', 'Reports'), on: true },
    { l: T('Aprobaciones', 'Approvals'), on: false },
    { l: T('Cobranza', 'Collections'), on: false },
];

const DELIVERIES = [
    { ev: 'invoice.sent', try: 2, ok: false, st: '503', ms: '4,812', at: '11:26' },
    { ev: 'invoice.issued', try: 1, ok: true, st: '200', ms: '184', at: '11:14' },
    { ev: 'quote.approved', try: 1, ok: true, st: '200', ms: '131', at: '11:09' },
    { ev: 'quote.sent', try: 1, ok: true, st: '200', ms: '118', at: '11:02' },
    { ev: 'quote.approval_decided', try: 1, ok: true, st: '200', ms: '96', at: '11:02' },
    { ev: 'quote.approval_requested', try: 1, ok: true, st: '200', ms: '102', at: '10:47' },
    { ev: 'quote.created', try: 1, ok: true, st: '200', ms: '88', at: '10:46' },
];

const AR = [
    { c: 'Constructora Albarrada', f: 'FAC-1187', v: T('18 sep 2026', 'Sep 18, 2026'), over: 12, due: 0, prom: T('Promete 3 oct', 'Promises Oct 3'), s: 318400 },
    { c: 'Hospitales Vértice', f: 'FAC-1179', v: T('30 ago 2026', 'Aug 30, 2026'), over: 31, due: 0, prom: '', s: 96250 },
    { c: 'Inmobiliaria Cumbres', f: 'COT-2291', v: T('7 oct 2026', 'Oct 7, 2026'), over: 0, due: 7, prom: '', s: 512800 },
    { c: 'Grupo Ferretero Anáhuac', f: 'FAC-1192', v: T('14 oct 2026', 'Oct 14, 2026'), over: 0, due: 14, prom: '', s: 184300 },
    { c: 'Desarrollos Tamarindo', f: 'FAC-1195', v: T('21 oct 2026', 'Oct 21, 2026'), over: 0, due: 21, prom: '', s: 76900 },
];
const AR_TOTAL = AR.reduce((s, r) => s + r.s, 0);
const AR_OVER = AR.filter((r) => r.over).reduce((s, r) => s + r.s, 0);
const AGING = [
    { l: T('Por vencer', 'Not yet due'), v: AR.filter((r) => !r.over).reduce((s, r) => s + r.s, 0), c: '#cbd5e1' },
    { l: T('1–30 días', '1–30 days'), v: 318400, c: '#64748b' },
    { l: T('31–60 días', '31–60 days'), v: 96250, c: '#0a192f' },
];

const REPS = [
    { i: 'DR', n: 'Diego Ruiz', role: '', q: 42, rate: 38, won: 4120000, paid: 3260000, days: 18 },
    { i: 'MO', n: 'Mariana Olvera', role: '', q: 35, rate: 31, won: 2870000, paid: 2410000, days: 22 },
    { i: 'AP', n: 'Andrés Pineda', role: '', q: 28, rate: 29, won: 1960000, paid: 1380000, days: 26 },
    { i: 'LM', n: 'Laura Méndez', role: T('Administrador', 'Admin'), q: 9, rate: 44, won: 1180000, paid: 1180000, days: 12 },
];
const REP_MAX = Math.max(...REPS.map((r) => r.won));
const REP_TOTAL = REPS.reduce((s, r) => s + r.won, 0);
const REP_RATE = Math.round(REPS.reduce((s, r) => s + r.rate, 0) / REPS.length);
const ticket = (r: (typeof REPS)[number]) => Math.round(r.won / Math.max(1, Math.round((r.q * r.rate) / 100)));

const INV = [
    { d: T('Varilla corrugada 1/2 in', 'Rebar 1/2 in'), q: 60, p: 1080 },
    { d: T('Malla electrosoldada 6x6', 'Welded wire mesh 6x6'), q: 120, p: 118 },
    { d: T('Flete Laredo, TX', 'Freight to Laredo, TX'), q: 1, p: 2400 },
];
const INV_TOTAL = INV.reduce((s, l) => s + l.q * l.p, 0);
const FX = 17.92;

const AUDIT = [
    { a: 'cotizacion.aprobacion_aprobada', d: 'COT-2318', m: T('hace 3 min', '3 min ago'), ip: '189.203.44.10' },
    { a: 'cotizacion.aprobacion_rechazada', d: 'COT-2309', m: T('hace 1 h', '1 h ago'), ip: '189.203.44.10' },
    { a: 'sso.exigir_activado', d: 'Okta · Distribuidora Centauro', m: T('hace 2 h', '2 h ago'), ip: '189.203.44.10' },
    { a: 'sso.dominio_verificado', d: 'centauro.mx', m: T('hace 2 h', '2 h ago'), ip: '189.203.44.10' },
    { a: 'equipo.actualizado', d: 'diego.ruiz@centauro.mx', m: T('ayer', 'yesterday'), ip: '187.190.12.63' },
    { a: 'webhook.secreto_rotado', d: 'api.centauro.mx', m: T('ayer', 'yesterday'), ip: '187.190.12.63' },
    { a: 'equipo.invitado', d: 'sofia.garza@centauro.mx', m: T('hace 3 días', '3 days ago'), ip: '189.203.44.10' },
    { a: 'apikey.creada', d: T('Producción', 'Production'), m: T('hace 5 días', '5 days ago'), ip: '189.203.44.10' },
];
const HASH = '9f3c7a1e5b20d84c6f19e0a2b7d35c418e6f0b92d47a1c35e8b06f2d9a41e21a';
import { iconInner } from '../../../lib/icons';
---

<div class:list={['emk-stage', `emk-v-${variant}`, `emk-s-${scene}`]} data-emk aria-hidden="true">
    <div class="emk-canvas">

    {scene === 'aprobaciones' && (
        <>
        <div class="emk-win">
            <div class="emk-bar">
                <span class="emk-crumb">{T('Ajustes', 'Settings')}<i>/</i><b>{T('Aprobaciones y tesorería', 'Approvals and treasury')}</b></span>
                <span class="emk-btn emk-btn-navy">{T('Guardar cambios', 'Save changes')}</span>
            </div>
            <div class="emk-body">
                <div class="emk-h" data-emk-r>{T('Umbrales de aprobación', 'Approval thresholds')}</div>
                <div class="emk-fields">
                    <div class="emk-field" data-emk-r>
                        <label>{T('Descuento máx. sin aprobación (%)', 'Max discount without approval (%)')}</label>
                        <span class="emk-input editorial">12</span>
                        <small>{T('Por encima, "Enviar" pide aprobación.', 'Above it, "Send" requires approval.')}</small>
                    </div>
                    <div class="emk-field" data-emk-r>
                        <label>{T('Monto máx. sin aprobación (MXN)', 'Max amount without approval (MXN)')}</label>
                        <span class="emk-input editorial">1,000,000</span>
                        <small>{T('0 = sin tope.', '0 = no limit.')}</small>
                    </div>
                    <div class="emk-field" data-emk-r>
                        <label>{T('Margen bruto mínimo sin aprobación (%)', 'Minimum gross margin without approval (%)')}</label>
                        <span class="emk-input editorial">25</span>
                        <small>{T('Si alguna línea baja de este margen, se bloquea.', 'If any line falls below it, the quote is held.')}</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="emk-float emk-f-queue" data-emk-f>
            <div class="emk-q-head">
                <span class="emk-q-n editorial">1</span>
                <span>{T('esperan tu aprobación', 'awaiting your approval')}</span>
            </div>
            <div class="emk-q-row">
                <span class="emk-q-c">Constructora Albarrada</span>
                <span class="emk-q-meta"><span class="emk-mono">COT-2318</span><b class="editorial">{mxn(TOTAL, 0)}</b></span>
            </div>
        </div>
        </>
    )}

    {scene === 'integraciones' && (
        <div class="emk-win">
            <div class="emk-bar">
                <span class="emk-crumb">{T('Ajustes', 'Settings')}<i>/</i><b>{T('Integraciones', 'Integrations')}</b></span>
                <span class="emk-muted">{T('4 conectadas', '4 connected')}</span>
            </div>
            <div class="emk-body">
                <div class="emk-h emk-h-muted" data-emk-r>{T('Conectadas', 'Connected')}</div>
                <div class="emk-tiles">
                    {[
                        { n: 'HubSpot', d: 'hubspot.com', c: 'CRM', t: T('Clientes, contactos y Deals sincronizados con tus cotizaciones.', 'Clients, contacts and Deals synced with your quotes.') },
                        { n: 'Xero', d: 'xero.com', c: T('Contabilidad', 'Accounting'), t: T('Tus facturas de Cord, en borrador dentro de tu Xero.', 'Your Cord invoices, as drafts inside your Xero.') },
                        { n: 'Slack', d: 'slack.com', c: T('Comunicación', 'Messaging'), t: T('Un aviso en tu canal cada vez que una cotización avanza.', 'An alert in your channel every time a quote moves forward.') },
                        { n: 'Microsoft Teams', d: 'teams.microsoft.com', c: T('Comunicación', 'Messaging'), t: T('Una tarjeta en tu canal de Teams cada vez que una cotización avanza.', 'A card in your Teams channel every time a quote moves forward.') },
                    ].map((a) => (
                        <div class="emk-tile" data-emk-r>
                            <span class="emk-tile-top">
                                <img src={fav(a.d)} alt="" width="26" height="26" loading="lazy" />
                                <span class="emk-pill emk-ok"><i></i>{T('Conectado', 'Connected')}</span>
                            </span>
                            <b>{a.n}</b>
                            <small>{a.c}</small>
                            <p>{a.t}</p>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    )}

    {scene === 'equipo' && (
        <>
        <div class="emk-win">
            <div class="emk-bar">
                <span class="emk-crumb">{T('Ajustes', 'Settings')}<i>/</i><b>{T('Equipo y permisos', 'Team and permissions')}</b></span>
                <span class="emk-btn emk-btn-navy">{T('Agregar miembro', 'Add member')}</span>
            </div>
            <div class="emk-body emk-body-flush">
                <div class="emk-seats" data-emk-r>
                    <b class="editorial">{T('3 de 15 asientos', '3 of 15 seats')}</b>
                    <span class="emk-seatbar"><i style="width:20%"></i></span>
                </div>
                <div class="emk-thead emk-g-team"><span>{T('Miembro · rol', 'Member · role')}</span></div>
                {MEMBERS.map((m) => (
                    <div class="emk-tr emk-g-team" data-emk-r>
                        <span class="emk-who">
                            <span class="emk-av">{m.i}</span>
                            <span><b class="emk-name-role">{m.n}<span class:list={['emk-role', `emk-role-${m.k}`]}>{m.r}</span></b><small>{m.e}</small></span>
                        </span>
                    </div>
                ))}
            </div>
        </div>
        <div class="emk-float emk-f-perms" data-emk-f>
            <div class="emk-fp-head"><span class="emk-av emk-av-sm">DR</span><span><b>Diego Ruiz</b><small>{T('Vendedor', 'Rep')}</small></span></div>
            <ul>
                {PERMS.map((p) => (
                    <li class:list={{ off: !p.on }}>
                        {p.on
                            ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('check-circle')}></svg>
                            : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('minus-circle')}></svg>}
                        {p.l}
                    </li>
                ))}
            </ul>
        </div>
        </>
    )}

    {scene === 'cotizacion' && (
        <div class="emk-win">
            <div class="emk-bar">
                <span class="emk-crumb">{T('Cotizaciones', 'Quotes')}<i>/</i><b>COT-2318</b></span>
                <span class="emk-pill emk-muted-pill">{T('Borrador', 'Draft')}</span>
            </div>
            <div class="emk-body">
                <div class="emk-approval" data-emk-r>
                    <div class="emk-ap-info">
                        <span class="emk-ap-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('clock')}></svg>
                            {T('Pendiente de aprobación', 'Pending approval')}
                        </span>
                        <span class="emk-ap-why">{T(
                            `descuento 18% supera el 12% permitido y total ${mxnT(1240000, 0)} supera el tope de ${mxnT(1000000, 0)}`,
                            `discount 18% exceeds the 12% allowed and total ${mxn(1240000, 0)} exceeds the ${mxn(1000000, 0)} limit`,
                        )}</span>
                    </div>
                    <span class="emk-ap-actions">
                        <span class="emk-btn emk-btn-navy">{T('Aprobar y enviar', 'Approve and send')}</span>
                        <span class="emk-btn">{T('Rechazar', 'Reject')}</span>
                    </span>
                </div>
                <div class="emk-qhead" data-emk-r>
                    <span class="emk-who">
                        <span class="emk-av emk-av-lg">C</span>
                        <span><b>Constructora Albarrada <em class="emk-ver">V1</em></b><small>{T('Net 30 · Vigente hasta 14 oct 2026 · Creada 14 sep 2026', 'Net 30 · Valid until Oct 14, 2026 · Created Sep 14, 2026')}</small></span>
                    </span>
                    <span class="emk-qtotal"><small>TOTAL</small><b class="editorial">{mxnT(TOTAL)}</b></span>
                </div>
                <div class="emk-thead emk-g-items"><span>{T('Producto', 'Product')}</span><span class="r">{T('Cant.', 'Qty.')}</span><span class="r">{T('Precio', 'Price')}</span><span class="r">{T('Importe', 'Amount')}</span></div>
                {LINES.map((l) => (
                    <div class="emk-tr emk-g-items" data-emk-r>
                        <span class="emk-item"><b>{l.d}</b><small>{l.u}</small></span>
                        <span class="r editorial emk-dim">{num(l.q)}</span>
                        <span class="r emk-price">
                            {l.neg !== null && <s class="editorial">{mxn(l.list)}</s>}
                            <b class="editorial">{mxn(l.neg ?? l.list)}</b>
                        </span>
                        <span class="r editorial emk-amt">{mxn(l.q * (l.neg ?? l.list))}</span>
                    </div>
                ))}
                <div class="emk-totals" data-emk-r>
                    <div><span>Subtotal</span><b class="editorial">{mxn(SUB)}</b></div>
                    <div><span>{T('IVA 16%', 'VAT 16%')}</span><b class="editorial">{mxn(IVA)}</b></div>
                    <div class="grand"><span>Total</span><b class="editorial">{mxn(TOTAL)}</b></div>
                </div>
            </div>
        </div>
    )}

    {scene === 'webhooks' && (
        <div class="emk-win">
            <div class="emk-bar">
                <span class="emk-tabs">
                    <span>{T('Resumen', 'Overview')}</span><span class="on">Webhooks</span><span>API</span><span>{T('Registros', 'Logs')}</span><span>{T('Eventos', 'Events')}</span><span>{T('Salud', 'Health')}</span>
                </span>
                <span class="emk-pill emk-navy-pill">{T('Producción', 'Live')}</span>
            </div>
            <div class="emk-body emk-body-flush">
                <div class="emk-hook" data-emk-r>
                    <span class="emk-hook-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconInner('chevron-down')}></svg></span>
                    <span class="emk-hook-info">
                        <b class="emk-mono">https://api.centauro.mx/cord/webhooks</b>
                        <small><code>whsec_8c1f2a••••••••••••••</code> <i>{T('· 6 eventos', '· 6 events')}</i> <i class="err">{T('· última hace 2 min (503)', '· last 2 min ago (503)')}</i></small>
                    </span>
                    <span class="emk-btn">{T('Probar', 'Test')}</span>
                    <span class="emk-btn">{T('Editar', 'Edit')}</span>
                    <span class="emk-toggle on"></span>
                </div>
                <div class="emk-dels">
                    {DELIVERIES.map((x) => (
                        <div class="emk-del" data-emk-r>
                            <span class:list={['emk-dot', x.ok ? 'ok' : 'err']}></span>
                            <span class="emk-mono emk-del-ev">{x.ev}{x.try > 1 && <em>{T(` · intento ${x.try}`, ` · attempt ${x.try}`)}</em>}</span>
                            <span class:list={['emk-code', x.ok ? 'ok' : 'err']}>{x.st}</span>
                            <span class="emk-del-meta editorial">{x.ms}ms · {x.at}</span>
                            <span class:list={['emk-link', { strong: !x.ok }]}>{T('Reintentar', 'Retry')}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    )}

    {scene === 'sso' && (
        <>
        <div class="emk-win">
            <div class="emk-bar">
                <span class="emk-crumb">{T('Ajustes', 'Settings')}<i>/</i><b>SSO</b></span>
                <span class="emk-btn emk-btn-navy">{T('Conectar proveedor', 'Connect provider')}</span>
            </div>
            <div class="emk-body">
                <div class="emk-h" data-emk-r>{T('Conexiones', 'Connections')}</div>
                <div class="emk-conn" data-emk-r>
                    <img src={fav('okta.com')} alt="" width="30" height="30" loading="lazy" />
                    <span><b>Okta · Distribuidora Centauro</b><small class="emk-mono">http://www.okta.com/exk9c3ntaur0mx</small></span>
                    <span class="emk-pill emk-ok"><i></i>{T('Activa', 'Active')}</span>
                </div>
                <div class="emk-h" data-emk-r>{T('Dominios verificados', 'Verified domains')}</div>
                {['centauro.mx', 'centauro.com.mx'].map((d) => (
                    <div class="emk-dom" data-emk-r>
                        <span class="emk-mono">{d}</span>
                        <span class="emk-pill emk-ok"><i></i>{T('Verificado', 'Verified')}</span>
                    </div>
                ))}
                <div class="emk-h emk-h-gap" data-emk-r>{T('Exigir SSO', 'Require SSO')}</div>
                <div class="emk-switch" data-emk-r>
                    <span class="emk-toggle on"></span>
                    <span><b>{T('Exigir a tu equipo iniciar sesión por SSO', 'Require your team to sign in via SSO')}</b><small>{T('Bloquea contraseña, Google, Apple y llaves de acceso para todos menos el dueño de la cuenta, que conserva su contraseña como respaldo.', 'Blocks password, Google, Apple and passkeys for everyone except the account owner, who keeps their password as a fallback.')}</small></span>
                </div>
            </div>
        </div>
        <div class="emk-float emk-f-sec" data-emk-f>
            <div class="emk-fs-title">{T('Seguridad', 'Security')}</div>
            <div class="emk-switch emk-switch-sm">
                <span class="emk-toggle on"></span>
                <span><b>{T('Exigir verificación en dos pasos (2FA)', 'Require two-factor authentication (2FA)')}</b></span>
            </div>
            <div class="emk-fs-kv"><span>{T('Cierre por inactividad', 'Inactivity timeout')}</span><span class="emk-select">{T('8 horas', '8 hours')}</span></div>
            <div class="emk-fs-kv"><span>{T('Dominios de invitación', 'Invitation domains')}</span><span class="emk-select emk-mono">centauro.mx</span></div>
        </div>
        </>
    )}

    {scene === 'cobranza' && (
        <div class="emk-win">
            <div class="emk-bar">
                <span class="emk-tabs"><span class="on">{T('Cobranza', 'Collections')}</span><span>{T('Agente IA', 'AI agent')}</span></span>
                <span class="emk-chip">{T('Al día de hoy · 30 de septiembre de 2026', 'As of today · September 30, 2026')}</span>
            </div>
            <div class="emk-body">
                <div class="emk-kpis emk-kpis-3" data-emk-r>
