<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
        document.querySelectorAll<HTMLElement>('[data-emk]').forEach((stage) => {
            const rows = stage.querySelectorAll<HTMLElement>('[data-emk-r]');
            const floats = stage.querySelectorAll<HTMLElement>('[data-emk-f]');
            if (!rows.length && !floats.length) return;
            gsap.set(rows, { opacity: 0, y: 8 });
            gsap.set(floats, { opacity: 0, y: 16 });
            ScrollTrigger.create({
                trigger: stage, start: 'top 82%', once: true,
                onEnter: () => {
                    gsap.to(rows, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', stagger: 0.05, clearProps: 'transform,opacity' });
                    gsap.to(floats, { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out', delay: 0.25 + rows.length * 0.04, clearProps: 'transform,opacity' });
                },
            });
        });
    }
