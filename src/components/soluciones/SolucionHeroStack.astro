                                            <span class="ehs-new">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                                {L('Nueva factura', 'New invoice')}
                                            </span>
                                        </span>
                                    </div>

                                    <div class="ehs-sum">
                                        <span><b class="editorial">{money(D.porCobrar)}<i class="ehs-cur">{cur}</i></b><small>{L('por cobrar', 'outstanding')}</small></span>
                                        <span class="ehs-sum-warn"><b class="editorial">{money(D.vencido)}<i class="ehs-cur">{cur}</i></b><small>{L('vencido', 'past due')} · {D.vencidas}</small></span>
                                        <span><b class="editorial">{money(D.cobradoMes)}<i class="ehs-cur">{cur}</i></b><small>{L('cobrado este mes', 'collected this month')}</small></span>
                                    </div>

                                    <div class="ehs-filters">
                                        {FILTROS.map((f, fi) => <span class:list={['ehs-fp', { on: fi === 0 }]}>{f}</span>)}
                                    </div>

                                    <div class="ehs-fth">
                                        <span class="ehs-chk"></span>
                                        <span>{L('Factura', 'Invoice')}</span><span>{L('Cliente', 'Client')}</span>
                                        <span class="ehs-r">Total</span><span class="ehs-r">{L('Saldo', 'Balance')}</span><span>{L('Estado', 'Status')}</span>
                                    </div>
                                    {D.fac.map((f) => {
                                        const meta = FAC_META[f.st];
                                        // Solo se selecciona una emitida, abierta y aún no enviada.
                                        const enviable = f.st === 'open' && !f.sent;
                                        return (
                                            <div class="ehs-ftr">
                                                <span class:list={['ehs-chk', { off: !enviable }]}></span>
                                                <span class="ehs-ffolio">
                                                    <strong>{f.num ?? L('Sin folio', 'No number')}</strong>
                                                    {!f.num && <small>{L('Borrador', 'Draft')} · {f.draft}</small>}
                                                </span>
                                                <span class="ehs-fcli"><i class="ehs-fav">{inicial(f.who)}</i><span>{f.who}</span></span>
                                                <span class="editorial ehs-r ehs-ftot">{money(f.total)}<i class="ehs-cur">{cur}</i></span>
                                                <span class="editorial ehs-r ehs-fsal">{f.saldo > 0 ? <Fragment>{money(f.saldo)}<i class="ehs-cur">{cur}</i></Fragment> : '–'}</span>
                                                <span class="ehs-fst">
                                                    <span class="ehs-status" style={`color:${meta.color};background:${meta.bg}`}>{meta.label}</span>
                                                    {f.sent && <small>{L('Enviada', 'Sent')}</small>}
                                                </span>
                                            </div>
                                        );
                                    })}
                                </div>
                            )}
                        </div>
                    )}
                </div>
                <div class="ehs-cap">
                    <h3>{c.title}</h3>
                    <a href={c.href} class="ehs-link">
                        <span>{L('Explorar', 'Explore')}</span>
                        <span class="ehs-link-ic" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </a>
                </div>
            </article>
        ))}
    </div>

    <div class="ehs-pager" role="group" aria-label={L('Capacidades destacadas', 'Featured capabilities')}>
        {cards.map((c, i) => (
            <button type="button" class="ehs-dot" data-ehs-dot={String(i)} aria-label={c.title} aria-current={i === 0 ? 'true' : undefined}>
                <i></i>
            </button>
        ))}
    </div>
</div>

<script>
    // 33% más rápido que la versión original (5.6 s): 5.6 / 1.33 ≈ 4.2 s.
    const INTERVAL = 4200;
    document.querySelectorAll<HTMLElement>('[data-ehs]').forEach((root) => {
        const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-ehs-card]'));
        const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ehs-dot]'));
        const n = cards.length;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let front = 0;
        let timer: number | undefined;
        let hovering = false;
        let visible = true;

        const paint = (leaving?: HTMLElement) => {
            cards.forEach((card, i) => {
                const pos = (i - front + n) % n;
                if (card === leaving) return;
                card.dataset.pos = String(pos);
                const isFront = pos === 0;
                card.toggleAttribute('inert', !isFront);
                if (isFront) card.removeAttribute('aria-hidden');
                else card.setAttribute('aria-hidden', 'true');
            });
            dots.forEach((d, i) => {
                if (i === front) d.setAttribute('aria-current', 'true');
                else d.removeAttribute('aria-current');
            });
            root.style.setProperty('--ehs-cycle', `${INTERVAL}ms`);
            root.classList.remove('ehs-tick');
            void root.offsetWidth; // reinicia la barra de progreso del dot activo
            if (!reduced) root.classList.add('ehs-tick');
        };

        const go = (next: number) => {
            if (next === front) return;
            const old = cards[front];
            const step = (((next - front) % n) + n) % n;
            const dir = step <= n / 2 ? 1 : -1;
            front = (next + n) % n;
            if (reduced) { paint(); return; }
            // La tarjeta que sale se desliza y se desvanece; luego vuelve al fondo.
            old.dataset.pos = 'out';
            old.setAttribute('inert', '');
            old.setAttribute('aria-hidden', 'true');
            paint(old);
            // El fondo del hero (RibbonHeroBg) escucha este evento y empuja la
            // tela en la dirección en que sale la tarjeta.
            window.dispatchEvent(new CustomEvent('cord:hero-shift', { detail: { dir } }));
            window.setTimeout(() => {
                old.dataset.pos = String((cards.indexOf(old) - front + n) % n);
            }, 320);
        };

        const schedule = () => {
            window.clearTimeout(timer);
            if (reduced || hovering || !visible) { root.classList.remove('ehs-tick'); return; }
            timer = window.setTimeout(() => { go(front + 1); schedule(); }, INTERVAL);
        };

        dots.forEach((d, i) => d.addEventListener('click', () => { go(i); paint(); schedule(); }));

        // Pausa al pasar el cursor (solo escritorio: en táctil no hay hover y
        // la rotación sigue). Pausa fuera de pantalla y con la pestaña oculta.
        if (window.matchMedia('(hover: hover)').matches) {
            root.addEventListener('mouseenter', () => { hovering = true; root.classList.add('ehs-paused'); schedule(); });
            root.addEventListener('mouseleave', () => { hovering = false; root.classList.remove('ehs-paused'); paint(); schedule(); });
        }
        new IntersectionObserver(([e]) => { visible = e.isIntersecting; schedule(); }, { threshold: 0.2 }).observe(root);
        document.addEventListener('visibilitychange', () => { visible = !document.hidden; schedule(); });

        paint();
        schedule();
    });
</script>

