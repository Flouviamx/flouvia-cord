---
// Stack de tarjetas de los heroes de /soluciones (clases ehs-*).
// Tres capacidades reales por variante, cada una con su calca de pantalla y su
// enlace a la página de producto. Rotan solas; con prefers-reduced-motion no
// rotan y el pager sigue funcionando. El HTML por defecto es el estado final.
interface Props { isEn?: boolean; variant?: 'empresas' | 'startups' }
const { isEn = false, variant = 'empresas' } = Astro.props;

const cur = isEn ? 'USD' : 'MXN';
const pre = isEn ? '/en' : '';
const L = (es: string, en: string) => (isEn ? en : es);

// Cifras por variante: un corporativo y una startup no facturan lo mismo, y un
// mockup con números fuera de escala delata que es de relleno.
const D = variant === 'startups'
    ? {
        bars: [12, 16, 15, 21, 19, 26, 31, 29, 38, 44, 52, 61],
        cobrado: L('$486,200', '$38,450'), growth: '+64%', dias: '9',
        rowA: { av: 'NL', c: '#8b5cf6', name: 'Nómada Labs', ref: 'FAC-0118', amt: L('$48,000', '$3,200') },
        rowB: { av: 'PV', c: '#0ea5a4', name: 'Pixel & Vela', ref: 'FAC-0117', amt: L('$22,500', '$1,450') },
        saldo: L('$134,900', '$9,870'), recordatorios: '41', abiertas: L('12 abiertas', '12 open'),
        fac: [
            { id: 'FAC-0121', who: 'Nómada Labs', amt: L('$48,000', '$3,200'), st: 'ok' },
            { id: 'FAC-0120', who: 'Estudio Brote', amt: L('$18,600', '$1,190'), st: 'info' },
            { id: 'FAC-0119', who: 'Kilo Studio', amt: L('$31,250', '$2,050'), st: 'late' },
            { id: 'FAC-0116', who: 'Ruta Norte', amt: L('$12,400', '$820'), st: 'pend' },
        ],
    }
    : {
        bars: [38, 44, 41, 52, 49, 58, 55, 63, 60, 71, 68, 82],
        cobrado: L('$4,290,777', '$2,429,777'), growth: '+18.4%', dias: '21',
        rowA: { av: 'GV', c: '#6366f1', name: 'Grupo Vértice', ref: 'FAC-2031', amt: L('$1,165,340', '$65,340') },
        rowB: { av: 'AN', c: '#0ea5a4', name: 'Aceros del Norte', ref: 'FAC-2029', amt: L('$389,940', '$18,902') },
        saldo: L('$2,771,810', '$318,204'), recordatorios: '126', abiertas: L('38 abiertas', '38 open'),
        fac: [
            { id: 'FAC-2034', who: 'Constructora Zarco', amt: L('$742,100', '$42,100'), st: 'ok' },
            { id: 'FAC-2033', who: 'Ferrex Industrial', amt: L('$196,880', '$9,880'), st: 'info' },
            { id: 'FAC-2030', who: 'Cementos Gama', amt: L('$508,415', '$27,415'), st: 'late' },
            { id: 'FAC-2028', who: 'Distribuidora Ámbar', amt: L('$261,060', '$14,060'), st: 'pend' },
        ],
    };
const FAC_ST: Record<string, string> = {
    ok: L('Pagada', 'Paid'), info: L('Vista', 'Viewed'), late: L('Vencida 5 d', '5 days late'), pend: L('Abono parcial', 'Partial'),
};

const cards = variant === 'startups'
    ? [
        { key: 'link', title: L('Propuesta aceptada y cobrada en el mismo link', 'Proposal accepted and paid in the same link'), href: `${pre}/producto/link-publico` },
        { key: 'cobros', title: L('Ingresos que ves entrar en vivo', 'Revenue you watch come in live'), href: `${pre}/producto/pagos` },
        { key: 'facturas', title: L('Facturas que se persiguen solas', 'Invoices that chase themselves'), href: `${pre}/producto/facturacion` },
    ]
    : [
        { key: 'cobros', title: L('Cobro en línea y conciliación', 'Online payments and reconciliation'), href: `${pre}/producto/pagos` },
        { key: 'margen', title: L('Márgenes y aprobaciones bajo control', 'Margins and approvals under control'), href: `${pre}/producto/aprobaciones` },
        { key: 'facturas', title: L('Facturación con cobranza automática', 'Invoicing with automatic collections'), href: `${pre}/producto/facturacion` },
    ];
---

<div class="ehs" data-ehs data-variant={variant}>
    <div class="ehs-stage">
        {cards.map((c, i) => (
            <article class="ehs-card" data-ehs-card data-pos={String(i)} aria-hidden={i === 0 ? undefined : 'true'} inert={i === 0 ? undefined : true}>
                <div class="ehs-shot">
                    {c.key === 'cobros' && (
                        <div class="ehs-panel">
                            <div class="ehs-bar">
                                <span class="ehs-crumb">{L('Cobros · Este trimestre', 'Payments · This quarter')}</span>
                                <span class="ehs-live"><i></i>{L('En vivo', 'Live')}</span>
                            </div>
                            <div class="ehs-kpis">
                                <div>
                                    <span class="ehs-lbl">{L('Cobrado', 'Collected')} <em class="ehs-up">{D.growth}</em></span>
                                    <b class="editorial">{D.cobrado} <small>{cur}</small></b>
                                </div>
                                <div>
                                    <span class="ehs-lbl">{L('Días promedio de cobro', 'Avg. days to pay')}</span>
                                    <b class="editorial">{D.dias} <small>{L('días', 'days')}</small></b>
                                </div>
                            </div>
                            <div class="ehs-chart" aria-hidden="true">
                                {D.bars.map((h) => (
                                    <span style={`--h:${h}%`}><i style={`height:${Math.round(h * 0.38)}%`}></i></span>
                                ))}
                            </div>
                            <div class="ehs-axis"><span>{L('1 jul', 'Jul 1')}</span><span>{L('Hoy', 'Today')}</span></div>
                            <div class="ehs-rows">
                                <div class="ehs-row">
                                    <span class="ehs-av" style={`--c:${D.rowA.c}`}>{D.rowA.av}</span>
                                    <span class="ehs-who"><b>{D.rowA.name}</b><small>{D.rowA.ref}</small></span>
                                    <span class="ehs-amt editorial">{D.rowA.amt}</span>
                                    <span class="ehs-pill ok">{L('Pagado', 'Paid')}</span>
                                </div>
                                <div class="ehs-row">
                                    <span class="ehs-av" style={`--c:${D.rowB.c}`}>{D.rowB.av}</span>
                                    <span class="ehs-who"><b>{D.rowB.name}</b><small>{D.rowB.ref}</small></span>
                                    <span class="ehs-amt editorial">{D.rowB.amt}</span>
                                    <span class="ehs-pill pend">{L('En tránsito', 'In transit')}</span>
                                </div>
                            </div>
                        </div>
                    )}
                    {c.key === 'margen' && (
                        <div class="ehs-panel">
                            <div class="ehs-bar">
                                <span class="ehs-crumb">COT-0149 · Grupo Vértice</span>
                                <span class="ehs-pill warn">{L('En aprobación', 'Pending approval')}</span>
                            </div>
                            <div class="ehs-kpis">
                                <div>
                                    <span class="ehs-lbl">Total</span>
                                    <b class="editorial">{L('$1,284,500', '$212,480')} <small>{cur}</small></b>
                                </div>
                                <div>
                                    <span class="ehs-lbl">{L('Margen', 'Margin')} <em class="ehs-down">{L('mín. 25%', 'min. 25%')}</em></span>
                                    <b class="editorial ehs-warn-num">23.4%</b>
                                </div>
                            </div>
                            <div class="ehs-table">
                                <div class="ehs-th"><span>{L('Concepto', 'Item')}</span><span>{L('Cant.', 'Qty')}</span><span>{L('Margen', 'Margin')}</span></div>
                                <div class="ehs-tr"><span>{L('Viga IPR 12"', 'Steel beam IPR 12"')}</span><span class="editorial">340</span><span class="editorial">27.1%</span></div>
                                <div class="ehs-tr"><span>{L('Lámina galvanizada cal. 18', 'Galvanized sheet cal. 18')}</span><span class="editorial">1,200</span><span class="editorial ehs-warn-num">19.8%</span></div>
                                <div class="ehs-tr"><span>{L('Flete e instalación', 'Freight and installation')}</span><span class="editorial">1</span><span class="editorial">31.0%</span></div>
                            </div>
                            <div class="ehs-approval">
                                <svg viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
                                <span><b>{L('Descuento de 18% excede tu límite de 12%', '18% discount exceeds your 12% limit')}</b><small>{L('Enviado a Finanzas · Laura Méndez', 'Routed to Finance · Laura Méndez')}</small></span>
                            </div>
                        </div>
                    )}
                    {c.key === 'link' && (
                        <div class="ehs-panel">
                            <div class="ehs-bar">
                                <span class="ehs-crumb">COT-0042 · Nómada Labs</span>
                                <span class="ehs-pill ok">{L('Aceptada', 'Accepted')}</span>
                            </div>
                            <div class="ehs-link-head">
                                <span class="ehs-link-logo">K</span>
                                <span class="ehs-who"><b>Kilo Studio</b><small>{L('Propuesta de rediseño y lanzamiento', 'Redesign and launch proposal')}</small></span>
                            </div>
                            <div class="ehs-table">
                                <div class="ehs-tr"><span>{L('Sprint de diseño (2 semanas)', 'Design sprint (2 weeks)')}</span><span></span><span class="editorial">{L('$28,000', '$1,850')}</span></div>
                                <div class="ehs-tr"><span>{L('Landing y lanzamiento', 'Landing page and launch')}</span><span></span><span class="editorial">{L('$13,379', '$880')}</span></div>
                                <div class="ehs-tr ehs-tr-total"><span>{L('Total con IVA', 'Total')}</span><span></span><span class="editorial">{L('$48,000', '$2,730')} <small>{cur}</small></span></div>
                            </div>
                            <div class="ehs-sign">
                                <span class="ehs-sign-name">Mariana Ruiz</span>
                                <small>{L('Firmado · 30 sep, 11:42', 'Signed · Sep 30, 11:42')}</small>
                            </div>
                            <div class="ehs-paybtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                                {L('Pagado con tarjeta', 'Paid by card')}
                            </div>
                        </div>
                    )}
                    {c.key === 'facturas' && (
                        <div class="ehs-panel">
                            <div class="ehs-bar">
                                <span class="ehs-crumb">{L('Facturas · Por cobrar', 'Invoices · Receivables')}</span>
                                <span class="ehs-crumb-soft">{D.abiertas}</span>
                            </div>
                            <div class="ehs-kpis">
                                <div>
                                    <span class="ehs-lbl">{L('Saldo por cobrar', 'Outstanding')}</span>
                                    <b class="editorial">{D.saldo} <small>{cur}</small></b>
                                </div>
                                <div>
                                    <span class="ehs-lbl">{L('Recordatorios enviados', 'Reminders sent')}</span>
                                    <b class="editorial">{D.recordatorios}</b>
                                </div>
                            </div>
                            <div class="ehs-rows ehs-rows-tight">
                                {D.fac.map((f) => (
                                    <div class="ehs-row">
                                        <span class="ehs-who"><b>{f.id}</b><small>{f.who}</small></span>
                                        <span class="ehs-amt editorial">{f.amt}</span>
                                        <span class={`ehs-pill ${f.st}`}>{FAC_ST[f.st]}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
                <div class="ehs-cap">
                    <h3>{c.title}</h3>
                    <a href={c.href} class="ehs-link">
                        <span>{L('Explorar', 'Explore')}</span>
                        <span class="ehs-link-ic" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </a>
                </div>
            </article>
        ))}
    </div>

    <div class="ehs-pager" role="group" aria-label={L('Capacidades destacadas', 'Featured capabilities')}>
        {cards.map((c, i) => (
            <button type="button" class="ehs-dot" data-ehs-dot={String(i)} aria-label={c.title} aria-current={i === 0 ? 'true' : undefined}>
                <i></i>
            </button>
        ))}
    </div>
</div>

<script>
    const INTERVAL = 5600;
    document.querySelectorAll<HTMLElement>('[data-ehs]').forEach((root) => {
        const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-ehs-card]'));
        const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ehs-dot]'));
        const n = cards.length;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let front = 0;
        let timer: number | undefined;
        let hovering = false;
        let visible = true;

        const paint = (leaving?: HTMLElement) => {
            cards.forEach((card, i) => {
                const pos = (i - front + n) % n;
                if (card === leaving) return;
                card.dataset.pos = String(pos);
                const isFront = pos === 0;
                card.toggleAttribute('inert', !isFront);
                if (isFront) card.removeAttribute('aria-hidden');
                else card.setAttribute('aria-hidden', 'true');
            });
            dots.forEach((d, i) => {
                if (i === front) d.setAttribute('aria-current', 'true');
                else d.removeAttribute('aria-current');
            });
            root.style.setProperty('--ehs-cycle', `${INTERVAL}ms`);
            root.classList.remove('ehs-tick');
            void root.offsetWidth; // reinicia la barra de progreso del dot activo
            if (!reduced) root.classList.add('ehs-tick');
        };

        const go = (next: number) => {
            if (next === front) return;
            const old = cards[front];
            front = (next + n) % n;
            if (reduced) { paint(); return; }
            // La tarjeta que sale se desliza y se desvanece; luego vuelve al fondo.
            old.dataset.pos = 'out';
            old.setAttribute('inert', '');
            old.setAttribute('aria-hidden', 'true');
            paint(old);
            window.setTimeout(() => {
                old.dataset.pos = String((cards.indexOf(old) - front + n) % n);
            }, 420);
        };

        const schedule = () => {
            window.clearTimeout(timer);
            if (reduced || hovering || !visible) { root.classList.remove('ehs-tick'); return; }
            timer = window.setTimeout(() => { go(front + 1); schedule(); }, INTERVAL);
        };

        dots.forEach((d, i) => d.addEventListener('click', () => { go(i); paint(); schedule(); }));

        // Pausa al pasar el cursor (solo escritorio: en táctil no hay hover y
        // la rotación sigue). Pausa fuera de pantalla y con la pestaña oculta.
        if (window.matchMedia('(hover: hover)').matches) {
            root.addEventListener('mouseenter', () => { hovering = true; root.classList.add('ehs-paused'); schedule(); });
            root.addEventListener('mouseleave', () => { hovering = false; root.classList.remove('ehs-paused'); paint(); schedule(); });
        }
        new IntersectionObserver(([e]) => { visible = e.isIntersecting; schedule(); }, { threshold: 0.2 }).observe(root);
        document.addEventListener('visibilitychange', () => { visible = !document.hidden; schedule(); });

        paint();
        schedule();
    });
</script>

<style>
    .ehs {
        position: relative;
        width: 100%;
        max-width: 440px;
        --ehs-cycle: 5600ms;
    }
    .ehs-stage {
        position: relative;
        height: 540px;
    }

    /* ── Tarjeta ── */
    .ehs-card {
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        background: #ffffff;
        border-radius: 22px;
        overflow: hidden;
        transform-origin: 30% 100%;
        box-shadow:
            0 1px 1px rgba(10, 25, 47, 0.06),
            0 8px 20px -6px rgba(10, 25, 47, 0.25),
            0 40px 80px -20px rgba(10, 16, 36, 0.55);
        transition:
            transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.6s ease,
            filter 0.6s ease;
        will-change: transform;
    }
    .ehs-card[data-pos='0'] { z-index: 3; transform: none; }
    .ehs-card[data-pos='1'] {
        z-index: 2;
        transform: translate(78px, 34px) rotate(7deg) scale(0.95);
        filter: brightness(0.94);
    }
    .ehs-card[data-pos='2'] {
        z-index: 1;
        transform: translate(146px, 84px) rotate(13deg) scale(0.9);
        filter: brightness(0.86);
    }
    .ehs-card[data-pos='out'] {
        z-index: 4;
        opacity: 0;
        transform: translate(-60px, -26px) rotate(-5deg) scale(0.97);
        transition: transform 0.42s cubic-bezier(0.4, 0, 1, 1), opacity 0.38s ease;
    }

    .ehs-shot {
        background: #f5f5f7;
        padding: 22px 22px 0;
        height: 360px;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(180deg, #000 82%, transparent);
        mask-image: linear-gradient(180deg, #000 82%, transparent);
    }
    .ehs-panel {
        background: #ffffff;
        border-radius: 14px 14px 0 0;
        box-shadow: 0 0 0 1px rgba(10, 25, 47, 0.06), 0 6px 18px -8px rgba(10, 25, 47, 0.18);
        padding: 0 18px 18px;
        min-height: 100%;
        color: #0a192f;
        font-size: 11px;
    }
    .ehs-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 12px 0;
        margin-bottom: 14px;
        border-bottom: 1px solid rgba(10, 25, 47, 0.07);
    }
    .ehs-crumb { font-weight: 600; font-size: 11.5px; letter-spacing: -0.01em; }
    .ehs-crumb-soft { color: rgba(10, 25, 47, 0.5); font-weight: 500; }
    .ehs-live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: rgba(10, 25, 47, 0.55);
        font-weight: 500;
    }
    .ehs-live i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
    }

    .ehs-kpis {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 14px;
        margin-bottom: 14px;
    }
    .ehs-lbl {
        display: flex;
        align-items: center;
        gap: 6px;
        color: rgba(10, 25, 47, 0.55);
        font-weight: 500;
        margin-bottom: 4px;
    }
    .ehs-kpis b {
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .ehs-kpis small { font-size: 10px; color: rgba(10, 25, 47, 0.45); font-weight: 500; letter-spacing: 0; }
    .ehs-up, .ehs-down {
        font-style: normal;
        font-size: 9.5px;
        font-weight: 600;
        padding: 1px 6px;
        border-radius: 100px;
    }
    .ehs-up { color: #047857; background: rgba(16, 185, 129, 0.12); }
    .ehs-down { color: #b45309; background: rgba(245, 158, 11, 0.14); }
    .ehs-warn-num { color: #b45309; }

    /* Barras apiladas: volumen cobrado vs. cobrado en línea */
    .ehs-chart {
        display: flex;
        align-items: flex-end;
        gap: 6px;
        height: 92px;
        padding-bottom: 2px;
    }
    .ehs-chart span {
        position: relative;
        flex: 1;
        height: var(--h);
        border-radius: 3px 3px 1px 1px;
        background: linear-gradient(180deg, #7c83ff, #6366f1);
        overflow: hidden;
    }
    .ehs-chart span i {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        background: #22c3a6;
    }
    .ehs-axis {
        display: flex;
        justify-content: space-between;
        color: rgba(10, 25, 47, 0.4);
        font-size: 9.5px;
        margin: 6px 0 12px;
    }

    .ehs-rows { display: flex; flex-direction: column; }
    .ehs-row {
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        align-items: center;
        gap: 10px;
        padding: 8px 0;
        border-top: 1px solid rgba(10, 25, 47, 0.06);
    }
    .ehs-rows-tight .ehs-row { grid-template-columns: 1fr auto auto; }
    .ehs-av {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 9px;
        font-weight: 700;
        color: var(--c);
        background: color-mix(in srgb, var(--c) 14%, #fff);
    }
    .ehs-who { display: flex; flex-direction: column; min-width: 0; }
    .ehs-who b { font-weight: 600; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ehs-who small { color: rgba(10, 25, 47, 0.45); font-size: 9.5px; }
    .ehs-amt { font-weight: 600; font-variant-numeric: tabular-nums; }
    .ehs-pill {
        font-size: 9.5px;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 100px;
        white-space: nowrap;
    }
    .ehs-pill.ok { color: #047857; background: rgba(16, 185, 129, 0.12); }
    .ehs-pill.pend { color: #4338ca; background: rgba(99, 102, 241, 0.12); }
    .ehs-pill.warn { color: #b45309; background: rgba(245, 158, 11, 0.15); }
    .ehs-pill.info { color: #0369a1; background: rgba(14, 165, 233, 0.12); }
    .ehs-pill.late { color: #be123c; background: rgba(244, 63, 94, 0.11); }

    .ehs-table { margin-bottom: 12px; }
    .ehs-th, .ehs-tr {
        display: grid;
        grid-template-columns: 1fr 52px 52px;
        gap: 8px;
        padding: 7px 0;
    }
    .ehs-th {
        color: rgba(10, 25, 47, 0.45);
        font-weight: 600;
        font-size: 9.5px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(10, 25, 47, 0.07);
    }
    .ehs-tr { border-bottom: 1px solid rgba(10, 25, 47, 0.05); }
    .ehs-th span:not(:first-child), .ehs-tr span:not(:first-child) { text-align: right; }
    .ehs-approval {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        padding: 10px 12px;
        border-radius: 10px;
        background: rgba(245, 158, 11, 0.08);
        color: #b45309;
