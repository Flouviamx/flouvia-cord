---
// Stack de tarjetas de los heroes de /soluciones (clases ehs-*).
// Tres capacidades reales por variante, cada una con su calca de pantalla y su
// enlace a la página de producto. Rotan solas; con prefers-reduced-motion no
// rotan y el pager sigue funcionando. El HTML por defecto es el estado final.
//
// Las calcas NO son interpretaciones: replican la pantalla real de /app a ~75%
// de escala (mismas columnas, etiquetas de i18n, pills y colores de estado).
//   cobros   → src/pages/app/cobros.astro (zonas saldo/KPIs + cobros recientes)
//   margen   → src/pages/app/cotizaciones/[id].astro (approval-banner + d-head)
//              con la columna Margen del editor (nueva.astro, .lr-margen)
//   facturas → src/pages/app/facturas/index.astro (cot-summary + filtros + tabla)
// Si una de esas pantallas cambia, esta calca se desactualiza con ella.
interface Props { isEn?: boolean; variant?: 'empresas' | 'startups' }
const { isEn = false, variant = 'empresas' } = Astro.props;

const cur = isEn ? 'USD' : 'MXN';
const pre = isEn ? '/en' : '';
const L = (es: string, en: string) => (isEn ? en : es);
const locale = isEn ? 'en-US' : 'es-MX';

// Mismo formato que money() de lib/fmt-server.ts; la divisa se dice aparte
// (regla 21: un monto sin divisa es un número, no dinero).
const money = (n: number, dec = 0) =>
    new Intl.NumberFormat(locale, { style: 'currency', currency: cur, minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n);
const num = (n: number, dec = 0) =>
    new Intl.NumberFormat(locale, { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n);
// fmtDate() de la app: '28 sep 2026' / 'Sep 28, 2026'.
const fecha = (iso: string) =>
    new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
        .format(new Date(`${iso}T12:00:00Z`)).replace('.', '');
// fecha() del <script> de /app/cobros para la llegada del depósito: '02 oct'.
const llegada = (iso: string) =>
    new Intl.DateTimeFormat(locale, { day: '2-digit', month: 'short', timeZone: 'UTC' })
        .format(new Date(`${iso}T12:00:00Z`)).replace('.', '');

type Metodo = 'tarjeta' | 'spei' | 'transferencia';
// METODO_COLOR + metodoLabel de /app/cobros.
const METODO: Record<Metodo, { label: string; color: string }> = {
    tarjeta: { label: L('Tarjeta de crédito/débito', 'Credit/debit card'), color: '#6366f1' },
    spei: { label: L('Transferencia SPEI', 'SPEI transfer'), color: '#10b981' },
    transferencia: { label: L('Transferencia (Manual)', 'Transfer (Manual)'), color: '#0ea5e9' },
};

type FacSt = 'paid' | 'open' | 'overdue' | 'draft';
interface Factura { num: string | null; draft?: string; who: string; total: number; saldo: number; st: FacSt; sent?: boolean }
interface Cobro { folio: string; who: string; m: Metodo; amt: number }

// Serie real de la factura: FAC en México, INV en el resto (countries.ts), con
// el folio a seis dígitos que asigna la secuencia (lib/fiscal/invoices.ts).
const FP = isEn ? 'INV' : 'FAC';

// Cifras por variante: un corporativo y una startup no facturan lo mismo, y un
// mockup con números fuera de escala delata que es de relleno.
const D = variant === 'startups'
    ? {
        bars: [12, 16, 15, 21, 19, 26, 31, 29, 38, 44, 52, 61],
        saldo: isEn ? 4120.75 : 52380.4, camino: isEn ? 1450 : 22500, llegadaISO: '2026-10-02',
        cobrado: isEn ? 38450 : 486200, ops: 41, growth: 64, fee: isEn ? 1153 : 15072,
        recientes: [
            { folio: 'COT-0042', who: 'Nómada Labs', m: 'tarjeta', amt: isEn ? 2730 : 48000 },
            { folio: 'COT-0041', who: 'Pixel & Vela', m: isEn ? 'transferencia' : 'spei', amt: isEn ? 1450 : 22500 },
            { folio: 'COT-0039', who: 'Kilo Studio', m: 'tarjeta', amt: isEn ? 2050 : 31250 },
            { folio: 'COT-0037', who: 'Estudio Brote', m: isEn ? 'transferencia' : 'spei', amt: isEn ? 1190 : 18600 },
        ] as Cobro[],
        porCobrar: isEn ? 9870 : 134900, vencido: isEn ? 2050 : 31250, vencidas: 1, cobradoMes: isEn ? 14120 : 212480,
        fac: [
            { num: `${FP}-000121`, who: 'Nómada Labs', total: isEn ? 2730 : 48000, saldo: 0, st: 'paid', sent: true },
            { num: `${FP}-000120`, who: 'Estudio Brote', total: isEn ? 1190 : 18600, saldo: isEn ? 1190 : 18600, st: 'open' },
            { num: `${FP}-000119`, who: 'Kilo Studio', total: isEn ? 2050 : 31250, saldo: isEn ? 2050 : 31250, st: 'overdue', sent: true },
            { num: `${FP}-000118`, who: 'Pixel & Vela', total: isEn ? 1450 : 22500, saldo: isEn ? 725 : 11250, st: 'open', sent: true },
            { num: null, draft: 'BOR-4E90B1', who: 'Ruta Norte', total: isEn ? 820 : 12400, saldo: isEn ? 820 : 12400, st: 'draft' },
        ] as Factura[],
    }
    : {
        bars: [38, 44, 41, 52, 49, 58, 55, 63, 60, 71, 68, 82],
        saldo: isEn ? 68410.25 : 1184392.6, camino: isEn ? 18902 : 389940, llegadaISO: '2026-10-02',
        cobrado: isEn ? 2429777 : 4290777, ops: 126, growth: 18.4, fee: isEn ? 71921 : 131727,
        recientes: [
            { folio: 'COT-0148', who: 'Distribuidora El Zarco', m: isEn ? 'transferencia' : 'spei', amt: isEn ? 11420 : 196469 },
            { folio: 'COT-0147', who: 'Grupo Vértice', m: isEn ? 'transferencia' : 'spei', amt: isEn ? 32670 : 582670 },
            { folio: 'COT-0146', who: 'Aceros del Norte', m: 'tarjeta', amt: isEn ? 18902 : 389940 },
            { folio: 'COT-0144', who: 'Constructora Zarco', m: 'tarjeta', amt: isEn ? 42100 : 742100 },
        ] as Cobro[],
        porCobrar: isEn ? 318204 : 2771810, vencido: isEn ? 61535 : 1106215, vencidas: 3, cobradoMes: isEn ? 184250 : 3184250,
        fac: [
            { num: `${FP}-002034`, who: 'Constructora Zarco', total: isEn ? 42100 : 742100, saldo: 0, st: 'paid', sent: true },
            { num: `${FP}-002033`, who: 'Ferrex Industrial', total: isEn ? 9880 : 196880, saldo: isEn ? 9880 : 196880, st: 'open' },
            { num: `${FP}-002031`, who: 'Grupo Vértice', total: isEn ? 65340 : 1165340, saldo: isEn ? 32670 : 582670, st: 'open', sent: true },
            { num: `${FP}-002030`, who: 'Cementos Gama', total: isEn ? 27415 : 508415, saldo: isEn ? 27415 : 508415, st: 'overdue', sent: true },
            { num: null, draft: 'BOR-7C21E4', who: 'Distribuidora Ámbar', total: isEn ? 14060 : 261060, saldo: isEn ? 14060 : 261060, st: 'draft' },
        ] as Factura[],
    };
const feePct = Math.round((D.fee / D.cobrado) * 10000) / 100;

// Sparkline del KPI "Cobrado" (mountSparkline: línea navy suave, sin ejes).
const spark = (() => {
    const w = 120, h = 26, max = Math.max(...D.bars), min = Math.min(...D.bars);
    const pts = D.bars.map((v, i) => [(i / (D.bars.length - 1)) * w, h - 2 - ((v - min) / (max - min || 1)) * (h - 4)]);
    let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < pts.length - 1; i++) {
        const [x0, y0] = pts[Math.max(0, i - 1)], [x1, y1] = pts[i], [x2, y2] = pts[i + 1], [x3, y3] = pts[Math.min(pts.length - 1, i + 2)];
        d += ` C${(x1 + (x2 - x0) / 6).toFixed(1)},${(y1 + (y2 - y0) / 6).toFixed(1)} ${(x2 - (x3 - x1) / 6).toFixed(1)},${(y2 - (y3 - y1) / 6).toFixed(1)} ${x2.toFixed(1)},${y2.toFixed(1)}`;
    }
    return d;
})();

// ESTADO_META de /app/facturas (+ la rama "Vencida" que calcula la fila).
const FAC_META: Record<FacSt, { label: string; color: string; bg: string }> = {
    paid: { label: L('Pagada', 'Paid'), color: '#059669', bg: 'rgba(16,185,129,0.12)' },
    open: { label: L('Abierta', 'Open'), color: '#b45309', bg: 'rgba(245,158,11,0.12)' },
    overdue: { label: L('Vencida', 'Overdue'), color: '#dc2626', bg: 'rgba(239,68,68,0.1)' },
    draft: { label: L('Borrador', 'Draft'), color: '#5b6472', bg: 'rgba(91,100,114,0.1)' },
};
// inicial() de /app/facturas: las dos primeras letras, no las iniciales.
const inicial = (nombre: string) => nombre.trim().slice(0, 2).toUpperCase();
const FILTROS = [L('Todas', 'All'), L('Borradores', 'Drafts'), L('Abiertas', 'Open'), L('Vencidas', 'Past due'), L('Pagadas', 'Paid'), L('Anuladas', 'Void')];

// Cotización retenida por el flujo de aprobación. El motivo se arma igual que en
// lib/cotizaciones.ts: descuento máximo y margen mínimo de las líneas con costo.
const Q = {
    folio: 'COT-0149', cliente: 'Grupo Vértice', ini: 'GV', version: 2,
    minMargen: 25, maxDesc: 12, taxRate: isEn ? 0.0825 : 0.16,
    items: [
        { name: L('Viga IPR 12" × 31 lb/ft', 'W12×31 steel beam'), unit: L('pieza · 12 m', 'piece · 40 ft'), qty: 340, lista: isEn ? 146 : 2480, nego: isEn ? 138 : 2350, margen: 27.1 },
        { name: L('Lámina galvanizada cal. 18', 'Galvanized sheet, 18 ga'), unit: L('hoja · 4 × 10 ft', 'sheet · 4 × 10 ft'), qty: 1200, lista: isEn ? 23.2 : 395, nego: isEn ? 19.35 : 329, margen: 19.8 },
        { name: L('Flete e instalación en obra', 'Freight and on-site install'), unit: L('servicio', 'service'), qty: 1, lista: isEn ? 5340 : 90700, nego: null as number | null, margen: 31.0 },
    ],
};
const qSub = Q.items.reduce((s, it) => s + (it.nego ?? it.lista) * it.qty, 0);
const qTotal = Math.round(qSub * (1 + Q.taxRate) * 100) / 100;
const qDesc = Math.round(Math.max(...Q.items.map((it) => (it.nego !== null && it.nego < it.lista ? (1 - it.nego / it.lista) * 100 : 0))));
const qMin = Math.round(Math.min(...Q.items.map((it) => it.margen)));
const qMotivo = L(
    `descuento ${qDesc}% supera el ${Q.maxDesc}% permitido y margen bruto ${qMin}% está por debajo del mínimo de ${Q.minMargen}%`,
    `${qDesc}% discount exceeds the ${Q.maxDesc}% allowed and ${qMin}% gross margin is below the ${Q.minMargen}% minimum`,
);

const cards = variant === 'startups'
    ? [
        { key: 'link', title: L('Propuesta aceptada y cobrada en el mismo link', 'Proposal accepted and paid in the same link'), href: `${pre}/producto/link-publico` },
        { key: 'cobros', title: L('Ingresos que ves entrar en vivo', 'Revenue you watch come in live'), href: `${pre}/producto/pagos` },
        { key: 'facturas', title: L('Facturas que se persiguen solas', 'Invoices that chase themselves'), href: `${pre}/producto/facturacion` },
    ]
    : [
        { key: 'cobros', title: L('Cobro en línea y conciliación', 'Online payments and reconciliation'), href: `${pre}/producto/pagos` },
        { key: 'margen', title: L('Márgenes y aprobaciones bajo control', 'Margins and approvals under control'), href: `${pre}/producto/aprobaciones` },
        { key: 'facturas', title: L('Facturación con cobranza automática', 'Invoicing with automatic collections'), href: `${pre}/producto/facturacion` },
    ];
---

<div class="ehs" data-ehs data-variant={variant}>
    <div class="ehs-stage">
        {cards.map((c, i) => (
            <article class="ehs-card" data-ehs-card data-pos={String(i)} aria-hidden={i === 0 ? undefined : 'true'} inert={i === 0 ? undefined : true}>
                <div class="ehs-shot" aria-hidden="true">
                    {c.key === 'link' ? (
                        <div class="ehs-panel">
                            <div class="ehs-bar">
                                <span class="ehs-crumb">COT-0042 · Nómada Labs</span>
                                <span class="ehs-pill ok">{L('Aceptada', 'Accepted')}</span>
                            </div>
                            <div class="ehs-link-head">
                                <span class="ehs-link-logo">K</span>
                                <span class="ehs-who"><b>Kilo Studio</b><small>{L('Propuesta de rediseño y lanzamiento', 'Redesign and launch proposal')}</small></span>
                            </div>
                            <div class="ehs-table">
                                <div class="ehs-tr"><span>{L('Sprint de diseño (2 semanas)', 'Design sprint (2 weeks)')}</span><span></span><span class="editorial">{L('$28,000', '$1,850')}</span></div>
                                <div class="ehs-tr"><span>{L('Landing y lanzamiento', 'Landing page and launch')}</span><span></span><span class="editorial">{L('$13,379', '$880')}</span></div>
                                <div class="ehs-tr ehs-tr-total"><span>{L('Total con IVA', 'Total')}</span><span></span><span class="editorial">{L('$48,000', '$2,730')} <small>{cur}</small></span></div>
                            </div>
                            <div class="ehs-sign">
                                <span class="ehs-sign-name">Mariana Ruiz</span>
                                <small>{L('Firmado · 30 sep, 11:42', 'Signed · Sep 30, 11:42')}</small>
                            </div>
                            <div class="ehs-paybtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                                {L('Pagado con tarjeta', 'Paid by card')}
                            </div>
                        </div>
                    ) : (
                        <div class="ehs-app">
                            <!-- Topbar real de AppLayout: búsqueda ⌘K, Crear y accesos. -->
                            <div class="ehs-tb">
                                <span class="ehs-tb-search">
                                    <svg viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="20.5" y1="20.5" x2="16.2" y2="16.2"/></svg>
                                    {L('Buscar…', 'Search…')}
                                    <kbd>⌘K</kbd>
                                </span>
                                <span class="ehs-tb-right">
                                    <span class="ehs-tb-create">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                        {L('Crear', 'Create')}
                                        <svg class="ehs-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                                    </span>
                                    <span class="ehs-tb-ic">
                                        <svg viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0" fill="none"/></svg>
                                    </span>
                                    <span class="ehs-tb-av">AV</span>
                                </span>
                            </div>

                            {c.key === 'cobros' && (
                                <div class="ehs-pg">
                                    <div class="ehs-ph">
                                        <h4 class="ehs-ph-title">{L('Cobros', 'Collections')}</h4>
                                        <span class="ehs-dp">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3" fill="currentColor" fill-opacity="0.12"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
                                            {L('Este trimestre', 'This quarter')}
                                            <svg class="ehs-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                                        </span>
                                    </div>

                                    <div class="ehs-zone ehs-zone-bal">
                                        <div class="ehs-bal">
                                            <span class="ehs-kl">{L('Saldo disponible', 'Available balance')}<span class="ehs-snap">{L('en vivo', 'live')}</span></span>
                                            <b class="editorial ehs-bal-val">{money(D.saldo, 2)}<i class="ehs-cur">{cur}</i></b>
                                            <small>{L(`${money(D.camino, 2)} en camino`, `${money(D.camino, 2)} on the way`)}</small>
                                        </div>
                                        <div class="ehs-aside">
                                            <span class="ehs-st">{L('Próximo depósito', 'Next payout')}</span>
                                            <div class="ehs-next">
                                                <i class="ehs-mdot" style="background:#3b82f6"></i>
                                                <span><strong>{L('En camino', 'In transit')}</strong><small>{L('Llegada', 'Arrival')}: {llegada(D.llegadaISO)}</small></span>
                                                <b class="editorial">{money(D.camino, 2)}</b>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="ehs-zone ehs-zone-2 ehs-zone-kpi">
                                        <div class="ehs-kpi">
                                            <span class="ehs-kl">{L('Cobrado', 'Collected')}</span>
                                            <b class="editorial ehs-kpi-val">{money(D.cobrado)}<i class="ehs-cur">{cur}</i></b>
                                            <small>{D.ops} {L('operaciones en el periodo', 'payments in the period')}</small>
                                            <small class="ehs-delta">+{num(D.growth, D.growth % 1 ? 1 : 0)}% {L('vs. periodo anterior', 'vs. previous period')}</small>
                                            <svg class="ehs-spark" viewBox="0 0 120 26" preserveAspectRatio="none"><path d={spark}/></svg>
                                        </div>
                                        <div class="ehs-kpi">
                                            <span class="ehs-kl">{L('Neto depositado', 'Net deposited')}</span>
                                            <b class="editorial ehs-kpi-val">{money(D.cobrado - D.fee)}<i class="ehs-cur">{cur}</i></b>
                                            <small>{L('comisión', 'fees')} {money(D.fee)} · {num(feePct, 2)}% {L('efectivo', 'effective')}</small>
                                            <span class="ehs-seg" title="">
                                                <i style={`flex:${100 - feePct}`}></i><i class="ehs-seg-fee" style={`flex:${feePct}`}></i>
                                            </span>
                                            <span class="ehs-seg-key"><span><i class="ehs-mdot" style="background:#059669"></i>{L('Neto a tu banco', 'Net to your bank')}</span><span><i class="ehs-mdot" style="background:#f59e0b"></i>{L('Comisión', 'Fees')}</span></span>
                                        </div>
                                    </div>

                                    <div class="ehs-zone ehs-zone-tab">
                                        <span class="ehs-st ehs-st-line">{L('Cobros recientes', 'Recent payments')}</span>
                                        <div class="ehs-cth"><span>{L('Folio', 'Quote #')}</span><span>{L('Cliente', 'Client')}</span><span>{L('Método', 'Method')}</span><span class="ehs-r">{L('Monto', 'Amount')}</span></div>
                                        {D.recientes.map((r) => (
                                            <div class="ehs-ctr">
                                                <span class="ehs-cfolio">{r.folio}</span>
                                                <span class="ehs-ccli">{r.who}</span>
                                                <span class="ehs-cmet"><i class="ehs-mdot" style={`background:${METODO[r.m].color}`}></i>{METODO[r.m].label}</span>
                                                <span class="editorial ehs-r ehs-camt">{money(r.amt)}<i class="ehs-cur">{cur}</i></span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )}

                            {c.key === 'margen' && (
                                <div class="ehs-pg">
                                    <div class="ehs-ph">
                                        <div>
                                            <span class="ehs-crumbs"><span>{L('Cotizaciones', 'Quotes')}</span><b>{Q.folio}</b></span>
                                            <h4 class="ehs-ph-title">{Q.folio}</h4>
                                        </div>
                                        <span class="ehs-status" style="color:#64748b;background:rgba(100,116,139,0.1)">{L('Borrador', 'Draft')}</span>
                                    </div>

                                    <div class="ehs-apb">
                                        <span class="ehs-apb-info">
                                            <span class="ehs-apb-title">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.12"/><polyline points="12 7 12 12 15.5 14"/></svg>
                                                {L('Pendiente de aprobación', 'Pending approval')}
                                            </span>
                                            <span class="ehs-apb-why">{qMotivo}</span>
                                        </span>
                                        <span class="ehs-apb-acts">
                                            <span class="ehs-apb-ok">{L('Aprobar y enviar', 'Approve and send')}</span>
                                            <span class="ehs-apb-no">{L('Rechazar', 'Reject')}</span>
                                        </span>
                                    </div>

                                    <div class="ehs-dh">
                                        <span class="ehs-dh-av">{Q.ini}</span>
                                        <span class="ehs-dh-who">
                                            <b>{Q.cliente} <em>V{Q.version}</em></b>
                                            <small>Net 30 · {L('Vigente hasta', 'Valid until')} {fecha('2026-10-30')}</small>
                                        </span>
                                        <span class="ehs-dh-total">
                                            <small>TOTAL</small>
                                            <b class="editorial">{money(qTotal, 2)}<i class="ehs-cur">{cur}</i></b>
                                        </span>
                                    </div>

                                    <span class="ehs-st ehs-st-line ehs-margen-sec">{L('Detalle', 'Detail')}</span>
                                    <div class="ehs-dith">
                                        <span>{L('Producto', 'Product')}</span><span>{L('Cant.', 'Qty.')}</span><span>{L('Precio', 'Price')}</span><span class="ehs-r">{L('Importe', 'Amount')}</span><span class="ehs-c">{L('Margen', 'Margin')}</span>
                                    </div>
                                    {Q.items.map((it) => (
                                        <div class="ehs-ditr">
                                            <span class="ehs-diname">{it.name}<small>{it.unit}</small></span>
                                            <span class="ehs-diqty">{num(it.qty)}</span>
                                            <span class="ehs-diprice">
                                                {it.nego !== null && <s>{money(it.lista, 2)}</s>}
                                                <span class="editorial">{money(it.nego ?? it.lista, 2)}</span>
                                            </span>
                                            <span class="editorial ehs-r ehs-diamt">{money((it.nego ?? it.lista) * it.qty, 2)}<i class="ehs-cur">{cur}</i></span>
                                            <span class:list={['ehs-margen', { low: it.margen < Q.minMargen }]}>{Math.round(it.margen)}%</span>
                                        </div>
                                    ))}
                                </div>
                            )}

                            {c.key === 'facturas' && (
                                <div class="ehs-pg">
                                    <div class="ehs-ph">
                                        <h4 class="ehs-ph-title">{L('Facturas', 'Invoices')}</h4>
                                        <span class="ehs-ph-acts">
