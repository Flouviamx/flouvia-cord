---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  lang: "es" | "en";
}

const { headings, lang } = Astro.props;

// Solo h2 y h3: más profundo convierte el índice en una segunda página.
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const tocTitle = lang === 'es' ? 'En esta página' : 'On this page';
---

{toc.length > 0 && (
  <nav class="toc-nav" aria-labelledby="toc-title">
    <p class="toc-title" id="toc-title">{tocTitle}</p>
    <ul class="toc-list">
      {toc.map((heading) => (
        <li class={`toc-item depth-${heading.depth}`}>
          <a href={`#${heading.slug}`} class="toc-link" data-toc-slug={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // Seguimiento de lectura: el activo es el ÚLTIMO encabezado cuya parte
  // superior ya pasó por debajo del header fijo. Se recalcula en un rAF por
  // scroll (igual de fiable al subir que al bajar) y al cargar con #hash; el
  // IntersectionObserver sólo despierta el cálculo cuando un encabezado cruza
  // la franja superior, para no depender de su orden de entradas.
  function initScrollSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link[data-toc-slug]'));
    if (!links.length) return;

    const pairs = links
      .map((link) => ({ link, heading: document.getElementById(link.dataset.tocSlug || '') }))
      .filter((pair): pair is { link: HTMLAnchorElement; heading: HTMLElement } => Boolean(pair.heading));
    if (!pairs.length) return;

    let current: HTMLAnchorElement | null = null;
    let frame = 0;

    const headerOffset = () => {
      const header = document.querySelector<HTMLElement>('.docs-header');
      return (header?.getBoundingClientRect().bottom ?? 0) + 24;
    };

    const setActive = (link: HTMLAnchorElement | null) => {
      if (link === current) return;
      current?.classList.remove('active');
      current?.removeAttribute('aria-current');
      current = link;
      if (!link) return;
      link.classList.add('active');
      link.setAttribute('aria-current', 'location');
      // Mantén el activo a la vista si el índice es más alto que la ventana.
      const box = link.closest<HTMLElement>('.docs-toc');
      if (box && box.scrollHeight > box.clientHeight) {
        const top = link.offsetTop;
        const outside = top < box.scrollTop || top + link.offsetHeight > box.scrollTop + box.clientHeight;
        if (outside) box.scrollTo({ top: Math.max(0, top - box.clientHeight / 2) });
      }
    };

    const compute = () => {
      frame = 0;
      const limit = headerOffset();
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom) {
        setActive(pairs[pairs.length - 1].link);
        return;
      }
      let active: HTMLAnchorElement | null = null;
      for (const { link, heading } of pairs) {
        if (heading.getBoundingClientRect().top - limit <= 1) active = link;
        else break;
      }
      setActive(active ?? pairs[0].link);
    };

    const schedule = () => {
      if (!frame) frame = window.requestAnimationFrame(compute);
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(schedule, { rootMargin: '0px 0px -60% 0px' });
      pairs.forEach(({ heading }) => observer.observe(heading));
    }
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('hashchange', schedule);
    window.addEventListener('load', schedule);
    compute();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollSpy, { once: true });
  } else {
    initScrollSpy();
  }
</script>

<style>
  /* El contenedor .docs-toc (DocsLayout) es el único sticky. */
  .toc-nav {
    padding: 0 0 32px 24px;
    font-size: 13px;
  }

  .toc-title {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--docs-text-3, #5e6677);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--docs-hairline, rgba(0, 0, 0, 0.07));
  }

  .toc-item {
    margin: 0;
    line-height: 1.4;
  }

  .toc-link {
    position: relative;
    display: block;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--docs-text-3, #5e6677);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .toc-item.depth-3 .toc-link {
    padding-left: 26px;
  }

  .toc-link:hover {
    color: var(--docs-text, #050505);
  }

  /* Peso constante: el activo cambia color y barra, nunca el ancho del texto. */
  .toc-link.active {
    color: var(--docs-text, #050505);
    border-left-color: var(--docs-text, #050505);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--docs-focus, rgba(0, 113, 227, 0.55));
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
