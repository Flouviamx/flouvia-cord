---
// Pieza interna de los mockups del Cord Workbench (NO es un mockup: el registro
// de index.ts solo toma `Dm*.astro`). Dibuja la hoja navy del dock abierto —
// grabber, las seis pestañas reales y el chrome (⋯ · pantalla completa · ✕) — y
// trae las primitivas `wbm-*` que comparten DmWorkbenchOverview, DmApiKeys,
// DmTestKeyCreated, DmWebhookDeliveries, DmWorkbenchLogs y DmRestrictedKey.
//
// Calca de src/components/app/DevWorkbench.astro + src/styles/workbench.css: el
// Workbench es navy SIEMPRE (no sigue el tema de la app). Los nombres de las
// pestañas salen del diccionario real (wb.tab.*), en el mismo orden que TABS.
import DmIcon from './DmIcon.astro';
import { dmT, type DmLang } from './format';

interface Props {
    lang: DmLang;
    /** Pestaña activa: resumen · webhooks · eventos · api · registros · salud. */
    tab: 'resumen' | 'webhooks' | 'eventos' | 'api' | 'registros' | 'salud';
    class?: string;
}
const { lang, tab, class: cls } = Astro.props;
const TABS = ['resumen', 'webhooks', 'eventos', 'api', 'registros', 'salud'] as const;
---
<div class:list={['wbm', cls]}>
    <div class="wbm-grab"><span></span></div>
    <div class="wbm-tabs">
        <span class="wbm-tablist">{TABS.map((id) => <span class:list={['wbm-tab', { 'is-on': id === tab }]}>{dmT(lang, `wb.tab.${id}`)}</span>)}</span>
        <span class="wbm-chrome">
            <span class="wbm-ico"><DmIcon name="more" /></span>
            <span class="wbm-ico dm-hide-narrow"><DmIcon name="expand" /></span>
            <span class="wbm-ico"><DmIcon name="x" /></span>
        </span>
    </div>
    <div class="wbm-body"><slot /></div>
</div>

<style is:global>
    /* ── Hoja navy del dock (= .wb-panel) ─────────────────────────────────── */
    .wbm {
        --wbm-bg: #0a1524;
        --wbm-surface: #0f1d33;
        --wbm-surface-2: #12213a;
        --wbm-line: rgba(255, 255, 255, 0.09);
        --wbm-border: rgba(255, 255, 255, 0.1);
        --wbm-text: #e8eef8;
        --wbm-muted: #93a3bb;
        --wbm-faint: rgba(255, 255, 255, 0.42);
        --wbm-blue: #6b9bf2;
        --wbm-solid: #2f6df0;
        --wbm-ok: #10b981;
        --wbm-warn: #f59e0b;
        --wbm-danger: #ef4444;
        display: flex;
        flex-direction: column;
        min-width: 0;
        background: var(--wbm-bg);
        color: var(--wbm-text);
        border-radius: 20px;
        overflow: hidden;
        box-shadow:
            0 32px 80px -24px rgba(10, 25, 47, 0.6),
            0 12px 28px -12px rgba(10, 25, 47, 0.4),
            inset 0 0 0 1px rgba(255, 255, 255, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    .wbm-grab { display: flex; justify-content: center; align-items: center; height: 13px; flex-shrink: 0; }
    .wbm-grab span { width: 30px; height: 4px; border-radius: 100px; background: rgba(255, 255, 255, 0.16); }
    .wbm-tabs { display: flex; align-items: center; height: 36px; padding: 0 10px; border-bottom: 1px solid var(--wbm-line); flex-shrink: 0; min-width: 0; }
    .wbm-tablist { flex: 1; min-width: 0; display: flex; overflow: hidden; }
    .wbm-tab { flex-shrink: 0; position: relative; display: inline-flex; align-items: center; height: 36px; padding: 0 10px; font-size: 11.5px; font-weight: 600; letter-spacing: -0.01em; color: rgba(255, 255, 255, 0.45); white-space: nowrap; }
    .wbm-tab.is-on { color: #fff; }
    .wbm-tab.is-on::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 2px; border-radius: 2px 2px 0 0; background: var(--wbm-blue); }
    .wbm-chrome { margin-left: auto; display: flex; align-items: center; gap: 2px; flex-shrink: 0; padding-left: 6px; background: var(--wbm-bg); }
    .wbm-ico { width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; color: rgba(255, 255, 255, 0.42); }
    .wbm-ico .dm-ico { width: 13px; height: 13px; }
    .wbm-body { flex: 1; min-height: 0; padding: 16px 18px 20px; overflow: hidden; }

    /* ── Dock abierto sobre la app (compartido por los mockups dm-wb-figure) ── */
    .dm-wb-figure .dm-app { min-height: 660px; }
    .dm-wb-figure .dm-wb-sheet {
        position: absolute;
        left: 78px;
        right: calc(var(--dm-bleed) + 12px);
        bottom: 12px;
        height: var(--wbm-h, 72%);
        pointer-events: auto;
    }
    @container dm (max-width: 640px) {
        .dm-wb-figure .dm-app { min-height: 0; }
        .dm-wb-figure .wbbd { display: none; }
        .dm-wb-figure .dm-content { padding-bottom: 0; }
        .dm-wb-figure .dm-overlay { position: static; }
        .dm-wb-figure .dm-wb-sheet { position: relative; left: auto; right: auto; bottom: auto; height: auto; max-height: var(--wbm-hn, 560px); margin: 0 var(--dm-bleed) 0 0; }
    }

    /* ── Primitivas del contenido de las pestañas ─────────────────────────── */
    .wbm-card { background: var(--wbm-surface); border: 1px solid var(--wbm-border); border-radius: 12px; padding: 13px 14px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05); min-width: 0; }
    .wbm-lbl { display: block; font-size: 10.5px; font-weight: 600; color: var(--wbm-muted); }
    .wbm-sec-title { font-size: 13px; font-weight: 600; letter-spacing: -0.015em; color: #fff; }
    .wbm-big { font-size: 24px; line-height: 1.1; color: #fff; font-weight: 600; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
    .wbm-num { font-variant-numeric: tabular-nums; font-weight: 600; color: #fff; }
    .wbm-mono { font-family: var(--dm-mono); letter-spacing: -0.01em; }
    .wbm-seg { display: inline-flex; background: rgba(255, 255, 255, 0.06); border-radius: 8px; padding: 2px; flex-shrink: 0; }
    .wbm-seg span { font-size: 10.5px; font-weight: 600; color: rgba(255, 255, 255, 0.5); padding: 4px 9px; border-radius: 6px; white-space: nowrap; }
    .wbm-seg span.is-on { background: rgba(255, 255, 255, 0.11); color: #fff; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08); }
    .wbm-link { font-size: 11px; font-weight: 600; color: var(--wbm-blue); white-space: nowrap; }
    .wbm-kv { display: flex; flex-direction: column; }
    .wbm-kv-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--wbm-border); font-size: 11px; color: var(--wbm-muted); min-width: 0; }
    .wbm-kv-row:last-child { border-bottom: 0; }
    .wbm-kv-row b { color: #fff; font-weight: 600; font-variant-numeric: tabular-nums; min-width: 0; text-align: right; }
    .wbm-kv-row b.ok { color: var(--wbm-ok); }
    .wbm-kv-row b.bad { color: var(--wbm-danger); }
    .wbm-kv-row em { font-style: normal; color: var(--wbm-faint); font-weight: 500; }

    /* Botones del dock (api-btn-*) */
    .wbm-btn { display: inline-flex; align-items: center; justify-content: center; gap: 5px; height: 28px; padding: 0 12px; border-radius: 8px; font-size: 11px; font-weight: 600; white-space: nowrap; color: var(--wbm-muted); border: 1px solid var(--wbm-border); flex-shrink: 0; }
    .wbm-btn-solid { background: var(--wbm-solid); border-color: transparent; color: #fff; }
    .wbm-btn .dm-ico { width: 12px; height: 12px; }

    /* Método · ruta · status · latencia · fecha (= .act-*) */
    .wbm-m { display: inline-flex; justify-content: center; font-size: 8.5px; font-weight: 800; padding: 3px 0; border-radius: 5px; letter-spacing: 0.02em; }
    .wbm-m.get { color: #7ba7ff; background: rgba(107, 155, 242, 0.16); }
    .wbm-m.post { color: #fbbf24; background: rgba(245, 158, 11, 0.16); }
    .wbm-m.patch { color: #c4b5fd; background: rgba(139, 92, 246, 0.18); }
    .wbm-m.delete { color: #fca5a5; background: rgba(239, 68, 68, 0.16); }
    .wbm-path { font-family: var(--dm-mono); font-size: 11px; color: var(--wbm-text); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wbm-st { font-family: var(--dm-mono); font-size: 10.5px; font-weight: 700; }
    .wbm-st.ok { color: var(--wbm-ok); }
    .wbm-st.bad { color: var(--wbm-danger); }
    .wbm-lat { font-size: 10.5px; color: var(--wbm-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .wbm-when { font-size: 10px; color: rgba(255, 255, 255, 0.38); white-space: nowrap; font-variant-numeric: tabular-nums; }

    /* Etiquetas de llave (= .key-mode / .key-type / .key-scope) */
    .wbm-pill { display: inline-flex; align-items: center; font-size: 8.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 7px; border-radius: 100px; white-space: nowrap; flex-shrink: 0; }
    .wbm-pill.test, .wbm-pill.res, .wbm-pill.write { color: #fcd34d; background: rgba(245, 158, 11, 0.16); }
    .wbm-pill.live { color: #34d399; background: rgba(16, 185, 129, 0.14); }
    .wbm-pill.sec { color: rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.09); }
    .wbm-pill.pub { color: #a5b4fc; background: rgba(99, 102, 241, 0.2); }
    .wbm-pill.read { color: var(--wbm-blue); background: rgba(107, 155, 242, 0.16); }

    /* ── Modal navy del Workbench (= .wb-modal.compact) ───────────────────── */
    .wbm-modal { background: var(--wbm-bg, #0a1524); color: var(--wbm-text, #e8eef8); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; min-width: 0;
        box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.75), 0 4px 14px rgba(0, 0, 0, 0.3), inset 0 0 0 1px rgba(255, 255, 255, 0.09), inset 0 1px 0 rgba(255, 255, 255, 0.1); }
    .wbm-modal-top { display: flex; align-items: center; gap: 10px; padding: 13px 16px; border-bottom: 1px solid var(--wbm-line); }
    .wbm-modal-x { width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; color: rgba(255, 255, 255, 0.45); flex-shrink: 0; }
    .wbm-modal-x .dm-ico { width: 14px; height: 14px; }
    .wbm-modal-title { font-size: 13.5px; font-weight: 600; letter-spacing: -0.015em; color: #fff; min-width: 0; }
    .wbm-modal-body { padding: 15px 16px; display: flex; flex-direction: column; gap: 12px; }
    .wbm-modal-foot { display: flex; align-items: center; justify-content: flex-end; gap: 7px; padding: 12px 16px; border-top: 1px solid var(--wbm-line); }
    .wbm-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .wbm-flabel { font-size: 8.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.42); }
    .wbm-input { display: flex; align-items: center; min-height: 32px; padding: 0 11px; border-radius: 8px; background: rgba(255, 255, 255, 0.06); border: 1px solid var(--wbm-border); font-size: 12px; font-weight: 500; color: var(--wbm-text); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wbm-input.is-sel::after { content: ''; margin-left: auto; width: 5px; height: 5px; border-right: 1.5px solid rgba(255, 255, 255, 0.45); border-bottom: 1.5px solid rgba(255, 255, 255, 0.45); transform: translateY(-2px) rotate(45deg); flex-shrink: 0; margin-left: 10px; }
    .wbm-hint { font-size: 10.5px; color: rgba(255, 255, 255, 0.45); line-height: 1.4; }
    .wbm-opt { display: flex; align-items: flex-start; gap: 9px; padding: 9px 11px; border-radius: 10px; border: 1px solid var(--wbm-border); }
    .wbm-opt.is-on { border-color: var(--wbm-blue); background: rgba(107, 155, 242, 0.08); }
    .wbm-radio { width: 13px; height: 13px; border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.32); flex-shrink: 0; margin-top: 1px; }
    .wbm-opt.is-on .wbm-radio { border-color: var(--wbm-solid); background: radial-gradient(circle, #fff 0 2.5px, var(--wbm-solid) 3px); }
    .wbm-opt-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .wbm-opt-body b { font-size: 11.5px; font-weight: 600; color: var(--wbm-text); }
    .wbm-opt-body i { font-style: normal; font-size: 10.5px; color: var(--wbm-muted); line-height: 1.4; }
    .wbm-opts { display: flex; flex-direction: column; gap: 6px; }

    @container dm (max-width: 520px) {
        .wbm { border-radius: 18px 18px 0 0; }
        .wbm-tabs { padding: 0 4px; }
        .wbm-tab { padding: 0 7px; font-size: 10.5px; }
        .wbm-tab.is-on::after { left: 7px; right: 7px; }
        .wbm-body { padding: 13px 12px 16px; }
    }
</style>
