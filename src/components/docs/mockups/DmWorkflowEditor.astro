---
// Mockup: el editor de un workflow (/app/workflows/[id]) en cuatro momentos.
//
//   view="editor"  · lienzo con la "Escalera de seguimiento" y el panel
//                    "Editar acción" abierto sobre "Crear una tarea".
//   view="test"    · el mismo lienzo con la tarjeta "Prueba sin publicar".
//   view="runs"    · pestaña Ejecuciones con una ejecución fallida abierta.
//   view="trigger" · workflow nuevo con el buscador de disparadores abierto en
//                    la categoría Facturas.
//
// Calca de src/components/app/WorkflowEditor.astro: barra (cerrar, nombre,
// estado, "Cambios sin publicar", Probar / Guardar borrador / Publicar), pestañas
// Editor / Ejecuciones, lienzo punteado con nodos, rombo y ramas, panel lateral,
// tarjeta de prueba y buscador. Los textos salen del diccionario de la app
// (wf.*) y del catálogo real (src/lib/workflows/catalog.ts); el flujo es la
// plantilla escalera_seguimiento con un aviso a Slack en la rama "Si ocurre".
import DocsMockup from './DocsMockup.astro';
import DmIcon from './DmIcon.astro';
import type { IconName } from '../../../lib/icons';
import { findAction, findTrigger, TRIGGER_CATEGORIES, WORKFLOW_TRIGGERS, type ActionKey } from '../../../lib/workflows/catalog';
import { WORKFLOW_TEMPLATES } from '../../../lib/workflows/templates';
import { dmT, favicon, pick, tpl, DEMO, type DmLang } from './format';

interface Props {
    lang: DmLang;
    view?: 'editor' | 'test' | 'runs' | 'trigger';
    /** Pie de figura; por defecto describe el estado dibujado. */
    caption?: string;
}
const { lang, view = 'editor' } = Astro.props;
const L = lang;

// Íconos: mismo mapa que src/lib/workflows/icons.ts (categoría o acción → ícono).
const ICON: Record<string, IconName> = {
    quotes: 'quote', invoices: 'invoice', schedule: 'calendar', approvals: 'shield', payments: 'card', clients: 'user', products: 'products', tasks: 'check-square',
    create_task: 'check-square', notify_team: 'bell', send_client_email: 'mail-forward', query: 'search-insight',
    wait_until: 'history', wait: 'clock', condition: 'decision', plus: 'plus', trigger: 'bolt',
};
const BRAND_DOMAIN: Record<string, string> = { slack: 'slack.com', teams: 'teams.microsoft.com', hubspot: 'hubspot.com', whatsapp: 'whatsapp.com' };

const tplEsc = WORKFLOW_TEMPLATES.find((x) => x.key === 'escalera_seguimiento')!;
const trig = findTrigger('quote.sent')!;
const catLabel = (key: string) => TRIGGER_CATEGORIES.find((c) => c.key === key)?.label[L] ?? '';

// Texto de una condición "espera hasta", igual que stepSummary() del editor.
const estadoLabel = (v: string) => trig.fields.find((f) => f.key === 'estado_actual')!.options!.find((o) => o.value === v)!.label[L];
const estadoField = trig.fields.find((f) => f.key === 'estado_actual')!.label[L];
const opEs = L === 'en' ? 'is' : 'es';
const yMas = tpl(dmT(L, 'wf.y_mas'), { n: 1 });
const waitTitle = (v: string) => `${estadoField} ${opEs} ${estadoLabel(v)} ${yMas}`;

const def = tplEsc.definicion(L);
const root = def.steps[0] as any;
const taskTitle = String(root.then[0].params.titulo);
const emailSubject = String(root.else[0].params.asunto);
const slackMsg = L === 'en' ? '{{cliente}} opened {{folio}}: {{total}} {{moneda}}' : '{{cliente}} abrió {{folio}}: {{total}} {{moneda}}';

type NodeData = { kind: 'action' | 'trigger'; icon?: IconName; brand?: string; eyebrow: string; title: string; sub?: string; selected?: boolean };
const actionNode = (key: ActionKey, sub: string, selected = false): NodeData => {
    const a = findAction(key)!;
    return { kind: 'action', icon: ICON[key], brand: a.brand !== 'cord' ? a.brand : undefined, eyebrow: dmT(L, 'wf.accion'), title: a.label[L], sub, selected };
};
const isEditor = view === 'editor';
const N_TASK = actionNode('create_task', taskTitle, isEditor);
const N_SLACK = actionNode('slack_message', slackMsg);
const N_EMAIL = actionNode('send_client_email', emailSubject);

const W = {
    nombre: tplEsc.nombre[L],
    estado: view === 'trigger' ? 'draft' : 'active',
    dirty: view === 'editor' || view === 'test',
};
if (view === 'trigger') W.nombre = L === 'en' ? 'Untitled workflow' : 'Workflow sin título';

// Panel "Editar acción" sobre Crear una tarea.
const TASK = findAction('create_task')!;
const CHIPS = trig.fields.map((f) => ({ label: f.label[L], live: Boolean(f.live) }));

// Prueba sin publicar: resultado de simulateWorkflow() con el último envío real.
const fechaEvento = new Date('2026-10-06T10:42:00').toLocaleString(L === 'en' ? 'en-US' : 'es-MX', { dateStyle: 'medium', timeStyle: 'short' });
const fill = (s: string) => s.split('{{cliente}}').join(DEMO.cliente).split('{{folio}}').join(DEMO.folio).split('{{total}}').join('196,469.2').split('{{moneda}}').join(DEMO.currency);
const TEST = [
    { icon: 'wait_until', title: dmT(L, 'wf.espera_hasta'), r: 'si', label: dmT(L, 'wf.paso.si'), out: [] as string[] },
    { icon: 'action', title: TASK.label[L], r: 'ok', label: dmT(L, 'wf.probar.haria'), out: [`${TASK.params[0].label[L]}: ${fill(taskTitle)}`] },
    { icon: 'action', title: findAction('slack_message')!.label[L], r: 'ok', label: dmT(L, 'wf.probar.haria'), out: [`${findAction('slack_message')!.params[0].label[L]}: ${fill(slackMsg)}`] },
];

// Ejecuciones: lo que devuelve /api/workflows/[id]/runs, ya formateado.
const when = (iso: string) => new Date(iso).toLocaleString(L === 'en' ? 'en-US' : 'es-MX', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
const RUNS = [
    { s: 'queued', sum: `COT-0153 · Ferretería La Huerta`, at: '2026-10-07T17:02:00', open: false },
    {
        s: 'failed', sum: `COT-0151 · Constructora Apex`, at: '2026-10-07T16:20:00', open: true,
        steps: [
            { r: 'si', label: waitTitle('viewed') },
            { r: 'ok', label: TASK.label[L] },
            { r: 'error', label: findAction('slack_message')!.label[L], err: dmT(L, 'wf.err.slack_sin_conexion') },
        ],
        hint: tpl(dmT(L, 'wf.intento'), { n: 3 }),
        retry: true,
    },
    {
        s: 'waiting', sum: `COT-0150 · Grupo Ferretero Altamira`, at: '2026-10-07T09:15:00', open: true,
        steps: [{ r: 'esperando', label: waitTitle('viewed') }],
        hint: tpl(dmT(L, 'wf.continua'), { fecha: when('2026-10-09T09:15:00') }),
        cancel: true,
    },
    { s: 'succeeded', sum: `${DEMO.folio} · ${DEMO.cliente}`, at: '2026-10-06T10:42:00', open: false },
    { s: 'succeeded', sum: `COT-0147 · Aceros del Norte`, at: '2026-10-05T13:08:00', open: false },
    { s: 'succeeded', sum: `COT-0146 · Constructora Apex`, at: '2026-10-03T18:31:00', open: false },
];

// Buscador de disparadores, filtrado por Facturas.
const PICK_CAT = 'invoices';
const PICK = WORKFLOW_TRIGGERS.filter((t) => t.category === PICK_CAT);

const DATA = {
    es: {
        editor: `Editor de la "${tplEsc.nombre.es}": cuando se envía una cotización, espera hasta 2 días a que el cliente la abra. Si ocurre, crea una tarea y avisa en Slack; si se acaba el plazo, le escribe al cliente y vuelve a esperar hasta 5 días. Abierto, el panel "Editar acción" de la tarea con los datos del evento.`,
        test: `Prueba sin publicar con el último envío real (${fechaEvento}): la espera se cumplió y el workflow habría creado la tarea "${fill(taskTitle)}" y avisado en Slack, sin enviar nada.`,
        runs: `Pestaña Ejecuciones: una en cola, una fallida porque Slack no está conectado (con el detalle paso por paso y el botón Reintentar), una en espera que continúa el ${when('2026-10-09T09:15:00')} y varias completadas.`,
        trigger: `Buscador de disparadores de un workflow nuevo, filtrado por Facturas: los ${PICK.length} eventos de facturas, de "${PICK[0].label.es}" a "${PICK[PICK.length - 1].label.es}".`,
    },
    en: {
        editor: `Editor for "${tplEsc.nombre.en}": when a quote is sent, it waits up to 2 days for the client to open it. If that happens, it creates a task and posts to Slack; if the time runs out, it emails the client and waits again for up to 5 days. Open, the task's "Edit action" panel with the event data.`,
        test: `Test without publishing using the latest real send (${fechaEvento}): the wait was met and the workflow would have created the task "${fill(taskTitle)}" and posted to Slack, without sending anything.`,
        runs: `Runs tab: one queued, one failed because Slack is not connected (with the step-by-step detail and the Retry button), one waiting that resumes ${when('2026-10-09T09:15:00')}, and several completed.`,
        trigger: `Trigger search for a new workflow, filtered by Invoices: the ${PICK.length} invoice events, from "${PICK[0].label.en}" to "${PICK[PICK.length - 1].label.en}".`,
    },
};
const caption = Astro.props.caption ?? pick(DATA, L)[view];
const HEIGHT = { editor: 640, test: 600, runs: 690, trigger: 690 }[view];
---
<DocsMockup lang={L} variant="app" chrome="none" height={HEIGHT} caption={caption} class={`dm-wfe-figure dm-wfe-v-${view}`}>
    <div class="dm-wfe">
        <div class="dm-wfe-bar">
            <span class="dm-wfe-close"><DmIcon name="x" /></span>
            <span class="dm-wfe-name">{W.nombre}</span>
            <span class="dm-wfe-badge" data-estado={W.estado}>{dmT(L, `wf.estado.${W.estado}` as any)}</span>
            {W.dirty && <span class="dm-wfe-dirty">{dmT(L, 'wf.cambios_sin_publicar')}</span>}
            <span class="dm-wfe-actions">
                <span class="dm-wfe-btn">{dmT(L, 'wf.probar')}</span>
                <span class="dm-wfe-btn">{dmT(L, 'wf.guardar')}</span>
                <span class="dm-wfe-btn dm-wfe-btn-primary">{W.estado === 'draft' ? dmT(L, 'wf.publicar') : dmT(L, 'wf.publicar_cambios')}</span>
                <span class="dm-wfe-icon-btn"><DmIcon name="more" /></span>
            </span>
        </div>

        <div class="dm-wfe-tabs">
            <span class:list={['dm-wfe-tab', { 'is-on': view !== 'runs' }]}>{dmT(L, 'wf.tab_editor')}</span>
            <span class:list={['dm-wfe-tab', { 'is-on': view === 'runs' }]}>{dmT(L, 'wf.tab_ejecuciones')}</span>
        </div>

        {view === 'runs' ? (
            <div class="dm-wfe-runs">
                <div class="dm-wfe-runs-bar"><span class="dm-wfe-btn">{dmT(L, 'wf.actualizar')}</span></div>
                {RUNS.map((run) => (
                    <div class="dm-wfe-run">
                        <div class="dm-wfe-run-row">
                            <span class="dm-wfe-pill" data-s={run.s}>{dmT(L, `wf.run.${run.s}` as any)}</span>
                            <span class="dm-wfe-run-main">
                                <span class="dm-wfe-run-title">{trig.label[L]}</span>
                                <span class="dm-wfe-run-sum">{run.sum}</span>
                            </span>
                            <span class="dm-wfe-run-when">{when(run.at)}</span>
                        </div>
                        {run.open && (
                            <div class="dm-wfe-run-detail">
                                <div class="dm-wfe-run-steps">
                                    {run.steps!.map((st) => (
                                        <div class="dm-wfe-run-step">
                                            <span class:list={['dm-wfe-res', `is-${st.r}`]}>{dmT(L, `wf.paso.${st.r}` as any)}</span>
                                            <span class="dm-wfe-run-step-main">
                                                <span>{st.label}</span>
                                                {(st as any).err && <span class="dm-wfe-run-err">{(st as any).err}</span>}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                                <span class="dm-wfe-hint">{run.hint}</span>
                                <span class="dm-wfe-run-actions">
                                    {run.retry && <span class="dm-wfe-btn">{dmT(L, 'wf.reintentar')}</span>}
                                    {run.cancel && <span class="dm-wfe-btn">{dmT(L, 'wf.cancelar')}</span>}
                                </span>
                            </div>
                        )}
                    </div>
                ))}
            </div>
        ) : (
            <div class="dm-wfe-stage">
                <div class="dm-wfe-canvas">
                    {view === 'trigger' ? (
                        <div class="dm-wfe-flow">
                            <div class="dm-wfe-node is-empty is-top">
                                <span class="dm-wfe-node-icon"><DmIcon name="plus" /></span>
                                <span class="dm-wfe-node-text">
                                    <span class="dm-wfe-node-eyebrow">{dmT(L, 'wf.cuando')}</span>
                                    <span class="dm-wfe-node-title">{dmT(L, 'wf.agregar_disparador')}</span>
                                </span>
                            </div>
                            <div class="dm-wfe-link"></div>
                            <div class="dm-wfe-node is-empty is-top">
                                <span class="dm-wfe-node-icon"><DmIcon name="plus" /></span>
                                <span class="dm-wfe-node-text">
                                    <span class="dm-wfe-node-eyebrow">{dmT(L, 'wf.haz_esto')}</span>
                                    <span class="dm-wfe-node-title">{dmT(L, 'wf.agregar_paso')}</span>
                                </span>
                            </div>
                        </div>
                    ) : (
                        <div class="dm-wfe-flow">
                            <div class="dm-wfe-node is-top">
                                <span class="dm-wfe-node-icon"><DmIcon name={ICON[trig.category]} /></span>
                                <span class="dm-wfe-node-text">
                                    <span class="dm-wfe-node-eyebrow">{dmT(L, 'wf.cuando')}</span>
                                    <span class="dm-wfe-node-title">{trig.label[L]}</span>
                                    <span class="dm-wfe-node-sub">{catLabel(trig.category)}</span>
                                </span>
                            </div>
                            <div class="dm-wfe-link"><span class="dm-wfe-plus"><DmIcon name="plus" stroke={2} /></span></div>
                            <div class="dm-wfe-cond">
                                <span class="dm-wfe-diamond"><DmIcon name="history" /></span>
                                <div class="dm-wfe-node is-top dm-wfe-cond-summary">
                                    <span class="dm-wfe-node-icon"><DmIcon name="history" /></span>
                                    <span class="dm-wfe-node-text">
                                        <span class="dm-wfe-node-eyebrow">{dmT(L, 'wf.espera_hasta')}</span>
                                        <span class="dm-wfe-node-title">{waitTitle('viewed')}</span>
                                        <span class="dm-wfe-node-sub">{tpl(dmT(L, 'wf.hasta_dias'), { n: 2 })}</span>
                                    </span>
                                    <span class="dm-wfe-node-menu"><DmIcon name="more" /></span>
                                </div>
                                <div class="dm-wfe-branches">
                                    <div class="dm-wfe-branch">
                                        <span class="dm-wfe-branch-label">{dmT(L, 'wf.si_ocurre')}</span>
                                        {[N_TASK, N_SLACK].map((n, i) => (
                                            <Fragment>
                                                {i > 0 && <div class="dm-wfe-link"></div>}
                                                <div class:list={['dm-wfe-node', { 'is-selected': n.selected }]}>
                                                    <span class="dm-wfe-node-icon">{n.brand ? <img class="dm-logo" src={favicon(BRAND_DOMAIN[n.brand])} alt="" width="16" height="16" loading="lazy" decoding="async" /> : <DmIcon name={n.icon!} />}</span>
                                                    <span class="dm-wfe-node-text">
                                                        <span class="dm-wfe-node-eyebrow">{n.eyebrow}</span>
                                                        <span class="dm-wfe-node-title">{n.title}</span>
                                                        <span class="dm-wfe-node-sub">{n.sub}</span>
                                                    </span>
                                                    <span class="dm-wfe-node-menu"><DmIcon name="more" /></span>
                                                </div>
                                            </Fragment>
                                        ))}
                                        <div class="dm-wfe-link"></div>
                                        <div class="dm-wfe-node is-empty">
                                            <span class="dm-wfe-node-icon"><DmIcon name="plus" /></span>
                                            <span class="dm-wfe-node-text">
                                                <span class="dm-wfe-node-eyebrow">{dmT(L, 'wf.haz_esto')}</span>
                                                <span class="dm-wfe-node-title">{dmT(L, 'wf.agregar_paso')}</span>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="dm-wfe-branch">
                                        <span class="dm-wfe-branch-label">{dmT(L, 'wf.si_no_ocurre')}</span>
                                        <div class="dm-wfe-node">
                                            <span class="dm-wfe-node-icon"><DmIcon name={N_EMAIL.icon!} /></span>
                                            <span class="dm-wfe-node-text">
                                                <span class="dm-wfe-node-eyebrow">{N_EMAIL.eyebrow}</span>
                                                <span class="dm-wfe-node-title">{N_EMAIL.title}</span>
                                                <span class="dm-wfe-node-sub">{N_EMAIL.sub}</span>
                                            </span>
                                            <span class="dm-wfe-node-menu"><DmIcon name="more" /></span>
                                        </div>
                                        <div class="dm-wfe-link"></div>
                                        <span class="dm-wfe-diamond"><DmIcon name="history" /></span>
                                        <div class="dm-wfe-node dm-wfe-cond-summary">
                                            <span class="dm-wfe-node-icon"><DmIcon name="history" /></span>
                                            <span class="dm-wfe-node-text">
                                                <span class="dm-wfe-node-eyebrow">{dmT(L, 'wf.espera_hasta')}</span>
                                                <span class="dm-wfe-node-title">{waitTitle('approved')}</span>
                                                <span class="dm-wfe-node-sub">{tpl(dmT(L, 'wf.hasta_dias'), { n: 5 })}</span>
                                            </span>
                                            <span class="dm-wfe-node-menu"><DmIcon name="more" /></span>
                                        </div>
                                        <div class="dm-wfe-link"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}
                    <span class="dm-wfe-zoom">
                        <span><DmIcon name="plus" /></span>
                        <span><DmIcon name="minus" /></span>
                        <span><DmIcon name="expand" /></span>
                    </span>
                </div>

                {view === 'editor' && (
                    <Fragment>
                        <div class="dm-wfe-sheet-scrim"></div>
                        <div class="dm-wfe-panel">
                            <div class="dm-wfe-panel-head">
                                <span class="dm-wfe-panel-title">{dmT(L, 'wf.panel_accion')}</span>
                                <span class="dm-wfe-icon-btn"><DmIcon name="x" /></span>
                            </div>
                            <div class="dm-wfe-panel-body">
                                <div class="dm-wfe-summary">
                                    <span class="dm-wfe-node-icon"><DmIcon name="check-square" /></span>
                                    <span class="dm-wfe-node-text">
                                        <span class="dm-wfe-node-title">{TASK.label[L]}</span>
                                        <span class="dm-wfe-node-sub">{TASK.description[L]}</span>
                                    </span>
                                    <span class="dm-wfe-btn dm-wfe-btn-sm">{dmT(L, 'wf.cambiar')}</span>
                                </div>
                                <div class="dm-wfe-field">
                                    <span class="dm-wfe-label">{TASK.params[0].label[L]}</span>
                                    <span class="dm-wfe-input is-focus">{taskTitle}<i class="dm-wfe-caret"></i></span>
                                </div>
                                <div class="dm-wfe-field">
                                    <span class="dm-wfe-label">{TASK.params[1].label[L]}</span>
                                    <span class="dm-wfe-input">1</span>
                                    <span class="dm-wfe-hint">{TASK.params[1].hint![L]}</span>
                                </div>
                                <div class="dm-wfe-field">
                                    <span class="dm-wfe-label">{dmT(L, 'wf.variables')}</span>
                                    <span class="dm-wfe-hint">{dmT(L, 'wf.variables_hint')}</span>
                                    <span class="dm-wfe-chips">
                                        {CHIPS.map((c) => <span class="dm-wfe-chip">{c.label}{c.live && <small> · {dmT(L, 'wf.en_vivo')}</small>}</span>)}
                                    </span>
                                </div>
                            </div>
                            <div class="dm-wfe-panel-foot"><span class="dm-wfe-btn dm-wfe-btn-primary">{dmT(L, 'wf.listo')}</span></div>
                        </div>
                    </Fragment>
                )}

                {view === 'test' && (
                    <div class="dm-wfe-test">
                        <div class="dm-wfe-test-head">
                            <span class="dm-wfe-panel-title">{dmT(L, 'wf.probar_titulo')}</span>
                            <span class="dm-wfe-icon-btn"><DmIcon name="x" /></span>
                        </div>
                        <span class="dm-wfe-test-sub">{tpl(dmT(L, 'wf.probar_con_evento'), { fecha: fechaEvento }).replace('..', '.')}</span>
                        <div class="dm-wfe-test-steps">
                            {TEST.map((s) => (
                                <div class="dm-wfe-test-step">
                                    <span class="dm-wfe-node-icon"><DmIcon name={s.icon === 'action' ? 'bolt' : 'history'} /></span>
                                    <span class="dm-wfe-node-text">
                                        <span class="dm-wfe-test-title">{s.title}</span>
                                        {s.out.map((o) => <span class="dm-wfe-test-out">{o}</span>)}
                                    </span>
                                    <span class="dm-wfe-test-res" data-r={s.r}>{s.label}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                )}

            </div>
        )}
    </div>
    {view === 'trigger' && (
        <div slot="overlay" class="dm-wfe-overlay">
            <div class="dm-scrim"></div>
            <div class="dm-wfe-picker">
                <div class="dm-wfe-picker-top">
                    <span class="dm-wfe-search"><DmIcon name="search" /><span>{dmT(L, 'wf.buscar_disparador')}</span></span>
                    <span class="dm-wfe-chips">
                        <span class="dm-wfe-chip">{dmT(L, 'wf.todos')}</span>
                        {TRIGGER_CATEGORIES.map((c) => <span class:list={['dm-wfe-chip', { 'is-on': c.key === PICK_CAT }]}>{c.label[L]}</span>)}
                    </span>
                </div>
                <div class="dm-wfe-picker-list">
                    {PICK.map((t) => (
                        <div class="dm-wfe-picker-item">
                            <span class="dm-wfe-node-icon"><DmIcon name={ICON[t.category]} /></span>
                            <span class="dm-wfe-picker-lbl">{t.label[L]}</span>
                            <span class="dm-wfe-picker-cat">{catLabel(t.category)}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    )}
</DocsMockup>

<style is:global>
    /* El editor ocupa la ventana completa: sin topbar, con su propia barra. */
    .dm-wfe-figure .dm-content { padding: 14px 14px 0; display: flex; flex-direction: column; }
    .dm-wfe-figure .dm-main, .dm-wfe-figure .dm-app { align-self: stretch; }
    .dm-wfe { display: flex; flex-direction: column; gap: 10px; padding-right: var(--dm-bleed); flex: 1 0 auto; }

