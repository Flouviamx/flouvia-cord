---
// Mockup: Inicio (/app) en escritorio. Calca de src/pages/app/index.astro:
//   - arriba a la derecha, el botón "Personalizar" (icono de controles deslizantes,
//     WidgetCustomizeButtons.astro); en edición se cambia por Biblioteca,
//     Restablecer y Listo (eso lo dibuja DmWidgetLibrary);
//   - hero de dinero fijo: píldoras Cerrado / Cobrado / Cotizado, el monto del
//     periodo, la variación "vs. periodo anterior", el selector de fechas en
//     "Últimos 30 días" (pastilla gris; el rango se recuerda en el navegador, no va
//     en la URL), la nota del rango, la nota de divisa (MonedaNota: el negocio
//     también vende en USD y EUR) y la gráfica del periodo;
//   - la cuadrícula de widgets en su orden por defecto: Por cerrar, Tasa de cierre,
//     Ticket promedio, Por dar seguimiento, Embudo de conversión, Pipeline,
//     Tendencia mensual, Antigüedad de cartera, Flujo esperado · 5 semanas, Salud
//     del pipeline y los rankings (lo que sigue — Necesitan seguimiento, Recientes,
//     Actividad y Tareas — queda bajo el corte).
// Los KPI que siguen al rango (TrendKpi) llevan su variación contra el periodo
// anterior — en puntos para la tasa — y su minigráfica o barra con el acento del
// tono del widget. Cada widget lleva su alcance (Hoy / Rango) como la ScopeTag
// real. Gráficas en SVG propio con la paleta de la app; el pipeline y la cartera
// usan los colores de STATUS_META y de getCobranza().
import DocsMockup from './DocsMockup.astro';
import DmIcon from './DmIcon.astro';
import { STATUS_META } from '../../../lib/quote';
import { dmT, dmMoneyParts, dmMoney, pick, tpl, type DmLang } from './format';
import { BOARD_TOTALS, OPEN_VALUE, money0Parts } from './dm-gestion';
import { CERRADO_30, TICKET_30, VENTAS_30, monedaNota } from './dm-informes';

interface Props {
    lang: DmLang;
    caption?: string;
}
const { lang } = Astro.props;
const es = lang !== 'en';

const HERO = CERRADO_30;
const DELTA = 18;

// Serie diaria de 30 días (cerrado), determinista y escalada al total del hero.
const raw = Array.from({ length: 30 }, (_, i) => {
    const wave = Math.sin(i / 2.3) * 0.5 + Math.sin(i / 5.1 + 1) * 0.35;
    const weekend = i % 7 === 5 || i % 7 === 6 ? 0.55 : 1;
    return Math.max(0.08, (1 + wave + ((i * 37) % 11) / 14) * weekend + i * 0.03);
});
const rawSum = raw.reduce((a, b) => a + b, 0);
const daily = raw.map((v) => (v / rawSum) * HERO);
const W = 600;
const H = 130;
const maxD = Math.max(...daily) * 1.12;
const pts = daily.map((v, i) => [(i / (daily.length - 1)) * W, H - (v / maxD) * H] as const);
// Curva suave (Catmull-Rom → Bézier), como la línea de chart.ts.
const f1 = (n: number) => n.toFixed(1);
const line = pts.reduce((acc, [x, y], i) => {
    if (i === 0) return `M${f1(x)},${f1(y)}`;
    const [x0, y0] = pts[i - 2] ?? pts[i - 1];
    const [x1, y1] = pts[i - 1];
    const [x3, y3] = pts[i + 1] ?? [x, y];
    const c1x = x1 + (x - x0) / 6, c1y = y1 + (y - y0) / 6;
    const c2x = x - (x3 - x1) / 6, c2y = y - (y3 - y1) / 6;
    return `${acc} C${f1(c1x)},${f1(c1y)} ${f1(c2x)},${f1(c2y)} ${f1(x)},${f1(y)}`;
}, '');
const area = `${line} L${W},${H} L0,${H} Z`;

const SENT = BOARD_TOTALS.sent.total;
const VIEWED = BOARD_TOTALS.viewed.total;
const POR_CERRAR = SENT + VIEWED;
const FUNNEL = [
    { key: 'dash.funnel_enviadas', v: 32 },
    { key: 'dash.funnel_vistas', v: 26 },
    { key: 'dash.funnel_aprobadas', v: 14 },
    { key: 'dash.funnel_pagadas', v: 11 },
] as const;
const PIPE = (['draft', 'sent', 'viewed', 'approved', 'paid'] as const).map((k) => ({ k, ...BOARD_TOTALS[k] }));
const pipeTotal = PIPE.reduce((s, p) => s + p.total, 0);
const WEEKS = [
    { es: '9 sep', en: 'Sep 9', cot: 412000, cer: 214000 },
    { es: '16 sep', en: 'Sep 16', cot: 538000, cer: 296000 },
    { es: '23 sep', en: 'Sep 23', cot: 466000, cer: 241000 },
    { es: '30 sep', en: 'Sep 30', cot: 590000, cer: 318000 },
    { es: '7 oct', en: 'Oct 7', cot: 503000, cer: 215500 },
];
const maxW = Math.max(...WEEKS.map((w) => w.cot)) * 1.08;

// Minigráfica del Ticket promedio (sparkValues: un punto por día del rango) con área.
const spark = [42, 48, 45, 51, 49, 55, 52, 58, 54, 60, 57, 62, 59, 64];
const sp = spark.map((v, i) => [(i / (spark.length - 1)) * 100, 30 - ((v - 40) / 26) * 26] as const);
const sparkLine = sp.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const sparkArea = `${sparkLine} L100,32 L0,32 Z`;

// Cartera por antigüedad (getCobranza: cubetas y colores fijos). Suma = saldo de los clientes.
const AGING = [
    { key: 'vigente', v: 113620, color: '#3b82f6' },
    { key: 'd30', v: 64380, color: '#f59e0b' },
    { key: 'd60', v: 10000, color: '#f97316' },
    { key: 'd60p', v: 87310, color: '#ef4444' },
];
const agingTotal = AGING.reduce((s, a) => s + a.v, 0);
const R = 15.9155;
let acc = 0;
const ARCS = AGING.map((a) => {
    const len = (a.v / agingTotal) * 100;
    const arc = { ...a, dash: `${Math.max(0, len - 1.2).toFixed(2)} ${(100 - Math.max(0, len - 1.2)).toFixed(2)}`, off: (25 - acc).toFixed(2) };
    acc += len;
    return arc;
});

// Flujo esperado · 5 semanas (getCFO().semanas: "9 oct – 15 oct" y "{n} cot.").
const FLUJO = [
    { es: '9 – 15 oct', en: 'Oct 9 – 15', v: 186400, n: 3 },
    { es: '16 – 22 oct', en: 'Oct 16 – 22', v: 142700, n: 2 },
    { es: '23 – 29 oct', en: 'Oct 23 – 29', v: 96300, n: 2 },
    { es: '30 oct – 5 nov', en: 'Oct 30 – Nov 5', v: 61480, n: 1 },
    { es: '6 – 12 nov', en: 'Nov 6 – 12', v: 38600, n: 1 },
];
const maxF = Math.max(...FLUJO.map((f) => f.v)) * 1.1;

// Salud del pipeline: cuatro anillos (mountGauge) con el tono de cada umbral.
const ESPERADO = 298400;
const TONE = { ok: '#10b981', warn: '#f59e0b', danger: '#ef4444', neutral: '#0a192f' } as const;
const GAUGES = [
    { label: 'dash.dso_label', v: 34, max: 90, sfx: 'd', tone: 'warn' as const, sub: 'dash.dso_warn', dot: true },
    { label: 'dash.conc_label', v: 31, max: 100, sfx: '%', tone: 'ok' as const, sub: 'dash.conc_ok', dot: true },
    { label: 'dash.margen_label', v: 8, max: 50, sfx: '%', tone: 'ok' as const, sub: 'dash.margen_sub', dot: false },
    { label: 'dash.ingreso_esperado_label', v: Math.round((ESPERADO / OPEN_VALUE) * 100), max: 100, sfx: '%', tone: 'neutral' as const, sub: '', dot: false },
];

// Rankings del rango: clientes por tasa de aprobación (con muestra) y productos por ingreso.
const RANK_CLI = [
    { n: 'Acabados Monterrey', v: 75, s: '3/4' },
    { n: 'Distribuidora El Zarco', v: 71, s: '5/7' },
    { n: 'Constructora GAMA', v: 67, s: '4/6' },
    { n: 'Ferretera Industrial del Bajío', v: 67, s: '4/6' },
    { n: 'Northline Builders', v: 67, s: '2/3' },
];
const RANK_PROD = {
    es: [['Cemento gris CPC 30R · 50 kg', 412800], ['Varilla corrugada 3/8" × 12 m', 356400], ['Block hueco 15 × 20 × 40 cm', 198700], ['Malla electrosoldada 6×6', 142300], ['Flete a obra', 64500]],
    en: [['Gray cement CPC 30R · 50 kg', 412800], ['Rebar 3/8" × 12 m', 356400], ['Hollow block 15 × 20 × 40 cm', 198700], ['Welded wire mesh 6×6', 142300], ['Delivery to site', 64500]],
}[lang] as [string, number][];

const DATA = {
    es: {
        caption: `Inicio en escritorio: el botón Personalizar arriba a la derecha; el indicador de dinero con Cerrado, Cobrado y Cotizado muestra ${dmMoney(HERO, 'MXN', 'es')} cerrados en los últimos 30 días, +${DELTA} % vs. periodo anterior, con la nota del rango y la de divisa (las ventas en USD y EUR se suman convertidas a MXN). Debajo, los widgets en su orden por defecto, cada uno con su alcance Hoy o Rango: Por cerrar, Tasa de cierre (38 %, +4 pts), Ticket promedio (+6 %), Por dar seguimiento, Embudo de conversión, Pipeline, Tendencia mensual, Antigüedad de cartera, Flujo esperado · 5 semanas, Salud del pipeline y los rankings de clientes y productos.`,
        conv: 'Conversión de principio a fin',
    },
    en: {
        caption: `Home on desktop: the Customize button at the top right; the money indicator with Closed, Collected and Quoted shows ${dmMoney(HERO, 'MXN', 'en')} closed in the last 30 days, +${DELTA}% vs. the previous period, with the range note and the currency note (sales in USD and EUR are added converted to MXN). Below, the widgets in their default order, each with its Today or Range scope: In progress, Close rate (38%, +4 pts), Average ticket (+6%), Needs follow-up, Conversion funnel, Pipeline, Monthly trend, Receivables aging, Expected cash flow · 5 weeks, Pipeline health and the client and product rankings.`,
        conv: 'End-to-end conversion',
    },
};
const d = pick(DATA, lang);
const caption = Astro.props.caption ?? d.caption;
const M = (n: number) => money0Parts(n, 'MXN', lang);
const heroParts = dmMoneyParts(HERO, 'MXN', lang);
const g = (k: string) => dmT(lang, k as any);
---
<DocsMockup lang={lang} variant="app" chrome="full" sidebar="rail" active="dashboard" title={dmT(lang, 'dash.heading')} badges={{ seguimiento: 2 }} height={1500} caption={caption} class="dm-hm-figure">
    <span slot="actions" class="dm-hm-custom"><DmIcon name="sliders" />{g('widgets.personalizar')}</span>

    <div class="dm-surface dm-hm-hero">
        <div class="dm-hm-hero-top">
            <div>
                <div class="dm-hm-metrics">
                    <span class="is-on">{g('dash.hero_metric_cerrado')}</span>
                    <span>{g('dash.hero_metric_cobrado')}</span>
                    <span>{g('dash.hero_metric_cotizado')}</span>
                </div>
                <div class="dm-hm-hero-row">
                    <span class="dm-money dm-hm-hero-num">{heroParts.value}<span class="dm-cur">{heroParts.code}</span></span>
                    <span class="dm-hm-delta"><DmIcon name="arrow-up" stroke={2.5} />{DELTA}%<span>{g('dash.hero_vs_periodo')}</span></span>
                </div>
            </div>
            <span class="dm-hm-range"><DmIcon name="calendar" />{g('dash.dp_ultimos30')}<DmIcon name="chevron-down" /></span>
        </div>
        <span class="dm-hm-note">{g('dash.rango_nota')}</span>
        <span class="dm-hm-moneda"><DmIcon name="info" />{monedaNota(lang)}</span>
        <div class="dm-hm-chart">
            <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                {[0.25, 0.5, 0.75].map((f) => <line x1="0" x2={W} y1={H * f} y2={H * f} class="dm-hm-grid"></line>)}
                <path d={area} class="dm-hm-area"></path>
                <path d={line} class="dm-hm-line" vector-effect="non-scaling-stroke"></path>
            </svg>
            <div class="dm-hm-xs">{(es ? ['9 sep', '16 sep', '23 sep', '30 sep', '7 oct'] : ['Sep 9', 'Sep 16', 'Sep 23', 'Sep 30', 'Oct 7']).map((x) => <span>{x}</span>)}</div>
        </div>
    </div>

    <div class="dm-hm-grid4">
        <div class="dm-surface dm-hm-kpi">
            <span class="dm-hm-kpi-head"><span class="dm-kpi-label">{g('dash.kpi_por_cerrar')}</span><span class="dm-hm-scope">{g('widgets.scope_hoy')}</span></span>
            <span class="dm-money dm-hm-kpi-num">{M(POR_CERRAR).value}<span class="dm-cur">MXN</span></span>
            <span class="dm-kpi-sub">{tpl(g('dash.kpi_cotizaciones_activas'), { n: BOARD_TOTALS.sent.n + BOARD_TOTALS.viewed.n })}</span>
            <span class="dm-hm-split"><i style={`flex-grow:${SENT};background:${STATUS_META.sent.color}`}></i><i style={`flex-grow:${VIEWED};background:${STATUS_META.viewed.color}`}></i></span>
            <span class="dm-hm-legend">
                <span><i style={`background:${STATUS_META.sent.color}`}></i>{g('cot.col.sent')} <b>{M(SENT).value}</b></span>
                <span><i style={`background:${STATUS_META.viewed.color}`}></i>{g('cot.col.viewed')} <b>{M(VIEWED).value}</b></span>
            </span>
        </div>
        <div class="dm-surface dm-hm-kpi">
            <span class="dm-hm-kpi-head"><span class="dm-kpi-label">{g('dash.kpi_tasa_cierre')}</span><span class="dm-hm-scope is-range">{g('widgets.scope_rango')}</span></span>
            <span class="dm-hm-kpi-row"><span class="dm-editorial dm-hm-kpi-num">38%</span><span class="dm-hm-up"><DmIcon name="arrow-up" stroke={2.4} />4 pts</span></span>
            <span class="dm-kpi-sub">{tpl(g('dash.kpi_tasa_sub'), { g: 12, n: 32 })}</span>
            <span class="dm-hm-progress"><i style="width:38%"></i></span>
        </div>
        <div class="dm-surface dm-hm-kpi">
            <span class="dm-hm-kpi-head"><span class="dm-kpi-label">{g('dash.kpi_ticket_promedio')}</span><span class="dm-hm-scope is-range">{g('widgets.scope_rango')}</span></span>
            <span class="dm-hm-kpi-row"><span class="dm-money dm-hm-kpi-num">{M(TICKET_30).value}<span class="dm-cur">MXN</span></span><span class="dm-hm-up"><DmIcon name="arrow-up" stroke={2.4} />6%</span></span>
            <span class="dm-kpi-sub">{tpl(g('dash.kpi_ticket_n'), { n: VENTAS_30 })}</span>
            <svg class="dm-hm-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true"><path d={sparkArea} class="a"></path><path d={sparkLine} class="l" vector-effect="non-scaling-stroke"></path></svg>
        </div>
        <div class="dm-surface dm-hm-kpi">
            <span class="dm-hm-kpi-head"><span class="dm-kpi-label">{g('dash.kpi_por_seguimiento')}</span><span class="dm-hm-scope">{g('widgets.scope_hoy')}</span></span>
            <span class="dm-editorial dm-hm-kpi-num is-warn">2</span>
            <span class="dm-kpi-sub">{g('dash.kpi_vista_plural')}</span>
        </div>
    </div>

    <div class="dm-hm-grid2">
        <div class="dm-surface dm-hm-card">
            <div class="dm-hm-sechead"><span>{g('dash.funnel_titulo')}<span class="dm-hm-scope is-range">{g('widgets.scope_rango')}</span></span></div>
            <div class="dm-hm-funnel">
                {FUNNEL.map((f, i) => (
                    <div class="dm-hm-frow">
                        <span class="dm-hm-fbar" style={`width:${Math.max(30, (f.v / FUNNEL[0].v) * 100)}%;opacity:${(1 - i * (0.55 / 3)).toFixed(2)}`}><span>{g(f.key)}</span><b>{f.v}</b></span>
                        <span class="dm-hm-fnote">{i > 0 ? `${Math.round((f.v / FUNNEL[i - 1].v) * 100)}%` : ''}</span>
                    </div>
                ))}
            </div>
            <span class="dm-hm-conv">{d.conv} <b>{Math.round((FUNNEL[3].v / FUNNEL[0].v) * 100)}%</b></span>
        </div>
        <div class="dm-surface dm-hm-card">
            <div class="dm-hm-sechead"><span>{g('dash.pipeline_titulo')}<span class="dm-hm-scope">{g('widgets.scope_hoy')}</span></span><span class="dm-hm-link">{g('dash.ver_todas')}</span></div>
            <span class="dm-hm-segbar">{PIPE.map((p) => <i style={`flex-grow:${p.total};background:${STATUS_META[p.k].color}`}></i>)}</span>
            <div class="dm-hm-seglegend">
                {PIPE.map((p) => (
                    <span class="dm-hm-segrow">
                        <i style={`background:${STATUS_META[p.k].color}`}></i>
                        <span class="dm-hm-seglabel">{g(`cot.col.${p.k}`)} · {p.n}</span>
                        <span class="dm-money">{M(p.total).value}<span class="dm-cur">MXN</span></span>
                        <span class="dm-hm-segpct">{Math.round((p.total / pipeTotal) * 100)}%</span>
                    </span>
                ))}
            </div>
        </div>
    </div>

    <div class="dm-surface dm-hm-card">
        <div class="dm-hm-sechead">
            <span>{g('dash.tendencia_titulo')}<span class="dm-hm-scope is-range">{g('widgets.scope_rango')}</span></span>
            <span class="dm-hm-tlegend"><span><i class="is-cot"></i>{g('dash.tendencia_cotizado')}</span><span><i class="is-cer"></i>{g('dash.tendencia_cerrado')}</span></span>
        </div>
        <div class="dm-hm-bars">
            {WEEKS.map((w) => (
                <div class="dm-hm-bcol">
                    <span class="dm-hm-bpair">
                        <i class="is-cot" style={`height:${((w.cot / maxW) * 100).toFixed(1)}%`}></i>
                        <i class="is-cer" style={`height:${((w.cer / maxW) * 100).toFixed(1)}%`}></i>
                    </span>
                    <span class="dm-hm-blabel">{w[lang]}</span>
                </div>
            ))}
        </div>
    </div>

    <div class="dm-hm-grid2">
        <div class="dm-surface dm-hm-card">
            <div class="dm-hm-sechead"><span>{g('dash.aging_titulo')}<span class="dm-hm-scope">{g('widgets.scope_hoy')}</span></span></div>
            <div class="dm-hm-donut">
                <span class="dm-hm-donut-stage">
                    <svg viewBox="0 0 42 42" aria-hidden="true">
                        <circle cx="21" cy="21" r={R} class="trk"></circle>
                        {ARCS.map((a) => <circle cx="21" cy="21" r={R} stroke={a.color} stroke-dasharray={a.dash} stroke-dashoffset={a.off}></circle>)}
                    </svg>
                    <span class="dm-hm-donut-c"><b>{M(agingTotal).value}</b><span class="dm-cur">MXN</span></span>
                </span>
                <span class="dm-hm-donut-legend">
                    {AGING.map((a) => <span><i style={`background:${a.color}`}></i><span class="l">{g(`cob.aging_${a.key}`)}</span><span class="dm-money">{M(a.v).value}</span></span>)}
                </span>
            </div>
        </div>
        <div class="dm-surface dm-hm-card">
            <div class="dm-hm-sechead"><span>{g('dash.flujo_titulo')}<span class="dm-hm-scope">{g('widgets.scope_hoy')}</span></span><span class="dm-hm-link">{g('dash.tesoreria')}</span></div>
            <div class="dm-hm-flow">
                {FLUJO.map((f) => (
                    <div class="dm-hm-fcol">
                        <span class="dm-hm-fv">{M(f.v).value}</span>
                        <span class="dm-hm-ftrack"><i style={`height:${((f.v / maxF) * 100).toFixed(1)}%`}></i></span>
                        <span class="dm-hm-fl">{f[lang]}</span>
                        <span class="dm-hm-fs">{tpl(g('dash.n_cot'), { n: f.n })}</span>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <div class="dm-surface dm-hm-card">
        <div class="dm-hm-sechead"><span>{g('dash.salud_titulo')}<span class="dm-hm-scope">{g('widgets.scope_hoy')}</span></span><span class="dm-hm-link">{g('dash.ver_cfo')}</span></div>
        <div class="dm-hm-health">
            {GAUGES.map((x) => {
                const pct = Math.min(1, x.v / x.max) * 100;
                return (
                    <div class="dm-hm-hcell">
                        <span class="dm-hm-gauge">
                            <svg viewBox="0 0 42 42" aria-hidden="true"><circle cx="21" cy="21" r={R} class="trk"></circle><circle cx="21" cy="21" r={R} stroke={TONE[x.tone]} stroke-dasharray={`${pct.toFixed(1)} ${(100 - pct).toFixed(1)}`} stroke-dashoffset="25" class="val"></circle></svg>
                            <b>{x.v}{x.sfx}</b>
                        </span>
                        <span class="dm-hm-hlabel">{g(x.label)}</span>
                        <span class="dm-hm-hsub">{x.dot && <i style={`background:${TONE[x.tone]}`}></i>}{x.sub ? g(x.sub) : tpl(g('dash.de_pipeline'), { monto: `${M(OPEN_VALUE).value} MXN` })}</span>
                    </div>
                );
            })}
        </div>
    </div>

    <div class="dm-hm-grid2">
        <div class="dm-surface dm-hm-card">
            <div class="dm-hm-sechead"><span>{g('dash.rank_clientes_titulo')}<span class="dm-hm-scope is-range">{g('widgets.scope_rango')}</span></span></div>
            <div class="dm-hm-rank">{RANK_CLI.map((r) => <span class="dm-hm-rrow"><span class="n">{r.n}</span><span class="t"><i style={`width:${r.v}%`}></i></span><span class="v">{r.v}%</span></span>)}</div>
        </div>
        <div class="dm-surface dm-hm-card">
            <div class="dm-hm-sechead"><span>{g('dash.rank_productos_titulo')}<span class="dm-hm-scope is-range">{g('widgets.scope_rango')}</span></span></div>
            <div class="dm-hm-rank is-ok">{RANK_PROD.map(([n, v]) => <span class="dm-hm-rrow"><span class="n">{n}</span><span class="t"><i style={`width:${((v / RANK_PROD[0][1]) * 100).toFixed(1)}%`}></i></span><span class="v">{M(v).value}</span></span>)}</div>
        </div>
    </div>
</DocsMockup>

<style is:global>
    .dm-hm-figure .dm-page-head { padding-right: calc(20px + var(--dm-bleed)); }
    .dm-hm-figure .dm-content { padding-right: calc(20px + var(--dm-bleed)); display: flex; flex-direction: column; gap: 10px; }
    /* "Personalizar" (.widget-edit-btn.is-customize): superficie blanca, hairline y sombra de contacto. */
    .dm-hm-custom { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px 0 10px; border-radius: 999px; background: #fff; border: 1px solid var(--dm-border); box-shadow: 0 1px 2px rgba(10, 25, 47, 0.06); font-size: 11px; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
