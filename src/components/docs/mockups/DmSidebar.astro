---
// Sidebar de la app dentro de un mockup. Sale de la MISMA fuente que la real
// (SIDEBAR_NAV + diccionario de la app): grupos, orden, iconos y nombres no se
// copian a mano. La usa DocsMockup con chrome="full".
import { SIDEBAR_NAV } from '../../../lib/sidebar-nav';
import DmIcon from './DmIcon.astro';
import { dmT, DEMO, type DmLang } from './format';

interface Props {
    lang: DmLang;
    /** id de SIDEBAR_NAV activo: dashboard, cotizaciones, clientes, productos, facturas, cobros, cobranza, ai-ar, informes, desempeno, workflows. */
    active?: string;
    org?: string;
    /** Contadores accionables, como en la app: cotizaciones vistas sin responder y cuentas vencidas. */
    badges?: { seguimiento?: number; vencidas?: number };
    /** Rail colapsado (68 px en la app): solo iconos; los contadores se vuelven un punto. */
    rail?: boolean;
}
const { lang, active = 'dashboard', org = DEMO.org, badges = {}, rail = false } = Astro.props;
const eyebrow = lang === 'en' ? 'Workspace' : 'Espacio de trabajo';
const inSection = (it: (typeof SIDEBAR_NAV)[number]['items'][number]) => it.id === active || !!it.children?.some((c) => c.id === active);
---
<div class:list={['dm-sidebar', { 'is-rail': rail }]}>
    <div class="dm-sb-org">
        <span class="dm-sb-org-av">{org.trim().charAt(0).toUpperCase()}</span>
        <span class="dm-sb-org-text">
            <span class="dm-sb-org-eyebrow">{eyebrow}</span>
            <span class="dm-sb-org-name">{org}</span>
        </span>
        <DmIcon name="chevrons-updown" />
    </div>
    {SIDEBAR_NAV.map((group) => (
        <div class="dm-sb-group">
            {group.label && <div class="dm-sb-label">{dmT(lang, group.label)}</div>}
            {group.items.map((it) => {
                const n = it.badge ? badges[it.badge] ?? 0 : 0;
                return (
                    <Fragment>
                        <div class:list={['dm-sb-item', { 'is-active': it.id === active }]}>
                            <DmIcon name={it.icon} />
                            <span class="dm-sb-item-label">{dmT(lang, it.label)}</span>
                            {n > 0 && <span class:list={['dm-sb-badge', { 'is-danger': it.badge === 'vencidas' }]}>{n}</span>}
                        </div>
                        {it.children && inSection(it) && (
                            <div class="dm-sb-sub">
                                {it.children.map((c) => (
                                    <div class:list={['dm-sb-item', { 'is-active': c.id === active }]}>
                                        <DmIcon name={c.icon} />
                                        <span class="dm-sb-item-label">{dmT(lang, c.label)}</span>
                                    </div>
                                ))}
                            </div>
                        )}
                    </Fragment>
                );
            })}
        </div>
    ))}
</div>
