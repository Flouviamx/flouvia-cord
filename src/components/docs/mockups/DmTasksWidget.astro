---
// Mockup: widget "Tareas y recordatorios" del Inicio. Calca del widget `tareas` de
// src/pages/app/index.astro, que monta TaskBoard variant="widget": título y "Ver
// todas", el segmentado Mías / Todas (con equipo, abre en Mías), el capturador con
// sus atajos, prioridad y responsable, y la lista agrupada por vencimiento con un
// tope de 8 filas.
//
// Las tareas son las de dm-tasks.ts, las MISMAS que DmTasksPage: en "Mías" quedan
// las cinco de Ana Torres, todas con su avatar navy.
//
// Con `bare` dibuja solo el contenido del widget (sin marco) para reutilizarlo
// dentro de DmHome; sin `bare` es una figura propia (variant="panel").
import DocsMockup from './DocsMockup.astro';
import TkBoard from './TkBoard.astro';
import { pick, type DmLang } from './format';
import { dmTaskGroups } from './dm-tasks';
import { SELLER } from './dm-gestion';

interface Props {
    lang: DmLang;
    bare?: boolean;
    caption?: string;
}
const { lang, bare = false } = Astro.props;
const n = dmTaskGroups(lang, 'mias').total;

const DATA = {
    es: {
        caption: `Widget Tareas y recordatorios del Inicio en el filtro Mías: el capturador "Ej. Llamar a GAMA para dar seguimiento…" con Agregar, los atajos Hoy, Mañana y Lunes, la fecha, Prioridad alta y el responsable ${SELLER} (yo); debajo, las ${n} tareas de ${SELLER} agrupadas en Vencidas (el contracargo de COT-0153 con la etiqueta ALTA), Hoy, Mañana, Esta semana y Sin fecha.`,
    },
    en: {
        caption: `Home "Tasks and reminders" widget on the Mine filter: the "E.g. Call GAMA for a follow-up…" composer with Add, the Today, Tomorrow and Monday shortcuts, the date, High priority and the assignee ${SELLER} (me); below, ${SELLER}'s ${n} tasks grouped into Overdue (the COT-0153 chargeback with the HIGH tag), Today, Tomorrow, This week and No date.`,
    },
};
const d = pick(DATA, lang);
const caption = Astro.props.caption ?? d.caption;
---
{bare ? (
    <TkBoard lang={lang} variant="widget" scope="mias" />
) : (
    <DocsMockup lang={lang} variant="panel" panelWidth={560} caption={caption} class="dm-tw-figure">
        <TkBoard lang={lang} variant="widget" scope="mias" />
    </DocsMockup>
)}
