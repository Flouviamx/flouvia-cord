---
// Tabla de líneas del editor de documentos para los mockups de docs.
// Calca de rowHtml() en src/lib/editor/document-editor.ts: agarre para
// reordenar, nombre con la unidad (y el precio sugerido si lo hay), cantidad,
// Lista (tachada solo cuando el precio pactado es menor), Precio en verde
// cuando baja de la lista, impuesto (solo si la cuenta tiene varias tasas),
// importe, margen en rojo bajo el mínimo de Aprobaciones y las acciones de la
// fila (duplicar y quitar).
//
// No empieza con "Dm": no se registra como etiqueta del MDX; es una pieza
// interna de DmCotAiBlock, DmCotLines y DmCotClientStep.
import './dm-cot-editor.css';
import DmIcon from './DmIcon.astro';
import DmMoney from './DmMoney.astro';
import { getDocumentEditorI18n } from '../../../i18n/app';
import type { DmLang } from './format';

export interface CotLine {
    name: string;
    unit: string;
    qty: number;
    lista: number;
    /** Precio pactado; si falta, se cobra el de lista. */
    nego?: number;
    /** Etiqueta del impuesto de la línea ("IVA 16%"). */
    tax?: string;
    /** Costo unitario; sin costo el margen es "—". */
    costo?: number;
    /** Texto extra bajo el nombre (precio sugerido). Se pinta como el botón punteado de la app. */
    hint?: string;
    added?: boolean;
    /** Fila bajo el puntero: muestra el agarre y las acciones a pleno color. */
    hover?: boolean;
}
interface Props {
    lang: DmLang;
    lines: CotLine[];
    currency?: string;
    showTax?: boolean;
    /** Margen mínimo de Ajustes › Aprobaciones (0 = sin tope). */
    marginMin?: number;
    taxLabel?: string;
}
const { lang, lines, currency = 'MXN', showTax = true, marginMin = 0, taxLabel = 'IVA' } = Astro.props;
const T = getDocumentEditorI18n(lang);
const loc = lang === 'en' ? 'en-US' : 'es-MX';
const num = (n: number) => n.toLocaleString(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---
<div class:list={['dm-ced-lines', { 'no-tax': !showTax }]}>
    <div class="dm-ced-lh">
        <span></span><span>{T.thConcept}</span><span class="is-right">{T.thQty}</span><span class="is-right">{T.thList}</span><span class="is-right">{T.thPrice}</span>
        {showTax && <span>{taxLabel}</span>}
        <span class="is-right">{T.thAmount}</span><span class="is-center">{T.thMargin}</span><span></span>
    </div>
    {lines.map((l) => {
        const precio = l.nego ?? l.lista;
        const deal = l.nego !== undefined && l.nego < l.lista;
        const m = l.costo && precio > 0 ? ((precio - l.costo) / precio) * 100 : null;
        const low = m !== null && marginMin > 0 && m < marginMin;
        return (
            <div class:list={['dm-ced-lr', { 'is-added': l.added, 'is-hover': l.hover }]}>
                <span class="dm-ced-grip"><DmIcon name="grip" /></span>
                <span class="dm-ced-name">
                    <span class="dm-ced-name-main">{l.name}</span>
                    <small>{l.unit}{l.hint && <> · <span class="dm-ced-hintp">{l.hint}</span></>}</small>
                </span>
                <span class="dm-ced-in dm-ced-qty">{l.qty.toLocaleString(loc)}</span>
                <span class:list={['dm-ced-lista', { 'is-struck': deal }]}><DmMoney amount={l.lista} currency={currency} lang={lang} /></span>
                <span class:list={['dm-ced-in dm-ced-nego', { 'is-deal': deal }]}>{num(precio)}</span>
                {showTax && <span class="dm-ced-tax">{l.tax}</span>}
                <span class="dm-ced-imp"><DmMoney amount={precio * l.qty} currency={currency} lang={lang} /></span>
                <span class:list={['dm-ced-mg', { 'is-low': low, 'is-na': m === null }]}>{m === null ? '—' : `${Math.round(m)}%`}</span>
                <span class="dm-ced-acts"><DmIcon name="copy" /><DmIcon name="x" /></span>
            </div>
        );
    })}
</div>
