---
// Mockup: Informes › Resumen (/app/informes?r=resumen) con el selector de informes
// abierto. Calca de src/pages/app/informes.astro + ReportPicker.astro +
// informes/ResumenReport.astro.
// En la app la lista de informes NO es una columna fija: es el panel del selector
// (arriba, junto al rango de fechas), con su buscador "Buscar informes" y los 15
// informes agrupados por categoría en el orden de REPORT_GROUPS — Resumen, Ventas,
// Clientes, Productos, Finanzas, Equipo y Personalizados —, cada uno con su icono
// y "Por rango de fechas" o "Al día de hoy" según su alcance. Los informes
// guardados van al final de Personalizados, con el pin y "Informe guardado". El
// catálogo sale de REPORTS (src/lib/informes.ts), así que un informe nuevo aparece
// aquí solo.
//
// El panel real mide como máximo 560 px y hace scroll: `scroll="top"` (por
// defecto) lo dibuja recién abierto; `scroll="end"` desplazado hasta abajo, con
// Finanzas, Equipo, Personalizados y los guardados. La madurez de la cohorte es una barra segmentada
// (Ganado / Perdido / Aún abierto), como el widget real.
import './dm-reports.css';
import DocsMockup from './DocsMockup.astro';
import DmIcon from './DmIcon.astro';
import type { IconName } from '../../../lib/icons';
import { REPORTS, REPORT_GROUPS, reportLabel } from '../../../lib/informes';
import { dmT, dmMoney, pick, type DmLang } from './format';
import { money0Parts } from './dm-gestion';

interface Props {
    lang: DmLang;
    /** Posición del scroll del panel del selector. */
    scroll?: 'top' | 'end';
    caption?: string;
}
const { lang } = Astro.props;
const atEnd = Astro.props.scroll === 'end';
// Informes guardados de la organización (al final de Personalizados).
const SAVED = { es: ['Ventas por país', 'Ventas por nivel de cliente'], en: ['Sales by country', 'Sales by client tier'] }[lang];

const ICON: Record<string, IconName> = {
    overview: 'overview', pulse: 'pulse', sales: 'chart-line', clients: 'clients', products: 'products',
    payments: 'card', tax: 'percent', finance: 'chart', flow: 'trending-up', collection: 'wallet',
    cohort: 'grid', team: 'user-check', explore: 'search-insight',
};
const groups = REPORT_GROUPS.map((g) => ({ g, items: REPORTS.filter((r) => r.group === g) })).filter((x) => x.items.length);

const CERRADO = 1284500;
const PERDIDO = 96300;
const MAT = { won: 38, lost: 13, open: 49 };
// Serie del movimiento comercial (cerrado por fecha de origen), determinista.
const serie = Array.from({ length: 30 }, (_, i) => 0.6 + Math.sin(i / 3.1) * 0.35 + Math.sin(i / 1.7 + 2) * 0.2 + i * 0.012);
const mx = Math.max(...serie) * 1.15;
const W = 300, H = 90;
const path = serie.map((v, i) => `${i ? 'L' : 'M'}${((i / 29) * W).toFixed(1)},${(H - (v / mx) * H).toFixed(1)}`).join(' ');

const DATA = {
    es: {
        caption: `Informes › Resumen con el selector de informes abierto: el buscador "Buscar informes" y los informes agrupados por categoría, cada uno con su icono y si va "Por rango de fechas" o "Al día de hoy" (Resumen, Ventas y Clientes arriba; al desplazarse, Productos, Finanzas, Equipo y Personalizados). Detrás, el rango "Últimos 30 días", el botón Personalizar y los widgets Tasa de cierre (38 %), Valor cerrado (${dmMoney(CERRADO, 'MXN', 'es')}) y la madurez de la cohorte.`,
        captionEnd: 'El selector de informes desplazado hasta abajo: Finanzas (Pagos recibidos, Impuestos facturados, Finanzas, Flujo de caja · 90 días, Cobranza y cartera), Equipo (Ventas por vendedor) y Personalizados, con el Informe personalizado y, al final, los informes guardados "Ventas por país" y "Ventas por nivel de cliente" con su pin.',
        sub: 'Una sola casa para entender el desempeño y decidir qué mover.',
        rango: 'Últimos 30 días',
        buscar: 'Buscar informes',
        porRango: 'Por rango de fechas',
        hoy: 'Al día de hoy',
        guardado: 'Informe guardado',
        w: {
            tasa: 'TASA DE CIERRE', tasaSub: '12 / 32 cotizaciones enviadas',
            cerrado: 'VALOR CERRADO', cerradoSub: 'Cohorte creada en el rango',
            vel: 'VELOCIDAD DEL PIPELINE', velSub: 'cerrado por día del rango',
            perdido: 'VALOR PERDIDO', perdidoSub: '4 cotizaciones',
            mov: 'Movimiento comercial', movDesc: 'Valor cerrado por fecha de origen de la cotización.',
            mad: 'Madurez de la cohorte', madDesc: 'Qué pasó con lo cotizado dentro del rango.',
            won: 'Ganado', lost: 'Perdido', open: 'Aún abierto',
            explain: 'Un rango reciente puede tener poco cierre porque la cohorte todavía no madura; no necesariamente porque esté rindiendo mal.',
        },
    },
    en: {
        caption: `Reports › Overview with the report picker open: the "Search reports" box and the reports grouped by category, each with its icon and whether it uses a "Date range" or is "As of today" (Overview, Sales and Clients at the top; scrolling down, Products, Finance, Team and Custom). Behind it, the "Last 30 days" range, the Customize button and the Close rate (38%), Closed value (${dmMoney(CERRADO, 'MXN', 'en')}) and cohort maturity widgets.`,
        captionEnd: 'The report picker scrolled to the bottom: Finance (Payments received, Invoiced taxes, Finance, Cash flow · 90 days, Collections and receivables), Team (Sales by team member) and Custom, with the Custom report and, at the end, the saved reports "Sales by country" and "Sales by client tier" with their pin.',
        sub: 'One place to understand performance and decide what to move.',
        rango: 'Last 30 days',
        buscar: 'Search reports',
        porRango: 'Date range',
        hoy: 'As of today',
        guardado: 'Saved report',
        w: {
            tasa: 'CLOSE RATE', tasaSub: '12 / 32 sent quotes',
            cerrado: 'CLOSED VALUE', cerradoSub: 'Cohort created in range',
            vel: 'PIPELINE VELOCITY', velSub: 'closed per range day',
            perdido: 'LOST VALUE', perdidoSub: '4 quotes',
            mov: 'Commercial movement', movDesc: 'Closed value by quote creation date.',
            mad: 'Cohort maturity', madDesc: 'What happened to quotes created in range.',
            won: 'Won', lost: 'Lost', open: 'Still open',
            explain: 'A recent range may show little closing because its cohort has not matured yet, not because it is underperforming.',
        },
    },
};
const d = pick(DATA, lang);
const caption = Astro.props.caption ?? (atEnd ? d.captionEnd : d.caption);
const M = (n: number) => money0Parts(n, 'MXN', lang);
const resumen = REPORTS.find((r) => r.id === 'resumen')!;
---
<DocsMockup lang={lang} variant="app" chrome="full" sidebar="rail" active="informes" title={reportLabel(resumen, lang)} height={690} caption={caption} class="dm-rp-figure">
    <Fragment slot="actions">
        <span class="dm-rx-actions">
            <span class="dm-rx-pill is-open"><DmIcon name="overview" />{reportLabel(resumen, lang)}<DmIcon name="chevron-down" class="dm-rx-chev" /></span>
            <span class="dm-rx-pill is-date"><DmIcon name="calendar" />{d.rango}<DmIcon name="chevron-down" class="dm-rx-chev" /></span>
            <span class="dm-rp-custom"><DmIcon name="sliders" />{dmT(lang, 'widgets.personalizar')}</span>
        </span>
    </Fragment>

    <div class="dm-rp-sub">{d.sub}</div>
    <div class="dm-rp-kpis">
        <div class="dm-surface dm-rp-kpi"><span class="dm-kpi-label">{d.w.tasa}</span><b class="dm-editorial">38%</b><small>{d.w.tasaSub}</small></div>
        <div class="dm-surface dm-rp-kpi"><span class="dm-kpi-label">{d.w.cerrado}</span><b class="dm-money">{M(CERRADO).value}<span class="dm-cur">MXN</span></b><small>{d.w.cerradoSub}</small></div>
        <div class="dm-surface dm-rp-kpi"><span class="dm-kpi-label">{d.w.vel}</span><b class="dm-money">{M(CERRADO / 30).value}<span class="dm-cur">MXN</span></b><small>{d.w.velSub}</small></div>
        <div class="dm-surface dm-rp-kpi"><span class="dm-kpi-label">{d.w.perdido}</span><b class="dm-money is-danger">{M(PERDIDO).value}<span class="dm-cur">MXN</span></b><small>{d.w.perdidoSub}</small></div>
    </div>
    <div class="dm-rp-row">
        <div class="dm-surface dm-rp-card">
            <span class="dm-rp-title">{d.w.mad}</span>
            <span class="dm-rp-desc">{d.w.madDesc}</span>
            <span class="dm-rp-seg"><i style={`flex-grow:${MAT.won};background:#059669`}></i><i style={`flex-grow:${MAT.lost};background:#ef4444`}></i><i style={`flex-grow:${MAT.open};background:#8b95a5`}></i></span>
            <span class="dm-rp-legend">
                <span><i style="background:#059669"></i>{d.w.won}<b>{MAT.won}%</b></span>
                <span><i style="background:#ef4444"></i>{d.w.lost}<b>{MAT.lost}%</b></span>
                <span><i style="background:#8b95a5"></i>{d.w.open}<b>{MAT.open}%</b></span>
            </span>
            <span class="dm-rp-explain">{d.w.explain}</span>
        </div>
        <div class="dm-surface dm-rp-card">
            <span class="dm-rp-title">{d.w.mov}</span>
            <span class="dm-rp-desc">{d.w.movDesc}</span>
            <svg class="dm-rp-line" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                <line x1="0" x2={W} y1={H / 3} y2={H / 3}></line><line x1="0" x2={W} y1={(H * 2) / 3} y2={(H * 2) / 3}></line>
                <path d={path} vector-effect="non-scaling-stroke"></path>
            </svg>
        </div>
    </div>

    <div slot="overlay" class:list={['dm-rp-panel', { 'is-end': atEnd }]}>
        <span class="dm-rp-search"><DmIcon name="search" />{d.buscar}</span>
        <div class="dm-rp-list">
            <div class="dm-rp-scroll">
                {groups.map(({ g, items }) => (
                    <div class="dm-rp-group">
                        <span class="dm-rp-glabel">{dmT(lang, `inf.grupo.${g}`)}</span>
                        {items.map((r) => (
                            <span class:list={['dm-rp-opt', { 'is-on': r.id === 'resumen' }]}>
                                <DmIcon name={ICON[r.icon] ?? 'chart'} />
                                <span class="dm-rp-copy"><b>{reportLabel(r, lang)}</b><small>{r.scope === 'snapshot' ? d.hoy : d.porRango}</small></span>
                                {r.id === 'resumen' && <DmIcon name="check" class="dm-rp-check" />}
                            </span>
                        ))}
                        {g === 'personalizados' && SAVED.map((n) => (
                            <span class="dm-rp-opt">
                                <DmIcon name="pin" />
                                <span class="dm-rp-copy"><b>{n}</b><small>{d.guardado}</small></span>
                            </span>
                        ))}
                    </div>
                ))}
            </div>
            <span class="dm-rp-thumb"></span>
        </div>
    </div>
</DocsMockup>

<style is:global>
    .dm-rp-figure .dm-page-head, .dm-rp-figure .dm-content { padding-right: calc(18px + var(--dm-bleed)); }
    .dm-rp-sub { margin: -6px 0 12px; font-size: 11px; color: var(--dm-muted); }
    .dm-rp-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 10px; }
    .dm-rp-kpi { display: flex; flex-direction: column; gap: 5px; padding: 12px 13px; min-width: 0; }
    .dm-rp-kpi .dm-kpi-label { font-size: 8.5px; }
    .dm-rp-kpi b { font-size: 19px; line-height: 1.05; color: var(--dm-navy); letter-spacing: -0.035em; }
    .dm-rp-kpi b .dm-cur { font-size: 9px; }
    .dm-rp-kpi b.is-danger { color: var(--dm-danger-ink); }
    .dm-rp-kpi small { font-size: 10px; color: var(--dm-muted); line-height: 1.35; }
    .dm-rp-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .dm-rp-card { display: flex; flex-direction: column; gap: 4px; padding: 13px 15px 15px; min-width: 0; }
    .dm-rp-title { font-size: 12.5px; font-weight: 600; }
    .dm-rp-desc { font-size: 10px; color: var(--dm-muted); margin-bottom: 8px; }
    .dm-rp-line { display: block; width: 100%; height: 96px; }
    .dm-rp-line line { stroke: rgba(10, 25, 47, 0.06); vector-effect: non-scaling-stroke; }
    .dm-rp-line path { fill: none; stroke: var(--dm-navy); stroke-width: 1.8; stroke-linejoin: round; }
    .dm-rp-seg { display: flex; gap: 2px; height: 12px; border-radius: 99px; overflow: hidden; }
    .dm-rp-seg i { flex-basis: 0; }
    .dm-rp-legend { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
    .dm-rp-legend span { display: flex; align-items: center; gap: 7px; font-size: 10.5px; color: var(--dm-muted); }
    .dm-rp-legend i { width: 7px; height: 7px; border-radius: 50%; }
    .dm-rp-legend b { margin-left: auto; color: var(--dm-text); font-weight: 650; font-variant-numeric: tabular-nums; }
    .dm-rp-explain { margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--dm-border); font-size: 9.5px; line-height: 1.5; color: var(--dm-muted); }

    .dm-rp-custom { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 11px 0 10px; border-radius: 999px; background: #fff; border: 1px solid var(--dm-border); box-shadow: 0 1px 2px rgba(10, 25, 47, 0.06); font-size: 10.5px; font-weight: 600; white-space: nowrap; }
    .dm-rp-custom .dm-ico { width: 13px; height: 13px; color: var(--dm-muted); }

    /* Panel del selector (.report-picker-panel), abierto bajo su botón: 380 px y
       máximo 560 px de alto en la app; aquí a escala. */
    .dm-rp-panel {
        position: absolute;
        right: calc(var(--dm-bleed) + 92px);
        top: 112px;
        width: 290px;
        padding: 8px;
        border-radius: 20px;
        background: #fff;
        border: 1px solid rgba(10, 25, 47, 0.08);
        box-shadow: 0 24px 80px rgba(10, 25, 47, 0.16), 0 3px 14px rgba(10, 25, 47, 0.08);
    }
    .dm-rp-search { display: flex; align-items: center; gap: 7px; height: 34px; padding: 0 10px; border-radius: 12px; background: var(--dm-canvas); font-size: 11px; color: var(--dm-faint); }
    .dm-rp-search .dm-ico { width: 13px; height: 13px; color: #687181; }
    .dm-rp-list { position: relative; height: 480px; overflow: hidden; margin-top: 4px; }
    .dm-rp-panel.is-end .dm-rp-scroll { position: absolute; left: 0; right: 0; bottom: 0; }
    .dm-rp-thumb { position: absolute; right: 1px; top: 6px; width: 3px; height: 46%; border-radius: 99px; background: rgba(10, 25, 47, 0.18); }
    .dm-rp-panel.is-end .dm-rp-thumb { top: auto; bottom: 6px; }
    .dm-rp-group { padding: 4px 0; }
    .dm-rp-glabel { display: block; padding: 6px 9px 3px; font-size: 7.5px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #9299a5; }
    .dm-rp-opt { display: flex; align-items: center; gap: 9px; min-height: 42px; padding: 5px 9px; border-radius: 11px; }
    .dm-rp-opt.is-on { background: #eef2f7; }
    .dm-rp-opt > .dm-ico { width: 16px; height: 16px; flex: 0 0 auto; color: var(--dm-navy); }
    .dm-rp-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    .dm-rp-copy b { font-size: 11px; font-weight: 650; color: #1d2430; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dm-rp-copy small { font-size: 9px; color: #858d99; }
    .dm-rp-opt .dm-rp-check { width: 14px; height: 14px; color: var(--dm-navy); }

    @container dm (max-width: 640px) {
        .dm-rp-figure .dm-stage { height: auto; max-height: 1300px; }
        .dm-rp-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .dm-rp-row { grid-template-columns: minmax(0, 1fr); }
        .dm-rp-figure .dm-overlay { position: static; }
        .dm-rp-panel { position: relative; right: auto; top: auto; width: auto; margin: 0 calc(var(--dm-bleed) + 12px) 16px 12px; }
    }
</style>
