---
// Mockup: paso 3 "Condiciones" y resumen "Revisa y envía" del editor,
// cotizando en USD para un negocio que lleva sus libros en MXN.
//
// Calca de DocumentEditor.astro. Columna principal: Vigencia, Anticipo (%) con
// su nota (depositNoteTpl), la divisa con bandera, la iguala mensual (apagada:
// excluye el anticipo) y el panel de tasa protegida (fxExplainTpl, tipo de
// hoy → tasa protegida, chips Poco / Normal / Cauto, clientPaysTpl y el
// candado). Columna lateral: el resumen que solo resume — etiqueta Borrador,
// estado de autoguardado, conteo, Subtotal, Le descontaste, IVA, Total, las
// condiciones en una línea (sumTermsQuoteTpl), el botón principal, Guardar
// borrador, Vista previa y los atajos. La tasa protegida es la de hoy más el
// colchón elegido (+2%), y "en tus libros" multiplica el total por esa tasa,
// igual que la app.
import DocsMockup from './DocsMockup.astro';
import DmIcon from './DmIcon.astro';
import DmMoney from './DmMoney.astro';
import './dm-cot-editor.css';
import { getDocumentEditorI18n } from '../../../i18n/app';
import { termLabel } from '../../../lib/payment-terms';
import { dmMoney, pick, tpl, type DmLang } from './format';

interface Props {
    lang: DmLang;
    /** Pie de figura; por defecto describe las opciones elegidas. */
    caption?: string;
}
const { lang } = Astro.props;
const T = getDocumentEditorI18n(lang);
const BASE = 'USD';
const FISCAL = 'MXN';
const SUBTOTAL = 8450;
const AHORRO = 610;
const IVA = Math.round(SUBTOTAL * 0.16 * 100) / 100;
const TOTAL = SUBTOTAL + IVA;
const ANT = Math.round(TOTAL * 50) / 100;
const SPOT = 18.421;
const BUF = 2;
const APPLIED = SPOT * (1 + BUF / 100);
const LIBROS = Math.round(TOTAL * APPLIED * 100) / 100;

const fiscalName = new Intl.DisplayNames([lang], { type: 'currency' }).of(FISCAL) ?? FISCAL;
const baseName = new Intl.DisplayNames([lang], { type: 'currency' }).of(BASE) ?? BASE;
const explain = tpl(T.fxExplainTpl, { base: `<b>${BASE}</b>`, fiscal: fiscalName });
const antNote = tpl(T.depositNoteTpl, { ant: dmMoney(ANT, BASE, lang), resto: dmMoney(TOTAL - ANT, BASE, lang) });
const pays = tpl(T.clientPaysTpl, { monto: `<b>${dmMoney(TOTAL, BASE, lang)}</b>`, libros: `<b>${dmMoney(LIBROS, FISCAL, lang)}</b>` });
const terms = tpl(T.sumTermsQuoteTpl, { term: termLabel('net30', lang), n: 30 });

const DATA = {
    es: {
        caption: `Paso 3 Condiciones y resumen Revisa y envía, cotizando en USD: vigencia de 30 días, anticipo de 50%, iguala mensual apagada y la tasa protegida con el colchón Normal +2%. El resumen muestra subtotal ${dmMoney(SUBTOTAL, BASE, 'es')}, le descontaste ${dmMoney(AHORRO, BASE, 'es')}, IVA 16%, total ${dmMoney(TOTAL, BASE, 'es')} con "Net 30 · válida 30 días", el estado de guardado y los botones Crear y enviar, Guardar borrador y Vista previa.`,
        count: '4 líneas · 136 piezas',
        saved: 'Guardado a las 10:42',
    },
    en: {
        caption: `Step 3 Terms and the Review and send summary, quoting in USD: valid for 30 days, a 50% deposit, monthly recurring charge off and the locked rate with the Normal +2% cushion. The summary shows subtotal ${dmMoney(SUBTOTAL, BASE, 'en')}, you discounted them ${dmMoney(AHORRO, BASE, 'en')}, tax 16%, total ${dmMoney(TOTAL, BASE, 'en')} with "Net 30 · valid 30 days", the save status and the Create and send, Save draft and Preview buttons.`,
        count: '4 lines · 136 units',
        saved: 'Saved at 10:42 AM',
    },
};
const d = pick(DATA, lang);
const caption = Astro.props.caption ?? d.caption;
const CHIPS = [
    { label: T.fxLow, v: 1 },
    { label: T.fxNormal, v: 2 },
    { label: T.fxHigh, v: 5 },
] as const;
const taxIncluded = tpl(T.taxIncludedTpl, { tax: 'IVA' });
---
<DocsMockup lang={lang} variant="app" chrome="none" caption={caption} class="dm-cot-rp-figure">
    <div class="dm-ced dm-cot-rp-grid">
        <div class="dm-cot-rp-main">
            <div class="dm-ced-step">
                <span class="dm-ced-num">3</span>
                <span class="dm-ced-step-text">
                    <span class="dm-ced-step-title">{T.step3Title}</span>
                    <span class="dm-ced-step-hint">{T.step3HintQuote}</span>
                </span>
            </div>
            <div class="dm-ced-cond">
                <div class="dm-ced-field">
                    <span class="dm-ced-flabel">{T.validity}</span>
                    <span class="dm-ced-select">30 {T.days}</span>
                </div>
                <div class="dm-ced-field">
                    <span class="dm-ced-flabel">{T.deposit} <span class="dm-ced-opt">{T.optional}</span></span>
                    <span class="dm-ced-select dm-cot-rp-num">50</span>
                    <span class="dm-ced-note">{antNote}</span>
                </div>
                <div class="dm-ced-field">
                    <span class="dm-ced-flabel">{T.currencyQuote}</span>
                    <span class="dm-ced-select dm-cot-rp-cur"><img src="/flags/us.svg" alt="" width="18" height="18" loading="lazy" decoding="async" /><span class="dm-ced-select-text">{BASE} — {baseName}</span></span>
                </div>
                <div class="dm-ced-frow dm-cot-rp-rec"><span>{T.recurring} <span class="dm-ced-opt">{T.recurringTag}</span></span><span class="dm-ced-toggle"></span></div>
            </div>

            <div class="dm-cot-rp-fx">
                <span class="dm-cot-rp-explain" set:html={explain} />
                <div class="dm-cot-rp-row">
                    <div class="dm-cot-rp-stepper">
                        <span class="dm-cot-rp-step"><span class="dm-cot-rp-slbl">{T.fxToday}</span><DmMoney amount={SPOT} currency={FISCAL} lang={lang} class="dm-cot-rp-sval" /></span>
                        <DmIcon name="arrow-right" class="dm-cot-rp-arrow" />
                        <span class="dm-cot-rp-step is-on"><span class="dm-cot-rp-slbl">{T.fxProtected} +{BUF}%</span><DmMoney amount={APPLIED} currency={FISCAL} lang={lang} class="dm-cot-rp-sval" /></span>
                    </div>
                    <div class="dm-cot-rp-cushwrap">
                        <span class="dm-cot-rp-cush-lbl">{T.fxCaution}</span>
                        <div class="dm-cot-rp-cush">
                            {CHIPS.map((c) => <span class:list={['dm-cot-rp-chip', { 'is-on': c.v === BUF }]}><b>{c.label}</b><small>+{c.v}%</small></span>)}
                        </div>
                    </div>
                </div>
                <span class="dm-cot-rp-sees" set:html={pays} />
                <span class="dm-cot-rp-lock"><DmIcon name="lock" />{T.fxLockQuote}</span>
            </div>
        </div>

        <div class="dm-ced-sum dm-cot-rp">
            <div class="dm-cot-rp-head"><span class="dm-ced-sum-title">{T.reviewQuote}</span><span class="dm-ced-tag">{T.tagDraft}</span></div>
            <span class="dm-ced-state">{d.saved}</span>
            <span class="dm-ced-sum-count">{d.count}</span>
            <div class="dm-ced-sl"><span>{T.subtotal}</span><DmMoney amount={SUBTOTAL} currency={BASE} lang={lang} /></div>
            <div class="dm-ced-sl is-save"><span>{T.discounted}</span><span class="dm-cot-rp-neg">−<DmMoney amount={AHORRO} currency={BASE} lang={lang} /></span></div>
            <div class="dm-ced-sl is-tax"><span>IVA 16%</span><DmMoney amount={IVA} currency={BASE} lang={lang} /></div>
            <div class="dm-ced-frow"><span>{taxIncluded}</span><span class="dm-ced-toggle"></span></div>
            <div class="dm-ced-div"></div>
            <div class="dm-ced-sl is-total"><span>{T.total}</span><DmMoney amount={TOTAL} currency={BASE} lang={lang} /></div>
            <span class="dm-ced-terms">{terms}</span>
            <span class="dm-ced-send"><DmIcon name="send" />{T.sendNewQuote}</span>
            <span class="dm-ced-draftbtn">{T.saveDraftNew}</span>
            <span class="dm-ced-tools"><DmIcon name="eye" />{T.preview}</span>
            <span class="dm-ced-kbds"><span><kbd>⌘</kbd><kbd>Enter</kbd>{T.kbdSend}</span><span><kbd>⌘</kbd><kbd>S</kbd>{T.kbdSave}</span></span>
        </div>
    </div>
</DocsMockup>

<style is:global>
    .dm-cot-rp-grid { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 22px; align-items: start; padding: 4px 0; }
    .dm-cot-rp-main { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    .dm-cot-rp-main .dm-ced-step { margin-bottom: 2px; }
    .dm-cot-rp-rec { align-self: end; min-height: 36px; }
    .dm-cot-rp { gap: 9px; padding: 18px; }
    .dm-cot-rp-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .dm-cot-rp-neg { display: inline-flex; align-items: baseline; color: #059669; font-weight: 600; }
    .dm-cot-rp-num { font-variant-numeric: tabular-nums; }
    .dm-cot-rp-num::after { display: none; }
    .dm-cot-rp-cur img { width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 0 1px rgba(10, 25, 47, 0.08); }
    .dm-cot-rp-fx { --ced-field: #ffffff; display: flex; flex-direction: column; gap: 10px; padding: 13px; border-radius: 12px; background: var(--dm-soft); border: 1px solid var(--dm-border); }
    .dm-cot-rp-explain { font-size: 10.5px; line-height: 1.5; color: var(--dm-muted); }
    .dm-cot-rp-explain b { color: var(--dm-text); font-weight: 600; }
    .dm-cot-rp-row { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 10px; align-items: end; }
    .dm-cot-rp-stepper { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: stretch; gap: 6px; }
    .dm-cot-rp-step { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; border-radius: 9px; border: 1px solid var(--dm-border); background: #fff; min-width: 0; }
    .dm-cot-rp-step.is-on { border-color: rgba(16, 185, 129, 0.5); background: rgba(16, 185, 129, 0.07); }
    .dm-cot-rp-slbl { font-size: 9px; font-weight: 600; line-height: 1.25; color: var(--dm-muted); }
    .dm-cot-rp-step.is-on .dm-cot-rp-slbl { color: #059669; }
    .dm-cot-rp-sval { font-size: 14px; color: var(--dm-text); }
    .dm-cot-rp-arrow { align-self: center; width: 13px; height: 13px; color: var(--dm-faint); }
    .dm-cot-rp-cushwrap { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .dm-cot-rp-cush-lbl { font-size: 10.5px; font-weight: 500; color: var(--dm-muted); }
    .dm-cot-rp-cush { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .dm-cot-rp-chip { display: flex; flex-direction: column; align-items: center; gap: 1px; padding: 7px 4px; border-radius: 9px; border: 1px solid var(--dm-border-strong); background: #fff; }
    .dm-cot-rp-chip b { font-size: 11px; font-weight: 600; color: var(--dm-text); }
    .dm-cot-rp-chip small { font-size: 9.5px; color: var(--dm-muted); }
    .dm-cot-rp-chip.is-on { background: var(--dm-navy); border-color: var(--dm-navy); }
    .dm-cot-rp-chip.is-on b, .dm-cot-rp-chip.is-on small { color: #fff; }
    .dm-cot-rp-sees { font-size: 11.5px; line-height: 1.45; color: var(--dm-text); }
    .dm-cot-rp-sees b { font-weight: 600; font-variant-numeric: tabular-nums; }
    .dm-cot-rp-lock { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--dm-muted); }
    .dm-cot-rp-lock .dm-ico { width: 12px; height: 12px; }
    @container dm (max-width: 640px) {
        .dm-cot-rp-figure .dm-stage { height: auto; }
        .dm-cot-rp-grid { grid-template-columns: minmax(0, 1fr); }
        .dm-cot-rp-row { grid-template-columns: minmax(0, 1fr); }
    }
</style>
