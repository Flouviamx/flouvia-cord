---
// Mockup: panel "Revisa y envía" del editor cotizando en USD para un negocio
// que lleva sus libros en MXN.
//
// Calca de la columna derecha de nueva.astro: conteo de líneas, Subtotal,
// "Le descontaste", el interruptor de impuestos incluidos, el desglose por
// tasa, Total, Vigencia, la iguala mensual (apagada: es excluyente con el
// anticipo), Anticipo (%) con su nota (anticipoNoteTpl), el selector de divisa
// con bandera y el bloque de tasa protegida (fxExplainTpl, tipo de hoy →
// tasa protegida, chips Poco / Normal / Cauto, clienteVeraTpl y el candado).
// La tasa protegida es la de hoy más el colchón elegido (+2%), y "en tus
// libros" multiplica el total de venta por esa tasa, igual que la app.
import DocsMockup from './DocsMockup.astro';
import DmIcon from './DmIcon.astro';
import DmMoney from './DmMoney.astro';
import './dm-cot-editor.css';
import { getEditorRuntimeI18n } from '../../../i18n/app';
import { dmT, dmMoney, pick, tpl, type DmLang } from './format';

interface Props {
    lang: DmLang;
    /** Pie de figura; por defecto describe las opciones elegidas. */
    caption?: string;
}
const { lang } = Astro.props;
const RT = getEditorRuntimeI18n(lang);
const BASE = 'USD';
const FISCAL = 'MXN';
const SUBTOTAL = 8450;
const AHORRO = 610;
const IVA = Math.round(SUBTOTAL * 0.16 * 100) / 100;
const TOTAL = SUBTOTAL + IVA;
const ANT = Math.round(TOTAL * 50) / 100;
const SPOT = 18.421;
const BUF = 2;
const APPLIED = SPOT * (1 + BUF / 100);
const LIBROS = Math.round(TOTAL * APPLIED * 100) / 100;

const fiscalName = new Intl.DisplayNames([lang], { type: 'currency' }).of(FISCAL) ?? FISCAL;
const baseName = new Intl.DisplayNames([lang], { type: 'currency' }).of(BASE) ?? BASE;
const explain = tpl(RT.fxExplainTpl, { base: `<b>${BASE}</b>`, fiscal: fiscalName });
const antNote = tpl(RT.anticipoNoteTpl, { ant: dmMoney(ANT, BASE, lang), resto: dmMoney(TOTAL - ANT, BASE, lang) });

const DATA = {
    es: {
        caption: `Panel Revisa y envía cotizando en USD: subtotal ${dmMoney(SUBTOTAL, BASE, 'es')}, le descontaste ${dmMoney(AHORRO, BASE, 'es')}, IVA 16% y total ${dmMoney(TOTAL, BASE, 'es')}; vigencia de 30 días, iguala mensual apagada, anticipo de 50% y la tasa protegida con el colchón Normal +2%.`,
        count: '4 líneas · 136 piezas',
        iguala: ' (iguala)',
        cliente: 'Tu cliente paga', libros: 'en tus libros ≈',
    },
    en: {
        caption: `Review and send panel quoting in USD: subtotal ${dmMoney(SUBTOTAL, BASE, 'en')}, you discounted them ${dmMoney(AHORRO, BASE, 'en')}, tax 16% and total ${dmMoney(TOTAL, BASE, 'en')}; valid for 30 days, monthly recurring charge off, a 50% deposit, and the locked rate with the Normal +2% cushion.`,
        count: '4 lines · 136 units',
        iguala: '',
        cliente: 'Your client pays', libros: 'in your books ≈',
    },
};
const d = pick(DATA, lang);
const caption = Astro.props.caption ?? d.caption;
const CHIPS = [
    { k: 'ed.fx_poco', v: 1 },
    { k: 'ed.fx_normal', v: 2 },
    { k: 'ed.fx_cauto', v: 5 },
] as const;
---
<DocsMockup lang={lang} variant="panel" panelWidth={392} caption={caption} class="dm-cot-rp-figure">
    <div class="dm-ced dm-cot-rp">
        <span class="dm-ced-sum-title">{dmT(lang, 'ed.revisa_envia')}</span>
        <span class="dm-ced-sum-count">{d.count}</span>
        <div class="dm-ced-sl"><span>{dmT(lang, 'ed.subtotal')}</span><DmMoney amount={SUBTOTAL} currency={BASE} lang={lang} /></div>
        <div class="dm-ced-sl is-save"><span>{dmT(lang, 'ed.le_descontaste')}</span><span class="dm-cot-rp-neg">−<DmMoney amount={AHORRO} currency={BASE} lang={lang} /></span></div>
        <div class="dm-ced-frow"><span>{dmT(lang, 'ed.iva_incluido')}</span><span class="dm-ced-toggle"></span></div>
        <div class="dm-ced-sl is-tax"><span>IVA 16%</span><DmMoney amount={IVA} currency={BASE} lang={lang} /></div>
        <div class="dm-ced-div"></div>
        <div class="dm-ced-sl is-total"><span>{dmT(lang, 'ed.total')}</span><DmMoney amount={TOTAL} currency={BASE} lang={lang} /></div>

        <div class="dm-ced-field">
            <span class="dm-ced-flabel">{dmT(lang, 'ed.vigencia')}</span>
            <span class="dm-ced-select">30 {dmT(lang, 'ed.dias')}</span>
        </div>
        <div class="dm-ced-frow"><span>{dmT(lang, 'ed.recurrente_label')}<span class="dm-ced-opt">{d.iguala}</span></span><span class="dm-ced-toggle"></span></div>
        <div class="dm-ced-field">
            <span class="dm-ced-flabel">{dmT(lang, 'ed.anticipo_label')} <span class="dm-ced-opt">{dmT(lang, 'ed.opcional')}</span></span>
            <span class="dm-ced-select dm-cot-rp-num">50</span>
            <span class="dm-ced-note">{antNote}</span>
        </div>
        <div class="dm-ced-field">
            <span class="dm-ced-flabel">{dmT(lang, 'ed.moneda_label')}</span>
            <span class="dm-ced-select dm-cot-rp-cur"><img src="/flags/us.svg" alt="" width="18" height="18" loading="lazy" decoding="async" /><span class="dm-ced-select-text">{BASE} — {baseName}</span></span>
        </div>

        <div class="dm-cot-rp-fx">
            <span class="dm-cot-rp-explain" set:html={explain} />
            <div class="dm-cot-rp-stepper">
                <span class="dm-cot-rp-step"><span class="dm-cot-rp-slbl">{dmT(lang, 'ed.fx_tipo_hoy')}</span><DmMoney amount={SPOT} currency={FISCAL} lang={lang} class="dm-cot-rp-sval" /></span>
                <DmIcon name="arrow-right" class="dm-cot-rp-arrow" />
                <span class="dm-cot-rp-step is-on"><span class="dm-cot-rp-slbl">{dmT(lang, 'ed.fx_tasa_protegida')} +{BUF}%</span><DmMoney amount={APPLIED} currency={FISCAL} lang={lang} class="dm-cot-rp-sval" /></span>
            </div>
            <span class="dm-cot-rp-cush-lbl">{dmT(lang, 'ed.fx_cauto_label')}</span>
            <div class="dm-cot-rp-cush">
                {CHIPS.map((c) => <span class:list={['dm-cot-rp-chip', { 'is-on': c.v === BUF }]}><b>{dmT(lang, c.k)}</b><small>+{c.v}%</small></span>)}
            </div>
            <span class="dm-cot-rp-sees">{d.cliente} <b>{dmMoney(TOTAL, BASE, lang)}</b> · {d.libros} <b>{dmMoney(LIBROS, FISCAL, lang)}</b></span>
            <span class="dm-cot-rp-lock"><DmIcon name="lock" />{dmT(lang, 'ed.fx_lock_row')}</span>
        </div>

        <span class="dm-ced-send">{dmT(lang, 'ed.btn_enviar_nueva')}<DmIcon name="arrow-right" /></span>
        <span class="dm-ced-draftbtn">{dmT(lang, 'ed.btn_borrador_nueva')}</span>
    </div>
</DocsMockup>

<style is:global>
    .dm-cot-rp-figure .dm-v-panel { padding: 30px 24px; }
    .dm-cot-rp-figure .dm-panel { border-radius: 20px; }
    .dm-cot-rp { display: flex; flex-direction: column; gap: 11px; padding: 22px 22px 20px; }
    .dm-cot-rp-neg { display: inline-flex; align-items: baseline; color: #059669; font-weight: 600; }
    .dm-cot-rp-num { font-variant-numeric: tabular-nums; }
    .dm-cot-rp-num::after { display: none; }
    .dm-cot-rp-cur img { width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 0 1px rgba(10, 25, 47, 0.08); }
    .dm-cot-rp-fx { display: flex; flex-direction: column; gap: 10px; padding: 13px; border-radius: 12px; background: var(--dm-soft); border: 1px solid var(--dm-border); }
    .dm-cot-rp-explain { font-size: 10.5px; line-height: 1.5; color: var(--dm-muted); }
    .dm-cot-rp-explain b { color: var(--dm-text); font-weight: 600; }
    .dm-cot-rp-stepper { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: stretch; gap: 6px; }
    .dm-cot-rp-step { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; border-radius: 9px; border: 1px solid var(--dm-border); background: #fff; min-width: 0; }
    .dm-cot-rp-step.is-on { border-color: rgba(16, 185, 129, 0.5); background: rgba(16, 185, 129, 0.07); }
    .dm-cot-rp-slbl { font-size: 9px; font-weight: 600; line-height: 1.25; color: var(--dm-muted); }
    .dm-cot-rp-step.is-on .dm-cot-rp-slbl { color: #059669; }
    .dm-cot-rp-sval { font-size: 14px; color: var(--dm-text); }
    .dm-cot-rp-arrow { align-self: center; width: 13px; height: 13px; color: var(--dm-faint); }
    .dm-cot-rp-cush-lbl { font-size: 10.5px; font-weight: 500; color: var(--dm-muted); }
    .dm-cot-rp-cush { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .dm-cot-rp-chip { display: flex; flex-direction: column; align-items: center; gap: 1px; padding: 7px 4px; border-radius: 9px; border: 1px solid var(--dm-border-strong); background: #fff; }
    .dm-cot-rp-chip b { font-size: 11px; font-weight: 600; color: var(--dm-text); }
    .dm-cot-rp-chip small { font-size: 9.5px; color: var(--dm-muted); }
    .dm-cot-rp-chip.is-on { background: var(--dm-navy); border-color: var(--dm-navy); }
    .dm-cot-rp-chip.is-on b, .dm-cot-rp-chip.is-on small { color: #fff; }
    .dm-cot-rp-sees { font-size: 11.5px; line-height: 1.45; color: var(--dm-text); }
    .dm-cot-rp-sees b { font-weight: 600; font-variant-numeric: tabular-nums; }
    .dm-cot-rp-lock { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--dm-muted); }
    .dm-cot-rp-lock .dm-ico { width: 12px; height: 12px; }
    @container dm (max-width: 520px) {
        .dm-cot-rp { padding: 18px 16px; }
    }
</style>
