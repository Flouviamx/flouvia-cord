---
// Mockup: la app de Cord en escritorio con el menú lateral ancho y la barra
// superior, sobre Inicio. Es la pieza de "Mapa de la aplicación": enseña el
// shell completo, así que lo arma con DmSidebar y DmTopbar en vez de pasar por
// el chrome de DocsMockup (que en angosto oculta la sidebar).
//
// Sidebar (calca de Sidebar.astro): selector de Materiales del Valle, dos
// fijados con el icono de su sección (un cliente y un informe), la lista plana
// con los contadores accionables (3 cotizaciones vistas sin responder, 2
// tareas para hoy), Ingresos con Cobranza en tinte naranja (2 cuentas
// vencidas), Análisis y Automatización, el cursor sobre Clientes mostrando su
// atajo G L, y el pie de un plan Pro: "Invitar al equipo" y el botón de
// colapsar. Con `meter` el pie es el de Starter: "Cotizaciones activas 38 / 50"
// y "Mejorar plan".
//
// Topbar (calca de AppLayout + TopbarApps): Buscar ⌘K, Crear, Aplicaciones con
// HubSpot y Slack conectados, la campana con 3 sin leer, Ayuda, Tema (sol =
// Claro) y Ajustes.
//
// En un marco angosto se dibuja como en el teléfono: la topbar móvil y el menú
// como cajón, con las filas Ayuda / Tema / Configuración arriba y la X de los
// fijados siempre visible.
import DocsMockup from './DocsMockup.astro';
import DmMoney from './DmMoney.astro';
import DmSidebar from './DmSidebar.astro';
import DmStatus from './DmStatus.astro';
import DmTopbar from './DmTopbar.astro';
import type { QuoteStatus } from '../../../lib/quote';
import { dmT, pick, DEMO, type DmLang, type DmPin } from './format';

interface Props {
    lang: DmLang;
    caption?: string;
    /** Pie de un plan Starter (medidor de cotizaciones activas) en lugar del de Pro (Invitar al equipo). */
    meter?: boolean;
}
const { lang, meter = false } = Astro.props;

const DATA = {
    es: {
        caption: meter
            ? 'La app en escritorio sobre Inicio con el plan Starter: el menú lateral con el selector de Materiales del Valle, dos páginas fijadas, la lista Inicio, Cotizaciones (3 vistas sin responder), Clientes, Productos y Tareas (2 para hoy), los grupos Ingresos (Cobranza con 2 cuentas vencidas), Análisis y Automatización, y al pie el medidor Cotizaciones activas 38 / 50 con Mejorar plan. Arriba, Buscar, Crear, Aplicaciones, la campana con 3 sin leer, Ayuda, Tema y Ajustes.'
            : 'La app en escritorio sobre Inicio: el menú lateral con el selector de Materiales del Valle, dos páginas fijadas, la lista Inicio, Cotizaciones (3 vistas sin responder), Clientes con su atajo G L al pasar el cursor, Productos y Tareas (2 para hoy), los grupos Ingresos (Cobranza con 2 cuentas vencidas), Análisis y Automatización, y al pie Invitar al equipo y el botón para colapsar. Arriba, Buscar, Crear, Aplicaciones con dos apps conectadas, la campana con 3 notificaciones sin leer, Ayuda, Tema y Ajustes.',
        pinReport: 'Flujo de caja',
        activas: '7 cotizaciones activas',
    },
    en: {
        caption: meter
            ? 'The app on desktop over Home on the Starter plan: the sidebar with the Materiales del Valle switcher, two pinned pages, the Home, Quotes (3 viewed with no reply), Clients, Products and Tasks (2 due today) list, the Revenue (Collections with 2 overdue accounts), Insights and Automation groups, and at the bottom the Active quotes 38 / 50 meter with Upgrade plan. At the top, Search, Create, Apps, the bell with 3 unread, Help, Theme and Settings.'
            : 'The app on desktop over Home: the sidebar with the Materiales del Valle switcher, two pinned pages, the Home, Quotes (3 viewed with no reply), Clients showing its G L shortcut on hover, Products and Tasks (2 due today) list, the Revenue (Collections with 2 overdue accounts), Insights and Automation groups, and at the bottom Invite people and the collapse button. At the top, Search, Create, Apps with two connected apps, the bell with 3 unread notifications, Help, Theme and Settings.',
        pinReport: 'Cash flow',
        activas: '7 active quotes',
    },
};
const d = pick(DATA, lang);
const caption = Astro.props.caption ?? d.caption;
const PINS: DmPin[] = [
    { label: DEMO.cliente, href: '/app/clientes/zarco' },
    { label: d.pinReport, href: '/app/informes?r=flujo' },
];
const RECENT: { folio: string; cliente: string; status: QuoteStatus; total: number }[] = [
    { folio: 'COT-0152', cliente: 'Constructora Apex', status: 'approved', total: 10000 },
    { folio: DEMO.folio, cliente: DEMO.cliente, status: 'viewed', total: DEMO.total },
    { folio: 'COT-0147', cliente: 'Aceros del Norte', status: 'sent', total: 84310.5 },
    { folio: 'COT-0146', cliente: 'Grupo Inmobiliario Lerma', status: 'paid', total: 312880 },
];
---
<DocsMockup lang={lang} variant="app" chrome="none" caption={caption} class="dm-map-figure">
    <div class="dm-map">
        <DmSidebar
            lang={lang}
            active="dashboard"
            badges={{ seguimiento: 3, vencidas: 2, tareas: 2 }}
            pins={PINS}
            hover={meter ? undefined : 'clientes'}
            invite={!meter}
            plan={meter ? { used: 38, limit: 50 } : undefined}
            mobile
        />
        <div class="dm-map-main">
            <DmTopbar lang={lang} notif={3} apps={['hubspot.com', 'slack.com']} />
            <div class="dm-page-head"><div class="dm-h1">{dmT(lang, 'dash.heading')}</div></div>
            <div class="dm-content">
                <div class="dm-kpis dm-map-kpis">
                    <div class="dm-surface dm-kpi">
                        <span class="dm-kpi-label">{dmT(lang, 'dash.kpi_por_cerrar')}</span>
                        <span class="dm-kpi-num"><DmMoney amount={603659.7} lang={lang} /></span>
                        <span class="dm-kpi-sub">{d.activas}</span>
                    </div>
                    <div class="dm-surface dm-kpi">
                        <span class="dm-kpi-label">{dmT(lang, 'dash.kpi_por_seguimiento')}</span>
                        <span class="dm-kpi-num dm-editorial">3</span>
                        <span class="dm-kpi-sub">{dmT(lang, 'dash.kpi_vista_plural')}</span>
                    </div>
                </div>
                <div class="dm-surface dm-map-recent">
                    <div class="dm-sec-head"><span class="dm-sec-title">{dmT(lang, 'dash.w_recientes')}</span></div>
                    <div class="dm-table">
                        {RECENT.map((q) => (
                            <div class="dm-tr" style="--dm-cols: 74px minmax(0,1fr) auto auto">
                                <span class="dm-folio">{q.folio}</span>
                                <span class="dm-ellipsis">{q.cliente}</span>
                                <DmStatus status={q.status} lang={lang} />
                                <span class="dm-num"><DmMoney amount={q.total} lang={lang} /></span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</DocsMockup>

<style is:global>
    .dm-map-figure .dm-window > .dm-app > .dm-main > .dm-content { padding: 0; }
    .dm-map { flex: 1 0 auto; display: grid; grid-template-columns: 206px minmax(0, 1fr); align-items: stretch; }
    .dm-map-main { min-width: 0; display: flex; flex-direction: column; padding-right: var(--dm-bleed); }
    .dm-map-main .dm-content { padding: 14px 20px 22px; }
    .dm-map-kpis { --dm-kpi-min: 170px; }
    .dm-map-recent { margin-top: 12px; padding: 12px 0 2px; }
    .dm-map-recent .dm-sec-head { padding: 0 14px 9px; margin-bottom: 0; }

    /* Angosto: como en el teléfono. Arriba la topbar móvil y el menú como cajón
       (filas grandes, Ayuda / Tema / Configuración, la X de los fijados a la
       vista, sin atajos ni botón de colapsar). */
    @container dm (max-width: 640px) {
        .dm-map { grid-template-columns: minmax(0, 1fr); }
        .dm-map-main { order: -1; }
        .dm-map-main .dm-page-head, .dm-map-main .dm-content { display: none; }
        .dm-map-figure .dm-sidebar { display: flex; margin: 10px var(--dm-bleed) 0 0; padding: 14px 10px 14px; border-radius: 0 18px 0 0; box-shadow: 0 0 40px rgba(10, 25, 47, 0.16); max-height: none; }
        .dm-map-figure .dm-sb-mobile { display: flex; }
        .dm-map-figure .dm-sb-item { height: 38px; padding: 0 12px; gap: 12px; border-radius: 11px; font-size: 13px; }
        .dm-map-figure .dm-sb-item .dm-ico { width: 17px; height: 17px; }
        .dm-map-figure .dm-sb-item.is-hover { background: transparent; color: var(--dm-muted); }
        .dm-map-figure .dm-sb-item.is-hover .dm-ico { opacity: 0.62; }
        .dm-map-figure .dm-sb-keys, .dm-map-figure .dm-sb-toggle { display: none; }
        .dm-map-figure .dm-sb-label { padding: 8px 12px 5px; font-size: 11px; }
        .dm-map-figure .dm-sb-group + .dm-sb-group { margin-top: 12px; }
        .dm-map-figure .dm-sb-pin-x { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; margin-right: -8px; color: var(--dm-label); }
        .dm-map-figure .dm-sb-pin-x .dm-ico { width: 11px; height: 11px; opacity: 1; }
        .dm-map-figure .dm-sb-invite { height: 38px; padding: 0 12px; gap: 12px; font-size: 13px; border-radius: 11px; }
        .dm-map-figure .dm-sb-invite .dm-ico { width: 17px; height: 17px; }
        .dm-map-figure .dm-sb-sub { padding-left: 24px; }
        .dm-map-figure .dm-sb-sub::before { left: 20px; }
    }
</style>
