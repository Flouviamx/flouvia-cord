---
// Mockup: paso "¿Qué le vas a cotizar?" del editor con tres líneas negociadas.
//
// Calca de nueva.astro: encabezado del paso 2, columnas reales (la de impuesto
// aparece porque la cuenta tiene más de una tasa), el precio sugerido por
// historial bajo el nombre ("Sugerido: … (68% cierra)", plantilla
// sugeridoConCierreTpl) y el margen en rojo cuando una línea baja del mínimo
// de Ajustes › Aprobaciones (aquí 20%).
//
// La marca original del artículo pedía licencias y laptops; se usan productos
// de Materiales del Valle (el negocio de demo) con las mismas cifras de la
// historia: precio de lista 29,000.00, sugerido 27,550.00 y margen 18%.
import DocsMockup from './DocsMockup.astro';
import DmIcon from './DmIcon.astro';
import CotEdLines, { type CotLine } from './CotEdLines.astro';
import './dm-cot-editor.css';
import { getEditorRuntimeI18n } from '../../../i18n/app';
import { dmT, dmMoney, pick, tpl, type DmLang } from './format';

interface Props {
    lang: DmLang;
    /** Pie de figura; por defecto describe las líneas. */
    caption?: string;
}
const { lang } = Astro.props;
const RT = getEditorRuntimeI18n(lang);
const CUR = 'MXN';
const sugerido = tpl(RT.sugeridoConCierreTpl, { precio: dmMoney(27550, CUR, lang), pct: 68 });

const DATA: { es: { caption: string; lines: CotLine[] }; en: { caption: string; lines: CotLine[] } } = {
    es: {
        caption: `Paso ¿Qué le vas a cotizar? con tres líneas: cemento gris × 400, revolvedora de concreto × 2 y renta de bomba para colado × 10. Bajo la revolvedora, el precio sugerido ${dmMoney(27550, CUR, 'es')} (68% cierra), y su margen de 18% en rojo por quedar bajo el mínimo de 20%.`,
        lines: [
            { name: 'Cemento gris CPC 30R', unit: 'saco 50 kg', qty: 400, lista: 245, nego: 235, tax: 'IVA 16%', costo: 178.6 },
            { name: 'Revolvedora de concreto 1 saco', unit: 'pieza', qty: 2, lista: 29000, nego: 25900, tax: 'IVA 16%', costo: 21238, hint: sugerido },
            { name: 'Renta de bomba para colado', unit: 'hora', qty: 10, lista: 1850, tax: 'IVA 16%', costo: 990 },
        ],
    },
    en: {
        caption: `"What are you quoting them?" step with three lines: gray cement × 400, concrete mixer × 2 and concrete pump rental × 10. Under the mixer, the suggested price ${dmMoney(27550, CUR, 'en')} (68% close), and its 18% margin in red for falling below the 20% minimum.`,
        lines: [
            { name: 'Gray cement CPC 30R', unit: '50 kg bag', qty: 400, lista: 245, nego: 235, tax: 'IVA 16%', costo: 178.6 },
            { name: 'Concrete mixer, 1 bag', unit: 'piece', qty: 2, lista: 29000, nego: 25900, tax: 'IVA 16%', costo: 21238, hint: sugerido },
            { name: 'Concrete pump rental', unit: 'hour', qty: 10, lista: 1850, tax: 'IVA 16%', costo: 990 },
        ],
    },
};
const d = pick(DATA, lang);
const caption = Astro.props.caption ?? d.caption;
---
<DocsMockup lang={lang} variant="app" chrome="topbar" title={dmT(lang, 'ed.title_nueva')} crumbs={[dmT(lang, 'ed.crumb_cotizaciones')]} caption={caption} class="dm-cot-ln-figure">
    <span slot="actions" class="dm-ced-draft">{dmT(lang, 'ed.borrador')}</span>
    <div class="dm-ced dm-cot-ln">
        <div class="dm-ced-step">
            <span class="dm-ced-num">2</span>
            <span class="dm-ced-step-text">
                <span class="dm-ced-step-title">{dmT(lang, 'ed.paso2_titulo')}</span>
                <span class="dm-ced-step-hint" set:html={dmT(lang, 'ed.paso2_hint')} />
            </span>
        </div>
        <CotEdLines lang={lang} lines={d.lines} marginMin={20} />
        <div class="dm-ced-add">
            <span class="dm-ced-search"><DmIcon name="search" /><span class="dm-ced-search-t">{dmT(lang, 'ed.buscar_producto_ph')}</span></span>
            <span class="dm-ced-btn2">{dmT(lang, 'ed.linea_libre')}</span>
            <span class="dm-ced-btn2 dm-hide-narrow">{dmT(lang, 'ed.insertar_kit')}</span>
        </div>
    </div>
</DocsMockup>

<style is:global>
    .dm-cot-ln-figure .dm-content, .dm-cot-ln-figure .dm-page-head { padding-right: calc(4px + var(--dm-bleed)); }
    .dm-cot-ln { padding: 6px 0 4px; }
</style>
