    .qx-btn-primary:hover { transform: translateY(-2px); filter: brightness(1.15); }
    .qx-btn-ghost { color: #0a192f; background: #f5f5f7; }
    .qx-btn-ghost:hover { background: #ececef; }
    .qx-restart { align-self: flex-start; font-size: 0.8rem; font-weight: 600; color: #6b7686; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
    .qx-restart:hover { color: #0a192f; text-decoration: underline; text-underline-offset: 3px; }
    .qx-restart:focus-visible { outline: 2px solid #0a192f; outline-offset: 2px; border-radius: 6px; }

    /* ── Vista del vendedor ── */
    .qx-seller { display: flex; flex-direction: column; gap: 0.55rem; }
    .qx-seller-top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }
    .qx-sim { display: inline-flex; align-items: center; gap: 6px; font-size: 0.68rem; font-weight: 600; color: #8a93a2; letter-spacing: 0.01em; }
    .qx-sim svg { color: #8a93a2; }
    .qx-sheet-close {
        display: none; width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer;
        background: rgba(10,25,47,0.05); color: #0a192f; place-items: center;
    }
    .qx-sheet-close:focus-visible { outline: 2px solid #0a192f; outline-offset: 2px; }
    .qx-seller-title { margin: 0; font-size: 0.98rem; font-weight: 600; letter-spacing: -0.02em; color: #050505; }

    .qx-app {
        position: relative;
        background: #fff; border-radius: 18px;
        border: 1px solid rgba(10,25,47,0.06);
        box-shadow: 0 1px 2px rgba(10,25,47,0.05), 0 20px 50px -24px rgba(10,25,47,0.22);
    }
    .qx-app-bar {
        display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
        padding: 0.7rem 1rem; border-bottom: 1px solid rgba(10,25,47,0.06);
    }
    .qx-crumb { font-size: 0.7rem; color: #8a93a2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .qx-crumb b { color: #050505; font-weight: 600; }
    .qx-status { font-size: 0.66rem; font-weight: 600; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
    .qx-head { display: flex; align-items: flex-start; gap: 0.7rem; padding: 0.9rem 1rem 0.3rem; }
    .qx-avatar {
