        transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), filter 0.2s, background 0.2s;
    }
    .qx-btn:active { transform: scale(0.97); transition-duration: 0.08s; }
    .qx-btn:focus-visible { outline: 2px solid #0a192f; outline-offset: 3px; }
