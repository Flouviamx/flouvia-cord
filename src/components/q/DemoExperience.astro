    .qx-feat-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
    .qx-feat-label { font-size: 0.86rem; font-weight: 600; color: #050505; letter-spacing: -0.01em; }
    .qx-feat-desc { font-size: 0.78rem; color: #6b7686; line-height: 1.45; }
    .qx-feat-arrow { flex-shrink: 0; color: #a3abb8; transition: transform 0.25s cubic-bezier(0.22,1,0.36,1), color 0.2s; }
    .qx-feat:hover .qx-feat-arrow { transform: translateX(2px); color: #0a192f; }
    .qx-close-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.6rem; }
    .qx-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 48px; padding: 0 22px; border-radius: 999px;
