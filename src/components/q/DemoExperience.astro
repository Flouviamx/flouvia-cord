---
// DemoExperience — la capa que convierte /q/demo en un recorrido.
//
// Envuelve a QuoteCard (slot) y agrega tres piezas que SOLO existen en la demo:
//   · la vista simulada del vendedor: lo que la app le muestra a tu equipo
//     mientras el cliente usa el link (presencia, atención por sección y
//     actividad), calcada de /app/cotizaciones/[id] y de la campana de
//     notificaciones de AppLayout;
//   · una guía de cinco pasos que avanza cuando el visitante HACE la acción,
//     escuchando los eventos `cord:*` que emite QuoteCard;
//   · un cierre con los features que se acaban de vivir.
//
// Nada de esto habla con el servidor (regla 19): todo sale de los eventos del
// navegador. Las cotizaciones reales nunca renderizan este componente.
import { t } from '../../i18n/app';
import { publicPath } from '../../i18n/utils';
import { currentLocale } from '../../lib/context';
import { money } from '../../lib/fmt-server';
import { quoteTotal, STATUS_META } from '../../lib/quote';
import { FEATURES } from '../../lib/producto';
import { FEATURES_EN } from '../../lib/producto.en';

interface Props {
    quote: any;
    org: any;
}

const { quote: q } = Astro.props;
const L = currentLocale();
const lang = L === 'en' ? 'en' : 'es';
const tf = (key: string, vars: Record<string, string> = {}) => {
    let s = t(L, key as any);
    for (const k in vars) s = s.split(`{${k}}`).join(vars[k]);
    return s;
};

const signup = publicPath('/registro', lang);
const planes = publicPath('/precios', lang);

const items: any[] = Array.isArray(q.items) ? q.items : [];
const linea2 = items[1] ?? items[0];
// Total si el cliente quita la segunda partida: el mismo motor que el link.
const montoSinLinea2 = money(quoteTotal({ ...q, items: items.filter((it) => it.id !== linea2?.id) }));

// Estados con el color de STATUS_META y la etiqueta de la app en el idioma.
const statusLabel = (s: string) => (s === 'rejected' ? t(L, 'q.seller_rechazada') : t(L, `cot.col.${s}` as any));
const STATUS = Object.fromEntries(
    (['sent', 'viewed', 'approved', 'rejected', 'paid'] as const).map((s) => [
        s,
        { label: statusLabel(s), color: STATUS_META[s].color, bg: STATUS_META[s].bg },
    ]),
);
const inicial = STATUS[q.status] ?? STATUS.viewed;

// Mismo mapeo de color que la bitácora de /app/cotizaciones/[id].
const dotColor = (tipo: string) =>
    tipo === 'approved' || tipo === 'paid' ? '#10b981'
    : tipo === 'viewed' ? '#7c3aed'
    : tipo === 'sent' ? '#3b82f6'
    : tipo === 'rejected' ? '#ef4444'
    : '#cbd5e1';

const SEC_LABEL = {
    resumen: t(L, 'q.atencion.sec_resumen'),
    partidas: t(L, 'q.atencion.sec_partidas'),
    notas: t(L, 'q.atencion.sec_notas'),
    pago: t(L, 'q.atencion.sec_pago'),
    conversacion: t(L, 'q.atencion.sec_conversacion'),
};

const CATALOGO = lang === 'en' ? FEATURES_EN : FEATURES;
const ICONOS: Record<string, string> = {
    'link-publico': '<path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" /><rect x="3" y="3" width="18" height="18" rx="5" fill="currentColor" fill-opacity="0.12" stroke="none" />',
    seguimiento: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" fill="currentColor" fill-opacity="0.14" /><circle cx="12" cy="12" r="3" />',
    negociacion: '<path d="M21 14.5a2 2 0 0 1-2 2H8l-4 3.5V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2Z" fill="currentColor" fill-opacity="0.14" /><line x1="8" y1="9" x2="16" y2="9" /><line x1="8" y1="12.5" x2="13" y2="12.5" />',
    pagos: '<rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="currentColor" fill-opacity="0.14" /><line x1="2.5" y1="10" x2="21.5" y2="10" /><line x1="6" y1="15" x2="10" y2="15" />',
    facturacion: '<path d="M14 2.5H6.5a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8Z" fill="currentColor" fill-opacity="0.14" /><polyline points="14 2.5 14 8 19.5 8" /><line x1="8.5" y1="13" x2="15.5" y2="13" /><line x1="8.5" y1="16.5" x2="13" y2="16.5" />',
};
const FEATS = [
    { slug: 'link-publico', desc: 'q.demo_cierre_link' },
    { slug: 'seguimiento', desc: 'q.demo_cierre_seguimiento' },
    { slug: 'negociacion', desc: 'q.demo_cierre_negociacion' },
    { slug: 'pagos', desc: 'q.demo_cierre_pagos' },
    { slug: 'facturacion', desc: 'q.demo_cierre_facturacion' },
].map((f) => ({
    ...f,
    label: CATALOGO.find((x) => x.slug === f.slug)?.nav ?? f.slug,
    href: publicPath(`/producto/${f.slug}`, lang),
    icon: ICONOS[f.slug],
}));

const eventos: any[] = Array.isArray(q.eventos) ? q.eventos : [];

// Todo lo que el script necesita, ya resuelto en el idioma del request.
const data = {
    intl: L === 'en' ? 'en-US' : 'es-MX',
    tz: 'America/Mexico_City',
    currency: (q.baseCurrency as string) || 'MXN',
    folio: q.folio,
    cliente: q.cliente,
    linea2: linea2 ? String(linea2.id) : '',
    lineas: Object.fromEntries(items.map((it) => [String(it.id), String(it.descripcion)])),
    status: STATUS,
    dots: { comment: dotColor('comment'), counter: dotColor('counter'), approved: dotColor('approved'), rejected: dotColor('rejected'), paid: dotColor('paid'), viewed: dotColor('viewed') },
    secLabels: SEC_LABEL,
    s: {
        hoy: t(L, 'q.seller_hoy'),
        viendo: t(L, 'id.viendo_ahora'),
        eventos1: t(L, 'q.seller_eventos_uno'),
        eventosN: t(L, 'q.seller_eventos'),
        evLinea: t(L, 'q.seller_ev_linea'),
        evPropuesta: t(L, 'q.seller_ev_propuesta'),
        evFirma: t(L, 'q.seller_ev_firma'),
        evFirmaParcial: t(L, 'q.seller_ev_firma_parcial'),
        evRechazo: t(L, 'q.seller_ev_rechazo'),
        evRechazoSin: t(L, 'q.seller_ev_rechazo_sin'),
        evPago: t(L, 'q.seller_ev_pago'),
        notif: {
            viewed: t(L, 'notif.tipo.viewed'),
            comment: t(L, 'notif.tipo.comment'),
            counter: t(L, 'notif.tipo.counter'),
            approved: t(L, 'notif.tipo.approved'),
            rejected: t(L, 'notif.tipo.rejected'),
            paid: t(L, 'notif.tipo.paid'),
        },
        paso: t(L, 'q.tour_paso'),
        hecho: t(L, 'q.tour_hecho'),
        accion: t(L, 'q.tour_accion'),
        siguiente: t(L, 'q.tour_siguiente'),
        cerrar: t(L, 'q.tour_cerrar'),
        tituloFirma: t(L, 'q.demo_cierre_titulo_firma'),
        tituloPago: t(L, 'q.demo_cierre_titulo_pago'),
        pasos: [
            { titulo: t(L, 'q.tour_1_titulo'), texto: t(L, 'q.tour_1_texto'), accion: false },
            { titulo: t(L, 'q.tour_2_titulo'), texto: tf('q.tour_2_texto', { linea: String(linea2?.descripcion ?? '') }), accion: true },
            { titulo: t(L, 'q.tour_3_titulo'), texto: tf('q.tour_3_texto', { linea: String(linea2?.descripcion ?? ''), monto: montoSinLinea2 }), accion: true },
            { titulo: t(L, 'q.tour_4_titulo'), texto: t(L, 'q.tour_4_texto'), accion: true },
            { titulo: t(L, 'q.tour_5_titulo'), texto: t(L, 'q.tour_5_texto'), accion: true },
        ],
    },
};
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="qx-stage" data-qx-root>
    <script type="application/json" id="qxData" is:inline set:html={dataJson} />

    <div class="qx-main">
        <slot />

        <section class="qx-close" id="qxClose" hidden aria-labelledby="qxCloseTitle">
            <span class="qx-close-eyebrow">{t(L, 'q.demo_cierre_eyebrow')}</span>
            <h2 class="qx-close-title" id="qxCloseTitle">{t(L, 'q.demo_cierre_titulo_firma')}</h2>
            <p class="qx-close-sub">{t(L, 'q.demo_cierre_sub')}</p>
            <ul class="qx-feats">
                {FEATS.map((f) => (
                    <li>
                        <a class="qx-feat" href={f.href}>
                            <span class="qx-feat-ico" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
                            </span>
                            <span class="qx-feat-body">
                                <span class="qx-feat-label">{f.label}</span>
                                <span class="qx-feat-desc">{t(L, f.desc as any)}</span>
                            </span>
                            <svg class="qx-feat-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18" /></svg>
                        </a>
                    </li>
                ))}
            </ul>
            <div class="qx-close-actions">
                <a class="qx-btn qx-btn-primary" href={signup}>
                    {t(L, 'q.demo_cierre_cta')}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                </a>
                <a class="qx-btn qx-btn-ghost" href={planes}>{t(L, 'q.demo_cierre_planes')}</a>
            </div>
            <a class="qx-restart" href="/q/demo">{t(L, 'q.demo_reiniciar')}</a>
        </section>
    </div>

    <aside class="qx-seller" id="qxSeller" aria-labelledby="qxSellerTitle">
        <div class="qx-seller-top">
            <span class="qx-sim">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2.5" fill="currentColor" fill-opacity="0.14" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
                {t(L, 'q.seller_sim')}
            </span>
            <button type="button" class="qx-sheet-close" id="qxSheetClose" aria-label={t(L, 'q.seller_cerrar')}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>
        <h2 class="qx-seller-title" id="qxSellerTitle">{t(L, 'q.seller_titulo')}</h2>

        <div class="qx-app">
            <div class="qx-toast" id="qxToast" aria-hidden="true"></div>

            <div class="qx-app-bar">
                <span class="qx-crumb">{t(L, 'sidebar.item.cotizaciones')} <span aria-hidden="true">/</span> <b>{q.folio}</b></span>
                <span class="qx-status" id="qxStatus" style={`color:${inicial.color}; background:${inicial.bg}`}>{inicial.label}</span>
            </div>

            <div class="qx-head">
                <span class="qx-avatar" aria-hidden="true">{q.clienteInicial}</span>
                <div class="qx-head-text">
                    <span class="qx-name">{q.cliente}</span>
                    <span class="qx-meta">{q.terminos} · {t(L, 'id.vigente_hasta')} {q.vigencia}</span>
                    <span class="qx-live" id="qxLive" hidden>
                        <span class="qx-live-dot"></span>
                        <span>{t(L, 'id.viendo_ahora')}<span class="qx-live-sec" id="qxLiveSec"></span></span>
                    </span>
                </div>
            </div>
            <div class="qx-total">
                <span>{t(L, 'id.total')}</span>
                <span class="editorial" id="qxTotal">{money(quoteTotal(q))}</span>
            </div>

            <section class="qx-sec">
                <h3>{t(L, 'id.atencion.titulo')}</h3>
                <div class="qx-at-sum">
                    <span>{t(L, 'id.atencion.persona')}</span>
                    <span class="qx-at-sep" aria-hidden="true">·</span>
                    <span>{tf('id.atencion.aperturas', { n: '2' })}</span>
                </div>
                <div class="qx-bars" id="qxBars"></div>
            </section>

            <section class="qx-sec">
                <h3>{t(L, 'id.actividad')}</h3>
                <div class="qx-tl" id="qxFeed" aria-live="polite">
                    {eventos.map((e) => (
                        <div class="qx-tl-item">
                            <span class="qx-tl-dot" style={`background:${dotColor(e.tipo)}`}></span>
                            <div class="qx-tl-body">
                                <span class="qx-tl-text">{e.detalle}</span>
                                <span class="qx-tl-time">{e.cuando}</span>
                            </div>
                        </div>
                    ))}
                </div>
            </section>
        </div>
    </aside>
</div>

<button type="button" class="qx-pill" id="qxPill" aria-controls="qxSeller" aria-expanded="false" aria-label={t(L, 'q.seller_abrir')}>
    <span class="qx-live-dot" aria-hidden="true"></span>
    <span class="qx-pill-text" id="qxPillText">{t(L, 'q.seller_pill')}</span>
    <span class="qx-pill-count" id="qxPillCount">{tf('q.seller_eventos', { n: String(eventos.length) })}</span>
</button>
<div class="qx-backdrop" id="qxBackdrop" hidden></div>

<div class="qx-ring" id="qxRing" aria-hidden="true" hidden></div>

<div class="qx-tour" id="qxTour" role="dialog" aria-modal="false" aria-labelledby="qxTourTitle" aria-describedby="qxTourText" hidden>
    <div class="qx-tour-top">
        <span class="qx-tour-eyebrow">{t(L, 'q.tour_label')}</span>
        <span class="qx-tour-count" id="qxTourCount" aria-hidden="true">1/5</span>
        <button type="button" class="qx-tour-x" id="qxTourX" aria-label={t(L, 'q.tour_cerrar')}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
        </button>
    </div>
    <div class="qx-tour-progress" aria-hidden="true">
        {[0, 1, 2, 3, 4].map((i) => <span data-seg={i}></span>)}
    </div>
    <p class="qx-sr" id="qxTourLive" aria-live="polite"></p>
    <h2 class="qx-tour-title" id="qxTourTitle"></h2>
    <p class="qx-tour-text" id="qxTourText"></p>
    <p class="qx-tour-hint" id="qxTourHint">
        <span class="qx-tour-hint-dot" aria-hidden="true"></span>
        <span id="qxTourHintText">{t(L, 'q.tour_accion')}</span>
    </p>
    <div class="qx-tour-foot">
        <button type="button" class="qx-tour-skip" id="qxTourSkip">{t(L, 'q.tour_saltar')}</button>
        <button type="button" class="qx-tour-next" id="qxTourNext">{t(L, 'q.tour_siguiente')}</button>
    </div>
</div>

<button type="button" class="qx-reopen" id="qxReopen" hidden>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="currentColor" fill-opacity="0.14" /><polygon points="10 8.5 16 12 10 15.5" fill="currentColor" stroke="none" /></svg>
    {t(L, 'q.tour_reabrir')}
</button>

<script>
    interface Paso { titulo: string; texto: string; accion: boolean }
    interface Meta { label: string; color: string; bg: string }
    interface Data {
        intl: string; tz: string; currency: string; folio: string; cliente: string;
        linea2: string; lineas: Record<string, string>;
        status: Record<string, Meta>; dots: Record<string, string>;
        secLabels: Record<string, string>;
        s: Record<string, any> & { pasos: Paso[]; notif: Record<string, string> };
    }

    const root = document.querySelector<HTMLElement>('[data-qx-root]');
    let D: Data | null = null;
    try { D = JSON.parse(document.getElementById('qxData')?.textContent || 'null'); } catch { D = null; }
    if (root && D) iniciar(root, D);

    function iniciar(root: HTMLElement, D: Data) {
        const S = D.s;
        const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        const escritorio = window.matchMedia('(min-width: 1400px)');
        const fill = (tpl: string, vars: Record<string, string | number>) =>
            Object.keys(vars).reduce((acc, k) => acc.split(`{${k}}`).join(String(vars[k])), tpl);
        const dinero = (n: number) => {
            try {
                return new Intl.NumberFormat(D.intl, { style: 'currency', currency: D.currency, minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
            } catch { return String(n); }
        };
        // Formato de la bitácora de la app: "hoy, 18:40" en la zona del negocio.
        const horaTl = () => {
            const hhmm = new Intl.DateTimeFormat(D.intl, { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: D.tz }).format(new Date());
            return `${S.hoy}, ${hhmm}`;
        };
        // Formato de la campana: Intl.RelativeTimeFormat corto, como /api/notificaciones.
        const ahoraNotif = () => new Intl.RelativeTimeFormat(D.intl, { numeric: 'auto', style: 'short' }).format(0, 'minute');

        // ══════════════════════════════════════════════════════════════
        //  Vista del vendedor
        // ══════════════════════════════════════════════════════════════
        const feed = $('qxFeed');
        const statusEl = $('qxStatus');
        const totalEl = $('qxTotal');
        const live = $('qxLive');
        const liveSec = $('qxLiveSec');
        const bars = $('qxBars');
        const toast = $('qxToast');
        const pill = $<HTMLButtonElement>('qxPill');
        const pillText = $('qxPillText');
        const pillCount = $('qxPillCount');
        const pillBase = pillText?.textContent || '';

        const pintaConteo = () => {
            const n = feed?.children.length ?? 0;
            if (pillCount) pillCount.textContent = n === 1 ? S.eventos1 : fill(S.eventosN, { n });
        };

        const ponStatus = (s: string) => {
            const m = D.status[s];
            if (!statusEl || !m) return;
            statusEl.textContent = m.label;
            statusEl.style.color = m.color;
            statusEl.style.background = m.bg;
            statusEl.classList.remove('qx-pop');
            void statusEl.offsetWidth;
            statusEl.classList.add('qx-pop');
        };

        const ICONOS: Record<string, string> = {
            eye: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>',
            check: '<path d="M20 6L9 17l-5-5"/>',
            x: '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>',
            card: '<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>',
            chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
        };
        // Mismo icono y tono por tipo que la campana de AppLayout.
        const NOTIF_ICON: Record<string, string> = { viewed: 'eye', approved: 'check', rejected: 'x', paid: 'card', comment: 'chat', counter: 'chat' };
        const TONE: Record<string, string> = { approved: 'ok', paid: 'ok', viewed: 'warn', counter: 'warn', rejected: 'danger' };

        let toastTimer = 0;
        let pillTimer = 0;
        const notifica = (tipo: string) => {
            const title = S.notif[tipo];
            if (!title || !toast) return;
            const a = document.createElement('div');
            a.className = 'qx-notif-item';
            const ico = document.createElement('span');
            ico.className = `qx-notif-ico${TONE[tipo] ? ' ' + TONE[tipo] : ''}`;
            ico.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONOS[NOTIF_ICON[tipo]] || ICONOS.chat}</svg>`;
            const body = document.createElement('span');
            body.className = 'qx-notif-body';
            const t1 = document.createElement('span'); t1.className = 'qx-notif-title'; t1.textContent = title;
            const t2 = document.createElement('span'); t2.className = 'qx-notif-sub'; t2.textContent = `${D.folio} · ${D.cliente}`;
            const t3 = document.createElement('span'); t3.className = 'qx-notif-when'; t3.textContent = ahoraNotif();
            body.append(t1, t2, t3);
            a.append(ico, body);
            toast.replaceChildren(a);
            toast.classList.add('is-on');
            window.clearTimeout(toastTimer);
            toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), 5200);

            // En móvil la vista vive detrás de la píldora: la píldora avisa.
            if (pillText && pill) {
                pillText.textContent = title;
                pill.classList.add('is-news');
                window.clearTimeout(pillTimer);
                pillTimer = window.setTimeout(() => { pillText.textContent = pillBase; pill.classList.remove('is-news'); }, 3600);
            }
        };

        const evento = (tipo: string, texto: string, conNotif = true) => {
            if (!feed) return;
            const item = document.createElement('div');
            item.className = 'qx-tl-item qx-in';
            const dot = document.createElement('span');
            dot.className = 'qx-tl-dot';
            dot.style.background = D.dots[tipo] || '#cbd5e1';
            const body = document.createElement('div');
            body.className = 'qx-tl-body';
            const tx = document.createElement('span'); tx.className = 'qx-tl-text'; tx.textContent = texto;
            const tm = document.createElement('span'); tm.className = 'qx-tl-time'; tm.textContent = horaTl();
            body.append(tx, tm);
            item.append(dot, body);
            feed.prepend(item);
            feed.scrollTop = 0;
            pintaConteo();
            if (conNotif) notifica(tipo);
        };

        // ── Presencia y atención por sección ──
        // En la app llegan por el latido del link (cada 10 s) y el stream del
        // detalle; aquí se leen del scroll del propio visitante.
        const dwell: Record<string, number> = {};
        let seccion: string | null = null;
        const pintaPresencia = () => {
            if (!live) return;
            const visible = document.visibilityState === 'visible';
            live.hidden = !visible;
            if (liveSec) liveSec.textContent = seccion && D.secLabels[seccion] ? ` — ${D.secLabels[seccion]}` : '';
        };
        const fmtDwell = (s: number) => {
            if (!s || s <= 0) return '—';
            if (s < 60) return `${s}s`;
            const m = Math.floor(s / 60), r = s % 60;
            return r ? `${m}m ${r}s` : `${m}m`;
        };
        const pintaBarras = () => {
            if (!bars) return;
            const filas = Object.entries(dwell).filter(([, v]) => v > 0).sort((a, b) => b[1] - a[1]);
            const max = filas.reduce((m, [, v]) => Math.max(m, v), 0) || 1;
            const existentes = new Map<string, HTMLElement>();
            bars.querySelectorAll<HTMLElement>('.qx-at-fila').forEach((f) => existentes.set(f.dataset.sec || '', f));
            filas.forEach(([clave, seg]) => {
                let fila = existentes.get(clave);
                if (!fila) {
                    fila = document.createElement('div');
                    fila.className = 'qx-at-fila';
                    fila.dataset.sec = clave;
                    fila.innerHTML = '<span class="qx-at-label"></span><span class="qx-at-track"><span class="qx-at-fill"></span></span><span class="editorial qx-at-val"></span>';
                    (fila.querySelector('.qx-at-label') as HTMLElement).textContent = D.secLabels[clave] || clave;
                }
                (fila.querySelector('.qx-at-fill') as HTMLElement).style.width = `${Math.round((seg / max) * 100)}%`;
                (fila.querySelector('.qx-at-val') as HTMLElement).textContent = fmtDwell(seg);
                bars.appendChild(fila); // re-ordena sin recrear
            });
        };

        // La sección "activa" es la que cruza la línea de lectura (45 % de la
        // ventana). Un umbral de IntersectionObserver no sirve aquí: una sección
        // más alta que la ventana nunca llega a verse al 20 %.
        const secciones = Array.from(document.querySelectorAll<HTMLElement>('.q-card [data-sec]'));
        let lecturaPendiente = false;
        const leeSeccion = () => {
            lecturaPendiente = false;
            const linea = window.innerHeight * 0.45;
            let mejor: string | null = null;
            let distancia = Infinity;
            for (const el of secciones) {
                const r = el.getBoundingClientRect();
                if (r.height === 0) continue;
                const d = r.top <= linea && r.bottom >= linea ? 0 : Math.min(Math.abs(r.top - linea), Math.abs(r.bottom - linea));
                if (d < distancia) { distancia = d; mejor = el.dataset.sec || null; }
            }
            if (mejor && mejor !== seccion) { seccion = mejor; pintaPresencia(); }
        };
        const agendaLectura = () => {
            if (lecturaPendiente) return;
            lecturaPendiente = true;
            window.requestAnimationFrame(leeSeccion);
        };
        window.addEventListener('scroll', agendaLectura, { passive: true });
        window.addEventListener('resize', agendaLectura);
        let tick = 0;
        window.setInterval(() => {
            if (document.visibilityState !== 'visible' || !seccion) return;
            dwell[seccion] = (dwell[seccion] ?? 0) + 1;
            if (++tick % 2 === 0) pintaBarras();
        }, 1000);
        window.setTimeout(() => { leeSeccion(); if (!seccion) seccion = 'resumen'; pintaPresencia(); }, 900);
        document.addEventListener('visibilitychange', pintaPresencia);

        // ── Lo que el cliente hace → lo que ve el vendedor ──
        let aprobacion: any = null;
        window.addEventListener('cord:item_comment', (e: Event) => {
            const d = (e as CustomEvent).detail || {};
            // Los comentarios por línea no van a la campana: el vendedor los ve
            // en la propia línea del detalle, en vivo.
            evento('comment', fill(S.evLinea, { linea: D.lineas[String(d.item_id)] || '', mensaje: `"${String(d.mensaje || '')}"` }), false);
        });
        window.addEventListener('cord:message', (e: Event) => {
            const d = (e as CustomEvent).detail || {};
            const mensaje = String(d.mensaje || '');
            if (d.action === 'counter') {
                const monto = Number(d.propuesta) > 0 ? fill(S.evPropuesta, { monto: dinero(Number(d.propuesta)) }) : '';
                evento('counter', [monto, mensaje].filter(Boolean).join(' — '));
            } else {
                evento('comment', mensaje);
            }
        });
        window.addEventListener('cord:demo_approved', (e: Event) => { aprobacion = (e as CustomEvent).detail || null; });
        window.addEventListener('cord:approved', (e: Event) => {
            const d = (e as CustomEvent).detail || {};
            const nombre = String(d.signed_by || '');
            const a = aprobacion;
            const parcial = a && a.count < a.of;
            ponStatus('approved');
            if (a && totalEl) totalEl.textContent = dinero(Number(a.total));
            evento('approved', parcial
                ? fill(S.evFirmaParcial, { nombre, n: a.count, total: a.of, aceptado: dinero(a.brutoAceptado), todo: dinero(a.brutoTotal) })
                : fill(S.evFirma, { nombre }));
        });
        window.addEventListener('cord:rejected', (e: Event) => {
            const motivo = String((e as CustomEvent).detail?.comentario || '');
            ponStatus('rejected');
            evento('rejected', motivo ? fill(S.evRechazo, { motivo }) : S.evRechazoSin);
        });
        window.addEventListener('cord:demo_paid', () => {
            ponStatus('paid');
            evento('paid', S.evPago);
        });

        // ── Hoja inferior (móvil y tableta) ──
        const seller = $('qxSeller');
        const backdrop = $('qxBackdrop');
        const sheetClose = $<HTMLButtonElement>('qxSheetClose');
        let sheetAbierta = false;
        const abreHoja = () => {
            if (!seller || escritorio.matches) return;
            sheetAbierta = true;
            seller.classList.add('is-open');
            seller.setAttribute('role', 'dialog');
            seller.setAttribute('aria-modal', 'true');
            if (backdrop) backdrop.hidden = false;
            pill?.setAttribute('aria-expanded', 'true');
            window.setTimeout(() => sheetClose?.focus(), 60);
        };
        const cierraHoja = (devolverFoco = true) => {
            if (!seller || !sheetAbierta) return;
            sheetAbierta = false;
            seller.classList.remove('is-open');
            seller.removeAttribute('role');
            seller.removeAttribute('aria-modal');
            if (backdrop) backdrop.hidden = true;
            pill?.setAttribute('aria-expanded', 'false');
            if (devolverFoco) pill?.focus();
        };
        pill?.addEventListener('click', () => (sheetAbierta ? cierraHoja() : abreHoja()));
        sheetClose?.addEventListener('click', () => cierraHoja());
        backdrop?.addEventListener('click', () => cierraHoja());
        escritorio.addEventListener('change', () => cierraHoja(false));

        // ══════════════════════════════════════════════════════════════
        //  Guía
        // ══════════════════════════════════════════════════════════════
        const KEY = 'cord.demo.guia.cerrada';
        const recordada = () => { try { return localStorage.getItem(KEY) === '1'; } catch { return false; } };
        const recuerda = (cerrada: boolean) => {
            try { if (cerrada) localStorage.setItem(KEY, '1'); else localStorage.removeItem(KEY); } catch { /* modo privado */ }
        };

        const tour = $('qxTour');
        const ring = $('qxRing');
        const reopen = $<HTMLButtonElement>('qxReopen');
        const titleEl = $('qxTourTitle');
        const textEl = $('qxTourText');
        const hintEl = $('qxTourHint');
        const hintText = $('qxTourHintText');
        const countEl = $('qxTourCount');
        const liveEl = $('qxTourLive');
        const nextBtn = $<HTMLButtonElement>('qxTourNext');
        const skipBtn = $<HTMLButtonElement>('qxTourSkip');
        const xBtn = $<HTMLButtonElement>('qxTourX');
        const segs = Array.from(tour?.querySelectorAll<HTMLElement>('[data-seg]') ?? []);
        const TOTAL = S.pasos.length;

        const visible = (el: Element | null): el is HTMLElement => {
            if (!el) return false;
            const r = (el as HTMLElement).getBoundingClientRect();
            return r.width > 0 && r.height > 0;
        };
        const q1 = (sel: string) => document.querySelector<HTMLElement>(sel);
        const OBJETIVOS: Array<() => HTMLElement | null> = [
            () => q1('.q-total-hero'),
            () => {
                const hilo = document.getElementById(`thread-${D.linea2}`);
                if (hilo && !hilo.classList.contains('ql-hidden')) {
                    const caja = hilo.querySelector<HTMLElement>('.qi-reply-box');
                    return visible(caja) ? caja : hilo;
                }
                return q1(`.qi-chat-btn[data-item-id="${CSS.escape(D.linea2)}"]`);
            },
            () => q1(`.qi-row-wrapper[data-line-id="${CSS.escape(D.linea2)}"] .qi-pick`),
            () => {
                const firma = document.getElementById('stepSign');
                if (firma && !firma.classList.contains('ql-hidden')) return firma;
                return q1('#qApproveBtn');
            },
            () => {
                const pago = document.getElementById('qDemoPay');
                if (pago && !pago.hidden) {
                    const sim = document.getElementById('qDemoPaySim');
                    return visible(sim) ? sim : pago;
                }
                const btn = q1('#qPayBtn');
                return visible(btn) ? btn : q1('#qApproveBtn');
            },
        ];

        let paso = 0;
        let activa = false;
        let terminada = false;
        let raf = 0;

        const enPantalla = (el: HTMLElement) => {
            const r = el.getBoundingClientRect();
            return r.top >= 64 && r.bottom <= window.innerHeight - 180;
        };
        const llevaA = (el: HTMLElement | null) => {
            if (!el || enPantalla(el)) return;
            el.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'center' });
        };

        const sigueObjetivo = () => {
            if (!activa || !ring) return;
            const el = OBJETIVOS[paso]?.();
            if (visible(el)) {
                const r = el.getBoundingClientRect();
                const pad = 6;
                ring.hidden = false;
                ring.style.transform = `translate(${Math.round(r.left - pad)}px, ${Math.round(r.top - pad)}px)`;
                ring.style.width = `${Math.round(r.width + pad * 2)}px`;
                ring.style.height = `${Math.round(r.height + pad * 2)}px`;
            } else {
                ring.hidden = true;
            }
            raf = window.requestAnimationFrame(sigueObjetivo);
        };

        const pinta = () => {
            const p = S.pasos[paso];
            if (!p || !tour) return;
            tour.classList.remove('is-done');
            if (titleEl) titleEl.textContent = p.titulo;
            if (textEl) textEl.textContent = p.texto;
            if (countEl) countEl.textContent = `${paso + 1}/${TOTAL}`;
            if (liveEl) liveEl.textContent = `${fill(S.paso, { n: paso + 1, total: TOTAL })}: ${p.titulo}`;
            if (hintEl) hintEl.hidden = !p.accion;
            if (hintText) hintText.textContent = S.accion;
            segs.forEach((s, i) => { s.classList.toggle('is-on', i <= paso); });
            if (ring && !reduce.matches) {
                ring.classList.add('is-moving');
                window.setTimeout(() => ring.classList.remove('is-moving'), 450);
            }
            if (nextBtn) nextBtn.textContent = paso === TOTAL - 1 ? S.cerrar : S.siguiente;
        };

        const colocaSticky = () => {
            // La barra fija de "Aprobar" se centra en la tarjeta, no en la ventana,
            // cuando la vista del vendedor ocupa la columna derecha.
            const sticky = document.getElementById('qSticky');
            const card = document.querySelector<HTMLElement>('.q-card');
            if (!sticky || !card) return;
            if (escritorio.matches) {
                const r = card.getBoundingClientRect();
                sticky.style.left = `${Math.round(r.left)}px`;
                sticky.style.right = 'auto';
                sticky.style.width = `${Math.round(r.width)}px`;
                sticky.style.paddingLeft = '0';
                sticky.style.paddingRight = '0';
            } else {
                sticky.style.left = sticky.style.right = sticky.style.width = '';
                sticky.style.paddingLeft = sticky.style.paddingRight = '';
            }
        };

        const muestra = (i: number) => {
            if (!tour) return;
            activa = true;
            paso = Math.max(0, Math.min(TOTAL - 1, i));
            tour.hidden = false;
            if (reopen) reopen.hidden = true;
            document.documentElement.classList.add('qx-guia');
            pinta();
            window.cancelAnimationFrame(raf);
            raf = window.requestAnimationFrame(sigueObjetivo);
            ajustaSticky();
        };
        const oculta = (recordar: boolean) => {
            if (!tour) return;
            activa = false;
            tour.hidden = true;
            if (ring) ring.hidden = true;
            window.cancelAnimationFrame(raf);
            document.documentElement.classList.remove('qx-guia');
            if (recordar) recuerda(true);
            if (reopen) reopen.hidden = terminada;
            ajustaSticky();
        };
        // El riel de la guía desplaza la tarjeta en escritorio ancho; la barra
        // fija se recoloca al terminar esa transición (o de inmediato sin ella).
        function ajustaSticky() {
            colocaSticky();
            window.setTimeout(colocaSticky, 480);
        }
        const ve = (i: number, llevar = true) => {
            if (i >= TOTAL) { terminada = true; oculta(true); return; }
            muestra(i);
            if (llevar) window.setTimeout(() => llevaA(OBJETIVOS[paso]?.() ?? null), 60);
        };
        // El visitante hizo la acción del paso `i`. Si iba adelantado (aprobó
        // sin pasar por la pregunta), la guía lo alcanza en vez de regresarlo.
        const hecho = (i: number) => {
            if (!activa || paso > i) return;
            if (paso < i) { ve(i + 1); return; }
            tour?.classList.add('is-done');
            if (hintEl) hintEl.hidden = false;
            if (hintText) hintText.textContent = S.hecho;
            window.setTimeout(() => { if (activa && paso === i) ve(i + 1); }, 850);
        };

        nextBtn?.addEventListener('click', () => ve(paso + 1));
        skipBtn?.addEventListener('click', () => oculta(true));
        xBtn?.addEventListener('click', () => oculta(true));
        reopen?.addEventListener('click', () => {
            recuerda(false);
            const aprobada = !document.getElementById('stepApproved')?.classList.contains('ql-hidden');
            ve(aprobada ? TOTAL - 1 : 0);
            window.setTimeout(() => nextBtn?.focus(), 80);
        });
        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            if (sheetAbierta) { cierraHoja(); return; }
            if (activa && tour?.contains(document.activeElement)) { oculta(true); reopen?.focus(); }
        });

        window.addEventListener('cord:item_comment', () => hecho(1));
        window.addEventListener('cord:demo_selection', (e: Event) => {
            const d = (e as CustomEvent).detail || {};
            if (Number(d.count) < Number(d.of)) hecho(2);
        });
        window.addEventListener('cord:approved', () => { hecho(3); muestraCierre(false); });
        window.addEventListener('cord:demo_paid', () => {
            hecho(4);
            muestraCierre(true);
        });
        window.addEventListener('cord:rejected', () => { terminada = true; oculta(false); });

        // La guía no tapa la barra fija de "Aprobar": sube cuando aparece.
        const sticky = document.getElementById('qSticky');
        if (sticky && tour) {
            const lift = () => document.documentElement.classList.toggle('qx-lift', sticky.classList.contains('q-sticky-show'));
            new MutationObserver(lift).observe(sticky, { attributes: true, attributeFilter: ['class'] });
            lift();
        }

        // ── Cierre ──
        const cierre = $('qxClose');
        const cierreTitulo = $('qxCloseTitle');
        function muestraCierre(pagado: boolean) {
            if (!cierre) return;
            if (cierreTitulo) cierreTitulo.textContent = pagado ? S.tituloPago : S.tituloFirma;
            if (cierre.hidden) {
                cierre.hidden = false;
                cierre.classList.add('qx-in');
            }
            if (pagado) {
                window.setTimeout(() => cierre.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' }), 1500);
            }
        }

        // ── Arranque ──
        colocaSticky();
        window.addEventListener('resize', colocaSticky);
        root.addEventListener('transitionend', (e) => { if (e.target === root) colocaSticky(); });
        if ('ResizeObserver' in window) {
            const card = document.querySelector('.q-card');
            if (card) new ResizeObserver(colocaSticky).observe(card);
        }
        if (recordada()) {
            if (reopen) reopen.hidden = false;
        } else {
            window.setTimeout(() => ve(0, false), 1100);
        }
        document.documentElement.classList.add('qx-demo');
    }
</script>

<style>
