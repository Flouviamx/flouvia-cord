---
import { money, lineTotal, quoteSubtotal, quoteTotal, quoteTaxBreakdown, quoteRetenciones, quoteDescuento, quoteTaxLines } from '../../lib/queries';
import { etiquetaDescuento } from '../../lib/descuentos';
import { getCountryProfile } from '../../lib/countries';
import { currencyDecimals } from '../../lib/currency';
import { taxBreakdownRows, taxNotes } from '../../lib/tax-components';
import { currentLocale, setRequestCurrency } from '../../lib/context';
import { brandStyle, brandColor, resolveBrandProfile } from '../../lib/brand-profile';
import { t } from '../../i18n/app';
import type { Quote } from '../../lib/quote';
interface Props { q:Quote; org:any; preview?:boolean; }
const {q,org:ORG,preview=false} = Astro.props;
const L = currentLocale();
setRequestCurrency(q.baseCurrency || ORG.moneda);
const descuentoPct = (lista: number, nego: number) =>
    lista > 0 ? Math.round((1 - nego / lista) * 100) : 0;
const condiciones = ORG.pdfCondiciones ? ORG.pdfCondiciones.split('\n').filter(Boolean) : [];
// Vocabulario fiscal del país del emisor: "RFC" es de México, "NIF" de España,
// "Tax ID" de Estados Unidos. El PDF que ve el cliente no puede decir RFC si su
// proveedor está en Madrid.
const PROFILE = getCountryProfile(ORG.countryCode || 'MX', L);
const TAX_LABEL = PROFILE.taxLabel;
// Un renglón por impuesto: en Canadá el 14.975% de Quebec es GST + QST.
// EE. UU.: renglones por jurisdicción del sales tax por dirección, y la nota
// de un 0 % legítimo ("sin obligación de recaudar en Texas").
const TAX_LINES = quoteTaxLines(q);
const TAX_ROWS = taxBreakdownRows(quoteTaxBreakdown(q), {
    country: ORG.countryCode || 'MX', region: ORG.fiscalMetadata?.region, taxLabel: TAX_LABEL,
    decimals: currencyDecimals(q.baseCurrency || ORG.moneda || 'MXN'), lineas: TAX_LINES,
});
const TAX_NOTES = taxNotes(TAX_LINES, L);
const TAX_ID_LABEL = PROFILE.taxIdLabel;
// Descuento de documento: subtotal BRUTO arriba y el descuento antes de impuestos.
const DESCUENTO = quoteDescuento(q);
// Fuera de México el identificador se captura en el perfil fiscal
// (`fiscal_metadata.tax_id`): el SIREN de París o la USt-IdNr. de Berlín no
// viven en `rfc`, y el PDF los omitía aunque el negocio ya los hubiera guardado.
const TAX_ID = String((PROFILE.code !== 'MX' && (ORG.fiscalMetadata?.tax_id || ORG.fiscalTaxId)) || ORG.rfc || '');

const hoy = new Intl.DateTimeFormat(L === 'en' ? 'en-US' : 'es-MX', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());

// Plantilla del PDF: clasico (acento) | minimal (líneas finas) | detallado (banda de color)
const tpl = ORG.pdfTemplate || 'clasico';
const profile = resolveBrandProfile(ORG.brandProfile);
const accent = brandColor(ORG.colorMarca);
const printLogo = ORG.logoUrl;
const darkLogo = profile.logoDark || printLogo;
---

<!doctype html>
<html lang={L}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{q.folio} — {ORG.nombre}</title>
</head>
<body>
    <!-- Toolbar (no se imprime) -->
    <div class="toolbar" hidden={preview}>
        <a href={`/app/cotizaciones/${q.id}`} class="tb-back">{t(L, 'imp.volver')}</a>
        <span class="tb-hint">{t(L, 'imp.hint')}</span>
        <button class="tb-print" onclick="window.print()">{t(L, 'imp.imprimir')}</button>
    </div>

    <main class="sheet" data-template={tpl} data-density={profile.density} style={brandStyle(profile,accent,ORG.colorSecundario)}>
        <!-- Encabezado con la marca de la org -->
        <header class="doc-head">
            <div class="dh-org">
                <img class="dh-logo dh-logo-main" data-print-logo="main" src={printLogo || undefined} alt={ORG.nombre} hidden={!printLogo}/><span class="dh-mark dh-logo-main" data-print-initial="main" hidden={!!printLogo}>{ORG.inicial}</span>
                <img class="dh-logo dh-logo-dark" data-print-logo="dark" src={darkLogo || undefined} alt={ORG.nombre} hidden={!darkLogo}/><span class="dh-mark dh-logo-dark" data-print-initial="dark" hidden={!!darkLogo}>{ORG.inicial}</span>
                <div>
                    <h1>{ORG.nombre}</h1>
                    {ORG.razonSocial && <p>{ORG.razonSocial}</p>}
                    {TAX_ID && <p>{TAX_ID_LABEL} {TAX_ID}</p>}
                    {ORG.direccion && <p>{ORG.direccion}</p>}
                    {(ORG.email || ORG.telefono) && <p>{[ORG.email, ORG.telefono].filter(Boolean).join(' · ')}</p>}
                </div>
            </div>
            <div class="dh-doc">
                <span class="dh-label">{t(L, 'imp.cotizacion')}</span>
                <span class="dh-folio editorial">{q.folio}</span>
                <span class="dh-date">{t(L, 'imp.emitida')} {q.creada}</span>
                <span class="dh-date">{t(L, 'imp.vigente_hasta')} {q.vigencia}</span>
            </div>
        </header>

        <!-- Cliente y términos -->
        <section class="doc-meta">
            <div>
                <span class="dm-label">{t(L, 'imp.para')}</span>
                <b>{q.cliente}</b>
            </div>
            <div>
                <span class="dm-label">{t(L, 'imp.terminos')}</span>
                <b>{q.terminos}</b>
            </div>
            <div>
                <span class="dm-label">{t(L, 'imp.moneda')}</span>
                <b>{q.baseCurrency || ORG.moneda}</b>
            </div>
        </section>

        <!-- Items -->
        <table class="doc-items">
            <thead>
                <tr>
                    <th>{t(L, 'imp.concepto')}</th>
                    <th class="num">{t(L, 'imp.cantidad')}</th>
                    <th class="num">{t(L, 'imp.precio_unitario')}</th>
                    <th class="num">{t(L, 'imp.importe')}</th>
                </tr>
            </thead>
            <tbody>
                {q.items.map((it) => (
                    <tr>
                        <td>
                            {it.descripcion}
                            <small>{it.unidad}</small>
                        </td>
                        <td class="num editorial">{it.cantidad.toLocaleString(L === 'en' ? 'en-US' : 'es-MX')}</td>
                        <td class="num">
                            {it.precioNegociado !== null && (
                                <span class="strike" hidden={!ORG.pdfMostrarLista}>
                                    <s>{money(it.precioLista)}</s>
                                    <i>−{descuentoPct(it.precioLista, it.precioNegociado)}%</i>
                                </span>
                            )}
                            <span class="editorial">{money(it.precioNegociado ?? it.precioLista)}</span>
                        </td>
                        <td class="num editorial">{money(lineTotal(it))}</td>
                    </tr>
                ))}
            </tbody>
        </table>

        <!-- Totales -->
        <section class="doc-totals">
            <div><span>{t(L, 'imp.subtotal')}</span><span class="editorial">{money(quoteSubtotal(q) + DESCUENTO)}</span></div>
            {DESCUENTO > 0 && (
                <div><span>{etiquetaDescuento(q.descuento, L)}</span><span class="editorial">−{money(DESCUENTO)}</span></div>
            )}
            {TAX_ROWS.map((tr) => (
                <div><span>{tr.label}</span><span class="editorial">{money(tr.impuesto)}</span></div>
            ))}
            {quoteRetenciones(q).map((r) => (
                <div><span>{r.nombre}</span><span class="editorial">−{money(r.monto)}</span></div>
            ))}
            <div class="grand">
                <span>{t(L, 'imp.total')}</span>
                <span class="editorial" >{money(quoteTotal(q))}</span>
            </div>
            {TAX_NOTES.map((nota) => <div><span>{nota}</span><span></span></div>)}
        </section>

        {q.notas && (
            <section class="doc-notes">
                <span class="dm-label">{t(L, 'imp.notas')}</span>
                <p>{q.notas}</p>
            </section>
        )}

        {(preview || condiciones.length > 0) && (
            <section class="doc-notes" id="printConditions" hidden={!condiciones.length}>
                <span class="dm-label">{t(L, 'imp.condiciones')}</span>
                <ul>
                    {condiciones.map((c) => <li>{c}</li>)}
                </ul>
            </section>
        )}

        <footer class="doc-foot">
            <p class="df-msg" id="printMessage" hidden={!ORG.pdfMensaje}>{ORG.pdfMensaje}</p>
            <p class="df-meta">{t(L, 'imp.generado_pre')} {hoy} · {ORG.nombre} {t(L, 'imp.generado_post')}</p>
        </footer>
    </main>
</body>
</html>

<style>
    [hidden] { display:none!important; }
    :root {
        --ink: #0f1729;
        --muted: #5b6472;
        --line: rgba(10,25,47,0.12);
    }
    * { box-sizing: border-box; }
    html, body {
        margin: 0; padding: 0;
        background: #eef0f3;
        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }
    .editorial { font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }

    .toolbar {
        display: flex; align-items: center; gap: 1rem;
        max-width: 820px; margin: 0 auto; padding: 1rem 1.2rem;
    }
    .tb-back { font-size: 0.82rem; font-weight: 600; color: var(--muted); text-decoration: none; }
    .tb-back:hover { color: var(--ink); }
    .tb-hint { flex: 1; font-size: 0.72rem; color: var(--muted); text-align: right; }
    .tb-print {
        font-family: inherit; font-size: 0.84rem; font-weight: 600;
        background: #0a192f; color: #fff; border: none; cursor: pointer;
        padding: 10px 18px; border-radius: 9px;
    }

    .sheet {
        font-family:var(--brand-font);
        max-width: 820px; margin: 0 auto 3rem;
        background: #fff; border-radius: 6px;
        box-shadow: 0 20px 50px -20px rgba(10,25,47,0.25);
        padding: 3rem 3.2rem;
    }

    .doc-head {
        display: flex; justify-content: space-between; gap: 2rem;
        padding-bottom: 1.6rem; margin-bottom: 1.6rem;
        border-bottom: 3px solid var(--brand-primary);
    }
    .dh-org { display: flex; gap: 14px; align-items: flex-start; }
    .dh-mark {
        width: 46px; height: 46px; border-radius: 10px; flex-shrink: 0;
        color: var(--brand-on-primary); background:var(--brand-primary); display: flex; align-items: center; justify-content: center;
        font-size: 0.95rem; font-weight: 800;
    }
    .dh-logo { height: var(--brand-logo-height); max-height:60px; max-width: 220px; width: auto; object-fit: contain; display: block; }
    .dh-org h1 { font-size: 1.2rem; font-weight: 800; margin: 0 0 2px; letter-spacing: -0.3px; }
    .dh-org p { font-size: 0.72rem; color: var(--muted); margin: 1px 0; }
    .dh-doc { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
    .dh-label { font-size: 0.62rem; font-weight: 800; letter-spacing: 2px; color: var(--muted); }
    .dh-folio { font-size: 1.5rem; color:var(--print-ink); }
    .dh-date { font-size: 0.72rem; color: var(--muted); }

    .doc-meta {
        display: flex; gap: 3rem; flex-wrap: wrap;
        margin-bottom: 1.8rem;
    }
    .dm-label { display: block; font-size: 0.6rem; font-weight: 800; letter-spacing: 1.6px; color: var(--muted); margin-bottom: 3px; }
    .doc-meta b { font-size: 0.88rem; }

    .doc-items { width: 100%; border-collapse: collapse; margin-bottom: 1.4rem; }
    .doc-items th {
        text-align: left; font-size: 0.62rem; font-weight: 800; letter-spacing: 1.2px;
        text-transform: uppercase; color: var(--muted);
        padding: 0 10px 8px;
    }
    .doc-items thead tr { border-bottom: 2px solid var(--brand-primary); }
    .doc-items td {
        padding: 10px; font-size: 0.85rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
    }
    .doc-items td small { display: block; font-size: 0.68rem; color: var(--muted); }
    .num { text-align: right; white-space: nowrap; }
    .strike { display: block; font-size: 0.7rem; color: #99a2af; }
    .strike i {
        font-style: normal; font-weight: 700; color: #059669;
        margin-left: 5px;
    }

    .doc-totals { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; margin-bottom: 2rem; }
    .doc-totals > div { display: flex; justify-content: space-between; gap: 4rem; min-width: 260px; font-size: 0.85rem; color: var(--muted); }
    .doc-totals .grand {
        border-top: 2px solid var(--brand-primary); padding-top: 9px; margin-top: 4px;
        font-weight: 700; color: var(--ink);
    }
    .doc-totals .grand .editorial { font-size: 1.35rem; }

    .doc-notes { margin-bottom: 1.6rem; }
    .doc-notes p, .doc-notes ul { font-size: 0.8rem; color: var(--ink); margin: 4px 0 0; line-height: 1.55; }
    .doc-notes ul { padding-left: 1.1rem; }
    .doc-notes li { margin-bottom: 2px; }

    .doc-foot { border-top: 1px solid var(--line); padding-top: 1.2rem; }
    .df-msg { font-size: 0.8rem; color: var(--ink); margin: 0 0 6px; }
    .df-meta { font-size: 0.66rem; color: var(--muted); margin: 0; }

    /* ════════ PLANTILLAS ════════ */
    /* MINIMAL — líneas finas, sin bloques de color (acento solo en el total) */
    .sheet[data-template="minimal"] .doc-head { border-bottom-width: 1px; padding-bottom: 1.3rem; }
    .sheet[data-template="minimal"] .dh-org h1 { font-weight: 700; }
    .sheet[data-template="minimal"] .doc-items thead tr { border-bottom-width: 1px; border-color:var(--line); }

    /* DETALLADO — encabezado en banda con el color de marca + filas cebra */
    .sheet[data-template="detallado"] .doc-head {
        background:var(--brand-primary); border: none; border-radius: var(--brand-button-radius);
        padding: 1.6rem 1.8rem; margin-bottom: 1.8rem;
    }
    .sheet[data-template="detallado"] .doc-head h1 { color: var(--brand-on-primary); }
    .sheet[data-template="detallado"] .dh-org p { color:var(--brand-on-primary); }
    .sheet[data-template="detallado"] .dh-label { color:var(--brand-on-primary); }
    .sheet[data-template="detallado"] .dh-date { color:var(--brand-on-primary); }
    .sheet[data-template="detallado"] .doc-items tbody tr:nth-child(even) td { background: color-mix(in srgb,var(--brand-secondary) 8%,white); }
    .sheet[data-template="detallado"] .doc-items td:first-child { padding-left: 12px; }
    .sheet[data-template="detallado"] .doc-items th:first-child { padding-left: 12px; }

    @media screen and (max-width: 700px) {
        .toolbar { position: sticky; top: 0; z-index: 5; display: grid; grid-template-columns: 1fr auto; gap: .4rem .75rem; padding: max(.65rem, env(safe-area-inset-top)) max(.75rem, env(safe-area-inset-right)) .65rem max(.75rem, env(safe-area-inset-left)); background: rgba(238,240,243,.96); backdrop-filter: blur(16px); }
        .tb-back, .tb-print { min-height: 44px; display: inline-flex; align-items: center; }
        .tb-print { justify-content: center; }
        .tb-hint { grid-column: 1 / -1; grid-row: 2; text-align: left; }
        .sheet { margin: .5rem .5rem 2rem; padding: 1.4rem 1rem; border-radius: 14px; overflow-x: auto; }
        .doc-head { flex-direction: column; gap: 1.25rem; }
        .dh-org { min-width: 0; }
        .dh-org > div { min-width: 0; }
        .dh-org h1, .dh-org p { overflow-wrap: anywhere; }
        .dh-logo { max-width: min(180px, 60vw); }
        .dh-doc { align-items: flex-start; }
        .doc-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
        .doc-items { min-width: 640px; }
        .doc-totals { align-items: stretch; }
        .doc-totals > div { width: 100%; min-width: 0; gap: 1rem; }
        .sheet[data-template="detallado"] .doc-head { padding: 1.2rem; }
    }

    .sheet { --print-ink:#111827; }
    .dh-logo-dark { display:none; }
    .sheet[data-template="detallado"] .dh-logo-main { display:none; }
    .sheet[data-template="detallado"] .dh-logo-dark { display:flex; }
    .sheet[data-template="detallado"] .dh-folio { color:var(--brand-on-primary); }
    .sheet .doc-head { margin-bottom:var(--brand-gap); }
    .sheet[data-template="minimal"] .doc-head { border-color:var(--line); }
    .sheet[data-density="compact"] .doc-items td { padding-block:6px; }
    .doc-items tr { break-inside:avoid; }
    .doc-notes, .doc-totals { break-inside:avoid; }
    @media print {
        html, body { background: #fff; }
        /* Respeta los colores de marca (banda, acentos) al imprimir/guardar PDF */
        * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .toolbar { display: none; }
        .sheet {
            max-width: none; margin: 0; padding: 0.4cm 0;
            box-shadow: none; border-radius: 0;
        }
        @page { margin: 1.4cm 1.6cm; }
    }
</style>

<script>
    import { resolveBrandProfile, brandVariables } from '../../lib/brand-profile';
    window.addEventListener('message', event => {
        if (event.source !== parent || parent === window || event.origin !== location.origin || !['cord:pdf-preview','cord:brand-preview'].includes(event.data?.type)) return;
        const sheet = document.querySelector<HTMLElement>('.sheet')!;
        const d = event.data;
        if(d.type==='cord:brand-preview'){
            const p=resolveBrandProfile(d.profile);
            for(const [key,value] of Object.entries(brandVariables(p,d.primary,d.secondary)))sheet.style.setProperty(key,value);
            sheet.dataset.density=p.density;
            for(const kind of ['main','dark']){
                const url=kind==='dark'?(p.logoDark||d.logo):d.logo;
                const safe=typeof url==='string'&&/^(https?:\/\/|data:image\/(png|jpeg|webp|svg\+xml);base64,)/.test(url);
                const img=sheet.querySelector<HTMLImageElement>(`[data-print-logo="${kind}"]`)!;
                if(safe)img.src=url;else img.removeAttribute('src');img.hidden=!safe;
                sheet.querySelector<HTMLElement>(`[data-print-initial="${kind}"]`)!.hidden=safe;
            }
            return;
        }
        sheet.dataset.template = ['minimal','clasico','detallado'].includes(d.template) ? d.template : 'clasico';
        for (const node of sheet.querySelectorAll<HTMLElement>('.strike')) node.hidden = !d.list;
        const msg = sheet.querySelector<HTMLElement>('#printMessage')!;
        msg.textContent = String(d.message || ''); msg.hidden = !d.message;
        const section = sheet.querySelector<HTMLElement>('#printConditions');
        if (section) {
            const list = section.querySelector('ul')!; list.replaceChildren();
            for (const line of String(d.conditions || '').split('\n').filter(Boolean)) { const li = document.createElement('li'); li.textContent=line; list.append(li); }
            section.hidden = !list.children.length;
        }
    });
    if (parent !== window) parent.postMessage({type:'cord:pdf-preview-ready'},location.origin);
</script>
