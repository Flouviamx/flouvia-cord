---
import Layout from '../../layouts/Layout.astro';
import Nav from '../landing/Nav.astro';
import Footer from '../landing/Footer.astro';
import PageAnims from '../landing/PageAnims.astro';
import FaqAccordion from '../landing/FaqAccordion.astro';
import IntegrationAppMockup from './IntegrationAppMockup.astro';
import IntegrationCard from './IntegrationCard.astro';
import { CATEGORY_LABEL, INTEGRATION_PAGES, type IntegrationLanding } from '../../lib/integraciones-landing';
import { FEATURES } from '../../lib/producto';
import { FEATURES_EN } from '../../lib/producto.en';
import { INTEGRATION_STORY } from '../../lib/integraciones-historia';
import { SITE, SOFTWARE_ID } from '../../lib/seo/entities';

interface Props {
    page: IntegrationLanding;
    isEn?: boolean;
}

const { page, isEn = false } = Astro.props;
const c = isEn ? page.en : page.es;
const lang = isEn ? 'en' : 'es';
const base = isEn ? `${SITE}/en` : SITE;
const pre = isEn ? '/en' : '';
const pageUrl = `${base}/integraciones/${page.slug}`;
const hubLabel = isEn ? 'Integrations' : 'Integraciones';
const category = CATEGORY_LABEL[page.categoria][lang];
const producto = (isEn ? FEATURES_EN : FEATURES).find((f) => f.slug === page.producto);
const related = page.related
    .map((slug) => INTEGRATION_PAGES.find((p) => p.slug === slug))
    .filter(Boolean) as IntegrationLanding[];
const story = INTEGRATION_STORY[page.slug];
const datos = (isEn ? story.en : story.es).datos;
const [firstBlock, ...restBlocks] = c.blocks;
const brandVars = `--ig-from:${story.brand.from};--ig-to:${story.brand.to};--ig-accent:${story.brand.accent}`;
const arrow = 'M5 12h14M13 6l6 6-6 6';

const schema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebPage',
            '@id': `${pageUrl}#webpage`,
            url: pageUrl,
            name: c.metaTitle,
            description: c.metaDescription,
            inLanguage: lang,
            isPartOf: { '@id': `${SITE}/#website` },
            about: [
                { '@id': SOFTWARE_ID },
                { '@type': 'SoftwareApplication', name: page.nombre, url: `https://${page.dominio}` },
            ],
        },
        {
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Cord', item: `${base}/` },
                { '@type': 'ListItem', position: 2, name: hubLabel, item: `${base}/integraciones` },
                { '@type': 'ListItem', position: 3, name: page.nombre, item: pageUrl },
            ],
        },
        {
            '@type': 'HowTo',
            name: isEn ? `How to connect ${page.nombre} with Cord` : `Cómo conectar ${page.nombre} con Cord`,
            description: c.sub,
            step: c.pasos.map((step, i) => ({ '@type': 'HowToStep', position: i + 1, name: step.name, text: step.text })),
        },
        {
            '@type': 'FAQPage',
            mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
        },
    ],
};
---

<Layout title={c.metaTitle} description={c.metaDescription} imageAlt={`Cord + ${page.nombre}`}>
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <Nav />
    <main class="ig" style={brandVars}>
        <div class="ig-wrap">
            <div class="ig-crumbbar reveal">
                <nav class="ig-crumbs" aria-label={isEn ? 'Breadcrumb' : 'Ruta'}>
                    <a href={`${pre}/integraciones`}>{hubLabel}</a>
                    <span aria-hidden="true">/</span>
                    <span>{page.nombre}</span>
                </nav>
                <div class="ig-jump">
                    <a href="#como-conectar">{isEn ? 'How to connect' : 'Cómo conectar'}</a>
                    <a href={`#faq-${page.slug}`}>{isEn ? 'Questions' : 'Preguntas'}</a>
                    <a href={`${pre}/integraciones`}>{isEn ? 'All integrations' : 'Todas las integraciones'}</a>
                </div>
            </div>

            <section class="ig-hero">
                <div class="ig-hero-text">
                    <h1 class="ig-title masked-title">{c.titulo}</h1>
                    <p class="ig-sub reveal">{c.sub}</p>
                    <div class="ig-actions reveal">
                        <a href="/sign-up" class="ig-btn-primary">
                            <span>{isEn ? 'Start for free' : 'Empezar gratis'}</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={arrow}/></svg>
                        </a>
                        {c.guias[0] && <a href={c.guias[0].href} class="ig-btn-ghost">{isEn ? 'Read the guide' : 'Ver la guía'}</a>}
                    </div>
                </div>

                <aside class="ig-facts reveal">
                    <div class="ig-facts-head">
                        <span class="ig-facts-logo"><img src={page.logo} alt="" width="46" height="46" /></span>
                        <b>{page.nombre}</b>
                    </div>
                    <div class="ig-facts-sec">
                        <p class="ig-facts-label">{isEn ? 'What it connects' : 'Qué conecta'}</p>
                        <ul>{c.flujo.map((f) => <li>{f.cord}</li>)}</ul>
                    </div>
                    <div class="ig-facts-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="2" fill="currentColor" fill-opacity="0.13"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><rect x="13" y="13" width="7" height="7" rx="2" fill="currentColor" fill-opacity="0.13"/></svg>
                        <span>{category}</span>
                    </div>
                    <div class="ig-facts-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.13"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
                        <span>{c.plan}</span>
                    </div>
                </aside>
            </section>

            <section class="ig-show reveal-mockup" aria-label={isEn ? `Cord in ${page.nombre}` : `Cord en ${page.nombre}`}>
                <div class="ig-show-art" aria-hidden="true"></div>
                <div class="ig-show-stage">
                    <IntegrationAppMockup slug={page.slug} logo={page.logo} en={isEn} />
                </div>
            </section>

            <div class="ig-story">
                <aside class="ig-rail">
                    <ul class="ig-stats">
                        {datos.map((d) => (
                            <li class="reveal">
                                <b>{d.valor}</b>
                                <span>{d.texto}</span>
                            </li>
                        ))}
                    </ul>
                    <div class="ig-rail-cta reveal">
                        <p>{isEn ? 'Ready to connect it?' : '¿Todo listo para conectarla?'}</p>
                        <a href="/sign-up" class="ig-btn-primary ig-btn-sm">
                            <span>{isEn ? 'Start for free' : 'Empezar gratis'}</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={arrow}/></svg>
                        </a>
                    </div>
                </aside>

                <div class="ig-body">
                    {firstBlock && (
                        <article class="ig-chapter reveal">
                            <p class="ig-eyebrow">{firstBlock.eyebrow}</p>
                            <h2>{firstBlock.titulo}</h2>
                            <p>{firstBlock.copy}</p>
                            <ul class="ig-bullets">
                                {firstBlock.bullets.map((b) => <li>{b}</li>)}
                            </ul>
                        </article>
                    )}

                    <figure class="ig-flow reveal">
                        <div class="ig-flow-head">
                            <span class="ig-flow-pair" aria-hidden="true">
                                <img src="/favicon-192x192.png" alt="" width="30" height="30" />
                                <i></i>
                                <img src={page.logo} alt="" width="30" height="30" />
                            </span>
                            <figcaption>{c.flujoTitulo}</figcaption>
                        </div>
                        <div class="ig-flow-table">
                            <div class="ig-flow-th">
                                <span>Cord</span>
                                <span>{page.nombre}</span>
                            </div>
                            {c.flujo.map((row) => (
                                <div class="ig-flow-row">
                                    <span class="ig-flow-cord">{row.cord}</span>
                                    <span class="ig-flow-app"><b>{row.app}</b><em>{row.dir}</em></span>
                                </div>
                            ))}
                        </div>
                    </figure>

                    {restBlocks.map((b) => (
                        <article class="ig-chapter reveal">
                            <p class="ig-eyebrow">{b.eyebrow}</p>
                            <h2>{b.titulo}</h2>
                            <p>{b.copy}</p>
                            <ul class="ig-bullets">
                                {b.bullets.map((bullet) => <li>{bullet}</li>)}
                            </ul>
                        </article>
                    ))}

                    <section class="ig-chapter" id="como-conectar">
                        <p class="ig-eyebrow reveal">{isEn ? 'SETUP' : 'CONFIGURACIÓN'}</p>
                        <h2 class="reveal">{isEn ? `How to connect ${page.nombre}` : `Cómo conectar ${page.nombre}`}</h2>
                        <ol class="ig-steps">
                            {c.pasos.map((step, i) => (
                                <li class="reveal">
                                    <span class="ig-step-n editorial">{i + 1}</span>
                                    <div>
                                        <h3>{step.name}</h3>
                                        <p>{step.text}</p>
                                    </div>
                                </li>
                            ))}
                        </ol>
                    </section>

                    <section class="ig-chapter ig-limits reveal">
                        <p class="ig-eyebrow">{isEn ? 'NO SURPRISES' : 'SIN SORPRESAS'}</p>
                        <h2>{isEn ? 'What it does not do yet' : 'Lo que todavía no hace'}</h2>
                        <p>{isEn ? 'We would rather you read it here than find it out halfway through.' : 'Preferimos que lo leas aquí a que lo descubras a medio camino.'}</p>
                        <ul>
                            {c.limites.map((l) => <li>{l}</li>)}
                        </ul>
                    </section>
                </div>
            </div>
        </div>

        <FaqAccordion faqs={c.faqs} eyebrow={isEn ? 'QUESTIONS' : 'PREGUNTAS'} title={isEn ? `${page.nombre} and Cord` : `${page.nombre} y Cord`} id={`faq-${page.slug}`} />

        <section class="ig-more">
            <div class="ig-wrap">
                <div class="ig-more-head">
                    <h2 class="reveal">{isEn ? 'Explore more integrations' : 'Conoce más integraciones'}</h2>
                    <a href={`${pre}/integraciones`} class="ig-all reveal">
                        {isEn ? 'See every integration' : 'Ver todas las integraciones'}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                    </a>
                </div>
                <ul class="ig-related">
                    {related.map((r) => (
                        <li class="reveal"><IntegrationCard page={r} href={`${pre}/integraciones/${r.slug}`} en={isEn} /></li>
                    ))}
                </ul>
                <div class="ig-guides reveal">
                    <p class="ig-eyebrow">{isEn ? 'GUIDES' : 'GUÍAS'}</p>
                    <ul>
                        {c.guias.map((g) => (
                            <li><a href={g.href}>{g.label}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/></svg></a></li>
                        ))}
                        {producto && (
                            <li><a href={`${pre}/producto/${producto.slug}`}>{producto.nav}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}/></svg></a></li>
                        )}
                    </ul>
                </div>
            </div>
        </section>
    </main>
    <Footer ctaTitle={c.cta.titulo} ctaSub={c.cta.sub} />
    <PageAnims />
</Layout>

<style>
    .ig { background: var(--color-bg-soft); }
    .ig-wrap { max-width: 1180px; margin: 0 auto; padding: 0 5%; box-sizing: content-box; }

    .ig-crumbbar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 8.2rem 0 1.4rem; border-bottom: 1px dashed rgba(10,25,47,0.12); }
    .ig-crumbs { display: flex; align-items: center; gap: 10px; font-size: 1.05rem; font-weight: 600; color: #0a192f; }
    .ig-crumbs a { color: var(--ig-accent); text-decoration: none; filter: saturate(0.85) brightness(0.85); }
    .ig-crumbs a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .ig-crumbs span[aria-hidden] { color: #c0c5cd; font-weight: 400; }
    .ig-jump { display: flex; gap: 1.8rem; }
    .ig-jump a { font-size: 0.92rem; font-weight: 600; color: var(--color-blue-deep); text-decoration: none; opacity: 0.75; transition: opacity 0.2s ease; }
    .ig-jump a:hover { opacity: 1; }

    .ig-hero { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 5rem; align-items: start; padding: 4.5rem 0 4rem; }
    .ig-title { font-size: clamp(2.5rem, 5vw, 4.6rem) !important; line-height: 1.05 !important; letter-spacing: -0.045em !important; color: #0a192f; margin: 0 0 2rem !important; text-align: left !important; text-wrap: balance; }
    .ig-sub { font-size: 1.18rem; line-height: 1.65; color: #3b4452; max-width: 640px; margin: 0 0 2.2rem; }
    .ig-actions { display: flex; gap: 0.9rem; align-items: center; flex-wrap: wrap; }
    .ig-btn-primary {
        display: inline-flex; align-items: center; gap: 10px; background: var(--color-blue-deep); color: #fff;
        text-decoration: none; font-size: 0.98rem; font-weight: 600; padding: 14px 28px; border-radius: 999px; min-height: 44px; box-sizing: border-box;
        box-shadow: 0 18px 44px -16px rgba(10,25,47,0.55);
        transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-spring);
    }
    .ig-btn-primary svg { width: 15px; height: 15px; transition: transform 0.5s var(--ease-spring); }
    .ig-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 24px 50px -16px rgba(10,25,47,0.6); }
    .ig-btn-primary:hover svg { transform: translateX(3px); }
    .ig-btn-primary:active { transform: scale(0.98); }
    .ig-btn-sm { font-size: 0.9rem; padding: 11px 22px; }
    .ig-btn-ghost {
        display: inline-flex; align-items: center; color: var(--color-blue-deep); text-decoration: none; font-size: 0.95rem; font-weight: 600;
        padding: 13px 24px; border-radius: 999px; background: #f0f1f4; min-height: 44px; box-sizing: border-box; transition: background 0.3s ease, transform 0.3s var(--ease-spring);
    }
    .ig-btn-ghost:hover { background: #e7e9ee; }
    .ig-btn-ghost:active { transform: scale(0.98); }
    .ig a:focus-visible { outline: 2px solid var(--color-blue-deep); outline-offset: 3px; }

    .ig-facts { background: #fff; border-radius: 22px; border: 1px solid rgba(10,25,47,0.07); box-shadow: 0 2px 4px rgba(10,25,47,0.03), 0 24px 48px -28px rgba(10,25,47,0.2); overflow: hidden; }
    .ig-facts-head { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 1.8rem 1.4rem; background: #f7f8fa; border-bottom: 1px solid rgba(10,25,47,0.07); }
    .ig-facts-logo { display: inline-flex; flex-shrink: 0; }
    .ig-facts-logo img { width: 46px; height: 46px; border-radius: 24%; object-fit: contain; }
    .ig-facts-head b { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.04em; color: #0a192f; }
    .ig-facts-sec { padding: 1.4rem 1.5rem; border-bottom: 1px solid rgba(10,25,47,0.07); }
    .ig-facts-label { font-size: 0.86rem; color: #8a94a3; margin: 0 0 0.9rem; }
    .ig-facts-sec ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; }
    .ig-facts-sec li { font-size: 0.95rem; color: #0a192f; line-height: 1.35; }
    .ig-facts-row { display: flex; align-items: flex-start; gap: 12px; padding: 1.1rem 1.5rem; border-bottom: 1px solid rgba(10,25,47,0.07); font-size: 0.9rem; line-height: 1.45; color: #0a192f; }
    .ig-facts-row:last-child { border-bottom: none; }
    .ig-facts-row svg { width: 20px; height: 20px; flex-shrink: 0; color: #8a94a3; }

    .ig-show { position: relative; border-radius: 30px; overflow: hidden; isolation: isolate; padding: clamp(2rem, 5vw, 4.5rem) clamp(1.2rem, 6vw, 5.5rem); }
    .ig-show-art {
        position: absolute; inset: 0; z-index: -1;
        background:
            radial-gradient(90% 70% at 12% 0%, color-mix(in srgb, var(--ig-from) 85%, #fff) 0%, transparent 60%),
            radial-gradient(80% 80% at 100% 100%, color-mix(in srgb, var(--ig-to) 75%, #000) 0%, transparent 70%),
            linear-gradient(160deg, var(--ig-from) 0%, var(--ig-to) 100%);
    }
    .ig-show-art::after {
        content: ''; position: absolute; inset: 0; opacity: 0.45;
        background-image: radial-gradient(rgba(255,255,255,0.14) 1px, transparent 1px); background-size: 18px 18px;
        mask-image: linear-gradient(180deg, #000, transparent 75%); -webkit-mask-image: linear-gradient(180deg, #000, transparent 75%);
    }
    .ig-show-stage { max-width: 880px; margin: 0 auto; }

    .ig-story { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 5.5rem; padding: 6rem 0 5rem; }
    .ig-rail { position: sticky; top: 7rem; align-self: start; display: flex; flex-direction: column; gap: 2.6rem; }
    .ig-stats { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2.2rem; }
    .ig-stats li { position: relative; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .ig-stats li::before { content: ''; position: absolute; left: 0; top: 0.2rem; height: 1.9rem; width: 2px; border-radius: 2px; background: var(--ig-accent); }
    .ig-stats b { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.04em; line-height: 1.1; color: #0a192f; font-variant-numeric: tabular-nums; }
    .ig-stats span { font-size: 0.95rem; line-height: 1.55; color: #525a66; }
    .ig-rail-cta { padding-left: 1.2rem; display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
    .ig-rail-cta p { margin: 0; font-size: 1.08rem; font-weight: 700; letter-spacing: -0.02em; color: #0a192f; }

    .ig-body { display: flex; flex-direction: column; gap: 4.5rem; min-width: 0; }
    .ig-eyebrow { font-size: 0.66rem; font-weight: 800; letter-spacing: 2.2px; text-transform: uppercase; color: #8a8f98; margin: 0 0 1rem; }
    .ig-chapter h2 { font-size: clamp(1.6rem, 2.4vw, 2.1rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.15; color: #0a192f; margin: 0 0 1.3rem; text-wrap: balance; }
    .ig-chapter > p:not(.ig-eyebrow) { font-size: 1.12rem; line-height: 1.75; color: #3b4452; margin: 0; max-width: 720px; }
    .ig-bullets { list-style: none; margin: 1.6rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.8rem; }
    .ig-bullets li { position: relative; padding-left: 1.6rem; font-size: 1rem; line-height: 1.55; color: #1d2530; }
    .ig-bullets li::before { content: ''; position: absolute; left: 2px; top: 0.55em; width: 7px; height: 7px; border-radius: 50%; background: var(--ig-accent); }

    .ig-flow { margin: 0; position: relative; border-radius: 26px; padding: 2.2rem; overflow: hidden; isolation: isolate; box-shadow: 0 30px 60px -30px rgba(10,25,47,0.45); }
    .ig-flow::before {
        content: ''; position: absolute; inset: 0; z-index: -1;
        background: radial-gradient(80% 90% at 100% 0%, color-mix(in srgb, var(--ig-from) 70%, #fff) 0%, transparent 60%), linear-gradient(150deg, var(--ig-from), var(--ig-to));
    }
    .ig-flow-head { display: flex; align-items: center; gap: 14px; margin-bottom: 1.4rem; }
    .ig-flow-pair { display: inline-flex; align-items: center; gap: 6px; padding: 6px; border-radius: 14px; background: rgba(255,255,255,0.16); }
    .ig-flow-pair img { width: 30px; height: 30px; border-radius: 24%; object-fit: contain; }
    .ig-flow-pair i { width: 16px; height: 2px; background: repeating-linear-gradient(90deg, rgba(255,255,255,0.8) 0 3px, transparent 3px 6px); }
    .ig-flow figcaption { font-size: 1.2rem; font-weight: 650; letter-spacing: -0.02em; color: #fff; }
    .ig-flow-table { background: #fff; border-radius: 16px; overflow: hidden; }
    .ig-flow-th, .ig-flow-row { display: grid; grid-template-columns: 0.9fr 1.3fr; gap: 1.2rem; padding: 0.95rem 1.3rem; }
    .ig-flow-th { background: #f7f8fa; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: #8a94a3; }
    .ig-flow-row { border-top: 1px solid rgba(10,25,47,0.06); }
    .ig-flow-cord { font-size: 0.9rem; font-weight: 600; color: #0a192f; }
    .ig-flow-app { display: flex; flex-direction: column; gap: 3px; }
    .ig-flow-app b { font-size: 0.9rem; font-weight: 600; color: #0a192f; }
    .ig-flow-app em { font-style: normal; font-size: 0.8rem; color: #64748b; }

    .ig-steps { list-style: none; margin: 1.8rem 0 0; padding: 0; display: flex; flex-direction: column; }
    .ig-steps li { display: grid; grid-template-columns: 40px 1fr; gap: 1.1rem; padding: 1.4rem 0; border-top: 1px solid rgba(10,25,47,0.08); }
    .ig-steps li:last-child { border-bottom: 1px solid rgba(10,25,47,0.08); }
    .ig-step-n { width: 32px; height: 32px; border-radius: 50%; background: var(--color-blue-deep); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.86rem; }
    .ig-steps h3 { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; color: #0a192f; margin: 0.25rem 0 0.4rem; }
    .ig-steps p { font-size: 0.98rem; line-height: 1.65; color: #3b4452; margin: 0; }

    .ig-limits ul { list-style: none; margin: 1.6rem 0 0; padding: 0; }
    .ig-limits li { position: relative; padding: 1rem 0 1rem 1.6rem; border-top: 1px solid rgba(10,25,47,0.08); font-size: 0.98rem; line-height: 1.6; color: #1d2530; }
    .ig-limits li:last-child { border-bottom: 1px solid rgba(10,25,47,0.08); }
