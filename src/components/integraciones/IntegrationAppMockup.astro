                                            <i class={`iam-av ${c.oc}`}>{c.owner}</i>
                                        </span>
                                    </article>
                                ))}
                            </div>
                            <footer><span>{L('Importe total', 'Total amount')}</span><b class="editorial">{col.total}</b></footer>
