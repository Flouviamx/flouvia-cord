<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const initIam = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll<HTMLElement>('[data-iam]').forEach((root) => {
            const layers = root.querySelectorAll<HTMLElement>('.iam-layer');
            if (!layers.length) return;
            gsap.set(layers, { opacity: 0, y: 28 });
            ScrollTrigger.create({
                trigger: root, start: 'top 80%', once: true,
                onEnter: () => gsap.to(layers, { opacity: 1, y: 0, duration: 0.95, delay: 0.5, ease: 'power3.out', clearProps: 'opacity,transform' }),
            });
        });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initIam);
    else initIam();
</script>

