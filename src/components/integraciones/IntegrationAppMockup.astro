<div class={`iam iam-${slug}`} data-iam>
    {slug === 'hubspot' && (
        <div class="iam-stage iam-hs">
            <div class="iam-win iam-hs-win">
                <div class="iam-hs-nav">
                    <img class="iam-hs-logo" src={logo} alt="" width="20" height="20" loading="lazy" />
                    <span class="iam-hs-search"><svg class="iam-i" viewBox="0 0 24 24" set:html={I.search} />{L('Buscar en HubSpot', 'Search HubSpot')}</span>
                    <span class="iam-hs-navr">
                        <svg class="iam-i" viewBox="0 0 24 24" set:html={I.apps} />
                        <svg class="iam-i" viewBox="0 0 24 24" set:html={I.help} />
                        <svg class="iam-i" viewBox="0 0 24 24" set:html={I.gear} />
                        <svg class="iam-i" viewBox="0 0 24 24" set:html={I.bell} />
                        <span class="iam-hs-acct"><i class="iam-av c1">AR</i>Materiales del Valle<svg class="iam-i" viewBox="0 0 24 24" set:html={I.down} /></span>
                    </span>
                </div>
                <div class="iam-hs-head">
                    <div class="iam-hs-title">
                        <b>{L('Negocios', 'Deals')}</b>
                        <span class="iam-hs-pipe">{L('Pipeline:', 'Pipeline:')} <strong>{L('Ventas con Cord', 'Sales with Cord')}</strong><svg class="iam-i" viewBox="0 0 24 24" set:html={I.down} /></span>
                    </div>
                    <div class="iam-hs-actions">
                        <span class="iam-hs-btn">{L('Acciones', 'Actions')}<svg class="iam-i" viewBox="0 0 24 24" set:html={I.down} /></span>
