---
// Layout base de Cord — hereda el sistema de diseño Flouvia.
// Producto global (signup abierto a cualquier país); CFDI/SAT es una función
// adicional para negocios en México, no un gate de quién puede usar Cord.

interface Props {
    title: string;
    description?: string;
    image?: string;
    noindex?: boolean;
    ogType?: string;
}

import Analytics from '@vercel/analytics/astro';
import { getLangFromUrl, altLangUrls } from '../i18n/utils';
import PostHog from '../components/posthog.astro';

const {
    title,
    description = 'Cord — la plataforma que transforma propuestas y acuerdos en transacciones pagadas al instante. Centraliza en un solo link interactivo la negociación, firmas legales, inteligencia de margen y cobros automatizados. Para cualquier negocio, en cualquier país.',
    image = '/og-cord.png',
    noindex = false,
    ogType = 'website',
} = Astro.props;

const SITE      = Astro.site ?? new URL('https://cordhq.app');
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage   = new URL(image, SITE).href;

const lang = getLangFromUrl(Astro.url);
const { esUrl, enUrl } = altLangUrls(Astro.url);
const siteCanonicalEs = new URL(esUrl, SITE).href;
const siteCanonicalEn = new URL(enUrl, SITE).href;
const locale = lang === 'es' ? 'es_MX' : 'en_US';
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />

        <!-- Gate de animación (mismo patrón que flouvia-web): marca <html> ANTES del
             primer paint para que los elementos animados partan ocultos sin flash.
             Sin JS o con reduced-motion, la clase nunca se añade y todo queda visible. -->
        <script is:inline>
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                document.documentElement.classList.add('js-anim');
            }
        </script>

        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={siteCanonicalEs} />
        <link rel="alternate" hreflang="en" href={siteCanonicalEn} />
        <link rel="alternate" hreflang="x-default" href={siteCanonicalEs} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <!-- Open Graph -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="Cord" />
        <meta property="og:locale" content={locale} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

        <!-- Favicons -->
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.webmanifest" />

        <!-- Theme color: navy en light, navy en dark (se adapta el icono vía SVG) -->
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a192f" />

        <!-- iOS / Safari -->
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="default" />
        <meta name="apple-mobile-web-app-title" content="Cord" />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

        <title>{title}</title>

        <!-- Datos estructurados / SEO por página (JSON-LD, etc.) -->
        <slot name="head" />

        <!-- PostHog Analytics -->
        <PostHog />

        <!-- Mixpanel Analytics -->
        <script is:inline define:vars={{ mpToken: import.meta.env.PUBLIC_MIXPANEL_TOKEN || '' }}>
            if (mpToken) {
                (function(f,b){if(!b.__SV){var e,g,i,h;window.mixpanel=b;b._i=[];b.init=function(e,f,c){function g(a,d){var b=d.split(".");2==b.length&&(a=a[b[0]],d=b[1]);a[d]=function(){a.push([d].concat(Array.prototype.slice.call(arguments,0)))}}var a=b;"undefined"!==typeof c?a=b[c]=[]:c="mixpanel";a.people=a.people||[];a.toString=function(a){var d="mixpanel";"mixpanel"!==c&&(d+="."+c);a||(d+=" (stub)");return d};a.people.toString=function(){return a.toString(1)+".people (stub)"};i="disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" ");for(h=0;h<i.length;h++)g(a,i[h]);b._i.push([e,f,c])};b.__SV=1.2;e=f.createElement("script");e.type="text/javascript";e.async=!0;e.src="https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";g=f.getElementsByTagName("script")[0];g.parentNode.insertBefore(e,g)}})(document,window.mixpanel||[]);
                mixpanel.init(mpToken, {
                    debug: location.hostname === 'localhost',
                    track_pageview: true,
                    persistence: 'localStorage',
                    record_sessions_percent: 100
                });
            }
        </script>
    </head>
    <body>
        <slot />
        <Analytics />
    </body>
</html>

<style is:global>
    /* ==========================================================
       TOKENS — sistema de diseño Flouvia, adaptado a Cord
       ========================================================== */
    :root {
        --color-bg: #ffffff;
        --color-bg-soft: #fcfcfc;
        --color-blue-deep: #0a192f;      /* navy principal */
        --color-text: #050505;
        --color-text-muted: #555556;
        --color-border: rgba(0, 0, 0, 0.08);

        /* Estados de cotización (mismos colores que el health score del portal) */
        --color-ok: #10b981;             /* aprobada / pagada */
        --color-warn: #f59e0b;           /* pendiente / por vencer */
        --color-danger: #ef4444;         /* vencida / rechazada */

        --font-sans: 'Inter', system-ui, sans-serif;

        --ease-ios: cubic-bezier(0.25, 1, 0.5, 1);
        --ease-spring: cubic-bezier(0.22, 1, 0.36, 1);
        --ease-smooth: cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
        overflow-x: clip; /* clip: recorta sin crear scroll container → no rompe sticky */
    }

    html, body {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        position: relative;
        font-family: var(--font-sans);
        color: var(--color-text);
        background-color: var(--color-bg);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        -webkit-tap-highlight-color: transparent;
    }

    body {
        overflow-x: clip; /* idem — asegura que body tampoco genere scrollbar horizontal */
    }

    ::selection {
        background: #0a192f;
        color: #ffffff;
    }

    /* Regla de marca (jun 2026): montos y números en Inter seminegrita con
       números tabulares y tracking apretado — la firma "fintech" del producto.
       (Reemplaza a la antigua serif italic; la clase se mantiene por compatibilidad.) */
    .editorial {
        font-family: var(--font-sans);
        font-style: normal;
        font-weight: 600;
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
    }

    /* Unificar todos los títulos principales de páginas públicas (Hero style sobrio pero negrita).
       Estándar = el tamaño del hero del index (jul 2026, a petición de André: "quiero que
       todos los títulos estén igual" — antes el index era más chico a propósito; ahora su
       tamaño es EL estándar para toda la web pública). */
    h1.masked-title {
        font-size: clamp(2.1rem, 3.4vw, 3.6rem) !important;
        line-height: 1.1 !important;
        font-weight: 700 !important;
        letter-spacing: -0.035em !important;
        color: var(--color-blue-deep) !important;
        margin: 0 auto 3rem !important;
        max-width: 900px !important;
        text-wrap: balance !important;
        text-align: center !important;
    }
</style>
