---
import Layout from "./Layout.astro";

import type { MarkdownHeading } from "astro";
import TableOfContents from "../components/docs/TableOfContents.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocsBreadcrumbs from "../components/docs/DocsBreadcrumbs.astro";
import DocsPager from "../components/docs/DocsPager.astro";
import { DOCS_NAV, breadcrumbs, docHref, sectionFor } from "../lib/docs-nav";

export interface Props {
  headings?: MarkdownHeading[];
  title: string;
  /** Id de la página sin idioma (`pagos/condiciones`, `resumen` para la portada). Decide sección, activo, migas y paginador. */
  slug: string;
  lang?: "es" | "en";
  description?: string;
  lastUpdated?: string;
  reviewedBy?: string;
  appliesToMarkets?: string[];
  availablePlans?: string[];
  prerequisites?: string[];
  seoTitle?: string;
  alternates?: PublicAlternates;
}

import { cleanPathname, type PublicAlternates } from "../i18n/utils";
import { cordOrganization, DOCS_SITE, ORG_ID } from "../lib/seo/entities";

const {
  title,
  slug,
  lang = "es",
  description,
  headings = [],
  lastUpdated,
  reviewedBy,
  appliesToMarkets = [],
  availablePlans = [],
  prerequisites = [],
  seoTitle,
  alternates
} = Astro.props;
const pagePath = cleanPathname(Astro.url.pathname);
const esUrl = alternates?.es ?? '/docs';
const enUrl = alternates?.en ?? '/en/docs';

// Sección, activo, migas y paginador salen del slug y de src/lib/docs-nav.ts; el
// layout ya no adivina la sección leyendo Astro.url.
const docsRootHref = docHref('resumen', lang);
const currentSection = sectionFor(slug) ?? DOCS_NAV[0];
const isOverviewPage = slug === 'resumen' || slug.endsWith('/resumen');

// Docs vive en el subdominio docs.cordhq.app (rewrite en src/middleware.ts) — el
// breadcrumb/WebPage debe apuntar ahí, no al dominio apex (que 301-redirige a este
// mismo subdominio, lo que dejaba el canonical/JSON-LD apuntando a sí mismo a
// través de un redirect). Organization/WebSite SÍ se quedan en cordhq.app: son la
// entidad de marca única, no la ubicación de esta página en particular.
// El canonical público es estable incluso detrás de proxies que entregan la
// petición interna por HTTP. Usar Astro.url.origin podía publicar `http://` en
// previews o adaptadores que no preservaran correctamente X-Forwarded-Proto.
const pageOrigin = DOCS_SITE;

const marketNames: Record<string, { es: string; en: string }> = {
  MX: { es: 'México', en: 'Mexico' },
  US: { es: 'Estados Unidos', en: 'United States' },
  CA: { es: 'Canadá', en: 'Canada' },
  BR: { es: 'Brasil', en: 'Brazil' },
  ES: { es: 'España', en: 'Spain' },
  GB: { es: 'Reino Unido', en: 'United Kingdom' },
  DE: { es: 'Alemania', en: 'Germany' },
  FR: { es: 'Francia', en: 'France' },
  CO: { es: 'Colombia', en: 'Colombia' },
  AR: { es: 'Argentina', en: 'Argentina' },
  CL: { es: 'Chile', en: 'Chile' },
  PE: { es: 'Perú', en: 'Peru' }
};
const localizedMarkets = appliesToMarkets.map((code) => marketNames[code]?.[lang] || code);
const hasEditorialMetadata = Boolean(lastUpdated || reviewedBy || localizedMarkets.length || availablePlans.length || prerequisites.length);

const docsHome = lang === 'en' ? `${pageOrigin}/en/docs` : `${pageOrigin}/docs`;
const pageUrl = `${pageOrigin}${pagePath}`;
const isDocsHome = pageUrl === docsHome;
// Los grupos del sidebar no tienen página propia: en el JSON-LD solo entran los
// niveles con URL. El último es siempre esta página, con su título real.
const structuredCrumbs = [
  { name: "Cord Docs", item: docsHome },
  ...(isDocsHome ? [] : [
    ...breadcrumbs(slug, lang).slice(1, -1).filter((crumb) => crumb.href).map((crumb) => ({ name: crumb.label, item: `${pageOrigin}${crumb.href}` })),
    { name: title, item: pageUrl }
  ])
].filter((crumb, index, all) => all.findIndex((other) => other.item === crumb.item) === index);
const docsWebsiteId = `${pageOrigin}/#website`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    cordOrganization(),
    {
      "@type": "WebSite",
      "@id": docsWebsiteId,
      "url": `${pageOrigin}/`,
      "name": "Cord Docs",
      "alternateName": lang === "es" ? "Documentación de Cord" : "Cord Documentation",
      "publisher": { "@id": ORG_ID },
      "inLanguage": ["es", "en"]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        ...structuredCrumbs.map((crumb, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": crumb.name,
          "item": crumb.item
        }))
      ]
    },
    {
      "@type": "TechArticle",
      "headline": title,
      ...(description ? { "description": description } : {}),
      "url": pageUrl,
      "mainEntityOfPage": pageUrl,
      "inLanguage": lang,
      "isPartOf": { "@id": docsWebsiteId },
      "about": { "@id": "https://cordhq.app/#software" },
      "author": { "@id": ORG_ID },
      "publisher": { "@id": ORG_ID },
      ...(lastUpdated ? { "dateModified": lastUpdated } : {}),
      ...(localizedMarkets.length ? {
        "spatialCoverage": localizedMarkets.map((name) => ({ "@type": "Place", "name": name }))
      } : {}),
      ...(availablePlans.length ? {
        "audience": { "@type": "Audience", "audienceType": availablePlans.join(', ') }
      } : {}),
      ...(prerequisites.length ? { "dependencies": prerequisites.join('; ') } : {})
    }
  ]
};
import { iconInner } from '../lib/icons';
---

<Layout title={`${seoTitle ?? title} | Cord Docs`} description={description} ogType="article" canonicalOrigin={pageOrigin} alternates={alternates}>
  <style is:inline>
    :root { color-scheme: light; }
  </style>
  <!-- Set lang dynamically for JS scripts to read -->
  <script is:inline define:vars={{ lang }}>
    document.documentElement.lang = lang;
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="docs-layout">
    <a class="docs-skip-link" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>

    <!-- Header -->
    <header class="docs-header">
      <div class="header-top">
        <div class="header-left">
          <button type="button" id="mobile-menu-trigger" class="mobile-menu-btn" aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'} aria-controls="docs-sidebar" aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('menu')}></svg>
          </button>
          <a href={docsRootHref} class="logo">
            <img class="docs-logo-img" src="/imgs/logo-cord-navy.png" alt="Cord" width="62" height="24" />
            <span class="brand-docs">DOCS</span>
          </a>
        </div>

        <div class="header-center">
          <div class="search-container">
            <button type="button" class="search-input" id="search-trigger" aria-label={lang === 'es' ? 'Buscar en la documentación' : 'Search documentation'} aria-haspopup="dialog" aria-controls="search-modal" aria-keyshortcuts="/ Control+K Meta+K">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('search')}></svg>
              <span class="search-input-label">{lang === 'es' ? 'Buscar en la documentación' : 'Search docs'}</span>
              <kbd aria-hidden="true">/</kbd>
            </button>
          </div>
        </div>

        <div class="header-right">
          <div class="lang-toggle">
            <a href={esUrl} class={`lang-option ${lang === 'es' ? 'active' : ''}`} aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
            <a href={enUrl} class={`lang-option ${lang === 'en' ? 'active' : ''}`} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          </div>
        </div>
      </div>

      <nav class="header-bottom" aria-label={lang === 'es' ? 'Secciones de la documentación' : 'Documentation sections'}>
        <ul class="nav-links">
          {DOCS_NAV.map((section) => (
            <li class={section.id === currentSection.id ? 'active' : ''}><a href={docHref(section.home, lang)} aria-current={section.id === currentSection.id ? 'true' : undefined}>{section.tab[lang]}</a></li>
          ))}
        </ul>
        <div class="nav-tools">
          <div class="nav-dropdown-wrapper">
            <button type="button" class="nav-dropdown" id="docs-help-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="docs-help-menu">{lang === 'es' ? 'Ayuda' : 'Help'} <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('chevron-down')}></svg></button>
            <div class="dropdown-menu" id="docs-help-menu">
              <a href={lang === 'es' ? 'https://cordhq.app/soporte' : 'https://cordhq.app/en/support'}>{lang === 'es' ? 'Centro de soporte' : 'Support Center'}</a>
              <a href={lang === 'es' ? 'https://cordhq.app/contacto/ventas' : 'https://cordhq.app/en/contacto/ventas'}>{lang === 'es' ? 'Contactar a ventas' : 'Contact Sales'}</a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <div class="docs-body">
      <!-- Mobile Backdrop -->
      <div id="mobile-sidebar-backdrop" class="sidebar-backdrop hidden"></div>
      
      <!-- Sidebar -->
      <aside class="docs-sidebar" id="docs-sidebar">
        <div class="sidebar-mobile-header">
          <a href={docsRootHref} class="logo"><img class="docs-logo-img docs-logo-img--sm" src="/imgs/logo-cord-navy.png" alt="Cord" width="52" height="20" /><span class="brand-docs">DOCS</span></a>
          <button id="mobile-menu-close" class="mobile-menu-close" aria-label={lang === 'es' ? 'Cerrar menú' : 'Close menu'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('x')}></svg></button>
        </div>
        <DocsSidebar slug={slug} lang={lang} />
      </aside>

      <!-- Main Content -->
      <main class="docs-main" id="main" tabindex="-1">
        <div class="docs-content-area">
          <div class={`main-content-column ${isOverviewPage ? 'overview-layout' : ''}`}>
            <div class="content-container">
          <DocsBreadcrumbs slug={slug} lang={lang} />
          <button type="button" class="docs-copy-ai" id="docsCopyAi" data-done={lang === 'es' ? 'Copiado' : 'Copied'} data-failed={lang === 'es' ? 'No se pudo copiar' : 'Could not copy'} title={lang === 'es' ? 'Copia esta página en Markdown para pegarla en un asistente de IA' : 'Copy this page as Markdown to paste into an AI assistant'}>
            <svg class="docs-copy-ai-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('copy')}></svg>
            <svg class="docs-copy-ai-done" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('check')}></svg>
            <span class="docs-copy-ai-label">{lang === 'es' ? 'Copiar para IA' : 'Copy for AI'}</span>
          </button>
          <span class="docs-sr-only" id="docsCopyAiStatus" role="status" aria-live="polite"></span>
          <slot />

          {hasEditorialMetadata && (
            <aside class="doc-metadata" aria-label={lang === 'es' ? 'Datos de esta guía' : 'About this guide'}>
              <p class="doc-metadata-title">{lang === 'es' ? 'Datos de esta guía' : 'About this guide'}</p>
              <dl>
                {lastUpdated && (
                  <div>
                    <dt>{lang === 'es' ? 'Actualizada' : 'Updated'}</dt>
                    <dd><time datetime={lastUpdated}>{new Intl.DateTimeFormat(lang === 'es' ? 'es-MX' : 'en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${lastUpdated}T00:00:00Z`))}</time></dd>
                  </div>
                )}
                {reviewedBy && <div><dt>{lang === 'es' ? 'Revisada por' : 'Reviewed by'}</dt><dd>{reviewedBy}</dd></div>}
                {localizedMarkets.length > 0 && <div><dt>{lang === 'es' ? 'Mercados' : 'Markets'}</dt><dd>{localizedMarkets.join(', ')}</dd></div>}
                {availablePlans.length > 0 && <div><dt>{lang === 'es' ? 'Planes' : 'Plans'}</dt><dd>{availablePlans.join(', ')}</dd></div>}
                {prerequisites.length > 0 && <div><dt>{lang === 'es' ? 'Antes de empezar' : 'Before you begin'}</dt><dd>{prerequisites.join(' · ')}</dd></div>}
              </dl>
            </aside>
          )}

          <DocsPager slug={slug} lang={lang} />

          <div class="docs-footer">
            <div class="feedback-section" role="group" aria-labelledby="feedback-question">
              <span class="feedback-title" id="feedback-question">{lang === 'es' ? '¿Te ha sido útil la página?' : 'Was this page helpful?'}</span>
              <button class="feedback-btn" id="feedback-yes" aria-pressed="false"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('thumbs-up')}></svg> {lang === 'es' ? 'Sí' : 'Yes'}</button>
              <button class="feedback-btn" id="feedback-no" aria-pressed="false"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('thumbs-down')}></svg> {lang === 'es' ? 'No' : 'No'}</button>
              <span class="feedback-thanks" id="feedback-thanks" role="status" aria-live="polite" data-text={lang === 'es' ? 'Gracias por tus comentarios.' : 'Thanks for your feedback.'}></span>
            </div>
            
            <hr class="footer-divider" />
            
            <ul class="footer-links">
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('lifebuoy')}></svg>
                {lang === 'es' ? '¿Necesitas ayuda? ' : 'Need help? '}
                <a href={lang === 'es' ? 'https://cordhq.app/soporte' : 'https://cordhq.app/en/support'}>{lang === 'es' ? 'Consulta el Centro de soporte' : 'Visit the Support Center'}</a>
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('document')}></svg>
                {lang === 'es' ? 'Revisa qué está disponible y qué viene después en el ' : 'See what is available and what comes next on the '}
                <a href={lang === 'es' ? 'https://cordhq.app/roadmap' : 'https://cordhq.app/en/roadmap'}>{lang === 'es' ? 'roadmap de Cord' : 'Cord roadmap'}</a>
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('help')}></svg>
                {lang === 'es' ? '¿Tienes alguna pregunta? ' : 'Have questions? '}
                <a href={lang === 'es' ? 'https://cordhq.app/contacto/ventas' : 'https://cordhq.app/en/contacto/ventas'}>{lang === 'es' ? 'Ponte en contacto con el equipo de ventas' : 'Contact sales team'}</a>
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('products')}></svg>
                {lang === 'es' ? '¿LLM? ' : 'LLM? '}
                <a href="https://cordhq.app/llms.txt">{lang === 'es' ? 'Lee llms.txt' : 'Read llms.txt'}</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
          {headings && headings.length > 0 && !isOverviewPage && (
            <aside class="docs-toc">
              <TableOfContents headings={headings} lang={lang} />
            </aside>
          )}
        </div>
      </main>
    </div>
  </div>

  <!-- Search Modal -->
  <div id="search-modal" class="search-modal hidden" role="dialog" aria-modal="true" aria-label={lang === 'es' ? 'Buscar en la documentación' : 'Search documentation'}>
    <div class="search-modal-backdrop" id="search-backdrop"></div>
    <div class="search-modal-content">
      <div class="search-modal-header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconInner('search')}></svg>
        <label class="docs-sr-only" for="search-input-field">{lang === 'es' ? 'Buscar en la documentación' : 'Search documentation'}</label>
        <input type="search" id="search-input-field" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-results" enterkeyhint="go" placeholder={lang === 'es' ? 'Buscar en la documentación' : 'Search documentation'} autocomplete="off" spellcheck="false" />
        <button type="button" id="search-close" class="search-close-btn" aria-label={lang === 'es' ? 'Cerrar búsqueda' : 'Close search'}>ESC</button>
      </div>
      <div class="search-modal-body" id="search-results">
        <div class="search-results-empty">
          <p>{lang === 'es' ? 'Escribe algo para buscar en guías, referencias de API y más.' : 'Type to search guides, API references, and more.'}</p>
        </div>
      </div>
      <div class="search-modal-footer" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> {lang === 'es' ? 'navegar' : 'navigate'}</span>
        <span><kbd>Enter</kbd> {lang === 'es' ? 'abrir' : 'open'}</span>
        <span><kbd>Esc</kbd> {lang === 'es' ? 'cerrar' : 'close'}</span>
      </div>
      <p class="docs-sr-only" id="search-status" role="status" aria-live="polite"></p>
    </div>
  </div>
</Layout>

<script>
  // Search Modal Logic with Fuse.js
  import Fuse from 'fuse.js';
  import { escapeHtml } from '../lib/escape';

  const isEn = () => document.documentElement.lang === 'en';
  const tr = (es: string, en: string) => (isEn() ? en : es);

  // El header fijo cambia de alto entre escritorio y móvil (y con la fila de
  // pestañas). Las anclas y el índice leen su alto real desde esta variable.
  const docsHeader = document.querySelector<HTMLElement>('.docs-header');
  const syncHeaderHeight = () => {
    if (!docsHeader) return;
    document.documentElement.style.setProperty('--docs-header-h', `${Math.round(docsHeader.getBoundingClientRect().height)}px`);
  };
  syncHeaderHeight();
  if (docsHeader && 'ResizeObserver' in window) new ResizeObserver(syncHeaderHeight).observe(docsHeader);
  const enableSmoothScroll = () => window.requestAnimationFrame(() => document.documentElement.classList.add('docs-smooth-scroll'));
  if (document.readyState === 'complete') enableSmoothScroll();
  else window.addEventListener('load', enableSmoothScroll, { once: true });

  const trigger = document.getElementById('search-trigger');
  const modal = document.getElementById('search-modal');
  const backdrop = document.getElementById('search-backdrop');
  const closeBtn = document.getElementById('search-close');
  const input = document.getElementById('search-input-field') as HTMLInputElement | null;
  const resultsContainer = document.getElementById('search-results');
  const searchStatus = document.getElementById('search-status');

  type SearchDoc = { title: string; description: string; body: string; url: string; lang: string; section?: string; plain?: string; foldedPlain?: string };

  let fuse: Fuse<SearchDoc> | null = null;
  let indexPromise: Promise<void> | null = null;
  let searchAnalyticsTimer: number | null = null;
  let statusTimer: number | null = null;
  let lastTrackedSearch = '';
  let activeIndex = -1;
  let returnFocusTo: HTMLElement | null = null;

  function trackDocsEvent(event, properties = {}) {
    (window as any).cordTrack?.(event, {
      page_path: window.location.pathname,
      language: document.documentElement.lang || 'es',
      ...properties
    });
  }

  // Search can contain contact or account data. Keep the useful intent while
  // removing common direct identifiers before it reaches analytics.
  function analyticsSafeQuery(query: string) {
    return query
      .trim()
      .replace(/\s+/g, ' ')
      .replace(/[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}/g, '[email]')
      .replace(/\b\d{6,}\b/g, '[number]')
      .slice(0, 120);
  }

  function scheduleSearchAnalytics(query: string, resultCount: number) {
    const safeQuery = analyticsSafeQuery(query);
    if (safeQuery.length < 2) return;

    if (searchAnalyticsTimer) window.clearTimeout(searchAnalyticsTimer);
    searchAnalyticsTimer = window.setTimeout(() => {
      const searchKey = `${safeQuery.toLocaleLowerCase()}:${resultCount}`;
      if (searchKey === lastTrackedSearch) return;
      lastTrackedSearch = searchKey;

      const properties = {
        query: safeQuery,
        query_length: safeQuery.length,
        results_count: resultCount
      };
      trackDocsEvent('docs_search_performed', properties);
      if (resultCount === 0) trackDocsEvent('docs_search_zero_results', properties);
    }, 700);
  }

  // --- Texto: plegado sin acentos para resaltar lo que coincide ---------------
  const foldChar = (ch: string) => {
    const folded = ch.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    return folded || ch;
  };
  const fold = (text: string) => Array.from(text).map(foldChar).join('');

  function queryTerms(query: string) {
    const terms = fold(query).split(/[^\p{L}\p{N}._-]+/u).filter((term) => term.length >= 2);
    return Array.from(new Set(terms)).sort((a, b) => b.length - a.length);
  }

  // Envuelve en <mark> cada aparición de los términos, escapando todo lo demás.
  function highlight(text: string, terms: string[]) {
    if (!text) return '';
    if (!terms.length) return escapeHtml(text);
    const chars = Array.from(text);
    let folded = '';
    const owner: number[] = [];
    chars.forEach((ch, i) => {
      const f = foldChar(ch);
      folded += f;
      for (let k = 0; k < f.length; k++) owner.push(i);
    });
    const marked = new Array(chars.length).fill(false);
    for (const term of terms) {
      let from = folded.indexOf(term);
      while (from !== -1) {
        for (let k = from; k < from + term.length; k++) marked[owner[k]] = true;
        from = folded.indexOf(term, from + term.length);
      }
    }
    let html = '';
    let open = false;
    chars.forEach((ch, i) => {
      if (marked[i] && !open) { html += '<mark>'; open = true; }
      if (!marked[i] && open) { html += '</mark>'; open = false; }
      html += escapeHtml(ch);
    });
    if (open) html += '</mark>';
    return html;
  }

  // El cuerpo del índice es MDX crudo: se limpia una vez para sacar extractos.
  function plainBody(body: string) {
    return body
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/<[^>]+>/g, ' ')
      .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
      .replace(/^\s*\|?[-:| ]{3,}\|?\s*$/gm, ' ')
      .replace(/[#>*_`|]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function excerpt(doc: SearchDoc, terms: string[]) {
    if (!terms.length) return '';
    if (doc.plain === undefined) {
      doc.plain = plainBody(doc.body || '');
      doc.foldedPlain = fold(doc.plain);
    }
    const plain = doc.plain;
    const foldedPlain = doc.foldedPlain || '';
    // Sólo es fiable cuando plegar no cambió la longitud (caso normal en es/en).
    if (foldedPlain.length !== plain.length) return '';
    const at = terms.map((term) => foldedPlain.indexOf(term)).filter((i) => i >= 0).sort((a, b) => a - b)[0];
    if (at === undefined) return '';
    const start = Math.max(0, at - 60);
    const end = Math.min(plain.length, at + 120);
    return `${start > 0 ? '…' : ''}${plain.slice(start, end).trim()}${end < plain.length ? '…' : ''}`;
  }

  // La sección sale de la URL: es lo que el lector usa para distinguir dos
  // páginas con el mismo título ("Resumen", "Seguridad").
  const SECTION_LABELS: Record<string, [string, string]> = {
    cuenta: ['Cuenta', 'Account'],
    cotizacion: ['Cotizaciones', 'Quotes'],
    interaccion: ['Interacción y cierre', 'Interaction and closing'],
    gestion: ['Gestión de ventas', 'Sales management'],
    pagos: ['Cobrar y facturar', 'Get paid and invoice'],
    desarrolladores: ['Desarrolladores', 'Developers'],
    operacion: ['Operación', 'Operations'],
    productos: ['Productos', 'Products'],
    'automatizacion/workflows': ['Cord Workflows', 'Cord Workflows'],
    'automatizacion/integraciones': ['Integraciones', 'Integrations'],
  };
  function sectionLabel(url: string) {
    const path = url.replace(/^https?:\/\/[^/]+/, '').replace(/^\/en(?=\/)/, '').replace(/^\/docs\/?/, '');
    const parts = path.split('/').filter(Boolean);
    const entry = SECTION_LABELS[parts.slice(0, 2).join('/')] || SECTION_LABELS[parts[0] || ''];
    if (entry) return isEn() ? entry[1] : entry[0];
    return parts.length ? '' : tr('Inicio', 'Home');
  }

  function setEmpty(message: string) {
    if (!resultsContainer) return;
    resultsContainer.innerHTML = `<div class="search-results-empty"><p>${escapeHtml(message)}</p></div>`;
    activeIndex = -1;
    input?.setAttribute('aria-expanded', 'false');
    input?.removeAttribute('aria-activedescendant');
  }

  function announce(message: string) {
    if (!searchStatus) return;
    if (statusTimer) window.clearTimeout(statusTimer);
    statusTimer = window.setTimeout(() => { searchStatus.textContent = message; }, 350);
  }

  function showEmptyState() {
    setEmpty(tr('Escribe algo para buscar en guías, referencias de API y más.', 'Type to search guides, API references, and more.'));
    announce('');
  }

  function loadIndex() {
    if (indexPromise) return indexPromise;
    indexPromise = (async () => {
      const res = await fetch('/api/docs-search.json');
      if (!res.ok) throw new Error(`Search index returned ${res.status}`);
      const currentLang = document.documentElement.lang || 'es';
      const searchData: SearchDoc[] = (await res.json()).filter((doc: SearchDoc) => doc.lang === currentLang);
      fuse = new Fuse(searchData, {
        keys: [
          { name: 'title', weight: 0.7 },
          { name: 'description', weight: 0.3 },
          { name: 'body', weight: 0.5 }
        ],
        includeMatches: true,
        minMatchCharLength: 2,
        threshold: 0.3,
        ignoreLocation: true
      });
    })();
    indexPromise.catch(() => { indexPromise = null; });
    return indexPromise;
  }

  async function fetchSearchData() {
    if (!fuse) setEmpty(tr('Cargando índice de búsqueda…', 'Loading search index…'));
    try {
      await loadIndex();
      if (input && input.value.trim() !== '') performSearch(input.value);
      else showEmptyState();
    } catch (err) {
      console.error('Failed to load search data:', err);
      setEmpty(tr('No se pudo cargar la búsqueda. Inténtalo de nuevo.', 'Search could not load. Please try again.'));
    }
  }

  function options() {
    return Array.from(resultsContainer?.querySelectorAll<HTMLElement>('[role="option"]') || []);
  }

  function setActive(index: number, scroll = true) {
    const items = options();
    if (!items.length) return;
    activeIndex = Math.max(0, Math.min(index, items.length - 1));
    items.forEach((item, i) => {
      const active = i === activeIndex;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    const current = items[activeIndex];
    input?.setAttribute('aria-activedescendant', current.id);
    if (scroll) current.scrollIntoView({ block: 'nearest' });
  }

  function performSearch(query: string) {
    if (!fuse) return;
    if (!query || query.trim() === '') {
      showEmptyState();
      return;
    }

    const results = fuse.search(query).slice(0, 8); // Top 8 results
    scheduleSearchAnalytics(query, results.length);

    if (results.length === 0) {
      setEmpty(`${tr('No se encontraron resultados para', 'No results found for')} "${query.trim()}"`);
      announce(tr('Sin resultados', 'No results'));
      return;
    }

    const terms = queryTerms(query);
    let html = `<ul class="search-results-list" role="listbox" id="search-listbox" aria-label="${escapeHtml(tr('Resultados de búsqueda', 'Search results'))}">`;
    results.forEach(({ item }, index) => {
      // El índice trae la sección de src/lib/docs-nav.ts; la URL es el respaldo.
      const section = item.section || sectionLabel(item.url);
      const descHasTerm = terms.some((term) => fold(item.description || '').includes(term));
      const titleHasTerm = terms.some((term) => fold(item.title || '').includes(term));
      const snippet = !descHasTerm && !titleHasTerm ? excerpt(item, terms) : '';
      const detail = snippet || item.description;
      html += `
        <li class="search-result-item" role="option" id="search-opt-${index}" aria-selected="false">
          <a href="${escapeHtml(item.url)}" data-search-position="${index + 1}" tabindex="-1">
            ${section ? `<span class="search-result-section">${escapeHtml(section)}</span>` : ''}
            <span class="search-result-title">${highlight(item.title, terms)}</span>
            ${detail ? `<span class="search-result-desc">${highlight(detail, terms)}</span>` : ''}
          </a>
        </li>
      `;
    });
    html += '</ul>';

    if (resultsContainer) resultsContainer.innerHTML = html;
    input?.setAttribute('aria-controls', 'search-listbox');
    input?.setAttribute('aria-expanded', 'true');
    setActive(0, false);
    announce(results.length === 1
      ? tr('1 resultado. Usa las flechas para elegir.', '1 result. Use the arrow keys to choose.')
      : tr(`${results.length} resultados. Usa las flechas para elegir.`, `${results.length} results. Use the arrow keys to choose.`));
  }

  const isSearchOpen = () => Boolean(modal && !modal.classList.contains('hidden'));

  function openSearch(source = 'button') {
    if (!modal || !input || isSearchOpen()) return;
    returnFocusTo = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    modal.classList.remove('hidden');
    trigger?.setAttribute('aria-expanded', 'true');
    input.focus();
    document.body.style.overflow = 'hidden';
    trackDocsEvent('docs_search_opened', { source });
    fetchSearchData(); // Fetch JSON dynamically on first open
  }

  function closeSearch() {
    if (!modal || !isSearchOpen()) return;
    modal.classList.add('hidden');
    trigger?.setAttribute('aria-expanded', 'false');
    if (input) input.value = '';
    if (searchAnalyticsTimer) window.clearTimeout(searchAnalyticsTimer);
    showEmptyState();
    document.body.style.overflow = '';
    (returnFocusTo && document.contains(returnFocusTo) ? returnFocusTo : trigger)?.focus();
    returnFocusTo = null;
  }

  if (trigger) {
    trigger.addEventListener('click', () => openSearch('button'));
    // Precarga del índice con la intención (hover o foco), no al pintar la página.
    const prefetch = () => { loadIndex().catch(() => {}); };
    trigger.addEventListener('pointerenter', prefetch, { once: true });
    trigger.addEventListener('focus', prefetch, { once: true });
    trigger.addEventListener('touchstart', prefetch, { once: true, passive: true });
  }
  if (backdrop) backdrop.addEventListener('click', closeSearch);
  if (closeBtn) closeBtn.addEventListener('click', closeSearch);

  if (input) {
    input.addEventListener('input', () => performSearch(input.value));
    input.addEventListener('keydown', (event) => {
      const items = options();
      if (event.key === 'ArrowDown' && items.length) {
        event.preventDefault();
        setActive(activeIndex < 0 ? 0 : (activeIndex + 1) % items.length);
      } else if (event.key === 'ArrowUp' && items.length) {
        event.preventDefault();
        setActive(activeIndex <= 0 ? items.length - 1 : activeIndex - 1);
      } else if (event.key === 'Enter' && items.length) {
        event.preventDefault();
        items[Math.max(0, activeIndex)].querySelector<HTMLAnchorElement>('a')?.click();
      }
    });
  }

  if (resultsContainer) {
    resultsContainer.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-search-position]');
      if (!link) return;
      trackDocsEvent('docs_search_result_clicked', {
        query: analyticsSafeQuery(input?.value || ''),
        result_path: new URL(link.href, window.location.origin).pathname,
        result_position: Number(link.dataset.searchPosition)
      });
    });
    resultsContainer.addEventListener('pointermove', (event) => {
      const option = (event.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (!option) return;
      const index = options().indexOf(option);
      if (index >= 0 && index !== activeIndex) setActive(index, false);
    });
  }

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const isEditing = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target?.isContentEditable;
    const isModK = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
    if ((event.key === '/' && !isEditing && !isSearchOpen()) || (isModK && !isSearchOpen())) {
      event.preventDefault();
      openSearch(isModK ? 'keyboard_shortcut_mod_k' : 'keyboard_shortcut');
    } else if (event.key === 'Escape' && isSearchOpen()) {
      event.preventDefault();
      closeSearch();
    } else if (event.key === 'Tab' && isSearchOpen() && input && closeBtn) {
      // El diálogo es modal: el foco no sale de él mientras está abierto.
      const first = input;
      const last = closeBtn;
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    }
  });

  // Help dropdown: abre con clic o teclado, no sólo con hover.
  const helpTrigger = document.getElementById('docs-help-trigger');
  const helpMenu = document.getElementById('docs-help-menu');
  const helpWrap = helpTrigger?.closest<HTMLElement>('.nav-dropdown-wrapper') || null;
  const helpItems = () => Array.from(helpMenu?.querySelectorAll<HTMLAnchorElement>('a') || []);

  function setHelpOpen(open: boolean, focusItem: 'first' | 'last' | null = null) {
    if (!helpTrigger || !helpWrap) return;
    helpWrap.classList.toggle('open', open);
    helpTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open && focusItem) {
      const items = helpItems();
      (focusItem === 'first' ? items[0] : items[items.length - 1])?.focus();
    }
  }

  if (helpTrigger && helpMenu && helpWrap) {
    helpTrigger.addEventListener('click', () => setHelpOpen(!helpWrap.classList.contains('open')));
    helpTrigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') { event.preventDefault(); setHelpOpen(true, 'first'); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); setHelpOpen(true, 'last'); }
    });
    helpMenu.addEventListener('keydown', (event) => {
      const items = helpItems();
      const index = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown') { event.preventDefault(); items[(index + 1) % items.length]?.focus(); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); items[(index - 1 + items.length) % items.length]?.focus(); }
      else if (event.key === 'Home') { event.preventDefault(); items[0]?.focus(); }
      else if (event.key === 'End') { event.preventDefault(); items[items.length - 1]?.focus(); }
      else if (event.key === 'Escape') { event.preventDefault(); setHelpOpen(false); helpTrigger.focus(); }
    });
    helpWrap.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !helpWrap.contains(next)) setHelpOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (!helpWrap.contains(event.target as Node)) setHelpOpen(false);
    });
  }

// Feedback Logic
  const btnYes = document.getElementById('feedback-yes') as HTMLButtonElement | null;
  const btnNo = document.getElementById('feedback-no') as HTMLButtonElement | null;
  const thanksMsg = document.getElementById('feedback-thanks');

  const feedbackStorageKey = `cord_docs_feedback:${window.location.pathname}`;

  function renderFeedback(response: 'yes' | 'no') {
    const clickedBtn = response === 'yes' ? btnYes : btnNo;
    const otherBtn = response === 'yes' ? btnNo : btnYes;
    if (!clickedBtn || !otherBtn || !thanksMsg) return;

    clickedBtn.classList.add('active');
    clickedBtn.setAttribute('aria-pressed', 'true');
    clickedBtn.classList.add('disabled');
    otherBtn.classList.add('disabled');
    clickedBtn.disabled = true;
    otherBtn.disabled = true;
    thanksMsg.textContent = thanksMsg.dataset.text || '';
  }

  function handleFeedbackClick(response: 'yes' | 'no') {
    renderFeedback(response);
    try {
      window.localStorage.setItem(feedbackStorageKey, response);
    } catch {
      // Feedback still works if storage is unavailable.
    }
    trackDocsEvent('docs_feedback_submitted', { helpful: response === 'yes' });
  }

  if (btnYes) {
    btnYes.addEventListener('click', () => handleFeedbackClick('yes'));
  }
  if (btnNo) {
    btnNo.addEventListener('click', () => handleFeedbackClick('no'));
  }

  try {
    const savedFeedback = window.localStorage.getItem(feedbackStorageKey);
    if (savedFeedback === 'yes' || savedFeedback === 'no') renderFeedback(savedFeedback);
  } catch {
    // Ignore unavailable storage.
  }

  // Mobile Menu Logic
  // Bajo 880px el sidebar es un panel fuera de pantalla: cerrado queda `inert`
  // (ni foco ni lector de pantalla lo alcanzan), Escape lo cierra y el foco
  // vuelve al botón que lo abrió.
  const menuTrigger = document.getElementById('mobile-menu-trigger');
  const menuClose = document.getElementById('mobile-menu-close');
  const sidebar = document.getElementById('docs-sidebar');
  const sidebarBackdrop = document.getElementById('mobile-sidebar-backdrop');
  const offCanvasQuery = window.matchMedia('(max-width: 880px)');
  const isMenuOpen = () => Boolean(sidebar?.classList.contains('open'));

  function openMobileMenu() {
    if (!sidebar) return;
    sidebar.classList.add('open');
    sidebar.inert = false;
    sidebar.setAttribute('role', 'dialog');
    sidebar.setAttribute('aria-modal', 'true');
    sidebar.setAttribute('aria-label', tr('Navegación de la documentación', 'Documentation navigation'));
    sidebarBackdrop?.classList.remove('hidden');
    menuTrigger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    window.requestAnimationFrame(() => (menuClose || sidebar).focus());
  }

  function closeMobileMenu(restoreFocus = true) {
    if (!sidebar) return;
    const wasOpen = isMenuOpen();
    sidebar.classList.remove('open');
    sidebar.removeAttribute('role');
    sidebar.removeAttribute('aria-modal');
    sidebar.removeAttribute('aria-label');
    sidebar.inert = offCanvasQuery.matches;
    sidebarBackdrop?.classList.add('hidden');
    menuTrigger?.setAttribute('aria-expanded', 'false');
    if (wasOpen) document.body.style.overflow = '';
    if (wasOpen && restoreFocus) menuTrigger?.focus();
  }

  function syncSidebarMode() {
    if (!sidebar) return;
    if (offCanvasQuery.matches) sidebar.inert = !isMenuOpen();
    else closeMobileMenu(false);
  }

  if (menuTrigger) menuTrigger.addEventListener('click', openMobileMenu);
  if (menuClose) menuClose.addEventListener('click', () => closeMobileMenu());
  if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', () => closeMobileMenu());
  offCanvasQuery.addEventListener('change', syncSidebarMode);
  syncSidebarMode();

  document.addEventListener('keydown', (event) => {
    if (!isMenuOpen() || !sidebar) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeMobileMenu();
    } else if (event.key === 'Tab') {
      const focusables = Array.from(sidebar.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'))
        .filter((el) => el.offsetParent !== null);
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    }
  });
  sidebar?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a[href]') && isMenuOpen()) closeMobileMenu(false);
  });

</script>

<style is:global>
