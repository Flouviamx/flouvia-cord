  .docs-code-copy:hover { background: rgba(255, 255, 255, 0.08); color: #ffffff; }
  .docs-code-copy.is-done { color: #86efac; }
  .docs-layout .docs-code-copy:focus-visible { outline: 2px solid #93c5fd; outline-offset: 0; }
  .docs-main .content-container .docs-code pre {
