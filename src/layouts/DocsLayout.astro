                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/herramientas/elements/eventos')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/herramientas/elements/eventos')}>{lang === 'es' ? 'Eventos' : 'Events'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/herramientas/elements/seguridad')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/herramientas/elements/seguridad')}>{lang === 'es' ? 'Seguridad CSP' : 'CSP Security'}</a></li>
                    </ul>
                  </li>
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Esenciales' : 'Essentials'}
                    </button>
                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/esenciales/autenticacion')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/esenciales/autenticacion')}>{lang === 'es' ? 'Autenticación' : 'Authentication'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/esenciales/paginacion')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/esenciales/paginacion')}>{lang === 'es' ? 'Paginación' : 'Pagination'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/esenciales/errores')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/esenciales/errores')}>{lang === 'es' ? 'Manejo de Errores' : 'Error Handling'}</a></li>
                    </ul>
                  </li>
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Funciones' : 'Features'}
                    </button>
                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/funciones/cotizaciones')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/funciones/cotizaciones')}>{lang === 'es' ? 'API de Cotizaciones' : 'Quotes API'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/funciones/clientes')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/funciones/clientes')}>{lang === 'es' ? 'API de Clientes' : 'Clients API'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/funciones/productos')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/funciones/productos')}>{lang === 'es' ? 'API de Productos' : 'Products API'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/funciones/cobranza')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/funciones/cobranza')}>{lang === 'es' ? 'API de Cobranza' : 'Collections API'}</a></li>
                    </ul>
                  </li>
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Seguridad y Privacidad' : 'Security & Privacy'}
                    </button>
                    <ul class="sidebar-submenu">
