                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/herramientas/workbench')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/herramientas/workbench')}>Cord Workbench</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/herramientas/webhooks')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/herramientas/webhooks')}>{lang === 'es' ? 'Webhooks' : 'Webhooks'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/herramientas/mcp')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/herramientas/mcp')}>{lang === 'es' ? 'Servidor MCP' : 'MCP Server'}</a></li>
                    </ul>
                  </li>
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      Cord Elements
                    </button>
                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/herramientas/elements/resumen')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/herramientas/elements/resumen')}>{lang === 'es' ? 'Resumen' : 'Overview'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/herramientas/elements/react')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/herramientas/elements/react')}>React & Next.js</a></li>
