                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Configurar cobros' : 'Configure payments'}
                    </button>
                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/onboarding')) ? 'active' : ''}><a href={getUrl('/docs/pagos/onboarding')}>{lang === 'es' ? 'Conectar cuenta (KYC)' : 'Connect account (KYC)'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/condiciones')) ? 'active' : ''}><a href={getUrl('/docs/pagos/condiciones')}>{lang === 'es' ? 'Tarifas y ventajas' : 'Fees and advantages'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/metodos')) ? 'active' : ''}><a href={getUrl('/docs/pagos/metodos')}>{lang === 'es' ? 'Métodos de cobro' : 'Payment methods'}</a></li>
                    </ul>
                  </li>
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Modelos de cobro avanzado' : 'Advanced billing models'}
                    </button>
                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/anticipos')) ? 'active' : ''}><a href={getUrl('/docs/pagos/anticipos')}>{lang === 'es' ? 'Anticipo y Saldo' : 'Upfront and Balance'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/igualas')) ? 'active' : ''}><a href={getUrl('/docs/pagos/igualas')}>{lang === 'es' ? 'Igualas recurrentes' : 'Monthly retainers'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/credito')) ? 'active' : ''}><a href={getUrl('/docs/pagos/credito')}>{lang === 'es' ? 'Términos de crédito (Net)' : 'Credit terms (Net)'}</a></li>
                    </ul>
                  </li>
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Gestión de cobros' : 'Payment management'}
                    </button>
                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/dashboard')) ? 'active' : ''}><a href={getUrl('/docs/pagos/dashboard')}>{lang === 'es' ? 'Dashboard de cobros' : 'Payments dashboard'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/reembolsos')) ? 'active' : ''}><a href={getUrl('/docs/pagos/reembolsos')}>{lang === 'es' ? 'Reembolsos' : 'Refunds'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/disputas')) ? 'active' : ''}><a href={getUrl('/docs/pagos/disputas')}>{lang === 'es' ? 'Disputas y contracargos' : 'Disputes and chargebacks'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/facturacion')) ? 'active' : ''}><a href={getUrl('/docs/pagos/facturacion')}>{lang === 'es' ? 'Facturación (CFDI 4.0)' : 'Invoicing (CFDI 4.0)'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/facturas-emitidas')) ? 'active' : ''}><a href={getUrl('/docs/pagos/facturas-emitidas')}>{lang === 'es' ? 'Facturas' : 'Invoices'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/facturas-recurrentes')) ? 'active' : ''}><a href={getUrl('/docs/pagos/facturas-recurrentes')}>{lang === 'es' ? 'Facturas recurrentes' : 'Recurring invoices'}</a></li>
                    </ul>
                  </li>
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Cobranza y tesorería' : 'Collections and treasury'}
                    </button>
                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/cartera-cobranza')) ? 'active' : ''}><a href={getUrl('/docs/pagos/cartera-cobranza')}>{lang === 'es' ? 'Cartera y seguimiento' : 'Receivables and follow-up'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/cobranza-ia')) ? 'active' : ''}><a href={getUrl('/docs/pagos/cobranza-ia')}>{lang === 'es' ? 'Cobranza autónoma (IA)' : 'Autonomous collections (AI)'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/tesoreria-fx')) ? 'active' : ''}><a href={getUrl('/docs/pagos/tesoreria-fx')}>{lang === 'es' ? 'Tesorería y FX Lock' : 'Treasury and FX Lock'}</a></li>
                    </ul>
                  </li>
                </ul>
              </div>
            </>
          ) : Astro.url.pathname.includes(getUrl('/docs/desarrolladores')) ? (
            <>
              <ul class="sidebar-menu">
                <li class={Astro.url.pathname === getUrl('/docs/desarrolladores/empezar/resumen') || Astro.url.pathname === getUrl('/docs/desarrolladores/empezar/resumen/') ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/empezar/resumen')}>{lang === 'es' ? 'Resumen' : 'Overview'}</a></li>
              </ul>

              <div class="sidebar-section">
                <p class="sidebar-heading">{lang === 'es' ? 'DESARROLLADORES' : 'DEVELOPERS'}</p>
                <ul class="sidebar-menu">
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Empezar' : 'Get Started'}
                    </button>
                    <ul class="sidebar-submenu">
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/empezar/apikey')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/empezar/apikey')}>{lang === 'es' ? 'Crea tu API Key' : 'Create your API Key'}</a></li>
                      <li class={Astro.url.pathname.includes(getUrl('/docs/desarrolladores/empezar/pruebas')) ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/empezar/pruebas')}>{lang === 'es' ? 'Entornos de Prueba' : 'Test Environments'}</a></li>
                    </ul>
                  </li>
                  <li class="sidebar-dropdown open">
                    <button class="sidebar-dropdown-toggle">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      {lang === 'es' ? 'Herramientas' : 'Tools'}
