---
import Layout from "./Layout.astro";

import type { MarkdownHeading } from "astro";
import TableOfContents from "../components/docs/TableOfContents.astro";

export interface Props {
  headings?: MarkdownHeading[];
  title: string;
  lang?: "es" | "en";
  description?: string;
  lastUpdated?: string;
  reviewedBy?: string;
  appliesToMarkets?: string[];
  availablePlans?: string[];
  prerequisites?: string[];
}

import { altLangUrls } from "../i18n/utils";

const {
  title,
  lang = "es",
  description,
  headings = [],
  lastUpdated,
  reviewedBy,
  appliesToMarkets = [],
  availablePlans = [],
  prerequisites = []
} = Astro.props;
const { esUrl, enUrl } = altLangUrls(Astro.url);

const getUrl = (path: string) => lang === 'en' ? `/en${path}` : path;

const isOverviewPage = Astro.url.pathname.endsWith('/resumen') || Astro.url.pathname.endsWith('/resumen/') || Astro.url.pathname === '/docs' || Astro.url.pathname === '/docs/' || Astro.url.pathname === '/en/docs' || Astro.url.pathname === '/en/docs/';
const isPaymentsSection = Astro.url.pathname.includes(getUrl('/docs/pagos'));
const isDeveloperSection = Astro.url.pathname.includes(getUrl('/docs/desarrolladores'));
const isQuoteSection = [
  getUrl('/docs/cotizacion'),
  getUrl('/docs/interaccion'),
  getUrl('/docs/gestion')
].some((prefix) => Astro.url.pathname.includes(prefix));
const isStartSection = !isPaymentsSection && !isDeveloperSection && !isQuoteSection;

// Docs vive en el subdominio docs.cordhq.app (rewrite en src/middleware.ts) — el
// breadcrumb/WebPage debe apuntar ahí, no al dominio apex (que 301-redirige a este
// mismo subdominio, lo que dejaba el canonical/JSON-LD apuntando a sí mismo a
// través de un redirect). Organization/WebSite SÍ se quedan en cordhq.app: son la
// entidad de marca única, no la ubicación de esta página en particular.
// El canonical público es estable incluso detrás de proxies que entregan la
// petición interna por HTTP. Usar Astro.url.origin podía publicar `http://` en
// previews o adaptadores que no preservaran correctamente X-Forwarded-Proto.
const pageOrigin = 'https://docs.cordhq.app';

const marketNames: Record<string, { es: string; en: string }> = {
  MX: { es: 'México', en: 'Mexico' },
  US: { es: 'Estados Unidos', en: 'United States' },
  CA: { es: 'Canadá', en: 'Canada' },
  BR: { es: 'Brasil', en: 'Brazil' },
  ES: { es: 'España', en: 'Spain' },
  GB: { es: 'Reino Unido', en: 'United Kingdom' },
  DE: { es: 'Alemania', en: 'Germany' },
  FR: { es: 'Francia', en: 'France' },
  CO: { es: 'Colombia', en: 'Colombia' },
  AR: { es: 'Argentina', en: 'Argentina' },
  CL: { es: 'Chile', en: 'Chile' },
  PE: { es: 'Perú', en: 'Peru' }
};
const localizedMarkets = appliesToMarkets.map((code) => marketNames[code]?.[lang] || code);
const hasEditorialMetadata = Boolean(lastUpdated || reviewedBy || localizedMarkets.length || availablePlans.length || prerequisites.length);

// Build breadcrumb from URL path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = pathSegments.map((segment, index) => {
  const path = '/' + pathSegments.slice(0, index + 1).join('/');
  const label = segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');
  return { name: label, url: `${pageOrigin}${path}` };
});

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://cordhq.app/#organization",
      "name": "Cord",
      "url": "https://cordhq.app",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cordhq.app/imgs/logo-cord-navy.png"
      },
      "sameAs": []
    },
    {
      "@type": "WebSite",
      "@id": "https://cordhq.app/#website",
      "url": "https://cordhq.app",
      "name": "Cord",
      "publisher": { "@id": "https://cordhq.app/#organization" },
      "inLanguage": lang === "es" ? "es-MX" : "en-US"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url
      }))
    },
    {
      "@type": "TechArticle",
      "headline": title,
      ...(description ? { "description": description } : {}),
      "url": `${pageOrigin}${Astro.url.pathname}`,
      "mainEntityOfPage": `${pageOrigin}${Astro.url.pathname}`,
      "inLanguage": lang === "es" ? "es-MX" : "en-US",
      "isPartOf": { "@id": "https://cordhq.app/#website" },
      "about": { "@id": "https://cordhq.app/#organization" },
      "author": { "@id": "https://cordhq.app/#organization" },
      "publisher": { "@id": "https://cordhq.app/#organization" },
      ...(lastUpdated ? { "dateModified": lastUpdated } : {}),
      ...(localizedMarkets.length ? {
        "spatialCoverage": localizedMarkets.map((name) => ({ "@type": "Place", "name": name }))
      } : {}),
      ...(availablePlans.length ? {
        "audience": { "@type": "Audience", "audienceType": availablePlans.join(', ') }
      } : {}),
      ...(prerequisites.length ? { "dependencies": prerequisites.join('; ') } : {})
    }
  ]
};
---

<Layout title={`${title} | Cord Docs`} description={description} ogType="article" canonicalOrigin={pageOrigin}>
  <style is:inline>
    :root { color-scheme: light; }
    html { lang: ${lang}; }
  </style>
  <!-- Set lang dynamically for JS scripts to read -->
  <script is:inline define:vars={{ lang }}>
    document.documentElement.lang = lang;
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="docs-layout">
    
    <!-- Header -->
    <header class="docs-header">
      <div class="header-top">
        <div class="header-left">
          <button id="mobile-menu-trigger" class="mobile-menu-btn" aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
          </button>
          <a href={getUrl('/docs')} class="logo">
            <img src="/imgs/logo-cord-navy.png" alt="Cord" height="24" style="height: 24px; margin-right: 6px;" />
            <span class="brand-docs">DOCS</span>
          </a>
        </div>
        
        <div class="header-center">
          <div class="search-container">
            <button class="search-input" id="search-trigger" aria-label={lang === 'es' ? 'Buscar en la documentación' : 'Search documentation'}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
              <span>{lang === 'es' ? 'Buscar en la document...' : 'Search docs...'}</span>
              <kbd>/</kbd>
            </button>
          </div>
        </div>

        <div class="header-right">
          <div class="lang-toggle">
            <a href={esUrl} class={`lang-option ${lang === 'es' ? 'active' : ''}`} aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
            <a href={enUrl} class={`lang-option ${lang === 'en' ? 'active' : ''}`} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          </div>
        </div>
      </div>

      <nav class="header-bottom">
        <ul class="nav-links">
          <li class={isStartSection ? 'active' : ''}><a href={getUrl('/docs')}>{lang === 'es' ? 'Empezar' : 'Get started'}</a></li>
          <li class={isQuoteSection ? 'active' : ''}><a href={getUrl('/docs/cotizacion/resumen')}>{lang === 'es' ? 'Cotizar y cerrar' : 'Quote and close'}</a></li>
          <li class={isPaymentsSection ? 'active' : ''}><a href={getUrl('/docs/pagos/resumen')}>{lang === 'es' ? 'Cobrar y facturar' : 'Get paid and invoice'}</a></li>
          <li class={isDeveloperSection ? 'active' : ''}><a href={getUrl('/docs/desarrolladores/empezar/resumen')}>{lang === 'es' ? 'Desarrolladores' : 'Developers'}</a></li>
        </ul>
        <div class="nav-tools">
          <div class="nav-dropdown-wrapper">
            <button class="nav-dropdown">{lang === 'es' ? 'Ayuda' : 'Help'} <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></button>
            <div class="dropdown-menu">
              <a href={lang === 'es' ? 'https://cordhq.app/soporte' : 'https://cordhq.app/en/support'}>{lang === 'es' ? 'Centro de soporte' : 'Support Center'}</a>
              <a href={lang === 'es' ? 'https://cordhq.app/contacto/ventas' : 'https://cordhq.app/en/contacto/ventas'}>{lang === 'es' ? 'Contactar a ventas' : 'Contact Sales'}</a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <div class="docs-body">
      <!-- Mobile Backdrop -->
      <div id="mobile-sidebar-backdrop" class="sidebar-backdrop hidden"></div>
      
      <!-- Sidebar -->
      <aside class="docs-sidebar" id="docs-sidebar">
        <div class="sidebar-mobile-header">
          <a href={getUrl('/docs')} class="logo"><img src="/imgs/logo-cord-navy.png" alt="Cord" height="20" style="height: 20px; margin-right: 4px;" /><span class="brand-docs">DOCS</span></a>
          <button id="mobile-menu-close" class="mobile-menu-close" aria-label={lang === 'es' ? 'Cerrar menú' : 'Close menu'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
        </div>
        <nav class="sidebar-nav">
          {Astro.url.pathname.includes(getUrl('/docs/pagos')) ? (
            <>
              <ul class="sidebar-menu">
                <li class={Astro.url.pathname === getUrl('/docs/pagos/resumen') || Astro.url.pathname === getUrl('/docs/pagos/resumen/') ? 'active' : ''}><a href={getUrl('/docs/pagos/resumen')}>{lang === 'es' ? 'Resumen' : 'Overview'}</a></li>
                <li class={Astro.url.pathname.includes(getUrl('/docs/pagos/aceptar')) ? 'active' : ''}><a href={getUrl('/docs/pagos/aceptar')}>{lang === 'es' ? 'Aceptar un pago' : 'Accept a payment'}</a></li>
              </ul>

              <div class="sidebar-section">
                <p class="sidebar-heading">{lang === 'es' ? 'PAGOS EN COTIZACIONES' : 'PAYMENTS IN QUOTES'}</p>
