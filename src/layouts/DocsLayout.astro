  </div>

  <!-- Search Modal -->
  <div id="search-modal" class="search-modal hidden" role="dialog" aria-modal="true" aria-label={lang === 'es' ? 'Buscar en la documentación' : 'Search documentation'}>
    <div class="search-modal-backdrop" id="search-backdrop"></div>
    <div class="search-modal-content">
      <div class="search-modal-header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" id="search-input-field" placeholder={lang === 'es' ? 'Buscar en la documentación...' : 'Search documentation...'} autocomplete="off" spellcheck="false" />
        <button id="search-close" class="search-close-btn" aria-label={lang === 'es' ? 'Cerrar búsqueda' : 'Close search'}>ESC</button>
      </div>
      <div class="search-modal-body">
        <div class="search-results-empty">
          <p>{lang === 'es' ? 'Escribe algo para buscar en guías, referencias de API y más.' : 'Type to search guides, API references, and more.'}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Dropdown Logic
  const dropdownToggles = document.querySelectorAll('.sidebar-dropdown-toggle');
  dropdownToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const parent = toggle.parentElement;
      parent.classList.toggle('open');
    });
  });

  
  // Search Modal Logic with Fuse.js
  import Fuse from 'fuse.js';
  import { escapeHtml } from '../lib/escape';
  
  const trigger = document.getElementById('search-trigger');
  const modal = document.getElementById('search-modal');
  const backdrop = document.getElementById('search-backdrop');
  const closeBtn = document.getElementById('search-close');
  const input = document.getElementById('search-input-field');
  const resultsContainer = document.querySelector('.search-modal-body');
  
  let fuse = null;
  let searchData = [];
  let isFetching = false;
  let searchAnalyticsTimer = null;
  let lastTrackedSearch = '';

  function trackDocsEvent(event, properties = {}) {
    (window as any).cordTrack?.(event, {
      page_path: window.location.pathname,
      language: document.documentElement.lang || 'es',
      ...properties
    });
  }

  // Search can contain contact or account data. Keep the useful intent while
  // removing common direct identifiers before it reaches analytics.
  function analyticsSafeQuery(query) {
    return query
      .trim()
      .replace(/\s+/g, ' ')
      .replace(/[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}/g, '[email]')
      .replace(/\b\d{6,}\b/g, '[number]')
      .slice(0, 120);
  }

  function scheduleSearchAnalytics(query, resultCount) {
    const safeQuery = analyticsSafeQuery(query);
    if (safeQuery.length < 2) return;

    if (searchAnalyticsTimer) window.clearTimeout(searchAnalyticsTimer);
    searchAnalyticsTimer = window.setTimeout(() => {
      const searchKey = `${safeQuery.toLocaleLowerCase()}:${resultCount}`;
      if (searchKey === lastTrackedSearch) return;
      lastTrackedSearch = searchKey;

      const properties = {
        query: safeQuery,
        query_length: safeQuery.length,
        results_count: resultCount
      };
      trackDocsEvent('docs_search_performed', properties);
      if (resultCount === 0) trackDocsEvent('docs_search_zero_results', properties);
    }, 700);
  }

  async function fetchSearchData() {
    if (fuse || isFetching) return;
    isFetching = true;
    try {
      // Show loading state
      if (resultsContainer) {
        resultsContainer.innerHTML = `<div class="search-results-empty"><p>${document.documentElement.lang === 'en' ? 'Loading search index...' : 'Cargando índice de búsqueda...'}</p></div>`;
      }
      const res = await fetch('/api/docs-search.json');
      if (!res.ok) throw new Error(`Search index returned ${res.status}`);
      searchData = await res.json();
      
      // Filter by current language
      const currentLang = document.documentElement.lang || 'es';
      searchData = searchData.filter(doc => doc.lang === currentLang);

      fuse = new Fuse(searchData, {
        keys: [
          { name: 'title', weight: 0.7 },
          { name: 'description', weight: 0.3 },
          { name: 'body', weight: 0.5 }
        ],
        includeMatches: true,
        threshold: 0.3,
        ignoreLocation: true
      });
      
      // Trigger search if user already typed something
      if (input.value.trim() !== '') {
        performSearch(input.value);
      } else {
        showEmptyState();
      }
    } catch (err) {
      console.error('Failed to load search data:', err);
      if (resultsContainer) {
        resultsContainer.innerHTML = `<div class="search-results-empty"><p>${document.documentElement.lang === 'en' ? 'Failed to load search.' : 'Error al cargar búsqueda.'}</p></div>`;
      }
    }
  }

  function showEmptyState() {
    if (resultsContainer) {
      resultsContainer.innerHTML = `<div class="search-results-empty"><p>${document.documentElement.lang === 'en' ? 'Type to search guides, API references, and more.' : 'Escribe algo para buscar en guías, referencias de API y más.'}</p></div>`;
    }
  }

  function performSearch(query) {
    if (!fuse) return;
    if (!query || query.trim() === '') {
      showEmptyState();
      return;
    }
    
    const results = fuse.search(query).slice(0, 8); // Top 8 results
    scheduleSearchAnalytics(query, results.length);
    
    if (results.length === 0) {
      resultsContainer.innerHTML = `<div class="search-results-empty"><p>${document.documentElement.lang === 'en' ? 'No results found for' : 'No se encontraron resultados para'} "${escapeHtml(query)}"</p></div>`;
      return;
    }

    let html = '<ul class="search-results-list">';
    results.forEach(({ item }, index) => {
      html += `
        <li class="search-result-item">
          <a href="${item.url}" data-search-position="${index + 1}">
            <span class="search-result-title">${escapeHtml(item.title)}</span>
            ${item.description ? `<span class="search-result-desc">${escapeHtml(item.description)}</span>` : ''}
          </a>
        </li>
      `;
    });
    html += '</ul>';
    
    resultsContainer.innerHTML = html;
  }

  function openSearch(source = 'button') {
    modal.classList.remove('hidden');
    input.focus();
    document.body.style.overflow = 'hidden';
    trackDocsEvent('docs_search_opened', { source });
    fetchSearchData(); // Fetch JSON dynamically on first open
  }

  function closeSearch() {
    modal.classList.add('hidden');
    input.value = '';
    if (searchAnalyticsTimer) window.clearTimeout(searchAnalyticsTimer);
    showEmptyState();
    document.body.style.overflow = '';
  }

  if (trigger) trigger.addEventListener('click', () => openSearch('button'));
  if (backdrop) backdrop.addEventListener('click', closeSearch);
  if (closeBtn) closeBtn.addEventListener('click', closeSearch);

  if (input) {
    input.addEventListener('input', (e) => {
      performSearch(e.target.value);
    });
  }

  if (resultsContainer) {
    resultsContainer.addEventListener('click', (event) => {
      const link = event.target.closest('a[data-search-position]');
      if (!link) return;
      trackDocsEvent('docs_search_result_clicked', {
        query: analyticsSafeQuery(input?.value || ''),
        result_path: new URL(link.href, window.location.origin).pathname,
        result_position: Number(link.dataset.searchPosition)
      });
    });
  }

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const isEditing = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target?.isContentEditable;
    if (event.key === '/' && !isEditing && modal?.classList.contains('hidden')) {
      event.preventDefault();
      openSearch('keyboard_shortcut');
    } else if (event.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeSearch();
      trigger?.focus();
    }
  });

// Feedback Logic
  const btnYes = document.getElementById('feedback-yes');
  const btnNo = document.getElementById('feedback-no');
  const thanksMsg = document.getElementById('feedback-thanks');

  const feedbackStorageKey = `cord_docs_feedback:${window.location.pathname}`;

  function renderFeedback(response) {
    const clickedBtn = response === 'yes' ? btnYes : btnNo;
    const otherBtn = response === 'yes' ? btnNo : btnYes;
    if (!clickedBtn || !otherBtn || !thanksMsg) return;

    clickedBtn.classList.add('active');
    clickedBtn.setAttribute('aria-pressed', 'true');
    clickedBtn.classList.add('disabled');
    otherBtn.classList.add('disabled');
    clickedBtn.disabled = true;
    otherBtn.disabled = true;
    thanksMsg.style.display = 'inline-block';
  }

  function handleFeedbackClick(response) {
    renderFeedback(response);
    try {
      window.localStorage.setItem(feedbackStorageKey, response);
    } catch {
      // Feedback still works if storage is unavailable.
    }
    trackDocsEvent('docs_feedback_submitted', { helpful: response === 'yes' });
  }

  if (btnYes) {
    btnYes.addEventListener('click', () => handleFeedbackClick('yes'));
  }
  if (btnNo) {
    btnNo.addEventListener('click', () => handleFeedbackClick('no'));
  }

  try {
    const savedFeedback = window.localStorage.getItem(feedbackStorageKey);
    if (savedFeedback === 'yes' || savedFeedback === 'no') renderFeedback(savedFeedback);
  } catch {
    // Ignore unavailable storage.
  }

  // Mobile Menu Logic
  const menuTrigger = document.getElementById('mobile-menu-trigger');
  const menuClose = document.getElementById('mobile-menu-close');
  const sidebar = document.getElementById('docs-sidebar');
  const sidebarBackdrop = document.getElementById('mobile-sidebar-backdrop');

  function openMobileMenu() {
    if(sidebar) sidebar.classList.add('open');
    if(sidebarBackdrop) sidebarBackdrop.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    if(sidebar) sidebar.classList.remove('open');
    if(sidebarBackdrop) sidebarBackdrop.classList.add('hidden');
    document.body.style.overflow = '';
  }

  if(menuTrigger) menuTrigger.addEventListener('click', openMobileMenu);
  if(menuClose) menuClose.addEventListener('click', closeMobileMenu);
  if(sidebarBackdrop) sidebarBackdrop.addEventListener('click', closeMobileMenu);

</script>

