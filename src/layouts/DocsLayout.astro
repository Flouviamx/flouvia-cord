<script>
  import { iconSvg } from '../lib/icons';

  const isEn = document.documentElement.lang === 'en';
  const tr = (es: string, en: string) => (isEn ? en : es);
  const article = document.querySelector<HTMLElement>('.docs-main .content-container');

  // Una sola región viva para "Copiado": el lector de pantalla oye el cambio
  // aunque el botón no cambie de nombre accesible.
  const liveRegion = document.createElement('span');
  liveRegion.className = 'docs-sr-only';
  liveRegion.setAttribute('role', 'status');
  liveRegion.setAttribute('aria-live', 'polite');
  document.body.append(liveRegion);
  const announce = (message: string) => {
    liveRegion.textContent = '';
    window.setTimeout(() => { liveRegion.textContent = message; }, 50);
  };

  // --- Bloques de código: barra con lenguaje y botón de copiar ---------------
  const LANG_LABELS: Record<string, string> = {
    js: 'JavaScript', javascript: 'JavaScript', mjs: 'JavaScript', jsx: 'JSX',
    ts: 'TypeScript', typescript: 'TypeScript', tsx: 'TSX',
    json: 'JSON', jsonc: 'JSON', bash: 'Bash', sh: 'Shell', shell: 'Shell', zsh: 'Shell', console: 'Terminal',
    html: 'HTML', xml: 'XML', css: 'CSS', python: 'Python', py: 'Python', php: 'PHP', ruby: 'Ruby',
    go: 'Go', java: 'Java', yaml: 'YAML', yml: 'YAML', toml: 'TOML', sql: 'SQL', http: 'HTTP',
    diff: 'Diff', md: 'Markdown', mdx: 'MDX', vue: 'Vue', astro: 'Astro', graphql: 'GraphQL', env: '.env', dotenv: '.env',
  };
  const PLAIN = new Set(['', 'plaintext', 'text', 'txt', 'plain']);
  const copyIcon = iconSvg('copy', 'docs-code-copy-icon', 1.5, 14);
  const doneIcon = iconSvg('check', 'docs-code-copy-icon', 1.5, 14);

  function codeText(pre: HTMLElement) {
    return (pre.querySelector('code') || pre).textContent?.replace(/\n$/, '') || '';
  }

  function decorateCode(pre: HTMLPreElement) {
    if (pre.parentElement?.classList.contains('docs-code')) return;
    const lang = (pre.dataset.language || '').toLowerCase();
    const wrap = document.createElement('div');
    wrap.className = 'docs-code';
    const bar = document.createElement('div');
    bar.className = 'docs-code-bar';
    bar.dataset.copyIgnore = '';

    const chip = document.createElement('span');
    chip.className = 'docs-code-lang';
    chip.textContent = PLAIN.has(lang) ? '' : LANG_LABELS[lang] || lang.toUpperCase();
    bar.append(chip);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'docs-code-copy';
    const label = tr('Copiar', 'Copy');
    button.setAttribute('aria-label', chip.textContent ? tr(`Copiar código ${chip.textContent}`, `Copy ${chip.textContent} code`) : tr('Copiar código', 'Copy code'));
    button.innerHTML = `${copyIcon}<span class="docs-code-copy-text">${label}</span>`;
    let timer = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeText(pre));
        button.classList.add('is-done');
        button.innerHTML = `${doneIcon}<span class="docs-code-copy-text">${tr('Copiado', 'Copied')}</span>`;
        announce(tr('Código copiado', 'Code copied'));
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.classList.remove('is-done');
          button.innerHTML = `${copyIcon}<span class="docs-code-copy-text">${label}</span>`;
        }, 1800);
      } catch {
        announce(tr('No se pudo copiar', 'Could not copy'));
      }
    });
    bar.append(button);

    pre.before(wrap);
    wrap.append(bar, pre);
  }

  // --- Tablas: contenedor desplazable que conserva la semántica de <table> --
  const tableWraps: HTMLElement[] = [];
  function decorateTable(table: HTMLTableElement) {
    if (table.parentElement?.classList.contains('docs-table')) return;
    const wrap = document.createElement('div');
    wrap.className = 'docs-table';
    const cols = Math.max(1, ...Array.from(table.rows).map((row) => row.cells.length));
    wrap.style.setProperty('--docs-table-cols', String(cols));
    // Primera columna "clave" (nombres cortos): no se parte en escritorio.
    const firstCells = Array.from(table.rows).map((row) => row.cells[0]?.textContent?.trim() || '');
    if (cols > 1 && firstCells.every((text) => text.length <= 30)) wrap.classList.add('docs-table--key');
    table.before(wrap);
    wrap.append(table);
    tableWraps.push(wrap);
  }

  function syncScrollableTables() {
    tableWraps.forEach((wrap) => {
      const scrollable = wrap.scrollWidth > wrap.clientWidth + 1;
      wrap.classList.toggle('is-scrollable', scrollable);
      if (scrollable) {
        wrap.tabIndex = 0;
        wrap.setAttribute('role', 'region');
        wrap.setAttribute('aria-label', tr('Tabla desplazable', 'Scrollable table'));
      } else {
        wrap.removeAttribute('tabindex');
        wrap.removeAttribute('role');
        wrap.removeAttribute('aria-label');
      }
    });
  }

  if (article) {
    article.querySelectorAll<HTMLPreElement>('pre').forEach(decorateCode);
    article.querySelectorAll<HTMLTableElement>('table').forEach(decorateTable);
    syncScrollableTables();
    window.addEventListener('resize', () => window.requestAnimationFrame(syncScrollableTables), { passive: true });

    // La decoración agrega alto por encima del ancla: si la página abrió con
    // #hash, se vuelve a alinear (scroll-margin-top deja el h2 bajo el header).
    if (location.hash.length > 1 && window.scrollY > 0) {
      let target: HTMLElement | null = null;
      try { target = document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch { target = null; }
      target?.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
    }
  }

  // --- Copiar para IA: Markdown con estructura, no innerText aplanado --------
  const SKIP = [
    '.docs-copy-ai', '#docsCopyAiStatus', '.docs-footer', '.doc-metadata', '.docs-code-bar', '[data-copy-ignore]',
    '.dn-crumbs', '.dn-pager', 'nav', 'script', 'style', 'template', 'button', 'svg', '.docs-sr-only', '[aria-hidden="true"]', '[role="tablist"]',
  ].join(',');
  const BLOCK_TAGS = new Set([
    'P', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'UL', 'OL', 'PRE', 'TABLE', 'BLOCKQUOTE', 'HR', 'DIV', 'SECTION',
    'HEADER', 'FOOTER', 'ARTICLE', 'ASIDE', 'FIGURE', 'FIGCAPTION', 'DL', 'DETAILS', 'SUMMARY', 'CORD-TABS', 'MAIN', 'FORM',
  ]);
  // Los enlaces se resuelven contra la URL canónica (docs.cordhq.app), no
  // contra el host desde el que se abrió la página (preview, localhost).
  const canonicalUrl = () => document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href || location.href;
  const absUrl = (href: string) => {
    if (href.startsWith('#')) return `${canonicalUrl().split('#')[0]}${href}`;
    try { return new URL(href, canonicalUrl()).href; } catch { return href; }
  };
  const isBlock = (el: Element): boolean => BLOCK_TAGS.has(el.tagName) || Array.from(el.children).some((child) => !child.matches(SKIP) && isBlock(child));

  function inline(node: Node): string {
    if (node.nodeType === Node.TEXT_NODE) return (node.textContent || '').replace(/\s+/g, ' ');
    if (node.nodeType !== Node.ELEMENT_NODE) return '';
    const el = node as HTMLElement;
    if (el.matches(SKIP)) return '';
    const inner = () => Array.from(el.childNodes).map(inline).join('');
    switch (el.tagName) {
      case 'BR': return '\n';
      case 'STRONG': case 'B': { const t = inner().trim(); return t ? `**${t}**` : ''; }
      case 'EM': case 'I': { const t = inner().trim(); return t ? `_${t}_` : ''; }
      case 'CODE': case 'KBD': return `\`${(el.textContent || '').replace(/\s+/g, ' ')}\``;
      case 'IMG': { const img = el as HTMLImageElement; return img.alt ? `![${img.alt}](${absUrl(img.getAttribute('src') || '')})` : ''; }
      case 'A': {
        const t = inner().trim();
        const href = el.getAttribute('href');
        return href && t ? `[${t}](${absUrl(href)})` : t;
      }
      default: {
        // Piezas en línea separadas sólo por CSS (flex/gap) necesitan su espacio.
        const display = getComputedStyle(el).display;
        return /flex|inline-block|grid/.test(display) ? ` ${inner()} ` : inner();
      }
    }
  }

  function cellText(cell: HTMLTableCellElement) {
    return Array.from(cell.childNodes).map(inline).join('').replace(/\s*\n\s*/g, ' ').replace(/\|/g, '\\|').trim();
  }

  function table(el: HTMLTableElement) {
    const rows = Array.from(el.rows).map((row) => Array.from(row.cells).map(cellText));
    if (!rows.length) return '';
    const width = Math.max(...rows.map((row) => row.length));
    const line = (cells: string[]) => `| ${Array.from({ length: width }, (_, i) => cells[i] ?? '').join(' | ')} |`;
    const hasHead = Boolean(el.tHead) || Array.from(el.rows[0].cells).every((cell) => cell.tagName === 'TH');
    const head = hasHead ? rows[0] : Array.from({ length: width }, () => '');
    const body = hasHead ? rows.slice(1) : rows;
    return [line(head), line(Array.from({ length: width }, () => '---')), ...body.map(line)].join('\n');
  }

  function list(el: HTMLElement) {
    const ordered = el.tagName === 'OL';
    let n = Number(el.getAttribute('start') || 1);
    return Array.from(el.children)
      .filter((child) => child.tagName === 'LI')
      .map((li) => {
        const marker = ordered ? `${n++}.` : '-';
        const content = blocks(li as HTMLElement).join('\n');
        const pad = ' '.repeat(marker.length + 1);
        return `${marker} ${content.split('\n').map((l, i) => (i === 0 ? l : l ? pad + l : l)).join('\n')}`;
      })
      .join('\n');
  }

  function quote(text: string) {
    return text.split('\n').map((l) => (l ? `> ${l}` : '>')).join('\n');
  }

  function block(el: HTMLElement): string[] {
    if (el.matches(SKIP)) return [];
    const tag = el.tagName;
    if (/^H[1-6]$/.test(tag)) {
      const text = Array.from(el.childNodes).map(inline).join('').replace(/\s+/g, ' ').trim();
      return text ? [`${'#'.repeat(Number(tag[1]))} ${text}`] : [];
    }
    if (tag === 'P') { const t = Array.from(el.childNodes).map(inline).join('').replace(/ {2,}/g, ' ').trim(); return t ? [t] : []; }
    if (tag === 'UL' || tag === 'OL') return [list(el)];
    if (tag === 'PRE') {
      const lang = (el.dataset.language || '').toLowerCase();
      return [`\`\`\`${PLAIN.has(lang) ? '' : lang}\n${codeText(el)}\n\`\`\``];
    }
    if (tag === 'TABLE') return [table(el as HTMLTableElement)];
    if (tag === 'HR') return ['---'];
    if (tag === 'BLOCKQUOTE') return [quote(blocks(el).join('\n\n'))];
    if (el.classList.contains('callout')) {
      const type = el.className.match(/callout-(info|warning|success)/)?.[1] || 'info';
      const fallback = { info: tr('Nota', 'Note'), warning: tr('Importante', 'Important'), success: tr('Listo', 'Done') }[type];
      const title = el.querySelector('.callout-title')?.textContent?.trim() || fallback;
      const body = el.querySelector<HTMLElement>('.callout-body');
      return [quote([`**${title}**`, ...(body ? blocks(body) : [])].join('\n\n'))];
    }
    if (tag === 'CORD-TABS') {
      return Array.from(el.querySelectorAll<HTMLElement>(':scope > .tabs-panels > .tab-panel')).flatMap((panel) => [
        `**${panel.dataset.label || ''}**`,
        ...blocks(panel),
      ]);
    }
    if (tag === 'DL') {
      return Array.from(el.querySelectorAll('dt')).map((dt) => {
        const dd = dt.nextElementSibling?.tagName === 'DD' ? dt.nextElementSibling : null;
        return `**${(dt.textContent || '').trim()}**: ${dd ? Array.from(dd.childNodes).map(inline).join('').trim() : ''}`;
      });
    }
    if (tag === 'A' && isBlock(el)) {
      const inner = blocks(el);
      const href = absUrl(el.getAttribute('href') || '');
      if (inner[0]?.startsWith('#')) inner[0] = inner[0].replace(/^(#+) (.*)$/, `$1 [$2](${href})`);
      else inner.push(`[${tr('Abrir', 'Open')}](${href})`);
      return inner;
    }
    return blocks(el);
  }

  // Recorre hijos mezclando texto suelto (párrafo) con bloques.
  function blocks(container: HTMLElement): string[] {
    const out: string[] = [];
    let buffer = '';
    const flush = () => {
      const text = buffer.replace(/[ \t]+\n/g, '\n').replace(/ {2,}/g, ' ').trim();
      if (text) out.push(text);
      buffer = '';
    };
    container.childNodes.forEach((node) => {
      if (node.nodeType === Node.ELEMENT_NODE) {
        const el = node as HTMLElement;
        if (el.matches(SKIP)) return;
        if (isBlock(el) || el.tagName === 'PRE' || el.tagName === 'TABLE' || el.classList.contains('docs-code') || el.classList.contains('docs-table')) {
          flush();
          out.push(...block(el).filter(Boolean));
          return;
        }
      }
      buffer += inline(node);
    });
    flush();
    return out;
  }

  function pageMarkdown(container: HTMLElement) {
    const canonical = canonicalUrl();
    const body = blocks(container).join('\n\n').replace(/\n{3,}/g, '\n\n').trim();
    return `${body}\n\n---\n${tr('Fuente', 'Source')}: ${canonical}\n`;
  }

  const copyAi = document.getElementById('docsCopyAi');
  const copyAiStatus = document.getElementById('docsCopyAiStatus');
  const copyAiLabel = copyAi?.querySelector<HTMLElement>('.docs-copy-ai-label');
  let copyAiTimer = 0;
  copyAi?.addEventListener('click', async () => {
    if (!article || !copyAiLabel) return;
    const original = copyAiLabel.dataset.label || copyAiLabel.textContent || '';
    copyAiLabel.dataset.label = original;
    try {
      await navigator.clipboard.writeText(pageMarkdown(article));
      copyAi.classList.add('is-done');
      copyAiLabel.textContent = copyAi.dataset.done || original;
      if (copyAiStatus) copyAiStatus.textContent = tr('Página copiada en Markdown', 'Page copied as Markdown');
    } catch {
      copyAiLabel.textContent = copyAi.dataset.failed || original;
      if (copyAiStatus) copyAiStatus.textContent = copyAi.dataset.failed || '';
    }
    window.clearTimeout(copyAiTimer);
    copyAiTimer = window.setTimeout(() => {
      copyAi.classList.remove('is-done');
      copyAiLabel.textContent = original;
      if (copyAiStatus) copyAiStatus.textContent = '';
    }, 1800);
  });
</script>
