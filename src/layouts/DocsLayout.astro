          <div class="docs-footer">
            <div class="feedback-section" role="group" aria-labelledby="feedback-question">
              <span class="feedback-title" id="feedback-question">{lang === 'es' ? '¿Te ha sido útil la página?' : 'Was this page helpful?'}</span>
              <button class="feedback-btn" id="feedback-yes" aria-pressed="false"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg> {lang === 'es' ? 'Sí' : 'Yes'}</button>
              <button class="feedback-btn" id="feedback-no" aria-pressed="false"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3"></path></svg> {lang === 'es' ? 'No' : 'No'}</button>
              <span class="feedback-thanks" id="feedback-thanks" style="display: none;">{lang === 'es' ? '¡Gracias por tus comentarios!' : 'Thanks for your feedback!'}</span>
            </div>
            
            <hr class="footer-divider" />
            
            <ul class="footer-links">
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><line x1="21.17" y1="8" x2="12" y2="8"></line><line x1="3.95" y1="6.06" x2="8.54" y2="14"></line><line x1="10.88" y1="21.94" x2="15.46" y2="14"></line></svg>
                {lang === 'es' ? '¿Necesitas ayuda? ' : 'Need help? '}
                <a href={lang === 'es' ? 'https://cordhq.app/soporte' : 'https://cordhq.app/en/support'}>{lang === 'es' ? 'Consulta el Centro de soporte' : 'Visit the Support Center'}</a>
              </li>
