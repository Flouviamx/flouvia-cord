      radial-gradient(farthest-side at 0 50%, rgba(0, 0, 0, 0.1), transparent) left / 14px 100% no-repeat scroll,
      radial-gradient(farthest-side at 100% 50%, rgba(0, 0, 0, 0.1), transparent) right / 14px 100% no-repeat scroll,
      var(--docs-surface);
