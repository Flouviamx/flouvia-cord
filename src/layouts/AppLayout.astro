    .qtask-date { flex: 0 0 auto; font-family: var(--font-sans); font-size: 0.85rem; color: var(--color-text); background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: 10px; padding: 10px 12px; }
    .qtask-btn { flex: 1; font-family: var(--font-sans); font-size: 0.86rem; font-weight: 600; color: #fff; background: var(--color-blue-deep); border: none; border-radius: 10px; padding: 10px 16px; cursor: pointer; transition: transform 0.3s var(--ease-spring), box-shadow 0.3s var(--ease-spring); box-shadow: 0 6px 18px -8px rgba(10,25,47,0.5); }
    .qtask-btn:hover { transform: translateY(-1px); box-shadow: 0 10px 24px -8px rgba(10,25,47,0.55); }
    @media (max-width: 560px) { .qtask-row { flex-direction: column; } .qtask-date { width: 100%; } }

    /* ── MOBILE ── */
    @media (max-width: 880px) {
        .tb-burger { display: inline-flex; }
        .app-content {
            padding: 1rem 1rem 2rem;
            padding-left: max(1rem, env(safe-area-inset-left));
            padding-right: max(1rem, env(safe-area-inset-right));
            padding-bottom: calc(2rem + env(safe-area-inset-bottom));
        }
        /* La pill flotante respeta el notch (se mantiene sticky por debajo de él). */
        .topbar {
            margin: calc(0.6rem + env(safe-area-inset-top)) 0.6rem 0;
            padding: 0.45rem 0.6rem; border-radius: 14px;
        }
        .topbar { top: calc(0.6rem + env(safe-area-inset-top)); }
        .page-head { padding: 1.1rem 1rem 0; }
        .ph-title { font-size: 1.35rem; }
        .ph-actions { width: 100%; }
        .tb-demo { display: none; }
        /* La barra de búsqueda se reduce a un ícono de lupa (estilo Stripe móvil) */
        .tb-search {
            flex: 0 0 auto; width: 36px; height: 36px; padding: 0; gap: 0;
            justify-content: center; border: none; background: transparent; border-radius: 9px;
        }
        .tb-search:hover { background: var(--color-bg-soft); box-shadow: none; }
        .tb-search svg { width: 18px; height: 18px; }
        .tb-search-label, .tb-kbd { display: none; }
        /* Topbar móvil = lupa, guía (solo el anillo), crear, apps y notificaciones.
           Engrane, ayuda y tema viven en el drawer. */
        .tb-notif-wrap { display: inline-flex; }
        .tb-gear, .tb-help, .tb-theme { display: none; }
        .tb-create {
            width: 36px; height: 36px; border-radius: 50%; padding: 0; justify-content: center;
        }
        .tb-create span, .tb-create-caret { display: none; }
        /* La guía minimizada vive en esta píldora: ocultarla en móvil dejaba la guía
           inalcanzable. Se queda solo el anillo de progreso. */
        .onb-pill { padding: 3px; gap: 0; }
        .onb-pill-label { display: none; }
        /* El panel de notificaciones a ancho casi completo */
        .notif-panel { width: min(340px, calc(100vw - 1.5rem)); }
        .ph-pin { display: none; }
        /* Sin teclado físico no hay atajos que enseñar (regla 16). */
        .cmdk-kbd { display: none; }
    }
</style>

<script is:inline define:vars={{ RT }}>
    // Serializa el runtime de i18n ya resuelto en el idioma del request a un
    // global — el <script> grande de abajo NO es is:inline (usa TS) y por lo
    // tanto no puede leer `t()`/frontmatter directamente en tiempo de ejecución.
    window.CORD_I18N = RT;
</script>

<script>
    import { iconInner, iconSvg } from '../lib/icons';
    import { normalizeText, tokenize, scoreDoc } from '../lib/help-search';
    import { wireTopbarMenu } from '../lib/topbar-menu';
    const mobileUi = () => window.matchMedia('(max-width: 880px)').matches;
    const escAttr = (s: string) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

    // ── Salir del entorno de prueba (banner ámbar) ──
    // Limpia la cookie (fuente de verdad server-side) + el espejo en localStorage
    // y regresa al dashboard real.
    document.getElementById('testEnvExit')?.addEventListener('click', () => {
        document.cookie = 'cord_test_mode=; path=/; max-age=0; SameSite=Lax';
        try { localStorage.setItem('cord_test_mode', 'false'); } catch {}
        window.location.assign('/app');
    });

    // Vaciar datos de prueba (tipo Stripe "delete all test data"): borra la org
    // sandbox por completo; se recrea fresca + reseed al recargar.
    document.getElementById('testEnvReset')?.addEventListener('click', async () => {
        const I18N = (window as any).CORD_I18N || {};
        const cc = (window as any).cordConfirm;
        const ok = cc ? await cc({
            ...(I18N.testResetConfirm || { title: 'Vaciar datos de prueba', body: '', confirmText: 'Vaciar todo' }),
            danger: true,
        }) : true;
        if (!ok) return;
        try {
            const res = await fetch('/api/test-mode/reset', { method: 'POST' });
            if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || I18N.testResetErr || 'No se pudo vaciar'); }
            try { sessionStorage.setItem('cord.flash', JSON.stringify({ msg: I18N.testResetOk || 'Datos de prueba vaciados', type: 'ok' })); } catch {}
            window.location.assign('/app');
        } catch (e: any) {
            (window as any).cordToast?.(e.message || I18N.testResetErr || 'No se pudo vaciar los datos de prueba', 'error');
        }
    });

    // ── Menú de comandos (Cmd+K) ── buscador global + navegación rápida.
    function initCmdk() {
        const cmdk = document.getElementById('cmdk');
        const input = document.getElementById('cmdkInput') as HTMLInputElement | null;
        const results = document.getElementById('cmdkResults');
        if (!cmdk || !input || !results) return;

        const I = {
            dashboard: iconInner('overview'),
            doc: iconInner('document'),
            card: iconInner('card'),
            users: iconInner('clients'),
            box: iconInner('products'),
            chart: iconInner('chart'),
            gear: iconInner('gear'),
            plus: iconInner('plus'),
            receipt: iconInner('invoice'),
            sparkle: iconInner('cpu'),
            check: iconInner('check-circle'),
            external: iconInner('external'),
        };
        const I18N = (window as any).CORD_I18N || {};
        const G = I18N.cmdkGroups || { ir_a: 'Ir a', acciones: 'Acciones', recientes: 'Recientes', cotizaciones: 'Cotizaciones', clientes: 'Clientes', productos: 'Productos' };
        const KEYS: Record<string, string> = I18N.cmdkKeys || {};
        const NAV: any[] = (I18N.cmdkNav || []).map(([title, href, iconKey, hint, keywords]: any) => ({ group: G.ir_a, title, href, icon: (I as any)[iconKey], hint, keywords, kbd: mobileUi() ? undefined : KEYS[href] }));
        const ACTIONS: any[] = (I18N.cmdkActions || []).map((a: any) => ({
            group: G.acciones, title: a.title, href: a.href, icon: (I as any)[a.icon], kbd: mobileUi() ? undefined : a.kbd, hint: a.hint,
            run: a.runKey === 'quickTask' ? () => (window as any).cordQuickTask?.() : undefined,
        }));
        const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
        const esc = (s: string) => String(s).replace(/</g, '&lt;');

        // ── Recientes (localStorage) — se muestran cuando el buscador está vacío ──
        const RECENT_KEY = 'cord.recent.v1';
        const getRecents = (): any[] => { try { return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch { return []; } };
        const pushRecent = (it: any) => {
            if (!it?.href || it.href === '/') return;
            try {
                const r = getRecents().filter((x: any) => x.href !== it.href);
                r.unshift({ title: it.title, href: it.href, icon: it.icon });
                localStorage.setItem(RECENT_KEY, JSON.stringify(r.slice(0, 5)));
            } catch {}
        };

        let items: any[] = []; let sel = 0; let seq = 0;

        const staticMatches = (q: string) => {
            const all = [...NAV, ...ACTIONS];
            if (!q.trim()) return all;
            const nq = norm(q);
            // Empata contra el título Y los sinónimos (`keywords` de
            // settings.ts): "IVA", "VAT", "NIF" o "CSD" no son el nombre de
            // ninguna pestaña, pero son lo que la gente teclea. El hint sigue
            // fuera a propósito — es texto de apoyo, no vocabulario de búsqueda.
            //
            // Los sinónimos empatan por PRINCIPIO DE PALABRA, no por substring:
            // "iva" dentro de "privacidad" haría que buscar el impuesto más
            // común de México devolviera "Datos y privacidad". Una consulta con
            // espacios ("sales tax") sí va por substring, porque ahí partir en
            // palabras rompería la frase.
            const kwHit = (kw: string) => {
                if (!kw) return false;
                const n = norm(kw);
                return nq.includes(' ') ? n.includes(nq) : n.split(/\s+/).some((w: string) => w.startsWith(nq));
            };
            return all.filter((c) => norm(c.title).includes(nq) || kwHit(c.keywords));
        };
        const buildItems = (q: string, ent: any) => {
            const list: any[] = [];
            if (!q.trim()) {
                getRecents().forEach((r: any) => list.push({ group: G.recientes, title: r.title, href: r.href, icon: r.icon || I.doc }));
            }
            if (ent) {
                (ent.cotizaciones || []).forEach((c: any) => list.push({ group: G.cotizaciones, title: `${c.folio} · ${c.cliente}`, sub: c.sub, href: `/app/cotizaciones/${encodeURIComponent(c.id)}`, icon: I.doc }));
                (ent.facturas || []).forEach((d: any) => list.push({ group: G.facturas || 'Facturas', title: `${d.folio} · ${d.cliente}`, sub: d.sub, href: `/app/facturas/${encodeURIComponent(d.id)}`, icon: I.receipt }));
                (ent.clientes || []).forEach((c: any) => list.push({ group: G.clientes, title: c.empresa, href: `/app/clientes/${encodeURIComponent(c.id)}`, icon: I.users }));
                (ent.productos || []).forEach((p: any) => list.push({ group: G.productos, title: p.sku ? `${p.nombre} · ${p.sku}` : p.nombre, href: `/app/productos/${encodeURIComponent(p.id)}`, icon: I.box }));
            }
            staticMatches(q).forEach((c) => list.push(c));
            return list;
        };
        const paint = (q = '') => {
            if (!items.length) {
                input.removeAttribute('aria-activedescendant');
                const noResults = (I18N.cmdkSinResultados || 'Sin resultados para “{q}”').replace('{q}', esc(q));
                const hint = I18N.cmdkSugerencia || 'Prueba con un folio, cliente, producto o sección.';
                results.innerHTML = `<div class="cmdk-empty">${iconSvg('search')}<p>${noResults}</p><span>${hint}</span></div>`;
                return;
            }
            let html = ''; let last = '';
            items.forEach((it, i) => {
                if (it.group !== last) { html += `<div class="cmdk-group-label">${it.group}</div>`; last = it.group; }
                const right = it.kbd ? `<kbd class="cmdk-kbd">${esc(it.kbd)}</kbd>`
                    : it.hint ? `<span class="cmdk-hint">${esc(it.hint)}</span>`
                    : it.sub ? `<span class="cmdk-hint">${esc(it.sub)}</span>` : '';
                html += `<button type="button" tabindex="-1" role="option" id="cmdkOpt${i}" aria-selected="${i === sel}" class="cmdk-item ${i === sel ? 'sel' : ''}" data-i="${i}"><span class="cmdk-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${it.icon}</svg></span><span class="cmdk-item-body"><span class="cmdk-item-title">${esc(it.title)}</span></span>${right}</button>`;
            });
            results.innerHTML = html;
            input.setAttribute('aria-activedescendant', `cmdkOpt${sel}`);
            results.querySelector('.cmdk-item.sel')?.scrollIntoView({ block: 'nearest' });
        };
        // Mover la selección sin redibujar la lista. Redibujar en cada mousemove
        // re-creaba todos los botones y desplazaba la lista sola cerca del borde.
        const select = (i: number, scroll: boolean) => {
            if (!items.length) return;
            const next = Math.max(0, Math.min(i, items.length - 1));
            results.querySelector('.cmdk-item.sel')?.classList.remove('sel');
            results.querySelector('[aria-selected="true"]')?.setAttribute('aria-selected', 'false');
            sel = next;
            const el = document.getElementById(`cmdkOpt${sel}`);
            el?.classList.add('sel');
            el?.setAttribute('aria-selected', 'true');
            input.setAttribute('aria-activedescendant', `cmdkOpt${sel}`);
            if (scroll) el?.scrollIntoView({ block: 'nearest' });
        };
        // Cada tecla invalida las búsquedas en vuelo (antes solo las de 2+ letras:
        // borrar de "acm" a "a" dejaba que la respuesta de "acm" pintara encima) y
        // la consulta al servidor espera a que se deje de escribir.
        let searchTimer = 0;
        const render = (q: string) => {
            const my = ++seq;
            items = buildItems(q, null); sel = 0; paint(q);
            clearTimeout(searchTimer);
            if (q.trim().length < 2) return;
            searchTimer = window.setTimeout(async () => {
                try {
                    const res = await fetch('/api/search?q=' + encodeURIComponent(q.trim()));
                    const data = await res.json();
                    if (my !== seq) return;
                    items = buildItems(q, data); sel = 0; paint(q);
                } catch { /* sin red: se quedan los resultados locales */ }
            }, 140);
        };
        const activate = (i: number) => {
            const it = items[i];
            if (!it) return;
            if (typeof it.run === 'function') { close(false); it.run(); return; }
            if (it.href) { pushRecent(it); close(false); window.location.href = it.href; }
        };
        // El foco vuelve a donde estaba al cerrar (botón de búsqueda o la página).
        let returnFocus: HTMLElement | null = null;
        const open = () => {
            returnFocus = document.activeElement as HTMLElement | null;
            (cmdk as HTMLElement).hidden = false; document.body.style.overflow = 'hidden';
            input.value = ''; render(''); setTimeout(() => input.focus(), 20);
        };
        const close = (restore = true) => {
            if ((cmdk as HTMLElement).hidden) return;
            (cmdk as HTMLElement).hidden = true; document.body.style.overflow = '';
            clearTimeout(searchTimer); seq++;
            if (restore) returnFocus?.focus?.();
        };

        input.addEventListener('input', () => render(input.value));
        results.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('.cmdk-item') as HTMLElement; if (b) activate(parseInt(b.dataset.i!, 10)); });
        results.addEventListener('mousemove', (e) => { const b = (e.target as HTMLElement).closest('.cmdk-item') as HTMLElement; if (b) { const i = parseInt(b.dataset.i!, 10); if (i !== sel) select(i, false); } });
        // El buscador es lo único enfocable del diálogo: Tab no se escapa a la página de atrás.
        results.addEventListener('mousedown', (e) => e.preventDefault());
        input.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown') { e.preventDefault(); select(sel + 1, true); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); select(sel - 1, true); }
            else if (e.key === 'Home' && e.ctrlKey) { e.preventDefault(); select(0, true); }
            else if (e.key === 'End' && e.ctrlKey) { e.preventDefault(); select(items.length - 1, true); }
            else if (e.key === 'Enter') { e.preventDefault(); activate(sel); }
            else if (e.key === 'Tab') { e.preventDefault(); }
        });

        document.getElementById('cmdkOpen')?.addEventListener('click', open);
        document.getElementById('cmdkBackdrop')?.addEventListener('click', () => close());
        document.addEventListener('keydown', (e) => {
            if (!mobileUi() && (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); (cmdk as HTMLElement).hidden ? open() : close(); }
            else if (e.key === 'Escape' && !(cmdk as HTMLElement).hidden) { close(); }
        });
    }


    // ── Tema claro / oscuro (persistente, sin flash; el <head> lo aplica al cargar) ──
    // Tema en tres modos que se recorren en orden: claro → oscuro → sistema.
    // Dos disparadores: el botón de la topbar (escritorio) y la fila del drawer
    // (móvil; ahí el de la topbar está oculto y antes no había otro).
    // "Sistema" sigue en vivo al sistema operativo (p. ej. el modo noche de macOS).
    function initTheme() {
        const root = document.documentElement;
        const MODES = ['light', 'dark', 'system'] as const;
        type Mode = typeof MODES[number];
        const btns = ['themeBtn', 'sbTheme'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const current = (): Mode => {
            const m = root.getAttribute('data-theme-mode');
            return m === 'dark' || m === 'system' ? m : 'light';
        };
        const apply = (mode: Mode) => {
            root.setAttribute('data-theme-mode', mode);
            const dark = mode === 'dark' || (mode === 'system' && media.matches);
            if (dark) root.setAttribute('data-theme', 'dark'); else root.removeAttribute('data-theme');
            const tb = document.getElementById('themeBtn');
            const name = tb?.dataset[`l${mode[0].toUpperCase()}${mode.slice(1)}` as 'lLight'] || mode;
            const label = `${tb?.dataset.lTema || ''}: ${name}`;
            btns.forEach((b) => { b.setAttribute('aria-label', label); b.setAttribute('title', label); });
        };
        btns.forEach((b) => b.addEventListener('click', () => {
            const next = MODES[(MODES.indexOf(current()) + 1) % MODES.length];
            try { localStorage.setItem('cord.theme', next); } catch (e) {}
            apply(next);
        }));
        media.addEventListener('change', () => { if (current() === 'system') apply('system'); });
        apply(current());
    }

    // ── window.cordWireModal(dlg) — chrome de <dialog class="modal"> (src/styles/modal.css) ──
    // Pinta hairlines en .m-head/.m-foot solo cuando el .m-body de verdad tiene contenido
    // oculto por scroll (no siempre) y resetea el scroll al cerrar. Global en window (no un
    // import) porque lo consumen tanto <script> normales (ClientModal/ProductModal, las
    // listas) como <script is:inline> (el editor de cotizaciones, kits.astro) — mismo patrón
    // que cordToast/cordConfirm de abajo.
    (window as any).cordWireModal = (dlg: HTMLDialogElement) => {
        // .m-body = el esqueleto compartido (src/styles/modal.css); .kmod-body = el
        // esqueleto propio de productos/kits.astro (nomenclatura distinta a propósito,
        // no forma parte del sistema compartido) — mismo fix de scroll, dos prefijos.
        const body = dlg.querySelector<HTMLElement>('.m-body, .kmod-body');
        if (!body) return;
        const sync = () => {
            dlg.dataset.top = body.scrollTop > 2 ? '1' : '0';
            dlg.dataset.bottom = body.scrollHeight - body.scrollTop - body.clientHeight > 2 ? '1' : '0';
        };
        body.addEventListener('scroll', sync, { passive: true });
        new ResizeObserver(sync).observe(body);
        dlg.addEventListener('close', () => { body.scrollTop = 0; });
        sync();
    };

    // ── Toasts globales — window.cordToast(msg, 'ok'|'error'|'info') ──
    function initToasts() {
        const stack = document.getElementById('toastStack');
        if (!stack) return;
        const ICONS: any = {
            ok: iconInner('check'),
            error: iconInner('alert-circle'),
            info: iconInner('info'),
        };
        (window as any).cordToast = (msg: string, type = 'info', ms = 3800) => {
            const t = document.createElement('div');
            t.className = 'toast ' + (type === 'ok' || type === 'error' ? type : '');
            const ico = ICONS[type] || ICONS.info;
            const closeLabel = (window as any).CORD_I18N?.layoutQtaskCerrar || 'Cerrar';
            t.innerHTML = `<svg class="toast-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ico}</svg><span>${String(msg).replace(/</g, '&lt;')}</span><button class="toast-close" aria-label="${closeLabel}">${iconSvg('x', '', 2.2)}</button>`;
            stack.appendChild(t);
            const remove = () => { t.classList.add('out'); setTimeout(() => t.remove(), 250); };
            t.querySelector('.toast-close')?.addEventListener('click', remove);
            const timer = setTimeout(remove, ms);
            t.addEventListener('mouseenter', () => clearTimeout(timer));
            return t;
        };
        // Flash tras navegación: sessionStorage 'cord.flash' = {msg,type}
        try {
            const flash = sessionStorage.getItem('cord.flash');
            if (flash) { sessionStorage.removeItem('cord.flash'); const f = JSON.parse(flash); (window as any).cordToast(f.msg, f.type); }
        } catch (e) {}
    }

    // ── Confirmación global — window.cordConfirm(opts): Promise<boolean> ──
    // Reemplaza confirm() nativo con un modal con estética Cord. Uso:
    //   if (!await cordConfirm({ title, body, danger, confirmText })) return;
    //   cordConfirm('¿Texto simple?')  → también acepta un string.
    function initConfirm() {
        const modal = document.getElementById('cordConfirm');
        if (!modal) return;
        const backdrop = document.getElementById('cconfBackdrop');
        const titleEl = document.getElementById('cconfTitle')!;
        const bodyEl = document.getElementById('cconfBody')!;
        const okBtn = document.getElementById('cconfOk') as HTMLButtonElement;
        const cancelBtn = document.getElementById('cconfCancel') as HTMLButtonElement;

        let resolver: ((v: boolean) => void) | null = null;
        const close = (result: boolean) => {
            if (!resolver) return;
            const r = resolver; resolver = null;
            modal.setAttribute('hidden', '');
            document.removeEventListener('keydown', onKey);
            r(result);
        };
        const onKey = (e: KeyboardEvent) => {
            if (e.key === 'Escape') { e.preventDefault(); close(false); }
            else if (e.key === 'Enter') { e.preventDefault(); close(true); }
        };
        okBtn.addEventListener('click', () => close(true));
        cancelBtn.addEventListener('click', () => close(false));
        backdrop?.addEventListener('click', () => close(false));

        (window as any).cordConfirm = (opts: any): Promise<boolean> => {
            const I18N = (window as any).CORD_I18N || {};
            const o = typeof opts === 'string' ? { body: opts } : (opts || {});
            titleEl.textContent = o.title || I18N.confirmTituloDefault || '¿Estás seguro?';
            bodyEl.textContent = o.body || '';
            bodyEl.style.display = o.body ? '' : 'none';
            okBtn.textContent = o.confirmText || I18N.confirmOk || 'Confirmar';
            cancelBtn.textContent = o.cancelText || I18N.confirmCancel || 'Cancelar';
            modal.classList.toggle('danger', !!o.danger);
            modal.removeAttribute('hidden');
            // Foco en cancelar por defecto (acción no destructiva) para evitar
            // confirmar sin querer al presionar Enter apurado.
            setTimeout(() => (o.danger ? cancelBtn : okBtn).focus(), 20);
            document.addEventListener('keydown', onKey);
            return new Promise<boolean>((resolve) => { resolver = resolve; });
        };
    }

    function initStepUp() {
        const modal = document.getElementById('cordStepUp');
        const form = document.getElementById('stepupForm') as HTMLFormElement | null;
        const input = document.getElementById('stepupCredential') as HTMLInputElement | null;
        const error = document.getElementById('stepupError');
        const cancel = document.getElementById('stepupCancel');
        const submit = document.getElementById('stepupOk') as HTMLButtonElement | null;
        if (!modal || !form || !input || !error || !cancel || !submit) return;
        let resolver: ((value: boolean) => void) | null = null;
        const close = (value: boolean) => {
            modal.setAttribute('hidden', '');
            input.value = '';
            error.setAttribute('hidden', '');
            const current = resolver;
            resolver = null;
            current?.(value);
        };
        cancel.addEventListener('click', () => close(false));
        document.getElementById('stepupBackdrop')?.addEventListener('click', () => close(false));
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            submit.disabled = true;
            error.setAttribute('hidden', '');
            try {
                const credential = input.value;
                const response = await fetch('/api/account/reauthenticate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: credential, code: credential }),
                });
                if (!response.ok) throw new Error();
                close(true);
            } catch {
                error.removeAttribute('hidden');
                input.select();
            } finally {
                submit.disabled = false;
            }
        });
        (window as any).cordStepUp = (): Promise<boolean> => {
            if (resolver) return Promise.resolve(false);
            modal.removeAttribute('hidden');
            setTimeout(() => input.focus(), 20);
            return new Promise((resolve) => { resolver = resolve; });
        };
    }

    // ── Barra de progreso al navegar (feedback de carga) ──
    function initNavProgress() {
        const bar = document.getElementById('navProgress');
        if (!bar) return;
        let timer = 0; let prog = 0;
        const start = () => {
            bar.classList.add('active'); prog = 8; (bar as HTMLElement).style.width = '8%';
            clearInterval(timer);
            timer = window.setInterval(() => { prog = Math.min(prog + Math.random() * 12, 90); (bar as HTMLElement).style.width = prog + '%'; }, 220);
        };
        const done = () => { clearInterval(timer); clearTimeout(safety); bar.classList.remove('active'); (bar as HTMLElement).style.width = '0'; };
        // Respaldo: si seguimos aquí, la navegación no ocurrió (un mailto:, un
        // protocolo externo, un "salir sin guardar" cancelado que no se detectó).
        let safety = 0;
        const arm = () => { clearTimeout(safety); safety = window.setTimeout(done, 10000); };
        // Arranca en `beforeunload`, que cubre enlaces, formularios y navegaciones
        // por script (⌘K, atajos). Antes también arrancaba con cada clic, y si una
        // página preguntaba "¿salir sin guardar?" y se cancelaba, la barra se
        // quedaba al 90 % hasta recargar. Se registra al final (después de los
        // guardas de las páginas) para ver si alguno canceló con preventDefault.
        window.setTimeout(() => {
            window.addEventListener('beforeunload', (e) => {
                if (e.defaultPrevented) return;
                start(); arm();
            });
        }, 0);
        window.addEventListener('pageshow', done);
    }

    // ── Utilidades Globales ──

    function initNotifs() {
        const btn = document.getElementById('notifBtn');
        const panel = document.getElementById('notifPanel');
        const list = document.getElementById('notifList');
        const count = document.getElementById('notifCount');
        const markAll = document.getElementById('notifMarkAll');
        if (!btn || !panel || !list) return;
        const ICONS: any = {
            send: iconInner('send'),
            eye: iconInner('eye'),
            check: iconInner('check'),
            x: iconInner('x'),
            card: iconInner('card'),
            doc: iconInner('document'),
            chat: iconInner('chat'),
        };
        const TONE: any = { approved: 'ok', paid: 'ok', payment: 'ok', viewed: 'warn', counter: 'warn', rejected: 'danger' };
        const esc = (s: string) => String(s).replace(/</g, '&lt;');
        const I18N = (window as any).CORD_I18N || {};

        // "Visto hasta" por miembro, en el servidor (lo trae el SSR). Antes vivía
        // en localStorage y no seguía al usuario entre dispositivos.
        let seen = Number(count?.dataset.seen || 0) || 0;
        const setCount = (n: number) => {
            if (count) { count.hidden = n <= 0; count.textContent = n >= 10 ? '9+' : String(n); }
            const label = btn.dataset.label || '';
            btn.setAttribute('aria-label', n > 0 ? `${label} (${n >= 10 ? '9+' : n})` : label);
        };
        const save = (ts: number) => {
            if (!(ts > seen)) return;
            seen = ts;
            fetch('/api/app/notif-seen', {
                method: 'PUT', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ seen: ts }), keepalive: true,
            }).catch(() => {});
        };
        // Migración única desde la marca vieja del navegador.
        try {
            const LEGACY = 'cord.notif.seen';
            const local = parseInt(localStorage.getItem(LEGACY) || '0', 10) || 0;
            if (!seen && local > 0) save(local);
            localStorage.removeItem(LEGACY);
        } catch (e) {}

        const paint = (items: any[], prevSeen: number) => {
            if (!items.length) { list.innerHTML = `<div class="notif-empty">${I18N.notifSinActividad || 'Sin actividad reciente'}</div>`; return; }
            list.innerHTML = items.map((n: any) => {
                const unread = n.ts > prevSeen ? ' unread' : '';
                const tone = TONE[n.tipo] ? ' ' + TONE[n.tipo] : '';
                const icon = ICONS[n.icon] || ICONS.doc;
                return `<a class="notif-item${unread}" href="${escAttr(n.href)}"><span class="notif-ico${tone}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${icon}</svg></span><span class="notif-body"><span class="notif-title">${esc(n.title)}</span><span class="notif-sub">${esc(n.sub)}</span><span class="notif-when">${esc(n.cuando)}</span></span></a>`;
            }).join('');
        };
        const load = async () => {
            list.innerHTML = `<div class="notif-empty">${I18N.notifCargando || 'Cargando…'}</div>`;
            try {
                const res = await fetch('/api/notificaciones'); const data = await res.json();
                const prev = seen;
                paint(data.items || [], prev);
                // Abrir la bandeja la marca como vista (se siguen resaltando las nuevas).
                save(data.latest || Date.now());
                setCount(0);
            } catch { list.innerHTML = `<div class="notif-empty">${I18N.notifNoCargo || 'No se pudo cargar'}</div>`; }
        };
        wireTopbarMenu(btn, panel as HTMLElement, { id: 'notif', menu: false, onOpen: load });
        markAll?.addEventListener('click', () => {
            save(Date.now());
            setCount(0);
            list.querySelectorAll('.notif-item.unread').forEach((el) => el.classList.remove('unread'));
        });
    }

    // ── Atajos de teclado globales ──
    function initShortcuts() {
        const help = document.getElementById('kbdHelp');
        if (mobileUi()) {
            if (help) (help as HTMLElement).hidden = true;
            return;
        }
        document.getElementById('kbdHelpBackdrop')?.addEventListener('click', () => { if (help) (help as HTMLElement).hidden = true; });
        // `G` + letra: las rutas salen del propio menú (data-key en cada ítem de
        // la sidebar, que a su vez viene de src/lib/sidebar-nav.ts).
        const routeFor = (k: string) => document.querySelector<HTMLAnchorElement>(`.sidebar .sb-item[data-key="${CSS.escape(k)}"]`)?.getAttribute('href');
        const typing = (el: any) => el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT' || el.isContentEditable);
        let gPending = false; let gTimer = 0;
        document.addEventListener('keydown', (e) => {
            if (e.metaKey || e.ctrlKey || e.altKey) return;
            if (typing(e.target)) return;
            if (!(document.getElementById('cmdk') as HTMLElement)?.hidden) return; // cmdk abierto
            const k = e.key.toLowerCase();
            if (e.key === '?') { e.preventDefault(); if (help) (help as HTMLElement).hidden = !(help as HTMLElement).hidden; return; }
            if (help && !(help as HTMLElement).hidden) return; // overlay de ayuda abierto
            if (gPending) {
                gPending = false; clearTimeout(gTimer);
                const route = routeFor(k);
                if (route) { e.preventDefault(); window.location.href = route; return; }
            }
            if (k === 'g') { gPending = true; gTimer = window.setTimeout(() => { gPending = false; }, 1200); return; }
            if (k === '/') { e.preventDefault(); document.getElementById('cmdkOpen')?.click(); return; }
            if (e.key === '[') { e.preventDefault(); (window as any).__cordToggleSidebar?.(); return; }
            // Crear: la tecla sale del propio menú Crear (data-key), con la misma
            // letra que `G` + letra usa para ir a esa sección (C/G C, F/G F, L/G L,
            // P/G P) más T de tarea. Si el permiso esconde la opción, la tecla
            // tampoco hace nada. Fijar la página quedó en `x`.
            const createItem = document.querySelector<HTMLElement>(`#tbCreateMenu [data-key="${CSS.escape(k)}"]`);
            if (createItem) { e.preventDefault(); createItem.click(); return; }
            if (k === 'x') { e.preventDefault(); (window as any).__cordTogglePin?.(); return; }
        });
    }

    // ── Drawer de Ayuda (icono ? de la topbar) ──
    // Dos vistas en el mismo panel (inicio y chat). El chat NO es un modelo: responde
    // desde el FAQ y los artículos del Centro de ayuda, y cuando no encuentra nada lo
    // dice y manda a soporte. Nunca ejecuta acciones ni lee datos de la cuenta.
    function initHelp() {
        const btn = document.getElementById('helpBtn');
        const drawer = document.getElementById('helpDrawer') as HTMLElement | null;
        const panel = document.getElementById('helpPanel') as HTMLElement | null;
        const home = document.getElementById('helpHome') as HTMLElement | null;
        const chat = document.getElementById('helpChat') as HTMLElement | null;
        const search = document.getElementById('helpSearch') as HTMLInputElement | null;
        const grid = document.getElementById('helpGrid') as HTMLElement | null;
        const faqWrap = document.getElementById('helpFaq');
        const faqSec = document.getElementById('helpFaqSec') as HTMLElement | null;
        const artSec = document.getElementById('helpArticles') as HTMLElement | null;
        const artList = document.getElementById('helpArticleList');
        const empty = document.getElementById('helpEmpty') as HTMLElement | null;
        const history = document.getElementById('chatHistory');
        const quick = document.getElementById('chatQuick') as HTMLElement | null;
        const form = document.getElementById('chatForm') as HTMLFormElement | null;
        const input = document.getElementById('chatRealInput') as HTMLInputElement | null;
        const send = document.getElementById('chatSendBtn') as HTMLButtonElement | null;
        if (!btn || !drawer || !panel || !home || !chat || !faqWrap || !history || !form || !input || !send) return;

        const I18N = (window as any).CORD_I18N || {};
        const FAQ: { q: string; a: string }[] = I18N.faq || [];
        const isEn = document.documentElement.lang === 'en';
        const AI_NAME = chat.querySelector('#helpChatTitle')?.textContent?.trim() || 'Cord AI';
        const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

        // Búsqueda por palabras y sin acentos: src/lib/help-search.ts (la misma que
        // usa Cord AI en el servidor para elegir qué artículos lee).
        const norm = normalizeText;
        const tokens = tokenize;
        const score = scoreDoc;

        // Artículos del Centro de ayuda: índice estático, cargado al abrir por primera vez.
        type Art = { title: string; description: string; category: string; keywords?: string; url: string };
        let arts: Art[] = [];
        let artsReq: Promise<void> | null = null;
        const loadArts = () => artsReq ??= fetch('/api/support-search.json')
            .then((r) => (r.ok ? r.json() : []))
            .then((list: any[]) => {
                const lang = isEn ? 'en' : 'es';
                arts = list.filter((a) => a.lang === lang && a.url)
                    .map((a) => ({ title: a.title, description: a.description || '', category: a.category || '', keywords: a.keywords || '', url: a.url }));
            })
            .catch(() => { artsReq = null; });
        const findArts = (q: string, min = 0.5, n = 4) => {
            const tk = tokens(q);
            return arts.map((a) => ({ a, s: score(tk, a.title, `${a.description} ${a.category} ${a.keywords}`) }))
                .filter((x) => x.s >= min).sort((x, y) => y.s - x.s).slice(0, n).map((x) => x.a);
        };

        // ── FAQ (acordeón) ──
        faqWrap.innerHTML = FAQ.map((f) => `
            <div class="faq-item">
                <button type="button" class="faq-q" aria-expanded="false">
                    <span>${esc(f.q)}</span>
                    ${iconSvg('chevron-down', 'faq-chev', 2)}
                </button>
                <div class="faq-a"><div><p>${esc(f.a)}</p></div></div>
            </div>`).join('');
        faqWrap.addEventListener('click', (e) => {
            const q = (e.target as HTMLElement).closest('.faq-q');
            if (!q) return;
            const item = q.closest('.faq-item') as HTMLElement;
            const wasOpen = item.classList.contains('open');
            faqWrap.querySelectorAll('.faq-item.open').forEach((el) => {
                el.classList.remove('open');
                el.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
            });
            if (wasOpen) return;
            item.classList.add('open');
            q.setAttribute('aria-expanded', 'true');
            setTimeout(() => item.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'nearest' }), 280);
        });

        // ── Buscador: filtra el FAQ y propone artículos ──
        const runSearch = () => {
            const term = search?.value.trim() || '';
            const searching = term.length > 0;
            if (grid) grid.hidden = searching;
            const tk = tokens(term);
            let visibleFaq = 0;
            FAQ.forEach((f, i) => {
                const item = faqWrap.children[i] as HTMLElement | undefined;
                if (!item) return;
                const ok = !searching || norm(f.q + ' ' + f.a).includes(norm(term)) || (tk.length > 0 && score(tk, f.q, f.a) >= 0.5);
                item.hidden = !ok;
                if (ok) visibleFaq++;
            });
            if (faqSec) faqSec.hidden = visibleFaq === 0;
            const found = searching && term.length > 1 ? findArts(term, 0.5, 5) : [];
            if (artSec && artList) {
                artSec.hidden = found.length === 0;
                artList.innerHTML = found.map((a) => `
                    <a class="help-row" href="${esc(a.url)}" target="_blank" rel="noopener">
                        <span class="help-row-txt"><b>${esc(a.title)}</b><i>${esc(a.category)}</i></span>
                        ${iconSvg('external', 'help-grid-chev')}
                    </a>`).join('');
            }
            if (empty) empty.hidden = !searching || visibleFaq > 0 || found.length > 0;
        };
        search?.addEventListener('input', () => { loadArts().then(runSearch); runSearch(); });

        // ── Chat ──
        // Constructor ÚNICO de mensajes (regla 20: cada burbuja lleva su autor).
        let typing: number | null = null;
        const addMsg = (role: 'bot' | 'user', text: string, links: Art[] = [], animate = false) => {
            const msg = document.createElement('div');
            msg.className = `chat-msg ${role}`;
            const who = document.createElement('span');
            who.className = 'chat-author';
            who.textContent = role === 'user' ? (I18N.chatYou || (isEn ? 'You' : 'Tú')) : AI_NAME;
            const bubble = document.createElement('div');
            bubble.className = 'chat-bubble';
            const p = document.createElement('div');
            bubble.appendChild(p);
            msg.append(who, bubble);
            history.appendChild(msg);
            const addLinks = () => {
                if (!links.length) return;
                const box = document.createElement('div');
                box.className = 'chat-links';
                box.innerHTML = links.map((a) => `<a href="${esc(a.url)}" target="_blank" rel="noopener"><span>${esc(a.title)}</span>${iconSvg('external')}</a>`).join('');
                bubble.appendChild(box);
            };
            const toBottom = () => { history.scrollTop = history.scrollHeight; };
            if (!animate || reduced()) { p.textContent = text; addLinks(); toBottom(); return; }
            // Escritura progresiva por palabras (no por letra: 3x más rápida y se
            // lee mejor). Un mensaje nuevo cancela la escritura del anterior.
            if (typing) clearInterval(typing);
            const words = text.split(/(\s+)/);
            let i = 0;
            typing = window.setInterval(() => {
                p.textContent += words.slice(i, i + 2).join('');
                i += 2;
                toBottom();
                if (i >= words.length) { clearInterval(typing!); typing = null; addLinks(); toBottom(); }
            }, 28);
        };
        const showTyping = () => {
            const msg = document.createElement('div');
            msg.className = 'chat-msg bot';
            msg.innerHTML = `<span class="chat-author">${esc(AI_NAME)}</span><div class="chat-bubble"><span class="typing-dots"><span></span><span></span><span></span></span></div>`;
            history.appendChild(msg);
            history.scrollTop = history.scrollHeight;
            return msg;
        };

        const answer = (q: string): { text: string; links: Art[] } => {
            const tk = tokens(q);
            const best = FAQ.map((f) => ({ f, s: score(tk, f.q, f.a) })).sort((x, y) => y.s - x.s)[0];
            // Con respuesta del FAQ, solo artículos MUY relevantes como "más sobre esto";
            // sin ella, los artículos son la respuesta y basta una coincidencia media.
            if (best && best.s >= 0.5) return { text: best.f.a, links: findArts(q, 0.75, 2) };
            const links = findArts(q, 0.5, 3);
            if (links.length) return { text: I18N.chatArticlesIntro || '', links };
            return { text: I18N.chatNoMatch || '', links: [{ title: I18N.chatSupportLink || 'Soporte', url: isEn ? '/en/support' : '/soporte', description: '', category: '' }] };
        };

        // Conversación que viaja a Cord AI (solo texto; el servidor la recorta).
        let turns: { role: 'user' | 'assistant'; text: string }[] = [];
        let inflight: AbortController | null = null;
        const ask = async (text: string) => {
            const q = text.trim();
            if (!q || inflight) return;
            if (quick) quick.hidden = true;
            addMsg('user', q);
            input.value = '';
            send.disabled = true;
            const dots = showTyping();
            const prior = turns.slice();
            turns.push({ role: 'user', text: q });
            const ctrl = (inflight = new AbortController());
            let reply: { text: string; links: Art[] } | null = null;
            try {
                const res = await fetch('/api/ayuda/ia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question: q, history: prior }),
                    signal: ctrl.signal,
                });
                if (res.ok) {
                    const data = await res.json();
                    if (data?.text) reply = {
                        text: String(data.text),
                        links: (data.links || []).map((l: any) => ({ title: String(l.title), url: String(l.url), description: '', category: '' })),
                    };
                }
            } catch {
                if (ctrl.signal.aborted) return;   // el chat se reinició: nada que pintar
            }
            if (ctrl.signal.aborted) return;
            inflight = null;
            // Sin respuesta de la IA (caída, tope, sin llave): la búsqueda local
            // responde igual, desde el FAQ y los artículos.
            if (!reply) { await loadArts(); reply = answer(q); }
            dots.remove();
            turns.push({ role: 'assistant', text: reply.text });
            addMsg('bot', reply.text, reply.links, true);
            send.disabled = !input.value.trim();
        };

        const resetChat = () => {
            if (typing) { clearInterval(typing); typing = null; }
            if (inflight) { inflight.abort(); inflight = null; }
            turns = [];
            history.innerHTML = '';
            addMsg('bot', I18N.chatGreeting || '');
            if (quick) quick.hidden = false;
            input.value = '';
            send.disabled = true;
        };

        if (quick) {
            quick.innerHTML = FAQ.slice(0, 4).map((f, i) => `<button type="button" class="chat-quick-btn" data-quick="${i}">${esc(f.q)}</button>`).join('');
            quick.addEventListener('click', (e) => {
                const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-quick]');
                const f = b && FAQ[Number(b.dataset.quick)];
                if (!f) return;
                quick.hidden = true;
                addMsg('user', f.q);
                // Las sugeridas salen del FAQ: respuesta instantánea y gratis. Entran
                // al historial para que una pregunta de seguimiento tenga contexto.
                turns.push({ role: 'user', text: f.q }, { role: 'assistant', text: f.a });
                window.setTimeout(() => addMsg('bot', f.a, findArts(f.q, 0.75, 2), true), reduced() ? 0 : 260);
            });
        }
        input.addEventListener('input', () => { send.disabled = !input.value.trim(); });
        form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
        resetChat();

        // ── Vistas inicio ⇄ chat ──
        // Navegación tipo iOS, coherente con el "← Atrás" del chat: el chat entra
        // deslizándose desde la derecha mientras el inicio se corre un poco a la
        // izquierda y se apaga; de regreso, al revés. El panel anima su ancho a la
        // vez. Cada vista queda FIJA a su propio ancho final y anclada a la derecha
        // durante el cambio, así ningún texto se re-acomoda a media animación; el
        // panel (overflow hidden) es el que recorta. Sin Web Animations o con
        // movimiento reducido, el cambio es directo.
        let view: 'home' | 'chat' = 'home';
        let moving: Animation[] = [];
        const EASE = 'cubic-bezier(0.32, 0.72, 0, 1)';
        const DUR = 460;
        const applyView = (v: 'home' | 'chat') => {
            view = v;
            panel.classList.toggle('ai-active', v === 'chat');
            home.hidden = v === 'chat';
            chat.hidden = v === 'home';
        };
        const cleanup = () => {
            moving.forEach((a) => a.cancel());
            moving = [];
            for (const el of [home, chat]) {
                el.classList.remove('is-sliding');
                el.style.width = '';
                el.style.background = '';
            }
            panel.style.backgroundColor = '';
        };
        const setView = (v: 'home' | 'chat', after?: () => void) => {
            if (v === view && !moving.length) { after?.(); return; }
            cleanup();
            if (!('animate' in chat) || reduced() || drawer.hidden) {
                applyView(v);
                after?.();
                return;
            }
            const toChat = v === 'chat';
            const surface = () => getComputedStyle(panel).getPropertyValue('--help-surface').trim();
            const w0 = panel.getBoundingClientRect().width;
            const s0 = surface();
            panel.classList.toggle('ai-active', toChat);
            const w1 = panel.getBoundingClientRect().width;
            const s1 = surface();
            view = v;
            const homeW = toChat ? w0 : w1, chatW = toChat ? w1 : w0;
            const homeBg = (toChat ? s0 : s1) || '#f5f5f7', chatBg = (toChat ? s1 : s0) || '#ffffff';
            home.hidden = false;
            chat.hidden = false;
            home.classList.add('is-sliding');
            chat.classList.add('is-sliding');
            home.style.width = homeW + 'px';
            chat.style.width = chatW + 'px';
            home.style.background = homeBg;
            chat.style.background = chatBg;
            // La franja que el panel descubre al ensancharse lleva el color de inicio.
            panel.style.backgroundColor = homeBg;
            const homeOut = [{ transform: 'translateX(0)', opacity: 1 }, { transform: 'translateX(-22%)', opacity: 0 }];
            const chatIn = [
                { transform: 'translateX(100%)', boxShadow: '-24px 0 48px -24px rgba(10,25,47,0)' },
                { transform: 'translateX(0)', boxShadow: '-24px 0 48px -24px rgba(10,25,47,0.28)' },
            ];
            // De regreso se invierten los KEYFRAMES, no la dirección: `direction:
            // 'reverse'` también invierte la curva y la salida arrancaría lenta.
            const opts: KeyframeAnimationOptions = { duration: DUR, easing: EASE, fill: 'both' };
            moving = [
                panel.animate([{ width: w0 + 'px' }, { width: w1 + 'px' }], { duration: DUR, easing: EASE }),
                home.animate(toChat ? homeOut : [...homeOut].reverse(), opts),
                chat.animate(toChat ? chatIn : [...chatIn].reverse(), opts),
            ];
            moving[2].finished.then(() => {
                cleanup();
                applyView(v);
                after?.();
            }).catch(() => {});
        };
        const openChat = (prefill?: string) => setView('chat', () => {
            input.focus({ preventScroll: true });
            if (prefill) ask(prefill);
        });
        document.getElementById('helpAiOpen')?.addEventListener('click', () => openChat());
        document.getElementById('helpAiBack')?.addEventListener('click', () => setView('home', () => document.getElementById('helpAiOpen')?.focus()));
        document.getElementById('helpEmptyAi')?.addEventListener('click', () => openChat(search?.value || ''));

        // ── Abrir / cerrar ──
        let closing: number | null = null;
        const open = () => {
            if (closing) { clearTimeout(closing); closing = null; }
            drawer.classList.remove('is-closing');
            drawer.hidden = false;
            btn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
            loadArts();
            setTimeout(() => (view === 'chat' ? input : search)?.focus({ preventScroll: true }), 60);
        };
        const close = () => {
            if (drawer.hidden || closing) return;
            btn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            const finish = () => {
                closing = null;
                drawer.hidden = true;
                drawer.classList.remove('is-closing');
                cleanup();
                // El chat no persiste: es consulta, no historial. Se reinicia al cerrar.
                applyView('home');
                resetChat();
                if (search) { search.value = ''; runSearch(); }
                (btn as HTMLElement).focus({ preventScroll: true });
            };
            if (reduced()) { finish(); return; }
            drawer.classList.add('is-closing');
            closing = window.setTimeout(finish, 320);
        };

        btn.addEventListener('click', () => (drawer.hidden ? open() : close()));
        drawer.querySelectorAll('[data-help-close]').forEach((b) => b.addEventListener('click', close));
        document.getElementById('helpBackdrop')?.addEventListener('click', close);
        document.addEventListener('keydown', (e) => {
            if (drawer.hidden) return;
            if (e.key === 'Escape') {
                e.preventDefault();
                if (view === 'chat') setView('home', () => document.getElementById('helpAiOpen')?.focus());
                else close();
                return;
            }
            // Foco atrapado dentro del diálogo (aria-modal): Tab no se escapa a la app.
            if (e.key !== 'Tab') return;
            const items = Array.from(panel.querySelectorAll<HTMLElement>('button, a[href], input'))
                .filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
            if (!items.length) return;
            const first = items[0], last = items[items.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });

        // ── Accesos rápidos ──
        drawer.querySelectorAll<HTMLElement>('[data-help-action]').forEach((el) => {
            el.addEventListener('click', () => {
                const action = el.dataset.helpAction;
                if (action === 'shortcuts') {
                    if (mobileUi()) return;
                    close();
                    const h = document.getElementById('kbdHelp');
                    if (h) h.hidden = false;
                } else if (action === 'guide') {
                    close();
                    // La guía de configuración solo existe mientras el onboarding está
                    // incompleto; si ya no está montada, la guía es el Centro de ayuda.
                    const onb = (window as any).__cordOnb;
                    if (onb && document.getElementById('onbCard')) onb.set({ view: 'card', dismissed: false });
                    else window.location.href = isEn ? '/en/support' : '/soporte';
                }
            });
        });
    }

    // ── Menú "Crear" genérico (botón + popover) — reusado por móvil y desktop ──
    // ── Menú "Crear" de la topbar (desktop) ──
    let createMenu: ReturnType<typeof wireTopbarMenu> | null = null;
    function initCreateMenu(btnId: string, menuId: string) {
        const btn = document.getElementById(btnId);
        const menu = document.getElementById(menuId);
        if (!btn || !menu) return;
        createMenu = wireTopbarMenu(btn, menu, { id: 'create' });
    }

    // ⌘ en Mac; Ctrl en Windows y Linux (antes decía ⌘K para todos).
    function initModKey() {
        const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
        const plat = nav.userAgentData?.platform || navigator.platform || navigator.userAgent;
        if (/mac|iphone|ipad|ipod/i.test(plat)) return;
        document.querySelectorAll<HTMLElement>('[data-mod-key]').forEach((el) => {
            el.textContent = (el.textContent || '').replace('⌘', el.textContent === '⌘' ? 'Ctrl' : 'Ctrl ');
        });
    }

    // ── Quick-add de Tarea (modal desde el botón "Crear") ──
    function initQuickTask() {
        const modal = document.getElementById('qtask');
        const form = document.getElementById('qtaskForm') as HTMLFormElement | null;
        const titulo = document.getElementById('qtaskTitulo') as HTMLInputElement | null;
        const due = document.getElementById('qtaskDue') as HTMLInputElement | null;
        if (!modal || !form || !titulo) return;
        const open = () => { (modal as HTMLElement).hidden = false; document.body.style.overflow = 'hidden'; setTimeout(() => titulo.focus(), 30); };
        const close = () => { (modal as HTMLElement).hidden = true; document.body.style.overflow = ''; form.reset(); };
        // Disparadores: botón de la topbar y el menú móvil (si existiera un item de tarea).
        document.getElementById('tbCreateTarea')?.addEventListener('click', () => { createMenu?.close(); open(); });
        (window as any).cordQuickTask = open;
        document.getElementById('qtaskClose')?.addEventListener('click', close);
        document.getElementById('qtaskBackdrop')?.addEventListener('click', close);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !(modal as HTMLElement).hidden) close(); });
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const t = titulo.value.trim();
            if (!t) return;
            try {
                // Sin elegir responsable, la tarea es de quien la escribe.
                const res = await fetch('/api/tareas', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ titulo: t, due_date: due?.value || null, asignar_a_creador: true }) });
                if (!res.ok) throw new Error();
                close();
                // Un tablero de tareas abierto (Inicio o /app/tareas) se refresca solo.
                document.dispatchEvent(new CustomEvent('cord:tasks-changed'));
                (window as any).cordToast?.((window as any).CORD_I18N?.taskCreatedOk || 'Tarea creada', 'ok');
            } catch { (window as any).cordToast?.((window as any).CORD_I18N?.taskCreatedErr || 'No se pudo crear la tarea', 'error'); }
        });
    }

    function initApp() { initCmdk(); initTheme(); initToasts(); initConfirm(); initStepUp(); initNavProgress(); initNotifs(); initHelp(); initShortcuts(); initCreateMenu('tbCreate', 'tbCreateMenu'); initQuickTask(); initModKey(); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initApp);
    else initApp();
</script>
