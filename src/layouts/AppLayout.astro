    /* ── Transición inicio ⇄ chat ──
       Durante el cambio las dos vistas se apilan ancladas a la derecha, cada una a
       su ancho final (lo fija setView() en initHelp), y el panel recorta. El chat
       va encima: entra desde la derecha como una pantalla de navegación iOS. */
    .help-home.is-sliding, .help-chat.is-sliding { position: absolute; top: 0; right: 0; bottom: 0; will-change: transform; }
    .help-chat.is-sliding { z-index: 3; }

    /* ──────────────────────────────────────────────────────────────
       PULIDO MÓVIL GLOBAL (is:global → alcanza inputs de las páginas hijas)
       ────────────────────────────────────────────────────────────── */
    @media (max-width: 880px) {
        /* iOS hace zoom automático al enfocar un campo con font-size < 16px.
