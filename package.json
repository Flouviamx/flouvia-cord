{
  "name": "flouvia-cord",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs -- --reset",
    "db:cleanup-ops": "node scripts/cleanup-non-ops-data.mjs",
    "saml:xsw-check": "node scripts/saml-xsw-check.mjs",
    "security:csrf": "node scripts/csrf-matrix.mjs",
    "security:stripe-signature": "node scripts/stripe-signature-check.mjs",
    "security:encrypt-backfill": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/encrypt-backfill.mjs",
    "security:crypto": "node scripts/crypto-secret-check.mjs",
    "security:fees": "node --experimental-strip-types scripts/fees-check.mjs",
    "security:whitelabel": "node scripts/whitelabel-lint.mjs",
    "security:disputes": "node --experimental-strip-types scripts/dispute-safety-check.mjs",
    "security:fiscal": "node --experimental-strip-types scripts/fiscal-core-check.mjs",
    "security:billing": "node --experimental-strip-types scripts/billing-security-check.mjs",
    "security:billing-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-stripe-billing.mjs",
    "security:billing-db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-billing-db.mjs",
    "security:rls": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/rls-audit.mjs",
    "test:payments": "npm run security:csrf && npm run security:stripe-signature && npm run security:crypto && npm run security:fees && npm run security:whitelabel && npm run security:disputes && npm run security:billing"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nanostores/react": "^1.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@node-saml/node-saml": "^5.1.0",
    "@posthog/mcp": "^0.10.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.2.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "is-inside-container": "^1.0.0",
    "marked": "^15.0.0",
    "nanostores": "^1.4.0",
    "posthog-js": "^1.409.0",
    "posthog-node": "^5.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0",
    "typescript": "^6.0.3",
    "undici": "^8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "circle-flags": "^2.8.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
