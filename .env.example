# ── Auth propio — Google/Apple Sign-In (opcional; el botón se oculta/da 503 sin esto) ──
# Google Cloud Console → Credentials → OAuth 2.0 Client ID (tipo "Web application").
# Redirect URI autorizado: https://<tu-dominio>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer → Certificates, Identifiers & Profiles → Keys (Sign in with Apple).
# APPLE_PRIVATE_KEY es el contenido del archivo .p8 completo (con los saltos de
# línea como \n si va en una sola línea de env var).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Origin público exacto usado en los flujos de OAuth (debe matchear byte a
# byte el redirect_uri registrado en Google/Apple). Default: https://cordhq.app
SITE=
# URL pública usada para construir links desde correo, cron y webhooks, donde no
# existe un request confiable del cual derivar el origen. Default: https://cordhq.app
PUBLIC_SITE_URL=

# ── Panel interno /ops ──
# No usa una llave compartida ni una variable de entorno. El acceso exige una
# cuenta permitida explícitamente en `src/lib/ops-auth.ts` y en `ops_operators`,
# además de passkey o contraseña + TOTP.

# ── Neon (PostgreSQL serverless) — base de datos del SaaS ──
# Crear proyecto en neon.tech (o vía Vercel Marketplace → Neon) y pegar la URL.
# ⚠️ USA EL ENDPOINT POOLED: el host debe contener "-pooler"
#   (ej. ...-pooler.<region>.aws.neon.tech). El driver HTTP abre una conexión por
#   query; sin el pooler, un pico de usuarios concurrentes agota las conexiones
#   directas de Neon y la app tira 500s. El dashboard de Neon lo etiqueta "Pooled
#   connection"; la integración de Vercel Marketplace lo inyecta pooled por default.
DATABASE_URL=

# ── Rate limiting durable + sesiones SSE de MCP ──
# OPCIONALES (ago 2026). Antes eran obligatorias para Ops y eso lo dejó 503 en
# producción durante semanas, porque nunca se provisionaron. Hoy el rate limit
# fail-closed (`strictRateLimit`: login de Ops, reembolsos, disputas, reauth,
# Connect) usa Upstash si está y si no cae a la tabla `rate_limit_counters` de
# Neon — igual de compartida entre instancias, sin proveedor extra.
# Lo que SÍ siguen mejorando estas dos: el rate limit normal del resto de Cord
# (sin ellas es un contador in-memory POR INSTANCIA, que se multiplica por el
# número de réplicas de Vercel) y las sesiones del transporte MCP legacy
# (GET /api/mcp/sse + POST /api/mcp/message), que sin Redis caen a un Map en
# memoria y solo funcionan con una instancia. Crear en upstash.com (Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cifrado en reposo de secretos recuperables ──
# OBLIGATORIA para CLABE, TOTP, llaves Facturapi y secretos de webhooks. También
# cifra tokens MCP. Debe contener exactamente 32 bytes codificados en base64.
# El backfill migra columnas heredadas en texto claro. Para rotar, despliega la
# nueva llave y conserva la anterior en ENCRYPTION_KEY_PREV hasta re-cifrar las
# filas existentes durante una ventana controlada; no retires PREV antes.
# Generar con: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEY_PREV=
ENCRYPTION_KEY_PREV_ID=k0
# Compatibilidad histórica de MCP; no sustituye ENCRYPTION_KEY en producción.
MCP_SECRET_KEY=

# ── SSO empresarial SAML 2.0 (opcional) ──
# Keypair de firma del Service Provider (Cord) — SOLO necesario si una conexión
# activa sign_authn_request (algunos IdPs lo exigen; la mayoría no). Un único
# keypair a nivel Cord, reusado por TODAS las conexiones/orgs — ver
# spSigningMaterial() en src/lib/saml.ts. Sin estas dos vars, sign_authn_request
# simplemente no se puede activar (rechazado con "sp_signing_no_configurado"),
# el resto de SSO (login, validación de aserciones, JIT) funciona igual.
# SAML_SP_PRIVATE_KEY es el contenido del PEM completo (con los saltos de línea
# como \n si va en una sola línea de env var, igual que APPLE_PRIVATE_KEY).
# No necesita ser emitido por una CA real — es material de firma propio del SP,
# el IdP simplemente confía en la llave pública publicada en el metadata.
# Generar con: openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 1095 -nodes -subj "/CN=cordhq.app SAML SP"
SAML_SP_PRIVATE_KEY=
SAML_SP_CERT=

# ── Correo entrante del agente de cobranza (opcional) ──
# Secreto que debe mandar el proveedor de correo (Resend/SendGrid Inbound) como
# `Authorization: Bearer <secreto>` para invocar /api/webhooks/inbound-email.
# Sin él, ese endpoint rechaza todo (fail-closed).
INBOUND_EMAIL_SECRET=



# ── Stripe Billing (suscripciones + pago de cotizaciones) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Connect (cobro directo a la cuenta del dueño del negocio, vía Embedded Components)
# Secreto del webhook de "eventos en cuentas conectadas" (account.updated, checkout.session.*)
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Emails transaccionales (Resend) ──
# SIN esto NO se manda ningún correo (ni al enviar una cotización, ni recordatorios).
# El dominio remitente debe estar verificado en Resend. Usamos flouvia.com (ya
# verificado), NO cordhq.app.
RESEND_API_KEY=
RESEND_FROM="Cord <cotizaciones@flouvia.com>"
# Destinatario de los leads del formulario /contacto/ventas (default: hola@flouvia.com):
SALES_EMAIL=
# Secreto para proteger el cron de recordatorios (Vercel manda Authorization: Bearer):
CRON_SECRET=
# Incoming Webhook de un canal interno de operaciones; recibe alertas sin PII.
OPS_SLACK_WEBHOOK_URL=
FACTURAPI_CORD_ORG_KEY=                                        # llave fiscal de Cord para timbrar comisiones; el cron mensual solo crea borrador y alerta

# ── CFDI 4.0 — timbrado vía Facturapi (facturapi.io) ──
# Llave secreta de Facturapi: sk_test_… (pruebas) o sk_live_… (producción).
# Modo UNA-SOLA-CUENTA: timbra todo bajo TU RFC. Sin esta llave (y sin CSD por
# org), el timbrado es SIMULADO (se marca provider_data.simulado=true).
FACTURAPI_API_KEY=
# Llave de CUENTA de Facturapi ("User key"/Secret key del panel → User keys).
# Habilita el modo MULTI-TENANT: cada cliente sube su CSD en Ajustes › Datos
# fiscales y Cord crea su organización Facturapi para timbrar bajo SU RFC.
FACTURAPI_USER_KEY=
# FACTURAPI_URL=          # opcional, default https://www.facturapi.io/v2
# PAC_API_KEY=            # (legado: contrato PAC genérico, ya no usado por MexicoSatProvider)

# ── IA: armar cotizaciones desde texto (/api/cotizaciones/ai-draft) ──
# Llave de Anthropic (console.anthropic.com) o Vercel AI Gateway. Sin esto, el
# botón "Armar con IA" del editor devuelve un aviso de "no configurada".
ANTHROPIC_API_KEY=
# Opcional: modelo. El default del código es claude-haiku-4-5-20251001.
AI_MODEL=

# ── PostHog: product analytics + MCP server analytics ──
# Token del proyecto PostHog (us.posthog.com → Project Settings → Project API key).
# PUBLIC_ prefix: Astro lo expone al cliente; el token es público por diseño.
# Usado por: posthog-server.ts (backend), posthog.ts (client-side), y
# src/lib/mcp/rpc.ts (MCP analytics — emite $mcp_* events por cada tool call).
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Kill switch privado para previews, pruebas o mantenimiento. En `npm run dev`
# la captura ya se desactiva automáticamente aunque esta variable sea false.
POSTHOG_DISABLE_CAPTURE=false

# ── Log del servidor (src/lib/log.ts) ──
# Umbral de nivel: debug | info | warn | error. Opcional.
# Default: 'info' en producción (debug es ruido y cuesta ingest), 'debug' en
# local. Súbelo a 'debug' en un deployment concreto para diagnosticar sin tocar
# código; bájalo a 'error' si solo quieres fallos. En producción cada evento
# sale como UNA línea JSON, filtrable en Vercel por level/orgId/route.
LOG_LEVEL=
